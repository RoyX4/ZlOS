{
    "version": 4,
    "configurations": [
        {
            "name": "zl-linux",
            "includePath": ["${workspaceFolder}/**"],
            "defines": [
                "BUILD_PARSER",
                "BUILD_INTERP",
                "_strdup=strdup"
