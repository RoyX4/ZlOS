# apps_sys3.zl - Disk Usage, Services, Archive Manager, Image Viewer, Network
#
# ONE SLICE, ONE FILE. apps_registry.zl's seven dispatch chains each call into
# this file exactly once, so a slice can be written without touching the shared
# registry at all. That is not tidiness: five agents editing seven if-chains in
# one working tree clobber each other, and a duplicate app id compiles clean and
# misroutes at RUNTIME - REG_FIRST is a dispatch FLOOR, so `id >= REG_FIRST`
# routes into the registry and a collision is invisible until you open the app.
# That floor used to be APP_CATALOG, which is exactly how it went wrong: the
# catalog was given id 13 and so was APP_FILES, and for months `apps` raised
# the Files window instead of opening the catalog.
#
# THIS SLICE OWNS IDS 46..50 AND NO OTHERS.
#
# ---------------------------------------------------------------------------
# WHICH TOOLKIT EACH WIDGET COMES FROM
#
# uikit.c's catalogue is only PARTLY reachable from zl. The bridge is
# freestanding/runtime_kernel.c and it currently binds 60 ui_* names. What this
# file needs and GETS from the toolkit:
#
#   ui_begin ui_txt ui_tw ui_th ui_pill ui_pill_w ui_pill_h ui_tb ui_dot
#   ui_dot_sz ui_badge ui_badge_w ui_badge_h ui_meter ui_meter_h ui_mono
#   ui_stat ui_statc ui_statn ui_stat_end ui_ink_on ui_color
#
# What it needs and the bridge does NOT bind, so it is drawn here against the
# same numbers - kernel/docs/reference/ui/widgets.md S4.2, S7, S9, S10.3, S10.4 -
# each s3_* helper being a one-line forward the day its twin is bridged:
#
#   ui_utabs      underline tab strip   Services      S4.2 / ds 431, 3787
#   ui_colhead    column header grid    Archive       S7.2 / ds 4160
#   ui_grid_row   grid row + cells      Archive       S7.4 / ds 4175
#   ui_sidebar    sidebar panel         Network       S9.1 / ds 584
#   ui_nav_row    sidebar nav row       Network       S9.3 / ds 4034
#   ui_heading    section heading       Disk, Network S9.2 / ds 417, 586
#   ui_segbar_*   disk segment bar      Disk          S10.3 / ds 410, 3767
#   ui_minibar    inline mini bar       Disk          S10.4 / ds 421, 3785
#
# ui_meter stands in for ui_minibar (5px track vs 6px, same radius family).
#
# EVERY DRAW FUNCTION CALLS ui_begin FIRST, and that is not decoration.
# ui.c keeps the mode in a STATIC (`L.mode`), and every uikit widget opens
# with `if (ui_mode_get() != UI_DRAW) return;`. Nothing resets that mode when
# a draw begins - the app is expected to declare it. kernel.zl's menu_event
# (4435) leaves it at UI_HITTEST: `ui_begin(..., 1, ex, ey, 1)`, run to
# hit-test the start menu, with no matching ui_begin(..., 0, ...) afterwards.
# So an app here that skipped ui_begin would compile clean, pass every gate,
# and then paint NOTHING from the first start-menu click onward. That is
# precisely the shape of bug this suite has already shipped once (state
# changed, wm_dmg never called, nine handlers, all gates green).
#
# It is also safe in the other direction: menu_event is the ONLY hit-test
# ui_begin in the tree, and it does not re-run app_draw, so setting DRAW mode
# here cannot turn somebody else's hit-test pass into an unwanted repaint.
#
# NUMBERS ARE DRAWN WITH num_aa, not ui_txtn. num_aa is the committed builtin;
# it steps by cell_w(), which is exactly what ui_tw(s, size, UI_F_MONO)
# returns (ui_text_w: `ui_strlen(s) * fb_cell_w()`), so mono widths measured
# either way agree. It bypasses the DRAW-mode gate, which is harmless here
# precisely because of the ui_begin rule above.
#
# COLOUR. Every colour is theme(TH_*), i.e. ui_color(), i.e. design.h - no
# literal, and no second copy of a role. The zl role table is 20 entries
# (kernel.zl TH_BG..TH_OK) and the reference's palette is larger, so three
# tiers collapse and are called out at each site:
#
#   ds #74797f (ZD_TEXT_5), #5c6167 (ZD_TEXT_6), #c4c9cf (ZD_TEXT_2)
#                                             -> TH_TEXT_DIM / TH_TEXT
#   ds #f5b93c (ZD_WARN)                      -> TH_ACCENT
#   ds #0d0f12 (ZD_SURF_WELL)                 -> TH_BG (#07080a)
#   ds #474b50 (ZD_SURF_7)                    -> TH_BORDER (#22262b)
#
# Alpha tints are blended FROM a role - blend(..., theme(TH_ACCENT), 18) is
# the reference's rgba(184,232,56,.07) - so they are not literals either.
#
# EVERY NAME IN THIS FILE IS SLICE-PREFIXED, and that is not style. The four
# slice files plus kernel.zl compile into ONE translation unit (_gen.c), so a
# name is global to all of them. This file's Network app was first written
# with an `nt_` prefix and collided head-on with apps_utils.zl's Sticky Notes:
#
#   _gen.c:7118: error: redefinition of 'zl_fn_nt_draw'
#   _gen.c:1598: error: too few arguments to 'zl_fn_nt_event'; expected 5, have 3
#
# The C compiler caught that one. The same collision on a top-level CONSTANT
# (two files both writing `UI_SM = 0`) is the same class of error, and a
# collision on a mutable global would not be an error at all - just two apps
# sharing one variable. Hence s3du_ / s3sv_ / s3ar_ / s3iv_ / s3nw_ / s3_, and
# S3_ for the ui.h constants rather than UI_.

sys3_LO = 46
sys3_HI = 50
fn sys3_has(id) { if id < sys3_LO { return 0 }  if id > sys3_HI { return 0 }  return 1 }

APP_DISK  = 46
APP_SVC   = 47
APP_ARCH  = 48
APP_IMG   = 49
APP_NET   = 50

# ui.h's text sizes, flags and button kinds, as zl constants.
S3_SM = 0
S3_MD = 1
S3_MONO = 1
S3_BOLD = 2
S3_BTN_NEUTRAL = 0
S3_BTN_PRIMARY = 1
S3_BTN_DANGER  = 2
S3_PANEL_HEX   = 2

fn sys3_name(id) {
    if id == APP_DISK { return "Disk Usage" }
    if id == APP_SVC  { return "Services" }
    if id == APP_ARCH { return "Archive Manager" }
    if id == APP_IMG  { return "Image Viewer" }
    if id == APP_NET  { return "Network" }
    return ""
}
fn sys3_cat(id) { return 0 }

# reg_mono() forwards here and nothing defined it - the same hole apps_sys2.zl
# had, and see that file's sys2_mono for what an undefined zl function actually
# does at runtime. It never fired HERE only because sys3_icon() answers for all
# five of these apps, so the catalog draws an icon and never asks. That is luck,
# not design: give one of them -1 and the whole grid stops drawing again.
fn sys3_mono(id) {
    if id == APP_DISK { return "DU" }
    if id == APP_SVC  { return "SV" }
    if id == APP_ARCH { return "AR" }
    if id == APP_IMG  { return "IV" }
    if id == APP_NET  { return "NW" }
    return "??"
}

# Window sizes in design units; reg_new multiplies by ui().
#
# THE CITATION WAS TO THE SUPERSEDED DOCUMENT. This said "ds-reference.html
# APPS table", and design.h is explicit that where the two disagree the
# prototype wins. DISK and NET now carry presswork-prototype.html's rects; the
# other three still hold the older numbers and are marked so, because changing
# a size nobody has checked against the authority would be inventing one.
#
# DISK and NET also had a second, unreachable set of values in reg_w/reg_h -
# reg_w is never consulted for sys3's id band - so one id had two answers. The
# registry's copies are gone; these are the live ones.
fn sys3_w(id) {
    if id == APP_DISK { return 580 }
    if id == APP_SVC  { return 596 }
    if id == APP_ARCH { return 590 }
    if id == APP_IMG  { return 520 }
    if id == APP_NET  { return 600 }
    return 480
}
fn sys3_h(id) {
    if id == APP_DISK { return 420 }
    if id == APP_SVC  { return 392 }
    if id == APP_ARCH { return 384 }
    if id == APP_IMG  { return 410 }
    if id == APP_NET  { return 460 }
    return 340
}

# icons.c indices, only where the shape is a real match. reg_mono() has no
# per-slice hook, so an id answering -1 here would draw "??" rather than a
# monogram - every one of these five gets a real glyph instead.
fn sys3_icon(id) {
    if id == APP_DISK { return 12 }     # drive
    if id == APP_SVC  { return 4 }      # monitor
    if id == APP_ARCH { return 7 }      # files
    if id == APP_IMG  { return 2 }      # paint
    if id == APP_NET  { return 17 }     # network
    return 0 - 1
}

# ==============================================================================
# Shared shapes. Toolkit forwards first, then the widgets the bridge does not
# reach yet - see the header for the list and the reference lines.
# ==============================================================================

# mono text and its width, so no call site hand-counts characters
fn s3_mono(x, y, s, c) { ui_txt(x, y, s, c, S3_MD, S3_MONO)  return 0 }
fn s3_mw(s) { return ui_tw(s, S3_MD, S3_MONO) }

# S9.2 section heading. The dominant treatment is 10px / 400 / .08em /
# uppercase / #5c6167; the callers pass the uppercase literal.
fn s3_heading(x, y, s) { ui_txt(x, y, s, theme(TH_TEXT_DIM), S3_SM, 0)  return 0 }

# S13 pill button, medium: ZD_PILL_MD is padding 6/13 radius 11, which is the
# reference's own toolbar button. Returns the width so a row can advance.
fn s3_btn_w(s, flags) { return ui_pill_w(s, S3_MD, flags) }
fn s3_btn(x, y, s, kind, flags) {
    w = ui_pill_w(s, S3_MD, flags)
    ui_pill(x, y, w, ui_pill_h(S3_MD), s, S3_MD, kind, flags)
    return w
}

# S8 stat strip height, computed from the same terms ui_stat_begin uses
# (2 * ZD_STAT_PY + text_h(SM) + 2 + text_h(MD)) so a bottom-anchored strip
# can be positioned before it is drawn - ui_stat_end only reports afterwards.
fn s3_stat_h() { return 16 * ui() + ui_th(S3_SM) + ui_th(S3_MD) }

# ...and the minw to hand ui_stat_begin so the strip has EXACTLY n columns.
# The reference's `repeat(auto-fit, minmax(88px,1fr))` collapses the tracks it
# cannot fill, so 5 cells in a 590px strip become 5 columns of 118 - not 6 of
# 98 with 98px of bare gutter, which is what passing the reference's literal
# 88/96 to ui_stat_begin produces (it computes cols = w / minw and stops).
# Image Viewer is the case that makes this visible: it renders ONE cell.
fn s3_stat_min(w, n) { return w / n / ui() }

# S10.3 disk segment bar: a BORDERED, PADDED container of segments, not a
# track with a fill - the only bar in the reference shaped that way.
# ds 410 (track) + seg() 3767. h 12, radius 7, 1px padding, 1px gap.
fn s3_segbar(x, y, w, used, total, okc) {
    u = ui()
    h = 12 * u
    rrect(x, y, w, h, 7 * u, theme(TH_BORDER))
    rrect(x + u, y + u, w - 2 * u, h - 2 * u, 6 * u, theme(TH_BG))
    iw = w - 4 * u
    fw = 0
    if total > 0 { fw = used * iw / total }
    if fw < 0 { fw = 0 }
    if fw > iw { fw = iw }
    if fw > 0 { rrect(x + 2 * u, y + 2 * u, fw, h - 4 * u, 5 * u, okc) }
    if fw < iw - u { rrect(x + 3 * u + fw, y + 2 * u, iw - fw - u, h - 4 * u, 5 * u, theme(TH_PANEL_HI)) }
    return 0
}

# How many decimal digits a number occupies, so a mono number can be
# right-aligned. num_aa has no width function and its advance is cell_w().
fn s3_digits(n) {
    if n < 0 { n = 0 - n }
    d = 1
    p = 10
    while p <= n { d = d + 1  p = p * 10 }
    return d
}
fn s3_numw(n) { return s3_digits(n) * cell_w() }
fn s3_num_r(xr, y, n, c) {
    num_aa(xr - s3_numw(n), y, n, c)
    return 0
}

# ==============================================================================
# 46 - Disk Usage, 456 x 344.  ds-reference.html 402-427, diskMounts 3765,
# diskTop 3776.
#
# Per mount: a name, a read-only/read-write flag, a segmented capacity bar and
# used/total in mono; then "Largest files on rd0" over rows of path + mini bar
# + size.
#
# THE DATA IS REAL where the kernel has it. /tmp is zlfs - fs_cap()/fs_free()
# are block counts and fs_bs() the block size - and the largest-files list
# walks the real directory (fs_inuse/fs_bytes/fs_ch), so an unmounted volume
# shows an empty list rather than seven invented paths. /dev/rd0 is the boot
# image and this kernel exposes no size for it, so its 4 MiB read-only figure
# is the reference's own constant. That is the ONE number on this screen that
# is not a live read, and it is named here rather than dressed up.
# ==============================================================================
S3DU_PAD_X = 16
S3DU_PAD_Y = 14
S3DU_GAP   = 14
S3DU_ROWS  = 7                        # the reference lists the top 7
S3DU_SLOTS = 32                       # fs.c FS_MAXFILES - the whole directory
# S3DU_RD0 was here: the literal 4194304, cited to the superseded document,
# passed as both used and total so the pane drew a permanently full ramdisk
# this kernel has never had. Deleted rather than corrected - there is no rd0 to
# report a right number for.

# GATED ON THE MOUNT, NOT ON THE ARITHMETIC. fs_cap() keeps reporting a
# capacity when nothing is mounted while fs_free() reports 0, so
# used = cap - free = cap, and this row drew a 100%-FULL volume for a
# filesystem the kernel had refused to mount. Guarding on `total == 0` did not
# catch it, because the total was never 0 - the number that was wrong was the
# used figure, and it was wrong in the direction that looks like a full disk.
fn s3du_tmp_total() { if fs_ok() == 0 { return 0 }  return fs_cap() * fs_bs() }
fn s3du_tmp_used() { if fs_ok() == 0 { return 0 }  return (fs_cap() - fs_free()) * fs_bs() }

# (size desc, slot asc) - a total order, so "the rank-th largest" is well
# defined even when two files are the same size.
fn s3du_before(ai, bi) {
    if fs_bytes(ai) > fs_bytes(bi) { return 1 }
    if fs_bytes(ai) < fs_bytes(bi) { return 0 }
    if ai < bi { return 1 }
    return 0
}
fn s3du_at_rank(rank) {
    i = 0
    while i < S3DU_SLOTS {
        if fs_inuse(i) == 1 {
            n = 0
            j = 0
            while j < S3DU_SLOTS {
                if fs_inuse(j) == 1 { if s3du_before(j, i) == 1 { n = n + 1 } }
                j = j + 1
            }
            if n == rank { return i }
        }
        i = i + 1
    }
    return 0 - 1
}

# One mount block. Returns the y after it.
fn s3du_mount(x, y, w, nm, flag, used, total, ok) {
    u = ui()
    ui_txt(x, y, nm, theme(TH_TEXT_HI), S3_MD, S3_BOLD)
    fc = theme(TH_OK)
    if ok == 0 { fc = theme(TH_DANGER) }
    s3_mono(x + w - s3_mw(flag), y + 2 * u, flag, fc)
    by = y + 22 * u
    sc = theme(TH_ACCENT)
    if ok == 0 { sc = theme(TH_DANGER) }
    # A ZERO-CAPACITY VOLUME IS NOT A FULL ONE. s3_segbar divides by total, and
    # an unmounted zlfs reports capacity 0, so "used of total" was 0 of 0 - which
    # is not a fraction at all. Draw the empty track and say so in the figures
    # below rather than letting the arithmetic decide what 0/0 looks like.
    if total > 0 { s3_segbar(x, by, w, used, total, sc) } else { s3_segbar(x, by, w, 0, 1, sc) }
    ty = by + 18 * u
    if total == 0 {
        s3_mono(x, by + 18 * u, "not mounted - no capacity to report", theme(TH_TEXT_DIM))
        return by + 18 * u + ui_th(S3_MD) + 6 * u
    }
    uk = idiv(used, 1024)                    # idiv: whole KiB
    tk = idiv(total, 1024)                   # idiv: whole KiB
    num_aa(x, ty, uk, theme(TH_TEXT_DIM))
    s3_mono(x + s3_numw(uk), ty, " KiB used", theme(TH_TEXT_DIM))
    tw = s3_numw(tk) + s3_mw(" KiB")
    num_aa(x + w - tw, ty, tk, theme(TH_TEXT_DIM))
    s3_mono(x + w - tw + s3_numw(tk), ty, " KiB", theme(TH_TEXT_DIM))
    return ty + ui_th(S3_MD) + 6 * u
}

# ---- THE COMPOSITION BAR, WHICH IS THE PANE'S PRIMARY INSTRUMENT ------------
#
# R.disk opens with a segmented bar in a well and a five-row legend under it -
# kernel+tools 41.2, atlases 22.6, source 18.4, journal 6.1, free 11.7 - and
# this pane had neither. Two stacked mount rows are the SUPERSEDED document's
# layout; the authority leads with what the volume is made of.
#
# THOSE FIVE CATEGORIES CANNOT BE READ HERE AND ARE NOT COPIED. Nothing in this
# kernel knows which blocks are "atlases" or "source"; the prototype's numbers
# describe ITS image, and printing them would be five invented figures in the
# pane's most prominent instrument. zlfs does not have a journal at all, so
# that segment names a structure this filesystem lacks.
#
# What IS readable is better, because it is this disk: the directory gives a
# byte count per file, so the bar is the actual files, largest first, with the
# free remainder last. Same instrument, same shape, this machine's contents.
S3DU_BARH = 16
S3DU_LEGN = 5                      # the reference's five rows

# Bytes in the n-th largest file, or 0 past the end.
fn s3du_part_bytes(n) {
    sp_i = s3du_at_rank(n)
    if sp_i < 0 { return 0 }
    return fs_bytes(sp_i)
}

# A filename, one character at a time, the same way the largest-files list
# below draws it - zl has string literals and no string values, so fs_ch(slot,
# i) is the only route a runtime name has to the screen.
fn s3du_name(n, nx, ny, col) {
    sn_i = s3du_at_rank(n)
    if sn_i < 0 { return 0 }
    sn_c = 0
    sn_x = nx
    while sn_c < 20 {
        sn_ch = fs_ch(sn_i, sn_c)
        if sn_ch > 0 { char_aa(sn_x, ny, sn_ch, col) }
        if sn_ch > 0 { sn_x = sn_x + cell_w() }
        sn_c = sn_c + 1
    }
    return 0
}

fn s3du_used_bytes() {
    su_i = 0
    su_t = 0
    while su_i < S3DU_SLOTS {
        if fs_inuse(su_i) == 1 { su_t = su_t + fs_bytes(su_i) }
        su_i = su_i + 1
    }
    return su_t
}

# One segment's colour. The reference names steel, steel-br, warn, text-inert
# and well; the first four are the ladder's own instrument inks and the last is
# the ground the bar is cut into, which is exactly what "free" should read as.
fn s3du_part_col(n) {
    if n == 0 { return theme(TH_STEEL) }
    if n == 1 { return theme(TH_ACCENT_BR) }
    if n == 2 { return theme(TH_WARN) }
    if n == 3 { return theme(TH_SURF_7) }
    return theme(TH_SURF_WELL)
}

fn s3du_bar(bx, by, bw, total) {
    pw_well(bx, by, bw, S3DU_BARH * ui() + 14 * ui())
    ix = bx + 7 * ui()
    iy = by + 7 * ui()
    iw = bw - 14 * ui()
    ih = S3DU_BARH * ui()
    fill_rgb(ix, iy, iw, ih, theme(TH_CUT))
    if total < 1 { return by + S3DU_BARH * ui() + 14 * ui() }
    sx = ix + 1
    si = 0
    while si < S3DU_LEGN - 1 {
        sb = s3du_part_bytes(si)
        sw2 = (iw - 2) * sb / total
        if sw2 > 0 { fill_rgb(sx, iy + 1, sw2, ih - 2, s3du_part_col(si)) }
        if sw2 > 0 { fill_rgb(sx + sw2 - 1, iy + 1, 1, ih - 2, theme(TH_CUT)) }
        sx = sx + sw2
        si = si + 1
    }
    # EVERYTHING PAST THE FOURTH FILE IS STILL A FILE, and the bar used to draw
    # it as free space. The loop above plots the four largest entries; the
    # legend's free row computes total - s3du_used_bytes(), which sums ALL 32
    # directory slots. So on a volume holding five or more files the picture and
    # the figure printed directly beneath it reported different free space for
    # the same disk, and the picture was the optimistic one.
    #
    # The fifth segment is the same quantity the legend excludes: used bytes
    # that no plotted segment accounts for. Drawn in the ground-adjacent ink so
    # it reads as "occupied, not itemised" rather than as a fifth named file.
    sother = s3du_used_bytes()
    sk = 0
    while sk < S3DU_LEGN - 1 {
        sother = sother - s3du_part_bytes(sk)
        sk = sk + 1
    }
    if sother > 0 {
        sw3 = (iw - 2) * sother / total
        if sw3 > 0 { fill_rgb(sx, iy + 1, sw3, ih - 2, theme(TH_SURF_7)) }
        sx = sx + sw3
    }
    # the remainder is free, and it is the ground rather than an ink
    if sx < ix + iw - 1 { fill_rgb(sx, iy + 1, ix + iw - 1 - sx, ih - 2, theme(TH_SURF_WELL)) }
    return by + S3DU_BARH * ui() + 14 * ui()
}

# One legend row: a dot of the segment's colour, its name, its share right-flushed.
fn s3du_leg(lx, ly, lw, n, total) {
    ui_dot(lx + 4 * ui(), ly + pw_rowh() / 2, s3du_part_col(n), 0)
    lb = s3du_part_bytes(n)
    if n == S3DU_LEGN - 1 { lb = total - s3du_used_bytes() }
    if lb < 0 { lb = 0 }
    lcy = pw_celly(ly)
    if n == S3DU_LEGN - 1 { ui_txt(lx + 16 * ui(), lcy, "free", theme(TH_TEXT_2), PW_SM, 0) } else { s3du_name(n, lx + 16 * ui(), lcy, theme(TH_TEXT_2)) }
    lpc = 0
    if total > 0 { lpc = lb * 1000 / total }
    pw_decg(lx + lw - pw_decgw(lpc, 1, PW_SM, PW_MONO) - ui_tw(" %", PW_SM, PW_MONO), lcy, lpc, 1, theme(TH_TEXT_HI), PW_SM, PW_MONO)
    ui_txt(lx + lw - ui_tw(" %", PW_SM, PW_MONO), lcy, " %", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    pw_row_rule(lx, ly, lw)
    return ly + pw_rowh()
}

fn s3du_draw(ax, ay, aw, ah) {
    u = ui()
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    x = ax + S3DU_PAD_X * u
    w = aw - 2 * S3DU_PAD_X * u
    y = ay + S3DU_PAD_Y * u

    # R.disk's head: which volume, and whether it is sound. The reference reads
    # `rd0, zlfs, 4.0 MiB image  <dot> OK  0 orphan extents`; this says what
    # fs_ok() actually reports, because an unformatted volume is the state this
    # machine boots into and the reference never had one.
    ui_caps(x, y, "VOLUME", theme(TH_TEXT_2), T_CAPTION)
    if fs_ok() == 1 {
        label(x + 62 * u, y, "rd0, zlfs", theme(TH_TEXT_HI), T_CAPTION, W_REG)
        ui_dot(x + w - 96 * u, y + 5 * u, theme(TH_OK), 0)
        label_num(x + w - 84 * u, y, fs_n(), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label(x + w - 62 * u, y, "files mounted", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(x + 62 * u, y, "rd0, unformatted", theme(TH_TEXT_HI), T_CAPTION, W_REG)
        ui_dot(x + w - 96 * u, y + 5 * u, theme(TH_WARN), 0)
        label(x + w - 84 * u, y, "no volume", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    y = y + 22 * u

    # ---- THE COMPOSITION BAR AND ITS LEGEND, in the reference's order -------
    # The authority leads with what the volume is made of; the two stacked
    # mount rows below are the superseded document's layout and follow it.
    s3du_tot = s3du_tmp_total()
    y = s3du_bar(x, y + 6 * u, w, s3du_tot)
    # ONLY THE ROWS THAT NAME SOMETHING. The reference always has five parts
    # because its image always has five; this volume has as many files as it
    # has, and a legend row reading "0.0 %" beside no name is a row about
    # nothing. Free is always drawn, because free always exists.
    s3du_li = 0
    while s3du_li < S3DU_LEGN - 1 {
        if s3du_part_bytes(s3du_li) > 0 { y = s3du_leg(x, y, w, s3du_li, s3du_tot) }
        s3du_li = s3du_li + 1
    }
    y = s3du_leg(x, y, w, S3DU_LEGN - 1, s3du_tot)
    # the 2px struck rule, then the generation this volume is actually on
    fill_rgb(x, y + 4 * u, w, RULE_H * u, theme(TH_LIT))
    y = y + 4 * u + RULE_H * u + 6 * u
    ui_caps(x, y, "GENERATIONS", theme(TH_TEXT_2), T_CAPTION)
    # THE REFERENCE PRINTS THREE ROWS - 1, 2, 3 with roots and sizes - and they
    # are ITS image's history, not a reading. This machine knows exactly one
    # number about its own: dir_generation, bumped on every directory commit and
    # written into the superblock, so it survives a cold boot. That IS the
    # 1 -> 2 -> 3 the reference is illustrating, and it had no accessor until
    # now. One row that is read beats three that are quoted.
    if fs_ok() == 1 {
        num_aa(x + 110 * u, y, fs_gen(), theme(TH_TEXT_HI))
        label(x + 110 * u + s3_numw(fs_gen()), y, " - this volume, survives a cold boot", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(x + 110 * u, y, "no volume mounted - nothing to count", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    y = y + 22 * u
    # /dev/rd0 WAS A ROW ABOUT A DEVICE THIS KERNEL DOES NOT HAVE.
    #
    # It passed S3DU_RD0 - the literal 4194304, commented "ds 3769", a constant
    # copied out of the SUPERSEDED reference - as BOTH used and total, with
    # ok = 0. So every boot of every machine drew a 4 MiB volume reported 100%
    # full, bar filled edge to edge, flag and bar both in TH_DANGER. Three
    # invented figures and a failure colour, for a ramdisk that does not exist.
    #
    # The real block device here is the NVMe namespace, and nv_ok / nv_blocks /
    # nv_bsize are all bound. Capacity is READ from the controller. USED is not
    # reported for a raw namespace and nothing in this kernel tracks it, so the
    # row passes 0 and the bar draws empty - which is the true statement "we
    # know the size and not the occupancy", where a filled bar was the false
    # one. When the controller is absent the row says so rather than inventing
    # a device to be absent about.
    if nv_ok() == 1 {
        y = s3du_mount(x, y, w, "/dev/nvme0n1", "nvme namespace 1", 0, nv_blocks() * nv_bsize(), 1)
    } else {
        ui_txt(x, y, "/dev/nvme0n1", theme(TH_TEXT_HI), S3_MD, S3_BOLD)
        s3_mono(x + w - s3_mw("no controller"), y + 2 * u, "no controller", theme(TH_TEXT_DIM))
        y = y + 22 * u + ui_th(S3_MD) + 6 * u
    }
    y = y + S3DU_GAP * u
    # THE `ok` FLAG WAS THE LITERAL 1, WHICH IS THE ONE THING IT MUST NOT BE.
    # /tmp is zlfs, and when nothing is mounted fs_cap() and fs_free() are both
    # 0 - so used and total are both 0, the bar has nothing to divide by, and
    # this row drew a healthy green volume for a filesystem the kernel had
    # refused to mount. The Files pane three files away prints the refusal and
    # its cause on the same boot.
    y = s3du_mount(x, y, w, "/tmp", "read-write zlfs", s3du_tmp_used(), s3du_tmp_total(), fs_ok())
    y = y + S3DU_GAP * u

    # THE WRITE PATH AND WHAT PROVES IT. The reference closes on two kv rows,
    # and both are true of this filesystem rather than borrowed: zlfs journals
    # then swaps the superblock, and the generation sequence 1 -> 2 -> 3 was
    # verified across three cold boots - a power cycle between each, which is
    # the only way to prove a filesystem survives one.
    # SHORTENED TO THE WINDOW. This app is 456 design units wide and the
    # reference's full sentences ran past its right edge - a row clipped
    # mid-word says less than a shorter one that finishes.
    s3_mono(x, y, "write path", theme(TH_TEXT_DIM))
    s3_mono(x + 78 * u, y, "cow, journal then superblock swap", theme(TH_TEXT))
    y = y + 16 * u
    s3_mono(x, y, "verified", theme(TH_TEXT_DIM))
    s3_mono(x + 78 * u, y, "gen 1-2-3, three cold boots", theme(TH_TEXT))
    y = y + 20 * u

    s3_heading(x, y, "LARGEST FILES ON RD0")
    y = y + 19 * u

    top = s3du_at_rank(0)
    if top < 0 {
        ui_txt(x, y + 4 * u, "volume not mounted - nothing to size", theme(TH_TEXT_DIM), S3_MD, 0)
        return 0
    }
    mx = fs_bytes(top)
    if mx < 1 { mx = 1 }
    r = 0
    while r < S3DU_ROWS {
        slot = s3du_at_rank(r)
        if slot < 0 { r = S3DU_ROWS } else {
            ry = y + r * 23 * u
            if ry + 20 * u < ay + ah {
                # the path, byte by byte - there are no string values here, so
                # a real filename is drawn from fs_ch() one character at a time
                nc = 0
                while nc < 40 {
                    ch = fs_ch(slot, nc)
                    if ch == 0 { nc = 40 } else {
                        char_aa(x + nc * cell_w(), ry + 4 * u, ch, theme(TH_TEXT))
                        nc = nc + 1
                    }
                }
                bx = x + w - 84 * u - 54 * u - 9 * u
                ui_meter(bx, ry + 9 * u, 84 * u, fs_bytes(slot) * 100 / mx, theme(TH_ACCENT))
                s3_num_r(x + w, ry + 4 * u, fs_bytes(slot), theme(TH_TEXT_DIM))
                # ds 419: `border-bottom:1px solid #101215` on a body that
                # inherits the window's own #101215. The rule is the same
                # colour as what it sits on, so it is invisible IN THE
                # REFERENCE. Kept, because this is a clone - do not "fix" it
                # to TH_BORDER without changing the reference first.
                fill_rgb(x, ry + 22 * u, w, u, theme(TH_PANEL))
            }
            r = r + 1
        }
    }
    return 0
}

# ==============================================================================
# 47 - Services, 596 x 392.  ds-reference.html 429-467, svcTabs 3787,
# svcUnits 3798, svcCalls 3822.
#
# An underline tab strip (S4.2 - the 2px inset underline is the WHOLE
# affordance; there is no background change), unit rows with a status dot, a
# mono name, an uppercase state badge, a second line and per-row action pills;
# and a Syscalls tab that is a mono trace table on a sunken ground.
#
# THE UNITS ARE THIS KERNEL'S OWN SUBSYSTEMS, probed live. Every predicate
# below is a cached read (xhci_present, nvme_ready, virtio_net_ready,
# apic_active, smp_online, intel_supported, fs_mounted, rtc_valid,
# i2c_hid_ready, sched_active) - nothing here scans a bus or brings a device
# up, because app_draw runs on every repaint. usb_up/net_up/xhci_bringup are
# deliberately NOT called from draw: they mutate.
#
# present-but-not-ready is a real FAILED, not a decoration: an NVMe controller
# found with no namespace, a NIC that never negotiated, a disk present with
# zlfs unmounted.
# ==============================================================================
S3SV_TAB_H = 32
S3SV_ROW   = 46
S3SV_N     = 10
s3sv_tab = 0                         # 0 Units, 1 Syscalls
s3sv_sel = 0 - 1

fn s3sv_name(i) {
    if i == 0 { return "xhci.service" }
    if i == 1 { return "nvme.service" }
    if i == 2 { return "virtio-net.service" }
    if i == 3 { return "apic.service" }
    if i == 4 { return "smp.service" }
    if i == 5 { return "i915.service" }
    if i == 6 { return "zlfs.mount" }
    if i == 7 { return "rtc.service" }
    if i == 8 { return "i2c-hid.service" }
    return "sched.service"
}
fn s3sv_desc(i) {
    if i == 0 { return "USB 3 host controller - HID and mass storage" }
    if i == 1 { return "NVMe namespace 1 - the zlfs backing store" }
    if i == 2 { return "paravirtual NIC - ARP, IPv4 and TCP" }
    if i == 3 { return "local APIC and IO-APIC interrupt routing" }
    if i == 4 { return "application processors, trampolined from 16-bit" }
    if i == 5 { return "Intel Gen9 display - pipe, plane and panel power" }
    if i == 6 { return "block filesystem, mounted on /tmp" }
    if i == 7 { return "CMOS real-time clock and the 100 Hz tick" }
    if i == 8 { return "I2C HID transport - the ThinkPad touchpad" }
    return "cooperative scheduler - after apic.service"
}
fn s3sv_present(i) {
    if i == 0 { return usb_ok() }
    if i == 1 { return nv_ok() }
    if i == 2 { return net_there() }
    if i == 3 { return apic_on() }
    if i == 4 { if smp_n() > 0 { return 1 }  return 0 }
    if i == 5 { return intel_ok() }
    if i == 6 { return nv_ok() }
    if i == 7 { return rtc_ok() }
    if i == 8 { return i2c_ok() }
    return 1
}
fn s3sv_ready(i) {
    if i == 0 { return usb_ok() }
    if i == 1 { return nv_ready() }
    if i == 2 { return net_ok() }
    if i == 3 { return apic_on() }
    if i == 4 { if smp_n() > 1 { return 1 }  return 0 }
    if i == 5 { return intel_ok() }
    if i == 6 { return fs_ok() }
    if i == 7 { return rtc_ok() }
    if i == 8 { return tp_ok() }
    return sched_on()
}
# 0 active, 1 failed, 3 inactive - the reference's own state vocabulary minus
# `activating`, which nothing here can be: these probes are level, not edges.
fn s3sv_state(i) {
    if s3sv_ready(i) == 1 { return 0 }
    if s3sv_present(i) == 1 { return 1 }
    return 3
}
fn s3sv_state_col(s) {
    if s == 0 { return theme(TH_OK) }
    if s == 1 { return theme(TH_DANGER) }
    return theme(TH_BORDER)          # ds #474b50; TH_BORDER is the nearest role
}
fn s3sv_state_text(s) {
    if s == 0 { return "ACTIVE" }
    if s == 1 { return "FAILED" }
    return "INACTIVE"
}
fn s3sv_count(want) {
    n = 0
    i = 0
    while i < S3SV_N {
        if s3sv_state(i) == want { n = n + 1 }
        i = i + 1
    }
    return n
}

# The action pill, ds 3805: padding 3px 9px, radius 8, 10px - that is
# ZD_PILL_SM (3/9, radius 9), so `restart` and `stop` are plain ui_pill.
# `start` is not: the toolkit has no OK-tinted button kind and the reference's
# start button is rgba(169,227,75,.14) over #c7f36a text.
#
# THE KIND NUMBERS HERE ARE THIS FUNCTION'S OWN, not ui.h's, and they have to
# be: the first version took ui.h kinds directly and tested `if kind == 2` for
# the OK case - which is UI_BTN_DANGER's value, so `stop` and `start` rendered
# identically. Same value, two vocabularies, no compiler to notice.
S3SV_ACT_RESTART = 0
S3SV_ACT_STOP    = 1
S3SV_ACT_START   = 2
fn s3sv_action_w(s) { return ui_pill_w(s, S3_SM, 0) }
fn s3sv_action(x, y, s, act) {
    u = ui()
    w = ui_pill_w(s, S3_SM, 0)
    h = ui_pill_h(S3_SM)
    if act == S3SV_ACT_START {
        rrblend(x, y, w, h, 8 * u, theme(TH_OK), 36)
        ui_txt(x + 9 * u, y + 3 * u, s, theme(TH_OK), S3_SM, 0)
        return w
    }
    k = S3_BTN_NEUTRAL
    if act == S3SV_ACT_STOP { k = S3_BTN_DANGER }
    ui_pill(x, y, w, h, s, S3_SM, k, 0)
    return w
}

fn s3sv_tab_w(ti) {
    s = "Units"
    if ti == 1 { s = "Syscalls" }
    return ui_tw(s, S3_MD, 0) + 30 * ui()
}

fn s3sv_tabs(ax, ay, aw) {
    u = ui()
    ui_tb(ax, ay, aw, S3SV_TAB_H * u, 1)   # #14171a with a bottom rule - S5
    tx = ax
    ti = 0
    while ti < 2 {
        s = "Units"
        if ti == 1 { s = "Syscalls" }
        tw = s3sv_tab_w(ti)
        c = theme(TH_TEXT_DIM)
        if s3sv_tab == ti { c = theme(TH_TEXT_HI) }
        ui_txt(tx + 15 * u, ay + 9 * u, s, c, S3_MD, 0)
        if s3sv_tab == ti { fill_rgb(tx, ay + S3SV_TAB_H * u - 3 * u, tw, 2 * u, theme(TH_ACCENT)) }
        tx = tx + tw
        ti = ti + 1
    }
    # svcSummary, right-aligned mono. Built from live counts; there are no
    # runtime strings, so it is number + literal, number + literal.
    act = s3sv_count(0)
    fail = s3sv_count(1)
    sw = s3_numw(act) + s3_mw(" active ") + s3_numw(fail) + s3_mw(" failed ") + s3_numw(S3SV_N) + s3_mw(" units")
    sx = ax + aw - 11 * u - sw
    sy = ay + 8 * u
    num_aa(sx, sy, act, theme(TH_TEXT_DIM))
    sx = sx + s3_numw(act)
    s3_mono(sx, sy, " active ", theme(TH_TEXT_DIM))
    sx = sx + s3_mw(" active ")
    num_aa(sx, sy, fail, theme(TH_TEXT_DIM))
    sx = sx + s3_numw(fail)
    s3_mono(sx, sy, " failed ", theme(TH_TEXT_DIM))
    sx = sx + s3_mw(" failed ")
    num_aa(sx, sy, S3SV_N, theme(TH_TEXT_DIM))
    sx = sx + s3_numw(S3SV_N)
    s3_mono(sx, sy, " units", theme(TH_TEXT_DIM))
    return 0
}

fn s3sv_units(ax, ay, aw, ah) {
    u = ui()
    i = 0
    while i < S3SV_N {
        ry = ay + i * S3SV_ROW * u
        if ry < ay + ah {
            st = s3sv_state(i)
            col = s3sv_state_col(st)
            if s3sv_sel == i {
                blend(ax, ry, aw, S3SV_ROW * u, theme(TH_ACCENT), 18)
                fill_rgb(ax, ry, 2 * u, S3SV_ROW * u, theme(TH_ACCENT))
            }
            glow = 0
            if st == 0 { glow = 1 }
            ui_dot(ax + 12 * u, ry + 20 * u, col, glow)
            tx = ax + 12 * u + ui_dot_sz() + 10 * u
            s3_mono(tx, ry + 8 * u, s3sv_name(i), theme(TH_TEXT_HI))
            ui_badge(tx + s3_mw(s3sv_name(i)) + 7 * u, ry + 7 * u, s3sv_state_text(st), col)
            ui_txt(tx, ry + 26 * u, s3sv_desc(i), theme(TH_TEXT_DIM), S3_SM, 0)
            # actions, laid out from the right edge inwards
            if st == 0 {
                w2 = s3sv_action_w("stop")
                w1 = s3sv_action_w("restart")
                s3sv_action(ax + aw - 12 * u - w2, ry + 14 * u, "stop", S3SV_ACT_STOP)
                s3sv_action(ax + aw - 12 * u - w2 - 7 * u - w1, ry + 14 * u, "restart", S3SV_ACT_RESTART)
            } else {
                w1 = s3sv_action_w("start")
                s3sv_action(ax + aw - 12 * u - w1, ry + 14 * u, "start", S3SV_ACT_START)
            }
            fill_rgb(ax, ry + S3SV_ROW * u - u, aw, u, theme(TH_PANEL))
        }
        i = i + 1
    }
    return 0
}

# The Syscalls tab. zlOS has no syscall HISTORY to replay - there is no
# process table and no trace buffer - so this is the same five-column mono
# table over the calls the kernel makes to bring each subsystem up, with the
# REAL return of each one in the ok column and a real device figure in the
# argument column. `t` is this frame's tick counted backwards one row at a
# time so the column reads as a trace; it is the only synthesised number on
# the screen, and it is synthesised here rather than pretended about.
S3SV_CALLS = 12
fn s3sv_call_name(i) {
    if i == 0 { return "mount" }
    if i == 1 { return "openat" }
    if i == 2 { return "ioctl" }
    if i == 3 { return "read" }
    if i == 4 { return "socket" }
    if i == 5 { return "bind" }
    if i == 6 { return "ioctl" }
    if i == 7 { return "mmap" }
    if i == 8 { return "clone" }
    if i == 9 { return "ioctl" }
    if i == 10 { return "sched_yield" }
    return "statfs"
}
fn s3sv_call_arg(i) {
    if i == 0 { return "zlfs -> /tmp" }
    if i == 1 { return "/dev/nvme0n1" }
    if i == 2 { return "xhci: RESET" }
    if i == 3 { return "rtc: cmos 0x0b" }
    if i == 4 { return "AF_INET SOCK_DGRAM" }
    if i == 5 { return "ipv4: 0.0.0.0:0" }
    if i == 6 { return "ioapic: redir 1" }
    if i == 7 { return "i915: BAR0 8 MiB" }
    if i == 8 { return "smp: ap trampoline" }
    if i == 9 { return "i2c-hid: descriptor" }
    if i == 10 { return "sched: run queue" }
    return "/tmp free blocks"
}
fn s3sv_call_ok(i) {
    if i == 0 { return fs_ok() }
    if i == 1 { return nv_ready() }
    if i == 2 { return usb_ok() }
    if i == 3 { return rtc_ok() }
    if i == 4 { return net_ok() }
    if i == 5 { return ip_live() }
    if i == 6 { return apic_on() }
    if i == 7 { return intel_ok() }
    if i == 8 { if smp_n() > 1 { return 1 }  return 0 }
    if i == 9 { return tp_ok() }
    if i == 10 { return sched_on() }
    return fs_ok()
}

fn s3sv_calls(ax, ay, aw, ah) {
    u = ui()
    ui_mono(ax, ay, aw, ah, S3_PANEL_HEX)    # S14: the syscall-trace ground
    i = 0
    while i < S3SV_CALLS {
        ry = ay + 5 * u + i * 20 * u
        if ry + 16 * u < ay + ah {
            s3_num_r(ax + 64 * u, ry, ticks() - (S3SV_CALLS - 1 - i), theme(TH_BORDER))
            # NOT THE LITERAL 1. zlOS has no process table - this pane's own
            # header says so - and the reference renders this column as
            # `pid: c.pid ? String(c.pid) : '-'`, supplying '-' for exactly the
            # case where there is no process id. Printing 1 on all twelve rows
            # asserted a pid that does not exist, in the numeric column, which
            # reads as measured.
            s3_mono(ax + 107 * u - s3_mw("-"), ry, "-", theme(TH_TEXT_DIM))
            okv = s3sv_call_ok(i)
            cc = theme(TH_ACCENT)
            if okv == 0 { cc = theme(TH_DANGER) }
            s3_mono(ax + 116 * u, ry, s3sv_call_name(i), cc)
            s3_mono(ax + 217 * u, ry, s3sv_call_arg(i), theme(TH_TEXT_DIM))
            if okv == 1 {
                s3_mono(ax + aw - 12 * u - s3_mw("ok"), ry, "ok", theme(TH_OK))
            } else {
                s3_mono(ax + aw - 12 * u - s3_mw("ENODEV"), ry, "ENODEV", theme(TH_DANGER))
            }
        }
        i = i + 1
    }
    return 0
}

fn s3sv_draw(ax, ay, aw, ah) {
    u = ui()
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    s3sv_tabs(ax, ay, aw)
    by = ay + S3SV_TAB_H * u
    bh = ah - S3SV_TAB_H * u
    if s3sv_tab == 0 { return s3sv_units(ax, by, aw, bh) }
    return s3sv_calls(ax, by, aw, bh)
}

fn s3sv_event(win, ety, ecode, ex, ey) {
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    aw = wm_cw(win)
    if cy < S3SV_TAB_H * u {
        tx = 0
        ti = 0
        while ti < 2 {
            tw = s3sv_tab_w(ti)
            if cx >= tx { if cx < tx + tw { s3sv_tab = ti  wm_dmg(win)  return 1 } }
            tx = tx + tw
            ti = ti + 1
        }
        return 0
    }
    if s3sv_tab != 0 { return 0 }
    row = idiv(cy - S3SV_TAB_H * u, S3SV_ROW * u)  # idiv: a row INDEX
    if row < 0 { return 0 }
    if row >= S3SV_N { return 0 }
    # `start` on zlfs.mount is the one action this kernel can honestly
    # perform: fs_mount() is idempotent and non-destructive. Every other pill
    # selects the unit - zlOS cannot restart a driver it never stopped, and a
    # button that pretends to is worse than one that does not claim to.
    if row == 6 {
        w1 = s3sv_action_w("start")
        if s3sv_state(6) != 0 { if cx >= aw - 12 * u - w1 { if cx < aw - 12 * u {
                    fs_mount()
                    s3sv_sel = row
                    wm_dmg(win)
                    return 1
        }}}
    }
    s3sv_sel = row
    wm_dmg(win)
    return 1
}

# ==============================================================================
# 48 - Archive Manager, 590 x 384.  ds-reference.html 469-510, archGrid 4160,
# archRows 4167, archStats 4187, the empty state 4158 + 505-508.
#
# A toolbar, a six-column grid, a stat strip - AND AN EMPTY STATE, which is
# the screen the reference actually renders: `archEmpty: !st.arch` and nothing
# opens an archive at boot. A specified screen, not a placeholder.
#
# The members are the real zlfs directory and the ustar arithmetic is real:
# one 512-byte header block per member plus ceil(size/512) data blocks, plus
# two zero blocks at end-of-archive. "archive size", "payload", "blocks" and
# "block overhead" are computed from the volume, not typed in.
# ==============================================================================
S3AR_TB   = 36
S3AR_HEAD = 24
S3AR_ROW  = 25
s3ar_open = 0
s3ar_sel  = 0 - 1

fn s3ar_count() {
    n = 0
    i = 0
    while i < S3DU_SLOTS {
        if fs_inuse(i) == 1 { n = n + 1 }
        i = i + 1
    }
    return n
}
fn s3ar_slot_at(k) {
    n = 0
    i = 0
    while i < S3DU_SLOTS {
        if fs_inuse(i) == 1 {
            if n == k { return i }
            n = n + 1
        }
        i = i + 1
    }
    return 0 - 1
}
fn s3ar_payload() {
    n = 0
    i = 0
    while i < S3DU_SLOTS {
        if fs_inuse(i) == 1 { n = n + fs_bytes(i) }
        i = i + 1
    }
    return n
}
# 1 header block + ceil(size/512) data blocks per member, + 2 zero blocks.
fn s3ar_blocks() {
    n = 2
    i = 0
    while i < S3DU_SLOTS {
        if fs_inuse(i) == 1 { n = n + 1 + (fs_bytes(i) + 511) / 512 }
        i = i + 1
    }
    return n
}

fn s3ar_toolbar(ax, ay, aw) {
    u = ui()
    ui_tb(ax, ay, aw, S3AR_TB * u, 1)
    by = ay + (S3AR_TB * u - ui_pill_h(S3_MD)) / 2
    x = ax + 10 * u
    x = x + s3_btn(x, by, "Create archive", S3_BTN_PRIMARY, S3_BOLD) + 7 * u
    x = x + s3_btn(x, by, "Verify", S3_BTN_NEUTRAL, 0) + 7 * u
    s3_btn(x, by, "Extract to /tmp", S3_BTN_NEUTRAL, 0)
    s3_mono(ax + aw - 10 * u - s3_mw("/tmp/build.tar"), ay + 10 * u, "/tmp/build.tar", theme(TH_TEXT_DIM))
    return 0
}

fn s3ar_empty(ax, ay, aw, ah) {
    u = ui()
    cy = ay + ah / 2 - 40 * u
    icon(ax + aw / 2 - 12 * u, cy, 7, theme(TH_BORDER))
    ty = cy + 44 * u
    l1 = "No archive open. Create one to pack the source"
    l2 = "tree into a POSIX ustar file, then open it in the"
    l3 = "Hex Viewer to read the 512-byte headers."
    ui_txt(ax + aw / 2 - ui_tw(l1, S3_MD, 0) / 2, ty, l1, theme(TH_TEXT_DIM), S3_MD, 0)
    ui_txt(ax + aw / 2 - ui_tw(l2, S3_MD, 0) / 2, ty + 19 * u, l2, theme(TH_TEXT_DIM), S3_MD, 0)
    ui_txt(ax + aw / 2 - ui_tw(l3, S3_MD, 0) / 2, ty + 38 * u, l3, theme(TH_TEXT_DIM), S3_MD, 0)
    return 0
}

# c0 is the 1fr Member track; the other five are fixed, ds 4160.
fn s3ar_col_x(ax, aw, col) {
    u = ui()
    x = ax + 4 * u
    if col == 0 { return x }
    x = x + aw - 19 * u - 302 * u
    if col == 1 { return x }
    x = x + 66 * u
    if col == 2 { return x }
    x = x + 62 * u
    if col == 3 { return x }
    x = x + 62 * u
    if col == 4 { return x }
    return x + 54 * u
}
fn s3ar_col_name(col) {
    if col == 0 { return "Member" }
    if col == 1 { return "Size" }
    if col == 2 { return "Mode" }
    if col == 3 { return "Owner" }
    if col == 4 { return "Magic" }
    return "Checksum"
}

fn s3ar_header(ax, ay, aw) {
    u = ui()
    ui_tb(ax, ay, aw, S3AR_HEAD * u, 1)
    c = 0
    while c < 6 {
        s = s3ar_col_name(c)
        if c == 1 {
            ui_txt(s3ar_col_x(ax, aw, 1) + 56 * u - ui_tw(s, S3_SM, 0), ay + 6 * u, s, theme(TH_TEXT_DIM), S3_SM, 0)
        } else {
            ui_txt(s3ar_col_x(ax, aw, c) + 8 * u, ay + 6 * u, s, theme(TH_TEXT_DIM), S3_SM, 0)
        }
        c = c + 1
    }
    return 0
}

fn s3ar_rows(ax, ay, aw, ah) {
    u = ui()
    n = s3ar_count()
    k = 0
    while k < n {
        ry = ay + k * S3AR_ROW * u
        if ry + S3AR_ROW * u > ay + ah { k = n } else {
            slot = s3ar_slot_at(k)
            on = 0
            if s3ar_sel == slot { on = 1 }
            if on == 1 { fill_rgb(ax, ry, aw, S3AR_ROW * u, theme(TH_ACCENT)) }
            if on == 0 { if k % 2 == 1 { blend(ax, ry, aw, S3AR_ROW * u, theme(TH_TEXT_HI), 3) } }
            # `oc` was the "valid" ink and went with the fabricated checksum -
            # -Werror=unused-but-set-variable caught the leftover, which is the
            # guard doing its job on a deletion that stopped one line short.
            nc = theme(TH_TEXT_HI)
            dc = theme(TH_TEXT_DIM)
            if on == 1 {
                nc = ui_ink_on(theme(TH_ACCENT))
                dc = nc
            }
            ty = ry + 5 * u
            ci = 0
            while ci < 40 {
                ch = fs_ch(slot, ci)
                if ch == 0 { ci = 40 } else {
                    char_aa(s3ar_col_x(ax, aw, 0) + 8 * u + ci * cell_w(), ty, ch, nc)
                    ci = ci + 1
                }
            }
            s3_num_r(s3ar_col_x(ax, aw, 1) + 56 * u, ty, fs_bytes(slot), dc)
            # THREE FABRICATED COLUMNS. zlfs has no mode field, no uid, no gid
            # and no ustar header - this pane's own comment says the archive is
            # a PROJECTION of the directory. "0644" and "root/root" invent a
            # permission model and an owner; "ustar" names a format that is not
            # on the disk. All three read as facts about the file because they
            # sit in a table of facts about the file.
            s3_mono(s3ar_col_x(ax, aw, 2) + 8 * u, ty, "-", theme(TH_TEXT_DIM))
            s3_mono(s3ar_col_x(ax, aw, 3) + 8 * u, ty, "-", theme(TH_TEXT_DIM))
            s3_mono(s3ar_col_x(ax, aw, 4) + 8 * u, ty, "-", theme(TH_TEXT_DIM))
            # "valid" WAS A FLAG, NOT A CHECK. The Verify pill's whole handler
            # was `s3ar_verified = 1` - no byte was read, nothing was summed -
            # and this column keyed off that flag, so pressing Verify printed
            # "valid" against every member. There is nothing to sum: this pane's
            # own header says the archive is a PROJECTION of the zlfs directory,
            # and no ustar header exists on the volume to checksum.
            #
            # A checksum column that says "valid" for a checksum that was never
            # computed is the worst version of an invented figure - it is a
            # claim about integrity, which is the one thing a user would act on.
            s3_mono(s3ar_col_x(ax, aw, 5) + 8 * u, ty, "-", dc)
            k = k + 1
        }
    }
    return 0
}

# The unit lives in the KEY rather than the value: zl cannot build "34 x 512
# B" at runtime, and ui_statn takes an integer. An uppercase key is where the
# reference already puts its units-ish words, so this reads as designed rather
# than as a missing suffix.
fn s3ar_stats(ax, ay, aw) {
    pay = s3ar_payload()
    blk = s3ar_blocks()
    size = blk * 512
    over = 0
    if size > 0 { over = 100 - pay * 100 / size }
    ui_stat(ax, ay, aw, s3_stat_min(aw, 5))
    ui_statn("MEMBERS", s3ar_count(), theme(TH_TEXT))
    ui_statn("ARCHIVE SIZE B", size, theme(TH_TEXT))
    ui_statn("PAYLOAD B", pay, theme(TH_TEXT))
    ui_statn("BLOCK OVERHEAD %", over, theme(TH_ACCENT))   # ds WARN; no zl role
    ui_statn("BLOCKS x 512 B", blk, theme(TH_TEXT_DIM))
    ui_stat_end()
    return 0
}

fn s3ar_draw(ax, ay, aw, ah) {
    u = ui()
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    s3ar_toolbar(ax, ay, aw)
    by = ay + S3AR_TB * u
    bh = ah - S3AR_TB * u
    if s3ar_open == 0 { return s3ar_empty(ax, by, aw, bh) }
    sh = s3_stat_h()
    s3ar_header(ax, by, aw)
    s3ar_rows(ax, by + S3AR_HEAD * u, aw, bh - S3AR_HEAD * u - sh)
    s3ar_stats(ax, ay + ah - sh, aw)
    return 0
}

fn s3ar_event(win, ety, ecode, ex, ey) {
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    ah = wm_ch(win)
    if cy < S3AR_TB * u {
        x = 10 * u
        w = s3_btn_w("Create archive", S3_BOLD)
        if cx >= x { if cx < x + w {
                if fs_ok() == 0 { fs_mount() }
                if s3ar_count() > 0 { s3ar_open = 1 }
                wm_dmg(win)
                return 1
        }}
        x = x + w + 7 * u
        w = s3_btn_w("Verify", 0)
        if cx >= x { if cx < x + w {
                # The pill stays because the reference's toolbar has it; what
                # it does is say why it cannot do anything, which is true and
                # is more than setting a flag was.
                note_say2("nothing to verify", "this archive is a view of the zlfs directory - there are no ustar headers to sum", 900)
                wm_dmg(win)
                return 1
        }}
        # "Extract to /tmp" is drawn because it is in the reference's toolbar
        # and is INERT here, deliberately: zlfs IS /tmp, so extracting an
        # archive of /tmp back into /tmp would duplicate every member. A
        # control that changes nothing must not claim a repaint, so this falls
        # through to `return 0` rather than calling wm_dmg.
        return 0
    }
    if s3ar_open == 0 { return 0 }
    ry = cy - S3AR_TB * u - S3AR_HEAD * u
    if ry < 0 { return 0 }
    if cy > ah - s3_stat_h() { return 0 }
    slot = s3ar_slot_at(idiv(ry, S3AR_ROW * u))   # idiv: a slot INDEX
    if slot < 0 { return 0 }
    s3ar_sel = slot
    wm_dmg(win)
    return 1
}

# ==============================================================================
# 49 - Image Viewer, 520 x 410.  ds-reference.html 512-533, imgTabs 4203,
# imgZoom 4208, imgStats 4213.
#
# THE CANVAS IS BLANK IN THE REFERENCE TOO. ds.html imports seven sibling
# modules that were never delivered, so loadImage() never runs: state 1263 is
# `imgPath:null, imgInfo:null, imgScale:3` - no file tab is lit, the 3x zoom
# pill IS lit, and imgStats collapses to ONE cell reading "none loaded". That
# is what is reproduced here: the shell exactly, not an invented picture.
# ==============================================================================
S3IV_TB = 34
s3iv_sel  = 0 - 1                     # ds imgPath: null - no tab is active
s3iv_zoom = 3                         # ds imgScale: 3

fn s3iv_tab_name(i) {
    if i == 0 { return "gradient.ppm" }
    if i == 1 { return "plasma.ppm" }
    return "mandelbrot.pgm"
}
fn s3iv_zoom_name(z) {
    if z == 1 { return "1x" }
    if z == 2 { return "2x" }
    if z == 3 { return "3x" }
    return "4x"
}
# imgTabs are 5px 11px radius 10; imgZoom 5px 9px radius 9. ZD_PILL_SM is
# 3px 9px radius 9 - the zoom pill exactly, and the file tab within 2px.
fn s3iv_tab_w(i) { return ui_pill_w(s3iv_tab_name(i), S3_SM, S3_MONO) + 4 * ui() }
fn s3iv_zoom_w(z) { return ui_pill_w(s3iv_zoom_name(z), S3_SM, S3_MONO) }

fn s3iv_toolbar(ax, ay, aw) {
    u = ui()
    ui_tb(ax, ay, aw, S3IV_TB * u, 1)
    ph = ui_pill_h(S3_SM)
    py = ay + (S3IV_TB * u - ph) / 2
    x = ax + 9 * u
    i = 0
    while i < 3 {
        w = s3iv_tab_w(i)
        k = S3_BTN_NEUTRAL
        if s3iv_sel == i { k = S3_BTN_PRIMARY }
        ui_pill(x, py, w, ph, s3iv_tab_name(i), S3_SM, k, S3_MONO)
        x = x + w + 5 * u
        i = i + 1
    }
    zw = 0
    z = 1
    while z < 5 { zw = zw + s3iv_zoom_w(z) + 5 * u  z = z + 1 }
    zx = ax + aw - 9 * u - zw + 5 * u
    z = 1
    while z < 5 {
        w = s3iv_zoom_w(z)
        k = S3_BTN_NEUTRAL
        if s3iv_zoom == z { k = S3_BTN_PRIMARY }
        ui_pill(zx, py, w, ph, s3iv_zoom_name(z), S3_SM, k, S3_MONO)
        zx = zx + w + 5 * u
        z = z + 1
    }
    return 0
}

fn s3iv_draw(ax, ay, aw, ah) {
    u = ui()
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    s3iv_toolbar(ax, ay, aw)
    sh = s3_stat_h()
    # the canvas: #07080a and empty, exactly as the reference renders it
    fill_rgb(ax, ay + S3IV_TB * u, aw, ah - S3IV_TB * u - sh, theme(TH_BG))
    ui_stat(ax, ay + ah - sh, aw, s3_stat_min(aw, 1))
    ui_statc("IMAGE", "none loaded", theme(TH_TEXT_DIM))
    ui_stat_end()
    return 0
}

fn s3iv_event(win, ety, ecode, ex, ey) {
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    aw = wm_cw(win)
    if cy >= S3IV_TB * u { return 0 }
    x = 9 * u
    i = 0
    while i < 3 {
        w = s3iv_tab_w(i)
        if cx >= x { if cx < x + w { s3iv_sel = i  wm_dmg(win)  return 1 } }
        x = x + w + 5 * u
        i = i + 1
    }
    zw = 0
    z = 1
    while z < 5 { zw = zw + s3iv_zoom_w(z) + 5 * u  z = z + 1 }
    zx = aw - 9 * u - zw + 5 * u
    z = 1
    while z < 5 {
        w = s3iv_zoom_w(z)
        if cx >= zx { if cx < zx + w { s3iv_zoom = z  wm_dmg(win)  return 1 } }
        zx = zx + w + 5 * u
        z = z + 1
    }
    return 0
}

# ==============================================================================
# 50 - Network, 560 x 380.  ds-reference.html 583-621, netIfaces 4032,
# netRows 4049, pingLines 4060.
#
# A 158px sidebar of interfaces (S9.1), a toolbar with an up/down toggle and a
# ping button, a mono key/value grid and a ping-output panel.
#
# Everything is a live read of net.c and ip: virtio_net_present/ready, the
# tx/rx and drop counters, and net_ping's own sent/received/lost/min/avg/max.
# The addresses are DERIVED from kernel.zl's NET_ME / NET_GW rather than
# spelled out, so a change there cannot leave this screen quietly wrong.
#
# The driver value is red for a non-loopback interface. That is the
# reference's own rule (`{k:'driver', v:d.drv, bad:d.n !== 'lo'}`, ds 4054)
# and it is reproduced rather than corrected - this is a clone.
# ==============================================================================
S3NW_SIDE = 158
S3NW_ROW  = 44
S3NW_KV   = 8
S3NW_LOOPBACK = 2130706433            # 127.0.0.1
s3nw_sel  = 1                         # eth0, the interface with anything to say

# ---- THE LOOPBACK ROW IS INVENTED END TO END --------------------------------
#
# Six typed figures for a device this kernel does not have. There is no loopback
# in this tree at all - no lo device, no 127.0.0.1 route, nothing that would
# answer a packet sent to it - and yet the row asserted UP unconditionally, an
# address, an MTU of 65536, and rx 0 / tx 0 as MEASUREMENTS rather than as the
# absence of a device.
#
# The 65536 is the sharpest of them: that is Linux's loopback MTU, a fact about
# the machine this OS is compiled on, sitting in a table describing the machine
# it runs on. The same class as the clocks pane's NTP claim, which took two
# passes to remove.
#
# The row is kept, because the reference has two interfaces and the shape is
# the reference's - but it now says what is true: absent. A row that reports
# "not present" is a reading. A row that reports UP for something that does not
# exist is not.
fn s3nw_present(i) { if i == 0 { return 0 }  return 1 }
fn s3nw_up(i) {
    if i == 0 { return 0 }          # there is no loopback device in this kernel
    return net_ok()
}
fn s3nw_name(i) { if i == 0 { return "lo" }  return "eth0" }
# MTU IS READ FOR THE ONE INTERFACE THAT HAS ONE, and refused for the one that
# does not. 1500 is virtio-net's own frame ceiling and is a property of this
# driver; 65536 was the build host's.
fn s3nw_mtu(i) { if i == 0 { return 0 }  return 1500 }
# THE DRIVER IS READ, NOT TYPED. This returned the literal "virtio-net" for
# every non-loopback interface while netdev_kind() sat bound and unused - and
# the same pane's own head had already shipped a hardcoded "e1000e" beside this
# line's "virtio-net", which is how the bug was found the first time. The rail's
# subtitle had the third copy of it.
#
# The values are netdev.h's enum (NONE 0, VIRTIO 1, E1000 2, CDC_ECM 3). They
# are written as bare numbers rather than as a cited mirror because
# check-header-mirror.py compares against #define, and these are enumerators -
# a citation it cannot resolve would fail the build rather than guard anything.
fn s3nw_drv(i) {
    if i == 0 { return "not present" }
    if net_kind() == 1 { return "virtio-net" }
    if net_kind() == 2 { return "e1000" }
    if net_kind() == 3 { return "cdc-ecm" }
    return "no driver"
}
# THE LEASED ADDRESS WINS OVER THE COMPILE-TIME ONE. NET_ME is the static
# fallback this image was built with; dhcp_address() is what the machine was
# actually given, and DHCP runs every frame. Printing the constant while a lease
# is held shows an address the machine is not using.
fn s3nw_addr(i) {
    if i == 0 { return S3NW_LOOPBACK }
    if dhcp_ip() != 0 { return dhcp_ip() }
    return NET_ME
}
fn s3nw_rx(i) { if i == 0 { return 0 }  return net_rx() }
fn s3nw_tx(i) { if i == 0 { return 0 }  return net_tx() }

# a.b.c.d, drawn from the packed address - there are no string values here.
# Returns the width consumed so a caller can lay something out after it.
fn s3nw_ip(x, y, ip, c) {
    px = x
    q = 3
    while q >= 0 {
        p = 1
        k = 0
        while k < q { p = p * 256  k = k + 1 }
        v = (ip / p) % 256
        num_aa(px, y, v, c)
        px = px + s3_numw(v)
        if q > 0 { char_aa(px, y, 46, c)  px = px + cell_w() }
        q = q - 1
    }
    return px - x
}

fn s3nw_sidebar(ax, ay, ah) {
    u = ui()
    fill_rgb(ax, ay, S3NW_SIDE * u, ah, theme(TH_PANEL_HI))
    fill_rgb(ax + S3NW_SIDE * u - u, ay, u, ah, theme(TH_CHROME_LINE))
    s3_heading(ax + 15 * u, ay + 11 * u, "INTERFACES")
    i = 0
    while i < 2 {
        ry = ay + 29 * u + i * (S3NW_ROW + 2) * u
        rx = ax + 7 * u
        rw = S3NW_SIDE * u - 14 * u
        nc = theme(TH_TEXT)              # ds #c4c9cf (ZD_TEXT_2); no zl role
        sc = theme(TH_TEXT_DIM)
        if s3nw_sel == i {
            rrect(rx, ry, rw, S3NW_ROW * u, 11 * u, theme(TH_ACCENT))
            nc = ui_ink_on(theme(TH_ACCENT))
            sc = nc
        }
        # ABSENT IS NOT THE SAME AS DOWN. s3nw_present was written to say so
        # and then never called, so the loopback row - a device this kernel does
        # not have - drew the DOWN treatment: a red state, a dark dot, and the
        # word "down". That is a failure report about something that cannot
        # fail, and it sits in the same column where eth0's real down state
        # means a real problem.
        up = s3nw_up(i)
        dc = theme(TH_OK)
        if up == 0 { dc = theme(TH_BORDER) }
        ui_dot(rx + 9 * u, ry + 18 * u, dc, up)
        tx = rx + 9 * u + ui_dot_sz() + 9 * u
        s3_mono(tx, ry + 8 * u, s3nw_name(i), nc)
        if s3nw_present(i) == 0 {
            s3_mono(tx, ry + 25 * u, "not present", theme(TH_TEXT_DIM))
        } else {
            if up == 1 {
                s3nw_ip(tx, ry + 25 * u, s3nw_addr(i), sc)
            } else {
                s3_mono(tx, ry + 25 * u, "down", sc)
            }
        }
        i = i + 1
    }
    return 0
}

# netToggleLabel, ds 4040: 'ifdown ' + name when the interface is up, 'ifup ' +
# name when it is not. zl cannot join two strings at runtime, and drawing the
# verb through ui_pill and then the name beside it puts the name PAST the
# pill's right edge - ui_pill centres its label, so a wider pill moves the
# label right by half the extra width, not none of it. There are exactly four
# combinations, so they are four literals.
fn s3nw_toggle_label() {
    if s3nw_sel == 0 {
        if s3nw_up(0) == 1 { return "ifdown lo" }
        return "ifup lo"
    }
    if s3nw_up(1) == 1 { return "ifdown eth0" }
    return "ifup eth0"
}
fn s3nw_toggle_w() { return ui_pill_w(s3nw_toggle_label(), S3_MD, S3_MONO) }

fn s3nw_toolbar(ax, ay, aw) {
    u = ui()
    ui_tb(ax, ay, aw, 36 * u, 1)
    ph = ui_pill_h(S3_MD)
    py = ay + (36 * u - ph) / 2
    x = ax + 10 * u
    tw = s3nw_toggle_w()
    ui_pill(x, py, tw, ph, s3nw_toggle_label(), S3_MD, S3_BTN_NEUTRAL, S3_MONO)
    x = x + tw + 7 * u
    pw = ui_pill_w("ping", S3_MD, S3_MONO)
    ui_pill(x, py, pw, ph, "ping", S3_MD, S3_BTN_PRIMARY, S3_MONO)
    # THE SECOND COPY OF THE SAME FIGURE, and the fix landed on only one of
    # them. The KV row below already draws "-" for an interface that is not
    # present; this strip kept drawing num_aa(0), so selecting the loopback row
    # showed "mtu 0" in the toolbar and "mtu -" twelve pixels underneath, in the
    # same frame. A surface contradicting itself is worse than either answer.
    #
    # The right edge has to be measured inside each arm: "-" is one cell and
    # 1500 is four, so a single flush computed outside would put one of them in
    # the wrong place.
    if s3nw_present(s3nw_sel) == 0 {
        mx = ax + aw - 10 * u - s3_mw("mtu ") - s3_mw("-")
        s3_mono(mx, ay + 11 * u, "mtu ", theme(TH_TEXT_DIM))
        s3_mono(mx + s3_mw("mtu "), ay + 11 * u, "-", theme(TH_TEXT_DIM))
    } else {
        mtu = s3nw_mtu(s3nw_sel)
        mx = ax + aw - 10 * u - s3_mw("mtu ") - s3_numw(mtu)
        s3_mono(mx, ay + 11 * u, "mtu ", theme(TH_TEXT_DIM))
        num_aa(mx + s3_mw("mtu "), ay + 11 * u, mtu, theme(TH_TEXT_DIM))
    }
    return 0
}

fn s3nw_kv_key(i) {
    if i == 0 { return "interface" }
    if i == 1 { return "state" }
    if i == 2 { return "address" }
    if i == 3 { return "mtu" }
    if i == 4 { return "driver" }
    if i == 5 { return "rx packets" }
    if i == 6 { return "tx packets" }
    return "errors"
}

# R.net opens with `link <iface> <dot> UP` and, flush right, what the link
# actually negotiated. Every figure here is a real read - net_ok is the driver's
# own link state and net_rx/net_tx are its counters - so this is the reference's
# head over measurements rather than over its mock `1000 Mb/s full duplex`.
fn s3nw_head(hx, hy, hw, sel) {
    hu = ui()
    ui_caps(hx + 13 * hu, hy, "LINK", theme(TH_TEXT_2), T_CAPTION)
    label(hx + 58 * hu, hy, s3nw_name(sel), theme(TH_TEXT_HI), T_CAPTION, W_REG)
    # THE THIRD PLACE THIS PANE ANSWERS THE SAME QUESTION, and the fix reached
    # the other two. The sidebar row and the KV state row both branch on
    # s3nw_present now; this header did not, so selecting the loopback drew a
    # red dot and a bold red DOWN at the top of a pane that says NOT PRESENT
    # four rows below, in the same frame.
    #
    # Red is a claim about a fault. There is no loopback device in this kernel,
    # so there is nothing to have failed - and a danger colour spent on a
    # non-event is a danger colour that means less when eth0 really does drop.
    up = s3nw_up(sel)
    if s3nw_present(sel) == 0 {
        ui_dot(hx + 108 * hu, hy + 5 * hu, theme(TH_BORDER), 0)
        label(hx + 120 * hu, hy, "ABSENT", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        dc = theme(TH_OK)
        if up == 0 { dc = theme(TH_DANGER) }
        ui_dot(hx + 108 * hu, hy + 5 * hu, dc, 0)
        if up == 1 { label(hx + 120 * hu, hy, "UP", dc, T_CAPTION, W_BOLD) }
        if up == 0 { label(hx + 120 * hu, hy, "DOWN", dc, T_CAPTION, W_BOLD) }
    }
    # FLUSH RIGHT: THE DRIVER THIS INTERFACE ACTUALLY HAS, read rather than
    # written. This said "e1000e - dhcp" and the driver row two lines below it
    # said `virtio-net` - because I typed a device name instead of asking for
    # one, and this QEMU config is virtio. The contradiction was visible only
    # because my label sat above the true one; on a machine where the guess
    # happened to be right it would have looked correct and still been invented.
    #
    # The reference prints "1000 Mb/s full duplex - msi". Nothing in this kernel
    # measures negotiated speed or duplex, so the slot carries what is known:
    # which driver claimed the device.
    if sel == 0 {
        label(hx + hw - 130 * hu, hy, "loopback, no device", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(hx + hw - 130 * hu, hy, s3nw_drv(sel), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    return 0
}

fn s3nw_body(ax, ay, aw, ah) {
    u = ui()
    s3nw_head(ax, ay + 2 * u, aw, s3nw_sel)
    x = ax + 13 * u
    y = ay + 24 * u
    kw = s3_mw("rx packets") + 16 * u
    up = s3nw_up(s3nw_sel)
    i = 0
    while i < S3NW_KV {
        ry = y + i * 20 * u
        s3_mono(x, ry, s3nw_kv_key(i), theme(TH_TEXT_DIM))
        vx = x + kw
        if i == 0 { s3_mono(vx, ry, s3nw_name(s3nw_sel), theme(TH_TEXT)) }
        if i == 1 {
            # RUNNING WAS ASSERTED. "UP RUNNING" printed whenever the device
            # initialised, which is the U in UP - it says nothing about the
            # carrier. netdev_link_up() reads that and was bound and unused, so
            # a cable-out machine reported RUNNING. The two words are two
            # different facts and are now two different reads.
            if s3nw_present(s3nw_sel) == 0 {
                s3_mono(vx, ry, "NOT PRESENT", theme(TH_TEXT_DIM))
            } else {
                if up == 1 {
                    if net_link() == 1 { s3_mono(vx, ry, "UP RUNNING", theme(TH_TEXT)) } else { s3_mono(vx, ry, "UP NO CARRIER", theme(TH_WARN)) }
                } else {
                    s3_mono(vx, ry, "DOWN", theme(TH_DANGER))
                }
            }
        }
        # A DASH, NOT A ZERO. num_aa in a numeric column reads as a measurement,
        # and 0 is not an MTU - it is the absence of one. Same treatment the
        # disk pane gives an unmounted volume.
        if i == 2 {
            if s3nw_present(s3nw_sel) == 0 { s3_mono(vx, ry, "-", theme(TH_TEXT_DIM)) } else { s3nw_ip(vx, ry, s3nw_addr(s3nw_sel), theme(TH_TEXT)) }
        }
        if i == 3 {
            if s3nw_present(s3nw_sel) == 0 { s3_mono(vx, ry, "-", theme(TH_TEXT_DIM)) } else { num_aa(vx, ry, s3nw_mtu(s3nw_sel), theme(TH_TEXT)) }
        }
        if i == 4 {
            dc = theme(TH_TEXT)
            if s3nw_sel != 0 { dc = theme(TH_DANGER) }
            s3_mono(vx, ry, s3nw_drv(s3nw_sel), dc)
        }
        if i == 5 { num_aa(vx, ry, s3nw_rx(s3nw_sel), theme(TH_TEXT)) }
        if i == 6 { num_aa(vx, ry, s3nw_tx(s3nw_sel), theme(TH_TEXT)) }
        if i == 7 {
            # THREE FIGURES, AND ONLY THE MIDDLE ONE WAS READ. The errors count
            # and the overruns count were both the literal 0, drawn in TH_TEXT -
            # the same ink as the measured drop beside them - so nothing on the
            # row distinguished the one real reading from the two written ones.
            # A zero that was never counted is the most convincing invented
            # figure there is: it looks like good news.
            #
            # errors is now the sum of the rx-side rejects the IP layer actually
            # counts. overruns has no counter anywhere in this kernel - nothing
            # tracks ring overflow - so it says so instead of claiming none.
            erx = ip_short() + ip_badsum() + ip_badver() + ip_badihl() + net_runt()
            drop = net_drop()
            num_aa(vx, ry, erx, theme(TH_TEXT))
            px = vx + s3_numw(erx)
            s3_mono(px, ry, "  dropped ", theme(TH_TEXT))
            px = px + s3_mw("  dropped ")
            num_aa(px, ry, drop, theme(TH_TEXT))
            s3_mono(px + s3_numw(drop), ry, "  overruns not counted", theme(TH_TEXT_DIM))
        }
        i = i + 1
    }
    py = y + S3NW_KV * 20 * u + 12 * u
    s3_heading(x, py, "PING OUTPUT")
    py = py + 19 * u
    pw = aw - 26 * u
    ph = ah - (py - ay) - 11 * u
    if ph < 96 * u { ph = 96 * u }
    rrect(x, py, pw, ph, 10 * u, theme(TH_BORDER))
    rrect(x + u, py + u, pw - 2 * u, ph - 2 * u, 9 * u, theme(TH_BG))
    lx = x + 11 * u
    ly = py + 9 * u
    if ip_sent() == 0 {
        s3_mono(lx, ly, "no packets sent", theme(TH_BORDER))
        return 0
    }
    s3_mono(lx, ly, "PING ", theme(TH_TEXT))
    s3nw_ip(lx + s3_mw("PING "), ly, NET_GW, theme(TH_TEXT))
    ly = ly + 17 * u
    sent = ip_sent()
    recv = ip_recv()
    lost = ip_lost()
    num_aa(lx, ly, sent, theme(TH_TEXT))
    px = lx + s3_numw(sent)
    s3_mono(px, ly, " sent, ", theme(TH_TEXT))
    px = px + s3_mw(" sent, ")
    num_aa(px, ly, recv, theme(TH_TEXT))
    px = px + s3_numw(recv)
    s3_mono(px, ly, " received, ", theme(TH_TEXT))
    px = px + s3_mw(" received, ")
    num_aa(px, ly, lost, theme(TH_DANGER))
    px = px + s3_numw(lost)
    s3_mono(px, ly, " lost", theme(TH_DANGER))
    ly = ly + 17 * u
    s3_mono(lx, ly, "rtt min/avg/max = ", theme(TH_TEXT_DIM))
    px = lx + s3_mw("rtt min/avg/max = ")
    num_aa(px, ly, ip_min(), theme(TH_TEXT_DIM))
    px = px + s3_numw(ip_min())
    char_aa(px, ly, 47, theme(TH_TEXT_DIM))
    px = px + cell_w()
    num_aa(px, ly, ip_avg(), theme(TH_TEXT_DIM))
    px = px + s3_numw(ip_avg())
    char_aa(px, ly, 47, theme(TH_TEXT_DIM))
    px = px + cell_w()
    num_aa(px, ly, ip_max(), theme(TH_TEXT_DIM))
    px = px + s3_numw(ip_max())
    # MICROSECONDS, NOT MILLISECONDS. ip_min/avg/max are net_ping_min/avg/max,
    # whose values come from tsc_to_us() - cycles over kHz - so they are us. The
    # kernel's own boot gate prints these same three natives with " us" three
    # times. A thousand-fold unit error on a latency figure, in the same image
    # that gets it right on the console.
    s3_mono(px, ly, " us", theme(TH_TEXT_DIM))
    return 0
}

fn s3nw_draw(ax, ay, aw, ah) {
    u = ui()
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    s3nw_sidebar(ax, ay, ah)
    rx = ax + S3NW_SIDE * u
    rw = aw - S3NW_SIDE * u
    s3nw_toolbar(rx, ay, rw)
    s3nw_body(rx, ay + 36 * u, rw, ah - 36 * u)
    return 0
}

fn s3nw_event(win, ety, ecode, ex, ey) {
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    if cx < S3NW_SIDE * u {
        if cy < 29 * u { return 0 }
        # THE FALL-THROUGH DESCRIBED HERE BEFORE WAS INFERRED AND IS NOT REAL:
        # `/` truncates in the compiled kernel, so this index was always
        # integral. See the idiv note at the top of kernel.zl for how the wrong
        # claim got in. The `if i == 0 { ... } return <eth0 answer>` shape IS
        # worth knowing about - it makes any future out-of-range index silently
        # answer for eth0 - but nothing produces one today.
    row = idiv(cy - 29 * u, (S3NW_ROW + 2) * u)
        if row < 0 { return 0 }
        if row > 1 { return 0 }
        if s3nw_sel != row { s3nw_sel = row  wm_dmg(win)  return 1 }
        return 1
    }
    if cy >= 36 * u { return 0 }
    tx = cx - S3NW_SIDE * u
    x = 10 * u
    w = s3nw_toggle_w()
    if tx >= x { if tx < x + w {
            # ifup/ifdown. net_up() is virtio_net_init(), the one real bring-up
            # this kernel exposes, and it is idempotent; there is no ifdown, so
            # the toggle only ever brings an interface UP. lo is not a device, so
            # selecting it makes this a no-op that still repaints the label.
            if s3nw_sel == 1 { if net_ok() == 0 { net_up() } }
            wm_dmg(win)
            return 1
    }}
    x = x + w + 7 * u
    pw = ui_pill_w("ping", S3_MD, S3_MONO)
    if tx >= x { if tx < x + pw {
            # ip_run, NOT ip_ping. net_ping() sends one echo and RETURNS
            # the rtt, touching none of the six statics the panel reads;
            # net_ping_run() is what fills sent/recv/min/avg/max/jitter. So the
            # button sent a packet, threw the answer away, and the panel went on
            # showing whatever the BOOT gate had left in those statics - a
            # control that appears to work because the numbers beside it were
            # already there.
            if ip_live() == 1 { ip_run(NET_GW, 4, 1000) }
            wm_dmg(win)
            return 1
    }}
    return 0
}

# ==============================================================================
# The slice's four entry points.
#
# sys3_tick returns 0 on purpose. Services' unit states and Network's rx/tx
# counters do change, so a per-second repaint would be useful - but
# apps_registry.zl's reg_tick() has no per-slice line at all (it dispatches
# APP_CLOCK and nothing else), so any tick logic written here would be dead
# code that cannot be exercised. When that hook lands, this is where it goes,
# and it needs its OWN last-second variable per app: apps_system.zl's clk_tick
# documents the race two apps get when they share one.
# ==============================================================================
# reg_new's per-slice hook. The POSITIONS are the reference's own, from
# ds-reference.html's APPS table (995-1013): disk 300,150 - svc 172,82 -
# arch 196,104 - img 280,120 - net 212,112.
#
# The reference composes for a 1280-wide screen and this panel may be wider,
# so every reference x carries the same centring term the boot composition
# uses (kernel.zl 4503). RECOMPUTED rather than read from `desk_ox`: that name
# is only ever assigned INSIDE wm_boot_start, which makes it that function's
# local, so `desk_ox + ...` here would silently add nothing. Derived from the
# panel, so it cannot go stale. apps_sys2.zl has the same three lines as
# sys2_ox() - the duplication is deliberate for now (a slice may not depend on
# another slice's private file) and belongs in apps_common.zl the moment
# somebody owns that move.
fn s3_ox() {
    dox = (px_w() - 1280 * ui()) / 2
    if dox < 0 { dox = 0 }
    return dox
}
fn s3_x(id) {
    if id == APP_DISK { return 300 }
    if id == APP_SVC  { return 172 }
    if id == APP_ARCH { return 196 }
    if id == APP_IMG  { return 280 }
    return 212
}
fn s3_y(id) {
    if id == APP_DISK { return 150 }
    if id == APP_SVC  { return 82 }
    if id == APP_ARCH { return 104 }
    if id == APP_IMG  { return 120 }
    return 112
}
fn sys3_new(id, u) {
    return wm_open(id, reg_name(id), s3_ox() + s3_x(id) * u, s3_y(id) * u, sys3_w(id) * u, sys3_h(id) * u)
}

fn sys3_draw(id, ax, ay, aw, ah) {
    if id == APP_DISK { return s3du_draw(ax, ay, aw, ah) }
    if id == APP_SVC  { return s3sv_draw(ax, ay, aw, ah) }
    if id == APP_ARCH { return s3ar_draw(ax, ay, aw, ah) }
    if id == APP_IMG  { return s3iv_draw(ax, ay, aw, ah) }
    if id == APP_NET  { return s3nw_draw(ax, ay, aw, ah) }
    return 0
}
fn sys3_event(id, win, ety, ecode, ex, ey) {
    if id == APP_SVC  { return s3sv_event(win, ety, ecode, ex, ey) }
    if id == APP_ARCH { return s3ar_event(win, ety, ecode, ex, ey) }
    if id == APP_IMG  { return s3iv_event(win, ety, ecode, ex, ey) }
    if id == APP_NET  { return s3nw_event(win, ety, ecode, ex, ey) }
    return 0
}
fn sys3_tick(id, win) { return 0 }
