# apps_games1.zl - board games: click-to-place, one state machine per game,
# each with its own board rather than a reskin of another (see
# apps_registry.zl for why). apps_common.zl's ac_cell_idx/ac_board_bg carry
# the grid arithmetic every one of these shares.
#
# THE SHELL FOR THE SEVEN OLDER GAMES LIVES HERE. Word Guess, Tic-Tac-Toe,
# Nim, Tower of Hanoi, Lights Out, Connect Four and Maze were written before
# ds-reference.html's game window was established and before apps_games3.zl's
# g3_bar existed, so all seven drew straight onto the window body with no
# canvas and no status bar. gs_canvas() and gs_bar() below are that shell,
# once, and every one of the seven now calls them - the five in this file and
# the two in apps_games2.zl, which is imported after this one.
#
# It is a THIRD copy of the same thirty pixels (g3_bar, g4_bar, gs_bar) and
# that is deliberate, not an oversight: apps_registry.zl dispatches these
# seven DIRECTLY to wg_draw/tt_draw/... with no per-slice games1_draw() to
# hang a shared shell on, and apps_registry.zl belongs to another agent in
# this working tree. Hoisting one shell into apps_common.zl means editing a
# file four other jobs are also editing. The three copies should collapse into
# apps_common.zl the moment one agent owns both files.

# ==============================================================================
# The game-window shell - docs/design/ds-reference.html:569-581.
#
#   a canvas filling the window on #0b0d10, and under it a 30px status bar:
#   background #14171a, a 1px #0b0d0f top border, 11px horizontal padding,
#   an 8px gap, a pid chip on the left and a 9.5px mono #5c6167 key-hints
#   line that ellipsises.
#
# Every colour there is a design.h token: #14171a is ZD_SURF_4 = TH_CHROME,
# #0b0d0f is ZD_SURF_2 = TH_CHROME_LINE (and the canvas's own #0b0d10 is that
# same token to within one unit of blue - design.h names it ZD_SURF_GAME but
# no ui_color() role points at it), and #5c6167 is ZD_TEXT_6 = TH_TEXT_6
# exactly. The hint therefore uses TH_TEXT_6 rather than the TH_TEXT_DIM
# (= ZD_TEXT_4 #9ba0a6) g3_bar reaches for; the reference is unambiguous.
# ==============================================================================
GS_BAR = 30

fn gs_ph(ah) { return ah - GS_BAR * ui() }

fn gs_canvas(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, gs_ph(ah), theme(TH_CHROME_LINE))
    return 0
}

# THE SLOT, NOT THE APP ID. These helpers key off a 0..6 index declared right
# here rather than off APP_WORDLE..APP_MAZE, so this file and apps_games2.zl
# carry no copy of an app id. A duplicated app id compiles clean and misroutes
# at runtime - apps_games3.zl's header records six months of `apps` opening
# the wrong window for exactly that reason - and the cheapest way not to
# duplicate one is not to write it down twice.
GS_WG  = 0
GS_TT  = 1
GS_NIM = 2
GS_HO  = 3
GS_LO  = 4
GS_C4  = 5
GS_MZ  = 6

# THE PID IS DERIVED, NOT READ, and said out loud rather than dressed up. The
# reference looks a real process up (`st.kern.procs.find(...)`); this kernel
# has a scheduler in sched.c but no zl builtin that reports a per-app pid, so
# the chip shows a stable number derived from the slot. 271..295 by fours: all
# three digits (which is what makes the chip width below exact) and disjoint
# from g3_pid()'s 400..421, so two games from different slices never show the
# same number.
fn gs_pid(slot) { return 271 + slot * 4 }

# TWO HINTS PER GAME, WHICH IS THIS TREE'S ELLIPSIS. The reference sets
# text-overflow:ellipsis; label() has no such thing and the compositor's client
# scissor would chop the line mid-glyph at the window edge instead. Measuring
# the long form and falling back to a short one gets the same outcome - the
# hint always fits - without a string builtin zl does not have.
fn gs_keys(slot) {
    if slot == GS_WG  { return "type five letters   enter guesses   backspace deletes   r new word" }
    if slot == GS_TT  { return "click a square to place   x and o alternate   r restarts" }
    if slot == GS_NIM { return "click a pile where you want it cut   take the last stick to win   r restarts" }
    if slot == GS_HO  { return "click a peg to lift its top disk   click another to drop it   r restarts" }
    if slot == GS_LO  { return "click toggles the cell and its four neighbours   r shuffles" }
    if slot == GS_C4  { return "click a column to drop   four in a row wins   r restarts" }
    if slot == GS_MZ  { return "arrows or wasd walk   reach the teal exit   r generates a new maze" }
    return ""
}
fn gs_keys_short(slot) {
    if slot == GS_WG  { return "type   enter   bksp   r new" }
    if slot == GS_TT  { return "click a square   r new" }
    if slot == GS_NIM { return "click a pile   r new" }
    if slot == GS_HO  { return "click peg, click peg   r new" }
    if slot == GS_LO  { return "click a cell   r new" }
    if slot == GS_C4  { return "click a column   r new" }
    if slot == GS_MZ  { return "arrows or wasd   r new" }
    return ""
}

fn gs_bar(ax, ay, aw, ah, slot) {
    u = ui()
    bh = GS_BAR * u
    by = ay + gs_ph(ah)
    fill_rgb(ax, by, aw, bh, theme(TH_CHROME))
    fill_rgb(ax, by, aw, 1, theme(TH_CHROME_LINE))
    th = label_h(T_CAPTION)
    ty = by + (bh - th) / 2
    # The chip: padding 3px 8px, radius 8px. Its width is MEASURED - "pid",
    # a gap, and three digits - rather than the fixed fudge g3_bar uses, which
    # is why gs_pid() is constrained to three digits above. ZD_SURF_6 is the
    # token design.h itself annotates "borders, scrollbar thumb, chip faces";
    # the reference tints the chip with the accent at 10% alpha and there is
    # no rounded-rect blend builtin to do that with, so the face is the chip
    # token and the INK is the accent, which is the part that carries meaning.
    pw = label_w("pid", T_CAPTION, W_REG)
    nw = label_w("000", T_CAPTION, W_REG)
    cw = pw + nw + 20 * u
    chh = th + 6 * u
    rrect(ax + 11 * u, by + (bh - chh) / 2, cw, chh, 8 * u, theme(TH_BORDER))
    label(ax + 19 * u, ty, "pid", theme(TH_ACCENT), T_CAPTION, W_REG)
    label_num(ax + 19 * u + pw + 4 * u, ty, gs_pid(slot), theme(TH_ACCENT), T_CAPTION, W_REG)
    kx = ax + 11 * u + cw + 8 * u
    room = ax + aw - 11 * u - kx
    ks = gs_keys(slot)
    if label_w(ks, T_CAPTION, W_REG) > room { ks = gs_keys_short(slot) }
    label(kx, ty, ks, theme(TH_TEXT_6), T_CAPTION, W_REG)
    return 0
}

# ==============================================================================
# Tic-Tac-Toe - 3x3, two players share the keyboard-less window, click to
# place. TT_BOARD: 0 empty, 1 X, 2 O.
# ==============================================================================
TT_CELL = 44
tt_turn = 1
tt_win  = 0                         # 0 playing, 1/2 winner, 3 draw
# The three cells that won, or -1. tt_check knew which line it was and threw
# the answer away, so the board said "X wins" and left the player to find the
# line themselves - the one thing the screen is better at than the sentence.
tt_wa = 0 - 1
tt_wb = 0 - 1
tt_wc = 0 - 1
# The match tally. It survives `r` and is cleared only when the window is
# opened, which is why there are two resets below rather than one.
tt_sx = 0
tt_so = 0
tt_sd = 0

fn tt_newgame() {
    fill_mem(TT_BOARD, 0, 9)
    tt_turn = 1
    tt_win = 0
    tt_wa = 0 - 1
    tt_wb = 0 - 1
    tt_wc = 0 - 1
    return 0
}
# reg_new() calls this when the window opens; `r` calls tt_newgame(). A fresh
# window starts a fresh match, a fresh round inside one keeps the score.
fn tt_reset() { tt_newgame()  tt_sx = 0  tt_so = 0  tt_sd = 0  return 0 }

fn tt_at(i) { return peek8(TT_BOARD + i) }
fn tt_set(i, m) { poke8(TT_BOARD + i, m)  return 0 }

fn tt_line(a, b, c) {
    va = tt_at(a)
    if va == 0 { return 0 }
    if va == tt_at(b) { if va == tt_at(c) {
            tt_wa = a
            tt_wb = b
            tt_wc = c
            return va
    }}
    return 0
}
fn tt_won_cell(i) {
    if i == tt_wa { return 1 }
    if i == tt_wb { return 1 }
    if i == tt_wc { return 1 }
    return 0
}
fn tt_check() {
    r = tt_line(0, 1, 2)  if r > 0 { return r }
    r = tt_line(3, 4, 5)  if r > 0 { return r }
    r = tt_line(6, 7, 8)  if r > 0 { return r }
    r = tt_line(0, 3, 6)  if r > 0 { return r }
    r = tt_line(1, 4, 7)  if r > 0 { return r }
    r = tt_line(2, 5, 8)  if r > 0 { return r }
    r = tt_line(0, 4, 8)  if r > 0 { return r }
    r = tt_line(2, 4, 6)  if r > 0 { return r }
    ci = 0
    full = 1
    while ci < 9 { if tt_at(ci) == 0 { full = 0 }  ci = ci + 1 }
    if full == 1 { return 3 }
    return 0
}

fn tt_mark_col(m) {
    if m == 1 { return ac_play_color(4) }
    return theme(TH_ACCENT)
}
fn tt_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    cell = TT_CELL * u
    gx = ax + (aw - 3 * cell) / 2
    gy = ay + 4 * u
    ac_board_bg(gx, gy, cell, 3, 3, theme(TH_SURF_1), theme(TH_BORDER))
    ci = 0
    while ci < 9 {
        cx = gx + (ci % 3) * cell
        cy = gy + (ci / 3) * cell
        # the three cells that won, lit before the marks go on top
        if tt_won_cell(ci) == 1 { fill_rgb(cx + 1, cy + 1, cell - 1, cell - 1, theme(TH_SURF_5)) }
        m = tt_at(ci)
        if m > 0 {
            label(cx + cell / 2 - 6 * u, cy + cell / 2 - 8 * u, tt_mark_str(m), tt_mark_col(m), T_TITLE, W_BOLD)
        }
        ci = ci + 1
    }
    msg_y = gy + 3 * cell + 8 * u
    if tt_win == 0 { label(gx, msg_y, tt_turn_str(), theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if tt_win == 1 { label(gx, msg_y, "X wins - r plays again", ac_play_color(4), T_CAPTION, W_BOLD) }
    if tt_win == 2 { label(gx, msg_y, "O wins - r plays again", theme(TH_ACCENT), T_CAPTION, W_BOLD) }
    if tt_win == 3 { label(gx, msg_y, "draw - r plays again", theme(TH_TEXT_DIM), T_CAPTION, W_BOLD) }
    # the tally, which is what makes a second round worth playing
    sy = msg_y + 18 * u
    label(gx, sy, "X", ac_play_color(4), T_CAPTION, W_BOLD)
    label_num(gx + 14 * u, sy, tt_sx, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(gx + 44 * u, sy, "O", theme(TH_ACCENT), T_CAPTION, W_BOLD)
    label_num(gx + 58 * u, sy, tt_so, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(gx + 88 * u, sy, "drawn", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(gx + 132 * u, sy, tt_sd, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    gs_bar(ax, ay, aw, ah, GS_TT)
    return 0
}
fn tt_mark_str(m) { if m == 1 { return "X" }  return "O" }
fn tt_turn_str() { if tt_turn == 1 { return "X to move" }  return "O to move" }

fn tt_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { tt_newgame()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if tt_win != 0 { return 0 }
    u = ui()
    cell = TT_CELL * u
    gx = wm_cx(win) + (wm_cw(win) - 3 * cell) / 2
    gy = wm_cy(win) + 4 * u
    idx = ac_cell_idx(gx, gy, cell, 3, 3, ex, ey)
    if idx < 0 { return 0 }
    if tt_at(idx) != 0 { return 0 }
    tt_set(idx, tt_turn)
    tt_win = tt_check()
    if tt_win == 0 { if tt_turn == 1 { tt_turn = 2 } else { tt_turn = 1 } }
    # The tally is stepped HERE, on the transition, not in tt_draw. A counter
    # incremented from a draw counts repaints: drag another window across a
    # finished game and X wins fifty times.
    if tt_win == 1 { tt_sx = tt_sx + 1 }
    if tt_win == 2 { tt_so = tt_so + 1 }
    if tt_win == 3 { tt_sd = tt_sd + 1 }
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Nim - three piles, normal play (whoever takes the last object wins). Click a
# stick and it goes, along with every stick to its right - the standard Nim UI,
# where a click picks the size you are cutting the pile DOWN TO.
#
# TWO THINGS WERE WRONG HERE AND THE SECOND ONE MADE THE GAME UNWINNABLE.
#
# 1. The cut was `(cx - 10u) / (18u) + 1`. That + 1 means clicking the very
#    first stick of a pile leaves ONE stick, and no click anywhere leaves
#    zero - `if cut >= nim_pile(pi) { return 0 }` then refuses every attempt
#    on a pile of one. So piles ratcheted down to 1, 1, 1 and stuck there.
#    Nobody can take the last object, which is the only way this game ends.
#    A player could not win, lose or draw it.
# 2. It divided a possibly-negative numerator. This kernel's `/` truncates
#    toward zero, so a click LEFT of the piles gave (negative)/(18u) = 0 and
#    landed as a click on stick 0 rather than being rejected - the exact shape
#    the comment inside nim_event already warned about for the row index while
#    the column index below it did the same thing.
#
# And it was two players sharing one mouse with no opponent. It is now the
# machine, playing Bouton's optimal strategy - see nim_ai.
# ==============================================================================
nim_a = 3
nim_b = 5
nim_c = 7
nim_win  = 0                        # 0 playing, 1 you won, 2 the machine won
nim_lastp = 0 - 1                   # the pile the machine last took from
nim_lastn = 0                       # ...and how many it took

fn nim_reset() {
    nim_a = 3
    nim_b = 5
    nim_c = 7
    nim_win = 0
    nim_lastp = 0 - 1
    nim_lastn = 0
    return 0
}
fn nim_pile(i) { if i == 0 { return nim_a }  if i == 1 { return nim_b }  return nim_c }
fn nim_set(i, v) {
    if i == 0 { nim_a = v }
    if i == 1 { nim_b = v }
    if i == 2 { nim_c = v }
    return 0
}
fn nim_total() { return nim_a + nim_b + nim_c }

# THE NIM-SUM, and the whole theory of the game in one line. Bouton proved in
# 1901 that a position is lost for whoever has to move exactly when the XOR of
# the pile sizes is zero. bxor is exact in both this project's runtimes; `+`
# and `-` would not answer the same question at all.
fn nim_sum() { return bxor(bxor(nim_a, nim_b), nim_c) }

# The machine's move. From a non-zero nim-sum there is always a move to zero,
# and it is found by asking each pile what it would have to become: pile p
# wants to be p XOR s, which is a legal take exactly when that is smaller.
#
# From a ZERO nim-sum every move loses against perfect play, so it takes one
# stick from the largest pile and plays on. That branch is not decoration -
# without it the function returns having moved nothing, the turn never comes
# back to the player and the window looks frozen.
fn nim_ai() {
    s = nim_sum()
    if s != 0 {
        i = 0
        while i < 3 {
            p = nim_pile(i)
            t = bxor(p, s)
            if t < p {
                nim_lastp = i
                nim_lastn = p - t
                nim_set(i, t)
                return 1
            }
            i = i + 1
        }
    }
    big = 0
    i = 1
    while i < 3 { if nim_pile(i) > nim_pile(big) { big = i }  i = i + 1 }
    if nim_pile(big) == 0 { return 0 }
    nim_lastp = big
    nim_lastn = 1
    nim_set(big, nim_pile(big) - 1)
    return 1
}

# One player move and the reply to it, factored out of the click handler so the
# rules can be played by a test as well as by a mouse. `cut` is the number of
# sticks the pile is being left with, so cut == 0 empties it.
fn nim_take(pi, cut) {
    if nim_win != 0 { return 0 }
    if pi < 0 { return 0 }
    if pi > 2 { return 0 }
    if cut < 0 { return 0 }
    if cut >= nim_pile(pi) { return 0 }
    nim_set(pi, cut)
    nim_lastp = 0 - 1
    nim_lastn = 0
    if nim_total() == 0 { nim_win = 1  return 1 }
    nim_ai()
    if nim_total() == 0 { nim_win = 2  return 1 }
    return 1
}

NIM_DOT = 18
NIM_ROW = 26
fn nim_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    dw = NIM_DOT * u
    pi = 0
    while pi < 3 {
        py = ay + 10 * u + pi * NIM_ROW * u
        n = nim_pile(pi)
        # The empty slots stay drawn, in the sunken-well token: a pile that
        # simply vanishes gives the player nothing to compare against, and the
        # whole skill of this game is comparing pile sizes.
        di = 0
        while di < 7 {
            col = theme(TH_SURF_1)
            if di < n { col = ac_play_color(4) }
            # the ghost of the machine's last take, so its move is visible
            # rather than only stated in words underneath
            if di >= n { if pi == nim_lastp { if di < n + nim_lastn { col = theme(TH_SURF_5) } } }
            fill_rgb(ax + 10 * u + di * dw, py, dw - 4 * u, 16 * u, col)
            di = di + 1
        }
        label_num(ax + 10 * u + 7 * dw + 8 * u, py + 2 * u, n, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        pi = pi + 1
    }
    my = ay + 92 * u
    if nim_win == 0 {
        label(ax + 10 * u, my, "your move - click the stick you want to leave", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        if nim_lastp >= 0 {
            label(ax + 10 * u, my + 16 * u, "it took", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
            label_num(ax + 56 * u, my + 16 * u, nim_lastn, theme(TH_TEXT_HI), T_CAPTION, W_REG)
            label(ax + 74 * u, my + 16 * u, "from pile", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
            label_num(ax + 132 * u, my + 16 * u, nim_lastp + 1, theme(TH_TEXT_HI), T_CAPTION, W_REG)
        }
    } else {
        label(ax + 10 * u, my, nim_win_str(), nim_win_col(), T_CAPTION, W_BOLD)
    }
    gs_bar(ax, ay, aw, ah, GS_NIM)
    return 0
}
fn nim_win_str() { if nim_win == 1 { return "you took the last stick - you win. r restarts" }  return "it took the last stick - r restarts" }
fn nim_win_col() { if nim_win == 1 { return theme(TH_OK) }  return theme(TH_DANGER) }

fn nim_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { nim_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if nim_win != 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    # BOTH coordinates are checked non-negative BEFORE their divide, not after.
    # This kernel's `/` truncates toward zero (freestanding/runtime_kernel.c),
    # so (cy - 10u) at, say, cy = 8u gives -2u/26u = 0, not -1 - a click just
    # above the first pile would silently pass a `pi < 0` check done after the
    # division and register as a click ON pile 0. That was written down here
    # for the ROW and then the COLUMN two lines below did exactly the same
    # thing, unguarded, for the whole life of the file. ac_cell_idx in
    # apps_common.zl gets both right; cp_slider_at and ho_event had the same
    # shape and are fixed with it.
    if cy < 10 * u { return 0 }
    if cx < 10 * u { return 0 }
    pi = (cy - 10 * u) / (NIM_ROW * u)
    if pi > 2 { return 0 }
    into = cy - 10 * u - pi * NIM_ROW * u
    if into >= 16 * u { return 0 }
    # NO + 1. Clicking stick k leaves k sticks, so clicking the first stick
    # empties the pile - which is the only way anyone ever takes the last
    # object, and therefore the only way this game ends.
    cut = (cx - 10 * u) / (NIM_DOT * u)
    if nim_take(pi, cut) == 0 { return 0 }
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Tower of Hanoi - 3 pegs, 5 disks (0 smallest .. 4 largest). Click a peg to
# select its top disk, click another peg to move it there.
# ==============================================================================
ho_d0 = 0
ho_d1 = 0
ho_d2 = 0
ho_d3 = 0
ho_d4 = 0
ho_sel = 0 - 1
ho_moves = 0
# THE REFUSAL, MADE VISIBLE. An illegal drop - a larger disk onto a smaller
# one - used to be discarded in silence, so the only feedback for the rule
# that IS this puzzle was the disk not moving, which is indistinguishable from
# a missed click. This is set by the attempt and cleared by the next thing
# that succeeds.
ho_bad = 0
# 2^5 - 1, and it is a fact about the puzzle rather than a number picked to
# look encouraging: five disks cannot be moved in fewer.
HO_OPT = 31

fn ho_peg(d) {
    if d == 0 { return ho_d0 }
    if d == 1 { return ho_d1 }
    if d == 2 { return ho_d2 }
    if d == 3 { return ho_d3 }
    return ho_d4
}
fn ho_set(d, p) {
    if d == 0 { ho_d0 = p }
    if d == 1 { ho_d1 = p }
    if d == 2 { ho_d2 = p }
    if d == 3 { ho_d3 = p }
    if d == 4 { ho_d4 = p }
    return 0
}
fn ho_reset() { ho_d0 = 0  ho_d1 = 0  ho_d2 = 0  ho_d3 = 0  ho_d4 = 0  ho_sel = 0 - 1  ho_moves = 0  ho_bad = 0  return 0 }

# smallest disk index currently on peg p, the standard "top of stack" rule
# for this puzzle (larger disks can never sit above smaller ones), or -1.
fn ho_top(p) {
    d = 0
    while d < 5 { if ho_peg(d) == p { return d }  d = d + 1 }
    return 0 - 1
}

# The win condition, as a predicate rather than as a five-deep nest inside the
# draw. ho_draw held the only copy and returned early from the middle of it,
# so nothing else in the file could ask "is it finished?" - which is how
# ho_event came to accept moves on a solved puzzle and go on counting them.
fn ho_solved() {
    d = 0
    while d < 5 { if ho_peg(d) != 2 { return 0 }  d = d + 1 }
    return 1
}

# THE RULE OF THE PUZZLE, as a predicate. It existed only inside ho_event, as
# `if dtop > src`, with the "peg is empty" case as a separate arm - so nothing
# could ask whether a move was legal without performing it, and the test below
# would have had to restate the rule to check it.
#
# ho_top returns the SMALLEST disk index on a peg, which is its top disk
# (larger disks can never sit above smaller ones, so smallest == topmost is an
# invariant of the game rather than an assumption about the array).
fn ho_can(src, dst) {
    if src < 0 { return 0 }
    if src > 2 { return 0 }
    if dst < 0 { return 0 }
    if dst > 2 { return 0 }
    if src == dst { return 0 }
    s = ho_top(src)
    if s < 0 { return 0 }
    d = ho_top(dst)
    if d < 0 { return 1 }
    if d > s { return 1 }
    return 0
}
fn ho_move(src, dst) {
    if ho_solved() == 1 { return 0 }
    if ho_can(src, dst) == 0 { return 0 }
    ho_set(ho_top(src), dst)
    ho_moves = ho_moves + 1
    return 1
}

fn ho_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    baseY = ay + 90 * u
    pw = aw / 3
    pi = 0
    while pi < 3 {
        px = ax + pi * pw + pw / 2
        col = theme(TH_TEXT_DIM)
        if ho_sel == pi { col = theme(TH_ACCENT) }
        fill_rgb(px - 1 * u, baseY - 70 * u, 2 * u, 70 * u, col)
        fill_rgb(ax + pi * pw + 10 * u, baseY, pw - 20 * u, 4 * u, col)
        pi = pi + 1
    }
    d = 4
    while d >= 0 {
        p = ho_peg(d)
        stacklvl = 0
        dd = 0
        while dd < 5 { if ho_peg(dd) == p { if dd > d { stacklvl = stacklvl + 1 } }  dd = dd + 1 }
        w = (d + 2) * 10 * u
        px = ax + p * pw + pw / 2
        py = baseY - (stacklvl + 1) * 12 * u
        fill_rgb(px - w / 2, py, w, 10 * u, ac_play_color(4))
        d = d - 1
    }
    if ho_solved() == 1 {
        label(ax + 8 * u, ay + 8 * u, "solved in", theme(TH_OK), T_CAPTION, W_BOLD)
        label_num(ax + 74 * u, ay + 8 * u, ho_moves, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
        if ho_moves == HO_OPT {
            label(ax + 100 * u, ay + 8 * u, "- the minimum. r restarts", theme(TH_OK), T_CAPTION, W_BOLD)
        } else {
            label(ax + 100 * u, ay + 8 * u, "- 31 is the minimum. r restarts", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        }
        gs_bar(ax, ay, aw, ah, GS_HO)
        return 0
    }
    label(ax + 8 * u, ay + 8 * u, "moves", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(ax + 56 * u, ay + 8 * u, ho_moves, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(ax + 84 * u, ay + 8 * u, "of 31 minimum", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    if ho_bad == 1 {
        label(ax + 8 * u, ay + 24 * u, "a disk may not sit on a smaller one", theme(TH_WARN), T_CAPTION, W_REG)
    }
    gs_bar(ax, ay, aw, ah, GS_HO)
    return 0
}

fn ho_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { ho_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if ho_solved() == 1 { return 0 }
    aw = wm_cw(win)
    pw = aw / 3
    cx = ex - wm_cx(win)
    if cx < 0 { return 0 }               # see the note in nim_event
    p = cx / pw
    if p > 2 { return 0 }
    if ho_sel < 0 {
        # An empty peg cannot be picked up FROM, and saying so is the point -
        # this used to leave ho_sel unchanged and still report the event
        # handled and damage the window, so a click on an empty peg looked
        # exactly like a click on a full one and did nothing.
        if ho_top(p) < 0 { return 0 }
        ho_sel = p
        ho_bad = 0
        wm_dmg(win)
        return 1
    }
    if ho_sel == p { ho_sel = 0 - 1  ho_bad = 0  wm_dmg(win)  return 1 }
    if ho_move(ho_sel, p) == 1 { ho_bad = 0 } else { ho_bad = 1 }
    ho_sel = 0 - 1
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Lights Out - 5x5, a press toggles the cell and its four neighbours, win when
# every light is off.
#
# SOLVABLE BY CONSTRUCTION, and now provably so. The board starts solved (all
# off) and the shuffle is nothing but a sequence of ORDINARY PRESSES - the same
# lo_press() a click goes through. Pressing that same sequence again returns
# the board to all-off, so a solution demonstrably exists; and because a press
# is its own inverse and presses commute, the ORDER does not matter either.
# That is the whole argument, and it needs no solver.
#
# It is worth saying what the alternative would have cost: only 2^23 of the
# 2^25 boards are reachable at all, so scattering random bits gives a board
# that is unsolvable three times in four, and finding that out needs the
# solver this construction avoids.
#
# TWO THINGS CHANGED. The shuffle used to pick a flat 0..24 index and split it
# with `cell / LO_N` and `cell % LO_N`. LO_N is 5, so that is not a shift, and
# `/` is a DIFFERENT OPERATION in this project's two runtimes - it truncates in
# the kernel and does not in the host interpreter, which makes the shuffle a
# different shuffle depending on the backend. A row and a column are now drawn
# separately and nothing here divides. And the shuffle could land back on an
# all-off board - twelve presses can cancel - handing the player a puzzle that
# was already won; it now redraws until the board is not solved.
# ==============================================================================
LO_N = 5
LO_SHUFFLE = 12
lo_moves = 0

fn lo_toggle(r, c) {
    if r < 0 { return 0 }
    if r >= LO_N { return 0 }
    if c < 0 { return 0 }
    if c >= LO_N { return 0 }
    a = LIGHTS_BOARD + r * LO_N + c
    poke8(a, 1 - peek8(a))
    return 0
}
# ONE press, the plus-shape. The shuffle and the click used to carry a copy
# each - five lo_toggle calls apiece - which is two places for the shape of the
# move to drift, and a shuffle that presses a different shape from the one the
# player presses is a shuffle that does not guarantee anything.
fn lo_press(r, c) {
    lo_toggle(r, c)
    lo_toggle(r - 1, c)
    lo_toggle(r + 1, c)
    lo_toggle(r, c - 1)
    lo_toggle(r, c + 1)
    return 0
}
fn lo_shuffle() {
    fill_mem(LIGHTS_BOARD, 0, LO_N * LO_N)
    ki = 0
    while ki < LO_SHUFFLE {
        lo_press(ac_rand(LO_N), ac_rand(LO_N))
        ki = ki + 1
    }
    return 0
}
fn lo_reset() {
    ac_seed_from(ticks() + 19)          # see the note in wg_reset
    lo_shuffle()
    # A shuffle that cancels itself out hands over a solved board. Bounded, not
    # `while`: the generator is deterministic, and a bug that makes every
    # shuffle cancel would otherwise hang the compositor inside a click
    # handler rather than show a dull puzzle.
    tries = 0
    while tries < 8 {
        if lo_solved() == 0 { tries = 8 } else { lo_shuffle()  tries = tries + 1 }
    }
    lo_moves = 0
    return 0
}
fn lo_solved() {
    ci = 0
    while ci < LO_N * LO_N { if peek8(LIGHTS_BOARD + ci) != 0 { return 0 }  ci = ci + 1 }
    return 1
}
fn lo_lit() {
    n = 0
    ci = 0
    while ci < LO_N * LO_N { if peek8(LIGHTS_BOARD + ci) != 0 { n = n + 1 }  ci = ci + 1 }
    return n
}

fn lo_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    cell = 34 * u
    gx = ax + (aw - LO_N * cell) / 2
    gy = ay + 6 * u
    ri = 0
    while ri < LO_N {
        ci = 0
        while ci < LO_N {
            on = peek8(LIGHTS_BOARD + ri * LO_N + ci)
            col = theme(TH_SURF_1)
            if on == 1 { col = theme(TH_WARN) }
            rrect(gx + ci * cell + 2 * u, gy + ri * cell + 2 * u, cell - 4 * u, cell - 4 * u, 6 * u, col)
            ci = ci + 1
        }
        ri = ri + 1
    }
    my = gy + LO_N * cell + 8 * u
    if lo_solved() == 1 {
        label(gx, my, "all out in", theme(TH_OK), T_CAPTION, W_BOLD)
        label_num(gx + 76 * u, my, lo_moves, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
        label(gx + 100 * u, my, "presses - r shuffles again", theme(TH_OK), T_CAPTION, W_BOLD)
    } else {
        label(gx, my, "click to turn off every light", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label_num(gx, my + 16 * u, lo_lit(), theme(TH_WARN), T_CAPTION, W_BOLD)
        label(gx + 22 * u, my + 16 * u, "still lit", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label_num(gx + 90 * u, my + 16 * u, lo_moves, theme(TH_TEXT_HI), T_CAPTION, W_REG)
        label(gx + 112 * u, my + 16 * u, "presses", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    gs_bar(ax, ay, aw, ah, GS_LO)
    return 0
}

fn lo_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { lo_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if lo_solved() == 1 { return 0 }
    u = ui()
    cell = 34 * u
    gx = wm_cx(win) + (wm_cw(win) - LO_N * cell) / 2
    gy = wm_cy(win) + 6 * u
    idx = ac_cell_idx(gx, gy, cell, LO_N, LO_N, ex, ey)
    if idx < 0 { return 0 }
    # ac_cell_idx hands back a FLAT index and LO_N is 5, so splitting it needs
    # a divide - and `/` is a different operation in this project's two
    # runtimes. Twenty-five cells is a short walk; exactness is worth more here
    # than the four instructions it saves.
    r = 0
    while (r + 1) * LO_N <= idx { r = r + 1 }
    c = idx - r * LO_N
    lo_press(r, c)
    lo_moves = lo_moves + 1
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Connect Four - 7x6, click a column, the piece drops to the lowest empty
# row (row 0 = top in storage, drawn top-down; gravity works from the
# bottom row up). C4_BOARD: 0 empty, 1/2 a player's piece.
# ==============================================================================
C4_W = 7
C4_H = 6
c4_turn = 1
c4_win  = 0                         # 0 playing, 1/2 winner, 3 draw
# WHERE the four are, not just that there are four. c4_check knew the axis and
# the run length and threw both away, so a win was announced in a sentence and
# the player had to find the line on the board themselves.
c4_wr  = 0 - 1
c4_wc  = 0 - 1
c4_wdr = 0
c4_wdc = 0
# the cell the last piece landed in, ringed so a drop is visible
c4_lastr = 0 - 1
c4_lastc = 0 - 1

fn c4_reset() {
    fill_mem(C4_BOARD, 0, C4_W * C4_H)
    c4_turn = 1
    c4_win = 0
    c4_wr = 0 - 1
    c4_wc = 0 - 1
    c4_wdr = 0
    c4_wdc = 0
    c4_lastr = 0 - 1
    c4_lastc = 0 - 1
    return 0
}
fn c4_at(r, c) {
    if r < 0 { return 0 - 1 }
    if r >= C4_H { return 0 - 1 }
    if c < 0 { return 0 - 1 }
    if c >= C4_W { return 0 - 1 }
    return peek8(C4_BOARD + r * C4_W + c)
}
fn c4_set(r, c, m) { poke8(C4_BOARD + r * C4_W + c, m)  return 0 }
fn c4_run(r, c, dr, dc, m) {
    n = 0
    while c4_at(r, c) == m { n = n + 1  r = r + dr  c = c + dc }
    return n
}
# One axis through the landing cell: the run forward plus the run backward,
# minus the cell they share. c4_at answers -1 off the board and 0 for empty, so
# neither walk can leave the grid or run through a hole - which is the whole
# reason the count is done this way rather than by scanning the board for
# patterns.
#
# It also RECORDS the four when it finds them: back - 1 steps against the
# direction from the landing cell is where the run starts.
fn c4_axis(r, c, dr, dc, m) {
    fwd = c4_run(r, c, dr, dc, m)
    back = c4_run(r, c, 0 - dr, 0 - dc, m)
    if fwd + back - 1 < 4 { return 0 }
    c4_wr = r - (back - 1) * dr
    c4_wc = c - (back - 1) * dc
    c4_wdr = dr
    c4_wdc = dc
    return m
}
# ALL FOUR AXES: horizontal, vertical, and both diagonals. Each is checked
# through the cell just played, which is the only cell that can have completed
# a line - a full-board scan would be four times the work for the same answer.
fn c4_check(r, c) {
    m = c4_at(r, c)
    if m < 1 { return 0 }
    if c4_axis(r, c, 0, 1, m) > 0 { return m }
    if c4_axis(r, c, 1, 0, m) > 0 { return m }
    if c4_axis(r, c, 1, 1, m) > 0 { return m }
    if c4_axis(r, c, 1, 0 - 1, m) > 0 { return m }
    return 0
}
fn c4_won_cell(r, c) {
    if c4_wr < 0 { return 0 }
    k = 0
    while k < 4 {
        if c4_wr + k * c4_wdr == r { if c4_wc + k * c4_wdc == c { return 1 } }
        k = k + 1
    }
    return 0
}
fn c4_full() {
    ci = 0
    while ci < C4_W { if c4_at(0, ci) == 0 { return 0 }  ci = ci + 1 }
    return 1
}

# ONE DROP, the whole move. This lived inside the click handler and needed a
# `landrow` sentinel and a scan of the entire column, because the loop it was
# written into could not stop early - and that shape is what let an earlier
# version run the win check and the turn switch after a click on a FULL column,
# on nothing. Returning from inside the loop needs no sentinel at all.
#
# Returns the row the piece landed in, or -1 if the move was refused.
fn c4_drop(col) {
    if c4_win != 0 { return 0 - 1 }
    if col < 0 { return 0 - 1 }
    if col >= C4_W { return 0 - 1 }
    r = C4_H - 1
    while r >= 0 {
        if c4_at(r, col) == 0 {
            c4_set(r, col, c4_turn)
            c4_lastr = r
            c4_lastc = col
            if c4_check(r, col) > 0 { c4_win = c4_turn  return r }
            if c4_full() == 1 { c4_win = 3  return r }
            if c4_turn == 1 { c4_turn = 2 } else { c4_turn = 1 }
            return r
        }
        r = r - 1
    }
    return 0 - 1
}

# RED IS THE VERMILION AND YELLOW IS THE AMBER, in that order, because the two
# words are printed on screen when somebody wins. Getting distinct colours was
# not enough - the first pass made player 1 amber while the message said "red
# wins", so both players were named as the other one's colour. A piece colour
# that contradicts its own caption is a worse bug than two pieces sharing one.
fn c4_col_color(m) { if m == 1 { return theme(TH_ACCENT) }  return ac_play_color(4) }
fn c4_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    cell = 30 * u
    gx = ax + (aw - C4_W * cell) / 2
    gy = ay + 6 * u
    ac_board_bg(gx, gy, cell, C4_W, C4_H, theme(TH_SURF_1), theme(TH_BORDER))
    ri = 0
    while ri < C4_H {
        ci = 0
        while ci < C4_W {
            cx = gx + ci * cell
            cy = gy + ri * cell
            # the four that won, lit behind the pieces
            if c4_won_cell(ri, ci) == 1 { fill_rgb(cx + 1, cy + 1, cell - 1, cell - 1, theme(TH_SURF_5)) }
            m = c4_at(ri, ci)
            if m > 0 {
                fill_rgb(cx + 3 * u, cy + 3 * u, cell - 6 * u, cell - 6 * u, c4_col_color(m))
                # the piece that just landed, ringed. Seven columns of the
                # same two colours and no marker is a board you have to
                # re-read from scratch every turn.
                if ri == c4_lastr { if ci == c4_lastc {
                        fill_rgb(cx + 3 * u, cy + 3 * u, cell - 6 * u, 2 * u, theme(TH_TEXT_HI))
                        fill_rgb(cx + 3 * u, cy + cell - 5 * u, cell - 6 * u, 2 * u, theme(TH_TEXT_HI))
                        fill_rgb(cx + 3 * u, cy + 3 * u, 2 * u, cell - 6 * u, theme(TH_TEXT_HI))
                        fill_rgb(cx + cell - 5 * u, cy + 3 * u, 2 * u, cell - 6 * u, theme(TH_TEXT_HI))
                }}
            }
            ci = ci + 1
        }
        ri = ri + 1
    }
    msg_y = gy + C4_H * cell + 8 * u
    if c4_win == 0 { label(gx, msg_y, c4_turn_str(), theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if c4_win == 1 { label(gx, msg_y, "red wins - r restarts", theme(TH_ACCENT), T_CAPTION, W_BOLD) }
    if c4_win == 2 { label(gx, msg_y, "yellow wins - r restarts", ac_play_color(4), T_CAPTION, W_BOLD) }
    if c4_win == 3 { label(gx, msg_y, "draw - r restarts", theme(TH_TEXT_DIM), T_CAPTION, W_BOLD) }
    gs_bar(ax, ay, aw, ah, GS_C4)
    return 0
}
fn c4_turn_str() { if c4_turn == 1 { return "red to drop" }  return "yellow to drop" }

fn c4_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { c4_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if c4_win != 0 { return 0 }
    u = ui()
    cell = 30 * u
    gx = wm_cx(win) + (wm_cw(win) - C4_W * cell) / 2
    cx = ex - gx
    if cx < 0 { return 0 }
    col = cx / cell
    if col >= C4_W { return 0 }
    # A refused drop - a full column - changes nothing, so it must not damage
    # the window either. Reporting the event handled is still right: the click
    # was inside this app's board and no other window should see it.
    if c4_drop(col) < 0 { return 1 }
    wm_dmg(win)
    return 1
}
