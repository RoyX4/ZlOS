# apps_common.zl - grid/board helpers shared by the app-suite modules.
#
# Every board game in apps_games1.zl / apps_games2.zl draws a grid of square
# cells and hit-tests a click against that same grid. Before this file that
# logic would have been copy-pasted into each game (and drifted, the way
# dock_tile/dock_slot_at were kept honest by sharing DOCK_X0/DOCK_PITCH). This
# is that shared arithmetic, written once.
#
# zl has no lists, no arrays-of-struct and no function values (wm.c's own
# comment: "the zl kernel subset has no lists at all, zl_list_n is a hard
# fault") - so "shared" here means shared FUNCTIONS over explicit coordinates,
# the same idiom dock_tile/menu_row_at already use, not a shared data
# structure.

# The cell a screen point falls in, as a single flat index (row * gw + col),
# or -1 if the point is outside the grid. ax,ay is the grid's ORIGIN in screen
# coordinates (already client-relative-corrected by the caller, exactly like
# paint_dab takes ex - wm_cx(win)); cell is one cell's side in pixels.
fn ac_cell_idx(ax, ay, cell, gw, gh, ex, ey) {
    if ex < ax { return 0 - 1 }
    if ey < ay { return 0 - 1 }
    # idiv. `/` is FLOAT division in zl, and this function returns a CELL
    # INDEX - cr * gw + cc - which callers compare and use to select. A
    # fractional index matches no cell and selects nothing, so a click landed
    # only when the offset was an exact multiple of the cell size. This is the
    # shared grid hit test: every game with a board was reading it.
    cc = idiv(ex - ax, cell)
    cr = idiv(ey - ay, cell)
    if cc >= gw { return 0 - 1 }
    if cr >= gh { return 0 - 1 }
    return cr * gw + cc
}

# A flat board background plus internal grid lines - the part every board
# game repaints before drawing its own pieces on top.
fn ac_board_bg(ax, ay, cell, gw, gh, bgcol, linecol) {
    fill_rgb(ax, ay, gw * cell, gh * cell, bgcol)
    gi = 1
    while gi < gw {
        fill_rgb(ax + gi * cell, ay, 1, gh * cell, linecol)
        gi = gi + 1
    }
    gi = 1
    while gi < gh {
        fill_rgb(ax, ay + gi * cell, gw * cell, 1, linecol)
        gi = gi + 1
    }
    return 0
}

# The three category colours, used by the catalog tiles AND by anything else
# that wants to show "this is a game / a utility / a system app" at a glance.
# 0 = system, 1 = utility, 2 = game - matches reg_cat() in apps_registry.zl.
# THREE MORE RAW LITERALS FROM THE SUPERSEDED PALETTE, and they were the tile
# stripe and the three legend swatches - the catalogue's only colour coding.
# A pale blue, a mint and a lilac: nothing in PRESSWORK's ladder is any of
# those, and design.h states it is the only place a colour literal may appear.
#
# The three roles the ladder already has for exactly this job: TH_STEEL is the
# instrument colour, TH_OK the healthy one, TH_ACCENT the emphasis. They move
# with the theme, which these did not.
fn ac_cat_color(cat) {
    if cat == 0 { return theme(TH_STEEL) }
    if cat == 1 { return theme(TH_OK) }
    return theme(TH_ACCENT)
}

# THE GAMES' PIECE COLOURS ARE A DIFFERENT QUESTION FROM THE CATALOGUE'S.
#
# ac_cat_color answers "what KIND of app is this" - three semantic categories.
# The games were borrowing it to answer "give me hues nobody can confuse", and
# those are not the same question. The moment ac_cat_color moved onto the theme
# roles - which it had to, the raw literals were from the superseded palette -
# its three values stopped being disjoint from the roles the games ALSO use
# directly, and pieces started sharing colours:
#
#   Connect Four  red = ac_cat_color(2) = TH_ACCENT, yellow = TH_ACCENT.
#                 Every piece one colour. The game could not be played.
#   Tic-tac-toe   X and O both TH_ACCENT.
#   Tetris        tet_col's own comment claims "exactly seven distinct values";
#                 it had collapsed to five.
#
# One function, two callers wanting different things, is the whole fault. This
# is the second one, and its contract is exactly "N pairwise-distinct values
# from the ladder" - no semantics attached, so it can never be pulled toward a
# meaning the way the other was.
#
# Seven roles, checked pairwise against design.h's hexes:
#   0 TH_ACCENT   #E8734F vermilion   4 TH_WARN     amber
#   1 TH_STEEL    #7FB2E0 blue        5 TH_TEXT_HI  near-white
#   2 TH_OK       green               6 TH_DANGER   red
#   3 TH_STEEL_BR #A9CFF2 pale blue
fn ac_play_color(i) {
    if i == 0 { return theme(TH_ACCENT) }
    if i == 1 { return theme(TH_STEEL) }
    if i == 2 { return theme(TH_OK) }
    if i == 3 { return theme(TH_STEEL_BR) }
    if i == 4 { return theme(TH_WARN) }
    if i == 5 { return theme(TH_TEXT_HI) }
    return theme(TH_DANGER)
}

# A small deterministic PRNG, independent of sn_seed (Snake's own) so two
# games open at once never share or perturb each other's sequence. Same LCG
# shape as sn_rand - proven already, not reinvented.
# THE OLD GENERATOR'S LOW BITS WERE DEAD, AND EVERY GAME DREW FROM IT.
#
# `ac_seed = ac_seed * 1103515245 + 12345` looks like the textbook LCG, and in C
# on a 32-bit integer it is one. Here every value is a DOUBLE: zl_binop casts to
# long long, multiplies, and casts the result BACK to double. After two steps
# the product passes 2^53 and the round trip silently zeroes the bottom ten bits
# or so of the state. The line below then took bits 8..22 - whose lowest two are
# exactly the dead ones.
#
# Measured by replaying zl_binop's own semantics in C, 200,000 draws each:
#
#   ac_rand(4)   0 = 95.3%   1 = 2.9%   2 = 0.4%   3 = 1.4%
#   ac_rand(8)   even 95.7% of the time
#   ac_rand(6)   0, 2, 4 = 32% each;  1, 3, 5 = 1.5% each
#
# Every modulus that is a multiple of two collapsed. Simon played one pad,
# shuffles barely shuffled, and any game asking for a coin flip got the same
# answer nineteen times in twenty.
#
# MINSTD instead, chosen so the arithmetic CANNOT leave the exact range of a
# double: the largest product is 16807 * 2147483646 = 3.61e13, against 2^53 =
# 9.01e15. Two hundred and forty times the headroom, so no rounding occurs and
# the low bits stay alive. The shift by 64 drops the weakest of them anyway.
#
# Same replay, after:
#
#   ac_rand(4)   24.9 / 25.1 / 25.1 / 24.9
#   ac_rand(8)   12.3 to 12.6 across all eight
#   ac_rand(52)  min 9,827  max 10,241 over 520,000 draws (ideal 10,000)
ac_seed = 1

# 0 is a fixed point of a Lehmer generator - it would return 0 for ever - so a
# caller seeding from a tick count that happens to be 0, or from a multiple of
# the modulus, is corrected rather than trusted.
fn ac_seed_from(n) {
    ac_seed = n % 2147483647
    if ac_seed < 0 { ac_seed = 0 - ac_seed }
    if ac_seed == 0 { ac_seed = 1 }
    return 0
}

fn ac_rand(n) {
    ac_seed = (ac_seed * 16807) % 2147483647
    r = idiv(ac_seed, 64) % n
    if r < 0 { r = 0 - r }
    return r
}

# ---- hex/binary text, by hand ------------------------------------------------
# The `hex` builtin (console_puthex) writes to the VGA/serial TEXT console,
# not the framebuffer - it is for the old shell, not a window. A windowed app
# has no string values to build ("42" is not a zl value it can construct), so
# base-converting a number into on-screen text means picking digits apart with
# arithmetic and drawing each one with char_aa, which takes a character CODE
# rather than a string. Shared here because Base Converter and Checksum both
# need it.
fn ac_hexchar(v) {
    if v < 10 { return 48 + v }        # '0'..'9'
    return 55 + v                       # 'A'..'F'  (55 + 10 = 'A' = 65)
}

# Draws `digits` hex characters of `val`, most significant first, at (x,y).
# `val` is treated as an unsigned magnitude - callers pass band()'d values.
fn ac_draw_base(x, y, val, digits, base, color) {
    dw = cell_w()
    di = digits - 1
    while di >= 0 {
        place = 1
        pk = 0
        while pk < di { place = place * base  pk = pk + 1 }
        dv = (val / place) % base
        char_aa(x + (digits - 1 - di) * dw, y, ac_hexchar(dv), color)
        di = di - 1
    }
    return 0
}
