# apps_system.zl - system apps beyond the original 13, built entirely on
# introspection builtins that already existed (cpu_*, rtc_*, smp_*, apic_*)
# - each one a real read of live kernel state, not a mockup.

# ==============================================================================
# Clocks & Timers - digital clock off rtc.c. GIVEN ITS OWN TICK SOURCE
# (clk_last_s below), deliberately NOT kernel.zl's app_tick `last_tick_sec`,
# which APP_MONITOR already owns: app_tick runs once per open window per
# frame, and two apps comparing the same shared "last second" variable race
# - whichever is ticked first in a frame updates it, so the second app's
# `if tsec != last_tick_sec` sees no change and never asks for a repaint.
# That is the exact bug this brief named ("one shared second-timer starved
# the Clock when another live system app ticked first"). One clock, one
# variable, nobody else touches it.
# ==============================================================================
clk_last_s = 0 - 1

fn clk_draw(ax, ay, aw, ah) {
    u = ui()
    if rtc_ok() == 0 {
        label(ax + 8 * u, ay + 10 * u, "no real-time clock on this machine", theme(TH_TEXT_DIM), T_BODY, W_REG)
        return 0
    }
    label(ax + 8 * u, ay + 8 * u, "local time", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ac_draw_base(ax + 8 * u, ay + 28 * u, rtc_h(), 2, 10, theme(TH_TEXT_HI))
    char_aa(ax + 8 * u + 2 * cell_w(), ay + 28 * u, 58, theme(TH_TEXT_HI))
    ac_draw_base(ax + 8 * u + 3 * cell_w(), ay + 28 * u, rtc_mi(), 2, 10, theme(TH_TEXT_HI))
    char_aa(ax + 8 * u + 5 * cell_w(), ay + 28 * u, 58, theme(TH_TEXT_HI))
    ac_draw_base(ax + 8 * u + 6 * cell_w(), ay + 28 * u, rtc_s(), 2, 10, theme(TH_ACCENT))

    label(ax + 8 * u, ay + 66 * u, "date", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ac_draw_base(ax + 8 * u, ay + 84 * u, rtc_y(), 4, 10, theme(TH_TEXT_HI))
    char_aa(ax + 8 * u + 4 * cell_w(), ay + 84 * u, 45, theme(TH_TEXT_DIM))
    ac_draw_base(ax + 8 * u + 5 * cell_w(), ay + 84 * u, rtc_mo(), 2, 10, theme(TH_TEXT_HI))
    char_aa(ax + 8 * u + 7 * cell_w(), ay + 84 * u, 45, theme(TH_TEXT_DIM))
    ac_draw_base(ax + 8 * u + 8 * cell_w(), ay + 84 * u, rtc_d(), 2, 10, theme(TH_TEXT_HI))

    label(ax + 8 * u, ay + 116 * u, "uptime ticks", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(ax + 8 * u, ay + 132 * u, ticks(), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    return 0
}

fn clk_tick() {
    if rtc_ok() == 0 { return 0 }
    s = rtc_s()
    if s != clk_last_s { clk_last_s = s  return 1 }
    return 0
}

# ==============================================================================
# System Info - live cpu_*/smp_*/apic_* reads. No state, no tick: none of
# this changes fast enough to need one, and app_draw already re-runs on
# every repaint.
# ==============================================================================
# the cell modes: size in the low byte, 256 right-aligns, 512 is the mono face
SI_M_MONO = 512
SI_M_NUM  = 768
fn si_yn(v) { if v == 1 { return "yes" }  return "no" }
fn si_row(ax, y, k, v) {
    label(ax, y, k, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label(ax + 130 * ui(), y, v, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
    return 0
}
fn si_rownum(ax, y, k, v) {
    label(ax, y, k, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(ax + 130 * ui(), y, v, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
    return 0
}

# THE REFERENCE'S SHAPE, THIS MACHINE'S REGISTERS. R.regs is `block`, a
# register / value / decode table, a derivation well and a band - and its
# subject is the Intel display block, reading PIPE_LINK_M/N off real silicon.
#
# That block reads ZERO under QEMU, which is the same reason the rail's PWR row
# shows WARN there. Printing the reference's 0x0080D9E4 on a machine with no
# Intel display would be inventing a reading, so the table shows the registers
# this machine DOES answer - cpuid and the APIC - and decodes each one. Same
# structure, real values, and it says which block it is reading.
SI_N = 9
fn si_reg(i) {
    if i == 0 { return "CPUID.1:EBX[23:16]" }
    if i == 1 { return "CPUID.1:EBX[31:24]" }
    if i == 2 { return "APIC:ICR startup" }
    if i == 3 { return "TSC / PIT gate" }
    if i == 4 { return "TSC frequency" }
    if i == 5 { return "CPUID.1:EDX[26]" }
    if i == 6 { return "CPUID.1:ECX[28]" }
    if i == 7 { return "CPUID.1:ECX[31]" }
    return "IA32_APIC_BASE[11]"
}
fn si_dec(i) {
    if i == 0 { return "logical cores this package reports" }
    if i == 1 { return "threads the topology leaf enumerates" }
    if i == 2 { return "processors that answered INIT/STARTUP" }
    if i == 3 { return "core clock, measured against the PIT" }
    if i == 4 { return "invariant TSC, kHz" }
    if i == 5 { return "SSE2 - the float path this kernel forbids" }
    if i == 6 { return "AVX - present, unused, no XSAVE area" }
    if i == 7 { return "hypervisor present bit" }
    return "local APIC enabled, not the 8259" }
fn si_val(i) {
    if i == 0 { return cpu_cores() }
    if i == 1 { return cpu_thr() }
    if i == 2 { return smp_n() }
    if i == 3 { return cpu_mhz() }
    if i == 4 { return cpu_khz() }
    if i == 5 { return cpu_sse2() }
    if i == 6 { return cpu_avx() }
    if i == 7 { return cpu_hv() }
    return apic_on()
}
# rows 5..8 are flags: their value column reads yes/no, not a figure
fn si_isflag(i) { if i >= 5 { return 1 }  return 0 }

fn si_draw(ax, ay, aw, ah) {
    u = ui()
    hdh = 22 * u
    # the head: which block, and whether it answered
    ui_caps(ax + 10 * u, ay + 6 * u, "BLOCK", theme(TH_TEXT_2), T_CAPTION)
    label(ax + 62 * u, ay + 6 * u, "cpuid + local apic", theme(TH_TEXT_HI), T_CAPTION, W_REG)
    sidx = ax + aw - 96 * u
    sicol = theme(TH_OK)
    if apic_on() == 0 { sicol = theme(TH_WARN) }
    ui_dot(sidx, ay + 6 * u + 5 * u, sicol, 0)
    if apic_on() == 1 { label(sidx + 12 * u, ay + 6 * u, "apic live", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if apic_on() == 0 { label(sidx + 12 * u, ay + 6 * u, "pic only", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }

    # the table: the reference's 30 / 24 / 46
    ui_grid("150|90|*")
    ui_colhead(ax, ay + hdh, aw, "register|value|decode", 0 - 1, 0)
    ry = ay + hdh + ui_colhead_h()
    rh = ui_growh()
    i = 0
    while i < SI_N {
        if ry + rh <= ay + ah - 8 * u {
            ui_grow(ax, ry, aw, i, 0)
            ui_gcell(ax, aw, ry, rh, 0, si_reg(i), theme(TH_TEXT_2), SI_M_MONO)
            if si_isflag(i) == 1 {
                ui_gcell(ax, aw, ry, rh, 1, si_yn(si_val(i)), theme(TH_TEXT_HI), SI_M_NUM)
            } else {
                ui_gcelln(ax, aw, ry, rh, 1, si_val(i), theme(TH_TEXT_HI), SI_M_NUM)
            }
            ui_gcell(ax, aw, ry, rh, 2, si_dec(i), theme(TH_TEXT_DIM), 0)
            ry = ry + rh
        }
        i = i + 1
    }
    return 0
}

# ==============================================================================
# Calculator - four functions. Keyboard (digits, + - * / . = c) and a
# clickable pad both drive the same entry/accumulator state.
# ==============================================================================
ca_acc  = 0
ca_op   = 0                         # 0 none, 1 + , 2 - , 3 * , 4 /
ca_entry = 0
ca_has_entry = 0

fn ca_apply() {
    if ca_op == 1 { ca_acc = ca_acc + ca_entry }
    if ca_op == 2 { ca_acc = ca_acc - ca_entry }
    if ca_op == 3 { ca_acc = ca_acc * ca_entry }
    if ca_op == 4 { if ca_entry != 0 { ca_acc = ca_acc / ca_entry } }
    if ca_op == 0 { ca_acc = ca_entry }
    return 0
}
fn ca_clear() { ca_acc = 0  ca_op = 0  ca_entry = 0  ca_has_entry = 0  return 0 }
fn ca_digit(n) { ca_entry = ca_entry * 10 + n  ca_has_entry = 1  return 0 }
fn ca_setop(o) {
    if ca_has_entry == 1 { ca_apply() } else { ca_op = o  return 0 }
    ca_op = o
    ca_entry = 0
    ca_has_entry = 0
    return 0
}
fn ca_equals() { ca_apply()  ca_op = 0  ca_entry = 0  ca_has_entry = 0  return 0 }

fn ca_btn_label(i) {
    if i == 0 { return "7" }  if i == 1 { return "8" }  if i == 2 { return "9" }  if i == 3 { return "/" }
    if i == 4 { return "4" }  if i == 5 { return "5" }  if i == 6 { return "6" }  if i == 7 { return "*" }
    if i == 8 { return "1" }  if i == 9 { return "2" }  if i == 10 { return "3" }  if i == 11 { return "-" }
    if i == 12 { return "C" }  if i == 13 { return "0" }  if i == 14 { return "=" }  return "+"
}
fn ca_btn_press(i) {
    if i == 0 { ca_digit(7)  return 0 }
    if i == 1 { ca_digit(8)  return 0 }
    if i == 2 { ca_digit(9)  return 0 }
    if i == 3 { ca_setop(4)  return 0 }
    if i == 4 { ca_digit(4)  return 0 }
    if i == 5 { ca_digit(5)  return 0 }
    if i == 6 { ca_digit(6)  return 0 }
    if i == 7 { ca_setop(3)  return 0 }
    if i == 8 { ca_digit(1)  return 0 }
    if i == 9 { ca_digit(2)  return 0 }
    if i == 10 { ca_digit(3)  return 0 }
    if i == 11 { ca_setop(2)  return 0 }
    if i == 12 { ca_clear()  return 0 }
    if i == 13 { ca_digit(0)  return 0 }
    if i == 14 { ca_equals()  return 0 }
    ca_setop(1)
    return 0
}

CA_BTN = 44
fn ca_draw(ax, ay, aw, ah) {
    u = ui()
    fill_rgb(ax + 8 * u, ay + 6 * u, aw - 16 * u, 30 * u, rgb(14, 17, 26))
    if ca_has_entry == 1 { label_num(ax + 12 * u, ay + 14 * u, ca_entry, theme(TH_TEXT_HI), T_TITLE, W_BOLD) }
    if ca_has_entry == 0 { label_num(ax + 12 * u, ay + 14 * u, ca_acc, theme(TH_TEXT_HI), T_TITLE, W_BOLD) }

    gy = ay + 46 * u
    i = 0
    while i < 16 {
        r = i / 4
        c = i % 4
        bx = ax + 8 * u + c * CA_BTN * u
        by = gy + r * CA_BTN * u
        bg = rgb(30, 36, 54)
        if i == 15 { bg = ac_cat_color(1) }
        rrect(bx + 2 * u, by + 2 * u, CA_BTN * u - 4 * u, CA_BTN * u - 4 * u, 6 * u, bg)
        label(bx + CA_BTN * u / 2 - 4 * u, by + CA_BTN * u / 2 - 8 * u, ca_btn_label(i), theme(TH_TEXT_HI), T_BODY, W_BOLD)
        i = i + 1
    }
    return 0
}

fn ca_event(win, ety, ecode, ex, ey) {
    if ety == 4 {
        if band(ecode, 1) == 0 { return 0 }
        u = ui()
        # ca_draw's grid starts at (ax + 8u, ay + 46u); cx/cy here are
        # already client-relative (matching ax/ay), so BOTH margins have to
        # be subtracted before dividing, and both checked non-negative
        # first - `/` truncates toward zero, so skipping either check would
        # be the same off-by-a-row/column misses this brief already warned
        # about elsewhere in this suite.
        cx = ex - wm_cx(win) - 8 * u
        cy = ey - wm_cy(win) - 46 * u
        if cx < 0 { return 0 }
        if cy < 0 { return 0 }
        c = cx / (CA_BTN * u)
        r = cy / (CA_BTN * u)
        if c > 3 { return 0 }
        if r > 3 { return 0 }
        ca_btn_press(r * 4 + c)
        wm_dmg(win)
        return 1
    }
    if ety != 3 { return 0 }
    if ecode == 99 { ca_clear()  wm_dmg(win)  return 1 }
    if ecode == 61 { ca_equals()  wm_dmg(win)  return 1 }
    if ecode == 13 { ca_equals()  wm_dmg(win)  return 1 }
    if ecode == 43 { ca_setop(1)  wm_dmg(win)  return 1 }
    if ecode == 45 { ca_setop(2)  wm_dmg(win)  return 1 }
    if ecode == 42 { ca_setop(3)  wm_dmg(win)  return 1 }
    if ecode == 47 { ca_setop(4)  wm_dmg(win)  return 1 }
    if ecode < 48 { return 0 }
    if ecode > 57 { return 0 }
    ca_digit(ecode - 48)
    wm_dmg(win)
    return 1
}
