# apps_system.zl - system apps beyond the original 13, built entirely on
# introspection builtins that already existed (cpu_*, rtc_*, smp_*, apic_*)
# - each one a real read of live kernel state, not a mockup.

# ==============================================================================
# Clocks & Timers - digital clock off rtc.c. GIVEN ITS OWN TICK SOURCE
# (clk_last_s below), deliberately NOT kernel.zl's app_tick `last_tick_sec`,
# which APP_MONITOR already owns: app_tick runs once per open window per
# frame, and two apps comparing the same shared "last second" variable race
# - whichever is ticked first in a frame updates it, so the second app's
# `if tsec != last_tick_sec` sees no change and never asks for a repaint.
# That is the exact bug this brief named ("one shared second-timer starved
# the Clock when another live system app ticked first"). One clock, one
# variable, nobody else touches it.
# ==============================================================================
clk_last_s = 0 - 1

# R.clock: a source head, three duration cards, the readings, and a well that
# says why the wall clock is not one of them.
#
# THE PANE IS ABOUT MONOTONIC TIME, which is the reference's whole point - "every
# duration on this pane is read from the monotonic counter, never from the wall
# clock". This drew the RTC's hours, minutes and date, which is the one clock
# that cannot be trusted for a duration.
#
# AND IT IS NOT TRUE HERE, which is the opposite of what this used to say. The
# line above was "this machine's RTC runs days slow and NTP corrects it
# mid-session" - a fact about the Linux box this OS is BUILT on, copied out of
# the prototype and asserted about the guest. There is no NTP client anywhere in
# this kernel, so nothing ever corrects the RTC and nothing observes it drifting.
# The conclusion survives and the reason changes: durations come from ticks()
# because the RTC is a wall clock nobody disciplines, not because something
# steps it mid-session.
#
# The source line says PIT at 100 Hz because that is what this kernel programs -
# the reference's "apic timer, 1000.15 Hz measured" is its machine, not this one.
fn clk_hms_h(t) { return idiv(t, 3600) }
fn clk_hms_m(t) { return idiv(t, 60) % 60 }
fn clk_hms_s(t) { return t % 60 }

# one duration card: label above, h m s below, in the card's own plate
fn clk_card(cx, cy, cw, ch, nm, secs) {
    cu = ui()
    rrect(cx, cy, cw, ch, R_INSET_D * cu, theme(TH_PANEL_HI))
    ui_caps(cx + 10 * cu, cy + 7 * cu, nm, theme(TH_TEXT_2), T_CAPTION)
    vx = cx + 10 * cu
    vy = cy + 24 * cu
    ac_draw_base(vx, vy, clk_hms_h(secs), 2, 10, theme(TH_TEXT_HI))
    label(vx + 2 * cell_w() + 2 * cu, vy, "h", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    vx = vx + 3 * cell_w() + 4 * cu
    ac_draw_base(vx, vy, clk_hms_m(secs), 2, 10, theme(TH_TEXT_HI))
    label(vx + 2 * cell_w() + 2 * cu, vy, "m", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    vx = vx + 3 * cell_w() + 4 * cu
    ac_draw_base(vx, vy, clk_hms_s(secs), 2, 10, theme(TH_TEXT_HI))
    label(vx + 2 * cell_w() + 2 * cu, vy, "s", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    return 0
}

# a reading row: LABEL, then the figure, then its unit and note
fn clk_kv(kx, ky, kw, nm, val, unit) {
    ku = ui()
    ui_caps(kx, ky, nm, theme(TH_TEXT_2), T_CAPTION)
    label_num(kx + 96 * ku, ky, val, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(kx + 96 * ku + s3_numw(val) + 5 * ku, ky, unit, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    return 0
}

fn clk_draw(ax, ay, aw, ah) {
    # ui_begin FIRST. ui.c keeps the draw/hit-test mode in a file static that
    # only ui_begin sets, and every gated uikit widget opens with
    # `if (ui_mode_get() != UI_DRAW) return;`. kernel.zl's menu_event leaves it
    # at UI_HITTEST after any left-click in the start menu and nothing restores
    # it - so this pane painted its grid cells, column heads, dots and mono
    # panels normally until the first menu click, and nothing afterwards.
    #
    # apps_utils.zl documents this hazard in as many words, and this file was
    # one of the two that did not follow it. A written warning nobody applied
    # is a guess with a citation.
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    u = ui()
    up = idiv(ticks(), 100)

    # the head: which counter these durations come from, and whether it is sound
    ui_caps(ax + 10 * u, ay + 6 * u, "SOURCE", theme(TH_TEXT_2), T_CAPTION)
    label(ax + 72 * u, ay + 6 * u, "PIT, 100 Hz on IRQ0", theme(TH_TEXT_HI), T_CAPTION, W_REG)
    scol = theme(TH_OK)
    if rtc_ok() == 0 { scol = theme(TH_WARN) }
    ui_dot(ax + aw - 74 * u, ay + 11 * u, scol, 0)
    if rtc_ok() == 1 { label(ax + aw - 62 * u, ay + 6 * u, "monotonic", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if rtc_ok() == 0 { label(ax + aw - 62 * u, ay + 6 * u, "no rtc", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }

    # THREE CARDS, and only two of them are different numbers. The reference's
    # third is `process`, which needs per-process accounting this kernel does
    # not keep - so the third card is the TICK COUNT itself rather than an
    # invented third duration.
    cy = ay + 26 * u
    cw = (aw - 26 * u) / 3
    chh = 46 * u
    clk_card(ax + 8 * u, cy, cw, chh, "MONOTONIC", up)
    clk_card(ax + 13 * u + cw, cy, cw, chh, "SINCE BOOT", up)
    rrect(ax + 18 * u + 2 * cw, cy, cw, chh, R_INSET_D * u, theme(TH_PANEL_HI))
    ui_caps(ax + 28 * u + 2 * cw, cy + 7 * u, "TICKS", theme(TH_TEXT_2), T_CAPTION)
    label_num(ax + 28 * u + 2 * cw, cy + 24 * u, ticks(), theme(TH_TEXT_HI), T_CAPTION, W_BOLD)

    # the readings this machine can actually take
    ky = cy + chh + 12 * u
    # 100 IS THE FREQUENCY, NOT THE DIVISOR. idt.c programs
    # `divisor = 1193182 / 100`, so the divisor is 11931 and 100 is the rate it
    # produces. Calling the rate a divisor names the wrong quantity while
    # printing the right number, which is the kind of error that survives
    # review precisely because the figure beside it checks out.
    clk_kv(ax + 12 * u, ky, aw, "TICK", 100, "Hz from the PIT, divisor 11931 of 1193182")
    ky = ky + 17 * u
    clk_kv(ax + 12 * u, ky, aw, "BUDGET", wm_budget(), "us per presentation deadline")
    ky = ky + 17 * u
    # "invariant" WAS PRINTED UNCONDITIONALLY while cpu_inv() - CPUID
    # 0x80000007 EDX bit 8 - sat bound and unused. On a part without it the TSC
    # changes rate with the core clock, which is exactly when a reader needs to
    # be told, and exactly when the old caption said the opposite.
    if cpu_inv() == 1 { clk_kv(ax + 12 * u, ky, aw, "TSC", cpu_khz(), "kHz, invariant") } else { clk_kv(ax + 12 * u, ky, aw, "TSC", cpu_khz(), "kHz, NOT invariant - rate follows the core") }
    ky = ky + 17 * u
    if rtc_ok() == 1 {
        ui_caps(ax + 12 * u, ky, "WALL", theme(TH_TEXT_2), T_CAPTION)
        ac_draw_base(ax + 108 * u, ky, rtc_h(), 2, 10, theme(TH_TEXT_HI))
        char_aa(ax + 108 * u + 2 * cell_w(), ky, 58, theme(TH_TEXT_DIM))
        ac_draw_base(ax + 108 * u + 3 * cell_w(), ky, rtc_mi(), 2, 10, theme(TH_TEXT_HI))
        label(ax + 108 * u + 6 * cell_w(), ky, "wall clock, never differenced", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        ui_caps(ax + 12 * u, ky, "WALL", theme(TH_TEXT_2), T_CAPTION)
        label(ax + 108 * u, ky, "no real-time clock on this machine", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }

    # the well: why the wall clock is stated and not used
    wy = ky + 24 * u
    # 62, not 50: three lines inset 9 dp at a 15 dp lead need 9 + 3*15 = 54,
    # and the panel was 50 - so the last line, which is the one that names the
    # rule, was clipped through the middle.
    if wy + 64 * u <= ay + ah - 6 * u {
        ui_mono(ax + 10 * u, wy, aw - 20 * u, 62 * u, 0)
        # THIS USED TO DESCRIBE THE DEVELOPMENT MACHINE, NOT THIS ONE. It said
        # "this rtc runs slow and ntp corrects it mid session" - which is true
        # of the Linux box this OS is built on, and impossible here: there is no
        # NTP client anywhere in this kernel, and nothing ever observes drift.
        # A fact about the host had leaked into the guest's own UI and was being
        # printed as if measured. What IS true is the reason the note exists:
        # "READ ONCE AT BOOT" WAS ALSO WRONG, AND IT WAS TODAY'S CORRECTION.
        #
        # Replacing the NTP claim, I wrote that the RTC is read once at boot.
        # It is not: kernel.zl samples it once before the first frame AND
        # rail_clock_tick re-reads the CMOS through rtc_up() once per monotonic
        # second, for as long as a non-minimised window is open. A second false
        # mechanism in the place a first one was just removed from.
        #
        # What is actually true - and is the point the note exists to make - is
        # that it is never CORRECTED against anything and never DIFFERENCED to
        # produce a duration. Those two are the reason it cannot time anything,
        # and neither depends on how often it is sampled.
        label(ax + 20 * u, wy + 9 * u, "the rtc is re-read once a second and never corrected - there is", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label(ax + 20 * u, wy + 24 * u, "no ntp on this machine, so it drifts and nothing observes it.", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label(ax + 20 * u, wy + 39 * u, "every duration above is read from ticks(), not from the rtc.", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    return 0
}

# THE PANE REPAINTED ONLY WHEN THE CLOCK IT DOES NOT TRUST TICKED.
#
# This opened `if rtc_ok() == 0 { return 0 }` and then compared rtc_s(), which
# returns a CACHED second refreshed only by rtc_read() through rail_clock_tick.
# rail_clock_tick latches rtc_fails at RTC_GIVE_UP after three bad reads and
# stops calling rtc_up() for the rest of the session - so on a machine with no
# CMOS, or one that glitches three times, this pane froze permanently. Its
# uptime and its stopwatch, which are driven by ticks() and not by the RTC at
# all, froze with it.
#
# The tick is now the counter the pane actually reads. idiv, not `/`: `/` is
# float division here, so `ticks() / 100` changes on every tick and the guard
# never holds - the same bug this file's foot_tick had.
fn clk_tick() {
    s = idiv(ticks(), 100)
    if s != clk_last_s { clk_last_s = s  return 1 }
    return 0
}

# ==============================================================================
# System Info - live cpu_*/smp_*/apic_* reads. No state, no tick: none of
# this changes fast enough to need one, and app_draw already re-runs on
# every repaint.
# ==============================================================================
# the cell modes: size in the low byte, 256 right-aligns, 512 is the mono face
SI_M_MONO = 512
SI_M_NUM  = 768
fn si_yn(v) { if v == 1 { return "yes" }  return "no" }
fn si_row(ax, y, k, v) {
    label(ax, y, k, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label(ax + 130 * ui(), y, v, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
    return 0
}
fn si_rownum(ax, y, k, v) {
    label(ax, y, k, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(ax + 130 * ui(), y, v, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
    return 0
}

# THE REFERENCE'S SHAPE, THIS MACHINE'S REGISTERS. R.regs is `block`, a
# register / value / decode table, a derivation well and a band - and its
# subject is the Intel display block, reading PIPE_LINK_M/N off real silicon.
#
# That block reads ZERO under QEMU, which is the same reason the rail's PWR row
# shows WARN there. Printing the reference's 0x0080D9E4 on a machine with no
# Intel display would be inventing a reading, so the table shows the registers
# this machine DOES answer - cpuid and the APIC - and decodes each one. Same
# structure, real values, and it says which block it is reading.
# THREE OF THESE NAMED A REGISTER FIELD THE CODE DOES NOT READ.
#
# Rows 0 and 1 said CPUID.1:EBX[23:16] and [31:24]. cpu_threads() reads CPUID
# LEAF 0x0B, the topology leaf, and cpu_cores() is a derivation from it
# (threads / threads_per_core) - neither touches leaf 1's EBX, and [31:24]
# there is the initial APIC id, not a thread count. Row 8 said
# IA32_APIC_BASE[11]; apic_active() returns the kernel's own file-static
# apic_on flag, which is what this kernel DID, and the MSR can disagree with it.
#
# A register column that names a field nobody read is the worst version of this
# fault: it is checkable, it looks checked, and the value beside it is right.
SI_N = 9
fn si_reg(i) {
    if i == 0 { return "CPUID.0Bh topology" }
    if i == 1 { return "CPUID.0Bh threads" }
    if i == 2 { return "smp cores online" }
    if i == 3 { return "TSC / PIT gate" }
    if i == 4 { return "TSC frequency" }
    if i == 5 { return "CPUID.1:EDX[26]" }
    if i == 6 { return "CPUID.1:ECX[28]" }
    if i == 7 { return "CPUID.1:ECX[31]" }
    return "apic_on, kernel flag"
}
fn si_dec(i) {
    if i == 0 { return "cores, derived as threads / per-core" }
    if i == 1 { return "threads the topology leaf enumerates" }
    # NOT "processors that answered INIT/STARTUP". smp_n() counts cores the
    # kernel has brought online, and on a machine where no startup IPI was ever
    # sent it is 1 - the BSP, which answered nothing. The old decode read that 1
    # as evidence of a handshake that had not happened.
    if i == 2 { return "cores online, BSP included" }
    if i == 3 { return "core clock, measured against the PIT" }
    # Invariance is reported by the clocks pane, which reads cpu_inv(). Asserting
    # it here as well would be a second unchecked copy of the same claim.
    if i == 4 { return "TSC frequency, kHz" }
    if i == 5 { return "SSE2 - the float path this kernel forbids" }
    if i == 6 { return "AVX - present, unused, no XSAVE area" }
    if i == 7 { return "hypervisor present bit" }
    return "the APIC this kernel enabled, not the MSR bit" }
fn si_val(i) {
    if i == 0 { return cpu_cores() }
    if i == 1 { return cpu_thr() }
    if i == 2 { return smp_n() }
    if i == 3 { return cpu_mhz() }
    if i == 4 { return cpu_khz() }
    if i == 5 { return cpu_sse2() }
    if i == 6 { return cpu_avx() }
    if i == 7 { return cpu_hv() }
    return apic_on()
}
# rows 5..8 are flags: their value column reads yes/no, not a figure
fn si_isflag(i) { if i >= 5 { return 1 }  return 0 }

fn si_draw(ax, ay, aw, ah) {
    # ui_begin FIRST. ui.c keeps the draw/hit-test mode in a file static that
    # only ui_begin sets, and every gated uikit widget opens with
    # `if (ui_mode_get() != UI_DRAW) return;`. kernel.zl's menu_event leaves it
    # at UI_HITTEST after any left-click in the start menu and nothing restores
    # it - so this pane painted its grid cells, column heads, dots and mono
    # panels normally until the first menu click, and nothing afterwards.
    #
    # apps_utils.zl documents this hazard in as many words, and this file was
    # one of the two that did not follow it. A written warning nobody applied
    # is a guess with a citation.
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    u = ui()
    hdh = 22 * u
    # the head: which block, and whether it answered
    ui_caps(ax + 10 * u, ay + 6 * u, "BLOCK", theme(TH_TEXT_2), T_CAPTION)
    label(ax + 62 * u, ay + 6 * u, "cpuid + local apic", theme(TH_TEXT_HI), T_CAPTION, W_REG)
    sidx = ax + aw - 96 * u
    sicol = theme(TH_OK)
    if apic_on() == 0 { sicol = theme(TH_WARN) }
    ui_dot(sidx, ay + 6 * u + 5 * u, sicol, 0)
    if apic_on() == 1 { label(sidx + 12 * u, ay + 6 * u, "apic live", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if apic_on() == 0 { label(sidx + 12 * u, ay + 6 * u, "pic only", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }

    # the table: the reference's 30 / 24 / 46
    ui_grid("150|90|*")
    ui_colhead(ax, ay + hdh, aw, "register|value|decode", 0 - 1, 0)
    ry = ay + hdh + ui_colhead_h()
    rh = ui_growh()
    i = 0
    while i < SI_N {
        if ry + rh <= ay + ah - 8 * u {
            ui_grow(ax, ry, aw, i, 0)
            ui_gcell(ax, aw, ry, rh, 0, si_reg(i), theme(TH_TEXT_2), SI_M_MONO)
            if si_isflag(i) == 1 {
                ui_gcell(ax, aw, ry, rh, 1, si_yn(si_val(i)), theme(TH_TEXT_HI), SI_M_NUM)
            } else {
                ui_gcelln(ax, aw, ry, rh, 1, si_val(i), theme(TH_TEXT_HI), SI_M_NUM)
            }
            ui_gcell(ax, aw, ry, rh, 2, si_dec(i), theme(TH_TEXT_DIM), 0)
            ry = ry + rh
        }
        i = i + 1
    }
    return 0
}

# ==============================================================================
# Calculator - four functions. Keyboard (digits, + - * / . = c) and a
# clickable pad both drive the same entry/accumulator state.
# ==============================================================================
ca_acc  = 0
ca_op   = 0                         # 0 none, 1 + , 2 - , 3 * , 4 /
ca_entry = 0
ca_has_entry = 0

fn ca_apply() {
    if ca_op == 1 { ca_acc = ca_acc + ca_entry }
    if ca_op == 2 { ca_acc = ca_acc - ca_entry }
    if ca_op == 3 { ca_acc = ca_acc * ca_entry }
    if ca_op == 4 { if ca_entry != 0 { ca_acc = ca_acc / ca_entry } }
    if ca_op == 0 { ca_acc = ca_entry }
    return 0
}
fn ca_clear() { ca_acc = 0  ca_op = 0  ca_entry = 0  ca_has_entry = 0  return 0 }
fn ca_digit(n) { ca_entry = ca_entry * 10 + n  ca_has_entry = 1  return 0 }
fn ca_setop(o) {
    if ca_has_entry == 1 { ca_apply() } else { ca_op = o  return 0 }
    ca_op = o
    ca_entry = 0
    ca_has_entry = 0
    return 0
}
fn ca_equals() { ca_apply()  ca_op = 0  ca_entry = 0  ca_has_entry = 0  return 0 }

fn ca_btn_label(i) {
    if i == 0 { return "7" }  if i == 1 { return "8" }  if i == 2 { return "9" }  if i == 3 { return "/" }
    if i == 4 { return "4" }  if i == 5 { return "5" }  if i == 6 { return "6" }  if i == 7 { return "*" }
    if i == 8 { return "1" }  if i == 9 { return "2" }  if i == 10 { return "3" }  if i == 11 { return "-" }
    if i == 12 { return "C" }  if i == 13 { return "0" }  if i == 14 { return "=" }  return "+"
}
fn ca_btn_press(i) {
    if i == 0 { ca_digit(7)  return 0 }
    if i == 1 { ca_digit(8)  return 0 }
    if i == 2 { ca_digit(9)  return 0 }
    if i == 3 { ca_setop(4)  return 0 }
    if i == 4 { ca_digit(4)  return 0 }
    if i == 5 { ca_digit(5)  return 0 }
    if i == 6 { ca_digit(6)  return 0 }
    if i == 7 { ca_setop(3)  return 0 }
    if i == 8 { ca_digit(1)  return 0 }
    if i == 9 { ca_digit(2)  return 0 }
    if i == 10 { ca_digit(3)  return 0 }
    if i == 11 { ca_setop(2)  return 0 }
    if i == 12 { ca_clear()  return 0 }
    if i == 13 { ca_digit(0)  return 0 }
    if i == 14 { ca_equals()  return 0 }
    ca_setop(1)
    return 0
}

CA_BTN = 44
# R.calc: a right-aligned display well, the same value in three other bases, the
# width note, a rule, the sixteen keys, and a band.
#
# THE COLOURS WERE RAW LITERALS. This drew its display on rgb(14,17,26) and its
# keys on rgb(30,36,54) - blue-slate values from the palette PRESSWORK replaced,
# and design.h says it is the ONLY place a colour literal may appear. They are
# theme roles now, so the calculator answers a theme change like everything else.
#
# THE THREE BASES ARE THE POINT of a calculator in an OS written in a language
# with no floats. ac_draw_base renders an integer in any base, so hex, octal and
# binary come from the same value the display shows rather than from a second
# conversion. The width row states the constraint outright.
fn ca_val() { if ca_has_entry == 1 { return ca_entry }  return ca_acc }

# WHERE THE KEYPAD STARTS, IN ONE PLACE.
#
# ca_draw built it by accumulation - 42 + 16 + 16 + 16 + 18 + 8 = 116 - and
# ca_event subtracted a flat 46, with a comment directly above asserting
# "ca_draw's grid starts at (ax + 8u, ay + 46u)". A comment stating the opposite
# of the code, which is the class this repo keeps catching.
#
# The consequence is arithmetic, not opinion: '7' is drawn at ay+116u..ay+160u,
# so a click on it gives cy in [70u, 114u), r = cy/44u = 1 or 2, and presses '4'
# or '1'. The bottom row - C, 0, = - is drawn at ay+248u..ay+292u, giving r = 4
# or 5, which `if r > 3 { return 0 }` rejects outright. Three keys were
# unreachable and the rest hit the wrong one.
fn ca_grid_y() { return 116 * ui() }

# THE KEY WIDTH IS DERIVED FROM THE PLATE, not fixed at 44 design units.
#
# Four columns of a fixed CA_BTN filled 8 + 4*44 = 184 units of a client the
# registry gives as 360 - the prototype's own p[2] for `calc` - so nearly half
# the plate was empty to the right of the keys. The prototype lays the same
# sixteen keys out as `grid-template-columns: repeat(4, 1fr)` inside the pane's
# padding: the keys divide the width, they do not sit in a corner of it.
#
# One owner, because the draw and the hit test both need it and this suite has
# already been bitten by those two computing a geometry separately - which is
# what ca_grid_y exists for. `/` truncates toward zero here, which is what the
# hit test wants.
fn ca_btn_w(aw) { return idiv(aw - 16 * ui(), 4) }

fn ca_draw(ax, ay, aw, ah) {
    u = ui()
    dw = aw - 16 * u
    # the display: a well, value right-aligned as the reference has it
    rrect(ax + 8 * u, ay + 6 * u, dw, 30 * u, R_INSET_D * u, theme(TH_PANEL_HI))
    # MEASURE THE FACE YOU DRAW IN. s3_numw is digits times cell_w() - the
    # fixed 8px advance of the AA console font that num_aa uses - but this line
    # draws with label_num at T_TITLE, which is the PROPORTIONAL face at roughly
    # twice that size. So the right-flush subtracted a width the glyphs do not
    # have and the number hung off the well's right edge, by more the longer it
    # got. ui_tnw measures a number in the face and size it is about to be drawn
    # in, which is the whole reason it exists.
    cvw = ui_tnw(ca_val(), T_TITLE, W_BOLD)
    label_num(ax + 8 * u + dw - 10 * u - cvw, ay + 14 * u, ca_val(), theme(TH_TEXT_HI), T_TITLE, W_BOLD)

    # the same number, three other ways
    ky = ay + 42 * u
    ui_caps(ax + 12 * u, ky, "HEX", theme(TH_TEXT_2), T_CAPTION)
    ac_draw_base(ax + 78 * u, ky, ca_val(), 8, 16, theme(TH_TEXT_HI))
    ky = ky + 16 * u
    ui_caps(ax + 12 * u, ky, "OCTAL", theme(TH_TEXT_2), T_CAPTION)
    ac_draw_base(ax + 78 * u, ky, ca_val(), 11, 8, theme(TH_TEXT_HI))
    ky = ky + 16 * u
    ui_caps(ax + 12 * u, ky, "BINARY", theme(TH_TEXT_2), T_CAPTION)
    ac_draw_base(ax + 78 * u, ky, ca_val(), 16, 2, theme(TH_TEXT_HI))
    ky = ky + 16 * u
    ui_caps(ax + 12 * u, ky, "WIDTH", theme(TH_TEXT_2), T_CAPTION)
    label(ax + 78 * u, ky, "int64, no float in the drawing path", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ky = ky + 18 * u
    fill_rgb(ax + 12 * u, ky, dw - 8 * u, 1, theme(TH_CUT))

    # ky has accumulated to exactly ca_grid_y(); use the shared value so the
    # draw and the hit test cannot drift apart again.
    gy = ay + ca_grid_y()
    i = 0
    while i < 16 {
        r = i / 4
        c = i % 4
        bx = ax + 8 * u + c * ca_btn_w(aw)
        by = gy + r * CA_BTN * u
        bg = theme(TH_PANEL_HI)
        kc = theme(TH_TEXT_HI)
        # `=` IS THE PRIMARY, and it is index 14 here. The reference's last row
        # is `0 . = +` and it marks `=` as .btn.prim - the one key that COMMITS
        # rather than continues. This accented 15, which is `+`, so the accent
        # sat on an operator.
        #
        # Index 12 is `C` where the reference has `.`, and that is right rather
        # than a mismatch: a decimal point in a calculator whose drawing path
        # has no floats is a key that would do nothing.
        if i == 14 { bg = theme(TH_ACCENT)  kc = theme(TH_INK_ON) }
        rrect(bx + 2 * u, by + 2 * u, ca_btn_w(aw) - 4 * u, CA_BTN * u - 4 * u, R_INSET_D * u, bg)
        label(bx + idiv(ca_btn_w(aw), 2) - 4 * u, by + CA_BTN * u / 2 - 8 * u, ca_btn_label(i), kc, T_BODY, W_BOLD)
        i = i + 1
    }
    # THE NOTE WAS A WRITTEN FIGURE STANDING BESIDE ITS OWN NATIVE. It said
    # "241690 kHz is the measured pixel clock" as a literal - a number this
    # project did measure once, on one machine, quoted here forever. gpu_clk()
    # reads it live, and returns 0 where there is no Intel pipe to read, which
    # is the case the literal silently denied.
    ny = gy + 4 * CA_BTN * u + 6 * u
    ui_caps(ax + 12 * u, ny, "NOTE", theme(TH_TEXT_2), T_CAPTION)
    if gpu_clk() > 0 {
        num_aa(ax + 60 * u, ny, gpu_clk(), theme(TH_TEXT_2))
        label(ax + 60 * u + s3_numw(gpu_clk()), ny, " kHz, the pixel clock read from this pipe", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(ax + 60 * u, ny, "no intel pipe here - the pixel clock cannot be read", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    return 0
}

fn ca_event(win, ety, ecode, ex, ey) {
    if ety == 4 {
        if band(ecode, 1) == 0 { return 0 }
        u = ui()
        # ca_draw's grid starts at (ax + 8u, ay + 46u); cx/cy here are
        # already client-relative (matching ax/ay), so BOTH margins have to
        # be subtracted before dividing, and both checked non-negative
        # first - `/` truncates toward zero, so skipping either check would
        # be the same off-by-a-row/column misses this brief already warned
        # about elsewhere in this suite. The y margin is ca_grid_y(), which
        # ca_draw also uses; the 46 that used to be here was never the grid's
        # origin and the comment claiming it was is deleted with it.
        cx = ex - wm_cx(win) - 8 * u
        cy = ey - wm_cy(win) - ca_grid_y()
        if cx < 0 { return 0 }
        if cy < 0 { return 0 }
        c = idiv(cx, ca_btn_w(wm_cw(win)))
        r = cy / (CA_BTN * u)
        if c > 3 { return 0 }
        if r > 3 { return 0 }
        ca_btn_press(r * 4 + c)
        wm_dmg(win)
        return 1
    }
    if ety != 3 { return 0 }
    if ecode == 99 { ca_clear()  wm_dmg(win)  return 1 }
    if ecode == 61 { ca_equals()  wm_dmg(win)  return 1 }
    if ecode == 13 { ca_equals()  wm_dmg(win)  return 1 }
    if ecode == 43 { ca_setop(1)  wm_dmg(win)  return 1 }
    if ecode == 45 { ca_setop(2)  wm_dmg(win)  return 1 }
    if ecode == 42 { ca_setop(3)  wm_dmg(win)  return 1 }
    if ecode == 47 { ca_setop(4)  wm_dmg(win)  return 1 }
    if ecode < 48 { return 0 }
    if ecode > 57 { return 0 }
    ca_digit(ecode - 48)
    wm_dmg(win)
    return 1
}
