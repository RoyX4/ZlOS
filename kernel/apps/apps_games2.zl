# apps_games2.zl - grid/state games. See apps_registry.zl for the shared
# registry and apps_common.zl for the grid helpers most of these use.
#
# kernel.elf is close to raw_boot.asm's CHUNKS ceiling (see the note in
# apps_registry.zl's REG_COUNT comment) - every app added here has to earn
# its bytes, so these are written tighter than apps_utils.zl's.

# ==============================================================================
# Word Guess - 8-word list, 6 rows x 5 columns, keyboard entry, per-letter
# feedback (grey/yellow/green). WG_BOARD packs one cell per byte: letter in
# bits 0-4 (a=0..z=25), status in bits 5-6 (0 untried, 1 absent, 2 present,
# 3 correct).
#
# THE NAMED BUG: a previous attempt at this app started wg_row at 2, so the
# first two rows of the grid were skipped and unusable. wg_reset() sets it to
# 0, and there is no other assignment to wg_row anywhere below that could
# move it before the first guess.
# ==============================================================================
WG_ROWS = 6
WG_COLS = 5
WG_WORDS = 8

wg_widx = 0
wg_row  = 0                         # ROW 0. Not 2. See the note above.
wg_col  = 0
wg_done = 0                         # 0 playing, 1 won, 2 lost

fn wg_word(w, p) {
    if w == 0 { if p == 0 { return 2 }  if p == 1 { return 17 }  if p == 2 { return 0 }  if p == 3 { return 13 }  return 4 }    # crane
    if w == 1 { if p == 0 { return 15 } if p == 1 { return 11 }  if p == 2 { return 0 }  if p == 3 { return 13 }  return 19 }   # plant
    if w == 2 { if p == 0 { return 18 } if p == 1 { return 19 }  if p == 2 { return 14 } if p == 3 { return 17 }  return 12 }   # storm
    if w == 3 { if p == 0 { return 1 }  if p == 1 { return 17 }  if p == 2 { return 0 }  if p == 3 { return 21 }  return 4 }    # brave
    if w == 4 { if p == 0 { return 12 } if p == 1 { return 14 }  if p == 2 { return 20 } if p == 3 { return 18 }  return 4 }    # mouse
    if w == 5 { if p == 0 { return 6 }  if p == 1 { return 17 }  if p == 2 { return 0 }  if p == 3 { return 15 }  return 4 }    # grape
    if w == 6 { if p == 0 { return 7 }  if p == 1 { return 14 }  if p == 2 { return 20 } if p == 3 { return 18 }  return 4 }    # house
    if p == 0 { return 19 }  if p == 1 { return 17 }  if p == 2 { return 0 }  if p == 3 { return 8 }  return 13                # train
}

fn wg_reset() {
    # Seeded from ticks(), the same technique sn_reset() already uses for
    # Snake's food placement - without it ac_seed starts at the same
    # compile-time constant every boot, so the very first Word Guess of any
    # session would always land on the same word.
    ac_seed_from(ticks() + 11)
    wg_widx = ac_rand(WG_WORDS)
    wg_row = 0
    wg_col = 0
    wg_done = 0
    fill_mem(WG_BOARD, 0, WG_ROWS * WG_COLS)
    return 0
}

# ---- the packed cell, unpacked with BIT OPS and never with `/` ---------------
# A cell is `letter | status << 5`. It used to be read back as `v / 32` and
# `v % 32`, and that makes the rule BACKEND-DEPENDENT: the kernel runtime casts
# both operands of `/` to long long, the host interpreter does not, so 96 / 32
# is 3 in one and 3.0 in the other and 97 / 32 is 3 in one and 3.03125 in the
# other. hosttest/games4_rules.zl's header documents that trap and the fix -
# band and shr are exact in both - so the accessors below are the only way this
# file touches a packed cell.
fn wg_letter(r, c) { return band(peek8(WG_BOARD + r * WG_COLS + c), 31) }
fn wg_state(r, c)  { return shr(peek8(WG_BOARD + r * WG_COLS + c), 5) }
fn wg_put(r, c, letter, st) {
    poke8(WG_BOARD + r * WG_COLS + c, bor(band(letter, 31), shl(st, 5)))
    return 0
}

# ---- scoring, and the duplicate letter that the first version got wrong -----
# The old rule was "green if it matches here, else yellow if this letter occurs
# ANYWHERE in the target". That is the classic wrong answer, and it is wrong in
# both directions at once:
#
#   target STORM, guess ROOMS -> the second O has nothing left to match (STORM
#   has one O and the first already claimed it) but the old rule paints both
#   yellow, so the board says the word has two Os.
#   target GRAPE, guess EERIE -> R and E are green/placed, yet every remaining
#   E was painted yellow as well, which says "there are more Es" when there
#   are none.
#
# The rule every implementation of this game actually uses is a two-pass
# consumption: greens first, each claiming its own target letter, then each
# remaining guess letter takes ONE unclaimed target letter or stays grey.
#
# The claim set is FIVE BITS OF AN INTEGER, not a 26-entry tally in memory. It
# only ever has WG_COLS members, band/shl are exact in both runtimes, and it
# needs no address - so it cannot collide with a page some other slice owns.
fn wg_submit() {
    if wg_col != WG_COLS { return 0 }
    if wg_done != 0 { return 0 }
    used = 0
    ok = 1
    ci = 0
    while ci < WG_COLS {
        g = wg_letter(wg_row, ci)
        if g == wg_word(wg_widx, ci) {
            wg_put(wg_row, ci, g, 3)
            used = bor(used, shl(1, ci))
        } else {
            wg_put(wg_row, ci, g, 1)
            ok = 0
        }
        ci = ci + 1
    }
    ci = 0
    while ci < WG_COLS {
        if wg_state(wg_row, ci) == 1 {
            g = wg_letter(wg_row, ci)
            hit = 0 - 1
            fi = 0
            while fi < WG_COLS {
                if hit < 0 {
                    if band(used, shl(1, fi)) == 0 {
                        if wg_word(wg_widx, fi) == g { hit = fi }
                    }
                }
                fi = fi + 1
            }
            if hit >= 0 {
                used = bor(used, shl(1, hit))
                wg_put(wg_row, ci, g, 2)
            }
        }
        ci = ci + 1
    }
    if ok == 1 { wg_done = 1  return 0 }
    wg_row = wg_row + 1
    wg_col = 0
    if wg_row >= WG_ROWS { wg_done = 2 }
    return 0
}

# Green is TH_OK and amber is TH_WARN - the reference's own state pair, wired
# to meaning rather than to the accent setting, exactly as ui.c:78-80 says
# those two roles are for. Grey-absent is TH_BORDER (ZD_SURF_6, "chip faces")
# and an untouched cell is TH_SURF_1, the sunken-well token, which is what an
# empty input slot is everywhere else in this desktop.
fn wg_status_col(st) {
    if st == 3 { return theme(TH_OK) }
    if st == 2 { return theme(TH_WARN) }
    if st == 1 { return theme(TH_BORDER) }
    return theme(TH_SURF_1)
}
# Ink that survives its tile. TH_OK and TH_WARN are bright fills; the same
# near-white the grey tiles use disappears on them. theme(TH_BG) is the
# dark-ink-on-a-bright-fill idiom apps_games3.zl/apps_games4.zl already use
# (g48_ink, the Fifteen puzzle's solved tile).
fn wg_ink(st) {
    if st == 3 { return theme(TH_BG) }
    if st == 2 { return theme(TH_BG) }
    return theme(TH_TEXT_HI)
}

fn wg_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    cell = 26 * u
    gx = ax + (aw - WG_COLS * cell) / 2
    ri = 0
    while ri < WG_ROWS {
        ci = 0
        while ci < WG_COLS {
            st = wg_state(ri, ci)
            cx = gx + ci * cell
            cy = ay + 6 * u + ri * cell
            rrect(cx + 2 * u, cy + 2 * u, cell - 4 * u, cell - 4 * u, 4 * u, wg_status_col(st))
            # THE LETTER YOU ARE TYPING WAS INVISIBLE. This drew a character
            # only when the status was non-zero, and a letter typed into the
            # live row has no status until enter is pressed - so five keys went
            # in and the grid stayed blank, which reads as a dead app. Status
            # cannot mark it either: a fourth status value would need a third
            # bit, and "typed but unscored" is not a scoring state. The live
            # row is bounded by wg_col instead, which is already exact -
            # backspace zeroes the cell it retreats over.
            show = 0
            if st != 0 { show = 1 }
            if ri == wg_row { if ci < wg_col { show = 1 } }
            if show == 1 {
                char_aa(cx + cell / 2 - cell_w() / 2, cy + cell / 2 - cell_h() / 2, 65 + wg_letter(ri, ci), wg_ink(st))
            }
            # the caret, so an empty grid still says where the next key lands
            if wg_done == 0 { if ri == wg_row { if ci == wg_col {
                        fill_rgb(cx + 2 * u, cy + cell - 5 * u, cell - 4 * u, 2 * u, theme(TH_ACCENT))
            }}}
            ci = ci + 1
        }
        ri = ri + 1
    }
    if wg_done == 1 { label(gx, ay + 8 * u + WG_ROWS * cell, "correct - r restarts", ac_play_color(3), T_CAPTION, W_BOLD) }
    if wg_done == 2 {
        # THE ANSWER, on a loss. Six wrong guesses and then never being told
        # the word is the one outcome of this game that teaches nothing. There
        # is no string to draw - wg_word returns letter indices - so it is
        # drawn a character at a time, which is what char_aa is for.
        label(gx, ay + 8 * u + WG_ROWS * cell, "the word was", theme(TH_DANGER), T_CAPTION, W_BOLD)
        lx = gx + label_w("the word was", T_CAPTION, W_BOLD) + 8 * u
        ci = 0
        while ci < WG_COLS {
            char_aa(lx + ci * cell_w(), ay + 8 * u + WG_ROWS * cell, 65 + wg_word(wg_widx, ci), theme(TH_TEXT_HI))
            ci = ci + 1
        }
    }
    if wg_done == 0 { label(gx, ay + 8 * u + WG_ROWS * cell, "type a 5-letter word, enter to guess", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    gs_bar(ax, ay, aw, ah, GS_WG)
    return 0
}

# A press updates state, but the compositor only repaints a window it was
# TOLD is damaged (ui.h: app_draw "called only when the window is damaged,
# not every frame") - app_event's return value is discarded at every one of
# wm.c's three call sites (see reg_open's own comment on the same fact for
# focus). Every branch that changes anything therefore ends in wm_dmg(win).
fn wg_event(win, ety, ecode) {
    if ety != 3 { return 0 }
    if ecode == 114 { wg_reset()  wm_dmg(win)  return 1 }
    if wg_done != 0 { return 1 }
    if ecode == 13 { wg_submit()  wm_dmg(win)  return 1 }
    if ecode == 8 {
        if wg_col > 0 { wg_col = wg_col - 1  poke8(WG_BOARD + wg_row * WG_COLS + wg_col, 0) }
        wm_dmg(win)
        return 1
    }
    lc = ecode
    if lc >= 65 { if lc <= 90 { lc = lc + 32 } }
    if lc < 97 { return 0 }
    if lc > 122 { return 0 }
    if wg_col < WG_COLS { poke8(WG_BOARD + wg_row * WG_COLS + wg_col, lc - 97)  wg_col = wg_col + 1 }
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Maze - 21x13 = 273 cells, exactly the count named in the brief. Generated
# by a randomised backtracker, carved ITERATIVELY: boot.S documents this
# kernel's 256 KiB compositor stack as having already overflowed once
# ("the zl compositor nests deep... each zl frame is large"), and a maze
# opens from inside a click handler that is already several frames into
# the compositor's own call chain. A 273-deep zl recursion there is
# exactly the risk that comment warns about, so the DFS stack is data
# (MAZE_STACK, 273 u16 cell indices) instead of the C call stack.
#
# MAZE_BOARD: one byte per cell. Bits 0-3 = passage open to N/E/S/W (a
# passage is carved in both cells it joins, so movement only ever checks
# the CURRENT cell's own bit). Bit 4 = visited, generation-only. Bit 5 = the
# player has stood here, which is the trail.
#
# THE STACK HOLDS A PACKED (y, x), NOT A FLAT INDEX. It used to push
# `ny * MAZE_W + nx` and pull the pair back out with `idx % MAZE_W` and
# `idx / MAZE_W`. MAZE_W is 21, so that is a real division - and `/` is a
# DIFFERENT OPERATION in this project's two runtimes: the kernel casts both
# operands to long long, the host interpreter divides doubles. The generator
# was therefore a different generator depending on the backend, and no host
# test of it would have been a statement about the shipping maze.
#
# y * 32 + x is exact in both. MAZE_H is 13 and MAZE_W is 21, both under 32,
# so the pair fits in ten bits and band/shr take it apart with no arithmetic
# either runtime can disagree about.
# ==============================================================================
MAZE_W = 21
MAZE_H = 13
mz_px = 0
mz_py = 0
mz_won = 0
mz_steps = 0

fn mz_pack(x, y) { return bor(shl(y, 5), x) }
fn mz_ux(v) { return band(v, 31) }
fn mz_uy(v) { return shr(v, 5) }

# A NUMBER, NOT A BOOL, and this one is not a style preference - it is a third
# place the two runtimes disagree, found by hosttest/games12_rules.zl.
#
#   kernel   freestanding/runtime_kernel.c:975 casts BOTH operands of == to
#            long long before comparing, so `bool == 0` compares 1/0 with 0
#            and behaves as anyone would expect.
#   host     interp.c:1830 values_equal_depth begins `if (l.type != r.type)
#            return 0`, so a V_BOOL is NEVER equal to a V_NUM.
#
# mz_reset's carve loop asks `if mz_visited(nx, ny) == 0`. With a bool return
# that condition is true in the kernel - where the maze has always generated
# correctly - and FALSE, always, under the interpreter, where the carve loop
# therefore opened no passage at all and every maze came out solid wall.
#
# So this was never a bug on screen. It was worse in one specific way: it made
# the generator UNTESTABLE off the kernel, and a check that silently exercises
# different code from the code that ships is docs/GUARDS-THAT-DID-NOT-GUARD.md
# in one line. Returning 0 or 1 makes it one rule in both runtimes.
fn mz_visited(x, y) {
    if band(peek8(MAZE_BOARD + y * MAZE_W + x), 16) != 0 { return 1 }
    return 0
}
fn mz_mark(x, y) {
    a = MAZE_BOARD + y * MAZE_W + x
    poke8(a, bor(peek8(a), 16))
    return 0
}
fn mz_trodden(x, y) {
    if band(peek8(MAZE_BOARD + y * MAZE_W + x), 32) != 0 { return 1 }
    return 0
}
fn mz_tread(x, y) {
    a = MAZE_BOARD + y * MAZE_W + x
    poke8(a, bor(peek8(a), 32))
    return 0
}
# d: 0 north(y-1) 1 east(x+1) 2 south(y+1) 3 west(x-1). Opens the passage
# in BOTH cells it joins (opposite bit = (d+2)%4), so mz_move only ever
# has to look at the cell the player is standing in.
fn mz_open(cx, cy, d) {
    a1 = MAZE_BOARD + cy * MAZE_W + cx
    poke8(a1, bor(peek8(a1), shl(1, d)))
    nx = cx
    ny = cy
    if d == 0 { ny = cy - 1 }
    if d == 1 { nx = cx + 1 }
    if d == 2 { ny = cy + 1 }
    if d == 3 { nx = cx - 1 }
    a2 = MAZE_BOARD + ny * MAZE_W + nx
    # (d + 2) mod 4, as a mask. Four directions is a power of two, so this is
    # a bit operation rather than a remainder - and this file now has no `%`
    # and no `/` in any rule at all, which is what makes a host assertion
    # about it a statement about the kernel too.
    poke8(a2, bor(peek8(a2), shl(1, band(d + 2, 3))))
    return 0
}

fn mz_reset() {
    fill_mem(MAZE_BOARD, 0, MAZE_W * MAZE_H)
    ac_seed_from(ticks() + 29)          # see the note in wg_reset
    poke16(MAZE_STACK, mz_pack(0, 0))
    sp = 1
    mz_mark(0, 0)
    while sp > 0 {
        idx = peek16(MAZE_STACK + (sp - 1) * 2)
        cx = mz_ux(idx)
        cy = mz_uy(idx)
        rot = ac_rand(4)
        found = 0 - 1
        k = 0
        while k < 4 {
            if found < 0 {
                d = band(rot + k, 3)
                nx = cx
                ny = cy
                if d == 0 { ny = cy - 1 }
                if d == 1 { nx = cx + 1 }
                if d == 2 { ny = cy + 1 }
                if d == 3 { nx = cx - 1 }
                if nx >= 0 { if nx < MAZE_W { if ny >= 0 { if ny < MAZE_H {
                                if mz_visited(nx, ny) == 0 { found = d }
                }}}}
            }
            k = k + 1
        }
        if found >= 0 {
            mz_open(cx, cy, found)
            nx = cx
            ny = cy
            if found == 0 { ny = cy - 1 }
            if found == 1 { nx = cx + 1 }
            if found == 2 { ny = cy + 1 }
            if found == 3 { nx = cx - 1 }
            mz_mark(nx, ny)
            poke16(MAZE_STACK + sp * 2, mz_pack(nx, ny))
            sp = sp + 1
        } else {
            sp = sp - 1
        }
    }
    mz_px = 0
    mz_py = 0
    mz_won = 0
    mz_steps = 0
    mz_tread(0, 0)
    return 0
}

# The two properties that make a randomised backtracker's output a PERFECT
# maze - every cell reachable, and exactly one route between any two. Neither
# is checkable by playing it: a maze with an unreachable pocket looks identical
# to one without until you happen to want that pocket, and an extra loop looks
# like nothing at all. They are counted instead, and asserted on the host.
#
# A spanning tree over N cells has exactly N - 1 edges. mz_edges counts each
# carved passage once by only looking east and south, so a passage shared by
# two cells is not double counted.
fn mz_reached() {
    n = 0
    y = 0
    while y < MAZE_H {
        x = 0
        while x < MAZE_W { if mz_visited(x, y) { n = n + 1 }  x = x + 1 }
        y = y + 1
    }
    return n
}
fn mz_edges() {
    n = 0
    y = 0
    while y < MAZE_H {
        x = 0
        while x < MAZE_W {
            v = peek8(MAZE_BOARD + y * MAZE_W + x)
            if band(v, 2) != 0 { n = n + 1 }        # east
            if band(v, 4) != 0 { n = n + 1 }        # south
            x = x + 1
        }
        y = y + 1
    }
    return n
}

MZ_CELL = 15
fn mz_draw(ax, ay, aw, ah) {
    u = ui()
    gs_canvas(ax, ay, aw, ah)
    cell = MZ_CELL * u
    gx = ax + (aw - MAZE_W * cell) / 2
    gy = ay + 4 * u
    wallcol = theme(TH_TEXT_DIM)
    fill_rgb(gx, gy, MAZE_W * cell, MAZE_H * cell, theme(TH_SURF_1))
    ri = 0
    while ri < MAZE_H {
        ci = 0
        while ci < MAZE_W {
            v = peek8(MAZE_BOARD + ri * MAZE_W + ci)
            cxp = gx + ci * cell
            cyp = gy + ri * cell
            # the trail. Backtracking over your own path is most of the time
            # spent in a maze, and a maze that does not show where you have
            # been makes you keep the whole route in your head.
            if band(v, 32) != 0 { fill_rgb(cxp + 1, cyp + 1, cell - 1, cell - 1, theme(TH_SURF_WELL)) }
            if band(v, 1) == 0 { fill_rgb(cxp, cyp, cell + 1, 1, wallcol) }
            if band(v, 2) == 0 { fill_rgb(cxp + cell, cyp, 1, cell + 1, wallcol) }
            if band(v, 4) == 0 { fill_rgb(cxp, cyp + cell, cell + 1, 1, wallcol) }
            if band(v, 8) == 0 { fill_rgb(cxp, cyp, 1, cell + 1, wallcol) }
            ci = ci + 1
        }
        ri = ri + 1
    }
    fill_rgb(gx + (MAZE_W - 1) * cell + 3 * u, gy + (MAZE_H - 1) * cell + 3 * u, cell - 6 * u, cell - 6 * u, ac_play_color(3))
    fill_rgb(gx + mz_px * cell + 3 * u, gy + mz_py * cell + 3 * u, cell - 6 * u, cell - 6 * u, ac_play_color(4))
    msg_y = gy + MAZE_H * cell + 8 * u
    if mz_won == 1 {
        label(gx, msg_y, "found the exit in", ac_play_color(3), T_CAPTION, W_BOLD)
        label_num(gx + 116 * u, msg_y, mz_steps, theme(TH_TEXT_HI), T_CAPTION, W_BOLD)
        label(gx + 146 * u, msg_y, "steps - r generates a new maze", ac_play_color(3), T_CAPTION, W_BOLD)
    }
    if mz_won == 0 {
        label(gx, msg_y, "arrows or wasd to the teal exit", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label_num(gx + 210 * u, msg_y, mz_steps, theme(TH_TEXT_HI), T_CAPTION, W_REG)
        label(gx + 234 * u, msg_y, "steps", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    gs_bar(ax, ay, aw, ah, GS_MZ)
    return 0
}

fn mz_move(d) {
    if mz_won == 1 { return 0 }
    v = peek8(MAZE_BOARD + mz_py * MAZE_W + mz_px)
    if band(v, shl(1, d)) == 0 { return 0 }
    if d == 0 { mz_py = mz_py - 1 }
    if d == 1 { mz_px = mz_px + 1 }
    if d == 2 { mz_py = mz_py + 1 }
    if d == 3 { mz_px = mz_px - 1 }
    mz_steps = mz_steps + 1
    mz_tread(mz_px, mz_py)
    if mz_px == MAZE_W - 1 { if mz_py == MAZE_H - 1 { mz_won = 1 } }
    return 1
}

fn mz_event(win, ety, ecode) {
    # WASD as well as the arrows. Both are ordinary key-down codes and the
    # letters arrive as their lower-case ASCII, so this is one table with two
    # sets of names for the same four directions - the same thing every other
    # game in this suite that takes a direction does.
    if ety == 3 { if ecode == 114 { mz_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 1 { return 0 }
    if mz_won == 1 { return 1 }
    d = 0 - 1
    if ecode == K_UP    { d = 0 }
    if ecode == K_RIGHT { d = 1 }
    if ecode == K_DOWN  { d = 2 }
    if ecode == K_LEFT  { d = 3 }
    if ecode == 119 { d = 0 }           # w
    if ecode == 100 { d = 1 }           # d
    if ecode == 115 { d = 2 }           # s
    if ecode == 97  { d = 3 }           # a
    if ecode == 87  { d = 0 }           # W
    if ecode == 68  { d = 1 }           # D
    if ecode == 83  { d = 2 }           # S
    if ecode == 65  { d = 3 }           # A
    if d < 0 { return 0 }
    # only the moves that actually open a passage repaint - a press into a
    # wall changes nothing, and see the note on wg_event for why a change
    # that never calls wm_dmg is a change nobody ever sees.
    if mz_move(d) == 1 { wm_dmg(win) }
    return 1
}
