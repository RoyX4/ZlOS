# apps_registry.zl - the ONE shared app registry (see docs/app-suite.md).
#
# Every app added on top of the original 13 (APP_SHELL..APP_EDIT, plus
# APP_SETTINGS/APP_RUN/APP_BROWSER) is listed here ONCE: its name, which
# category it belongs to, its default window size, and which icon (if any) it
# reuses from the 20-icon atlas. The catalog window below reads this table to
# draw itself; task_label() in kernel.zl reads reg_name() so a new app's
# window gets a real taskbar chip instead of the generic "window" fallback.
#
# WHY ONE TABLE INSTEAD OF 30-ODD open_xxx() FUNCTIONS. open_app() (the
# original 13) repeats six lines - "already open? raise and focus; else
# open, restore focus, log it" - once per app. That was fine at 13 apps and
# would have been ~180 duplicated lines at 40. reg_open() below is that
# pattern written once; reg_new() is the only place that still varies per
# app (because a window's title and size are inherently per-app), and it is
# reached through reg_find_win(), not through a stored "myapp_win" global -
# wm already knows which windows are open (wm_n/wm_zat/wm_app), so asking it
# is simpler than keeping a second copy of that answer in sync.
#
# zl has no function values, so "dispatch" below is the same shape as
# app_draw/app_event/app_tick themselves: one big if-chain. What stays SMALL
# is the actual per-app STATE and LOGIC, which lives in apps_utils.zl,
# apps_games1.zl, apps_games2.zl and apps_system.zl - grouped by category, a
# handful of apps per file, none of them touching this dispatch table's
# shape.

APP_SETTINGS = 6                    # settings.c; wmglue.c dispatches its
# draw/event before zl ever sees them -
# this only has to know how to OPEN one
# "All Applications" - see cat_* below.
#
# 70 AND NOT 13, and that one digit is why the catalog never opened. 13 is
# APP_FILES (kernel.zl:3499), added to the original suite AFTER this constant
# was chosen at what was then one past APP_EDIT. Two apps sharing an id is not
# a naming problem, it is a routing problem, and it broke in the worst
# direction: reg_open() finds a window by ASKING wm which app each open window
# is showing (reg_find_win), and the desktop opens a Files window at boot. So
# `apps`, the dock's grid button and the start menu's "All Applications" all
# reached reg_open(13), which matched the Files window already on screen,
# raised and focused it, and returned 1 - success, no new window, no
# diagnostic. 47 of 53 apps live behind that click and none of them could be
# opened by a person or photographed by the oracle.
#
# It misrouted in the other direction too: app_event() tested `id >=
# APP_CATALOG` BEFORE its `id == APP_FILES` arm, so every key and click aimed
# at the Files window was handed to cat_event() instead of files_event().
#
# The seam those three dispatchers want is "is this id in the registry", which
# is REG_FIRST, not "is this id the catalog". They say REG_FIRST now, and this
# constant sits one past REG_LAST where reg_exists() already refuses it - the
# catalog must not list itself as a tile.
APP_CATALOG  = 70

# ---- utilities (apps_utils.zl) ----------------------------------------------
APP_CLIP  = 15
APP_COLOR = 16
APP_REGEX = 17
APP_BASE  = 18
APP_DIFF  = 19
APP_HASH  = 20
APP_UNIT  = 21
APP_NOTES = 22
APP_KEYS  = 23
APP_BENCH = 24

# ---- games (apps_games1.zl / apps_games2.zl) --------------------------------
APP_WORDLE   = 25
APP_TICTACTOE = 26
APP_NIM       = 27
APP_HANOI     = 28
APP_LIGHTS    = 29
APP_CONNECT4  = 30

# ---- system (apps_system.zl) -------------------------------------------------
APP_CLOCK   = 31
APP_SYSINFO = 32
APP_CALC    = 33

# ---- more games (apps_games2.zl) ---------------------------------------------
APP_MAZE = 34

REG_FIRST = 15                      # APP_CLIP: first real registry app id
REG_LAST  = 69                      # highest id any slice owns

# WHICH IDS ARE REAL. The catalog used to walk REG_FIRST..REG_FIRST+REG_COUNT
# and assume every id in that span was an app. That held while the ids were
# contiguous, and stopped holding the moment the id space was carved into
# reserved per-slice ranges: APP_MAZE owns 34, 35..39 were never allocated,
# and each slice was given one spare id at the end of its range that it
# deliberately did not use.
# Walking the span blind would put four empty tiles in "All Applications",
# each of which opens a window titled "App" that draws nothing.
#
# The gaps are listed rather than derived because there is nothing to derive
# them from: a slice's <slice>_has() answers for its whole RANGE, and its
# _name() returns "" for an id inside that range it did not implement - which
# zl cannot test for, having no string comparison.
fn reg_exists(id) {
    if id < REG_FIRST { return 0 }
    if id > REG_LAST { return 0 }             # incl. APP_CATALOG, which is
    # REG_LAST + 1 and must never
    # appear as a tile in itself
    if id >= 35 { if id <= 39 { return 0 } }   # never allocated; 34 is Maze
    if id == 51 { return 0 }                   # apps_sys3.zl   spare
    if id == 60 { return 0 }                   # apps_games3.zl spare
    if id == 69 { return 0 }                   # apps_games4.zl spare
    return 1
}

# The catalog indexes a DENSE list, so a gap never becomes a blank tile.
fn reg_count() {
    rc = 0
    rid = REG_FIRST
    while rid <= REG_LAST {
        if reg_exists(rid) == 1 { rc = rc + 1 }
        rid = rid + 1
    }
    return rc
}

fn reg_id_at(idx) {
    ri = 0
    rid = REG_FIRST
    while rid <= REG_LAST {
        if reg_exists(rid) == 1 {
            if ri == idx { return rid }
            ri = ri + 1
        }
        rid = rid + 1
    }
    return 0 - 1
}

# kernel.elf is measured against raw_boot.asm's CHUNKS ceiling (1,966,080
# bytes - the 32 KiB-chunk BIOS raw-boot loader silently truncates anything
# past it, per that file's own comment) after every app added here. That
# ceiling does NOT gate build.sh/build64.sh/buildefi.sh - none of them touch
# raw_boot.asm - so it cannot fail any of this brief's three required builds,
# but it is real and it is why this suite stops well short of the ~40 apps
# the mockup lists. Raising CHUNKS is a separate, boot-path change and
# deliberately not made here; see the report for the measured numbers.

# ---- the table --------------------------------------------------------------
# id -> display name (used by window titles, the catalog and the taskbar)
fn reg_name(id) {
    # The catalog is not a TILE (reg_exists refuses it) but it IS a window, so
    # task_label() asks for its name like any other. Without this its taskbar
    # chip read "App".
    if id == APP_CATALOG { return "All Applications" }
    if id == APP_CLIP  { return "Clipboard" }
    if id == APP_COLOR { return "Colour Picker" }
    if id == APP_REGEX { return "Regex Tester" }      # the reference's own name
    if id == APP_BASE  { return "Base Converter" }
    if id == APP_DIFF  { return "Text Diff" }         # the reference's own name
    if id == APP_HASH  { return "Checksum" }
    if id == APP_UNIT  { return "Unit Converter" }
    if id == APP_NOTES { return "Sticky Notes" }
    if id == APP_KEYS  { return "Keyboard Tester" }
    if id == APP_BENCH { return "Benchmark" }
    if id == APP_WORDLE    { return "Word Guess" }
    if id == APP_TICTACTOE { return "Tic-Tac-Toe" }
    if id == APP_NIM       { return "Nim" }
    if id == APP_HANOI     { return "Tower of Hanoi" }
    if id == APP_LIGHTS    { return "Lights Out" }
    if id == APP_CONNECT4  { return "Connect Four" }
    if id == APP_CLOCK   { return "Clocks & Timers" }
    if id == APP_SYSINFO { return "System Info" }
    if id == APP_CALC    { return "Calculator" }
    if id == APP_MAZE    { return "Maze" }
    # ---- the per-slice tables. Each file owns a disjoint id range and answers
    # ---- only for its own; see apps_sys2.zl for why they are separate files.
    if sys2_has(id) == 1 { return sys2_name(id) }
    if sys3_has(id) == 1 { return sys3_name(id) }
    if games3_has(id) == 1 { return games3_name(id) }
    if games4_has(id) == 1 { return games4_name(id) }
    return "App"
}

# id -> category: 0 system, 1 utility, 2 game. Governs the catalog's swatch
# colour (ac_cat_color) - there is no per-app colour anywhere else.
fn reg_cat(id) {
    if id >= APP_CLIP { if id <= APP_BENCH { return 1 } }
    if id >= APP_WORDLE { if id <= APP_CONNECT4 { return 2 } }
    if id == APP_MAZE { return 2 }
    # ---- the per-slice tables. Each file owns a disjoint id range and answers
    # ---- only for its own; see apps_sys2.zl for why they are separate files.
    if sys2_has(id) == 1 { return sys2_cat(id) }
    if sys3_has(id) == 1 { return sys3_cat(id) }
    if games3_has(id) == 1 { return games3_cat(id) }
    if games4_has(id) == 1 { return games4_cat(id) }
    return 0
}

# id -> default window size, in DESIGN UNITS (still needs * ui()).
fn reg_w(id) {
    # ---- THE FOURTEEN REGISTER APPS TAKE THE PROTOTYPE'S OWN RECTS ----------
    # The comment below says every size is "the reference's own, from
    # ds-reference.html's APPS" - and ds-reference.html is the PREDECESSOR
    # document. design.h settles which one wins: "THE SOURCE IS
    # docs/design/presswork-prototype.html ... If this header and the prototype
    # disagree, THE PROTOTYPE WINS." It justifies itself with "the oracle
    # compares by REGION", and that oracle is generated from ds.html, records
    # ds.html's sha, targets a 1280-wide screen, lives outside the repo in
    # ~/Downloads and is wired into no gate - so it has never compared anything.
    #
    # These fourteen are the prototype's APPS table, p[2] and p[3]. The games
    # and utilities below keep their existing sizes: the prototype has no
    # counterpart for them, so there is nothing to take.
    # KLOG, HEXV, DISK and NET ARE NOT ANSWERED HERE. reg_w/reg_h are consulted
    # only by reg_new's four generic wm_open lines, and those id bands stop short
    # of the sys2 and sys3 ranges - those four apps open through sys2_new and
    # sys3_new instead. Arms for them were added here and were unreachable from
    # the day they were written, while the tables that DO answer kept the older
    # sizes: one id, two disagreeing numbers, and the wrong one was the readable
    # one. Their prototype rects now live in sys2_w/sys2_h and sys3_w/sys3_h.
    if id == APP_CALC       { return 360 }
    if id == APP_CLOCK      { return 540 }
    # 620, not 600. Register 13 routes to APP_SYSINFO, and proto:1558 gives
    # `regs` p[260, 60, 620, 470] - this was the SYSTEM app's 600, taken before
    # the register table was re-pointed at this app and never re-read against
    # the row it now serves.
    if id == APP_SYSINFO    { return 620 }
    # EVERY SIZE IS THE REFERENCE'S OWN, from ds-reference.html's APPS,
    # UTILS and GAME_APPS arrays. They were not before: twenty of these
    # apps carried a size picked when the app was written, and the errors
    # were not small - Clocks & Timers opened 220x160 against the
    # reference's 520x352, a quarter of the area. The oracle compares by
    # REGION, so a window at the wrong size scores wrong however well its
    # contents are drawn. All ten utilities are 470x352; the rest differ.
    if id == APP_CLIP       { return 470 }
    if id == APP_COLOR      { return 470 }
    if id == APP_REGEX      { return 470 }
    if id == APP_BASE       { return 470 }
    if id == APP_DIFF       { return 470 }
    if id == APP_HASH       { return 470 }
    if id == APP_UNIT       { return 470 }
    if id == APP_NOTES      { return 470 }
    if id == APP_KEYS       { return 470 }
    if id == APP_BENCH      { return 470 }
    if id == APP_WORDLE     { return 400 }
    if id == APP_TICTACTOE  { return 350 }
    if id == APP_NIM        { return 400 }
    if id == APP_HANOI      { return 430 }
    if id == APP_LIGHTS     { return 360 }
    if id == APP_CONNECT4   { return 430 }
    if id == APP_MAZE       { return 500 }
    # ---- the per-slice tables. Each file owns a disjoint id range and answers
    # ---- only for its own; see apps_sys2.zl for why they are separate files.
    if sys2_has(id) == 1 { return sys2_w(id) }
    if sys3_has(id) == 1 { return sys3_w(id) }
    if games3_has(id) == 1 { return games3_w(id) }
    if games4_has(id) == 1 { return games4_w(id) }
    return 300
}
fn reg_h(id) {
    # ---- THE FOURTEEN REGISTER APPS TAKE THE PROTOTYPE'S OWN RECTS ----------
    # The comment below says every size is "the reference's own, from
    # ds-reference.html's APPS" - and ds-reference.html is the PREDECESSOR
    # document. design.h settles which one wins: "THE SOURCE IS
    # docs/design/presswork-prototype.html ... If this header and the prototype
    # disagree, THE PROTOTYPE WINS." It justifies itself with "the oracle
    # compares by REGION", and that oracle is generated from ds.html, records
    # ds.html's sha, targets a 1280-wide screen, lives outside the repo in
    # ~/Downloads and is wired into no gate - so it has never compared anything.
    #
    # These fourteen are the prototype's APPS table, p[2] and p[3]. The games
    # and utilities below keep their existing sizes: the prototype has no
    # counterpart for them, so there is nothing to take.
    if id == APP_CALC       { return 430 }
    if id == APP_CLOCK      { return 400 }
    if id == APP_SYSINFO    { return 470 }
    # EVERY SIZE IS THE REFERENCE'S OWN, from ds-reference.html's APPS,
    # UTILS and GAME_APPS arrays. They were not before: twenty of these
    # apps carried a size picked when the app was written, and the errors
    # were not small - Clocks & Timers opened 220x160 against the
    # reference's 520x352, a quarter of the area. The oracle compares by
    # REGION, so a window at the wrong size scores wrong however well its
    # contents are drawn. All ten utilities are 470x352; the rest differ.
    if id == APP_CLIP       { return 352 }
    if id == APP_COLOR      { return 352 }
    if id == APP_REGEX      { return 352 }
    if id == APP_BASE       { return 352 }
    if id == APP_DIFF       { return 352 }
    if id == APP_HASH       { return 352 }
    if id == APP_UNIT       { return 352 }
    if id == APP_NOTES      { return 352 }
    if id == APP_KEYS       { return 352 }
    if id == APP_BENCH      { return 352 }
    if id == APP_WORDLE     { return 380 }
    if id == APP_TICTACTOE  { return 380 }
    if id == APP_NIM        { return 330 }
    if id == APP_HANOI      { return 320 }
    if id == APP_LIGHTS     { return 390 }
    if id == APP_CONNECT4   { return 400 }
    if id == APP_MAZE       { return 390 }
    # ---- the per-slice tables. Each file owns a disjoint id range and answers
    # ---- only for its own; see apps_sys2.zl for why they are separate files.
    if sys2_has(id) == 1 { return sys2_h(id) }
    if sys3_has(id) == 1 { return sys3_h(id) }
    if games3_has(id) == 1 { return games3_h(id) }
    if games4_has(id) == 1 { return games4_h(id) }
    return 160
}

# id -> icon24 index (icons.c), or -1 for "no icon, draw the two-letter
# monogram instead" (reg_mono below).
#
# THIS TABLE USED TO BE ONE LINE LONG. Everything else fell through to the
# slices, three of which answered -1 unconditionally, so 46 of the 47 registry
# apps showed lettering in the app grid and the dock where ds-reference.html
# shows a glyph. The reference assigns each of its 53 apps an icon id in its
# APPS/UTILS/GAME_APPS arrays and DRAWS every one of them (its ICONS table,
# ds-reference.html:1121); gen_icons.py now renders those paths into the atlas
# at indices 44..88, so the answer for each app is the reference's own answer
# rather than a stand-in.
#
# The numbers are icons.c atlas indices. That file's header block is the
# authority on which index is which - it is generated, so it cannot drift from
# the atlas - and REF_ORDER in gen_icons.py is append-only for exactly this
# reason: reordering it would silently repoint every line below.
fn reg_icon(id) {
    # ---- utilities (UTILS) --------------------------------------------------
    if id == APP_CLIP  { return 56 }    # uClip
    if id == APP_COLOR { return 57 }    # uColor
    if id == APP_REGEX { return 58 }    # uRegex
    if id == APP_BASE  { return 59 }    # uBase
    if id == APP_DIFF  { return 60 }    # uDiff
    if id == APP_HASH  { return 61 }    # uHash
    if id == APP_UNIT  { return 62 }    # uUnit
    if id == APP_NOTES { return 63 }    # uNote
    if id == APP_KEYS  { return 64 }    # uKeys
    if id == APP_BENCH { return 65 }    # uBench

    # ---- games that live in this file's id range (GAME_APPS) ----------------
    if id == APP_WORDLE    { return 88 }   # gWord
    if id == APP_TICTACTOE { return 74 }   # gCross
    if id == APP_NIM       { return 85 }   # gSticks
    if id == APP_HANOI     { return 84 }   # gTower
    if id == APP_LIGHTS    { return 78 }   # gBulb
    if id == APP_CONNECT4  { return 76 }   # gDrop
    if id == APP_MAZE      { return 80 }   # gMaze

    # ---- system (APPS) ------------------------------------------------------
    if id == APP_CLOCK   { return 16 }  # clock - the atlas glyph already IS the
    # reference's, so it is not redrawn
    if id == APP_SYSINFO { return 55 }  # chip
    if id == APP_CALC    { return 49 }  # calcApp

    # ---- apps_sys2.zl's range (40..45) --------------------------------------
    # Answered here rather than in sys2_icon() because sys2_icon() is the
    # -1 stub this whole table exists to replace; see the note below.
    if id == APP_KLOG { return 44 }     # log
    if id == APP_REND { return 45 }     # render
    if id == APP_HEXV { return 46 }     # hex
    if id == APP_FBUF { return 47 }     # snap
    if id == APP_TTY  { return 48 }     # tty
    if id == APP_FONT { return 50 }     # font

    # ---- apps_sys3.zl's range (46..50) --------------------------------------
    # sys3_icon() answers for all five, but with STAND-INS chosen before the
    # reference's glyphs existed: Archive Manager got the folder, Image Viewer
    # got the paint palette, Services got the bar chart. The reference draws a
    # binary block, a photo and a service-row for those three, so they are
    # repointed here. disk and wifi keep the same picture either way.
    if id == APP_DISK { return 51 }     # disk
    if id == APP_SVC  { return 52 }     # svc
    if id == APP_ARCH { return 53 }     # binary
    if id == APP_IMG  { return 54 }     # imgv
    if id == APP_NET  { return 17 }     # network - the atlas's wifi fan

    # ---- apps_games3.zl's range (52..59) ------------------------------------
    if id == G3_TETRIS { return 66 }    # gTetris
    if id == G3_PONG   { return 67 }    # gPong
    if id == G3_BREAK  { return 68 }    # gBrick
    if id == G3_MINES  { return 69 }    # gMine
    if id == G3_2048   { return 70 }    # gNum
    if id == G3_LIFE   { return 71 }    # gLife
    if id == G3_ROIDS  { return 72 }    # gRock
    if id == G3_INVAD  { return 73 }    # gAlien

    # ---- apps_games4.zl's range (61..68) ------------------------------------
    if id == G4_FIFTEEN { return 75 }   # gTiles
    if id == G4_REVERSI { return 77 }   # gDisc
    if id == G4_SIMON   { return 79 }   # gWave
    if id == G4_SOKOBAN { return 81 }   # gCrate
    if id == G4_FLAPPY  { return 82 }   # gBird
    if id == G4_MISSILE { return 83 }   # gTarget
    if id == G4_BLACKJK { return 86 }   # gCard
    if id == G4_FROGGER { return 87 }   # gFrog

    # ---- the per-slice tables. Each file owns a disjoint id range and answers
    # ---- only for its own; see apps_sys2.zl for why they are separate files.
    #
    # Every registry app is now answered above, so these four are reached only
    # by an id a slice claims but this table has not been told about - a newly
    # added app, before someone gives it its icon. They stay as that fallback,
    # and as the seam a slice would use if it ever wanted a per-instance icon.
    if sys2_has(id) == 1 { return sys2_icon(id) }
    if sys3_has(id) == 1 { return sys3_icon(id) }
    if games3_has(id) == 1 { return games3_icon(id) }
    if games4_has(id) == 1 { return games4_icon(id) }
    return 0 - 1
}

# id -> two-letter monogram, drawn when reg_icon() is -1.
fn reg_mono(id) {
    if id == APP_CLIP  { return "CB" }
    if id == APP_COLOR { return "CP" }
    if id == APP_REGEX { return "PT" }
    if id == APP_BASE  { return "BC" }
    if id == APP_DIFF  { return "LD" }
    if id == APP_HASH  { return "CK" }
    if id == APP_UNIT  { return "UC" }
    if id == APP_NOTES { return "NT" }
    if id == APP_KEYS  { return "KT" }
    if id == APP_BENCH { return "BM" }
    if id == APP_WORDLE    { return "WG" }
    if id == APP_TICTACTOE { return "TT" }
    if id == APP_NIM       { return "NM" }
    if id == APP_HANOI     { return "TH" }
    if id == APP_LIGHTS    { return "LO" }
    if id == APP_CONNECT4  { return "C4" }
    if id == APP_SYSINFO { return "SI" }
    if id == APP_CALC    { return "CA" }
    if id == APP_MAZE    { return "MZ" }

    # ---- the per-slice marks, same rule as reg_name.
    if sys2_has(id) == 1 { return sys2_mono(id) }
    if sys3_has(id) == 1 { return sys3_mono(id) }
    if games3_has(id) == 1 { return games3_mono(id) }
    if games4_has(id) == 1 { return games4_mono(id) }
    return "??"
}

# ---- the generic opener ------------------------------------------------------
# Every window currently open, searched by APP ID rather than by a stored
# handle - wm.c's z-order already drops a window the moment it closes
# (wm_close -> z_remove), so this can never find a stale one.
fn reg_find_win(id) {
    ri = 0
    while ri < wm_n() {
        rw = wm_zat(ri)
        if wm_app(rw) == id { return rw }
        ri = ri + 1
    }
    return 0 - 1
}

# The only per-app branch left: construct the window (and reset its state,
# for anything that needs a fresh start each time it is opened - the same
# rule open_app() already follows for Snake). Returns the new window, or -1.
fn reg_new(id, u) {
    # THE PROTOTYPE'S COORDINATES ARE FIELD-RELATIVE, NOT SCREEN-RELATIVE.
    #
    # `p[14, 12, 720, 720]` was transcribed as raw screen pixels, so Settings
    # opened at absolute (14, 12) - underneath the register rail and underneath
    # the raster strip, both of which the field begins after. The rail is stated
    # to be the only route to every system function, and a 720-square plate
    # parked on top of it covers that route from the first frame.
    #
    # clamp_to_field cannot recover it either: that clamp runs on GRAB_MOVE and
    # lower-bounds at the window's CURRENT position precisely so a programmatic
    # placement is never yanked, which means a window opened out of bounds stays
    # out of bounds until the user drags it. Placement is the only chance.
    #
    # desk_x/desk_y are what the boot composition already uses for the same
    # numbers out of the same file.
    # settings_win IS RECORDED HERE TOO. There are two ways to open Settings and
    # only one of them was recording the window: reopen_settings assigns
    # settings_win, and this path - taken by the shell command, the command
    # palette row and the catalogue tile - returned the index without touching
    # it. So the pane's own "THIS PANE, LAST DRAW" figure read wm_appus(-1) and
    # printed 0, and reopen_settings would open a SECOND Settings window over
    # the first.
    #
    # zl globals are one namespace across the whole program, so this file can
    # assign kernel.zl's global directly - which is the smallest correct fix.
    if id == APP_SETTINGS {
        settings_win = wm_open(id, "Settings", desk_x(14), desk_y(12), 720 * u, 720 * u)
        return settings_win
    }
    if id == APP_CATALOG  { return wm_open(id, "All Applications", desk_x(120), desk_y(40), CAT_W * u, CAT_H * u) }
    if id == APP_REGEX     { pt_reset() }
    if id == APP_WORDLE    { wg_reset() }
    if id == APP_TICTACTOE { tt_reset() }
    if id == APP_NIM       { nim_reset() }
    if id == APP_HANOI     { ho_reset() }
    if id == APP_LIGHTS    { lo_reset() }
    if id == APP_CONNECT4  { c4_reset() }
    if id == APP_CALC      { ca_clear() }
    if id == APP_MAZE      { mz_reset() }
    if id >= APP_CLIP { if id <= APP_BENCH {
            return wm_open(id, reg_name(id), 160 * u, 80 * u, reg_w(id) * u, reg_h(id) * u)
    }}
    if id >= APP_WORDLE { if id <= APP_CONNECT4 {
            return wm_open(id, reg_name(id), 160 * u, 80 * u, reg_w(id) * u, reg_h(id) * u)
    }}
    if id >= APP_CLOCK { if id <= APP_CALC {
            return wm_open(id, reg_name(id), 160 * u, 80 * u, reg_w(id) * u, reg_h(id) * u)
    }}
    if id == APP_MAZE {
        return wm_open(id, reg_name(id), 160 * u, 80 * u, reg_w(id) * u, reg_h(id) * u)
    }

    # ---- the per-slice opens. Each file owns its own, so an app can pick its
    # ---- start position and reset its state before the first frame.
    if sys2_has(id) == 1 { return sys2_new(id, u) }
    if sys3_has(id) == 1 { return sys3_new(id, u) }
    if games3_has(id) == 1 { return games3_new(id, u) }
    if games4_has(id) == 1 { return games4_new(id, u) }
    return 0 - 1
}

# raise-and-focus if already open; otherwise open it, and it gets focus too
# (see the comment below - this is where it differs from open_app()).
fn reg_open(id) {
    ru = ui()
    rw = reg_find_win(id)
    if rw >= 0 {
        wm_setfocus(rw)
        wm_raise(rw)
        return 1
    }
    # UNLIKE open_app() (the original 13), this does NOT restore whichever
    # window had focus before. open_app() exists because the SHELL calls it
    # mid command-line - you typed "snake" and want to keep typing, so
    # focus must stay put. Every caller here is a deliberate CLICK (a
    # catalog tile, a menu row): wm_open() already focuses the window it
    # just opened, and restoring focus to the catalog behind it silently
    # sent every subsequent keystroke to the wrong window. Caught by
    # probe-catalog.py's Maze case: the click-to-place games worked (a
    # mouse event routes by SCREEN POSITION, not focus) while arrow keys
    # went nowhere (a key event has no position - it needs focus).
    rw = reg_new(id, ru)
    # A REFUSAL HAS TO SAY SO, and say which id. wm_open already prints when
    # WM_MAX is reached; this is the other half - reg_new returns -1 when no
    # arm claims the id at all, which is what a wrong id looks like from here.
    # It returned a bare 0 before, and a bare 0 is how "the catalog opens
    # nothing" stayed a mystery for six QEMU boots.
    if rw < 0 {
        put("  reg: no window for app id ")  print(id)
        return 0
    }
    wm_report(rw)
    return 1
}

# app_draw / app_event / app_tick fallbacks. kernel.zl calls these for any id
# the registry owns (id >= REG_FIRST); nothing above APP_FILES touches these
# except through this one seam.
fn reg_draw(id, ax, ay, aw, ah, afocus) {
    if id == APP_CATALOG { return cat_draw(ax, ay, aw, ah) }
    if id == APP_CLIP  { return cb_draw(ax, ay, aw, ah) }
    if id == APP_COLOR { return cp_draw(ax, ay, aw, ah) }
    if id == APP_REGEX { return pt_draw(ax, ay, aw, ah) }
    if id == APP_BASE  { return bc_draw(ax, ay, aw, ah) }
    if id == APP_DIFF  { return ld_draw(ax, ay, aw, ah) }
    if id == APP_HASH  { return ck_draw(ax, ay, aw, ah) }
    if id == APP_UNIT  { return uc_draw(ax, ay, aw, ah) }
    if id == APP_NOTES { return nt_draw(ax, ay, aw, ah) }
    if id == APP_KEYS  { return kt_draw(ax, ay, aw, ah) }
    if id == APP_BENCH { return bm_draw(ax, ay, aw, ah) }
    if id == APP_WORDLE    { return wg_draw(ax, ay, aw, ah) }
    if id == APP_TICTACTOE { return tt_draw(ax, ay, aw, ah) }
    if id == APP_NIM       { return nim_draw(ax, ay, aw, ah) }
    if id == APP_HANOI     { return ho_draw(ax, ay, aw, ah) }
    if id == APP_LIGHTS    { return lo_draw(ax, ay, aw, ah) }
    if id == APP_CONNECT4  { return c4_draw(ax, ay, aw, ah) }
    if id == APP_CLOCK   { return clk_draw(ax, ay, aw, ah) }
    if id == APP_SYSINFO { return si_draw(ax, ay, aw, ah) }
    if id == APP_CALC    { return ca_draw(ax, ay, aw, ah) }
    if id == APP_MAZE    { return mz_draw(ax, ay, aw, ah) }
    # ---- the per-slice tables, same rule as reg_name above.
    if sys2_has(id) == 1 { return sys2_draw(id, ax, ay, aw, ah) }
    if sys3_has(id) == 1 { return sys3_draw(id, ax, ay, aw, ah) }
    if games3_has(id) == 1 { return games3_draw(id, ax, ay, aw, ah) }
    if games4_has(id) == 1 { return games4_draw(id, ax, ay, aw, ah) }
    return 0
}
fn reg_event(id, win, ety, ecode, ex, ey) {
    if id == APP_CATALOG { return cat_event(win, ety, ecode, ex, ey) }
    if id == APP_CLIP  { return cb_event(win, ety, ecode, ex, ey) }
    if id == APP_COLOR { return cp_event(win, ety, ecode, ex, ey) }
    if id == APP_REGEX { return pt_event(win, ety, ecode) }
    if id == APP_BASE  { return bc_event(win, ety, ecode) }
    if id == APP_DIFF  { return ld_event(win, ety, ecode) }
    if id == APP_HASH  { return ck_event(win, ety, ecode) }
    if id == APP_UNIT  { return uc_event(win, ety, ecode, ex, ey) }
    if id == APP_NOTES { return nt_event(win, ety, ecode) }
    if id == APP_KEYS  { return kt_event(win, ety, ecode) }
    if id == APP_BENCH { return bm_event(win, ety, ecode, ex, ey) }
    if id == APP_WORDLE    { return wg_event(win, ety, ecode) }
    if id == APP_TICTACTOE { return tt_event(win, ety, ecode, ex, ey) }
    if id == APP_NIM       { return nim_event(win, ety, ecode, ex, ey) }
    if id == APP_HANOI     { return ho_event(win, ety, ecode, ex, ey) }
    if id == APP_LIGHTS    { return lo_event(win, ety, ecode, ex, ey) }
    if id == APP_CONNECT4  { return c4_event(win, ety, ecode, ex, ey) }
    if id == APP_CALC { return ca_event(win, ety, ecode, ex, ey) }
    if id == APP_MAZE { return mz_event(win, ety, ecode) }
    # ---- the per-slice tables, same rule as reg_name above.
    if sys2_has(id) == 1 { return sys2_event(id, win, ety, ecode, ex, ey) }
    if sys3_has(id) == 1 { return sys3_event(id, win, ety, ecode, ex, ey) }
    if games3_has(id) == 1 { return games3_event(id, win, ety, ecode, ex, ey) }
    if games4_has(id) == 1 { return games4_event(id, win, ety, ecode, ex, ey) }
    return 0
}
fn reg_tick(id, win) {
    if id == APP_CLOCK { return clk_tick() }
    # ---- the per-slice ticks. Without these an animated app never advances:
    # ---- its draw is called, its events arrive, and nothing moves on its own.
    if sys2_has(id) == 1 { return sys2_tick(id, win) }
    if sys3_has(id) == 1 { return sys3_tick(id, win) }
    if games3_has(id) == 1 { return games3_tick(id, win) }
    if games4_has(id) == 1 { return games4_tick(id, win) }
    return 0
}

# ---- the catalog window ------------------------------------------------------
# One grid, one scroll offset, one hover index - the same shape as the dock
# (dock_hover/dock_press) and the start menu (menu_hover), just bigger.
CAT_W = 560
CAT_H = 380
CAT_TILE_W = 130
CAT_TILE_H = 108
CAT_HEADER = 26

cat_scroll = 0
cat_hover  = 0 - 1

fn cat_cols(win) {
    cc = idiv(wm_cw(win), CAT_TILE_W * ui())      # idiv: a column COUNT
    if cc < 1 { cc = 1 }
    return cc
}

fn reg_cat_label(cat) {
    if cat == 0 { return "System" }
    if cat == 1 { return "Utility" }
    return "Game"
}

# Shared by drawing (position-pure) and hit-testing, so a click always lands
# on the tile it looks like it landed on - the same discipline menu_row_at
# documents for the start menu.
fn cat_hit(win, ex, ey) {
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win) - CAT_HEADER * u
    if cx < 0 { return 0 - 1 }
    if cy < 0 { return 0 - 1 }
    cols = cat_cols(win)
    col = idiv(cx, CAT_TILE_W * u)           # idiv: a tile INDEX, see ac_grid_hit
    if col >= cols { return 0 - 1 }
    row = idiv(cy, CAT_TILE_H * u) + cat_scroll   # idiv: a tile INDEX
    idx = row * cols + col
    if idx < 0 { return 0 - 1 }
    if idx >= reg_count() { return 0 - 1 }
    return idx
}

fn cat_max_scroll(win) {
    cols = cat_cols(win)
    rows = idiv(reg_count() + cols - 1, cols)     # idiv: a row COUNT
    vis  = (wm_ch(win) - CAT_HEADER * ui()) / (CAT_TILE_H * ui())
    if vis < 1 { vis = 1 }
    ms = rows - vis
    if ms < 0 { ms = 0 }
    return ms
}

fn cat_draw(ax, ay, aw, ah) {
    u = ui()
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))

    # the legend: three swatches, so the colour on every tile MEANS something
    # rather than being decoration - the anti-slop reading of "colour work".
    lx = ax + 8 * u
    li = 0
    while li < 3 {
        # THE LEGEND'S SWATCH IS THE SAME MARK THE TILES CARRY, so the key
        # and the thing it keys look alike. An 8x8 vermilion square is also
        # wider than the focus bar, which is the rule the tiles were just
        # corrected against.
        fill_rgb(lx, ay + 5 * u, focus_bar(), 16 * u, ac_cat_color(li))
        label(lx + 12 * u, ay + 6 * u, reg_cat_label(li), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        lx = lx + label_w(reg_cat_label(li), T_CAPTION, W_REG) + 32 * u
        li = li + 1
    }
    if reg_count() == 0 {
        label(ax + 8 * u, ay + CAT_HEADER * u + 8 * u, "no applications registered yet", theme(TH_TEXT_DIM), T_BODY, W_REG)
        return 0
    }

    cols = 1
    cc = idiv(aw, CAT_TILE_W * u)                 # idiv: a column COUNT
    if cc >= 1 { cols = cc }
    gy = ay + CAT_HEADER * u

    i = 0
    while i < reg_count() {
        id = reg_id_at(i)
        crow = idiv(i, cols) - cat_scroll         # idiv: a row number
        ccol = i % cols
        ty = gy + crow * CAT_TILE_H * u
        # only the rough vertical band, to skip work for rows scrolled off -
        # fb_clip (set to the client rect before app_draw runs) is what makes
        # this an optimisation rather than a correctness requirement.
        # CULL AGAINST THE BODY, NOT THE CLIENT. This admitted a row as soon as
        # any part of it reached the top of the CLIENT rect - but the legend
        # occupies the top CAT_HEADER units and is drawn first, so with the list
        # scrolled the row above the viewport had fourteen units of tile drawn
        # straight over the three legend swatches and their labels. fb_clip is
        # set to the client, not the body, so nothing stopped it.
        #
        # cat_scroll steps in whole rows, so the first visible row has ty == gy
        # exactly and this loses nothing.
        if ty >= gy {
            if ty < ay + ah {
                tx = ax + ccol * CAT_TILE_W * u
                hv = 0
                if cat_hover == i { hv = 1 }
                # THE TILE FACE COMES FROM THE THEME, NOT FROM THE OLD PALETTE.
                # These were rgb(26,32,48) and rgb(46,58,84) - #1A2030 and
                # #2E3A54, cold blue-slate values from the SUPERSEDED document.
                # PRESSWORK's plate is ZD_BASE #322B27 and its accent is
                # ZD_VERM #E8734F; neither literal exists anywhere in this
                # ladder. All Applications was the one window on the desktop
                # still wearing the predecessor's design, and the one window
                # that did not answer a theme change at all.
                #
                # design.h is explicit that it is the only place a colour
                # literal may appear. A raw rgb() in an app is that rule being
                # broken, and here it was broken in the direction of a palette
                # the project has replaced.
                bgc = theme(TH_PANEL_HI)
                if hv == 1 { bgc = theme(TH_SURF_5) }
                rrect(tx + 6 * u, ty + 4 * u, CAT_TILE_W * u - 12 * u, CAT_TILE_H * u - 16 * u, 10 * u, bgc)
                # A MARK, NOT A FILL - and the width is the one vermilion is
                # allowed.
                #
                # This drew a stripe the full width of the tile in
                # ac_cat_color, which resolves to TH_ACCENT for the game
                # category: 23 of the 37 tiles, plus the legend swatch, each
                # spending the overprint on an area more than a hundred units
                # wide. proto:129-131 - "vermilion never fills an area wider
                # than the focus bar except one button per view" - is cited by
                # line in apps_sys3.zl and PRINTED ON SCREEN by the Settings
                # PRESS tab, two windows from this one.
                #
                # The register rail already solves exactly this: a category is
                # a mark down the left edge at focus_bar() width, which is the
                # same signal at a width the budget permits.
                fill_rgb(tx + 6 * u, ty + 4 * u, focus_bar(), CAT_TILE_H * u - 16 * u, ac_cat_color(reg_cat(id)))
                ic = reg_icon(id)
                if ic >= 0 {
                    icon(tx + CAT_TILE_W * u / 2 - 12 * u, ty + 16 * u, ic, theme(TH_TEXT_HI))
                } else {
                    label(tx + 16 * u, ty + 18 * u, reg_mono(id), theme(TH_TEXT_HI), T_TITLE, W_BOLD)
                }
                label(tx + 10 * u, ty + CAT_TILE_H * u - 24 * u, reg_name(id), theme(TH_TEXT_HI), T_CAPTION, W_REG)
            }
        }
        i = i + 1
    }
    return 0
}

fn cat_event(win, ety, ecode, ex, ey) {
    if ety == 5 {
        cat_scroll = cat_scroll - ecode
        if cat_scroll < 0 { cat_scroll = 0 }
        ms = cat_max_scroll(win)
        if cat_scroll > ms { cat_scroll = ms }
        wm_dmg(win)
        return 1
    }
    if ety == 4 {
        nh = cat_hit(win, ex, ey)
        if nh != cat_hover {
            cat_hover = nh
            wm_dmg(win)
        }
        if band(ecode, 1) != 0 {
            # reg_id_at(nh), NOT REG_FIRST + nh. nh is an index into the DENSE
            # list; the id space has holes in it (35..39 unallocated, one spare
            # at the end of each slice), so the two stopped being the same
            # number at the first hole. Every tile from index 20 on - which is
            # every app in every slice file, 27 of the 47 - opened the app six
            # or more ids below the one whose name and icon were on the tile.
            if nh >= 0 { reg_open(reg_id_at(nh)) }
            return 1
        }
        return 1
    }
    return 0
}
