# kernel.zl - zlOS
#
# A kernel with a graphical console and a shell, written in zl. Runs on bare
# metal: no OS, no libc, no syscalls, no GRUB on the BIOS path. The serial and
# keyboard drivers are zl; on a UEFI framebuffer the whole UI - gradients, a
# scaled logo, panels, a block cursor - is drawn pixel by pixel from zl too.

COM1 = 0x3F8
VGA  = 0xB8000

# ---- palette (VGA colour indices; the framebuffer maps them to RGB) --------
C_BLACK  = 0x00
C_BLUE   = 0x01
C_GREEN  = 0x0A
C_CYAN   = 0x0B
C_RED    = 0x0C
C_GREY   = 0x07
C_DGREY  = 0x08
C_LBLUE  = 0x09
C_YELLOW = 0x0E
C_WHITE  = 0x0F

C_TITLE  = 0x1F      # white on blue (VGA title fallback)
C_STATUS = 0x8F      # white on dark grey
C_CURSOR = 0x0A      # green block cursor

# ---- true-colour theme (framebuffer only) ----------------------------------
# One source of truth now lives in ui.c's ui_theme. The zl side names semantic
# roles and asks for their current value, so Settings changes the chrome,
# furniture and applications together instead of leaving a second palette on
# screen. RGB remains for generated wallpaper light fields, not UI roles.
fn rgb(rr, gg, bb) { return rr * 65536 + gg * 256 + bb }

# ---- idiv, AND WHAT IT ACTUALLY DIFFERS FROM ---------------------------------
#
# THIS COMMENT USED TO SAY "`/` is FLOAT division: 7 / 2 is 3.5. Verified with
# ./interp, not assumed." The verification was real and it was run on the wrong
# machine, which is the most expensive kind of citation there is.
#
# ./interp is the HOSTED interpreter, built from src/runtime/interp.c and
# src/runtime/runtime.c, and there `/` is genuinely float (interp.c:1948,
# `make_num(a / b)`). But THIS FILE IS COMPILED, not interpreted: the C backend
# emits zl_binop("/", a, b) for every divide, and the runtime every kernel image
# links is freestanding/runtime_kernel.c, whose zl_binop opens
#
#     long long x = (long long)a.num, y = (long long)b.num;
#
# and returns (double)(x / y). Truncating integer division. Its own header says
# so in as many words - "Integer semantics on purpose ... Numbers here are
# whole" - and src/runtime/runtime.c is not linked into any kernel image at all.
#
# So `/` on the desktop's own code has always been integer division, and the
# sentence above sent a reader (me) chasing a bug class that does not exist
# here. It was believed precisely BECAUSE it carried evidence.
#
# WHAT idiv STILL DIFFERS BY, and it is not the truncation:
#   * `a / b` with b == 0 calls kfatal("divide by zero") and halts the machine.
#     idiv returns 0. That is a real trade and it goes the wrong way for a bug:
#     a zero divisor becomes a plausible index instead of a loud stop.
#   * idiv masks the result to 0x7FFFFFFF and handles a negative numerator by
#     negating around the mask. `/` does neither.
#
# Use whichever the situation wants, and know which one you are choosing.
# 0x7FFFFFFF is the mask rather than a smaller one because a memory address
# divided down is a legitimate argument here.
fn idiv(a, b) {
    if b <= 0 { return 0 }
    if a < 0 { return 0 - band((0 - a) / b, 0x7FFFFFFF) }
    return band(a / b, 0x7FFFFFFF)
}
TH_BG = 0
TH_PANEL = 1
TH_PANEL_HI = 2
TH_TEXT = 3
TH_TEXT_DIM = 4
TH_ACCENT = 5
TH_BORDER = 6
TH_DANGER = 7
TH_TITLE = 8
TH_TITLE_BOT = 9
TH_TITLE_OFF = 10
TH_WALL_TOP = 11
TH_WALL_BOT = 12
TH_BAR_TOP = 13
TH_BAR_BOT = 14
TH_BAR_HI = 15
TH_CHROME = 16
TH_CHROME_LINE = 17
TH_TEXT_HI = 18
TH_OK = 19
# Nine more roles, appended so no existing index moves. Before these an app had
# no way to say "warning" and spent the accent on it, and three text tiers and
# three surfaces collapsed onto two colours each.
TH_TEXT_2 = 20
TH_TEXT_5 = 21
TH_TEXT_6 = 22
TH_WARN = 23
TH_SURF_1 = 24
TH_SURF_5 = 25
TH_SURF_7 = 26
TH_SURF_WELL = 27
TH_ACCENT_BR = 28
# ---- PRESSWORK's own roles, 29..41 -----------------------------------------
# The twenty-nine above can name a surface and an ink. They cannot name a
# BOUNDARY (which side of an edge the one raking light is on) and they cannot
# name a VALUE INVERSION (the focused header is a light plate with its title
# reversed out of it). PRESSWORK needs both, so ui.h grew thirteen fields and
# this is the zl-visible half of that ABI.
#
# THE INDEX IS THE CONTRACT. ui_color() indexes a flat array of unsigneds from
# &theme.bg, so these numbers are struct field order and nothing else. ui.h
# carries two _Static_asserts anchoring cut (30) and ink_on (41) to exactly
# these values, so a field inserted above them fails the C build rather than
# silently handing this file the wrong colour - which is the failure mode a
# by-index ABI has and a by-name one does not.
TH_TITLE_OFF_BOT = 29
TH_CUT = 30                # the groove. every hairline, and the strip ground
TH_LIT = 31                # the struck top run, 2.5423:1 on ZD_BASE
TH_LITSOFT = 32            # the grazed left run
TH_EDGE_OVER = 33          # the boundary an occluder draws, under overlap only
TH_KNOCK = 34              # THE KNOCKOUT. 6.4796:1 on ZD_BASE
TH_KNOCK_INK = 35          # reversed out of it, 8.53:1
TH_KNOCK_INK2 = 36         # secondary on it, 4.70:1
TH_KO_EDGE = 37            # the knockout's own edge run
TH_GRID = 38               # the ruled module grid on the desk
TH_STEEL = 39              # the machine's own reading. INSTRUMENTS ONLY.
TH_STEEL_BR = 40
TH_INK_ON = 41             # text on vermilion, 6.14:1
# 42 is the slot after ink_on. The mirror guard cannot check this one: the
# colour roles are an ENUM in ui.h, not defines, so there is no symbol with a
# value for it to compare against. What holds the two in step is the
# _Static_assert in ui.h that anchors the LAST field's offset to the last
# enumerator - it fails to compile if the struct and the enum disagree, which
# is a stronger check than this comment could make and runs on every build.
TH_BAD_INK = 42            # failure TEXT, 5.9093:1 - see ui.h's tail assert
fn theme(role) { return ui_color(role) }

# ---- the metric roles, by index ---------------------------------------------
# ui_metric() answers in PIXELS, not design units: ui.c runs every one of these
# through dp() with the current scale before storing it, so `ui_metric(UM_RAIL_W)`
# is already `170 * scale` and multiplying by ui() again would double it. That
# is the one mistake this indirection invites, so it is named here rather than
# left to each call site to remember.
UM_PAD = 0
UM_GAP = 1
UM_ROW_H = 2
UM_RADIUS = 3
UM_TITLE_H = 4
UM_SCALE_Q8 = 5
UM_FOCUS_BAR = 6
UM_RAIL_W = 7
UM_STRIP_H = 8
UM_FOOT_H = 9
UM_BAND_H = 10

# ---- the app suite ----------------------------------------------------------
# Everything past the original 13 apps (APP_SHELL..APP_EDIT, APP_SETTINGS,
# APP_RUN) lives in these imported modules rather than bolted straight into
# this file - see docs/app-suite.md for the registry design. `import`
# splices each module's top level into this program at PARSE time (same
# mechanism for every backend, see docs/design/design_imports.md), so this
# is the one place that says what the suite is made of.
import apps_common
import apps_registry
import apps_utils
import apps_games1
import apps_games2
import apps_system
# The four id-disjoint slices. Each owns one file and one range so that four
# agents can write apps in parallel without editing a shared dispatch chain -
# see apps_sys2.zl for why, and for the runtime-misroute trap that makes a
# duplicate id worse than a compile error.
import apps_sys2
import apps_sys3
import apps_games3
import apps_games4
# Generated from app-manifest.json. It prints the exact manifest digest from
# inside the running image, so host-side registry truth and shipped bytes can
# no longer drift silently.
import app_manifest_embed
# Generated route-neutral source/toolchain identity. Unlike the app manifest,
# this covers the active kernel build inputs; exact target and final artifact
# hashes are joined by boot receipts after linking.
import build_identity_embed

# ---- serial input -----------------------------------------------------------
# It used to be read HERE, with band(inb(COM1 + 5), 1) as the ready test. Two
# things were wrong with that and both are now input.c's problem instead:
#
#   1. An undecoded port floats high, so on a machine with no UART - the
#      ThinkPad - that test is TRUE forever and inb(COM1) returns 0xFF forever.
#   2. Two readers of one FIFO cannot keep the order. input.c drains COM1 into
#      the event queue; a shell that ALSO read the port directly would hand out
#      a byte that arrived after one still sitting in the queue.
#
# So serial is a source of the input stack now, like PS/2 and USB, and there is
# exactly one reader. See support.c ser_rx() and input.c's pump.

# ---- PS/2 keyboard, in zl --------------------------------------------------
KBD_TABLE = 0x7000
fn kmap(code, ch) { poke8(KBD_TABLE + code, ch) }
fn kbd_init() {
    fill_mem(KBD_TABLE, 0, 128)
    kmap(0x02, 49)  kmap(0x03, 50)  kmap(0x04, 51)  kmap(0x05, 52)
    kmap(0x06, 53)  kmap(0x07, 54)  kmap(0x08, 55)  kmap(0x09, 56)
    kmap(0x0A, 57)  kmap(0x0B, 48)
    kmap(0x10, 113) kmap(0x11, 119) kmap(0x12, 101) kmap(0x13, 114)
    kmap(0x14, 116) kmap(0x15, 121) kmap(0x16, 117) kmap(0x17, 105)
    kmap(0x18, 111) kmap(0x19, 112)
    kmap(0x1E, 97)  kmap(0x1F, 115) kmap(0x20, 100) kmap(0x21, 102)
    kmap(0x22, 103) kmap(0x23, 104) kmap(0x24, 106) kmap(0x25, 107)
    kmap(0x26, 108)
    kmap(0x2C, 122) kmap(0x2D, 120) kmap(0x2E, 99)  kmap(0x2F, 118)
    kmap(0x30, 98)  kmap(0x31, 110) kmap(0x32, 109)
    kmap(0x39, 32)                      # space
    kmap(0x1C, 13)                      # enter
    kmap(0x0E, 8)                       # backspace
    kmap(0x01, 27)                      # esc
    kmap(0x33, 44)  kmap(0x34, 46)  kmap(0x35, 47)   # , . /
    kmap(0x0C, 45)  kmap(0x0D, 61)                   # - =
    kmap(0x27, 59)  kmap(0x28, 39)                   # ; '
    kmap(0x1A, 91)  kmap(0x1B, 93)                   # [ ]
}

# shift state, tracked for the editor so it can type capitals
shift_state = 0
# Ctrl, tracked the same way shift is. Without this the editor can never see
# Ctrl+C: the PS/2 path builds characters from a scancode table and there is no
# modifier state but shift, so `c` is all that ever arrives.
ctrl_state = 0

# a shift-aware read: returns a translated character, or 0 if nothing / a
# modifier / a release. Uppercases letters; leaves the rest as-is (v1).
fn edit_key() {
    uk = usb_key()
    # Codes >= 256 are keys with no character - arrows, F-keys, Home/End. The
    # editor appends and deletes; it has no cursor to move, so it has no use
    # for them. Dropping them here matters: further down, anything >= 32 gets
    # poke8'd into the text buffer, and poke8 would truncate 0x110 to 0x10 and
    # write a control byte into the file.
    if uk >= 256 { return 0 }
    if uk != 0 { return uk }
    sc = scan_get()
    if sc == 0 { return 0 }
    if sc == 0x1D { ctrl_state = 1   return 0 }      # ctrl down
    if sc == 0x9D { ctrl_state = 0   return 0 }      # ctrl up
    if sc == 0x2A { shift_state = 1  return 0 }      # left shift down
    if sc == 0x36 { shift_state = 1  return 0 }      # right shift down
    if sc == 0xAA { shift_state = 0  return 0 }      # left shift up
    if sc == 0xB6 { shift_state = 0  return 0 }      # right shift up
    if band(sc, 0x80) != 0 { return 0 }              # any other release
    ch = peek8(KBD_TABLE + sc)
    if ch == 0 { return 0 }
    if shift_state == 1 { if ch >= 97 { if ch <= 122 { ch = ch - 32 } } }
    # Ctrl+letter is the letter with the top three bits cleared - Ctrl+C is 3,
    # Ctrl+V is 22. That is not a convention this file invents: it is what
    # input.c already produces on the USB path, so the editor sees the same
    # codes whichever keyboard it is being typed on.
    if ctrl_state == 1 { if ch >= 97 { if ch <= 122 { return band(ch, 31) } } }
    return ch
}
# The keyboard now arrives by INTERRUPT: the IRQ1 handler drops each scancode
# into a ring buffer, and scan_get() pulls the next one (0 when empty). This
# replaced polling port 0x60 directly, which dropped keys on real hardware.
fn kbd_scan() {
    sc = scan_get()
    if sc == 0 { return 0 }
    if band(sc, 0x80) != 0 { return 0 }     # key release - ignore
    return peek8(KBD_TABLE + sc)
}
# The shell's character source. ALL THREE sources - PS/2, USB and the serial
# line the automated gates drive - land in one event queue with modifiers, caps
# lock and auto-repeat already applied, so this is one call and the order is
# whatever order the bytes actually arrived in.
fn key_get() {
    return in_char()
}

# The editor's reader: a character, OR a navigation key above 0x100 so it can
# tell an arrow from a letter.
fn key_full() {
    return in_key()
}

# key codes the input stack reports for the non-printing keys
K_ESC = 0x101
K_BKSP = 0x102
K_TAB = 0x103
K_ENTER = 0x104
K_LEFT = 0x110
K_RIGHT = 0x111
K_PGUP_K = 0x116                   # keycodes.h KEY_PGUP
K_PGDN_K = 0x117                   # keycodes.h KEY_PGDN
K_UP = 0x112
K_DOWN = 0x113
K_HOME = 0x114
K_END = 0x115
K_DEL = 0x119

# ---- timing + sound, both riding on the timer interrupt --------------------
# WAIT FOR THE TIMER, BUT NEVER FOREVER - the same rule zl_putc already applies
# to the UART. This was `while ticks() < target { }`, an unbounded spin on a
# hardware counter, and when the timer interrupt was not being delivered it
# hung the machine inside the two-note boot chime with nothing on screen to say
# why. That is exactly what happened booting under OVMF (see apic.c: no MADT,
# no interrupt source overrides, PIC disabled anyway).
#
# The guard is a WATCHDOG, not a deadline: `spins` resets every time the
# counter actually moves, so a slow machine is never cut short - only a frozen
# counter trips it. At 100 Hz a tick lands every 10 ms, and 400000 iterations
# of two builtin calls is far longer than that, so a healthy timer cannot.
fn wait_ticks(n) {
    target = ticks() + n
    seen = ticks()
    spins = 0
    while ticks() < target {
        now = ticks()
        if now != seen { seen = now  spins = 0 }
        spins = spins + 1
        if spins > 400000 { return 0 }
    }
    return 0
}
fn beep(freq, dur) {
    beep_on(freq)
    wait_ticks(dur)
    beep_off()
}

# ---- graphical chrome ------------------------------------------------------
# On a framebuffer these draw real pixels; on VGA text the primitives no-op
# and the plain text title/status bars are used instead.

# ---- PRESSWORK: there is no top bar, and there is no dock -------------------
# What used to sit here was a floating GNOME-style island at the top and a
# floating dock at the bottom, with the wallpaper showing round both. PRESSWORK
# has neither. It has four bolted bands and a desk:
#
#   RAIL    170 dp, ZD_RAISE, the full height of the LEFT edge. The numbered
#           REGISTER - one row per app slot, its number in mono and its name in
#           LABEL caps - plus the workspace row, the machine's own readings and
#           the clock. It replaces the dock AND the top bar, so every launcher,
#           every workspace control and the clock are in one column.
#   STRIP    30 dp, ZD_CUT, across the top of the FIELD. Datum's raster
#           instrument: one column per composite.
#   FOOT     46 dp, ZD_RAISE, across the bottom of the FIELD. The memory ruler
#           over the printer's slug.
#   FIELD   what is left. ZD_VOID, ruled with the module grid, with the
#           measured legend along its foot. This is the desk.
#
# NOTHING FLOATS AND NOTHING IS TRANSLUCENT. The island and the dock were both
# alpha fills over the wallpaper with a 1px white-at-11% border; PRESSWORK's
# bands are opaque plates separated from the desk by a 2 dp ZD_LIT struck rule
# on the side the one raking light comes from, and a 1 px ZD_CUT groove on the
# side it does not. Radius is ZD_R_BOLT - zero - because radius in this system
# encodes HOW MUCH THE OBJECT CAN MOVE and these four cannot move at all.
#
# The UI scale: 1 on a small screen, 2 once the console switches to 16x32
# cells. EVERY offset and size below is multiplied by it, so the desktop is
# laid out in design units rather than raw pixels and stays correct at any
# resolution instead of colliding when the text grows.
# THE LAYOUT SCALE. It was cell_w() / 8, so it was 1 below 1400 pixels and 2
# above, and 2 for ever after - which is why the desktop looked smaller the
# bigger the screen got. The layout is written in 800 design units; at 2560
# wide with ui 2 there are 1280 units of space for an 800-unit design, and at
# 3840 there are 1920. fb.c derives this from the screen now and the console
# cell is a separate question. See its comment at fb_ui_scale.
fn ui() { return ui_scale() }

# ---- TEXT ROLES ------------------------------------------------------------
# Every label this file drew went through text_aa, which is DejaVu Sans MONO.
# wm.c's window titles were the only proportional text anywhere on screen, and
# uniform advance is the single strongest "this is a terminal" signal there is
# (docs/desktop/desktop-look.md item 4) - applied, until now, to a dock, a menu, a tray and
# an identity card, none of which are terminals.
#
# A role, never a size: T_BODY at ui 2 and at ui 4 are different pixel heights,
# and any caller that had to know which is a caller that breaks on a screen
# nobody tested.
T_CAPTION = 0
T_BODY    = 1
T_TITLE   = 2
W_REG     = 0
W_BOLD    = 1
TITLE_H = 28                       # ZD_TITLE_H - down from 36, see design.h
# THE PROTOTYPE'S OWN NUMBERS. presswork-prototype.html's APPS table gives the
# monitor p:[14, 430, 640, 400]. This said 424 x 376, and the two-column body
# the reference specifies does not fit in 424 - the column heads collided and
# the composite-time figures ran into each other. The old comment claimed the
# height "matches the north-star three-window composition"; that composition
# came from ds.html, the PREDECESSOR document, which design.h has since
# superseded ("If this header and the prototype disagree, THE PROTOTYPE WINS").
# The widest the prototype's default composition reaches: files sits at x 672
# and is 540 wide. Below this the desk falls back to the stacked layout.
PROTO_FIT = 1212
# THE AUTHORITY'S OWN RECT FOR THE FILES WINDOW, named once.
#
# presswork-prototype.html gives files p:[672, 12, 540, 400]. The boot
# composition used those four numbers correctly, and the other two call sites -
# the shell's `files` command and reopen_files - opened it at
# desk_x(106), desk_y(300), 672 x 352. The 672 there is the authority's X used
# as a WIDTH, which is how a transcription error hides: the number is right, it
# is in the wrong slot, and nothing about 672 looks out of place in a size.
FILES_X = 672                      # presswork-prototype.html APPS files p[0]
FILES_Y = 12                       # ...p[1]
FILES_W = 540                      # ...p[2]
FILES_H = 400                      # ...p[3]

MON_W = 640                        # presswork-prototype.html APPS mon p[2]
MON_H = 400                        # presswork-prototype.html APPS mon p[3]
AB_H  = 150                        # About height; no clipped final line at 2x
# ABOUT HAD NO WIDTH OF ITS OWN. It used MON_W for its width AND for its right
# anchor, so raising the monitor to the prototype's 640 silently made About 640
# wide and moved it - a window nobody was editing, changed by a constant that
# had never been about it. 424 is the width it had for its whole life.
AB_W  = 424

# ---- the four bands, in design units ----------------------------------------
# These are ZD_RAIL_W / ZD_STRIP_H / ZD_FOOT_H / ZD_BAND_H / ZD_ROW_H / ZD_PAD /
# ZD_GAP / ZD_RULE_H / ZD_FOCUS_BAR, and they are DUPLICATED here for exactly one
# reason: ui_metric() answers 0 until ui_theme() has run, and this file draws a
# desktop on the VGA-fallback and pre-compositor paths where it has not. The
# accessors below prefer the theme and fall back to these, so a stale copy can
# only ever be wrong on a path where the theme does not exist yet - never on the
# shipped one. design.h remains the source; this is the copy, and it says so.
RAIL_W_D    = 170
STRIP_H_D   = 30
FOOT_H_D    = 46
BAND_H_D    = 20
ROW_H_D     = 26
PAD_D       = 10
GAP_D       = 8
RULE_H      = 2                    # ZD_RULE_H - the struck ZD_LIT rule
FOCUS_BAR_D = 3                    # ZD_FOCUS_BAR - the register mark's width
# THE RADIUS SCALE, and it is four values now rather than sixteen. Radius here
# encodes HOW MUCH THE OBJECT CAN MOVE, and nesting halves it: 9 for a plate
# that floats, 4 for something inset in one, 2 for a chip, 0 for anything
# bolted down - which is every one of the four bands. ui_metric(UM_RADIUS) is
# ZD_R_PLATE; the other three have no metric role, so they are here.
# ZD_R_BOLT is 0 and the four bands take it, which is why none of them names a
# radius at all - they are drawn with fill_rgb. ZD_R_PLATE is ui_metric(UM_RADIUS)
# and wm.c reads it. ZD_R_INSET is the only one this file has to name.
R_INSET_D   = 4                    # ZD_R_INSET - a row or field inside a plate
R_CHIP_D    = 2                    # design.h ZD_R_CHIP - the button and chip radius

# WHY NOTHING IS MOUNTED. fs_ok() answers yes or no; fs_mount_impl answers no
# from ten different places, and the Files pane used to print one sentence for
# all ten - then offer to format on it.
# ALL ELEVEN, NOT SIX. This copied six of fs.c's eleven causes and the pane
# below then printed "the mount was refused - reason not reported" for the
# other five - a false statement about the machine's own knowledge, on the one
# window whose whole subject is read figures.
#
# FS_WHY_DIRBROKEN is the sharp one. fs.c:439-446 carries a comment saying that
# before ITS fix the Files pane printed exactly that sentence "about a failure
# this function had just named on the console", and sets the code to stop it.
# The C half landed; this half was never written, so the string that comment
# names is still what the pane printed on that path.
FS_WHY_NODISK      = 1             # fs.c FS_WHY_NODISK
FS_WHY_UNREADABLE  = 2             # fs.c FS_WHY_UNREADABLE
FS_WHY_UNFORMATTED = 3             # fs.c FS_WHY_UNFORMATTED
FS_WHY_VERSION     = 4             # fs.c FS_WHY_VERSION
FS_WHY_DAMAGED     = 5             # fs.c FS_WHY_DAMAGED
FS_WHY_BLOCKSIZE   = 6             # fs.c FS_WHY_BLOCKSIZE
FS_WHY_MAXFILES    = 7             # fs.c FS_WHY_MAXFILES
FS_WHY_GEOMETRY    = 8             # fs.c FS_WHY_GEOMETRY
FS_WHY_DIRLOAD     = 9             # fs.c FS_WHY_DIRLOAD
FS_WHY_DIRENTRY    = 10            # fs.c FS_WHY_DIRENTRY
FS_WHY_DIRBROKEN   = 11            # fs.c FS_WHY_DIRBROKEN

# THE MODULE GRID. ZD_GRID_COLS / ROWS / MARGIN / GUTTER, and there is no
# ui_metric for them because they are not a widget metric - they are the desk's
# own ruling, read only by this file.
GRID_COLS   = 12
GRID_ROWS   = 8
GRID_MARGIN = 16
GRID_GUTTER = 12
CROP_LEN    = 18                   # ZD_CROP_LEN - the crop mark's arm
CROP_OFF    = 7                    # ZD_CROP_OFF - how far outside the margin

fn rail_w()   { rm = ui_metric(UM_RAIL_W)    if rm > 0 { return rm }  return RAIL_W_D * ui() }
fn strip_h()  { sm = ui_metric(UM_STRIP_H)   if sm > 0 { return sm }  return STRIP_H_D * ui() }
fn foot_h()   { fm = ui_metric(UM_FOOT_H)    if fm > 0 { return fm }  return FOOT_H_D * ui() }
fn band_h()   { bm = ui_metric(UM_BAND_H)    if bm > 0 { return bm }  return BAND_H_D * ui() }
fn row_h()    { wm = ui_metric(UM_ROW_H)     if wm > 0 { return wm }  return ROW_H_D * ui() }
fn pad_d()    { pm = ui_metric(UM_PAD)       if pm > 0 { return pm }  return PAD_D * ui() }
fn focus_bar() { cm = ui_metric(UM_FOCUS_BAR) if cm > 0 { return cm } return FOCUS_BAR_D * ui() }

# ---- the field: what is left after the four bands ---------------------------
# ONE ORIGIN, and every one of the six things that needs it reads it from here.
# The rule this file learned at pip_at and again at tray_x is that a second
# independently-derived origin for the same rectangle is how a control ends up
# drawn in one place and clickable in another - and the field is read by the
# grid, the legend, the crop marks, the boot composition, the menu and the
# window layout, which is six chances to get it wrong instead of one.
fn field_x() { return rail_w() }
# BORDER-BOX, LIKE EVERYTHING ELSE THE PROTOTYPE DECLARES.
#
# `* { box-sizing: border-box }` (proto:325), so `#raster { height:
# var(--zd-strip-h); border-bottom: calc(2px * var(--ui)) solid var(--zd-lit) }`
# (proto:486-487) is 30dp TOTAL - 28 of ZD_CUT with the 2dp rule INSIDE it -
# and `#foot` (proto:560-562) is 46dp total the same way.
#
# This added the rule ON TOP of each declared height. Measured: at ui 1 the
# strip occupied 32dp against 30 and the foot 48 against 46, and the field was
# `h - 80` against the authority's `h - 76`; at ui 2, 64/60, 96/92 and `h - 160`
# against `h - 152`.
#
# IT WAS NOT ONLY COSMETIC. wm.c reserves the border-box figure -
# `#define RESERVE_TOP(t) ((t)->strip_h)` (wm.c:338) - so the compositor's
# clamp_to_field and this file's field disagreed by RULE_H at both ends, and
# every window placed or clamped against one was off against the other.
#
# This is the identical fault already fixed for `.hdr` (wm.c:2879-2890) and
# `.sband` (wm.c:1763-1769) - the two elements at the other end of the screen.
fn field_y() { return strip_h() }
fn field_w() { return px_w() - rail_w() }
fn field_h() { return px_h() - field_y() - foot_h() }
# The old names, kept because forty call sites in this file and its app modules
# ask "where does the desktop start". They are the field's top-left now.
# TOPBAR_H and DESK_TOP ARE GONE. Every caller of either was asking "where does
# the desktop start", and the answer is now two numbers rather than one, because
# the desk has a left edge as well as a top one. field_x/field_y answer it and
# nothing may add a margin to a bare screen coordinate again.

# ---- the register rail, and its own vertical rhythm --------------------------
# PLATE's numbered REGISTER on graphite's single rail, and the prototype's
# reason for 170 dp is arithmetic rather than taste: "01 SYSTEM MONITOR" has to
# fit beside its number and its mark. The register alone would take 132.
#
# THE TWO-MATERIAL LAW IS NOT IMPORTED. Datum's law - chrome in ink, content on
# paper - needs a ground at L* >= 89.6 to hold its 14.26:1, and on this ground
# an ink rail would compute 1.35:1 against the plate: its meaning evaporates
# while its screen area does not. So the rail is ZD_RAISE, one rung proud of the
# plate, lit by the same lamp, its far edge cut away with a 1 px ZD_CUT groove
# and its near edge carrying a 1 px ZD_LIT struck run.
#
# THE RAIL'S BLOCKS, top to bottom, in design units. Everything except the
# register band is a FIXED height, and the register band is what is left - which
# is the only arrangement where the clock is at the bottom of the screen on a
# 600-tall panel and on a 1440-tall one without a second table.
RAIL_IDENT_H = 58                # 11 pad + the 24 dp identity line + 15 + 7
RAIL_SECT_H  = 26                # a section caption: 7 + 15 + 4
RAIL_STAT_H  = 63                # 3 + three 19 dp reading rows + 3
RAIL_CLOCK_H = 54                # 5 + the 24 dp HH:MM + 15 + 10
RAIL_SLOT_PL = 13                # a register row's left inset, past the mark
RAIL_SLOT_PR = 6
RAIL_SLOT_GAP = 7                # between the number and the icon, and again
                                 # between the icon and the name
RAIL_STROW_H = 19                # one reading row inside the stat block

# THE STAT BLOCK GREW FROM 44 TO 63 BECAUSE IT HAS THREE ROWS NOW, not two.
# 3 + three 19 dp rows + 3 = 63. Read that against rail_bot_h(): the register
# band loses 19 dp, and the bill is COUNTED rather than waved off. Run
# check-shell-layout.py against this file before and after and rail_reg_fit()
# on its four panel sizes goes
#
#   800x600 ui1   13 -> 13     the smallest panel, and the binding one:
#                              rail_bot_h() 155 -> 174, the band 358 -> 339 px,
#                              idiv(339, 26) is still 13
#   1280x800 ui1  21 -> 20
#   1920x1080 ui2 11 -> 10
#   2560x1440 ui2 18 -> 17
#
# One row off the CEILING on three of the four, none off the smallest, and the
# ceiling is what a tail window uses - the fixed twelve are untouched at every
# size the shipped ui scale actually produces. The 1920x1080 line is the one to
# read twice: it is already under REG_ROWS at 11, and it was before this change.
# That case is the checker's own assumption of ui 2 at 1920. fb.c computes
# ui_scale_q8 as width*256/1920 clamped at 256, so 1920 is ui 1 on the machine,
# where the band is 819 px and fits 31 rows - and 1920x1200 fits 36. Nothing
# ships clipped there.
#
# THE STATUS ROWS DO NOT CARRY THE PROTOTYPE'S ICON, and this is the one place
# the icon column could not be reproduced. `.strow` puts a 13 dp glyph before
# each of net / vol / pwr. The reason it is absent is arithmetic and it was
# found by computing it rather than by looking at a 1920 render, where it does
# not show:
#
#   fb_icon24's smallest output is 24 PHYSICAL pixels and it scales by
#   ui_scale_q8, so on a 2560-wide panel (q8 341) it draws 32 px. But a row
#   height written as `RAIL_STROW_H * ui()` does NOT scale by q8: zl_binop
#   (freestanding/runtime_kernel.c) casts both operands to long long before
#   multiplying, so ui() - which is q8/256.0 - TRUNCATES to 1 for every panel
#   from 1920 to 3839 px wide. At 2560 the row is 19 px and the icon is 32 -
#   thirteen pixels of one reading's glyph landing in the next reading's row.
#   (An earlier draft of this change grew the row to 26 to make room and still
#   overflowed by six there, which is how the truncation was found at all.)
#
# Sizing the block to absorb that needs RAIL_STAT_H >= 150 (the worst q8/trunc
# ratio approaches 2), which is 150 px of a 600 px panel spent on three
# readings. The register row escapes the same trap only because its height is
# row_h() - a THEME metric, computed in C by ui.c's dp() with proper rounding -
# where the stat block's is not, and it cannot be: check-shell-layout.py asserts
# `stat_y + RAIL_STAT_H * u + rule1 == clock_top` against a constant it parses
# out of this line, so the block's height has to stay a constant times ui().
#
# So the rows are the label, the state dot and the state WORD, which is the
# whole of the reading; the glyph was the only decorative part of that row and
# it is the part that did not fit. Closing it needs either a size argument on
# fb_icon24 or a dp()-equivalent for design units in zl, and neither is inside
# this file.

# THE STATE DOT beside a reading's state WORD. 7 dp square, the prototype's
# `.dot { width: 7px; height: 7px }`. It is square and not round because this
# file has no circle primitive that is not a rounded rect, and a 7 px rounded
# rect at radius 3 is a lumpy circle - a square swatch is what a printed key
# uses anyway. Colour never carries the state alone: the WORD is always beside
# it, which is the free rider all four parent designs share.
RAIL_DOT = 7
RAIL_DOT_GAP = 5                 # between the dot and the word

# THE ICON COLUMN. fb_icon24 is the whole icon vocabulary this kernel has and
# it takes NO size: it draws 24 design units, resolved against ui_scale_q8
# exactly the way rail_ico_w() below repeats. So the column is 24 and not the
# prototype's 14, and that divergence is recorded at rail_ico_w rather than
# hidden here.
RAIL_SLOT_ICO = 24

# THE REGISTER MARK - overprint job 1 of PRESSWORK's four, and the only part of
# the focus signal that is legible from the rail. Vermilion, ZD_FOCUS_BAR wide,
# on the rail's left edge. A RUNNING app gets a short mark; the app owning the
# FOCUSED window gets the full row height in ZD_VERM_BR and its row is dropped
# to ZD_BASE - the plate's own value, so the row reads as the window it owns.
#
# 35% top and bottom is the prototype's `.slot .mk { top: 35%; bottom: 35% }`,
# which leaves 30% of the row. It is written as a percentage of row_h() rather
# than a design constant because row_h() is a theme metric and a fixed mark on a
# scaled row is a mark that drifts off centre at ui 2.
RAIL_MK_PC = 30

# HOW WIDE THE ICON ACTUALLY LANDS, and this repeats fb_icon24's own arithmetic
# on purpose. THE RESERVED COLUMN AND THE DRAWN GLYPH MUST BE ONE NUMBER: the
# icon primitive takes no size argument, so a caller that reserves
# `RAIL_SLOT_ICO * ui()` and lets fb.c draw `(24 * ui_scale_q8 + 128) / 256`
# has two independently-derived widths for the same box - which is the second
# origin this file has already been bitten by twice (pip_at, tray_x).
#
# AND THEY DISAGREE BY EIGHT PIXELS, not by rounding. `K * ui()` does not scale
# by q8 at all in the fractional band: zl_binop casts both operands to long
# long before multiplying (freestanding/runtime_kernel.c), and ui() is
# q8/256.0, so it truncates to 1 for every panel from 1920 to 3839 px wide. At
# 2560 - q8 341, a size check-shell-layout.py tests - `RAIL_SLOT_ICO * ui()`
# reserves 24 while fb_icon24 draws 32. So this is the SAME expression fb.c
# evaluates, floor clamp included, and the layout below reads it rather than
# multiplying.
#
# THE 24 IS NOT A CHOICE AND IT IS NOT THE PROTOTYPE'S. `.slot` puts a 14 dp
# glyph before the name; fb_icon24's smallest output is 24 physical pixels,
# because it clamps `if (dst < ICON_W) dst = ICON_W`. Measured against the
# atlas rather than guessed: across the fifteen icons the register uses, the
# ink inside that 24 px box runs 13 px tall (snake) to 22 px (settings), median
# 19, in a 26 dp row - so the mark reads at roughly 73% of the row where the
# prototype's reads at about 54%. It is heavier than the reference and that is
# the whole of the divergence. Closing it needs a size argument on fb_icon24,
# and fb.c is not this change's to edit.
fn rail_ico_w() {
    iw = idiv(RAIL_SLOT_ICO * ui_scale_q8() + 128, 256)
    if iw < RAIL_SLOT_ICO { iw = RAIL_SLOT_ICO }
    return iw
}

# THE CLOCK GETS A FIXED CELL, and that is this file's own established rule for
# a live number, stated a few hundred lines down: "a readout whose labels slide
# sideways as the digits change is unreadable". A fixed cell wide enough for the
# worst case is the correct shape. It also means the rail's width does not have
# to be measured against a string that changes every minute.
#
# DIVERGENCE, recorded rather than hidden: the prototype's rail clock is MONO
# (`font-family: var(--mono)`, tabular-nums) at fs-lg. This one is the fixed-cell
# PROPORTIONAL form at T_TITLE, and the reason is a real limit rather than a
# preference: the mono atlas has exactly three baked sizes and the largest,
# font16x32_aa, is a FIXED 16x32 - fb_text_aa2x does not take a scale, so at
# ui 2 on a 2560-wide panel the clock would stay the size it is at 1280 while
# every label beside it doubled. T_TITLE scales, and clock_field() gives each
# digit its own cell, which is the property the mono face was wanted for.
# Restoring the mono clock means a scalable mono draw in fb.c, and fb.c is not
# this change's to edit.
#
# The second divergence is unchanged from before PRESSWORK: the reference's
# clock reads "Tue 22:00" and this one reads "22:00". zl's kernel subset has no
# runtime string type - label() takes a literal and label_num() takes an integer
# - so a weekday name would need a lookup table returning one of seven string
# literals and a way to concatenate it with the time, and there is no
# concatenation. The time itself is real: rtc_h() and rtc_mi() off the CMOS clock.
CLOCK_W = 36
CLOCK_CELL_LG = 14                 # the T_TITLE digit cell, design units

# ---- workspaces --------------------------------------------------------------
# The reference has three. The pip row that used to show which one you are on
# was in the top island; PRESSWORK's workspace row is in the rail, and the
# current one is a KNOCKOUT rather than a lozenge - see draw_rail_ws.
#
# THE CURRENT WORKSPACE IS THE COMPOSITOR'S NOW, not a variable in this file.
# It used to be a `ws_cur` here that only the pips read: switching changed the
# indicator and nothing else, and the comment that used to sit in this spot
# said so. That is the shape of an indicator that tells the truth about a
# variable and lies about the machine, and the fix is not to add filtering
# beside the variable - it is to move the variable to where the windows are.
# wm.c holds it, wm.c filters the paint walk, the hit test and both focus
# walks by it, and these two functions are now one call each.
#
# HOW MANY there are stays here, because that is policy: three buttons, three
# workspaces. wm_wsn() tells the compositor the ceiling so Super+9 is refused
# rather than switching to an empty ninth workspace with no button to return from.
# TWO, NOT THREE. The comment above said "The reference has three" and cited
# ds-reference.html - the SUPERSEDED document. presswork-prototype.html has two:
# renderRail maps [1, 2], the key handler answers alt+1 and alt+2 only, the ws
# toggle flips between 1 and 2, and the palette lists exactly "workspace 02".
# The alt+1/alt+2 bindings wired earlier today already assumed two, so the rail
# was drawing a third button no key could reach and no command could name.
WS_N = 2
fn cur_ws() { return wm_ws() }
fn set_ws(n) { return wm_setws(n) }

# The keyboard half of the workspace switch. Damage is claimed only when the
# switch actually happened - wm_set_ws returns 0 when n is out of range or is
# already current, and repainting the whole screen for a refused switch is a
# visible cost for no change.
fn ws_hotkey(n) {
    if set_ws(n) == 0 { return 0 }
    wm_damage(0, 0, px_w(), px_h())
    return 1
}

# WHERE AN APP LIVES WHEN NOTHING HAS OPENED IT YET - the reference's own
# assignment, from ds-reference.html's three tables:
#
#   APPS       each entry carries its own `ws:`, listed one per app below
#   UTILS      `ws:2` for all ten, applied by the .map() that builds them
#   GAME_APPS  `ws:3` for all twenty-four, the same way
#
# This is the INITIAL table and not a rule about opening. The reference's
# openApp() writes `winWs[id] = s.ws` every time, so an app you launch appears
# on the workspace you are looking at, which is what wm_open does here too. The
# table is what a window carries before anyone has opened it - which is why the
# only place it is read is the boot composition, where the three windows the
# desktop opens for itself get their workspace from it rather than from the
# accident of which workspace happened to be current at boot.
fn app_ws(id) {
    if id == APP_SHELL   { return 1 }         # Terminal
    if id == APP_FILES   { return 1 }
    if id == APP_MONITOR { return 1 }
    if id == APP_EDIT    { return 2 }         # Text Editor
    if id == APP_SETTINGS { return 1 }
    if id == APP_KLOG    { return 2 }         # Kernel Log
    if id == APP_REND    { return 3 }         # Renderer
    if id == APP_HEXV    { return 3 }         # Hex Viewer
    if id == APP_FBUF    { return 3 }         # Framebuffer
    if id == APP_TTY     { return 2 }         # Console (tty1)
    if id == APP_FONT    { return 3 }         # Font Atlas
    if id == APP_DISK    { return 1 }         # Disk Usage
    if id == APP_SVC     { return 1 }         # Services
    if id == APP_ARCH    { return 3 }         # Archive Manager
    if id == APP_IMG     { return 3 }         # Image Viewer
    if id == APP_NET     { return 2 }         # Network
    if id == APP_CLOCK   { return 2 }         # Clocks & Timers
    if id == APP_SYSINFO { return 1 }         # System Info
    if id == APP_SYSPANE { return 1 }         # 10 SYSTEM  - beside the shell
    if id == APP_TYPEPANE { return 1 }        # 14 TYPE    - beside it
    if id == APP_CALC    { return 2 }         # Calculator
    # The two whole categories. reg_cat() answers 1 for a utility and 2 for a
    # game, which is exactly the split the reference's two .map()s make, so
    # these two lines stand in for thirty-four entries and cannot go stale when
    # a game is added.
    if reg_cat(id) == 1 { return 2 }
    if reg_cat(id) == 2 { return 3 }
    return 1
}

# HH:MM, drawn as two numbers and a colon rather than one string, because there
# is no string to build. Leading zero is explicit: label_num(9) prints "9", and
# a clock that reads "9:5" is worse than no clock.
# One zero-padded two-digit field, returning the x after it.
#
# THIS EXISTS BECAUSE THE INLINE VERSION DREW "0000". Written straight through,
# the single-digit branch printed the leading zero, advanced, printed the digit
# and then did NOT advance again - so the colon landed on top of the digit and
# the whole clock collapsed into four touching glyphs. Splitting it out makes
# the advance unconditional and impossible to forget on one branch.
#
# A digit gets a FIXED cell rather than a measured one: label_num has no width
# function, and a clock whose colon slides as the digits change is the thing
# the fixed-cell rule elsewhere in this file exists to prevent.
CLOCK_DIGIT = 8
fn clock_field(nx, cy, v, cell, role, col) {
    if v < 10 {
        label(nx, cy, "0", col, role, W_REG)
        label_num(nx + cell, cy, v, col, role, W_REG)
        return nx + cell * 2
    }
    label_num(nx, cy, v, col, role, W_REG)
    return nx + cell * 2
}

# HH:MM at a given cell width and role, returning the x after it. The colon sits
# in a HALF cell, which is the one place the fixed grid is deliberately broken:
# a colon in a full digit cell reads as a gap with a dot in it.
fn draw_hhmm(cx, cy, cell, role, col) {
    nx = clock_field(cx, cy, rtc_h(), cell, role, col)
    label(nx, cy, ":", col, role, W_REG)
    nx = clock_field(nx + cell / 2, cy, rtc_mi(), cell, role, col)
    return nx
}

# ---- THE REGISTER ------------------------------------------------------------
# The rail's numbered rows. This IS the dock's launcher table - the same apps,
# the same routing - re-presented as a printed register: "01 TERMINAL" rather
# than a chip with a picture on it. Three things follow from that and all three
# are the point:
#
#   1  A REGISTER IS ORDERED AND A DOCK IS NOT. The number is not decoration; it
#      is the row's address, so the boot composition's three windows are 01, 02
#      and 03 and you can say which one you mean.
#   2  IT IS A TASKBAR TOO. A row whose app has a window carries the register
#      mark, and clicking it raises that window rather than opening a second
#      copy - which is what the dock already did and what the separate row of
#      window chips beside the dock was the wrong shape for.
#   3  THE ROWS ARE NOT ALL FIXED. Slots 0..REG_N-1 are the fixed register;
#      after them the rail lists any OPEN window whose app has no fixed slot,
#      which is where the forty-seven catalog apps appear. draw_rail and
#      rail_slot_at walk that tail in the same order for the same reason
#      draw_tasklist and task_slot_at had to: a hit test that counts a different
#      set of rows than the draw does hands the click to the row next door.
REG_N = 14                         # the prototype's fourteen, slot for slot
REG_CATALOG = 14                   # the row past the register: "ALL APPS"
REG_ROWS = 15                      # fixed rows drawn, register + catalog

# THE NAMES ARE LOWERCASE, which is a correction rather than a preference. The
# prototype's rows are `01 [icon] terminal 1119`: LABEL caps carry the NUMBER
# and the section captions, and the app's own name is set lowercase at fs-md
# (`.slot .nm`). This file had every name in caps, so the rail read as twelve
# headings with nothing under them - caps everywhere is caps meaning nothing,
# and the caption rung stops separating "REGISTER" from "terminal".
#
# They are literals and not lower-cased at runtime because zl's kernel subset
# has no string type to walk.
#
# THE WIDTH BUDGET, remeasured now the row carries an icon and a figure. The
# rail is 170 dp; at ui 1 that is 13 left inset + 16 of number + 7 + 24 of icon
# + 7 = 67 before the name, and the count is right-aligned into the last
# 6 + 4 mono cells = 38, so the figure starts at 132 and a name has 65 dp.
# MEASURED with fb_text_role_w against the shipped atlas, not estimated: the
# longest of these is "terminal" - 44 px at T_CAPTION regular, which is how an
# idle or running row draws it, and 50 px at W_BOLD, which is how the FOCUSED
# row draws it. Worst case is therefore 67 + 50 = 117 against a figure at 132:
# 15 px of air, and the same 15 px at 800x600 and 1920x1200 because all three
# are ui_scale_q8 256. On a 2560 panel the rail is 226 px and the slack is 63;
# on a 3840 panel it is 80. No panel this tree targets is tight.
#
# It stays T_CAPTION rather than the prototype's fs-md because T_BODY and
# T_CAPTION are the SAME 12 px cell at ui 1 (fb.c's role_base collapses to two
# steps there, and says why), so at the size this ships at the two are
# indistinguishable and T_CAPTION is the one that keeps its promise on a panel
# where they diverge.
# THE REGISTER IS THE PROTOTYPE'S, SLOT FOR SLOT. It used to be twelve rows of
# whatever this file had reached for first - browser, paint, snake, cube, about,
# run - against the prototype's fourteen, so the one surface a person reads
# before anything else disagreed with the design in eleven of twelve rows.
#
# Every one of the fourteen ALREADY EXISTS in this OS. The registry carries 63
# named implementations and the prototype names fourteen; thirteen matched by
# name (Kernel Log, Hex Viewer, Calculator, Network, Clocks & Timers, Disk
# Usage, System, Type ...) and the fourteenth, its `13 registers  pipe A`, is
# this tree's System Info. So this was never missing apps. It was a table
# pointing at the wrong ones.
#
# The catalogue row survives as row 15. The prototype had fourteen apps and
# needed no way to reach a fifteenth; this OS has forty-nine more, and dropping
# the row that reaches them to match a mock would be deleting a capability, not
# matching a design.
fn rail_name(slot) {
    if slot == 0 { return "terminal" }
    if slot == 1 { return "files" }
    if slot == 2 { return "monitor" }
    if slot == 3 { return "editor" }
    if slot == 4 { return "kernel log" }
    if slot == 5 { return "hex" }
    if slot == 6 { return "calculator" }
    if slot == 7 { return "network" }
    if slot == 8 { return "clocks" }
    if slot == 9 { return "system" }
    if slot == 10 { return "settings" }
    if slot == 11 { return "disk usage" }
    if slot == 12 { return "registers" }
    if slot == 13 { return "type" }
    return "all apps"
}

# THE ROW'S ICON, as an index into icons.c's 89-entry coverage atlas. The atlas
# is already in the image - the window titlebars draw out of it - so this is a
# table and not new artwork, and the indices are the generated header comment
# at the top of icons.c rather than numbers picked by eye.
#
# It is a SECOND table beside rail_app() and rail_name() rather than a field on
# one, because zl has no record type; the three are kept adjacent and walked by
# the same `slot` so a row added to one is visibly missing from the others.
# THE ROW'S SUBTITLE, the dim mono word wm.c prints after the window title.
# It answers "which one" where the title answers "what": the terminal's tty,
# the file window's volume, the monitor's sample rate. A THIRD table beside
# rail_app(), rail_name() and rail_icon(), kept adjacent for the same reason
# they are - zl has no record type, so a row added to one is visibly missing
# from the others.
# THE STATUS BAND'S LEFT CELL, which until now was EMPTY ON EVERY WINDOW.
#
# wm.c draws the band as chrome and has always had a slot for this - the design
# note there says the band is chrome precisely so that 53 apps cannot each draw
# it differently. wm_set_status is declared, defined, and bound to zl. It had
# ZERO CALLERS in any .zl file in the tree, so the cell it fills was blank on
# all fourteen windows while the prototype prints a line on each.
#
# These are the prototype's own band strings, except where its string would say
# something untrue of this machine. Each departure is named at the line.
fn rail_status(slot) {
    if slot == 0 { return "tty1" }
    if slot == 1 { return "rd0 - zlfs" }
    # "sampler 1 Hz" in the reference; the ring is per painted frame.
    if slot == 2 { return "sampler, per frame" }
    # "read only" in the reference, whose editor is a viewer. This one writes:
    # editor_save calls fs_wr then fs_sync and reports a failed flush as not
    # durable. Copying that label would advertise the opposite of Ctrl+S.
    if slot == 3 { return "read write" }
    if slot == 4 { return "ring buffer" }
    # "rd0 - 4 MiB" in the reference. hx_ui reads HX_BASE = 0x100000 - the
    # kernel image at its load address - with +0/+256/+512 page chips. It has
    # never been able to open a file, so naming a volume here would point at
    # something it does not show.
    if slot == 5 { return "kernel image" }
    if slot == 6 { return "int64" }
    if slot == 7 { return s3nw_drv(1) }
    if slot == 8 { return "monotonic" }
    if slot == 9 { return "zlos 0.3" }
    if slot == 10 { return "design.h" }
    if slot == 11 { return "rd0" }
    if slot == 12 { return "cpuid, apic" }
    # DejaVu is CORRECT and stays. The three baked atlases are generated from
    # DejaVu Sans Mono by gen_hd_font.py - kernel/HANDOFF.md:1116 - so this is a
    # true citation, not the prototype describing some other machine.
    if slot == 13 { return "DejaVu" }
    return "reg"
}

fn rail_sub(slot) {
    if slot == 0 { return "zlsh" }
    if slot == 1 { return "rd0" }
    # NOT "1 Hz". wm.c's sample ring is pushed once per PAINTED FRAME, not once
    # per second, so at 60 Hz its 64 columns are about one second and not
    # sixty-four of them. The monitor's own head row says "per composited
    # frame"; this is the same fact and must not disagree with it.
    if slot == 2 { return "per frame" }
    if slot == 3 { return "fb.c" }
    if slot == 4 { return "dmesg" }
    if slot == 5 { return "rd0 s0" }
    if slot == 6 { return "int64" }
    # NOT "enp0s31f6", WHICH THE PROTOTYPE PRINTS. That is a Linux predictable
    # interface name for an Intel part; this OS names no interfaces, and
    # s3nw_drv() two files away answers "virtio-net" for this very slot. The
    # network pane already shipped one bug of exactly this shape - a hardcoded
    # e1000e in the head with virtio-net in the driver row two lines below.
    if slot == 7 { return s3nw_drv(1) }
    if slot == 8 { return "monotonic" }
    # "0.3" is the VERSION, and check-version.py checks it against version.h
    # along with every other version literal in this file.
    if slot == 9 { return "0.3" }
    if slot == 10 { return "design.h" }
    if slot == 11 { return "zlfs" }
    # NOT "pipe A", WHICH IS WHAT THE PROTOTYPE PRINTS. Its registers pane
    # reads PIPE_LINK_M/N off real Intel silicon. This one deliberately does
    # not: that block reads ZERO under QEMU, and si_draw's own comment says
    # printing the reference's 0x0080D9E4 there "would be inventing a reading",
    # so the pane shows cpuid and the APIC instead. The subtitle stayed behind
    # naming a block the pane had already stopped reading.
    if slot == 12 { return "cpuid, apic" }
    if slot == 13 { return "DejaVu" }
    return "reg"
}

# EVERY OPEN WINDOW GETS ITS REGISTER NUMBER AND SUBTITLE, once per frame.
#
# wm.c draws those two cells but must not invent them - which app is 03 and
# what its subtitle says are shell facts, and the chrome deliberately renders
# them blank rather than guessing. This is the call that fills them, and
# without it the title bar comes out correct and empty, which is the exact
# shape of bug this tree keeps catching: finished-looking code with no caller.
#
# Once per frame rather than once per open, because a window can be closed and
# reopened into the same slot and because the rail table is the authority - a
# row added there should not need a second edit at some wm_open site to show
# up in the chrome. Twelve iterations of two stores is not worth caching.
fn label_windows() {
    ls = 0
    # REG_N, not 12. This said 12 while the register was twelve rows long, and
    # stayed 12 when it became fourteen - so rows 13 and 14 opened windows whose
    # chrome had no register number and no subtitle. The same class as
    # rail_cmd's slot table, found the same way: by changing REG_N and looking
    # for what did not move with it.
    while ls < REG_N {
        lw = rail_win(ls)
        if lw >= 0 {
            if wm_is_open(lw) == 1 { wm_set_label(lw, ls + 1, rail_sub(ls)) }
            if wm_is_open(lw) == 1 { wm_set_status(lw, rail_status(ls)) }
        }
        ls = ls + 1
    }
}

fn rail_icon(slot) {
    if slot == 0 { return 0 }        # terminal
    if slot == 1 { return 7 }        # files
    if slot == 2 { return 4 }        # monitor
    if slot == 3 { return 3 }        # editor
    if slot == 4 { return 44 }       # log
    if slot == 5 { return 46 }       # hex
    if slot == 6 { return 49 }       # calc
    if slot == 7 { return 17 }       # network
    if slot == 8 { return 16 }       # clock
    if slot == 9 { return 55 }       # chip - the SYSTEM pane
    if slot == 10 { return 8 }       # settings
    if slot == 11 { return 51 }      # disk
    if slot == 12 { return 53 }      # binary - the REGISTERS pane
    if slot == 13 { return 50 }      # font - the TYPE pane
    return 19                        # grid - ALL APPS
}

# The same, for a TAIL row: a window whose app has no fixed register slot. The
# tail is where the catalog's apps appear, and there are forty-seven of them
# against fourteen atlas entries that mean anything specific - so the ones this
# kernel names get their own mark and the rest get `svc`, the generic unit
# glyph, rather than a wrong specific one. A wrong icon is worse than a neutral
# one: it says "this is the editor" about something that is not.
fn app_icon(app) {
    if app == APP_SHELL   { return 0 }
    if app == APP_MONITOR { return 4 }
    if app == APP_ABOUT   { return 5 }
    if app == APP_SNAKE   { return 1 }
    if app == APP_BROWSER { return 20 }
    if app == APP_SETTINGS { return 8 }
    if app == APP_RUN     { return 42 }
    if app == APP_PAINT   { return 2 }
    if app == APP_CUBE    { return 6 }
    if app == APP_EDIT    { return 3 }
    if app == APP_FILES   { return 7 }
    if app == APP_ANIM    { return 45 }   # render
    if app == APP_MOUSE   { return 47 }   # snap
    return 52                             # svc
}

# ---- THE ROW'S FIGURE --------------------------------------------------------
# The prototype puts a live per-window number on every running row - `01
# terminal 1119` - and it is the SAME number its window's status band shows.
# Two modes exist there: `measured`, the window's app_us, and the fallback,
# `w.px / 1000` in kilopixels.
#
# THIS KERNEL CAN ONLY HONESTLY DRAW THE SECOND, and the prototype's own cost
# sheet says so before this file does: "PER WINDOW MICROSECONDS. wm.c measures
# app_us per window now - wm_win_us. This note predates that and said the
# opposite; the fallback
# is the window's repaint_pixels in the same slot, same face." Verified against
# wm.c rather than taken on trust - frame_us and frame_peak_us are file-static
# singletons and paint_repaint_pixels is reset once per COMPOSITE, not per
# window, so there is no per-window timing to read and wm_us() would print the
# whole frame's cost twelve times over. Twelve rows all reading 2939 is not a
# per-app figure; it is one figure drawn twelve times, which is the shape of a
# readout that lies.
#
# So the figure is the window's own client area in KILOPIXELS - which is
# exactly repaint_pixels for a full repaint of that window, per window, from
# numbers wm.c already keeps. It changes when the window is resized or
# maximised, which is when a window's repaint cost actually changes.
#
# THE UNIT IS NOT PRINTED, and that is the prototype's shape too: `.slot .us`
# is a bare figure and the window's own status band carries the word. A unit on
# every row of a 170 dp rail is thirty characters of the same three letters.
# THE RAIL AND THE STATUS BAND PRINT THE SAME FIGURE, because in the authority
# one function feeds both. `usOf(id)` is called by renderRail for the slot's
# figure AND by usBand for the window's band, so a row and the band under that
# window always agree.
#
# Here they did not: the rail printed KILOPIXELS - the client area over a
# thousand - and the band printed MICROSECONDS. Two quantities, two units, in
# two places the eye compares directly.
#
# usOf offers BOTH units and the choice is a config:
#   `S.cfg.us === 'measured' ? w.us + ' us' : (w.px / 1000) + ' kpx'`
#
# This surface takes the pixel count, and the reason is where it is DRAWN. The
# register rows are painted into the baked wallpaper by draw_rail_static, which
# runs once at boot - before any app has drawn a frame, so wins[].app_us is
# still 0 for every window and stays 0 in the bake for ever.
#
# I tried the microsecond figure first and it rendered a column of zeros on
# screen, which is how this is known rather than reasoned. The pixel count is
# available at bake time because it is arithmetic on the window's rect, which
# exists the moment it opens.
#
# So the rail and the status band DO print different quantities, and that is a
# real divergence from the authority - where one function feeds both. Closing it
# means moving these rows out of the bake, which is a bigger change than this
# note. Written down rather than papered over.
fn rail_slot_us(win) {
    if win < 0 { return 0 }
    return idiv(wm_cw(win) * wm_ch(win), 1000)
}

# THE RAIL'S OWN BLOCK BOUNDARIES. Fixed heights measured DOWN from the top and
# UP from the bottom; the register band is whatever is between them. Written as
# functions rather than as globals because px_h() is not known until the mode is
# settled, and a global evaluated at load time would be laid out for a screen
# nobody has.
# THESE TWO SUM THE SAME TERMS draw_rail_static WALKS, IN THE SAME ORDER, and
# that is the only thing that makes them correct - a block height that is a
# separate estimate of a walk is a block height that drifts. The first draft of
# rail_bot_h counted THREE rule-2s where the walk draws two, and used ui() for
# the 1px rule-1 where rail_rule1 advances by exactly 1 physical pixel. At ui 2
# that is five pixels of rail showing between the stat block and the clock -
# benign, invisible in a screenshot, and wrong. Read down this expression and
# down draw_rail_static together; they are the same list.
#
#   top     ident, rule2, sect,           rule1
#   bottom  rule2, sect,  wsrow,  rule2,  stat,  rule1,  clock
#
# THE RULES ARE 1 PHYSICAL PIXEL, NOT 1 DESIGN UNIT. A hairline that thickens
# with the scale stops being a hairline and becomes a rule, which is the whole
# distinction PLATE's two rule weights exist to carry - so rule 1 is `+ 1` here
# and rule 2 is `RULE_H * ui()`, and the difference between them is the rank.
fn rail_top_h()  { return RAIL_IDENT_H * ui() + RULE_H * ui() + RAIL_SECT_H * ui() + 1 }
fn rail_bot_h()  { return RULE_H * ui() + RAIL_SECT_H * ui() + row_h() + RULE_H * ui() + RAIL_STAT_H * ui() + 1 + RAIL_CLOCK_H * ui() }
fn rail_reg_y()  { return rail_top_h() }
# THE CAPTION IS PART OF THE LIVE BAND, not part of the baked half, because it
# carries the running count. So the rectangle that invalidates the register has
# to start at the caption and not at the first row - the same one-origin rule
# this file learned at tray_x, and the same failure if it is broken: a count
# that changes outside its own damage rectangle keeps its old value on screen.
fn rail_sect_y()   { return RAIL_IDENT_H * ui() + RULE_H * ui() }
fn rail_dmg_y()    { return rail_sect_y() }
fn rail_dmg_h()    { return rail_reg_y() + rail_reg_h() - rail_sect_y() }
fn rail_reg_h()  { rh = px_h() - rail_top_h() - rail_bot_h()  if rh < 0 { rh = 0 }  return rh }
# HOW MANY ROWS FIT, derived from the space rather than asserted. On a 480-tall
# panel at ui 1 this is 9 and the register is 12 rows long, so the tail is
# clipped - stated here rather than discovered on the machine that has one.
fn rail_reg_fit() { return idiv(rail_reg_h(), row_h()) }

# ---- one register row --------------------------------------------------------
# THE FOUR STATES, and each is a value on the ladder rather than an effect:
#   idle      the rail's own ZD_RAISE, number and name at ZD_TEXT_3
#   hover     ZD_FLOAT - one rung off the plane, the prototype's
#             `.slot:hover:not(.act) { background: var(--zd-float) }`
#   running   still the rail, but the number climbs to ZD_TEXT_2 and the name to
#             ZD_TEXT_1, and a SHORT vermilion mark appears at the left edge
#   focused   the row drops to ZD_BASE - the PLATE's own value, so the row reads
#             as the window it owns - the name goes ZD_TEXT_0 bold, and the mark
#             runs the FULL row height in ZD_VERM_BR
#
# There is no ring and no glow on any of them. PRESSWORK deleted both tokens
# (ZD_RING_FOCUS_A is 0), because focus is the knockout and the register mark.
#
# THE ROW IS FOUR COLUMNS NOW and it reads left to right exactly as the
# prototype's `.slot` does: mark, number, icon, name, figure. Everything past
# the number is laid out from ONE running x rather than from four independent
# offsets, because four offsets is four chances for the icon to sit inside the
# name on a scale nobody rendered.
#
# WEIGHT FOLLOWS FOCUS, which it did not before. Every name in the rail was
# W_BOLD, so the focused row - the one thing bold is for here - had no weight
# left to take. `.slot .nm` is the face's regular and `.slot.act .nm` is 700;
# this now says the same thing.
fn draw_rail_row(ry, num, nm, ico, us, running, focused, hovered) {
    u = ui()
    rw = rail_w()
    rh = row_h()
    ground = theme(TH_PANEL_HI)
    ncol = theme(TH_TEXT_DIM)
    tcol = theme(TH_TEXT_DIM)
    wgt = W_REG
    if hovered == 1 { ground = theme(TH_SURF_5) }
    if running == 1 { ncol = theme(TH_TEXT_2)  tcol = theme(TH_TEXT) }
    if focused == 1 { ground = theme(TH_PANEL)  ncol = theme(TH_TEXT_2)  tcol = theme(TH_TEXT_HI)  wgt = W_BOLD }
    fill_rgb(0, ry, rw, rh, ground)
    # rail edges back on - see draw_rail_win for why every live block owes this
    fill_rgb(0, ry, 1, rh, theme(TH_LIT))
    fill_rgb(rw - 1, ry, 1, rh, theme(TH_CUT))
    # the row's own groove. `border-bottom: 1px solid var(--zd-cut)`, and it is
    # 1 PHYSICAL pixel at every scale: a hairline that thickens with ui() stops
    # being a hairline and becomes a rule.
    fill_rgb(0, ry + rh - 1, rw, 1, theme(TH_CUT))
    # THE MARK. Overprint job 1. Short while the app merely runs, full height
    # once it owns the focused window.
    if running == 1 {
        mkh = rh * RAIL_MK_PC / 100
        mky = ry + (rh - mkh) / 2
        mkc = theme(TH_ACCENT)
        if focused == 1 { mkh = rh  mky = ry  mkc = theme(TH_ACCENT_BR) }
        fill_rgb(0, mky, focus_bar(), mkh, mkc)
    }
    # the number, in mono, because a register's addresses are a column of digits
    # and a column of digits that does not line up is not a column. num_aa
    # advances by cell_w(), which is the only fixed advance this file has.
    ny = ry + (rh - cell_h()) / 2
    if num < 10 {
        num_aa(RAIL_SLOT_PL * u, ny, 0, ncol)
        num_aa(RAIL_SLOT_PL * u + cell_w(), ny, num, ncol)
    } else {
        num_aa(RAIL_SLOT_PL * u, ny, num, ncol)
    }
    # THE ICON, then the name, off one running x. The icon's ink follows the
    # NUMBER's rung rather than the name's: it is the row's address in picture
    # form, structure beside a glyph, and putting it on the name's rung made
    # twelve marks compete with twelve words at the same value.
    tx = RAIL_SLOT_PL * u + 2 * cell_w() + RAIL_SLOT_GAP * u
    iw = rail_ico_w()
    icon(tx, ry + (rh - iw) / 2, ico, ncol)
    tx = tx + iw + RAIL_SLOT_GAP * u
    label(tx, ry + (rh - label_h(T_CAPTION)) / 2, nm, tcol, T_CAPTION, wgt)
    # THE FIGURE, on running rows only, right-aligned against the rail's own
    # inset. `.slot .us` is `margin-left: auto` and absent when the app is not
    # open, and both halves of that are the reading: an idle row has no window,
    # so it has no repaint cost, so a zero there would be a measurement of
    # nothing. It is ZD_TEXT_INERT - the structure rung, never a glyph rung -
    # for the same reason the section caption's figure is.
    if running == 1 {
    # TH_TEXT_DIM (ZD_TEXT_3), NOT TH_SURF_7. This drew GLYPHS with
    # ZD_TEXT_INERT, whose assignment in ui.c carries the words "STRUCTURE ONLY.
    # never a glyph." on the same line. Measured on this ladder it is 2.0222:1
    # on ZD_RAISE, against 5.3585:1 for ZD_TEXT_3 - and the prototype's own CSS
    # names that number as the reason there is no fifth text rung, listing the
    # four things the token may do: scrollbar thumb, resize grip, chart mark,
    # disabled menu row. A readout is none of them. The prototype uses .ink3 for
    # both .slot .us and #regcount.
        num_aa(rw - RAIL_SLOT_PR * u - s3_numw(us), ny, us, theme(TH_TEXT_DIM))
    }
    return 0
}

# The same row, for a window with no fixed register slot. Its number continues
# the register's numbering, and its name is the app's, so a catalog app that is
# open is addressable the same way Terminal is.
#
# ITS NAME STAYS TITLE CASE where the fixed register's are lowercase, and that
# is a real divergence rather than an oversight. The label is app_name(), which
# is the same function wm.c's window titles and the catalog's list read; the
# register's twelve are literals in rail_name() and cost nothing to set
# lowercase, but lowercasing app_name() would lowercase every window title in
# the system. Closing it needs a second name table for the rail, which is the
# kind of duplicate table the register's own comment above warns about.
fn draw_rail_win(ry, num, win, hovered) {
    u = ui()
    rw = rail_w()
    rh = row_h()
    focused = 0
    if wm_focus() == win { focused = 1 }
    ground = theme(TH_PANEL_HI)
    ncol = theme(TH_TEXT_2)
    tcol = theme(TH_TEXT)
    wgt = W_REG
    if hovered == 1 { ground = theme(TH_SURF_5) }
    if focused == 1 { ground = theme(TH_PANEL)  tcol = theme(TH_TEXT_HI)  wgt = W_BOLD }
    fill_rgb(0, ry, rw, rh, ground)
    # THE RAIL'S TWO EDGES GO BACK ON. draw_rail_static bakes a ZD_LIT near edge
    # and a ZD_CUT far edge down the full height of the rail into the wallpaper
    # cache; every live-painted block covers them with its own ground and, until
    # now, left them covered. The rail's frame vanished wherever anything was
    # actually drawn - which is every row that matters. rail_sect already put
    # them back and was the only block that did.
    fill_rgb(0, ry, 1, rh, theme(TH_LIT))
    fill_rgb(rw - 1, ry, 1, rh, theme(TH_CUT))
    fill_rgb(0, ry + rh - 1, rw, 1, theme(TH_CUT))
    mkh = rh * RAIL_MK_PC / 100
    mky = ry + (rh - mkh) / 2
    mkc = theme(TH_ACCENT)
    if focused == 1 { mkh = rh  mky = ry  mkc = theme(TH_ACCENT_BR) }
    fill_rgb(0, mky, focus_bar(), mkh, mkc)
    ny = ry + (rh - cell_h()) / 2
    if num < 10 {
        num_aa(RAIL_SLOT_PL * u, ny, 0, ncol)
        num_aa(RAIL_SLOT_PL * u + cell_w(), ny, num, ncol)
    } else {
        num_aa(RAIL_SLOT_PL * u, ny, num, ncol)
    }
    tx = RAIL_SLOT_PL * u + 2 * cell_w() + RAIL_SLOT_GAP * u
    iw = rail_ico_w()
    icon(tx, ry + (rh - iw) / 2, app_icon(wm_app(win)), ncol)
    tx = tx + iw + RAIL_SLOT_GAP * u
    # THE NAME IS CLIPPED AT THE FIGURE, because nothing else keeps them apart.
    # This drew unmeasured and unclipped, so a long app name ran through its own
    # us reading and out past the rail's outer edge - two pieces of text on top
    # of each other, one of which is a measurement.
    #
    # The prototype keeps them apart with the flex box: `.slot .nm` carries
    # overflow:hidden and text-overflow:ellipsis, `.slot .us` is margin-left:auto
    # and flex:none. The name yields to the figure there, so it yields here.
    #
    # zl has no string VALUES, so the name cannot be shortened before it is
    # drawn - but `clip` is bound to the framebuffer's real scissor, which is
    # the same result by a different route. The budget is computed from the
    # figure that is actually about to be drawn, not from a guess at its width.
    tus = rail_slot_us(win)
    fx = rw - RAIL_SLOT_PR * u - s3_numw(tus)
    nw = fx - RAIL_SLOT_GAP * u - tx
    if nw > 0 {
        clip(tx, ry, nw, rh)
        label(tx, ry + (rh - label_h(T_CAPTION)) / 2, app_name(wm_app(win)), tcol, T_CAPTION, wgt)
        clipoff()
    }
    # A tail row exists ONLY because its window is open, so it is running by
    # construction and the figure is unconditional here where it is guarded on
    # the fixed rows. rail_running_n() counts the tail on exactly that reasoning.
    # ONE CALL TO rail_slot_us, held in a local, because the x it is drawn at
    # is measured from the same value that is drawn - a second call is a second
    # chance for a resized window to change the answer between the two.
    tus = rail_slot_us(win)
    num_aa(rw - RAIL_SLOT_PR * u - s3_numw(tus), ny, tus, theme(TH_TEXT_DIM))
    return 0
}

# ---- the two rule weights ----------------------------------------------------
# PLATE's depth rank, on tokens that already exist and with no third value
# invented for it. RULE 1 is 1 px ZD_CUT - 1.84:1 on the rail, a groove. RULE 2
# is RULE_H of ZD_LIT - 1.56:1 on the rail, but twice the width. Nesting a
# surface never changes its value here; only the rule weight says which rank a
# block is in, which is what lets the rail have five blocks on one colour.
fn rail_rule1(ry) { fill_rgb(0, ry, rail_w(), 1, theme(TH_CUT))  return ry + 1 }
fn rail_rule2(ry) { fill_rgb(0, ry, rail_w(), RULE_H * ui(), theme(TH_LIT))  return ry + RULE_H * ui() }

# A section caption: LABEL caps at ZD_TEXT_3, optionally with a mono figure
# pushed to the right margin. `n < 0` means "no figure", because zl has no way
# to say "absent" other than a sentinel.
#
# THE FIGURE IS A FRACTION NOW - `7/14`, running over total - and the shape is
# the correction. `#regcount` is `runc + '/' + APPS.length`, and a bare "3" was
# answering a question nobody asked: three OF WHAT is the only reading a
# register count carries, and without the denominator the number has to be
# compared against a row count you can only get by counting rows. The
# denominator is also not a constant - the tail grows the register when a
# catalog app opens - so it has to be drawn, not baked.
#
# `m < 0` is the second sentinel and means "a plain figure, no denominator",
# which is what every caller outside the REGISTER caption wants.
fn rail_sect(ry, nm, n, m) {
    u = ui()
    fill_rgb(0, ry, rail_w(), RAIL_SECT_H * u, theme(TH_PANEL_HI))
    fill_rgb(0, ry, 1, RAIL_SECT_H * u, theme(TH_LIT))
    fill_rgb(rail_w() - 1, ry, 1, RAIL_SECT_H * u, theme(TH_CUT))
    # `.sect` carries `<span class="t-lab">`, so the head is the LABEL STYLE:
    # SM, bold, UPPERCASE and TRACKED by ZD_TR_LAB. It was label(), which is
    # none of the last two - the caller shouted the string itself and the
    # tracking did not exist outside uikit.c. ui_caps does the transform and
    # the pen, so "register" and "REGISTER" now draw identically.
    ui_caps(pad_d(), ry + 7 * u, nm, theme(TH_TEXT_DIM), T_CAPTION)
    if n >= 0 {
        # THE WHOLE FRACTION IS MEASURED BEFORE ANY OF IT IS DRAWN, then laid
        # out left to right from that one origin. Right-aligning each piece
        # against the margin separately is how "7/14" ends up as "7" and "14"
        # overlapping a slash, and the widths differ by a digit every time the
        # tail changes - this file has already paid for that mistake once, at
        # clock_field.
        fw = s3_numw(n)
        if m >= 0 { fw = fw + cell_w() + s3_numw(m) }
        fx = rail_w() - pad_d() - fw
        num_aa(fx, ry + 7 * u, n, theme(TH_TEXT_DIM))
        if m >= 0 {
            text_aa(fx + s3_numw(n), ry + 7 * u, "/", theme(TH_TEXT_DIM))
            num_aa(fx + s3_numw(n) + cell_w(), ry + 7 * u, m, theme(TH_TEXT_DIM))
        }
    }
    return ry + RAIL_SECT_H * u
}

# ---- how many register rows are showing --------------------------------------
# The count the REGISTER caption prints, and it is the number of RUNNING rows
# rather than the number of rows - a register of twelve rows that always says 12
# is a label, not a reading. The tail rows count too: a tail row exists only
# because its window is open, so every one of them is running by construction.
fn rail_running_n() {
    rn = 0
    rs = 0
    while rs < REG_N {
        if rail_running(rs) == 1 { rn = rn + 1 }
        rs = rs + 1
    }
    # ...clamped at zero, because rail_reg_rows() is itself clamped to what
    # FITS: on a panel too short for twelve rows it returns fewer than REG_ROWS
    # and the subtraction goes negative, which would print a register count of
    # -3 on exactly the machine nobody tests on.
    tail = rail_reg_rows() - REG_ROWS
    if tail < 0 { tail = 0 }
    return rn + tail
}

# ---- the rail's static half --------------------------------------------------
# The identity block, the two section captions, the rules and the stat block.
# None of it changes while the machine runs, so it is baked into the wallpaper
# cache with the desk and costs a blit rather than a repaint.
fn draw_rail_static() {
    u = ui()
    rw = rail_w()
    fill_rgb(0, 0, rw, px_h(), theme(TH_PANEL_HI))
    # the rail's own two runs. ZD_LIT down the LEFT because that is the side the
    # one raking light enters from, ZD_CUT down the RIGHT because that is the
    # far edge - the same grammar every plate in the system uses, applied to a
    # band that happens to be taller than it is wide.
    fill_rgb(0, 0, 1, px_h(), theme(TH_LIT))
    fill_rgb(rw - 1, 0, 1, px_h(), theme(TH_CUT))
    # THE IDENTITY. An operating system does not explain what it is in its own
    # chrome; it says which machine you are on. "zlos" at T_TITLE and the build
    # line under it in mono, which is the prototype's `.ident .w` / `.ident .b`.
    # `.ident .w` is `t-big`: LG, bold, UPPERCASE, tracked by ZD_TR_BIG. This
    # is the ONLY .t-big in the prototype's shell and ZD_TR_BIG had no reader
    # anywhere in the tree before it, so the display style was specified and
    # never once drawn. The string stays lower case for the same reason the
    # section heads' do - the transform belongs to the style.
    ui_disp(pad_d(), 11 * u, "zlos", theme(TH_TEXT_HI), T_TITLE)
    text_aa(pad_d(), 11 * u + 24 * u, "0.3 x86_64", theme(TH_TEXT_DIM))
    ry = RAIL_IDENT_H * u
    ry = rail_rule2(ry)
    # the REGISTER caption is NOT baked: it carries the running count, and a
    # baked count is a reading that stops reading. draw_rail_reg paints it.
    ry = ry + RAIL_SECT_H * u
    rail_rule1(ry)
    # ...and the bottom block, laid out UP from the foot of the screen so the
    # clock is at the bottom of the rail on every panel height.
    by = px_h() - rail_bot_h()
    by = rail_rule2(by)
    by = rail_sect(by, "WORKSPACE", 0 - 1, 0 - 1)
    by = by + row_h()                     # the workspace row is drawn live
    by = rail_rule2(by)
    by = by + RAIL_STAT_H * u             # the stat block is drawn live
    rail_rule1(by)
    return 0
}

# ---- the workspace row -------------------------------------------------------
# THE ONE PLACE THE SHELL USES THE KNOCKOUT. The current workspace's button is a
# solid ZD_KNOCK plate with its label reversed out in ZD_KNOCK_INK - 6.4796:1 on
# the plate, 8.53:1 for the ink on it - which is the same move wm.c makes on the
# focused window's header. Using it twice is deliberate: it is the design's one
# value inversion, and a reader who has learned it on a window reads it here for
# free. The others are the rail's own ground with a ZD_CUT divider between them.
fn rail_ws_y() { return px_h() - rail_bot_h() + RULE_H * ui() + RAIL_SECT_H * ui() }
fn draw_rail_ws() {
    rw = rail_w()
    rh = row_h()
    wy = rail_ws_y()
    bw = idiv(rw, WS_N)
    wsi = 1
    while wsi <= WS_N {
        bx = (wsi - 1) * bw
        bwi = bw
        if wsi == WS_N { bwi = rw - bx }
        ground = theme(TH_PANEL_HI)
        ink = theme(TH_TEXT_DIM)
        if wsi == cur_ws() { ground = theme(TH_KNOCK)  ink = theme(TH_KNOCK_INK) }
        fill_rgb(bx, wy, bwi, rh, ground)
        # rail edges back on - see draw_rail_win for why every live block owes
        # this. Only the first button touches the near edge and only the last
        # touches the far edge, so each is conditional on being that button.
        if bx == 0 { fill_rgb(0, wy, 1, rh, theme(TH_LIT)) }
        if bx + bwi >= rw { fill_rgb(rw - 1, wy, 1, rh, theme(TH_CUT)) }
        if wsi < WS_N { fill_rgb(bx + bwi - 1, wy, 1, rh, theme(TH_CUT)) }
        # "WS 01", NOT A BARE DIGIT. The prototype's button is
        # `<span class="t-lab">ws 0' + n + '</span>`, and .t-lab is tracked
        # uppercase - so it reads WS 01 / WS 02. A lone numeral in a 85dp cell
        # says nothing about what it selects; the label is the half that does.
        # Zero-padded because the register beside it is, and two rows of
        # numbers that pad differently read as two different kinds of number.
        wsw = ui_capsw("ws 0", PW_SM) + s3_numw(wsi)
        wsx = bx + (bwi - wsw) / 2
        ui_caps(wsx, wy + (rh - ui_th(PW_SM)) / 2, "ws 0", ink, PW_SM)
        num_aa(wsx + ui_capsw("ws 0", PW_SM), wy + (rh - cell_h()) / 2, wsi, ink)
        wsi = wsi + 1
    }
    return 0
}

# WHICH WORKSPACE BUTTON IS UNDER A POINT, or -1. It repeats draw_rail_ws's
# arithmetic in the same order and one term at a time, for the reason the old
# pip_at recorded and which has not changed: a control laid out as it is painted
# has no stored x, and a second independently-derived origin is how a control
# ends up drawn in one place and clickable in another. The whole row height is
# the target, which it already was.
fn rail_ws_at(hx, hy) {
    if px_w() == 0 { return 0 - 1 }
    if hx >= rail_w() { return 0 - 1 }
    wy = rail_ws_y()
    if hy < wy { return 0 - 1 }
    if hy >= wy + row_h() { return 0 - 1 }
    bw = idiv(rail_w(), WS_N)
    wn = idiv(hx, bw) + 1
    if wn > WS_N { wn = WS_N }
    return wn
}

# ---- the machine's own readings ----------------------------------------------
# THREE STATUS ROWS, replacing the two figure rows that were here. The
# prototype's `#railstat` is `[['net','net','UP'], ['vol','vol','OK'],
# ['power','pwr','WARN']]` - an icon, a LABEL-caps name, and a STATE WORD with
# a coloured dot beside it. Three of those four are here; the icon is not, and
# the arithmetic that rules it out is written out at RAIL_STROW_H rather than
# repeated here. The rows this file had were FRAME and WINDOWS,
# two mono figures, which is a different instrument in the same slot.
#
# WHAT WAS LOST AND WHERE IT WENT, because deleting a reading needs an account:
#   FRAME    the same wm_us() the RASTER STRIP plots, one column per composite,
#            with its BUDGET printed at the right-hand end - and a plot of the
#            last several hundred frames is strictly more than one instantaneous
#            sample of the same number. The System Monitor window carries the
#            figure itself. NOTE FOR WHOEVER RECONCILES THIS: the slug's own
#            comment above slug_fit() says FRAME was dropped from the foot
#            because "the rail prints it in its stat block", and after this
#            change the rail does not. The strip and the Monitor window are the
#            two places left; if an instantaneous figure is still wanted in the
#            chrome, the strip's readout is where it belongs, beside its budget.
#   WINDOWS  the count is now the REGISTER caption's NUMERATOR - "3/12" says
#            three of twelve rows are running, and a running row IS an open
#            window on this workspace, because rail_running() is wm_open_p() of
#            the row's window. Better shaped than the bare count it replaces,
#            which never said what it was three OUT OF.
#
# STATE COLOUR NEVER TRAVELS ALONE. Every row draws the WORD as well as the
# dot, which is the free rider all four parent designs share and the only
# reason a colour-blind reader gets the same reading. The dot is ZD_OK /
# ZD_WARN / ZD_BAD; those are wired to STATE and never to the accent, so
# vermilion still appears nowhere in this block.
#
# DIVERGENCE, recorded: the prototype inks a FAILING word with ZD_BAD_INK
# (#EF9077), a lightened vermilion, where the fill colour ZD_BAD is too dark to
# carry text - ui.c's own token comment is the source of that judgement and of
# the figure it quotes, not a ratio computed here. design.h has the token; ui.c
# does not expose a ui_color() role for it, so kernel.zl cannot name it. The bad
# word is drawn at ZD_TEXT_0 with the dot carrying the colour, which is
# under-signalled rather than mis-signalled - the safe direction, and the same
# call ui.c already documents for the focused header. Closing it is one theme
# role in ui.h/ui.c and one TH_ index here.
# wlen IS THE WORD'S CHARACTER COUNT, and it has to be an argument because zl
# has no string length. Six parameters, under the eight-arg cap.
fn rail_st_word(sy, nm, word, wlen, dotc, wordc) {
    u = ui()
    rw = rail_w()
    ty = sy + (RAIL_STROW_H * u - label_h(T_CAPTION)) / 2
    # the key is `.t-lab` in the prototype's `.strow`; the WORD beside it is
    # `.strow .w`, which is MONO and untracked, so only the key moves here.
    ui_caps(pad_d(), ty, nm, theme(TH_TEXT_DIM), T_CAPTION)
    # ...AND THE WORD IS DRAWN IN MONO, which the comment above has said the
    # whole time while the code below drew label() at W_BOLD - the proportional
    # face at bold weight. `.strow .w` is `font-family: var(--mono)` with no
    # font-weight, so it inherits regular (proto:472). Every other mono run in
    # this rail - the register numbers, the row figures, the caption fraction,
    # the date, the build line - goes through text_aa and cell_w(); these three
    # words were the exception, and the exception was not deliberate.
    #
    # The word first, measured, then the dot placed against its left edge - one
    # origin, so the dot cannot drift when "UP" becomes "DOWN".
    # ...AT THE MONO ORIGIN, not the caption's. Moving the word from label() to
    # text_aa was right and reusing `ty` with it was not: the two faces are
    # different heights, so the word sat low against the key beside it. The
    # vertical centre has to be computed from the face that is actually drawn.
    ww = wlen * cell_w()
    wx = rw - pad_d() - ww
    wy2 = sy + (RAIL_STROW_H * u - cell_h()) / 2
    text_aa(wx, wy2, word, wordc)
    dw = RAIL_DOT * u
    dy = sy + (RAIL_STROW_H * u - dw) / 2
    fill_rgb(wx - RAIL_DOT_GAP * u - dw, dy, dw, dw, dotc)
    return sy + RAIL_STROW_H * u
}

# THE STAT BLOCK'S ORIGIN, published so the tick can damage exactly what the
# draw paints. It was computed inline, which is why the block had no
# invalidation of its own: asking for it back meant copying the expression.
fn rail_stat_y() { return px_h() - rail_bot_h() + RULE_H * ui() + RAIL_SECT_H * ui() + row_h() + RULE_H * ui() }

# NET / VOL / PWR REFRESH ON THEIR OWN CADENCE NOW.
#
# draw_rail_stat samples net_link(), the speaker gate and panel_on() at paint
# time, and nothing claimed damage when any of those changed. The only
# once-a-second invalidation of this block sat inside the APP_MONITOR arm of
# app_tick - so the carrier state, the mute state and the panel state were live
# only while the System Monitor window happened to be open, and stale the rest
# of the time. That is precisely the failure rail_clock_tick's own comment
# describes and avoids for the clock, three rows below in the same rail.
#
# Guarded on its own second, so it costs one comparison per frame and one
# damage of a 170-wide block per second regardless of what is open.
rail_stat_sec = 0 - 1

fn rail_stat_tick() {
    rsec = idiv(ticks(), 100)
    if rsec == rail_stat_sec { return 0 }
    rail_stat_sec = rsec
    if px_w() < 1 { return 0 }
    desk_wakes = desk_wakes + 1  wake_win_c = wake_win_c + 1
    wm_damage(0, rail_stat_y(), rail_w(), RAIL_STAT_H * ui())
    return 1
}

fn draw_rail_stat() {
    u = ui()
    rw = rail_w()
    sy = rail_stat_y()
    fill_rgb(0, sy, rw, RAIL_STAT_H * u, theme(TH_PANEL_HI))
    # rail edges back on - see draw_rail_win for why every live block owes this
    fill_rgb(0, sy, 1, RAIL_STAT_H * u, theme(TH_LIT))
    fill_rgb(rw - 1, sy, 1, RAIL_STAT_H * u, theme(TH_CUT))
    ry = sy + 3 * u
    # NET - netdev_link_up(), which is the ONE call the whole net stack answers
    # "is there a link" with. It dispatches to whichever of e1000 / virtio-net /
    # CDC-ECM was selected and returns 0 when none was, so an absent card and a
    # cabled-but-down card both read DOWN, which is true of both.
    if net_link() == 1 {
        ry = rail_st_word(ry, "NET", "UP", 2, theme(TH_OK), theme(TH_OK))
    } else {
        ry = rail_st_word(ry, "NET", "DOWN", 4, theme(TH_DANGER), theme(TH_TEXT_HI))
    }
    # VOL - the PC speaker gate, read off port 0x61 bits 0 and 1, which is
    # literally the only audio output this machine has. speaker_on() sets them
    # and speaker_off() clears them (arch/x86/support.c), so this changes when a
    # beep plays and is a reading rather than a caption. There is no mixer and
    # no level to show: MUTE and ON are the two states that exist.
    if band(inb(0x61), 3) == 3 {
        ry = rail_st_word(ry, "VOL", "ON", 2, theme(TH_OK), theme(TH_OK))
    } else {
        ry = rail_st_word(ry, "VOL", "MUTE", 4, theme(TH_WARN), theme(TH_WARN))
    }
    # PWR - the panel power sequencer's PP_STATUS "panel on" bit, through
    # intel_panel_on(), which guards on intel_present() and costs one MMIO read.
    # This is the real power domain the prototype's own PWR row sits beside in
    # 13 REGISTERS (PP_STATUS "panel on, backlight on", PWR_WELL_CTL2 "wells 1
    # and 2 enabled"). On anything that is not an Intel display - QEMU, BGA,
    # virtio-gpu - it is 0, which is why the reference render shows PWR WARN:
    # the sequencer is not driving this panel, and nothing here knows the power
    # state of a panel it does not own. Saying WARN is the honest reading;
    # saying OK would be this file inventing a fact about hardware.
    if panel_on() == 1 {
        ry = rail_st_word(ry, "PWR", "OK", 2, theme(TH_OK), theme(TH_OK))
    } else {
        ry = rail_st_word(ry, "PWR", "WARN", 4, theme(TH_WARN), theme(TH_WARN))
    }
    return 0
}

# ---- the rail's clock --------------------------------------------------------
# THE MONTH, as one of twelve literals, because zl's kernel subset has no way
# to build a string and label() takes a literal. Lowercase to match the
# prototype's `26 aug 2026`, and three letters because the date line shares the
# rail's 170 dp with nothing to spare: `dd mon yyyy` is 11 mono cells, 88 px at
# ui 1, against 150 px of usable width.
fn rail_mon(m) {
    if m == 1  { return "jan" }
    if m == 2  { return "feb" }
    if m == 3  { return "mar" }
    if m == 4  { return "apr" }
    if m == 5  { return "may" }
    if m == 6  { return "jun" }
    if m == 7  { return "jul" }
    if m == 8  { return "aug" }
    if m == 9  { return "sep" }
    if m == 10 { return "oct" }
    if m == 11 { return "nov" }
    if m == 12 { return "dec" }
    return "---"
}

# THE DATE LINE, under the clock, replacing the word "presswork". A build name
# printed in the same slot as a reading is the exact shape this file objects to
# elsewhere: it never changes, so the eye stops reading that line, and the line
# under a clock is where a date belongs.
#
# IT IS GATED ON rtc_valid() AND SAYS SO WHEN THE READ FAILED. rtc.c only
# publishes a date when two consecutive CMOS reads agreed and every field
# passed its range check; l_year and friends are file-static and stay 0
# otherwise. Drawing "00 --- 0000" as though it were a date is worse than
# saying the clock has no source, so the failed case prints what is actually
# wrong instead.
fn draw_rail_date(dx, dy) {
    col = theme(TH_TEXT_DIM)
    if rtc_here() == 0 { text_aa(dx, dy, "no rtc", col)  return 0 }
    if rtc_ok() == 0   { text_aa(dx, dy, "rtc unread", col)  return 0 }
    if rtc_d() < 10 {
        num_aa(dx, dy, 0, col)
        num_aa(dx + cell_w(), dy, rtc_d(), col)
    } else {
        num_aa(dx, dy, rtc_d(), col)
    }
    text_aa(dx + 3 * cell_w(), dy, rail_mon(rtc_mo()), col)
    num_aa(dx + 7 * cell_w(), dy, rtc_y(), col)
    return 0
}

# HH:MM WITH NO SOURCE - the same five cells, filled with rules instead of
# digits. It exists because the first version of this block did not have it, and
# the result was a 24 dp "00:00" in ZD_TEXT_0 sitting directly on top of a line
# reading "rtc unread": the largest, brightest thing in the rail confidently
# stating a time, contradicted in six point underneath it. A readout with no
# source has to LOOK like one. The cells are draw_hhmm's own - two, a half for
# the colon, two - so the two forms occupy exactly the same box and the block
# does not reflow when a chip starts or stops answering.
fn draw_hhmm_none(cx, cy, cell, role, col) {
    label(cx, cy, "-", col, role, W_REG)
    label(cx + cell, cy, "-", col, role, W_REG)
    label(cx + cell * 2, cy, ":", col, role, W_REG)
    label(cx + cell * 2 + cell / 2, cy, "-", col, role, W_REG)
    label(cx + cell * 3 + cell / 2, cy, "-", col, role, W_REG)
    return 0
}

fn draw_rail_clock() {
    u = ui()
    rw = rail_w()
    cy = px_h() - RAIL_CLOCK_H * u
    fill_rgb(0, cy, rw, RAIL_CLOCK_H * u, theme(TH_PANEL_HI))
    # rail edges back on - see draw_rail_win for why every live block owes this
    fill_rgb(0, cy, 1, RAIL_CLOCK_H * u, theme(TH_LIT))
    fill_rgb(rw - 1, cy, 1, RAIL_CLOCK_H * u, theme(TH_CUT))
    # ...and it is rtc_ok() that decides, not rtc_here(): a chip that answers
    # its port but whose two reads never agreed has published nothing, and
    # rtc_valid() is the only flag that distinguishes "l_hour is a time" from
    # "l_hour is still its zero initialiser".
    if rtc_ok() == 1 {
        draw_hhmm(pad_d(), cy + 5 * u, CLOCK_CELL_LG * u, T_TITLE, theme(TH_TEXT_HI))
    } else {
        draw_hhmm_none(pad_d(), cy + 5 * u, CLOCK_CELL_LG * u, T_TITLE, theme(TH_TEXT_DIM))
    }
    draw_rail_date(pad_d(), cy + 5 * u + 24 * u)
    return 0
}

# ---- WHY THE CLOCK READ 00:00, AND WHERE THE READ NOW HAPPENS ----------------
# NOT A MISSING DRIVER AND NOT A MISSING BINDING. arch/x86/rtc.c is complete and
# has a host suite of its own; runtime_kernel.c binds all eleven of its entry
# points. rtc_hour() and rtc_min(), which draw_hhmm calls, return the file-local
# l_hour / l_min - and those are ONLY ever written by rtc_read(). Nothing on the
# desktop path ever called it. Grepped rather than assumed: the whole tree's
# calls to rtc_read() are the `date` command's zl arm, net/entropy.c seeding a
# PRNG, and rtctest.c. So the CMOS was never sampled while the compositor ran,
# the statics stayed at their zero initialiser, and the rail printed a
# perfectly-formatted midnight for ever.
#
# THAT IS THE WHOLE BUG and it is one call, but it does not belong in the paint
# path. draw_rail_clock runs on every damage rectangle that touches the rail -
# many times a second while a window is dragged - and rtc_read() spins on the
# CMOS update-in-progress flag and then reads all seven registers TWICE and
# compares them. Sampling a chip that ticks once a second at sixty hertz is
# sixty times the port traffic for the same answer.
#
# SO IT IS A TICK, and it is deliberately NOT hung off the Monitor app's
# once-a-second block a few hundred lines down. That block only runs while
# APP_MONITOR has a window: close Monitor and the slug's uptime already stops,
# and hanging the clock there would make the time stop with it. app_tick runs
# once per open window per frame, so the seconds guard here is what makes the
# read once per SECOND rather than once per window - the same shape raster_tick
# uses against wm_painted(), and for the same reason.
#
# IT ASKS FOR THE CLOCK BACK ONLY WHEN THE MINUTE CHANGES. The rail shows HH:MM
# and a date, so fifty-nine of every sixty reads change nothing on screen, and a
# damage rectangle for an unchanged readout is a repaint that buys nothing. The
# rectangle is the WHOLE clock block rather than a hand-counted strip inside it,
# which is this file's standing rule after the `)08` debris: a number that
# SHRINKS leaves the head of its previous value behind when the invalidated
# rectangle is narrower than the value that was there.
# AND IT GIVES UP AFTER THREE CONSECUTIVE FAILURES, which is the one part of
# this that is a hazard rather than a convenience. rtc_read() spins on the
# update-in-progress flag for UIP_SPINS - 100 000 iterations, two port accesses
# each - and RETURNS ZERO when it never clears. On a chip that is wedged that
# way, an unguarded once-a-second read is a spin of that length inside the frame
# loop every second for the life of the machine: a dropped frame per second, for
# ever, on hardware whose only symptom is that it cannot tell the time. Three
# strikes and this stops asking. The date line already prints what happened, so
# a reader is told rather than left with a clock that silently stopped, and the
# `date` command still reads the chip directly when a person asks it to.
RTC_GIVE_UP = 3

rtc_sec_seen = 0 - 1               # the ticks()/100 the last CMOS read came from
rtc_min_seen = 0 - 1               # h*60+mi the clock block was last drawn for
rtc_fails = 0                      # consecutive failed reads, latched at RTC_GIVE_UP

fn rail_clock_tick() {
    if rtc_fails >= RTC_GIVE_UP { return 0 }
    # idiv here is belt-and-braces, not a fix: `/` already truncates in the
    # compiled kernel. See the note on idiv at the top of this file for why an
    # earlier version of this comment claimed otherwise.
    csec = idiv(ticks(), 100)
    if csec == rtc_sec_seen { return 0 }
    rtc_sec_seen = csec
    if rtc_here() == 0 { rtc_fails = RTC_GIVE_UP  return 0 }
    if rtc_up() == 0 { rtc_fails = rtc_fails + 1  return 0 }
    rtc_fails = 0
    cmin = rtc_h() * 60 + rtc_mi()
    if cmin == rtc_min_seen { return 0 }
    rtc_min_seen = cmin
    desk_wakes = desk_wakes + 1  wake_win_c = wake_win_c + 1
    wm_damage(0, px_h() - RAIL_CLOCK_H * ui(), rail_w(), RAIL_CLOCK_H * ui())
    return 1
}

# ---- the whole register band -------------------------------------------------
# Drawn live rather than baked, because every one of the four row states is a
# function of what is open and what has focus.
fn draw_rail_reg() {
    # RUNNING OVER TOTAL, and both terms are the ones the rows below are drawn
    # from: rail_running_n() counts the same rows draw_rail_row marks, and
    # rail_reg_rows() is the same clamped count rail_slot_at hit-tests against.
    # A denominator derived some other way is a denominator that disagrees with
    # the rows on a panel too short to show them all.
    rail_sect(rail_sect_y(), "REGISTER", rail_running_n(), rail_reg_denom())
    ry = rail_reg_y()
    fit = rail_reg_fit()
    rs = 0
    drawn = 0
    while rs < REG_ROWS {
        if drawn < fit {
            run = 0
            foc = 0
            # rus, distinct from draw_rail_row's own parameter name: this
            # file's note on zl scope is that params are frame-scoped while free
            # locals are not. Two distinct names cost nothing and remove the
            # question entirely.
            rus = 0
            if rs < REG_N {
                run = rail_running(rs)
                if run == 1 {
                    rus = rail_slot_us(rail_win(rs))
                    if wm_focus() == rail_win(rs) { foc = 1 }
                }
            }
            hov = 0
            if rail_hover == rs { hov = 1 }
            draw_rail_row(ry + drawn * row_h(), rs + 1, rail_name(rs), rail_icon(rs), rus, run, foc, hov)
            drawn = drawn + 1
        }
        rs = rs + 1
    }
    # ...then the open windows with no fixed row. Same order as rail_slot_at.
    ti = 0
    while ti < wm_n() {
        tw = wm_zat(ti)
        if app_has_slot(wm_app(tw)) == 0 {
            if wm_winws(tw) == cur_ws() {
                if drawn < fit {
                    hov = 0
                    if rail_hover == drawn { hov = 1 }
                    draw_rail_win(ry + drawn * row_h(), drawn + 1, tw, hov)
                    drawn = drawn + 1
                }
            }
        }
        ti = ti + 1
    }
    # the unused tail of the band is the rail's own ground, not a hole
    used = drawn * row_h()
    if used < rail_reg_h() {
        fill_rgb(0, ry + used, rail_w(), rail_reg_h() - used, theme(TH_PANEL_HI))
        fill_rgb(0, ry + used, 1, rail_reg_h() - used, theme(TH_LIT))
        fill_rgb(rail_w() - 1, ry + used, 1, rail_reg_h() - used, theme(TH_CUT))
    }
    return 0
}

# WHICH REGISTER ROW IS UNDER A POINT, or -1. It returns a ROW INDEX in the same
# numbering draw_rail_reg draws in: 0..REG_ROWS-1 are the fixed register, and
# anything past that is the nth window with no fixed row. rail_launch resolves
# it back, so the two never have to agree about anything except the count.
fn rail_slot_at(cx, cy) {
    if cx >= rail_w() { return 0 - 1 }
    if cy < rail_reg_y() { return 0 - 1 }
    ri = idiv(cy - rail_reg_y(), row_h())
    if ri >= rail_reg_fit() { return 0 - 1 }
    if ri >= rail_reg_rows() { return 0 - 1 }
    return ri
}

# HOW MANY ROWS ARE ACTUALLY THERE - the fixed register plus the tail, clamped
# to what fits. One function, called by the draw and by the hit test, because
# two counts is how a click lands on a row that was never drawn.
# THE DENOMINATOR IS ROWS THAT CAN RUN, not rows drawn. The REGISTER caption
# used rail_reg_rows() - REG_N plus the ALL APPS launcher - so it read "n/15"
# while the numerator's own loop stops at REG_N and rail_app(14) returns -1.
# The count was structurally incapable of reaching its own denominator: 15/15
# could never appear however many apps were open. The prototype's #regcount is
# `runc + '/' + APPS.length`, and APPS.length is the register, not the register
# plus its launcher.
fn rail_reg_denom() { return REG_N }

fn rail_reg_rows() {
    n = REG_ROWS
    ti = 0
    while ti < wm_n() {
        tw = wm_zat(ti)
        if app_has_slot(wm_app(tw)) == 0 {
            if wm_winws(tw) == cur_ws() { n = n + 1 }
        }
        ti = ti + 1
    }
    fit = rail_reg_fit()
    if n > fit { n = fit }
    return n
}

# The window a tail row refers to, or -1. Same walk, same order.
fn rail_tail_win(ri) {
    want = ri - REG_ROWS
    ti = 0
    tn = 0
    while ti < wm_n() {
        tw = wm_zat(ti)
        if app_has_slot(wm_app(tw)) == 0 {
            if wm_winws(tw) == cur_ws() {
                if tn == want { return tw }
                tn = tn + 1
            }
        }
        ti = ti + 1
    }
    return 0 - 1
}

# ---- WHAT THE REGISTER LAUNCHES ---------------------------------------------
# The routing table, kept in one place so the drawing and the click test can
# never drift apart. This is the dock's table with Files added - the boot
# composition opens Terminal, Files and Monitor, and a register whose first
# three rows are not the three windows on screen is a register that does not
# refer to the machine.
# The registry id IS the app id - APP_EDIT is 12 and the manifest's Text Editor
# is entry 12 - so the nine registry apps below are addressed by their manifest
# number directly. app_draw's `id >= REG_FIRST` fall-through already routes them.
fn rail_app(slot) {
    if slot == 0 { return APP_SHELL }
    if slot == 1 { return APP_FILES }
    if slot == 2 { return APP_MONITOR }
    if slot == 3 { return APP_EDIT }
    if slot == 4 { return 40 }        # Kernel Log
    if slot == 5 { return 42 }        # Hex Viewer
    if slot == 6 { return 33 }        # Calculator
    if slot == 7 { return 50 }        # Network
    if slot == 8 { return 31 }        # Clocks & Timers
    if slot == 9 { return APP_SYSPANE }
    if slot == 10 { return APP_SETTINGS }
    if slot == 11 { return 46 }       # Disk Usage
    if slot == 12 { return 32 }       # System Info - the prototype's 13 registers
    if slot == 13 { return APP_TYPEPANE }
    return 0 - 1
}

# WHICH WINDOW A REGISTER ROW OWNS, or -1. The register mark and the focused
# row both need this, and before it existed "is this app running" and "is this
# app focused" were two different walks that could disagree.
fn rail_win(slot) {
    # THIS WAS THE FIFTH TABLE KEYED BY POSITION, AND IT WAS STALE.
    # It listed shell/files/mon/browser/edit/paint/snake/cube/about/settings/run
    # - the slot order from BEFORE the register became the prototype's fourteen.
    # rail_app(3) is APP_EDIT; this returned browser_win. So the browser wore
    # register 04 with the editor's subtitle "fb.c", the editor wore 05 with
    # "dmesg", and slots 11-13 got no label at all because the table stopped at
    # 10. Every window's chrome was captioned by a table nobody had updated.
    #
    # It is not replaced with a corrected table. The comment at rail_cmd's
    # deletion says the defect IS "a table keyed by position, sitting beside
    # four other tables keyed by the same position", and label_windows' own
    # comment records the same class a third time (REG_N vs a hardcoded 12).
    # A sixth copy would just wait to go stale again.
    #
    # So ASK. rail_app already says which app a slot is, and the window manager
    # already knows which window is showing which app. Add a rail row and the
    # labelling follows it with no second edit.
    rw_app = rail_app(slot)
    if rw_app < 0 { return 0 - 1 }
    rw_i = 0
    rw_n = wm_n()
    while rw_i < rw_n {
        rw_w = wm_zat(rw_i)
        if wm_app(rw_w) == rw_app { return rw_w }
        rw_i = rw_i + 1
    }
    return 0 - 1
}

fn rail_running(slot) {
    rwn = rail_win(slot)
    if rwn < 0 { return 0 }
    return wm_open_p(rwn)
}

# rail_cmd() was here: a slot-keyed table mapping 4 -> editor and 5 -> paint.
# Deleted rather than updated. It was the fifth table keyed by register position
# and the only one that was ever wrong, because the other four are read on every
# frame and this one only on a click.

# ---- THE RASTER STRIP --------------------------------------------------------
# Datum's instrument, with graphite's re-clocking kept, and the re-clocking is
# the whole reason it is worth drawing: ONE COLUMN PER COMPOSITE, never one per
# vblank. On an idle machine the compositor does not composite, so the strip
# STANDS STILL - and a still strip is information, where a strip that scrolls at
# 60 Hz whatever the machine is doing is an animated gif of an instrument.
#
# It sits on ZD_CUT, which is the one place a near-Dmax band is correct: this is
# an instrument, not a surface, and the surface ladder does not apply to it. A
# 2 dp ZD_LIT rule runs under it, which is the struck edge of the plate below.
#
# THE RING IS IN RAM, one byte per composite, because the strip is a HISTORY and
# a history has to be stored. One page, in the block declared with the app
# suite's buffers so check-memmap.sh's dupe sweep covers it - see the note there
# for why every fixed address in this tree is declared in kernel.zl.
RASTER_CAP  = 4096                 # bytes in RASTER_RING, one per column
RASTER_PITCH = 3                   # design units per column: 1 of bar, 2 of gap
# THE STORED UNIT IS THE BUDGET, NOT A ROUND NUMBER, and that is the correction
# that made the band mean anything. It was 255 units per 20 000 us - a ceiling
# nothing in this system names, so a column at half height meant "10 ms", which
# is a number you then have to compare against 16 667 in your head. Now
# RASTER_SCALE units IS one wm_budget(): a column at full height is a frame
# that spent its whole presentation deadline, and the word BUDGET with the
# figure is printed at the right-hand end of the same band. 255 still caps it,
# which is now just under two budgets rather than an unrelated 20 ms.
RASTER_SCALE = 128                 # stored units in ONE wm_budget()
# where a column turns. The reference's threshold is 0.85 of the budget, which
# on a 128-unit scale is 108.8 - so this is 108, the nearest whole unit BELOW
# it, because a threshold rounded up marks one band of frames as fine that the
# reference marks as late. 108/128 is 84.4 %, and that is the real figure.
RASTER_WARN  = 108
RASTER_FOOT  = 4                   # dp from the band's floor to the base rule
RASTER_HEAD  = 4                   # dp of clear the tallest column keeps
RASTER_GAP   = 12                  # dp of quiet either side of the plot
RASTER_MIN   = 64                  # columns the plot keeps before the readout goes
RD_GAP       = 11                  # dp between the readout's fields
RD_ADV_CELLS = 7                   # the advance counter's FIXED cell field
raster_head = 0                    # next byte to write
raster_n = 0                       # how many are valid, capped at RASTER_CAP
raster_seen = 0 - 1                # the wm_painted() value the last column came from

# ---- the readout at the right-hand end --------------------------------------
# THE BAND USED TO BE A PLOT WITH NOTHING TO READ IT AGAINST. A histogram with
# no axis and no scale is a texture: it says "something happened" and refuses to
# say how much. The reference prints three readings beside it and each one
# answers a question the columns raise -
#
#   ADVANCE <n> composite   what a column IS, and how many there have been.
#                           wm_painted() is the compositor's own count of frames
#                           that repainted, and it is the same edge raster_tick
#                           clocks on, so the counter and the plot cannot drift.
#   IDLE WAKEUPS/H <n>      what the clocking COSTS, counted. See below.
#   BUDGET 16 667 us        what full height means. wm_budget(), not a literal.
#
# MEASURED, NOT DECORATIVE, with one exception which is called out where it is
# drawn: the zero.
#
# ITS WIDTH IS FIXED so the plot's right edge does not step as the counter grows
# a digit - the same rule the foot's ruler follows for the same reason, and the
# same rule the rail's clock follows. strip_rd_w() and draw_strip_rd() walk the
# identical field list; that pairing is the shape check-shell-layout.py exists
# to police in the rail, and it is hand-checked here because the plot is bounded
# by the sum and drawn by the walk.
#
# MEASURED against the real font, all four panel sizes, ui 1: the readout is
# 487 px, which leaves the plot 549 / 530 / 1170 / 1810 px - that is 183 / 176 /
# 390 / 603 columns at 800x600, 1280x800, 1920x1200 and 2560x1440. 800x600 is
# the one that DROPS the readout: with it shown the plot would keep 50 px, which
# is 16 columns, far under the RASTER_MIN floor - so the band gives the whole
# width to the plot and the readout is not drawn at all.
fn budget_w() {
    # "16 667 us" - thousands, a printer's space, three digits, then the unit
    return s3_numw(idiv(wm_budget(), 1000)) + 7 * cell_w()
}
fn strip_rd_w() {
    cw = cell_w()
    g = RD_GAP * ui()
    w = ui_capsw("ADVANCE", T_CAPTION)
    w = w + g + RD_ADV_CELLS * cw
    w = w + g + 9 * cw                                  # "composite"
    w = w + g + ui_capsw("IDLE WAKEUPS/H", T_CAPTION)
    # THE WAKEUP FIGURE'S WIDTH, which used to reserve one cell for a literal
    # "0". It is a counted rate now and can be four digits on a machine that has
    # been up a short time, so it is measured like every other number on this
    # band. Reserving one cell for a four-digit figure would have pushed BUDGET
    # off the right edge.
    if wake_win_n < 1 { w = w + g + cw } else { w = w + g + s3_numw(wake_rate()) }
    w = w + g + ui_capsw("BUDGET", T_CAPTION)
    w = w + g + budget_w()
    return w
}
# ...and it is DROPPED rather than squeezed when the plot cannot keep RASTER_MIN
# columns beside it. At 800x600 - the BIOS fallback mode, which is a real mode
# this kernel boots in - the readout and the two gutters take nearly the whole
# band, and a sixteen-column histogram is not an instrument. The plot is the
# thing that cannot be printed anywhere else, so the plot wins the measure.
fn strip_rd_on() {
    room = px_w() - pad_d() - strip_rd_w() - RASTER_GAP * ui() - raster_x0()
    if room >= RASTER_MIN * RASTER_PITCH * ui() { return 1 }
    return 0
}
fn raster_x0() {
    return rail_w() + pad_d() + ui_capsw("RASTER", T_CAPTION) + RASTER_GAP * ui()
}
fn raster_x1() {
    if strip_rd_on() == 1 {
        return px_w() - pad_d() - strip_rd_w() - RASTER_GAP * ui()
    }
    return px_w() - pad_d()
}
# Three digits, zero padded, because a budget that prints "16 7 us" is worse
# than no budget. Only ever called with the sub-thousand remainder.
fn num3(nx, ny, v, col) {
    num_aa(nx, ny, idiv(v, 100), col)
    num_aa(nx + cell_w(), ny, idiv(v, 10) - idiv(v, 100) * 10, col)
    num_aa(nx + 2 * cell_w(), ny, v - idiv(v, 10) * 10, col)
    return nx + 3 * cell_w()
}
fn draw_strip_rd(rx, sh) {
    u = ui()
    cw = cell_w()
    g = RD_GAP * u
    ly = (sh - label_h(T_CAPTION)) / 2
    ny = (sh - cell_h()) / 2
    # THE LEGEND IS THE EXCEPTION, NOT THE RULE, and this had it backwards.
    #
    # The RASTER legend at the other end of the band is pinned INLINE in the
    # prototype - `<span class="lbl t-lab" style="color:var(--zd-text-2)">` -
    # which is the document going out of its way to lift that ONE label off the
    # default. .t-lab's own colour is ZD_TEXT_3, and the rule that would lift
    # `#raster .t-lab` to text-2 wholesale is scoped to
    # `:root[data-theme="light"]`, a ladder design.h says zlOS deliberately does
    # not ship.
    #
    # So on the only ladder this kernel has, these three captions are ZD_TEXT_3
    # and the legend is one rung above them on purpose. The old comment reasoned
    # that matching the legend was the consistent choice - but consistency with
    # an explicit exception is how an exception gets erased.
    lab = theme(TH_TEXT_DIM)
    val = theme(TH_TEXT)
    dim = theme(TH_TEXT_DIM)
    ui_caps(rx, ly, "ADVANCE", lab, T_CAPTION)
    rx = rx + ui_capsw("ADVANCE", T_CAPTION) + g
    # LEFT aligned inside a FIXED field, which is the pairing that matters: the
    # field's width never changes, so "composite" and everything right of it
    # cannot shuffle when the machine passes ten thousand; and the number sits
    # against its own label rather than five blank cells away from it, because
    # this is a sentence and not a column of figures. Right-aligning it - which
    # is what the foot's two size figures correctly do - printed "ADVANCE" and
    # then a five-cell hole.
    n = wm_painted()
    num_aa(rx, ny, n, val)
    rx = rx + RD_ADV_CELLS * cw + g
    text_aa(rx, ny, "composite", val)
    rx = rx + 9 * cw + g
    ui_caps(rx, ly, "IDLE WAKEUPS/H", lab, T_CAPTION)
    rx = rx + ui_capsw("IDLE WAKEUPS/H", T_CAPTION) + g
    # THIS WAS THE LITERAL "0", AND THE COMMENT HERE PREDICTED ITS OWN FAILURE.
    #
    # It argued the zero was derived from the mechanism rather than sampled: the
    # strip arms no timer, raster_tick is edge-triggered on wm_painted(), so an
    # idle machine performs no wakeups on the strip's account. Then it said, in
    # as many words, "if the strip ever grows a timer this line becomes a lie".
    #
    # The strip never grew a timer. The DESK did - foot_tick, rail_stat_tick and
    # rail_clock_tick each ask for their block back on a cadence, which is two
    # damages a second and about 7,200 an hour. And until a few lines above this
    # one, raster_tick damaged unconditionally too, so its own repaint forced the
    # composite that triggered the next: the surface printing the zero was the
    # thing making it false.
    #
    # A prediction that came true from a direction nobody was watching is still
    # the prediction being right. So it is counted now rather than reasoned
    # about: desk_wakes is incremented by every desk tick that actually damages,
    # and this is that count over the uptime, per hour. Before the machine has
    # run a second there is nothing to divide by and it says so.
    # A SINCE-BOOT AVERAGE IS NOT AN IDLE RATE, and the first counted version of
    # this was one. desk_wakes counts every desk damage since power-on, busy
    # periods included, so the figure was dominated by the boot burst for the
    # first minutes and by whatever the machine had been doing after that. It
    # printed 45000 a few seconds in - honest arithmetic, wrong question.
    #
    # The label says PER HOUR and means "at the rate it is going now". That is a
    # WINDOW, not an average: the wakes counted in the last minute, scaled. A
    # minute is long enough that the once-a-second ticks dominate the noise and
    # short enough that it follows what the machine is doing.
    if wake_win_n < 1 {
        text_aa(rx, ny, "-", val)
        rx = rx + cw + g
    } else {
        wk = wake_rate()
        num_aa(rx, ny, wk, val)
        rx = rx + s3_numw(wk) + g
    }
    ui_caps(rx, ly, "BUDGET", lab, T_CAPTION)
    rx = rx + ui_capsw("BUDGET", T_CAPTION) + g
    bg = wm_budget()
    hi = idiv(bg, 1000)
    num_aa(rx, ny, hi, dim)
    rx = rx + s3_numw(hi) + cw
    rx = num3(rx, ny, bg - hi * 1000, dim)
    text_aa(rx, ny, " us", dim)
    return 0
}

fn raster_cols() {
    rc = idiv(raster_x1() - raster_x0(), RASTER_PITCH * ui())
    if rc < 1 { rc = 1 }
    if rc > RASTER_CAP { rc = RASTER_CAP }
    return rc
}

# SAMPLE ONE COMPOSITE. Called from app_tick, which runs once per open window
# per frame, so the wm_painted() guard is what makes it once per COMPOSITE
# rather than once per window - the same shape the dock's pulse tick used, and
# for the same reason.
#
# The value stored is the frame's own body time from wm_us(), scaled so that
# ONE wm_budget() fills the band. It is clamped rather than wrapped: an
# instrument that wraps reads as a fast frame when it means a catastrophic one,
# which is a readout that lies in the dangerous direction.
fn raster_tick() {
    rp = wm_painted()
    if rp == raster_seen { return 0 }
    raster_seen = rp
    rv = idiv(wm_us() * RASTER_SCALE, wm_budget())
    if rv > 255 { rv = 255 }
    if rv < 1 { rv = 1 }
    # THE PREVIOUS SAMPLE, read before the ring moves on.
    rprev = 0 - 1
    if raster_n > 0 {
        rpi = raster_head - 1
        if rpi < 0 { rpi = RASTER_CAP - 1 }
        rprev = peek8(RASTER_RING + rpi)
    }
    poke8(RASTER_RING + raster_head, rv)
    raster_head = raster_head + 1
    if raster_head >= RASTER_CAP { raster_head = 0 }
    if raster_n < RASTER_CAP { raster_n = raster_n + 1 }
    # ...and ask for the band back, BUT ONLY WHEN THE COLUMN ACTUALLY CHANGED.
    #
    # This damaged unconditionally, and that made the strip a perpetual motion
    # machine: the damage forces a composite, the composite moves wm_painted(),
    # the next tick sees the change and damages again. The desktop never idled,
    # and the figure printed two inches to the right - "IDLE WAKEUPS/H 0" - was
    # false BECAUSE of the surface printing it. A twelve-line comment above that
    # figure argued the zero was honest on the grounds that "the strip arms no
    # timer"; it does not arm a timer, it arms itself.
    #
    # Skipping the identical column breaks the loop where it starts. On a busy
    # machine the values vary and the plot moves as before. On an idle one they
    # repeat, the damage stops, composites stop, and raster_tick then returns on
    # its first line - so the ring stops advancing too, and the plot stops
    # because there is genuinely nothing to plot. That is the reading the strip
    # is supposed to give.
    if rv == rprev { return 0 }
    desk_wakes = desk_wakes + 1  wake_win_c = wake_win_c + 1
    wm_damage(rail_w(), 0, px_w() - rail_w(), strip_h())
    return 1
}

fn draw_strip() {
    if px_w() > 0 {
        u = ui()
        sx = rail_w()
        sw = px_w() - sx
        sh = strip_h()
        # THE RULE IS THE BAND'S LAST TWO ROWS, not two rows after it. Under
        # border-box `#raster`'s 30dp includes its own border-bottom, so the
        # ZD_CUT ground is 28 and the ZD_LIT rule finishes the band.
        fill_rgb(sx, 0, sw, sh - RULE_H * u, theme(TH_CUT))
        fill_rgb(sx, sh - RULE_H * u, sw, RULE_H * u, theme(TH_LIT))
        # THE PLOT IS BOUNDED BY ITS OWN GUTTERS NOW. It used to run from the
        # right-hand pad all the way to the left-hand pad, which meant the
        # columns ran UNDER the label at one end and under nothing at all at the
        # other, because there was nothing at the other. Both ends now belong to
        # something printed, and the plot is what is left between them.
        x0 = raster_x0()
        x1 = raster_x1()
        base = sh - RASTER_FOOT * u
        top = RASTER_HEAD * u
        if x1 > x0 {
            # THE BASE RULE, and it is the thing that turns a scatter of ticks
            # into a reading. Without it a run of cheap frames is a row of
            # 1 px marks floating in a black band and the eye cannot tell them
            # from dust; with it they are short columns standing on a line.
            # ZD_TEXT_INERT, which is structure and never a glyph - the same
            # rung the reference rules its charts with.
            fill_rgb(x0, base, x1 - x0, 1, theme(TH_SURF_7))
            # the columns, right-aligned so the newest is at the right edge and
            # the history runs backwards into the past - which is the direction
            # every oscilloscope and every load graph has read since there were
            # any.
            cols = raster_cols()
            shown = raster_n
            if shown > cols { shown = cols }
            ci = 0
            while ci < shown {
                idx = raster_head - 1 - ci
                while idx < 0 { idx = idx + RASTER_CAP }
                v = peek8(RASTER_RING + idx)
                bh = idiv(v * (base - top), RASTER_SCALE)
                if bh < 1 { bh = 1 }
                if bh > base - top { bh = base - top }
                # ONE COLUMN CHANGES COLOUR AND ONLY ONE THING MAKES IT: a
                # composite that spent 85 % of the presentation deadline. That
                # is the only state this band reports, and it reports it in the
                # rung the system already uses for drift rather than in the
                # vermilion, because vermilion is the one overprint and it is
                # spent on the framebuffer's datum in the foot.
                col = theme(TH_STEEL)
                if v >= RASTER_WARN { col = theme(TH_WARN) }
                bx = x1 - (ci + 1) * RASTER_PITCH * u
                if bx >= x0 { fill_rgb(bx, base - bh, u, bh, col) }
                ci = ci + 1
            }
        }
        # the label rides OVER the columns at the left, on the strip's own
        # ground, because a legend that the data can draw through is not a
        # legend. Same move the desk's grid legend makes.
        lw = ui_capsw("RASTER", T_CAPTION) + 2 * pad_d()
        # ...AND IT STOPS AT THE RULE. `sh - 2` was the band's height less one
        # row top and bottom, which was right while the ZD_LIT rule lived
        # OUTSIDE the band. Now that the rule is the band's last RULE_H rows,
        # a backdrop of that height paints over its first row - so the rule was
        # 2dp everywhere except under this label, where it was 1.
        #
        # Two pixels under one word: invisible, and found by probe-field
        # reading the column just right of the rail, which is exactly where
        # this backdrop is.
        fill_rgb(sx + 1, 1, lw, sh - RULE_H * u - 1, theme(TH_CUT))
        ui_caps(sx + pad_d(), (sh - label_h(T_CAPTION)) / 2, "RASTER", theme(TH_TEXT_2), T_CAPTION)
        if strip_rd_on() == 1 {
            draw_strip_rd(px_w() - pad_d() - strip_rd_w(), sh)
        }
    } else {
        bar(0, C_TITLE)
        at(0, 2, "zlOS", C_TITLE)
    }
    return 0
}

# ---- THE RULED MODULE GRID ---------------------------------------------------
# PAPER's grid, and its job here is different from PAPER's. PLATE tiles windows
# ONTO the grid, so there the grid IS the arrangement. PRESSWORK floats - wm.c
# is a floating compositor and PRESSWORK did not change that - so the grid
# EXPLAINS where a plate sits rather than deciding it. Twelve by eight modules
# ruled onto the desk in ZD_GRID, 1.6470:1 on ZD_VOID: loud enough to say where
# a window is, quiet enough to be furniture.
#
# THE DIVISION IS INTEGER AND THE REMAINDER IS SPREAD, one pixel each onto the
# first `rem` columns, never dumped on the last one. Dumping it makes the right
# margin stop being a margin, and it is visible: at 2560 wide the remainder is
# several pixels. This is also why the legend prints "106/105" rather than a
# single number - it is a readout from the real division, and two widths IS the
# truthful answer.
fn grid_mar() { return GRID_MARGIN * ui() }
fn grid_gut() { return GRID_GUTTER * ui() }
fn grid_inw() { return field_w() - 2 * grid_mar() }
fn grid_inh() { return field_h() - 2 * grid_mar() }
fn grid_cw()  { return idiv(grid_inw() - grid_gut() * (GRID_COLS - 1), GRID_COLS) }
fn grid_cwr() { return grid_inw() - grid_gut() * (GRID_COLS - 1) - grid_cw() * GRID_COLS }
fn grid_rh()  { return idiv(grid_inh() - grid_gut() * (GRID_ROWS - 1), GRID_ROWS) }
fn grid_rhr() { return grid_inh() - grid_gut() * (GRID_ROWS - 1) - grid_rh() * GRID_ROWS }

# THE DESK GRID HAS STATE NOW. The field menu has always offered "toggle desk
# grid  CTRL G" and there was nothing to toggle - draw_grid ran unconditionally
# and no key reached it. S.cfg.grid is the prototype's equivalent.
desk_grid_on = 1
# THE OTHER THREE THINGS THE PRESS TAB OFFERS TO TURN OFF. Each of these was
# drawn unconditionally, so the prototype's S.cfg.crop / .ruler / .slug had no
# counterpart at all - the tab named six switches and this OS had none of them.
# RE-BAKING THE CACHE IS THREE STEPS, NOT TWO, AND I SHIPPED TWO.
#
# Boot does draw_wallpaper() then draw_rail_static() then wall_save(), and
# fb_wall_save copies WHAT IS CURRENTLY ON SCREEN. draw_wallpaper's first act is
# to fill the entire screen with TH_BG - the rail's columns included - so a
# re-bake that skips draw_rail_static captures bare wallpaper across x <
# rail_w() and the rail's static half is erased from the cache PERMANENTLY. It
# is drawn once at boot and never again; every later frame blits the cache.
#
# So toggling the desk grid destroyed the register rail, which is stated to be
# the only route to every system function. One missing line between a control
# that works and a desktop you cannot navigate.
fn rebake_wallpaper() {
    draw_wallpaper()
    draw_rail_static()
    wall_save()
    return 0
}

desk_crop_on = 1
desk_ruler_on = 1
desk_slug_on = 1
# THE WALLPAPER LEGEND'S OWN SWITCH. It was gated on desk_slug_on, which is the
# Settings row labelled "printer's slug" and belongs to the FOOT band - one
# switch owning two unrelated surfaces, which is the same "one switch, three
# things" fault the grid toggle was rewritten to stop committing. The legend is
# baked into the wallpaper cache, so whatever changes it must re-bake; nothing
# in Settings does yet, which is why this has no row there and defaults on.
desk_legend_on = 1

# THREE SWITCHES, THREE THINGS - the early return made it one switch.
#
# This opened `if desk_grid_on == 0 { return 0 }`, which skipped the crop marks
# and the legend along with the rules. desk_crop_on was declared, toggled and
# announced, and could not change a single pixel: the only code that reads it
# sat behind a return that had already fired. A control that is wired to a flag
# nobody reaches is not a control.
#
# The comment further down this function says exactly that in the abstract -
# "a blanket early return silently removed the crop marks and the legend as
# well" - and then the function did it anyway. Writing the hazard down is not
# the same as not having it.
#
# The rules are gated where the rules are drawn. Crop marks and the legend keep
# their own flags, which is what the prototype does: it toggles crop marks on a
# branch of their own and they survive a grid-off.
fn draw_grid() {
    if desk_grid_on == 0 {
        if desk_crop_on == 1 { draw_crop_marks() }
        if desk_legend_on == 1 { draw_grid_legend() }
        return 0
    }
    # `u = ui()` used to sit here and is gone: the only reader left was the crop
    # block, which now measures its own. -Werror=unused-but-set-variable caught
    # it, which is the guard doing exactly its job on a leftover from a split.
    fx = field_x()
    fy = field_y()
    fw = field_w()
    fh = field_h()
    mar = grid_mar()
    gut = grid_gut()
    if grid_cw() < 1 { return 0 }
    if grid_rh() < 1 { return 0 }
    gcol = theme(TH_GRID)
    # each module is ruled on BOTH edges, which is what makes the gutter read as
    # a gutter rather than as a single line between two modules
    gx = fx + mar
    gi = 0
    while gi < GRID_COLS {
        gw = grid_cw()
        if gi < grid_cwr() { gw = gw + 1 }
        fill_rgb(gx, fy + mar, 1, fh - 2 * mar, gcol)
        fill_rgb(gx + gw - 1, fy + mar, 1, fh - 2 * mar, gcol)
        gx = gx + gw + gut
        gi = gi + 1
    }
    gy = fy + mar
    gi = 0
    while gi < GRID_ROWS {
        gh = grid_rh()
        if gi < grid_rhr() { gh = gh + 1 }
        fill_rgb(fx + mar, gy, fw - 2 * mar, 1, gcol)
        fill_rgb(fx + mar, gy + gh - 1, fw - 2 * mar, 1, gcol)
        gy = gy + gh + gut
        gi = gi + 1
    }
    # CROP MARKS. Overprint job 3, and the only vermilion on the desk. An 18 dp
    # arm offset 7 dp OUTSIDE the margin at each of the four corners, so they
    # mark the trim rather than sitting on the image.
    # GATED AROUND THE MARKS ONLY, NOT AS AN EARLY RETURN. An early return here
    # would take draw_grid_legend() with it - which is precisely the fault an
    # audit found in this function this morning, where the grid's own early
    # return silently removed the crop marks and the legend as well. Writing the
    # same shape one screen below the comment describing it would have been
    # careless twice.
    if desk_crop_on == 1 { draw_crop_marks() }
    if desk_legend_on == 1 { draw_grid_legend() }
    return 0
}

# THE CROP MARKS, LIFTED OUT so that the switch that claims to control them can.
# They were inline in draw_grid behind its early return, which meant desk_crop_on
# was read only on frames where the grid was already being drawn - and never on
# the frames where it mattered. Recomputes its own margin rather than inheriting
# draw_grid's locals, because free locals of the same name collide across frames
# in this language and a silently shared `mar` is the kind of bug that only shows
# up at one screen size.
fn draw_crop_marks() {
    cm_u = ui()
    cm_fx = field_x()
    cm_fy = field_y()
    cm_fw = field_w()
    cm_fh = field_h()
    cm_mar = grid_mar()
    vcol = theme(TH_ACCENT)
    cl = CROP_LEN * cm_u
    co = CROP_OFF * cm_u
    ml = cm_fx + cm_mar
    mr = cm_fx + cm_fw - cm_mar
    mt = cm_fy + cm_mar
    mb = cm_fy + cm_fh - cm_mar
    fill_rgb(ml, mt - co, cl, 1, vcol)
    fill_rgb(ml - co, mt, 1, cl, vcol)
    fill_rgb(mr - cl, mt - co, cl, 1, vcol)
    fill_rgb(mr + co, mt, 1, cl, vcol)
    fill_rgb(ml, mb + co, cl, 1, vcol)
    fill_rgb(ml - co, mb - cl, 1, cl, vcol)
    fill_rgb(mr - cl, mb + co, cl, 1, vcol)
    fill_rgb(mr + co, mb - cl, 1, cl, vcol)
    return 0
}

# THE LEGEND, and it is a READOUT rather than a caption. It prints the module
# AS COMPUTED at this resolution - "MODULE 12 x 8  106/105 x 98/97 px GUTTER 12"
# - which doubles as a live check on where the integer division remainder went.
# If it ever prints a single width, the remainder is zero at that size; if it
# prints two, the split is visible in the rules above it.
#
# A CAPTION PRINTED ON A RULED SHEET CLEARS ITS OWN SPACE. Measured on the
# prototype's rendered pixels: where the legend crossed a grid rule, ZD_TEXT_3
# fell to 4.84:1 on ZD_GRID against 7.98:1 on ZD_VOID. So it carries the desk
# with it - a ZD_VOID plate with 5 dp of padding - and every glyph sits on the
# field. Mono, because the numbers are the content.
fn legend_num(lx, ly, n, col) {
    num_aa(lx, ly, n, col)
    return lx + s3_numw(n)
}
fn draw_grid_legend() {
    u = ui()
    if grid_cw() < 1 { return 0 }
    lh = cell_h()
    ly = field_y() + field_h() - 4 * u - lh
    lx = field_x() + 14 * u
    # measure first, then clear, then draw - the plate has to be as wide as what
    # goes on it and label_w cannot be asked about a number
    lw = 7 * cell_w()                                  # "MODULE "
    lw = lw + s3_numw(GRID_COLS) + 3 * cell_w() + s3_numw(GRID_ROWS) + 2 * cell_w()
    lw = lw + s3_numw(grid_cw() + 1) + cell_w() + s3_numw(grid_cw()) + 3 * cell_w()
    lw = lw + s3_numw(grid_rh() + 1) + cell_w() + s3_numw(grid_rh()) + 4 * cell_w()
    lw = lw + 7 * cell_w() + s3_numw(grid_gut())
    fill_rgb(lx - 5 * u, ly - 2 * u, lw + 10 * u, lh + 4 * u, theme(TH_BG))
    col = theme(TH_TEXT_DIM)
    text_aa(lx, ly, "MODULE ", col)
    lx = lx + 7 * cell_w()
    lx = legend_num(lx, ly, GRID_COLS, col)
    text_aa(lx, ly, " x ", col)
    lx = lx + 3 * cell_w()
    lx = legend_num(lx, ly, GRID_ROWS, col)
    text_aa(lx, ly, "  ", col)
    lx = lx + 2 * cell_w()
    # the two widths, and only when the remainder is non-zero. A legend that
    # always prints "106/106" is not reading anything.
    if grid_cwr() > 0 {
        lx = legend_num(lx, ly, grid_cw() + 1, col)
        text_aa(lx, ly, "/", col)
        lx = lx + cell_w()
    }
    lx = legend_num(lx, ly, grid_cw(), col)
    text_aa(lx, ly, " x ", col)
    lx = lx + 3 * cell_w()
    if grid_rhr() > 0 {
        lx = legend_num(lx, ly, grid_rh() + 1, col)
        text_aa(lx, ly, "/", col)
        lx = lx + cell_w()
    }
    lx = legend_num(lx, ly, grid_rh(), col)
    text_aa(lx, ly, " px  GUTTER ", col)
    lx = lx + 12 * cell_w()
    legend_num(lx, ly, grid_gut(), col)
    return 0
}

# ---- THE FOOT ----------------------------------------------------------------
# Two instruments in one 46 dp band, which is the only reason both fit. The top
# row is Datum's memory map - every region this kernel holds, drawn to scale
# against each other, with the framebuffer marked. The bottom row is PLATE's
# printer's slug: one mono line stating the machine and the grid AS MEASURED.
#
# THE MEMORY MAP IS THIS KERNEL'S OWN, not a picture of one. Every region below
# is a constant this file or memmap.h already declares, or a figure an allocator
# answers for. The segments are surface rungs rather than colours: an
# instrument's regions are read by their order, and a rainbow would make them
# look like categories.
# NAMED RULER_*, not MEM_*, and that is a note to the next reader rather than a
# style choice: check-memmap.sh sweeps this file for `NAME = 0x...` and lists
# everything it cannot size as a fixed address. These are not allocations -
# they are the ends of a READOUT - so they carry a name that says so instead of
# looking like more buffers nobody bounded.
#
# ---- WHY THE BAR IS PACKED BY SIZE AND NOT RULED BY ADDRESS ------------------
# IT USED TO BE ADDRESS-LINEAR AND IT WAS EMPTY. Every region this kernel maps
# lives under 256 MiB; the framebuffer is a PCI aperture and on this machine
# lands at 0xFD000000. A linear ruler between those two ends spends nearly all
# of its width on the hole between RAM and the aperture.
#
# MEASURED off the shipped render, 1920x1200, by counting the scanline through
# the middle of the bar: the bar was 1545 px and the three segments it drew
# covered TWELVE of them. 99.2 % of a memory map was the colour of unmapped
# address space. That is not a quiet instrument, it is an instrument that
# cannot be read - and the segment list could not be fixed by adding regions,
# because every region worth naming was already sub-pixel.
#
# The bar now gives each region a width proportional to its OWN SIZE, laid end
# to end, which is what the reference prototype does - its renderFoot() sums
# MEMMAP's sizes and takes each region's percentage of the sum, and prints the
# address range beside it as a caption. So the bar answers "how much", the
# readout answers "where", and neither pretends to be the other. The one thing
# a packed bar must not do is claim to be a ruler, which is why the readout
# leads with the two real addresses rather than with the sizes.
#
# EVERY REGION IS DISJOINT, which is the property that makes the packing honest.
# Window surfaces come out of heap_alloc - wm.c's client_surface_ensure and
# shell_surface_ensure both call it - so wm_sbytes() is INSIDE heap_used(), and
# it is drawn as a slice of the heap rather than beside it. Drawing both would
# count those megabytes twice and inflate the total under exactly the condition
# - many open windows - where the reading matters most.
RULER_BASE = 0x00100000            # where the kernel image is loaded
# The driver map, drawn AS ONE SPAN and not as its thirteen regions, which is a
# deliberate imprecision and worth naming. memmap.h places png.c's pictures, the
# EDID page, virtio_net's rings, the browser's document store, fb.c's back
# buffer and blur arena, the AP stacks, sched.c, i2c_hid, gpuring, nvme, xhci
# and virtio_gpu between HI_IMG and HI_HEAP, with real holes between several of
# them - so this segment is somewhat WIDER than what is genuinely occupied.
#
# The alternative is restating thirteen C macros in a zl file that cannot
# include the header they live in, which is thirteen constants that go stale
# silently instead of two. This file's own history is the argument: memmap.h's
# header records arena.c carrying a base that disagreed with the map for
# months, and png.c's arena being placed on top of Snake because "64 MiB looked
# free". Two restated ends with a comment saying they are restated is the
# smaller standing risk, and they carry the RULER_ prefix so check-memmap.sh's
# discovery sweep lists them as a readout rather than as two more buffers.
RULER_DMA     = 0x03000000         # memmap.h HI_IMG  - the first driver region

# MIRRORED C CONSTANTS, DECLARED SO A CHECKER CAN SEE THEM.
# zl cannot include a C header, so every one of these is a hand copy - and this
# file has already been burned by exactly that. desk_key compared Escape against
# 27 and F1 against 0x13B; keycodes.h says KEY_ESC is 0x101 and KEY_F1 is 0x120,
# and 0x13B is a Linux keycode from a scheme this kernel does not use. The
# copies were bare literals sitting inside an if, so nothing could check them
# and nothing did. wm.c hit the identical bug from the C side - a hand-copied
# key table with KEY_TAB missing, so Alt+Tab was written against '\t' and never
# fired - and its fix was to delete the copies and include the header. zl has no
# such move available. Naming them in the convention check-memmap-mirror.py
# already reads is the nearest thing: a copy a tool can compare beats a copy
# only a reader can.
KEY_ESC_K  = 0x101                 # keycodes.h KEY_ESC   - from a real keyboard
KEY_F1_K   = 0x120                 # keycodes.h KEY_F1
KEY_SUPER_K = 0x11A                # keycodes.h KEY_SUPER
KEY_ENTER_K = 0x104                # keycodes.h KEY_ENTER
MOD_ALT_K   = 4                    # keycodes.h MOD_ALT
SPARK_MAX  = 64                    # design.h ZD_SPARK_MAX - spark history depth
RULER_DMA_END = 0x10000000         # memmap.h HI_HEAP - the last one's ceiling
# THE READOUT IS SET TO THE MEASURE, exactly as the slug below it is, and for
# the same reason: the full form is sixty mono cells, which at 800x600 - the
# BIOS fallback mode this kernel really boots in - would leave the bar 57 px
# wide, measured against the real font. A 57 px memory map is not a smaller
# memory map, it is no memory map. The 24-cell form leaves 345 px. So
# the readout drops its two size figures first and keeps the address range,
# which is the half a bar cannot state on its own; below that it goes entirely
# and the ruler takes the width.
RULER_RD_FULL = 60                 # address range, then mapped, then free
RULER_RD_ADDR = 24                 # "0x........ .. 0x........" alone
RULER_MIN_BAR = 240                # dp of bar the readout will not shrink past
# The top of the ruler is the END OF THE FRAMEBUFFER, so the readout names the
# real span the map covers rather than a round number. On this machine that is
# roughly 0xFD000000 - the prototype's own readout reads "0x00100000 ..
# 0xC0611000" for the same reason, and for the same reason it is a caption.
fn mem_top() {
    return vram() + fb_pitch() * px_h()   # see ruler_fb for why not w * h * 4
}
fn foot_y() { return px_h() - foot_h() }

# ---- the eight regions, each measured, each disjoint -------------------------
# ONE FUNCTION PER REGION so the sum and the walk cannot disagree: ruler_total()
# adds these up and draw_foot() draws them in the same order, and both call the
# same eight functions rather than restating them. That is the pairing
# check-shell-layout.py polices in the rail, and the reason it is worth copying
# is that the last region takes the bar's REMAINDER - so a walk that drew a
# region the sum did not count would silently eat the free tail instead of
# overflowing, which is the failure mode nobody sees.
fn ruler_lo() {
    # the image and the stacks, which is everything between the load address
    # and the arena. Clamped rather than trusted for the reason ruler_heap() is:
    # arena_base() crosses a file boundary, and a negative width here would be
    # subtracted from the total and then drawn as nothing, so the bar would be
    # quietly wrong in two places at once instead of loudly wrong in one.
    lo = arena_base() - RULER_BASE
    if lo < 0 { lo = 0 }
    return lo
}
fn ruler_ar()   { return arena_used() }                     # the zl program arena
fn ruler_zl()   { return RASTER_RING + 0x1000 - SNAKE_X }   # kernel.zl's own block
fn ruler_dma()  { return RULER_DMA_END - RULER_DMA }        # every driver's region
fn ruler_srf()  { return wm_sbytes() }                      # window surfaces
fn ruler_heap() {
    # the heap MINUS the surfaces already counted above - see the disjointness
    # note in the block comment. Clamped at zero rather than trusted: the two
    # figures come from different files and a negative width would draw a
    # region the length of the bar.
    hr = heap_used() - wm_sbytes()
    if hr < 0 { hr = 0 }
    return hr
}
# THE FRAMEBUFFER'S REAL SPAN, which is pitch times height and not width times
# four. fb.c accepts 24bpp as well as 32 - so the old arithmetic overstated a
# 24bpp mode by a third - and it keeps fb_pitch as its own field from its own
# argument to fb_setup, because firmware pads scanlines for alignment. fb.c
# computes the mapped span as pitch * height itself, three lines from where it
# stores both.
fn ruler_fb()   { return fb_pitch() * px_h() }              # the framebuffer
fn ruler_free() { return arena_free() + heap_free() }       # headroom in both
fn ruler_mapped() {
    return ruler_lo() + ruler_ar() + ruler_zl() + ruler_dma() + ruler_srf() + ruler_heap() + ruler_fb()
}
fn ruler_total() { return ruler_mapped() + ruler_free() }

# One packed region. Returns the x the NEXT region starts at, so the walk is a
# chain and no region can be placed from a stale accumulator.
#
# THE DIVISION IS DONE IN KIBIBYTES, not bytes, for the reason foot_at's comment
# gave: a 200 MiB region times a 1600 px bar is 3.4e11, which zl's doubles hold
# and an integer backend would not. Dividing by 1024 first keeps the arithmetic
# inside 32 bits without changing a single drawn pixel at any bar width this
# shell can have.
fn ruler_seg(rx, ry, rh, bw, bytes, total, col, xend) {
    if bytes < 1 { return rx }
    sw = idiv(idiv(bytes, 1024) * bw, idiv(total, 1024))
    # a region that exists gets at least one pixel. The app-suite block is
    # 2.1 MiB against a total near 300 MiB, which rounds to nothing; a map that
    # silently omits its smallest region is the failure this whole rewrite is
    # about, one order of magnitude down.
    if sw < 1 { sw = 1 }
    if rx + sw > xend { sw = xend - rx }
    if sw < 1 { return rx }
    fill_rgb(rx, ry, sw, rh, col)
    # NOT WHEN THE REGION IS THE SEPARATOR. The clamp above guarantees a region
    # that exists gets at least one pixel; this line then painted ZD_CUT at
    # rx + sw - 1, which at sw == 1 is rx itself. So the smallest regions - the
    # ones the clamp was written to preserve - were overwritten by their own
    # groove and rendered as the groove colour, indistinguishable from the gaps
    # between regions. The clamp saved the pixel and the next line spent it.
    if sw > 1 { fill_rgb(rx + sw - 1, ry, 1, rh, theme(TH_CUT)) }
    return rx + sw
}

# NNN.N MiB, right-aligned on its DECIMAL POINT rather than on either end. The
# point is at mx and never moves, which is what stops the two figures jittering
# against their units as the heap grows - the same rule the clock's fixed cells
# follow. One decimal because the prototype prints one, and because whole
# mebibytes would report every surface allocation this desktop makes as "0".
fn mib1(mx, my, bytes, col) {
    wh = idiv(bytes, 1048576)
    fr = idiv((bytes - wh * 1048576) * 10, 1048576)
    num_aa(mx - s3_numw(wh), my, wh, col)
    text_aa(mx, my, ".", col)
    num_aa(mx + cell_w(), my, fr, col)
    return 0
}

# THE FOOT'S READINGS MOVE, SO THE FOOT HAS TO BE ASKED FOR BACK.
#
# draw_foot paints the memory ruler and the printer's slug, and four of the
# ruler's regions come from the two allocators - they move every time a window
# opens or a file is written. But nothing damaged the band on a cadence, so the
# readings only refreshed when something else happened to dirty that rectangle,
# which in practice meant "while System Monitor is open".
#
# A comment on draw_foot_ruler claimed it was "called from draw_clock too, which
# is the once-a-second pass the slug already uses". draw_clock's only call site
# is inside the TEXT-MODE loop, and the lines above that loop set running = 0 in
# graphics mode - the comment directly above it says "TEXT MODE, and only text
# mode. No framebuffer, so no compositor." So the once-a-second pass it cited
# does not run on any machine that has a screen. The citation was to a real
# function on an unreachable path, which reads exactly like a live one.
#
# One second, one damage, and only when the second actually rolled - same shape
# as rail_clock_tick beside it.
# EVERY DESK-TICK DAMAGE IS COUNTED, because the strip prints the rate - over a
# ROLLING MINUTE, not since boot. desk_wakes is the running total; wake_win_*
# hold the closed minute the readout actually reports, so the figure follows the
# machine instead of being dragged around by the boot burst for ever.
desk_wakes  = 0
wake_win_n  = 0                    # wakes counted in the last CLOSED minute
wake_win_c  = 0                    # ...and in the minute now filling
wake_win_m  = 0 - 1                # which minute that is

fn wake_tick() {
    wkm = idiv(ticks(), 6000)
    if wkm == wake_win_m { return 0 }
    if wake_win_m >= 0 { wake_win_n = wake_win_c }
    wake_win_m = wkm
    wake_win_c = 0
    return 0
}

# Wakes per hour, from the last closed minute. Sixty of them make an hour.
fn wake_rate() { return wake_win_n * 60 }

# IS THE COMPOSITOR ACTUALLY PAINTING? The System Monitor's swatch asked
# wm_run(), which is written in exactly two places - `running = 1` in wm_init
# and `running = 0` in wm_stop - so it is 1 for the entire life of every pane
# that can display it. The swatch had one state and a two-state legend.
#
# What "RUN" should mean on a sampler is that samples are arriving. That is
# whether wm_painted() moved since the last second, which is a real edge and
# the same one raster_tick clocks on.
sm_run_seen = 0 - 1
sm_run_sec  = 0 - 1
sm_run_live = 0

fn sm_run_tick() {
    smsec = idiv(ticks(), 100)
    if smsec == sm_run_sec { return 0 }
    sm_run_sec = smsec
    smp = wm_painted()
    if smp == sm_run_seen { sm_run_live = 0 } else { sm_run_live = 1 }
    sm_run_seen = smp
    return 0
}

foot_sec_seen = 0 - 1

fn foot_tick() {
    fsec = idiv(ticks(), 100)   # `/` would do; see the idiv note at the top
    if fsec == foot_sec_seen { return 0 }
    foot_sec_seen = fsec
    if px_w() < 1 { return 0 }
    desk_wakes = desk_wakes + 1  wake_win_c = wake_win_c + 1
    wm_damage(rail_w(), foot_y(), px_w() - rail_w(), foot_h())
    return 1
}

fn draw_foot() {
    u = ui()
    fx = rail_w()
    fw = px_w() - fx
    fy = foot_y()
    fh = foot_h()
    # THE FOOT'S RULE IS ITS FIRST TWO ROWS, not two rows above it - the same
    # border-box reading as the strip's, at the other end of the screen.
    #
    # GROUND FIRST, THEN THE RULE. Moving the rule inside the band put it under
    # the band's own fill: `fill_rgb(fx, fy, fw, fh, PANEL_HI)` starts at the
    # same y and covers it completely, so the foot lost its rule entirely for
    # one build. It survived before only because it was drawn ABOVE the fill's
    # first row. probe-field caught it by scanning up from the bottom and
    # finding no ZD_LIT anywhere in the foot.
    fill_rgb(fx, fy, fw, fh, theme(TH_PANEL_HI))
    fill_rgb(fx, fy, fw, RULE_H * u, theme(TH_LIT))
    if desk_ruler_on == 1 { draw_foot_ruler() }
    # ---- row 2: the printer's slug
    sy = fy + fh - band_h()
    # THE HAIRLINE IS THE SLUG ROW'S OWN BORDER, not an independent element.
    # In the prototype it is `#slugrow { border-top: 1px solid var(--zd-cut) }`
    # and `body.noslug #slugrow { display: none }` takes the rule away with the
    # text. Drawn outside the gate, switching the slug off left a full-width
    # ZD_CUT rule ruling off a band of nothing.
    if desk_slug_on == 1 {
        fill_rgb(fx + pad_d(), sy - 2 * u, fw - 2 * pad_d(), 1, theme(TH_CUT))
        draw_slug(fx + pad_d(), sy + 2 * u)
    }
    return 0
}

# ---- row 1: the memory ruler ------------------------------------------------
# SPLIT OUT OF draw_foot BECAUSE IT IS NOW LIVE. The old row 1 read vram(), a
# pointer that is fixed for the life of the boot, so painting it once with the
# rest of the foot cost nothing. Four of the eight regions below come from the
# two allocators and move every time a window opens, and draw_foot only runs on
# boot and at a command transition - so left where it was, this bar would sit
# showing the heap as it stood when the shell last printed a prompt. It is
# called from draw_clock too, which is the once-a-second pass the slug already
# uses, and a memory map is exactly a once-a-second reading.
#
# It clears its own band first, for the reason the slug's own redraw does: a
# figure that shrinks a digit leaves the old digit's tail behind otherwise.
fn draw_foot_ruler() {
    u = ui()
    fx = rail_w()
    fw = px_w() - fx
    fy = foot_y()
    # THE RULER'S BAND STARTS AFTER THE FOOT'S BORDER, not at its top edge.
    #
    # `ry - 3 * u` is `fy`, so this clear began on the foot's first row - and
    # once the ZD_LIT rule moved INSIDE the band (border-box, proto:560-562) it
    # wiped that rule out on every once-a-second redraw. draw_foot got the rule
    # right and this function took it away again, which is why probe-field
    # scanning up from the bottom found no ZD_LIT anywhere in the foot.
    #
    # Under border-box the content belongs inside the border, so the band and
    # its label both move down by RULE_H and the band loses that much height -
    # the foot's total is unchanged, which is the whole point of border-box.
    ry = fy + RULE_H * u + 3 * u
    fill_rgb(fx + 1, fy + RULE_H * u, fw - 2, foot_h() - band_h() - 3 * u - RULE_H * u, theme(TH_PANEL_HI))
    ui_caps(fx + pad_d(), ry + 2 * u, "MEMORY", theme(TH_TEXT_DIM), T_CAPTION)
    bx = fx + pad_d() + ui_capsw("MEMORY", T_CAPTION) + 9 * u
    # the readout is right-aligned and fixed-width, so the bar's right edge does
    # not move as the numbers change - the same fixed-cell rule as the clock
    cw = cell_w()
    rdc = ruler_rd_cells()
    rdw = rdc * cw
    bw = fw - (bx - fx) - pad_d() - rdw - 9 * u
    bh = 11 * u
    tot = ruler_total()
    if bw > 0 and tot > 0 {
        fill_rgb(bx, ry, bw, bh, theme(TH_SURF_WELL))
        fill_rgb(bx, ry, bw, 1, theme(TH_CUT))
        fill_rgb(bx, ry + bh - 1, bw, 1, theme(TH_CUT))
        fill_rgb(bx, ry, 1, bh, theme(TH_CUT))
        fill_rgb(bx + bw - 1, ry, 1, bh, theme(TH_CUT))
        # inside the ring, so no region draws over the well's own edge
        sy1 = ry + 1
        sh1 = bh - 2
        iw = bw - 2
        xe = bx + bw - 1
        sx1 = bx + 1
        # THE WALK, in the order a printed map is read: the image, then what the
        # kernel hands out, then what the drivers hold, then the heap, then the
        # framebuffer, then what is left.
        #
        # THREE INKS AND EACH ONE MEANS SOMETHING. ZD_TEXT_INERT is STRUCTURE -
        # memory nobody allocates and nobody frees, fixed at link time; ZD_STEEL
        # is the machine's own reading, so it carries the two allocators, whose
        # figures change while you watch; ZD_WARN carries the driver map because
        # that region is a different KIND of memory - device-visible, uncached,
        # written by hardware - and not because anything is wrong with it. The
        # vermilion is spent once, on the framebuffer, which is the address this
        # whole project is about.
        #
        # AND THE WALK BELOW USED TO DRAW FIVE. The window-surface slice took
        # ZD_STEEL_BR - a fifth ink, against a comment enumerating three plus
        # the overprint, and against a prototype whose #rulerbar has no such
        # value. The slice is an allocator's, like the arena and the heap, so it
        # takes the allocator's ink; it stays distinguishable by the 1px ZD_CUT
        # divider ruler_seg already draws between regions, which is exactly what
        # `#rulerbar span { border-right: 1px solid }` does in the reference.
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_lo(), tot, theme(TH_SURF_7), xe)
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_ar(), tot, theme(TH_STEEL), xe)
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_zl(), tot, theme(TH_SURF_7), xe)
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_dma(), tot, theme(TH_WARN), xe)
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_heap(), tot, theme(TH_STEEL), xe)
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_srf(), tot, theme(TH_STEEL), xe)
        # THE DATUM MARK. Overprint job 4: one vermilion hairline where the
        # framebuffer starts, because that address is what this whole project is
        # about. It overshoots the bar top and bottom so it reads as a tick
        # against a scale rather than as a boundary between two regions - which
        # is what the prototype's own <u> element does, and it has to, because
        # the region it marks is vermilion too.
        dx = sx1
        sx1 = ruler_seg(sx1, sy1, sh1, iw, ruler_fb(), tot, theme(TH_ACCENT), xe)
        if sx1 > dx { fill_rgb(dx, ry - 3 * u, 1, bh + 6 * u, theme(TH_ACCENT)) }
        # ...and the free tail takes the REMAINDER rather than its own share, so
        # the bar always ends flush against its ring. Seven roundings-up of one
        # pixel each would otherwise leave the last region short by seven, and a
        # ruler with a gap at the end reads as a drawing fault.
        if xe > sx1 { fill_rgb(sx1, sy1, xe - sx1, sh1, theme(TH_SURF_WELL)) }
        # ---- the readout. Sixty mono cells, laid out on fixed columns:
        #   0    "0x" + eight hex          the base of the map
        #   10   " .. "
        #   14   "0x" + eight hex          the end of the framebuffer
        #   26   NNN.N                     point at column 30
        #   32   " MiB mapped"
        #   45   NNN.N                     point at column 49
        #   51   " MiB free"               ends at column 60
        # The addresses and the figures take ZD_STEEL because they are readings;
        # the words between them take the caption rung, because they are not.
        rx = fx + fw - pad_d() - rdw
        dim = theme(TH_TEXT_DIM)
        # #rulerrd IS ONE SPAN AND IT IS ink3. The prototype's readout is
    # `<span class="t-num ink3" id="rulerrd">` and .ink3 is ZD_TEXT_3 - there is
    # no steel anywhere in it. This painted the two addresses and both MiB
    # figures in ZD_STEEL while only the connecting words took ZD_TEXT_3, so the
    # numbers read as instrument output and the words as caption, in a readout
    # the authority draws in one ink throughout.
    #
    # ZD_STEEL is INSTRUMENTS ONLY by its own comment in this file. A figure
    # being numeric does not make its surface an instrument.
    stl = theme(TH_TEXT_DIM)
        if rdc > 0 {
            text_aa(rx, ry, "0x", dim)
            hexat(rx + 2 * cw, ry, RULER_BASE, stl)
            text_aa(rx + 10 * cw, ry, " .. 0x", dim)
            hexat(rx + 16 * cw, ry, mem_top(), stl)
        }
        if rdc >= RULER_RD_FULL {
            mib1(rx + 30 * cw, ry, ruler_mapped(), stl)
            text_aa(rx + 32 * cw, ry, " MiB mapped", dim)
            mib1(rx + 49 * cw, ry, ruler_free(), stl)
            text_aa(rx + 51 * cw, ry, " MiB free", dim)
        }
    }
    return 0
}

# The measure the readout is set to. Both branches subtract the SAME leading
# terms draw_foot_ruler does - the label, the two 9 dp gaps and the two pads -
# so the two cannot disagree about where the bar starts; only the trailing
# width is decided here.
fn ruler_rd_cells() {
    room = px_w() - rail_w() - 2 * pad_d() - ui_capsw("MEMORY", T_CAPTION) - 18 * ui()
    if room - RULER_RD_FULL * cell_w() >= RULER_MIN_BAR * ui() { return RULER_RD_FULL }
    if room - RULER_RD_ADDR * cell_w() >= RULER_MIN_BAR * ui() { return RULER_RD_ADDR }
    return 0
}

# foot_at and foot_seg were here. They mapped an ADDRESS onto the bar, which is
# the operation the packed ruler above does not perform - see the block comment
# for why it stopped performing it. Deleted rather than left dead: a helper that
# still compiles is a helper the next person wires back in.

# A hex address, drawn digit by digit because there is no string to build.
# hex() prints to the console; this puts one on the framebuffer.
fn hexat(hx, hy, v, col) {
    hi = 7
    while hi >= 0 {
        hd = band(shr(v, hi * 4), 15)
        char_aa(hx + (7 - hi) * cell_w(), hy, hexchar(hd), col)
        hi = hi - 1
    }
    return 0
}
fn hexchar(d) {
    if d < 10 { return 48 + d }
    return 87 + d
}

# THE PRINTER'S SLUG. One mono line that states the machine and the grid as
# measured. It is the same reading the desk's legend carries, in the place a
# printed sheet puts it, and having it twice is deliberate: the legend belongs
# to the desk and disappears under a maximised window, the slug belongs to the
# machine and does not.
#
# ---- IT IS SET TO A MEASURE, and that is the whole reason it can grow --------
# The reference's slug is about 150 characters. At 1920 there is room for four
# hundred; at 800x600 - the BIOS fallback, which this kernel really boots in -
# the foot is 632 px, which is 79 mono cells, and a fixed 150-character line
# would run off the right-hand end of the plate and print on the desk. So every
# field measures itself against `se` before it is drawn, and the line simply
# STOPS at the last field that fits. That makes the field ORDER the priority
# order, which is why it reads machine, panel, cores, module, gutter, uptime,
# clock: what the sheet is of, then what it is, then how it is ruled.
#
# WHAT THE REFERENCE PRINTS THAT THIS DOES NOT, and why - because a slug that
# invents a figure is worse than a short one:
#
#   LOAD 0.58      there is no load average in this kernel. It needs a run-queue
#                  sample history and sched.c keeps none; the reference computes
#                  it from its own two fake CPU meters.
#
# MIN STEP AND KNOCK USED TO BE ON THAT LIST, and the reason given was wrong in
# every clause: "computing one needs pow(x, 2.4) on a linearised channel, and
# there are no floats in this drawing path". ui_ratio is a bound native that
# returns WCAG contrast as an INTEGER times 10^4, the system pane already
# recomputes fourteen rows with it, and draw_slug prints both from
# slug_minstep() and slug_knock() a few lines below this comment.
#
# The entry is kept rather than deleted because the shape of the mistake is
# worth more than the space: this is the inverse of the fault the list exists to
# prevent. Not a figure written where one could be read - a reading REFUSED
# where one was available, with a technical-sounding reason, which is the more
# durable of the two because a stated "cannot" is never revisited. It sat here
# unchallenged while the measurement it called impossible ran on every frame
# twelve hundred pixels away.
#
# SKEW is still absent, and for a real reason: it is a ratio between the two
# above, and printing a third figure derived from two already on the slug adds
# a number without adding a reading.
#
# What was ADDED is measured: smp_total() is the count of processors that came
# up, the module's two pixel widths are the real integer division and its
# remainder (which is why they print as "133/132" and not as one number), and
# the clock is the RTC, drawn only when rtc_ok() says there is one.
#
# FRAME <us> was REMOVED. It is the same wm_us() the raster strip now plots as a
# histogram twenty pixels above it and the rail prints in its stat block, and
# one instantaneous sample beside a plot of the last five hundred is the reading
# the plot exists to replace.
fn slug_fit(sx, se, w) {
    if sx + w <= se { return 1 }
    return 0
}
# One zero-padded two-digit field. Both branches advance by exactly two cells,
# which is the bug draw_hhmm's own comment records having made the other way.
fn slug2(sx, sy, v, col) {
    if v < 10 {
        text_aa(sx, sy, "0", col)
        num_aa(sx + cell_w(), sy, v, col)
    } else {
        num_aa(sx, sy, v, col)
    }
    return sx + 2 * cell_w()
}
# THE SLUG'S TWO CONTRAST FIGURES, RECOMPUTED against the live theme rather
# than quoted. Same two ui_ratio calls the system pane's ladder table makes, so
# a re-pointed palette moves the foot and the pane together or neither.
fn slug_minstep() { return ui_ratio(theme(TH_PANEL_HI), theme(TH_SURF_5)) }
fn slug_knock() { return ui_ratio(theme(TH_KNOCK), theme(TH_PANEL)) }

fn draw_slug(sx, sy) {
    col = theme(TH_TEXT_DIM)
    cw = cell_w()
    se = px_w() - pad_d()
    # ---- the machine and the panel
    w = 10 * cw + s3_numw(px_w()) + cw + s3_numw(px_h())
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "zlOS 0.3  ", col)
    sx = sx + 10 * cw
    sx = legend_num(sx, sy, px_w(), col)
    text_aa(sx, sy, "x", col)
    sx = sx + cw
    sx = legend_num(sx, sy, px_h(), col)
    # ---- the cores that actually came up, which is not the same as the cores
    # the package has: smp_total() counts the ones the trampoline brought online
    cpus = smp_total()
    w = 2 * cw + s3_numw(cpus) + 4 * cw
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  ", col)
    sx = sx + 2 * cw
    sx = legend_num(sx, sy, cpus, col)
    text_aa(sx, sy, " CPU", col)
    sx = sx + 4 * cw
    # ---- the module, with the two real widths. The remainder is spread one
    # pixel per column, so there are genuinely two column widths on this screen
    # and printing one of them would be the lie draw_grid_legend already refuses.
    # the two "NNN/NNN" pairs are counted WHOLE here and drawn conditionally
    # below, so on a screen whose division comes out exact this over-reserves by
    # about eight cells. That is the safe direction and it is deliberate: an
    # estimate that is short by one cell prints past the plate's right edge,
    # an estimate that is long by eight drops the field one screen width early.
    w = 9 * cw + s3_numw(GRID_COLS) + cw + s3_numw(GRID_ROWS) + cw
    w = w + s3_numw(grid_cw() + 1) + cw + s3_numw(grid_cw()) + cw
    w = w + s3_numw(grid_rh() + 1) + cw + s3_numw(grid_rh()) + 3 * cw
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  MODULE ", col)
    sx = sx + 9 * cw
    sx = legend_num(sx, sy, GRID_COLS, col)
    text_aa(sx, sy, "x", col)
    sx = sx + cw
    sx = legend_num(sx, sy, GRID_ROWS, col)
    text_aa(sx, sy, " ", col)
    sx = sx + cw
    if grid_cwr() > 0 {
        sx = legend_num(sx, sy, grid_cw() + 1, col)
        text_aa(sx, sy, "/", col)
        sx = sx + cw
    }
    sx = legend_num(sx, sy, grid_cw(), col)
    text_aa(sx, sy, "x", col)
    sx = sx + cw
    if grid_rhr() > 0 {
        sx = legend_num(sx, sy, grid_rh() + 1, col)
        text_aa(sx, sy, "/", col)
        sx = sx + cw
    }
    sx = legend_num(sx, sy, grid_rh(), col)
    text_aa(sx, sy, " px", col)
    sx = sx + 3 * cw
    # ---- the gutter
    w = 6 * cw + s3_numw(grid_gut())
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  GUT ", col)
    sx = sx + 6 * cw
    sx = legend_num(sx, sy, grid_gut(), col)
    # ---- THE THREE FIGURES THE SLUG SAID IT COULD NOT MEASURE ---------------
    #
    # A comment in this file declared MIN STEP, KNOCK and SKEW unmeasurable:
    # "Computing one needs pow(x, 2.4) on a linearised channel, and there are no
    # floats in this drawing path by design ... design.h states 1.1682 and
    # 6.4796 in prose and exports neither as a number ... Printing them would
    # mean a fourth hand-copy of two figures."
    #
    # Every clause of that is contradicted by this repo. ui_ratio is a bound
    # native returning WCAG contrast as an INTEGER times 10^4 - no float, no
    # hand-copy - and the system pane already recomputes FOURTEEN rows with it
    # against the live theme. The slug was the only surface that believed the
    # measurement was impossible, and it wrote that belief down as a reason.
    #
    # This is the inverse of the fault this project usually catches: not a
    # figure written where one could be read, but a reading refused where one
    # was available. Both come from the same place - nobody checked - and the
    # refusal is the more durable of the two, because a stated "cannot" is
    # never revisited.
    # ELEVEN CELLS RESERVED, ELEVEN ADVANCED. "  MIN STEP " is eleven characters
    # and the advance below is 11 * cw; this reserved ten, so whenever the room
    # left fell in [10*cw + ratw, 11*cw + ratw) the field passed slug_fit and
    # then drew up to a full cell past the right margin. Every other field in
    # this slug reserves exactly what it advances - GUT 6/6, KNOCK 8/8, UP 5/5 -
    # and this one was the odd one out.
    w = 11 * cw + pw_ratw(slug_minstep())
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  MIN STEP ", col)
    sx = sx + 11 * cw
    pw_rat(sx, sy, slug_minstep(), col)
    sx = sx + pw_ratw(slug_minstep())
    w = 8 * cw + pw_ratw(slug_knock())
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  KNOCK ", col)
    sx = sx + 8 * cw
    pw_rat(sx, sy, slug_knock(), col)
    sx = sx + pw_ratw(slug_knock())
    # ---- uptime, off the 100 Hz tick
    up = idiv(ticks(), 100)
    w = 5 * cw + s3_numw(up) + cw
    if slug_fit(sx, se, w) == 0 { return 0 }
    text_aa(sx, sy, "  UP ", col)
    sx = sx + 5 * cw
    sx = legend_num(sx, sy, up, col)
    text_aa(sx, sy, "s", col)
    sx = sx + cw
    # ---- the wall clock, LAST because it is the one field that is not about
    # this machine's configuration - and guarded, because a foot that prints
    # 00:00:00 on a box with no readable RTC is stating a time it does not know.
    if rtc_ok() > 0 {
        w = 2 * cw + 8 * cw
        if slug_fit(sx, se, w) == 0 { return 0 }
        text_aa(sx, sy, "  ", col)
        sx = sx + 2 * cw
        sx = slug2(sx, sy, rtc_h(), col)
        text_aa(sx, sy, ":", col)
        sx = sx + cw
        sx = slug2(sx, sy, rtc_mi(), col)
        text_aa(sx, sy, ":", col)
        sx = sx + cw
        sx = slug2(sx, sy, rtc_s(), col)
    }
    return 0
}

# ---- the shell's live pass ---------------------------------------------------
# draw_status keeps its name and its two callers' contract - the framebuffer
# branch paints the desktop's furniture, the VGA branch paints the text-mode
# status line - and what the framebuffer branch paints is now the rail's live
# half, the raster strip and the foot. `msg` is unused on this path and was
# already unused before PRESSWORK; it survives because the text branch needs it.
shell_baked = 0
fn draw_status(msg) {
    sr = status_row()
    if px_w() > 0 {
        if shell_baked == 0 { draw_rail_static() }
        draw_rail_reg()
        draw_rail_ws()
        draw_rail_stat()
        draw_rail_clock()
        draw_strip()
        draw_foot()
    } else {
        bar(sr, C_STATUS)
        at(sr, 2,  "h help", C_STATUS)
        at(sr, 12, "q halt", C_STATUS)
        at(sr, 40, "state:", C_STATUS)
        at(sr, 47, msg, C_STATUS)
        at(sr, 62, "uptime:", C_STATUS)
    }
}

# just the uptime, redrawn each second. `sec` is the VGA branch's - on the
# framebuffer the slug reads ticks() itself, which is the SAME source the
# caller derived sec from, so this is one clock and not two. On the framebuffer it is the foot's
# slug - the whole line, because the slug is one mono run and re-laying it out
# from its own start is what stops the "up 9" -> "up 10" case from leaving the
# head of the previous value behind. On VGA it uses the text cell.
#
# IT TAKES THE MEMORY RULER WITH IT, and that is not scope creep: four of the
# ruler's eight regions are allocator figures that move whenever a window opens,
# and the only other thing that paints them is draw_foot, which runs at a
# command transition. Once a second is the right cadence for a memory map and
# it is the cadence that already exists here.
fn draw_clock(sec) {
    if px_w() > 0 {
        u = ui()
        sx = rail_w() + pad_d()
        sy = foot_y() + foot_h() - band_h() + 2 * u
        fill_rgb(sx, sy, px_w() - sx - pad_d(), cell_h(), theme(TH_PANEL_HI))
        draw_slug(sx, sy)
        draw_foot_ruler()
        draw_rail_clock()
    } else {
        at_num(status_row(), 70, sec, C_STATUS)
    }
}

# [ OK ]/[ INFO ] boot lines, assembled from coloured pieces
fn ok_line(msg) {
    color(C_GREY)  put("  [")
    color(C_GREEN) put("  OK  ")
    color(C_GREY)  put("] ")
    color(C_GREY)  print(msg)
}
fn info_line(msg) {
    color(C_GREY)  put("  [")
    color(C_CYAN)  put(" INFO ")
    color(C_GREY)  put("] ")
    color(C_GREY)  print(msg)
}

# ---- the work the shell can do ---------------------------------------------
# Recursive, and it WORKS: zl gives every function call its own frame for the
# PARAMETERS, so `n` is restored after each sub-call - fib(20) returns 6765,
# verified against the golden transcript. (The no-locals gotcha only bites
# same-named *free locals*, e.g. a helper's `running` stomping the shell's.)
fn fib(n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
fn sum_squares(n) {
    t = 0
    i = 1
    while i <= n { t = t + i * i  i = i + 1 }
    return t
}
fn is_digit(c) { return c >= 48 and c <= 57 }

# THE SHELL HAS TWO INPUT MODELS AND THIS HAS TO SAY WHICH ONE IS RUNNING.
# Under the compositor a command is a typed word ending in Enter; on a machine
# with no framebuffer the old text shell is still a single keypress per
# command. Printing one list on both would be wrong on one of them, and a help
# screen that lists commands the machine will not accept is worse than none.
fn help() {
    if wm_run() == 1 { return help_typed() }
    return help_keys()
}

fn help_typed() {
    color(C_CYAN)  print("  commands - type the name, then Enter")
    color(C_GREY)
    print("    help              this help")
    print("    fib <n>           fib(n)              e.g.  fib 20")
    print("    sum <n>           sum of squares      e.g.  sum 10")
    print("    uptime            uptime, from the timer interrupt")
    print("    cpuid             the CPU's own brand string, via CPUID")
    print("    bars              colour-bar graphics demo (with sound)")
    print("    anim              a bouncing logo over a starfield")
    print("    mouse             a cursor driven by the PS/2 mouse")
    print("    snake             play SNAKE (w a s d to steer)")
    print("    paint             paint with the mouse")
    print("    edit              edit persistent /user/notes.txt")
    print("    files             persistent zlfs file manager")
    print("    format            explicitly initialise/mount zlfs on NVMe")
    print("    beep              beep the PC speaker")
    print("    poke              poke a byte into video memory and read it back")
    color(C_CYAN)  print("  our hardware drivers")
    color(C_GREY)
    print("    pci               PCI bus + the Intel GPU, read off real silicon")
    print("    usb               take the xHCI controller and enumerate the bus")
    print("    usbkbd            USB keyboard - live, straight off the HID reports")
    print("    mode              change the screen resolution, no BIOS involved")
    print("    cube              spinning 3D cube, rendered in software")
    print("    gpu               virtio-gpu - a real GPU driver, virtqueues and all")
    print("    cpu               the processor: CPUID, topology, caches, TSC clock")
    print("    nvme              NVMe disk - identify, then write and read a block back")
    print("    sched             multitasking - three tasks running beside the shell")
    print("    userexec          run /system/user.bin isolated in 64-bit Ring 3")
    print("    smp               wake the other CPU cores with INIT/STARTUP IPIs")
    print("    usbstor           USB mass storage - SCSI over USB, read a sector")
    print("    diag              flight recorder status (USB or RAM-only)")
    print("    diag save         flush buffered evidence to the prepared USB")
    print("    wifi              read-only Intel AX201 PCI/CSR inventory")
    print("    i2c               I2C-HID touchpad (real hardware only - QEMU has no LPSS I2C)")
    print("    input             input events - keys, modifiers, repeat, live")
    print("    clear             clear the scrollback")
    print("    reboot            reboot the machine")
    print("    quit              halt the machine")
    return 0
}

# TEXT MODE ONLY, and byte-for-byte what it has always printed - verify.sh
# diffs this against golden.txt.
fn help_keys() {
    color(C_CYAN)  print("  commands")
    color(C_GREY)
    print("    h        this help")
    print("    <n> f    fib(n)          e.g.  20f")
    print("    <n> s    sum of squares  e.g.  10s")
    print("    t        uptime, from the timer interrupt")
    print("    p        the CPU's own brand string, via CPUID")
    print("    b        colour-bar graphics demo (with sound)")
    print("    a        animation - a bouncing logo over a starfield")
    print("    x        mouse demo - a cursor driven by the PS/2 mouse")
    print("    g        play SNAKE (w a s d to steer)")
    print("    d        paint with the mouse")
    print("    i        edit persistent /user/notes.txt (graphical mode)")
    print("    l        list persistent zlfs files")
    print("    run F    run a program from a file (type it - needs a name)")
    print("    .        zlfs on the NVMe disk - mount, and count the boots")
    print("    ,        list the files ON DISK, by name")
    print("    ;        the real time, read off the CMOS clock")
    print("    '        write the clipboard to clip.txt on disk")
    print("             (Ctrl+C in the editor copies, Ctrl+V pastes)")
    print("    e        beep the PC speaker")
    print("    m        poke a byte into video memory and read it back")
    color(C_CYAN)  print("  our hardware drivers")
    color(C_GREY)
    print("    k        PCI bus + the Intel GPU, read off real silicon")
    print("    u        USB: take the xHCI controller and enumerate the bus")
    print("    j        USB keyboard - live, straight off the HID reports")
    print("    n        change the screen resolution, no BIOS involved")
    print("    v        spinning 3D cube, rendered in software")
    print("    w        draggable windows")
    print("    y        virtio-gpu - a real GPU driver, virtqueues and all")
    print("    z        the processor: CPUID, topology, caches, TSC clock")
    print("    o        NVMe disk - identify, then write and read a block back")
    print("    +        multitasking - three tasks running beside the shell")
    print("    *        SMP - wake the other CPU cores with INIT/STARTUP IPIs")
    print("    /        USB mass storage - SCSI over USB, read a sector")
    print("    ?        I2C-HID touchpad (real hardware only - QEMU has no LPSS I2C)")
    print("    =        input events - keys, modifiers, repeat, live")
    print("    c        clear the screen")
    print("    r        reboot the machine")
    print("    q        halt the machine")
    return 0
}

# a graphics demo: 14 colour bars, proving the framebuffer is ours to paint
fn colorbars() {
    if px_w() == 0 {
        color(C_GREY)  print("  (colour bars need the framebuffer console)")
        return 0
    }
    y = row() * 16 + 8
    w = px_w() / 14
    i = 1
    while i <= 14 {
        fill_rect((i - 1) * w, y, w, 40, i)
        i = i + 1
    }
    print("")
    print("")
    print("")
    color(C_GREY)  print("  14 colours, painted straight into the framebuffer")
    return 0
}

# ---- a live mouse demo: a cursor that follows the PS/2 mouse ---------------
# ---- the pointer diagnostics, as an app ------------------------------------
# Its value was never the cursor - it was the COUNTERS. A dead pointer has two
# very different causes and only these separate them: mouse_irqs() at 0 means
# no interrupt reached us at all, non-zero with a stuck position means the
# decode is wrong. ptr_driver() is new and answers a third: whether the USB
# pointer driver is even linked in (see the weak symbols in runtime_kernel.c).
m_lastx = 0 - 1
m_lasty = 0 - 1

fn mouse_tick() {
    if mouse_x() == m_lastx { if mouse_y() == m_lasty { return 0 } }
    m_lastx = mouse_x()
    m_lasty = mouse_y()
    return 1
}

# A well of an arbitrary pixel height. set_well() takes a line count because the
# settings panes stack text in it; the editor's body is whatever is left of the
# client, so it needs the same surface measured in pixels. Same five draws, same
# order, same tokens - this is the prototype's `.well` rule and nothing else.
SH_BTNH = 22                       # .btn { height: calc(22px * var(--ui)) }
SH_BTNPX = 10                      # .btn { padding: 0 calc(10px * var(--ui)) }

sh_us = 0
sh_t0 = 0

# .btn, to the prototype's own rule: ZD_RAISE ground, 1px ZD_CUT border, a
# struck ZD_LIT top inset, ZD_R_CHIP radius. `prim` swaps the ground for the
# vermilion overprint with ZD_INK_ON text - the one primary action, which
# design.h reserves the overprint for. `on` 0 draws it disabled, and a disabled
# button uses ZD_TEXT_INERT, which is one of the four uses that token is
# actually sanctioned for.
fn sh_btn(bx, by, bw, nm, prim, on) {
    bu = ui()
    bh = SH_BTNH * bu
    rrect(bx, by, bw, bh, R_CHIP_D * bu, theme(TH_CUT))
    if prim == 1 {
        rrect(bx + 1, by + 1, bw - 2, bh - 2, R_CHIP_D * bu, theme(TH_ACCENT))
        fill_rgb(bx + 1, by + 1, bw - 2, 1, theme(TH_ACCENT_BR))
    } else {
        rrect(bx + 1, by + 1, bw - 2, bh - 2, R_CHIP_D * bu, theme(TH_PANEL_HI))
        fill_rgb(bx + 1, by + 1, bw - 2, 1, theme(TH_LIT))
    }
    tc2 = theme(TH_TEXT_2)
    if prim == 1 { tc2 = theme(TH_INK_ON) }
    if on == 0 { tc2 = theme(TH_SURF_7) }
    ui_caps(bx + (bw - ui_capsw(nm, PW_SM)) / 2, by + (bh - ui_th(PW_SM)) / 2, nm, tc2, PW_SM)
    return bx + bw + 8 * bu
}

fn sh_btnw(nm) { return ui_capsw(nm, PW_SM) + 2 * SH_BTNPX * ui() }

# REGDUMP IS OFFERED ONLY WHEN THERE IS A PIPE TO DUMP. intel_ok() is false
# under QEMU, where the PIPE_A registers read back zero - the system pane
# already refuses to print them for exactly this reason. A button that runs and
# prints zeros is worse than one that says it cannot run.
# THE GATE WAS ASKING ABOUT A DEVICE THE BUTTON NEVER TOUCHES.
#
# This was `return intel_ok()`, so on every machine without an Intel display
# pipe - which is every machine the probes and the dev loop use - the button
# drew disabled and answered a click with "no intel pipe here - PIPE_A reads
# back zero". But the command behind it is run_command(216), which opens
# APP_SYSINFO: cpuid, the APIC, core and thread counts. si_draw's own comment
# says printing the reference's PIPE_A value "would be inventing a reading",
# which is precisely why that pane shows no display registers at all.
#
# So the control was permanently dead for a reason that did not apply to what
# it did, and the one machine where the gate opened is the one where the pane
# still would not have shown a pipe. A register dump of the CPU and the
# interrupt controller is a register dump; it is available everywhere; and the
# button is now enabled everywhere, which is also what the reference does with
# it.
fn sh_regdump_on() { return 1 }

# The reference's row is REBUILD / DMESG / REGDUMP. REBUILD IS NOT OFFERED:
# there is no compiler and no linker on this machine - exec.c runs a prebuilt
# /system/user.bin and nothing in the tree compiles anything - so that button
# could only ever lie about what it did. The two that remain both do their job.
fn sh_buttons(bx, by, bw) {
    bu = ui()
    nx = sh_btn(bx, by, sh_btnw("dmesg"), "dmesg", 1, 1)
    nx = sh_btn(nx, by, sh_btnw("regdump"), "regdump", 0, sh_regdump_on())
    ey2 = by + (SH_BTNH * bu - ui_th(PW_SM)) / 2
    # THE REFERENCE PRINTS "exit 0 - 1.42 s" AND ONLY THE SECOND HALF IS REAL.
    #
    # I added this readout as `exit N` from run_command's return value, and
    # that value is not an exit status. run_command returns 0 from 74 sites -
    # its ordinary "done" - returns 1 from one, and delegates from 48 more, so
    # the number it hands back depends on which branch ran and not on whether
    # anything succeeded. The catalog proved it on screen: `apps` opened the
    # window correctly and the band read "exit 1", because reg_open happened to
    # return 1. An arbitrary internal value printed under a name that means
    # something specific is precisely the fault I have spent today removing,
    # and I introduced this one.
    #
    # zlOS builtins do not exit. They are function calls in the compositor's
    # own process; there is no status to read and inventing a plausible 0 would
    # be worse than the 1, not better. The elapsed time IS real - ticks() is
    # the PIT at 100 Hz, so centiseconds, and the reference's own 1.42 s is 142
    # of them - so that is what this prints, and it prints what it is.
    ew3 = ui_tw("ran in ", PW_SM, PW_MONO) + s3_numw(sh_us) + ui_tw(" us", PW_SM, PW_MONO)
    ex3 = bx + bw - ew3
    ui_txt(ex3, ey2, "ran in ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    num_aa(ex3 + ui_tw("ran in ", PW_SM, PW_MONO), ey2, sh_us, theme(TH_TEXT_2))
    ui_txt(ex3 + ui_tw("ran in ", PW_SM, PW_MONO) + s3_numw(sh_us), ey2, " us", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return 0
}

# Which button a click landed on, or -1. The row is laid out once, here and in
# sh_buttons, from the same widths - a second copy of the geometry is how a
# button ends up drawn in one place and clickable in another.
fn sh_btn_hit(win, hx2, hy2) {
    hu = ui()
    hp = 10 * hu
    # SCREEN COORDINATES, BECAUSE THAT IS WHAT ex/ey ARE. This computed
    # `wm_ch(win) - ...`, a client HEIGHT, and compared it against a screen y -
    # so the row was drawn in one space and hit-tested in another and could
    # never be clicked. files_mouse_slot two hundred lines away does it right
    # (`wm_cy(win) + ...`) and was the thing to copy.
    hby = wm_cy(win) + wm_ch(win) - hp - SH_BTNH * hu
    if hy2 < hby { return 0 - 1 }
    if hy2 > hby + SH_BTNH * hu { return 0 - 1 }
    b0 = wm_cx(win) + hp
    b1 = b0 + sh_btnw("dmesg") + 8 * hu
    if hx2 >= b0 { if hx2 < b0 + sh_btnw("dmesg") { return 0 } }
    if hx2 >= b1 { if hx2 < b1 + sh_btnw("regdump") { return 1 } }
    return 0 - 1
}

fn pw_well(x, y, w, h) {
    pwu = ui()
    rrect(x, y, w, h, R_INSET_D * pwu, theme(TH_CUT))
    rrect(x + 1, y + 1, w - 2, h - 2, R_INSET_D * pwu - 1, theme(TH_SURF_WELL))
    fill_rgb(x + 1, y + 1, w - 2, 1, theme(TH_CUT))
    fill_rgb(x + 1, y + h - 2, w - 2, 1, theme(TH_LITSOFT))
    return 0
}

# How many newlines the buffer holds. The old footer printed ed_len - BYTES -
# where the reference prints "N ln", and those are different quantities in the
# same slot: a 4 KiB file is not 4096 lines.
fn ed_lines() {
    edl_i = 0
    edl_n = 1
    while edl_i < ed_len {
        if peek8(EDIT_BUF + edl_i) == 10 { edl_n = edl_n + 1 }
        edl_i = edl_i + 1
    }
    return edl_n
}

# Bytes since the last newline. The reference hardcodes col 1; this editor only
# ever appends, so the column is exactly computable and is a live number - one
# of the few places the OS can be strictly more truthful than the mockup for
# free.
fn ed_col() {
    edc_i = 0
    edc_c = 1
    while edc_i < ed_len {
        if peek8(EDIT_BUF + edc_i) == 10 { edc_c = 1 } else { edc_c = edc_c + 1 }
        edc_i = edc_i + 1
    }
    return edc_c
}

# IS THIS A TEXT BUFFER AT ALL?
#
# There was no answer to that question anywhere in the editor. editor_open_disk
# checks fs_ok, fs_inuse and the size ceiling and then fs_rd's the bytes
# unconditionally, and editor_draw guards only `if ed_c > 32`, so a binary file
# renders as a field of blank cells with the occasional stray glyph, advancing
# one cell per byte. That is precisely the state the reference's binary branch
# exists to prevent, and this OS reached it.
#
# The classification costs nothing invented: the bytes are already in EDIT_BUF.
# Anything outside tab, newline, carriage return and printable ASCII is not text
# to a renderer that draws one baked glyph per byte, which is what this one does.
fn ed_nontext() {
    edn_i = 0
    edn_n = 0
    edn_cap = ed_sniff()
    while edn_i < edn_cap {
        edn_c = peek8(EDIT_BUF + edn_i)
        if edn_c == 9 or edn_c == 10 or edn_c == 13 {
            edn_i = edn_i + 1
        } else {
            if edn_c < 32 or edn_c > 126 { edn_n = edn_n + 1 }
            edn_i = edn_i + 1
        }
    }
    return edn_n
}

fn ed_is_binary() {
    if ed_len < 1 { return 0 }
    if ed_nontext() * 20 > ed_sniff() { return 1 }
    return 0
}

# The filename, drawn a glyph at a time. It cannot go through a string: zl has
# string literals and no string values, so fs_ch(slot, i) one byte at a time is
# the only way a runtime name reaches the screen.
fn ed_name(nx, ny, col) {
    edn2_i = 0
    edn2_x = nx
    while edn2_i < 23 {
        edn2_c = fs_ch(ed_slot, edn2_i)
        if edn2_c > 0 { char_aa(edn2_x, ny, edn2_c, col) }
        if edn2_c > 0 { edn2_x = edn2_x + cell_w() }
        edn2_i = edn2_i + 1
    }
    return edn2_x
}

fn ed_namew() {
    edw_i = 0
    edw_n = 0
    while edw_i < 23 {
        if fs_ch(ed_slot, edw_i) > 0 { edw_n = edw_n + 1 }
        edw_i = edw_i + 1
    }
    return edw_n * cell_w()
}

# HOW FAR THE CLASSIFIER LOOKED. ed_is_binary samples the head of the buffer
# rather than all of it, and the number it stopped at is part of what the pane
# reports - a claim about 512 bytes and a claim about the file are different
# claims. One owner, so the sniffer and the sentence can never disagree.
fn ed_sniff() {
    esn = ed_len
    if esn > 512 { esn = 512 }
    return esn
}

# head(), binary branch: buffer | <name> | ... | "binary". Three fields, and
# deliberately not the four the text branch draws - see editor_draw.
fn ed_head_bin(hx, hy, hw) {
    hbu = ui()
    hby = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(hx, hby, "buffer", theme(TH_TEXT_DIM), PW_SM)
    ed_name(hx + ui_capsw("buffer", PW_SM) + 10 * hbu, hby, theme(TH_TEXT_HI))
    ui_caps(hx + hw - ui_capsw("binary", PW_SM), hby, "binary", theme(TH_TEXT_DIM), PW_SM)
    return hy + pw_headh()
}

# head(): buffer | <name> | <state> | ... | encoding, in the reference's order.
fn ed_head(hx, hy, hw) {
    hu = ui()
    hy2 = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(hx, hy2, "buffer", theme(TH_TEXT_DIM), PW_SM)
    ed_name(hx + ui_capsw("buffer", PW_SM) + 10 * hu, hy2, theme(TH_TEXT_HI))
    # NOT "read only", WHICH IS WHAT THE REFERENCE PRINTS. Its editor is a
    # viewer; this one writes - editor_save calls fs_wr and then fs_sync and
    # says so when the flush fails. Copying that label would advertise the
    # opposite of what Ctrl+S does.
    sx2 = hx + ui_capsw("buffer", PW_SM) + 10 * hu + ed_namew() + 14 * hu
    if ed_dirty == 1 { ui_caps(sx2, hy2, "modified", theme(TH_ACCENT), PW_SM) } else { ui_caps(sx2, hy2, "saved", theme(TH_TEXT_DIM), PW_SM) }
    # NOT "utf-8" EITHER. There is no UTF-8 decoder in the drawing path: one
    # byte in, one baked glyph out. "lf" is true - editor_key inserts byte 10
    # for Enter and there is no CR path anywhere.
    ew = ui_tw("ascii - lf - ", PW_SM, PW_MONO)
    enw = s3_numw(ed_lines()) + ui_tw(" ln", PW_SM, PW_MONO)
    ui_txt(hx + hw - ew - enw, hy2, "ascii - lf - ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    num_aa(hx + hw - enw, hy2, ed_lines(), theme(TH_TEXT_2))
    ui_txt(hx + hw - enw + s3_numw(ed_lines()), hy2, " ln", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return hy + pw_headh()
}

# The footer: ln, col, tab, state. Three of those four are read.
fn ed_foot(fx, fy, fw) {
    fu = ui()
    nx = sm_fig(fx, fy, "ln", ed_lines(), 0, theme(TH_TEXT_2))
    nx = sm_fig(nx, fy, "col", ed_col(), 0, theme(TH_TEXT_2))
    # THE REFERENCE PRINTS "tab 4" AND THIS ONE CANNOT. editor_key accepts
    # code >= 32 plus 3/8/13/19/22/27; Tab is 9, so it falls through and is
    # DISCARDED. There is no tab width because there are no tabs, and printing
    # a width would advertise a setting that does not exist.
    ui_caps(nx, fy, "tab", theme(TH_TEXT_DIM), PW_SM)
    ui_txt(nx + ui_capsw("tab", PW_SM) + 5 * fu, fy, "not accepted", theme(TH_TEXT_DIM), PW_SM, 0)
    if ed_dirty == 1 { pw_sw(fx + fw - pw_sww("UNSAVED"), fy, "UNSAVED", theme(TH_WARN)) } else { pw_sw(fx + fw - pw_sww("CLEAN"), fy, "CLEAN", theme(TH_OK)) }
    return 0
}

# THE BINARY BRANCH THE EDITOR NEVER HAD.
#
# The reference's empty state says "open it in 06 HEX", and this OS must not:
# hx_ui reads HX_BASE = 0x100000, which is kernel memory at the load address,
# with +0/+256/+512 page chips. It cannot view a file at all. Sending someone
# there would land them on the kernel image and call it their file, so the
# sentence says what is true instead and names the measurement that decided it.
fn ed_binary_body(bx, by, bw, bh) {
    bu = ui()
    pw_well(bx, by, bw, bh)
    cy = by + bh / 2 - ui_th(PW_SM)
    ui_caps(bx + (bw - ui_capsw("no text preview", PW_SM)) / 2, cy, "no text preview", theme(TH_TEXT_DIM), PW_SM)
    cy = cy + ui_th(PW_SM) + 8 * bu
    # THE COUNT GOES FIRST AND THE SAMPLE SIZE GOES LAST. This printed
    # "of the first <nontext> bytes are not text", which puts the COUNT of
    # non-text bytes in the slot where the sample SIZE belongs. Read literally
    # it asserts that ALL of the first N bytes are non-text - a strictly
    # stronger claim than the measurement makes, and a false one - while the
    # count itself never appeared and the 512-byte cap was never printed, so
    # nothing on the surface said this was a sample of the head of the file
    # rather than a verdict on the whole of it.
    #
    # Both figures are READ: ed_nontext() counts, ed_sniff() is how far it
    # looked. Same order the commit message described and the code did not do.
    lw = s3_numw(ed_nontext()) + ui_tw(" of the first ", PW_SM, PW_MONO) + s3_numw(ed_sniff()) + ui_tw(" bytes are not text", PW_SM, PW_MONO)
    lx = bx + (bw - lw) / 2
    num_aa(lx, cy, ed_nontext(), theme(TH_TEXT_2))
    lx2 = lx + s3_numw(ed_nontext())
    ui_txt(lx2, cy, " of the first ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    lx2 = lx2 + ui_tw(" of the first ", PW_SM, PW_MONO)
    num_aa(lx2, cy, ed_sniff(), theme(TH_TEXT_2))
    ui_txt(lx2 + s3_numw(ed_sniff()), cy, " bytes are not text", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    cy = cy + ui_th(PW_SM) + 6 * bu
    ui_txt(bx + (bw - ui_tw("this editor draws one baked glyph per byte", PW_SM, 0)) / 2, cy, "this editor draws one baked glyph per byte", theme(TH_TEXT_DIM), PW_SM, 0)
    cy = cy + ui_th(PW_SM) + 2 * bu
    ui_txt(bx + (bw - ui_tw("06 HEX reads memory, not files - it cannot show this one", PW_SM, 0)) / 2, cy, "06 HEX reads memory, not files - it cannot show this one", theme(TH_TEXT_DIM), PW_SM, 0)
    return 0
}

# The gutter and the text, inside the well. The reference's gutter is the first
# six columns of its own source strings lifted out; this one derives the numbers
# from the buffer, because the buffer is the truth here and the strings are the
# mockup's stand-in for one.
# THE EDITOR HAD NO VIEWPORT: past about fifteen rows it went blind.
#
# ed_text_body started at byte 0 every frame and stopped when it ran out of
# well, and the editor's entire state was ed_slot / ed_len / ed_dirty - there
# was no scroll offset anywhere. In the window this OS actually opens that is
# fifteen rows of roughly fifty-five columns, about eight hundred characters,
# against an EDIT_MAX of eight thousand. Everything past that was appended to a
# buffer drawn nowhere, with the caret frozen off the bottom edge. You could
# still type; you just could not see any of it, and neither could the caret.
#
# THE VIEW IS DERIVED, NOT STORED. The caret in this editor is always at the end
# of the buffer - every key appends - so the line that must be visible is
# ed_lines(), and the top of the view follows from it and the row capacity. That
# makes the default a READ: nothing has to be kept in sync, and no state can go
# stale against a resized window. ed_scroll is the user's own offset back from
# that anchor, exactly the shape the kernel log's kl_scroll already uses.
#
# The prototype's body is `class="well scroll"` - overflow-y:auto - so a
# scrollable body is what the authority asks for; this is the honest minimum of
# it, and the drawn scrollbar is the step after.
ed_scroll = 0

# How many text rows the well can show. One owner, because the draw, the scroll
# clamp and the key handler must agree or the caret leaves the viewport.
fn ed_rows(th) {
    edr = idiv(th - 12 * ui(), cell_h())     # idiv: a row COUNT that clamps the viewport
    if edr < 1 { edr = 1 }
    return edr
}

# The first line drawn, 0-based. Tail-anchored, then backed off by ed_scroll.
# HOW MANY COLUMNS THE WELL SHOWS. One owner, because the anchor below and the
# draw both need it and this file has already been bitten twice by two places
# computing one geometry. Same terms the draw uses: the gutter, its 8dp gap, and
# a cell's width for the wrap margin.
fn ed_cols(tw) {
    edc = idiv(tw - 5 * cell_w() - 16 * ui(), cell_w())
    if edc < 1 { edc = 1 }
    return edc
}

# SCREEN ROWS, NOT LOGICAL LINES - the renderer wraps and the anchor did not
# know it.
#
# ed_top anchored on ed_lines(), a count of 0x0A bytes, while ed_text_body wraps
# at the well's right edge, so ONE logical line can occupy many screen rows.
# Typing past a well-full of characters without pressing Enter left ed_lines()
# at 1, ed_top at 0, and the view pinned to the top while the caret walked off
# the bottom - the exact blindness the viewport was added to remove, reached by
# a different route.
#
# A line costs ceil(len / cols) rows, and at least one: an empty line still
# occupies a row. Walking the buffer to add them up is the same shape ed_lines
# already uses and costs the same once-per-frame pass.
# COUNTED BY WALKING, THE SAME WALK ed_row_off DOES.
#
# The first version used ceil(len / cols) per line, which disagrees with the
# walk for any line that is an exact multiple of the column count: the ceiling
# says one row, and the walk - which advances on `c >= cols` and then again on
# the newline - says two. Two functions describing one layout by different
# arithmetic will differ somewhere, and here they differed exactly where a line
# filled the well precisely.
#
# Same loop, same conditions, same order. They cannot disagree now because they
# are the same procedure asked two different questions.
fn ed_rows_used(tw) {
    eru_i = 0
    eru_n = 1
    eru_c = 0
    edc = ed_cols(tw)
    while eru_i < ed_len {
        if peek8(EDIT_BUF + eru_i) == 10 {
            eru_n = eru_n + 1
            eru_c = 0
        } else {
            eru_c = eru_c + 1
            if eru_c >= edc { eru_n = eru_n + 1  eru_c = 0 }
        }
        eru_i = eru_i + 1
    }
    return eru_n
}

# The first SCREEN ROW drawn. ed_line_off then has to skip that many rows rather
# than that many newlines - see ed_row_off.
fn ed_top(th, tw) {
    edmax = ed_rows_used(tw) - ed_rows(th)
    if edmax < 0 { edmax = 0 }
    # THE SCROLL IS CLAMPED HERE, where the well's size is known. editor_key
    # capped it against ed_lines() - 1, a count of NEWLINES, which for a wrapped
    # buffer is fewer rows than the buffer occupies: PgUp could not reach the
    # top of a long unbroken line. It also had no way to know tw. Clamping at
    # the draw keeps one owner for the wrap rule and makes the cap correct at
    # whatever size the window currently is.
    if ed_scroll > edmax { ed_scroll = edmax }
    if ed_scroll < 0 { ed_scroll = 0 }
    return edmax - ed_scroll
}

# Byte offset where screen row n begins, counting wrapped rows. Replaces
# ed_line_off, which counted newlines and therefore could not find a row in the
# middle of a wrapped line.
fn ed_row_off(n, tw) {
    if n < 1 { return 0 }
    ero_i = 0
    ero_r = 0
    ero_c = 0
    edc = ed_cols(tw)
    while ero_i < ed_len {
        if peek8(EDIT_BUF + ero_i) == 10 {
            ero_r = ero_r + 1
            ero_c = 0
            if ero_r >= n { return ero_i + 1 }
        } else {
            ero_c = ero_c + 1
            if ero_c >= edc {
                ero_r = ero_r + 1
                ero_c = 0
                if ero_r >= n { return ero_i + 1 }
            }
        }
        ero_i = ero_i + 1
    }
    return ed_len
}

fn ed_text_body(tx, ty, tw, th) {
    tu = ui()
    pw_well(tx, ty, tw, th)
    gw = 5 * cell_w() + 8 * tu
    fill_rgb(tx + gw, ty + 2, 1, th - 4, theme(TH_CUT))
    px = tx + gw + 8 * tu
    py = ty + 6 * tu
    etop = ed_top(th, tw)
    ln = etop + 1
    num_aa(tx + gw - 8 * tu - s3_numw(ln), py, ln, theme(TH_TEXT_DIM))
    i = ed_row_off(etop, tw)
    cw = cell_w()
    ch = cell_h()
    while i < ed_len {
        c = peek8(EDIT_BUF + i)
        if c == 10 {
            px = tx + gw + 8 * tu
            py = py + ch
            ln = ln + 1
            if py + ch < ty + th - 4 { num_aa(tx + gw - 8 * tu - s3_numw(ln), py, ln, theme(TH_TEXT_DIM)) }
        } else {
            if c > 32 { char_aa(px, py, c, theme(TH_TEXT_HI)) }
            px = px + cw
            if px > tx + tw - cw { px = tx + gw + 8 * tu  py = py + ch }
        }
        if py > ty + th - ch - 4 { i = ed_len } else { i = i + 1 }
    }
    # THE CARET IS ONLY DRAWN WHERE IT ACTUALLY IS. When the view is scrolled
    # back the caret is below the well, and the loop leaves px/py at wherever it
    # ran out of room - painting there would put an accent block on the last
    # visible row that does not mark the insertion point. A caret in the wrong
    # place is worse than no caret, because it is believed.
    if ed_scroll == 0 {
        if py + ch - 2 <= ty + th { fill_rgb(px, py, cw, ch - 2, theme(TH_ACCENT)) }
    }
    return 0
}

fn editor_draw(ax, ay, aw, ah) {
    eu = ui()
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    ep = 10 * eu
    ex = ax + ep
    ew2 = aw - 2 * ep
    ey = ay + ep
    # THE BINARY BRANCH IS A DIFFERENT PANE, not a text pane with one panel
    # swapped. ed_head and ed_foot were both unconditional, so a binary buffer
    # was labelled "ascii - lf - N ln" and "saved"/"modified" across its head
    # and given LN/COL/TAB along its foot - four figures derived from a buffer
    # the pane had just finished saying it could not read. The line count in
    # particular is a tally of 0x0A bytes presented in the slot reserved for
    # lines of text.
    #
    # The reference does the opposite: proto:1692-1698 replaces the whole
    # right-hand span with the single word "binary", and replaces the footer
    # row with one button. It drops the encoding, the line count and the state,
    # because none of them are answerable here.
    if ed_is_binary() == 1 {
        ey = ed_head_bin(ex, ey, ew2)
        bh = ah - (ey - ay) - ep
        ed_binary_body(ex, ey, ew2, bh)
        return 0
    }
    ey = ed_head(ex, ey, ew2)
    fh = pw_kvh()
    bh = ah - (ey - ay) - fh - ep
    ed_text_body(ex, ey, ew2, bh)
    ed_foot(ex, ay + ah - fh + (fh - ui_th(PW_SM)) / 2, ew2)
    return 0
}

fn mouse_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    ui_label("Pointer diagnostics")
    ui_sep()
    ui_num("x", mouse_x())
    ui_num("y", mouse_y())
    ui_num("buttons", mouse_btn())
    ui_num("IRQ12", mouse_irqs())
    ui_num("keyboard slot", usb_kbd_slot())
    if ptr_driver() == 1 {
        ui_label("USB pointer linked")
    } else {
        ui_dim("USB pointer absent")
    }
    return 0
}

# ---- a real window: soft drop shadow, rounded panel, gradient title bar ----
# This is increment #3+#4 of the desktop plan proven end to end: get_px-backed
# shadows, rrect chrome, a true-colour title bar, all drawn by the CPU.
fn draw_window(wx, wy, ww, wh, title, focus) {
    u = ui()
    shadow(wx, wy, ww, wh, 8 * u, 6 * u)
    # v10 SS6.10: the prototype's radii cluster at 11..16px, mode 13/14. At 5
    # the corners read as a bevel; at 12 they are the soft rectangles the whole
    # mockup is built from. The inner rrect stays exactly one unit tighter so
    # the hairline border follows the outer curve rather than cutting it.
    rrect(wx, wy, ww, wh, 12 * u, theme(TH_BORDER))
    rrect(wx + 1, wy + 1, ww - 2, wh - 2, 11 * u, theme(TH_PANEL))
    tbt = theme(TH_TITLE)
    tbb = theme(TH_TITLE_BOT)
    if focus == 0 { tbt = theme(TH_TITLE_OFF)  tbb = theme(TH_TITLE_OFF) }
    # rounded at the TOP to the same curve as the frame outside it. A square
    # band inside a 12-unit corner is two shapes that do not fit; at radius 5
    # it was invisible, which is why it survived this long.
    gradtop(wx + 4, wy + 3, ww - 8, TITLE_H * u - 5, 10 * u, tbt, tbb)
    if focus == 1 { fill_rgb(wx + 4, wy + TITLE_H * u - 2, ww - 8, 2, theme(TH_ACCENT)) }
    fill_rgb(wx + ww - 20 * u, wy + 9 * u, 11 * u, 11 * u, theme(TH_DANGER))
    text_aa(wx + 12 * u, wy + 7 * u, title, theme(TH_TEXT))
    return 0
}

# w - three overlapping windows over the wallpaper: the real thing next to the
# mockup, so the software-vs-browser gap is judged by eye, not by promise
# windows_demo drew three FAKE window frames and waited for a keypress. The
# compositor draws real ones, from a window table, and never says "press any
# key" - deleted, v10 plan SS1c.
# windows_demo was here: a static PICTURE of three window frames with "press
# any key" underneath, from before there was a window manager. desktop-TODO
# calls it superseded and it is - `windows` opens the real thing now. Deleted
# rather than converted; there is nothing in it the compositor does not do.

# a spinning 3D cube - proof the CPU can do real 3D with no GPU and no floats.
# Two wireframe cubes counter-rotating in a viewport window; the maths lives in
# fb.c (integer sine + a perspective divide), zl just spins the angle.
# USB link speeds, as the controller reports them in PORTSC bits 13:10.
# The numbering is the xHCI "Protocol Speed ID"; 1-4 are the defaults every
# controller uses, higher values are only meaningful with the extended
# capability tables, so anything else is reported honestly as unknown.
# Bring the USB stack all the way up: find the controller, take it from the
# firmware, build the DMA rings, then look for a boot-protocol keyboard on
# every port. Returns the keyboard's slot, or 0 if there is no keyboard.
# Safe to call twice - enumeration remembers what it already did.
# Bring the whole USB stack up and SAY what happened.
#
# This runs at boot, before anything is typed, on purpose: on a real UEFI
# machine the firmware's PS/2 emulation dies with ExitBootServices, so if this
# driver fails there is no keyboard to ask it with. The status has to be on the
# screen already. Stays silent when there is no xHCI controller at all, so the
# BIOS/serial test path is unchanged.
fn usb_boot() {
    ub = usb_up()
    if usb_ok() == 0 {
        # Say WHY, and say it on screen. On a UEFI machine there is no serial
        # console and no working PS/2, so a silent failure here is a machine
        # you cannot interact with and cannot diagnose.
        color(C_RED)
        put("  USB: no xHCI controller (")  put(pci_count())
        print(" PCI devices seen)")
        color(C_GREY)
        return 0
    }
    if ub > 0 {
        color(C_GREEN)
        put("  USB: HID keyboard live on slot ")  print(ub)
    } else {
        color(C_RED)
        if usb_ours() == 1 {
            print("  USB: controller is ours, but no HID boot keyboard found")
            color(C_GREY)
            # Dump what IS on the bus. On a machine with no keyboard and no
            # serial this is the only diagnostic we will ever get.
            ubp = 1
            while ubp <= usb_ports() {
                if usb_conn(ubp) == 1 {
                    put("    port ")   put(ubp)
                    put(" portsc 0x")  hex(usb_portsc(ubp), 8)
                    put(" reset->")    put(usb_prst(ubp))
                    put(" now 0x")     hex(usb_portsc(ubp), 8)
                    ubs = usb_enum(ubp)
                    put(" slot ")      put(ubs)
                    if ubs > 0 {
                        put(" vid ")  hex(usb_vid(), 4)
                        put(":")      hex(usb_pid(), 4)
                        put(" cls ")  hex(usb_cls(), 2)
                    }
                    print("")
                }
                ubp = ubp + 1
            }
        } else {
            print("  USB: could not take the xHCI controller")
        }
    }
    color(C_GREY)
    return ub
}

# Live echo test for the USB keyboard. This is the proof that stage 5 works:
# characters here came off the wire as HID reports, not from the PS/2 port.
fn usbkey_demo() {
    color(C_CYAN)  print("  USB keyboard test")
    color(C_GREY)
    if usb_kbd_ok() == 0 {
        if usb_boot() == 0 {
            color(C_RED)  print("    no USB boot keyboard found")
            color(C_GREY)
            return 0
        }
    }
    put("    keyboard on slot ")  put(usb_kbd_slot())
    put(", endpoint dci ")        print(usb_kbd_ep())
    print("    type - ESC or 60s ends the test")
    put("    ")
    ustop = ticks() + 6000
    while ticks() < ustop {
        uc = usb_key()
        if uc != 0 {
            if uc == 27 { print("")  print("    ESC - done")  return 0 }
            # >= 256 is a key with no character (arrow, F-key, Home/End).
            # emit() would draw whatever glyph that number lands on, so show
            # the code instead - this test exists to prove keys arrive.
            if uc >= 256 { put("<")  hex(uc, 3)  put(">") } else {
                if uc == 13 { print("")  put("    ") } else { emit(uc) }
            }
        }
    }
    print("")
    print("    timed out")
    return 0
}

# ---- a real line editor ---------------------------------------------------
# Reading a line is not "collect characters until Enter". A usable prompt has
# a cursor you can move, editing that happens in the middle of the line, and
# a history you can walk back through. That is the difference between typing
# at a computer and operating one.
#
# The line lives in memory at LINE_BUF, the history is a ring of HIST_N slots
# above it, and both are plain bytes - there is no allocator to ask.
#
# The retired numbered RAM-file area below 0x02025000 is now free. These two
# buffers remain deliberately page-separated and are registered in the memory
# map gate:
#
#   LINE_BUF  0x02030000 + LINE_MAX 200          -> 0x020300C8
#   HIST_BUF  0x02031000 + HIST_N 16 * 256       -> 0x02032000
#
# The 256 is the per-entry stride hardcoded in hist_save/hist_load below; it
# is comfortably above LINE_MAX, so a full-length line plus its terminator
# still fits in one slot.
LINE_BUF  = 0x02030000
LINE_MAX  = 200
HIST_BUF  = 0x02031000
HIST_N    = 16
hist_count = 0
hist_pos   = 0

fn line_get(i)    { return peek8(LINE_BUF + i) }
fn line_set(i, c) { poke8(LINE_BUF + i, c) }

fn hist_save(len) {
    hslot = hist_count % HIST_N
    hi = 0
    while hi < len {
        poke8(HIST_BUF + hslot * 256 + hi, peek8(LINE_BUF + hi))
        hi = hi + 1
    }
    poke8(HIST_BUF + hslot * 256 + len, 0)
    hist_count = hist_count + 1
}

# Load history entry `back` steps into the past. Returns its length.
fn hist_load(back) {
    if back <= 0 { return 0 }
    if back > hist_count { return -1 }
    if back > HIST_N { return -1 }
    hslot = (hist_count - back) % HIST_N
    hi = 0
    while hi < LINE_MAX {
        hc = peek8(HIST_BUF + hslot * 256 + hi)
        if hc == 0 { return hi }
        poke8(LINE_BUF + hi, hc)
        hi = hi + 1
    }
    return hi
}

# Redraw the line in place. The console has no way to move the cursor
# backwards, so the whole line is rewritten each time - at 80 columns that is
# far too fast to see, and it keeps the logic honest.
fn line_draw(len, cur, startcol) {
    put("\r")
    put("  zl> ")
    li = 0
    while li < len { emit(line_get(li))  li = li + 1 }
    put(" ")
    # park the cursor by rewriting up to it
    put("\r")
    put("  zl> ")
    li = 0
    while li < cur { emit(line_get(li))  li = li + 1 }
    return 0
}

# Read one line. Returns its length; the text is at LINE_BUF.
fn read_line() {
    llen = 0
    lcur = 0
    hist_pos = 0
    line_draw(0, 0, 0)
    while 1 == 1 {
        lk = key_full()
        if lk == 0 { continue }

        if lk == 13 {
            print("")
            if llen > 0 { hist_save(llen) }
            return llen
        }
        if lk == K_ENTER {
            print("")
            if llen > 0 { hist_save(llen) }
            return llen
        }

        if lk == 8 or lk == K_BKSP {
            if lcur > 0 {
                li = lcur - 1
                while li < llen - 1 {
                    line_set(li, line_get(li + 1))
                    li = li + 1
                }
                llen = llen - 1
                lcur = lcur - 1
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_DEL {
            if lcur < llen {
                li = lcur
                while li < llen - 1 {
                    line_set(li, line_get(li + 1))
                    li = li + 1
                }
                llen = llen - 1
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_LEFT  { if lcur > 0    { lcur = lcur - 1  line_draw(llen, lcur, 0) }  continue }
        if lk == K_RIGHT { if lcur < llen { lcur = lcur + 1  line_draw(llen, lcur, 0) }  continue }
        if lk == K_HOME  { lcur = 0     line_draw(llen, lcur, 0)  continue }
        if lk == K_END   { lcur = llen  line_draw(llen, lcur, 0)  continue }

        if lk == K_UP {
            hnew = hist_load(hist_pos + 1)
            if hnew >= 0 {
                hist_pos = hist_pos + 1
                llen = hnew
                lcur = hnew
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_DOWN {
            if hist_pos > 1 {
                hist_pos = hist_pos - 1
                hnew = hist_load(hist_pos)
                llen = hnew
                lcur = hnew
            } else {
                hist_pos = 0
                llen = 0
                lcur = 0
            }
            line_draw(llen, lcur, 0)
            continue
        }

        # Ctrl+U clears the line, Ctrl+A and Ctrl+E jump to the ends -
        # the readline bindings everyone's fingers already know.
        if lk == 21 { llen = 0  lcur = 0  line_draw(0, 0, 0)  continue }
        if lk == 1  { lcur = 0     line_draw(llen, lcur, 0)  continue }
        if lk == 5  { lcur = llen  line_draw(llen, lcur, 0)  continue }
        if lk == 27 { llen = 0  lcur = 0  line_draw(0, 0, 0)  continue }

        # an ordinary character: insert it at the cursor
        if lk >= 32 {
            if lk < 127 {
                if llen < LINE_MAX - 1 {
                    li = llen
                    while li > lcur {
                        line_set(li, line_get(li - 1))
                        li = li - 1
                    }
                    line_set(lcur, lk)
                    llen = llen + 1
                    lcur = lcur + 1
                    line_draw(llen, lcur, 0)
                }
            }
        }
    }
    return llen
}

fn spname(s) {
    if s == 1 { return "full (12 Mb/s)" }
    if s == 2 { return "low (1.5 Mb/s)" }
    if s == 3 { return "high (480 Mb/s)" }
    if s == 4 { return "super (5 Gb/s)" }
    if s == 5 { return "super+ (10 Gb/s)" }
    return "unknown"
}

# ---- the 3D cube, as an app ------------------------------------------------
# Was `while key_get() == 0 { ...draw... wait_ticks(3) }`: a loop that owned the
# screen and told you to "press any key to exit". The angle is the only state,
# so this is the smallest of the four conversions.
c_ang  = 0
c_next = 0

fn cube_tick() {
    if ticks() < c_next { return 0 }
    c_next = ticks() + 3
    c_ang = c_ang + 5
    if c_ang >= 360 { c_ang = 0 }
    return 1
}

fn cube_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    # The rasterizer has its OWN clip and it must be the client area. fb_clip
    # already stops the cube reaching the chrome, but cube_clip is what keeps
    # the geometry inside the viewport rather than merely scissored at the edge.
    cube_clip(ax, ay, ax + aw, ay + ah)
    cb_s = aw / 5
    if ah / 5 < cb_s { cb_s = ah / 5 }
    cube3d(ax + aw / 2, ay + ah / 2, cb_s, c_ang, theme(TH_ACCENT))
    return 0
}

# ---- an animation: a bouncing logo over a starfield ------------------------
# ---- the bouncing logo, as an app ------------------------------------------
# The starfield is recomputed from a FIXED seed every frame rather than stored,
# which is what stops it flickering - and it is what makes this app_draw
# position-pure for free.
a_lx = 40
a_ly = 90
a_vx = 6
a_vy = 4
a_next = 0

fn anim_tick(aw, ah) {
    if ticks() < a_next { return 0 }
    a_next = ticks() + 2
    a_lx = a_lx + a_vx
    a_ly = a_ly + a_vy
    if a_lx < 0        { a_lx = 0         a_vx = 0 - a_vx }
    if a_lx > aw - 120 { a_lx = aw - 120  a_vx = 0 - a_vx }
    if a_ly < 0        { a_ly = 0         a_vy = 0 - a_vy }
    if a_ly > ah - 48  { a_ly = ah - 48   a_vy = 0 - a_vy }
    return 1
}

fn anim_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    an_seed = 2463534242
    an_i = 0
    while an_i < 90 {
        an_seed = an_seed * 1103515245 + 12345
        an_x = band(an_seed / 4096, 2047) % aw
        an_seed = an_seed * 1103515245 + 12345
        an_y = band(an_seed / 4096, 2047) % ah
        # THE STARS ARE A THEME ROLE, not two hand-picked blue-greys. They were
        # rgb(120,132,160) and rgb(235,242,255) - the second of which is a near
        # white, and PRESSWORK has no white: ZD_TEXT_0 is the top of the ink
        # ramp and nothing in the system is brighter than it.
        an_c = theme(TH_TEXT_5)
        if band(an_seed, 7) == 0 { an_c = theme(TH_TEXT_HI) }
        fill_rgb(ax + an_x, ay + an_y, 2, 2, an_c)
        an_i = an_i + 1
    }
    logo(ax + a_lx, ay + a_ly, "zlOS", 3, C_CYAN)
    return 0
}

# ---- Snake: a real, playable game -----------------------------------------
# The snake body is an array of grid cells - and the kernel subset has no
# arrays, so it lives in raw memory: one byte per cell coordinate, walked
# with poke8/peek8. This is what the raw-memory primitives were FOR.
SNAKE_X = 0x02000000    # memmap.h ZL_LOW_BASE - the zl low block, not a
                        # coincidence: 0x30000 was inside the raw-loaded kernel
SNAKE_Y = 0x02000200

# ---- THE APP CONTRACT, applied ---------------------------------------------
# snake_game() used to be 90 lines around `while alive == 1 { ... }`, and that
# loop was the whole problem: it owned the screen, it owned the keyboard, and
# it ended with "press any key" - the phrase this rewrite exists to delete. It
# is three functions now and none of them loops.
#
# THE FUNCTIONS AND THE STATE THIS PARAGRAPH DESCRIBED ARE GONE. It named
# snake_draw / snake_key / snake_step and was followed by twelve globals -
# s_len, s_dx, s_dy, s_fx, s_fy, s_score, s_alive, s_seed, s_gw, s_gh, s_next,
# s_died - plus SNAKE_CELL, SNAKE_RATE and SNAKE_MAX. Every one of them had
# exactly ONE mention in the whole tree: its own declaration.
#
# The game that ships is sn_draw / sn_event at :7673, on sn_gw, sn_gh, sn_len,
# sn_dx, sn_dy, sn_fx, sn_fy, sn_score - a complete parallel set of names. This
# block is its predecessor, kept alive only by the comment above it, which read
# as documentation for the live game and described a dead one.
#
# SNAKE_X and SNAKE_Y STAY. They are the body's raw memory and the live game
# pokes them at :7718; they are also check-memmap.sh's anchors and ruler_zl's
# origin. Only the state that nothing reads goes.


# Size the board from the CLIENT AREA it was given, once, when the window
# opens. Recomputing it every frame would move the walls under a running snake
# if the window were resized, which is a worse bug than a board that does not
# refill a grown window.

# w/a/s/d and the arrow keys. A reversal into your own neck is refused, which
# is why each turn checks the axis it is leaving.

# ONE STEP, and only when the clock says so. Returns 1 if anything moved, which
# is how wm.c knows to repaint without this function drawing a single pixel -
# app_tick MUST NOT DRAW. That separation is what lets the snake keep playing
# while another window is dragged over it.

# Repaint the whole board from the raw arrays. Called only when damaged, and
# every coordinate derives from ax,ay - drag the window and the board goes with
# it, with nothing baked in.

# ---- paint, as an app - and it had to grow a CANVAS -------------------------
# The old paint drew each dab straight to the screen and never redrew. That is
# fine while it owns the whole display and nothing ever repaints, and it is
# fatal the moment a window can be dragged across it: the compositor repaints
# from damage, and there was nothing to repaint FROM. Exactly the problem
# term.c's scrollback solved for the shell.
#
# So the strokes are kept. Not a pixel buffer - 800x500 bytes would be 400,000
# peek8 calls per repaint and zl dispatches builtins through a linear strcmp
# chain, so a frame would take seconds. A capped list of DABS is bounded work:
# PAINT_MAX rects per repaint, once, when damaged.
#
# One 32-bit word per dab, because raw memory is all there is: x in 12 bits,
# y in 12, colour index in 8. 4096 is well past any client area this runs in.
# The coordinates are CLIENT-RELATIVE, which is what makes the drawing follow
# the window when you drag it instead of staying where the pixels were.
# It starts exactly where the zl low block ends, and that IS a dependency, not a
# coincidence: move ZL_LOW_END and this has to move with it or it lands inside
# the block. So it is declared as a mirror and check-memmap-mirror.py enforces
# it. Beyond here, 15 MiB to HI_IMG 0x03000000 is undeclared spare.
PAINT_BUF = 0x02100000  # memmap.h ZL_LOW_END - starts where the zl low block ends
PAINT_MAX = 2000

p_col  = 2
p_n    = 0

fn paint_pack(px, py, pc) { return px + py * 4096 + pc * 16777216 }

# THE PAINT PALETTE IS CONTENT, NOT CHROME, and that is why these seven survive
# the sweep that took every other literal out of this file. A theme role answers
# "what does this element MEAN"; a paint colour answers "which crayon did the
# person pick", and routing it through the theme would mean the user's red
# changes when the theme does. The rule the palette gate enforces is that no
# design.h TOKEN may have a second copy here - none of these is one.
fn paint_col(idx) {
    if idx == 1 { return rgb(230, 90, 90) }
    if idx == 2 { return rgb(120, 220, 140) }
    if idx == 3 { return rgb(240, 210, 110) }
    if idx == 4 { return rgb(110, 170, 245) }
    if idx == 5 { return rgb(215, 130, 235) }
    if idx == 6 { return rgb(110, 225, 230) }
    return rgb(235, 242, 255)
}

# A dab, in client coordinates. Refuses silently ONLY when full, and says so on
# the canvas rather than quietly dropping strokes forever.
fn paint_dab(cx, cy) {
    if p_n >= PAINT_MAX { return 0 }
    poke32(PAINT_BUF + p_n * 4, paint_pack(cx, cy, p_col))
    p_n = p_n + 1
    return 1
}

fn paint_clear() { p_n = 0  return 1 }

fn paint_key(code) {
    if code == 32 { return paint_clear() }
    if code >= 49 { if code <= 55 { p_col = code - 48  return 1 } }
    return 0
}

fn paint_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    pt_i = 0
    while pt_i < p_n {
        pt_w = peek32(PAINT_BUF + pt_i * 4)
        pt_c = idiv(pt_w, 16777216)              # idiv: a channel byte
        pt_y = band(pt_w / 4096, 4095)
        pt_x = band(pt_w, 4095)
        fill_rgb(ax + pt_x, ay + pt_y, 5, 5, paint_col(pt_c))
        pt_i = pt_i + 1
    }
    text_aa(ax + 6, ay + ah - cell_h(), "1-7 colour   space clears", theme(TH_TEXT_DIM))
    if p_n >= PAINT_MAX { text_aa(ax + 6, ay + 6, "canvas full", theme(TH_DANGER)) }
    return 0
}

# ---- persistent storage scratch -------------------------------------------
# A page of scratch for zlfs's small reads and writes. It sits far below the
# DMA arena map at the top of fb.c - bg 128 MiB, sp 160, sched 176, back 192,
# nvme 208, xhci 224, virtio-gpu 240. 32 MiB + 192 KiB collides with none of
# them, which is the check this project's recurring bug says to do every time.
# 0x02040000, NOT 0x02030000, which is LINE_BUF.
#
# HIST_BUF ends at 0x02032000 and PAINT_BUF starts at 0x02100000. This sits
# clear of both, and the largest
# use below is a clipboard write of cbn bytes.
DISK_SCRATCH = 0x02040000

# The Files app's typed-name field. It has to be a real address rather than a
# zl variable because the kernel subset has no runtime string values or
# arrays - see EDIT_BUF above for the same reason. DISK_SCRATCH is documented
# as "a page" (4096 bytes) and is never asked to hold more than a 4096-byte
# clipboard write, so one full page of headroom sits between the two: this
# starts at DISK_SCRATCH + 0x2000, not DISK_SCRATCH + 0x1000, on purpose.
# FS_NAME_MAX bytes (fs.c) is enough for the longest name fs_create will
# ever accept - check-memmap.sh's discovery sweep covers the dupe check, and
# it is registered in that script's sized list too. EDIT_BUF follows on the
# next page and is also generously clear of PAINT_BUF at 0x02100000.
FILES_NAME_BUF = 0x02042000
# ---- app suite: fixed buffers -----------------------------------------------
# One page (0x1000 = 4096 bytes) PER CONSUMER, deliberately generous rather
# than packed - a previous attempt at this suite put several boards in one
# undersized shared buffer and the maze (needs 273 cells) silently overran it.
# A dedicated page per board makes that class of bug impossible by
# construction: nobody's growth can ever reach a neighbour's byte 0, because
# every neighbour starts a full page away.
#
# Base picked clear of everything else in this range (checked against every
# .c and .zl file in the tree, not just kernel.zl - see the comment at
# DISK_SCRATCH above for why that matters): PAINT_BUF ends near 0x02102000,
# virtio_net.c's own arena doc puts its NET_FLOOR at 0x03000000, so this
# block (0x02200000..0x02216000, 88 KiB) sits in the middle of the same
# "80 MiB hole" with well over 0xDE0000 bytes of headroom on either side.
# check-memmap.sh's dupe sweep covers every constant below because they are
# declared here, in kernel.zl, rather than in the modules that use them.
TT_BOARD      = 0x02200000   # apps_games1.zl: Tic-Tac-Toe,  3x3  =  9 cells
LIGHTS_BOARD  = 0x02201000   # apps_games1.zl: Lights Out,   5x5  = 25 cells
C4_BOARD      = 0x02202000   # apps_games1.zl: Connect Four, 7x6  = 42 cells
RV_BOARD      = 0x02203000   # apps_games1.zl: Reversi,      8x8  = 64 cells
FIFTEEN_BOARD = 0x02204000   # apps_games1.zl: 15 Puzzle,    4x4  = 16 cells
MINE_BOARD    = 0x02205000   # apps_games2.zl: Minesweeper, 12x9  = 108 cells
G2048_BOARD   = 0x02206000   # apps_games2.zl: 2048,         4x4  = 16 cells
SIMON_SEQ     = 0x02207000   # apps_games2.zl: Simon,        sequence, max 32
MAZE_BOARD    = 0x02208000   # apps_games2.zl: Maze, 21x13 = 273 cells (the
# count the brief names) - own page, nothing
# else can ever share it
WG_BOARD      = 0x02209000   # apps_games2.zl: Word Guess,   6x5  = 30 cells
LIFE_BOARD    = 0x0220A000   # apps_games2.zl: Conway's Life,24x18= 432 cells
LIFE_NEXT     = 0x0220B000   # apps_games2.zl: ...next generation, scratch
PT_PATTERN    = 0x0220C000   # apps_utils.zl:  Pattern Tester, the pattern
PT_TEXT       = 0x0220D000   # apps_utils.zl:  Pattern Tester, the subject
DIFF_A        = 0x0220E000   # apps_utils.zl:  Line Diff, side A
DIFF_B        = 0x0220F000   # apps_utils.zl:  Line Diff, side B
HASH_BUF      = 0x02210000   # apps_utils.zl:  Checksum, the input bytes
NOTES_BUF     = 0x02211000   # apps_utils.zl:  Sticky Notes (2 pages)
FILES_BUF     = 0x02213000   # apps_system.zl: Files, one entry's bytes
RASTER_RING   = 0x02215000   # kernel.zl: the raster strip's history, one byte
# per composite. Declared HERE rather than
# beside the strip that reads it, because this
# is the block check-memmap.sh's dupe sweep
# walks - a fixed address declared anywhere
# else in this file is a fixed address nothing
# checks against its neighbours.
PAL_QUERY     = 0x02216000   # kernel.zl: the command palette's typed query,
# one byte per character, PAL_QMAX long
MAZE_STACK    = 0x02214000   # apps_games2.zl: Maze generation's OWN stack -
# an iterative backtracker, not a 273-deep zl
# recursion. boot.S:36 documents this kernel's
# 256 KiB compositor stack as already having
# overflowed once at 16 KiB because "the zl
# compositor nests deep... each zl frame is
# large"; carving a maze from inside a click
# handler (itself several frames into the
# frame loop) is exactly that nesting, so the
# DFS stack is 273 u16 cell indices in RAM
# instead, same idea as the board itself.

# ---- a text editor --------------------------------------------------------
# The text lives in a raw memory buffer, one byte per character. Typing
# appends, backspace removes, enter inserts a newline; the whole buffer is
# re-rendered each keystroke (buffers are small). This is a TempleOS-style
# "the OS edits text" feature, written entirely in zl.
# This used to be 0x00040000: unreserved low memory below every loader's kernel
# placement. Nothing in the memory map protected it, so firmware/loader data or
# a growing raw image could overwrite the editor (and editor typing could
# overwrite them) without check-memmap.sh seeing either side. Keep it in the
# declared 32..33 MiB ZL_LOW block, after DISK_SCRATCH's exact one-page extent
# and FILES_NAME_BUF. Its 8000 bytes end at 0x02044F40, before PAINT_BUF.
EDIT_BUF = 0x02043000
EDIT_MAX = 8000

# redraw_editor was here - it cleared the screen with fill_rect(0, 34, px_w(),
# ...), positioned with goto_row() and emitted through sc(), all of which are
# console operations anchored to the display rather than to a window. Replaced
# by editor_draw, which takes a rectangle.

# ---- the editor, as an app -------------------------------------------------
# Held until last, as the task list asks, because it has the most state to
# hoist - and in the end that turned out to be two numbers. EDIT_BUF was
# already raw memory; what was really tangled was the DRAWING, which went
# through the console (cls, at, goto_row, sc, row(), col()) and so was anchored
# to the screen rather than to a rectangle. A console cursor is not something
# an app_draw can be position-pure about.
#
# ESC still saves and exits - but "exits" now means the window CLOSES, which is
# the same thing every other window means by it. No "press any key".
ed_slot = 0
ed_len  = 0
ed_dirty = 0
# Set by the first refused close, cleared by anything that resolves the state.
# The second close in a row discards - see app_can_close.
ed_discard_armed = 0
ED_PAGE = 8                        # lines a page key moves the view

fn editor_open_disk(slot) {
    if fs_ok() == 0 { return 0 }
    if fs_inuse(slot) == 0 { return 0 }
    if fs_bytes(slot) >= EDIT_MAX { return 0 }
    fill_mem(EDIT_BUF, 0, EDIT_MAX)
    ed_len = fs_rd(slot, EDIT_BUF, EDIT_MAX - 1)
    ed_slot = slot
    ed_dirty = 0
    ed_scroll = 0
    ed_discard_armed = 0
    return 1
}

fn editor_open_default() {
    if files_ensure_mounted() == 0 { return 0 }
    fs_nclear()
    fs_npush(47)   fs_npush(117)  fs_npush(115)  fs_npush(101)
    fs_npush(114)  fs_npush(47)   fs_npush(110)  fs_npush(111)
    fs_npush(116)  fs_npush(101)  fs_npush(115)  fs_npush(46)
    fs_npush(116)  fs_npush(120)  fs_npush(116)
    edi = fs_get()
    if edi < 0 { edi = fs_new(EDIT_MAX) }
    if edi < 0 { return 0 }
    return editor_open_disk(edi)
}

fn editor_save() {
    # THE SINK CHECKS ITS TARGET TOO. Refusing the delete upstream closes the
    # only route in the tree today, but ed_slot is an index held across an
    # arbitrary amount of time and fs_write_impl guards only that the slot is in
    # use - it has no identity check, so a free-and-reuse from any future caller
    # would land this buffer on another file's bytes.
    #
    # This cannot tell "reused by someone else" from "still mine" - zl has no
    # string values, so the name cannot be compared - but it does catch the slot
    # being emptied, which is the first half of every such sequence. Refusing on
    # a freed slot is cheap and turns a silent overwrite into a message.
    if fs_ok() == 0 { note_say("no volume mounted - nothing to save to", 500)  return 0 }
    if fs_inuse(ed_slot) == 0 {
        note_say2("the file is gone", "its directory slot was freed - saving now could land on another file", 900)
        return 0
    }
    fs_stamp_now()
    if fs_wr(ed_slot, EDIT_BUF, ed_len) == 0 {
        note_say("file save failed", 400)
        return 0
    }
    if fs_sync() == 0 {
        note_say("file flush failed - not durable", 500)
        return 0
    }
    ed_dirty = 0
    note_say("file saved to zlfs", 240)
    return 1
}

# One key. Returns 1 if it changed anything, 2 if the editor is done.
fn editor_key(code) {
    # A BINARY FILE IS NOT EDITABLE, AND UNTIL NOW ONLY THE DRAWING CODE KNEW.
    #
    # ed_is_binary() was consulted in editor_draw and nowhere else, so the well
    # said "no text preview" while every printable keystroke still appended to
    # EDIT_BUF - invisibly, since the binary branch draws no caret and no text -
    # and ESC or Ctrl+S then wrote the mutated buffer back over the file. A
    # user could destroy a binary by opening it and leaning on the keyboard,
    # with the pane showing nothing at all.
    #
    # The reference's binary state is a dead end by construction: a head, a
    # well and one button, with no editable surface in the branch. This OS had
    # reached the state that branch exists to PREVENT, from the other side.
    #
    # ESC still closes, because after this guard there is nothing to save.
    if ed_is_binary() == 1 {
        if code == 27 { return 2 }
        return 0
    }
    # SCROLLING BACK THROUGH WHAT WAS TYPED. The view is tail-anchored, so these
    # only ever move BACKWARDS from the caret - ed_scroll is how far back, and 0
    # means "showing the caret". Clamped against the real line count so a page
    # key cannot walk the view off the top of a short buffer.
    #
    # ed_rows needs the well height, which this function does not have and must
    # not guess; ED_PAGE is a fixed step for that reason, and the draw clamps
    # what it is actually able to show. A wrong guess here would show as a jump,
    # not as corruption.
    if code == K_PGUP_K {
        # No cap here: this function has neither the well's height nor its
        # width, and capping against ed_lines() - the newline count - was wrong
        # for any wrapped buffer. ed_top clamps at the draw, where both are
        # known and where the wrap rule already lives.
        ed_scroll = ed_scroll + ED_PAGE
        return 1
    }
    if code == K_PGDN_K {
        ed_scroll = ed_scroll - ED_PAGE
        if ed_scroll < 0 { ed_scroll = 0 }
        return 1
    }
    # ANY EDIT SNAPS BACK TO THE CARET. Typing into a buffer whose view is
    # parked twenty lines up would put the character somewhere the user cannot
    # see, which is the defect this viewport was added to remove.
    ed_scroll = 0
    # ANY KEY THAT REACHES THE BUFFER DISARMS THE DISCARD. Someone who is still
    # working has not confirmed anything, and an arm that outlives the moment it
    # was set is a trap.
    ed_discard_armed = 0
    # ESC SAVES ONLY WHAT WAS CHANGED.
    #
    # This called editor_save() unconditionally. fs_write is copy-on-write
    # ALWAYS - fs.c says so at the top of fs_write_impl, "every replacement is
    # copy-on-write, even when it fits the old run" - so opening a file and
    # pressing Escape without typing allocated a fresh run, copied every block,
    # synced, and bumped FE_MTIME. An untouched file got a new extent and a new
    # modified time for being looked at.
    #
    # ed_dirty already tracks the answer and the footer is drawing it in the
    # same frame. The refusal half is kept: a dirty buffer that cannot be
    # flushed still refuses to close, because alloc_run can genuinely fail on a
    # fragmented volume and closing would be the moment the edits are lost.
    if code == 27 {
        if ed_dirty == 0 { return 2 }
        if editor_save() == 1 { return 2 }
        note_say2("could not save", "the volume has no contiguous run this size - the window stays open", 900)
        return 1
    }
    if code == 19 {
        editor_save()
        return 1
    }
    # THE FAILURE HALF CAME FROM THE DEAD COPY BELOW. Three of these branches
    # existed twice in this function - Ctrl+S, Ctrl+C and Ctrl+V - and the first
    # of each pair returns, so the second copy was unreachable. The unreachable
    # Ctrl+C was the one that reported a FAILED copy; the live one said nothing
    # when the clipboard refused, so a buffer too big to copy looked identical
    # to a copy that worked.
    #
    # Two implementations of one key is a coin flip about which behaviour ships,
    # and this landed on the one missing the error path.
    if code == 3 {
        clip_new()
        ed_ci = 0
        while ed_ci < ed_len { clip_add(peek8(EDIT_BUF + ed_ci))  ed_ci = ed_ci + 1 }
        if clip_done() == 1 {
            note_say("document copied", 180)
        } else {
            note_say("copy failed - too big for the clipboard", 400)
        }
        return 1
    }
    if code == 22 {
        ed_pi = 0
        while ed_pi < clip_n() {
            if ed_len < EDIT_MAX - 1 {
                poke8(EDIT_BUF + ed_len, clip_ch(ed_pi))
                ed_len = ed_len + 1
                ed_dirty = 1
            }
            ed_pi = ed_pi + 1
        }
        return 1
    }
    # THREE UNREACHABLE BRANCHES WERE HERE - a second Ctrl+S, Ctrl+C and Ctrl+V,
    # each already handled above with a return, along with the comments arguing
    # for them. They are deleted rather than left: a reader who finds the second
    # copy first reads behaviour that has never run, and the pair drifted apart
    # exactly as you would expect - one reported a failed copy and the other did
    # not. The surviving Ctrl+C now carries that failure branch.
    if code == 8 {
        if ed_len > 0 { ed_len = ed_len - 1  poke8(EDIT_BUF + ed_len, 0)  ed_dirty = 1 }
        return 1
    }
    if code == 13 {
        if ed_len < EDIT_MAX - 1 { poke8(EDIT_BUF + ed_len, 10)  ed_len = ed_len + 1  ed_dirty = 1 }
        return 1
    }
    if code >= 32 {
        if ed_len < EDIT_MAX - 1 { poke8(EDIT_BUF + ed_len, code)  ed_len = ed_len + 1  ed_dirty = 1 }
        return 1
    }
    return 0
}

# ---- the Files app, as a window --------------------------------------------
# zlfs already exists (fs.c) and could only be driven from the shell, one
# typed character at a time, by NUMBER - '.' to mount, ',' to list, and no way
# at all to create, open or delete a file BY NAME without going through the
# editor's numbered RAM slots. This is the window: it mounts zlfs the moment
# it opens (no manual step), lists what is already there, and turns typed
# text into fs_new/fs_get/fs_rm calls the same way the '.' and "'" shell
# commands already stage a name a character at a time - see FILES_NAME_BUF's
# comment for why that has to be a real address rather than a zl array.
fl_len     = 0           # characters typed into the name field, 0..23
fl_hover   = 0 - 1        # the row the pointer is over, or -1
fl_pressed = 0            # edge-detect for click-to-open - see files_event

# Auto-mount, silently on the happy path. A window opening is not a
# diagnostic and should not spam the shell scrollback every time it is
# opened - contrast the '.' command, which is a deliberate request to be told
# what happened and is untouched by this. Mirrors '.'s own
# setup-then-mount sequence. Formatting is an explicit destructive action.
fn files_ensure_mounted() {
    if fs_ok() == 1 { return 1 }
    if nv_setup() == 0 { return 0 }
    return fs_mount()
}

fn disk_list() {
    color(C_CYAN)  print("  zlfs files:")
    color(C_GREY)
    if files_ensure_mounted() == 0 {
        color(C_RED)  print("    no positively identified zlfs volume")
        color(C_GREY) return 0
    }
    di = 0
    dn = 0
    while di < fs_max() {
        if fs_inuse(di) == 1 {
            put("    ")
            dj = 0
            while dj < 24 {
                dc = fs_ch(di, dj)
                if dc > 0 { emit(dc) }
                dj = dj + 1
            }
            put("  ")  put(fs_bytes(di))  print(" bytes")
            dn = dn + 1
        }
        di = di + 1
    }
    if dn == 0 { print("    empty") }
    return dn
}

# An app with no text-mode form. Says which one and why, rather than doing
# nothing - a command that silently returns is this repo's most expensive
# recurring bug, and "the app list offers it but nothing happens" is exactly
# that shape.
fn needs_wm(what) {
    color(C_GREY)  put("  ")
    color(C_WHITE) put(what)
    color(C_GREY)  print(" runs in a window - it needs the framebuffer console")
    return 0
}

fn run_command(cmd, arg) {
    if cmd == 104 { help()  return 0 }
    if cmd == 14 {
        color(C_CYAN)  print("  64-bit user process")
        color(C_GREY)
        if files_ensure_mounted() == 0 {
            color(C_RED)  print("    no positively identified zlfs volume")
            color(C_GREY) return 0
        }
        ur = user_file()
        if ur == 0 {
            color(C_GREEN) print("    /system/user.bin exited; desktop alive")
        } else {
            color(C_RED)
            if ur == 0 - 2 { print("    /system/user.bin does not exist") } else {
                if ur == 0 - 3 { print("    image must be 1..4096 raw x86-64 bytes") } else {
                    put("    process refused/faulted: ")  print(ur)
                }
            }
        }
        color(C_GREY)
        return 0
    }
    if cmd == 202 {                       # wifi - safe AX201 transport inventory
        color(C_CYAN)  print("  Intel AX201 Wi-Fi transport")
        color(C_GREY)
        print("    read-only probe: no reset, no firmware, no association")
        diag_mark(220)
        wf_probe = wifi_probe()
        diag_mark(221)
        if wf_probe == 0 {
            color(C_RED)
            print("    exact 8086:02f0 QuZ device/CSR snapshot not available")
            color(C_YELLOW)
            print("    this is a safe refusal; no Wi-Fi device register was written")
            color(C_GREY)
            return 0
        }
        color(C_GREEN)
        put("    device:       8086:")  hex(wifi_dev(), 4)  print(" AX201 / QuZ")
        color(C_GREY)
        put("    BAR0:         0x")  hex(wifi_bar_hi(), 8)
        hex(wifi_bar_lo(), 8)  print("")
        put("    HW revision:  0x")  hex(wifi_hwrev(), 8)
        put("  type 0x")  hex(wifi_hwtype(), 3)  print("")
        put("    RF ID:        0x")  hex(wifi_rfid(), 8)  print("")
        put("    HW interface: 0x")  hex(wifi_hwif(), 8)  print("")
        put("    GP control:   0x")  hex(wifi_gp(), 8)  print("")
        put("    GPIO/reset:   0x")  hex(wifi_gpio(), 8)
        put(" / 0x")  hex(wifi_reset(), 8)  print("")
        put("    INT/mask:     0x")  hex(wifi_int(), 8)
        put(" / 0x")  hex(wifi_imask(), 8)  print("")
        put("    MAC CSR raw:  0x")  hex(wifi_mac0(), 8)
        put(" / 0x")  hex(wifi_mac1(), 8)  print("")
        color(C_YELLOW)
        print("    transport identified; Wi-Fi is NOT connected yet")
        color(C_GREY)
        print("    next gate: API-77 firmware boot and ALIVE, still bounded/manual")
        return 0
    }
    if cmd == 200 {                       # diag - persistent observer status
        # The physical boot stick reappears a couple of seconds after xHCI is
        # reset. Do one bounded mount attempt before reporting RAM-only so the
        # status command describes the state now, not the transient first
        # scan from the start of boot.
        if diag_on() == 0 { diag_up() }
        color(C_CYAN)  print("  flight recorder")
        color(C_GREY)
        ds_active = diag_on()
        if ds_active == 1 {
            color(C_GREEN)  print("    mode:       ACTIVE - validated ZLLOG USB journal")
        } else {
            color(C_YELLOW) print("    mode:       RAM-ONLY - no validated ZLLOG USB target")
        }
        color(C_GREY)
        put("    buffered:   ")  print(diag_buf())
        put("    dropped:    ")  print(diag_drop())
        put("    last error: ")  print(diag_err())
        if diag_err() == 1 {
            put("    MSC init:   stage ")  put(msc_istage())
            put(" port ")  put(msc_iport())
            put(" slot ")  put(msc_islot())
            put(" xHCI cc ")  print(msc_icc())
            put("    USB id:     ")  hex(msc_ivid(), 4)
            put(":")  hex(msc_ipid(), 4)  print("")
            if msc_iport() > 0 {
                put("    PORTSC:     0x")  hex(usb_portsc(msc_iport()), 8)  print("")
            }
            put("    USBSTS/CMD: 0x")  hex(usb_sts(), 8)
            put(" / 0x")  hex(usb_cmd(), 8)  print("")
        }
        return 0
    }
    if cmd == 201 {                       # diagsave - explicit durable flush
        # A failed early enumeration is not permanent. Retry the complete,
        # read-only validation once here before refusing; the normal frame loop
        # also retries with bounded backoff, so no command is required.
        if diag_on() == 0 { diag_up() }
        if diag_on() == 0 {
            color(C_RED)
            print("  save REFUSED - no validated ZLLOG USB target")
            color(C_YELLOW)
            print("    evidence remains buffered in RAM; nothing else was written")
            color(C_GREY)
            put("    buffered: ")  put(diag_buf())
            put("  dropped: ")    put(diag_drop())
            put("  error: ")      print(diag_err())
            if diag_err() == 1 {
                put("    MSC init stage ")  put(msc_istage())
                put(" port ")  put(msc_iport())
                put(" slot ")  put(msc_islot())
                put(" xHCI cc ")  print(msc_icc())
                if msc_iport() > 0 {
                    put("    PORTSC 0x")  hex(usb_portsc(msc_iport()), 8)
                }
                put(" USBSTS 0x")  hex(usb_sts(), 8)
                put(" USBCMD 0x")  hex(usb_cmd(), 8)  print("")
            }
            return 0
        }
        ds_before = diag_buf()
        if diag_save() == 1 {
            color(C_GREEN)
            put("  saved flight-recorder evidence to ZLLOG USB; buffered ")
            put(ds_before)  put(" -> ")  print(diag_buf())
        } else {
            color(C_RED)
            print("  save FAILED - evidence remains buffered in RAM")
            color(C_GREY)
            put("    buffered: ")  put(diag_buf())
            put("  dropped: ")    put(diag_drop())
            put("  error: ")      print(diag_err())
        }
        color(C_GREY)
        return 0
    }
    if cmd == 102 { color(C_WHITE)  put("  ")  print(fib(arg))  color(C_GREY)  return 0 }
    if cmd == 115 { color(C_WHITE)  put("  ")  print(sum_squares(arg))  color(C_GREY)  return 0 }
    if cmd == 116 {                      # t - uptime from the timer IRQ
        color(C_GREY)  put("  uptime: ")
        color(C_WHITE) put(ticks() / 100)  color(C_GREY)  put(" s  (")
        color(C_WHITE) put(ticks())        color(C_GREY)  print(" ticks at 100 Hz)")
        return 0
    }
    if cmd == 98  {                       # b - colour bars, with a little chime
        beep(880, 8)  beep(1174, 8)  beep(1568, 12)
        return colorbars()
    }
    if cmd == 112 {                       # p - CPU brand string via CPUID
        color(C_GREY)  put("  CPU: ")
        color(C_WHITE)
        i = 0
        while i < 48 {
            b = cpu_char(i)
            if b > 0 { emit(b) }
            i = i + 1
        }
        print("")
        color(C_GREY)
        return 0
    }
    if cmd == 101 {                       # e - beep
        color(C_GREY)  print("  beep!")
        beep(1000, 15)
        return 0
    }
    if cmd == 80 {                        # P - light the panel with OUR driver
        color(C_CYAN)  print("  taking the panel with our own modeset")
        color(C_GREY)
        print("    you are reading this on the loader's framebuffer.")
        print("    after this, every pixel is scanned out by a mode this")
        print("    driver programmed, over a link it trained itself.")
        print("")
        ii = intel_find()
        if ii < 0 {
            color(C_RED)   print("    no Intel GPU here - nothing to take")
            color(C_GREY)  return 0
        }
        if intel_ok() == 0 {
            color(C_RED)   print("    not a Gen9 part - refusing")
            color(C_GREY)  return 0
        }
        fb = panel_up()
        if fb == 0 {
            color(C_RED)
            put("    bring-up FAILED at plan step ")  print(panel_step())
            color(C_GREY)
            print("    the loader's framebuffer is untouched. nothing is lost.")
            return 0
        }
        color(C_GREEN)
        put("    the panel is ours. framebuffer at 0x")  hex(fb, 8)  print("")
        color(C_GREY)
        print("    press a key to move the console onto it")
        # `key()` USED TO BE HERE AND NOTHING DEFINES IT. zl resolves calls by
        # name at runtime, so it is not a link error - it falls through the
        # builtin table to kfatal("builtin not available in the kernel
        # subset"), which halts the machine. On the one path where that is most
        # expensive: the panel has just been brought up by our own driver on
        # the real ThinkPad, and the next statement moves the console onto it.
        # Caught by check-zlcalls.py, which exists because of this class.
        pk = 0
        while pk == 0 { pk = key_get()  idle() }
        panel_console()
        color(C_GREEN)
        print("  this text is being scanned out by our own driver.")
        color(C_GREY)
        return 0
    }
    if cmd == 107 {                       # k - the hardware, as the bus reports it
        color(C_CYAN)  print("  PCI bus scan")
        color(C_GREY)
        pci_scan()
        pn = 0
        while pn < pci_count() {
            put("    ")
            put(pci_vendor(pn))  put(":")  put(pci_device(pn))
            put("   class ")     print(pci_class(pn))
            pn = pn + 1
        }
        put("    devices found: ")  print(pci_count())
        print("")
        color(C_CYAN)  print("  Intel graphics (our own driver)")
        color(C_GREY)
        ii = intel_find()
        if ii < 0 {
            print("    no Intel GPU on this machine (expected in a VM)")
        } else {
            put("    device 0x")  print(intel_id())
            if intel_ok() == 1 {
                print("    generation:    Gen9/9.5 - supported")
                put("    MMIO  (BAR0):  0x")  hex(intel_mmio(), 8)  print("")
                put("    aperture:      0x")  hex(intel_aper(), 8)  print("")
                put("    stolen memory: ")    put(intel_ssize() / 1048576)  print(" MiB")
                put("    GGTT size:     ")    put(intel_ggtt() / 1048576)   print(" MiB")
                put("    pipe A active: ")    print(intel_pipe())
                put("    plane enabled: ")    print(intel_plane())
                put("    live mode:     ")    put(intel_w())  put(" x ")  print(intel_h())
                put("    stride:        ")    put(intel_stride())  print(" bytes")
                put("    plane format:  ")    put(gpu_fmt())
                put("   tiling mode ")        print(gpu_tile())
                # the real video signal, blanking included
                put("    timing:        ")    put(gpu_ha())  put(" of ")  put(gpu_ht())
                put(" px  x  ")               put(gpu_va())  put(" of ")  put(gpu_vt())
                print(" lines")
                print("    measuring refresh against the PIT...")
                gmhz = gpu_hz()
                put("    refresh:       ")    put(gmhz / 1000)
                put(".")                      put((gmhz % 1000) / 100)
                print(" Hz")
                put("    pixel clock:   ")    put(gpu_clk() / 1000)  print(" MHz")
                put("    panel power:   ")    print(panel_on())
                gblm = bl_max()
                if gblm > 0 {
                    put("    backlight:     ")  put(bl_get() * 100 / gblm)
                    put("% of ")                put(gblm)  print(" PWM counts")
                }
                # ask the panel what it is, over the GPU's own I2C bus
                gep = edid_read()
                if gep > 0 {
                    color(C_GREEN)
                    put("    EDID read on GMBUS pin pair ")  print(gep)
                    color(C_GREY)
                    put("    panel:         ")
                    emit(edid_vc(0))  emit(edid_vc(1))  emit(edid_vc(2))
                    put(" product 0x")  hex(edid_prod(), 4)  print("")
                    put("    native mode:   ")  put(edid_w())  put(" x ")  print(edid_h())
                    put("    physical size: ")  put(edid_mmw())  put(" x ")
                    put(edid_mmh())  print(" mm")
                } else {
                    print("    no EDID on any GMBUS pin pair")
                }
                put("    scanning out:  0x")  print(intel_surf())
            } else {
                print("    not a Gen9 part - detected but not driven")
            }
        }
        print("")
        color(C_CYAN)  print("  display adapter")
        color(C_GREY)
        gi = gpu_find()
        if gi < 0 {
            print("    no PCI display adapter found")
        } else {
            put("    framebuffer at 0x")  hex(gpu_fb(), 8)  print("")
            put("    video memory:  ")    put(gpu_vram() / 1048576)  print(" MiB")
            if gpu_present() == 1 {
                put("    modesetting:   YES, BGA rev ")  print(gpu_version())
                put("    current mode:  ")  put(gpu_w())  put(" x ")  print(gpu_h())
            } else {
                print("    modesetting:   not supported by this adapter")
            }
        }
        return 0
    }
    if cmd == 110 {                       # n - switch resolution, live
        color(C_CYAN)  print("  modesetting with our own driver")
        color(C_GREY)
        nw = 1280
        nh = 800
        if px_w() == 1280 { nw = 1920  nh = 1200 }
        put("    switching to ")  put(nw)  put(" x ")  print(nh)
        if set_res(nw, nh) == 1 {
            put("    now ")  put(gpu_w())  put(" x ")  put(gpu_h())
            put(", pitch ")  print(gpu_pitch())
            layout()
            draw_screen()
            color(C_GREEN)  print("  mode set by zlOS, no BIOS involved")
            color(C_GREY)
        } else {
            color(C_RED)  print("    the card refused that mode")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 117 {                       # u - the USB controller, our driver
        color(C_CYAN)  print("  USB host controller (xHCI)")
        color(C_GREY)
        ui2 = usb_find()
        if ui2 < 0 {
            print("    no xHCI controller found on the PCI bus")
        } else {
            put("    xHCI version  0x")  hex(usb_ver(), 4)   print("")
            put("    MMIO at       0x")  hex(usb_mmio(), 8)  print("")
            put("    device slots: ")    print(usb_slots())
            put("    root ports:   ")    print(usb_ports())
            put("    context size: ")    put(usb_ctxsz())  print(" bytes")
            if usb_ram() == 0 {
                color(C_RED)
                print("    the DMA arena at 224 MiB is not backed by RAM")
                color(C_GREY)
                return 0
            }
            # usb_up() is idempotent: it resets and builds our rings only if we
            # do not already own the controller. Re-resetting here would throw
            # away a working keyboard, which is exactly what we came for.
            ukb = usb_up()
            if usb_ours() == 1 {
                color(C_GREEN)
                print("    controller reset, rings up, RUNNING - it is ours")
                color(C_GREY)
                if usb_noop() == 1 {
                    color(C_GREEN)
                    print("    no-op command completed - DMA path proven")
                    color(C_GREY)
                } else {
                    color(C_RED)  print("    no-op did not complete")
                    color(C_GREY)
                }
            } else {
                color(C_RED)  print("    could not take the controller")
                color(C_GREY)
                return 0
            }
            put("    devices attached: ")  print(usb_count())
            up = 1
            while up <= usb_ports() {
                if usb_conn(up) == 1 {
                    put("      port ")  put(up)
                    put(" connected, speed ")  put(spname(usb_speed(up)))
                    # stage 4: reset the port, take a slot, address the device
                    # and read the descriptor that says what it actually is
                    uslot = usb_enum(up)
                    if uslot > 0 {
                        color(C_GREEN)
                        put("  -> slot ")  put(uslot)
                        put(" addr ")      print(usb_addr())
                        color(C_GREY)
                        put("        USB ")  hex(usb_uver(), 4)
                        put("  vendor ")     hex(usb_vid(), 4)
                        put(":")             hex(usb_pid(), 4)
                        put("  class ")      hex(usb_cls(), 2)
                        put("  ep0 mps ")    print(usb_mps())
                    } else {
                        color(C_RED)  print("  -> enumeration failed")
                        color(C_GREY)
                    }
                }
                up = up + 1
            }
            if ukb > 0 {
                color(C_GREEN)
                put("    HID boot keyboard on slot ")  put(ukb)
                put(", endpoint dci ")                 print(usb_kbd_ep())
                print("    keystrokes now come from OUR driver - try 'j'")
                color(C_GREY)
            } else {
                print("    no HID boot keyboard on this bus")
            }
        }
        return 0
    }
    if cmd == 106 { return usbkey_demo() }   # j - USB keyboard, live
    if cmd == 61 {                        # = - the input stack, live
        color(C_CYAN)  print("  input events")
        color(C_GREY)
        print("    every key press, release and character, with modifiers.")
        print("    try caps lock, ctrl, shift, arrows, and holding a key.")
        print("    MOVE THE MOUSE too - the pointer rate is printed once a")
        print("    second, and that number is the pointer's speed ceiling:")
        print("    a USB mouse sends at most 127 counts per report.")
        print("    ESC ends.")
        print("")
        iestop = ticks() + 3000
        # The drain rate, measured in the guest rather than inferred from a
        # bench. ptr_reports counts every report xhci.c decoded; the difference
        # over one second IS the rate, and reports/s * 127 is the fastest the
        # pointer can possibly travel. It read 1 per frame before the event
        # ring got a single owner - see docs/evidence/POINTER-EVIDENCE.md.
        ptrbase = ptr_reports()
        ptrnext = ticks() + 100
        while ticks() < iestop {
            if ticks() >= ptrnext {
                ptrnow = ptr_reports()
                color(C_CYAN)
                put("    pointer ")  put(ptrnow - ptrbase)
                put(" reports/s  ->  ceiling ")  put((ptrnow - ptrbase) * 127)
                put(" px/s   events ")  put(ptr_events())
                print("")
                color(C_GREY)
                ptrbase = ptrnow
                ptrnext = ticks() + 100
            }
            iet = in_next()
            if iet != 0 {
                iec = in_code()
                iem = in_mods()
                put("    ")
                if iet == 1 { put("down ") }
                if iet == 2 { put("up   ") }
                if iet == 3 { put("char ") }
                put("code 0x")  hex(iec, 4)
                if iec >= 32 {
                    if iec < 127 { put(" '")  emit(iec)  put("'") }
                }
                put("   mods")
                if band(iem, 1) != 0 { put(" shift") }
                if band(iem, 2) != 0 { put(" ctrl") }
                if band(iem, 4) != 0 { put(" alt") }
                if band(iem, 8) != 0 { put(" CAPS") }
                if iem == 0 { put(" -") }
                print("")
                if iet == 1 {
                    if iec == 0x101 {
                        print("    ESC - done")
                        return 0
                    }
                }
            }
        }
        print("    timed out")
        return 0
    }
    if cmd == 63 {                        # ? - the I2C touchpad
        color(C_CYAN)  print("  I2C-HID touchpad")
        color(C_GREY)
        # This command used to enumerate both controllers, reset the live bus,
        # probe 112 addresses and then spin for five seconds. During that loop
        # the compositor could not repaint or consume input, so the physical
        # laptop looked crashed. Automatic startup already owns the device;
        # diagnostics must observe that owner rather than compete with it.
        tp_service()
        if tp_devid() == 0 {
            print("    automatic startup has not found this laptop's LPSS I2C.")
            print("    QEMU has no LPSS I2C; on hardware, wait one second and retry.")
            return 0
        }
        put("    controller PCI 8086:")  hex(tp_devid(), 4)
        put(" at 0x")  hex(i2c_mmio(), 8)
        put("  COMP_TYPE 0x")  hex(i2c_ct(), 8)  print("")
        if tp_ptr() == 0 {
            color(C_RED)  print("    touchpad is not active")
            color(C_GREY)
            put("    TX_ABRT_SOURCE 0x")  hex(tp_abort(), 8)  print("")
            print("    this status command returned immediately; it did not re-probe.")
            return 0
        }
        color(C_GREEN)  print("    precision touchpad ACTIVE")  color(C_GREY)
        put("    HID device at I2C address 0x")  hex(tp_addr(), 2)  print("")
        put("    vendor ")  hex(tp_vid(), 4)
        put(":")            hex(tp_pid(), 4)
        put("  version ")   hex(tp_ver(), 4)  print("")
        put("    max input report ")  put(tp_maxin())
        put(" bytes, report descriptor ")  put(tp_rdlen())  print(" bytes")
        put("    LPSS reset 0x")  hex(tp_reset(), 8)
        put("  HCNT ")  put(tp_hcnt())
        put("  LCNT ")  print(tp_lcnt())
        put("    decoded reports: ")  put(tp_reports())
        put("  malformed: ")  print(tp_bad())
        print("    move the pad, then run i2c again to see the count increase.")
        return 0
    }
    if cmd == 47 {                        # / - USB mass storage
        color(C_CYAN)  print("  USB mass storage (SCSI over Bulk-Only Transport)")
        color(C_GREY)
        if usb_up() == 0 { }              # make sure the controller is ours
        mss = msc_up()
        if mss == 0 {
            print("    no bulk-only mass storage device on the bus")
            print("    add -device usb-storage,drive=... to QEMU")
            return 0
        }
        color(C_GREEN)
        put("    device on slot ")  put(mss)
        print(" - bulk IN and OUT endpoints configured")
        color(C_GREY)
        if msc_inq() == 1 {
            put("    INQUIRY:  ")
            mi = 8
            while mi < 36 { emit(msc_b(mi))  mi = mi + 1 }
            print("")
        } else {
            color(C_RED)  print("    INQUIRY failed")  color(C_GREY)
        }
        if msc_cap() == 1 {
            put("    capacity: ")  put(msc_mb())  put(" MiB in ")
            put(msc_blocks())  put(" blocks of ")  put(msc_bsize())  print(" bytes")
        } else {
            color(C_RED)  print("    READ CAPACITY failed")  color(C_GREY)
            return 0
        }
        if msc_read(0) == 1 {
            put("    block 0 first bytes: ")
            mi = 0
            while mi < 8 { hex(msc_b(mi), 2)  put(" ")  mi = mi + 1 }
            print("")
            # a real partitioned stick ends its first sector with 55 AA
            if msc_b(510) == 85 {
                if msc_b(511) == 170 {
                    color(C_GREEN)
                    print("    boot signature 55 AA - this is a real MBR")
                    color(C_GREY)
                }
            }
            color(C_GREEN)
            print("    read a sector off a USB stick with our own driver")
            color(C_GREY)
        } else {
            color(C_RED)  print("    READ(10) of block 0 failed")  color(C_GREY)
        }
        return 0
    }
    if cmd == 71 {                        # G - drive the GPU ring ourselves
        # THIS IS WHAT A USB BOOT IS FOR. The sequence below is proven on this
        # exact silicon from Linux (docs/drivers/display/gpu-driver.md: 16384/16384 pixels), but
        # never from inside zlOS - and there is no serial port on the ThinkPad,
        # so every number has to land on the SCREEN or the boot proves nothing.
        #
        # A COMMAND, not a boot step. If it wedges the GPU, a desktop that
        # already came up is worth more than one that never did.
        color(C_CYAN)  print("  GPU - our own ring on the blitter")
        color(C_GREY)
        print("    arming, mapping the GGTT, submitting one XY_COLOR_BLT...")
        gst = gpu_test()
        put("    RING_CTL 0x")   hex(gpu_ctl(), 8)
        put("   HEAD 0x")        hex(gpu_head(), 8)
        put("   TAIL 0x")        hex(gpu_tail(), 8)
        print("")
        put("    filled ")  put(gpu_filled())
        put(" of ")         put(gpu_want())
        put(" px, still poison ")  print(gpu_poison())
        if gst == 0 {
            color(C_GREEN)
            print("    THE GPU DREW IT. zlOS drove the ring itself.")
            if gpu_comp(1) == 1 {
                print("    compositor copy enabled; first 3 scenes will be hash-checked")
            } else {
                color(C_YELLOW)
                print("    compositor copy stayed off; mode/mapping was not safe")
            }
            color(C_GREY)
            return 0
        }
        color(C_RED)
        if gst == 1 { print("    step 1: no supported Intel GPU found") }
        if gst == 2 { print("    step 2: the ring would not enable (RING_CTL above)") }
        if gst == 3 { print("    step 3: GGTT mapping refused") }
        if gst == 4 { print("    step 4: the command would not encode") }
        if gst == 5 { print("    step 5: submitted, engine never caught up") }
        if gst == 6 { print("    step 6: engine ran but the pixels did not land") }
        color(C_GREY)
        print("    (the number IS the step - nothing else is needed to place it)")
        return 0
    }
    if cmd == 42 {                        # * - wake the other CPU cores
        color(C_CYAN)  print("  SMP - the other cores")
        color(C_GREY)
        put("    ACPI lists ")  put(smp_total())  print(" usable core(s):")
        smi = 0
        while smi < smp_total() {
            put("      core ")  put(smi)
            put(" has APIC id ")  print(smp_id(smi))
            smi = smi + 1
        }
        put("    trampoline is ")  put(smp_tsz())  print(" bytes, copied to 0x9000")
        print("    sending INIT then STARTUP to each...")
        smn = smp_go()
        put("    cores online now: ")  put(smn)
        put(" of ")  print(smp_total())
        if smn > 1 {
            color(C_GREEN)
            put("    they answered - APIC id bitmap 0x")  hex(smp_mask(), 8)
            print("")
            print("    the machine is running on more than one core")
            color(C_GREY)
            put("    APs park in HLT; disjoint framebuffer bands wake by IPI (")
            put(smp_jobs())  print(" completed so far)")
        } else {
            color(C_RED)  print("    no application processor answered")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 43 {                        # + - three tasks at once
        color(C_CYAN)  print("  multitasking")
        color(C_GREY)
        print("    three tasks, each counting at its own rate, plus this shell.")
        print("    every number below is a different stack.")
        print("")
        put("    tasks now runnable: ")  print(sched_go())
        mti = 0
        while mti < 12 {
            yield()
            put("    t=")   put(ticks())
            put("  A=")     put(counter(0))
            put("  B=")     put(counter(1))
            put("  C=")     put(counter(2))
            put("  switches=")  print(sched_sw())
            mts = ticks() + 25
            while ticks() < mts { yield() }
            mti = mti + 1
        }
        print("")
        color(C_GREEN)
        print("    all three advanced while the shell kept running.")
        color(C_GREY)
        return 0
    }
    if cmd == 111 {                       # o - NVMe storage, our driver
        color(C_CYAN)  print("  NVMe storage")
        color(C_GREY)
        if nv_find() < 0 {
            print("    no NVMe controller on the PCI bus")
            print("    add -device nvme,serial=zl,drive=... to QEMU")
            return 0
        }
        put("    MMIO at   0x")  hex(nv_mmio(), 8)  print("")
        put("    version   ")    hex(nv_ver(), 8)   print("")
        if nv_setup() == 0 {
            color(C_RED)  print("    controller did not come ready")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        print("    enabled, admin + I/O queues created - it is ours")
        color(C_GREY)
        put("    model:    ")
        nmi = 0
        while nmi < 40 { emit(nv_mb(nmi))  nmi = nmi + 1 }
        print("")
        put("    capacity: ")  put(nv_cap())  put(" MiB in ")
        put(nv_blocks())  put(" blocks of ")  put(nv_bsize())  print(" bytes")

        # The real proof: write a pattern to a block, read it back, compare.
        # This is a round trip through a DMA queue to actual storage.
        nvi = 0
        while nvi < 512 { nv_set(nvi, (nvi * 7 + 11) % 256)  nvi = nvi + 1 }
        if nv_write(1000, 0) == 0 {
            color(C_RED)  print("    write to LBA 1000 failed")
            color(C_GREY)  return 0
        }
        # scrub the buffer so a read that does nothing cannot look like success
        nvi = 0
        while nvi < 512 { nv_set(nvi, 0)  nvi = nvi + 1 }
        if nv_read(1000, 0) == 0 {
            color(C_RED)  print("    read back from LBA 1000 failed")
            color(C_GREY)  return 0
        }
        nvbad = 0
        nvi = 0
        while nvi < 512 {
            if nv_get(nvi) != (nvi * 7 + 11) % 256 { nvbad = nvbad + 1 }
            nvi = nvi + 1
        }
        if nvbad == 0 {
            color(C_GREEN)
            print("    wrote 512 bytes to LBA 1000, read them back, all match")
            print("    zlOS can store things that outlive it")
            color(C_GREY)
        } else {
            color(C_RED)
            put("    read back WRONG in ")  put(nvbad)  print(" of 512 bytes")
            color(C_GREY)
        }
        return 0
    }
    # . - zlfs: mount the disk, and prove a NAMED FILE survives a power cycle.
    #
    # The 'o' command above already writes a block and reads it back, which
    # proves the DMA round trip and nothing about persistence: it never
    # reboots. This keeps a counter in a file called "boots" and increments it
    # once per run, so the number on screen is the number of times this machine
    # has been powered on since the volume was formatted. That number cannot be
    # produced by a cache, a buffer or a lucky read - only by bytes that were
    # on the platter before this kernel existed.
    #
    # verify-disk.sh drives exactly this, twice, against the same image file.
    if cmd == 46 {
        color(C_CYAN)  print("  zlfs on NVMe")
        color(C_GREY)
        if nv_setup() == 0 {
            color(C_RED)
            put("    no usable NVMe controller (fault ")  put(nv_fault())  print(")")
            color(C_GREY)  return 0
        }
        if fs_mount() == 0 {
            # THE SAME MISDIAGNOSIS THE FILES PANE HAD, WIRED TO AN INSTANT
            # ERASE AND WITH NO CONFIRMATION AT ALL.
            #
            # This printed "no volume here yet - formatting" and called
            # fs_format() whenever the mount failed - for any of the TEN causes
            # fs_mount_impl can fail from. The Files app at least asked twice.
            # A volume whose superblock checksum is bad is not a volume that is
            # absent, and fs.c says so in as many words on the way out:
            # "the volume is damaged, not empty. Nothing was read." Typing
            # `format` on that disk destroyed it and told you it had been empty.
            #
            # fs_format is fs_mkfs_impl, which zeroes the superblock FIRST, by
            # its own comment, so a failed reformat cannot leave a mountable
            # half-volume. There is no undo and no confirmation on this path.
            if fs_why() != FS_WHY_UNFORMATTED {
                color(C_RED)
                print("    the mount was refused and the disk is NOT blank - refusing to format")
                put("    cause ")  put(fs_why())  print(" - see 02 FILES for what it means")
                color(C_GREY)  return 0
            }
            print("    no volume here yet - formatting")
            if fs_format() == 0 {
                color(C_RED)  print("    format failed")
                color(C_GREY)  return 0
            }
            if fs_mount() == 0 {
                color(C_RED)  print("    formatted, but will not mount")
                color(C_GREY)  return 0
            }
        }
        put("    mounted: ")  put(fs_n())  put(" file(s), ")
        put(fs_free())  put(" of ")  put(fs_cap())  print(" blocks free")

        # find "boots", or make it. The name is pushed one character at a
        # time because the zl kernel subset has no string values.
        fs_nclear()
        fs_npush(98)  fs_npush(111)  fs_npush(111)  fs_npush(116)  fs_npush(115)
        bi = fs_get()
        if bi < 0 { bi = fs_new(4) }
        if bi < 0 {
            color(C_RED)  print("    could not create 'boots'")
            color(C_GREY)  return 0
        }

        poke32(DISK_SCRATCH, 0)
        fs_rd(bi, DISK_SCRATCH, 4)
        bootn = peek32(DISK_SCRATCH) + 1
        poke32(DISK_SCRATCH, bootn)
        if fs_wr(bi, DISK_SCRATCH, 4) == 0 {
            color(C_RED)  print("    could not write 'boots'")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        put("    BOOTCOUNT=")  print(bootn)
        color(C_GREY)
        print("    that number came off the disk, not out of memory")
        # ...and say so on the desktop too. A toast is the right shape for
        # this: it is worth knowing and not worth a window.
        note_say("zlfs mounted", 300)
        # AND TELL THE FILES PANE, WHICH OTHERWISE NEVER FINDS OUT.
        #
        # A window's client is a RETAINED surface: it is re-rendered when
        # something invalidates it, not every frame. Mounting a volume from the
        # shell changes what files_draw would draw and damages nothing, so the
        # pane went on showing "no zlfs volume is mounted / the disk is present
        # and unformatted" over a mounted, freshly formatted disk - and the only
        # way to clear it was to move the window. Caught by screenshotting after
        # a successful format and reading the pane rather than the terminal.
        if files_win >= 0 { if wm_is_open(files_win) == 1 { files_refresh()  wm_dmg(files_win) } }
        return 0
    }
    # ; - the real time, off the CMOS clock. The header draws this too, but the
    # header only exists when there is a framebuffer, and verify.sh boots with
    # -display none. This is how the clock gets gated.
    if cmd == 59 {
        color(C_CYAN)  print("  the clock")
        color(C_GREY)
        if rtc_here() == 0 {
            color(C_RED)  print("    no RTC on this machine")
            color(C_GREY)  return 0
        }
        if rtc_up() == 0 {
            color(C_RED)
            put("    the clock would not settle (reason ")  put(rtc_why())  print(")")
            color(C_GREY)  return 0
        }
        put("    RTC=")
        put(rtc_y())   put("-")
        if rtc_mo() < 10 { put("0") }   put(rtc_mo())  put("-")
        if rtc_d()  < 10 { put("0") }   put(rtc_d())   put(" ")
        if rtc_h()  < 10 { put("0") }   put(rtc_h())   put(":")
        if rtc_mi() < 10 { put("0") }   put(rtc_mi())  put(":")
        if rtc_s()  < 10 { put("0") }   print(rtc_s())
        put("    epoch=")  print(rtc_epoch())
        # ONE TIME BASE FOR mtime, AND IT IS SECONDS SINCE MIDNIGHT.
        #
        # This called fs_stamp(rtc_epoch()) - seconds since 1970 - while
        # fs_stamp_now() stamps seconds since midnight, and both write the same
        # static in fs.c that becomes FE_MTIME. So running `;` once poisoned
        # every later file write with a ~1.79e9 stamp, and the Files column
        # renders it as idiv(secs, 3600) = about 497,000 hours: clock_field
        # draws all six digits but advances by only two cells, so the colon and
        # the minutes were printed on top of the overflow.
        #
        # Seconds-since-midnight is the honest domain here - this kernel has no
        # epoch anywhere else, and the column shows hh:mm - so the epoch reading
        # stays as something the shell PRINTS and stops being something it
        # writes into the filesystem.
        fs_stamp_now()
        return 0
    }
    # ' - write the clipboard to a file on disk, as "clip.txt".
    #
    # This is the half of the clipboard that makes the point. The editor puts
    # bytes there with Ctrl+C and has no idea what happens to them; this takes
    # them and writes them to the filesystem and has no idea where they came
    # from. Two programs that share nothing but one buffer - which is the
    # difference between a machine and several programs on one screen.
    if cmd == 39 {
        color(C_CYAN)  print("  clipboard -> disk")
        color(C_GREY)
        if clip_n() == 0 {
            print("    the clipboard is empty - copy something first (Ctrl+C in the editor)")
            return 0
        }
        if fs_ok() == 0 {
            print("    no volume mounted - press . first")
            return 0
        }
        # stage the name "clip.txt" a character at a time
        fs_nclear()
        fs_npush(99)  fs_npush(108) fs_npush(105) fs_npush(112)
        fs_npush(46)  fs_npush(116) fs_npush(120) fs_npush(116)
        cbi = fs_get()
        if cbi < 0 { cbi = fs_new(clip_n()) }
        if cbi < 0 {
            color(C_RED)  print("    could not create clip.txt")
            color(C_GREY)  return 0
        }
        # copy the clipboard into scratch RAM, then hand the disk one address
        cbn = clip_n()
        cbj = 0
        while cbj < cbn { poke8(DISK_SCRATCH + cbj, clip_ch(cbj))  cbj = cbj + 1 }
        if fs_wr(cbi, DISK_SCRATCH, cbn) == 0 {
            color(C_RED)  print("    the write failed")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        put("    wrote ")  put(cbn)  print(" bytes of clipboard to clip.txt")
        color(C_GREY)
        note_say("clipboard saved", 300)
        return 0
    }
    # , - list what is on the disk, by NAME
    if cmd == 44 {
        color(C_CYAN)  print("  zlfs")
        color(C_GREY)
        if fs_ok() == 0 {
            print("    no volume mounted - press . first")
            return 0
        }
        lsi = 0
        while lsi < fs_max() {
            if fs_inuse(lsi) == 1 {
                put("    ")
                lsc = 0
                while lsc < 24 {
                    lsb = fs_ch(lsi, lsc)
                    if lsb > 0 { emit(lsb) }
                    lsc = lsc + 1
                }
                put("  ")  put(fs_bytes(lsi))  put(" bytes at LBA ")
                print(fs_lba(lsi))
            }
            lsi = lsi + 1
        }
        put("    ")  put(fs_n())  put(" file(s), ")
        put(fs_free())  print(" blocks free")
        return 0
    }
    if cmd == 122 {                       # z - the processor, read from itself
        color(C_CYAN)  print("  the processor, via CPUID and the MSRs")
        color(C_GREY)
        put("    vendor:   ")
        cvi = 0
        while cvi < 12 { emit(cpu_vb(cvi))  cvi = cvi + 1 }
        print("")
        put("    family ")  put(cpu_fam())
        put("  model ")     put(cpu_mod())
        put("  stepping ")  print(cpu_step())
        put("    topology: ")  put(cpu_cores())  put(" core(s), ")
        put(cpu_thr())  put(" thread(s), ")
        put(cpu_tpc())  print(" per core")
        put("    this core is APIC id ")  print(cpu_apicid())
        put("    clock:    ")  put(cpu_mhz())  put(" MHz (TSC ")
        put(cpu_khz())  put(" kHz")
        if cpu_inv() == 1 { put(", invariant") }
        print(")")
        cci = 0
        while cci < 6 {
            if cpu_ctype(cci) != 0 {
                put("    cache L")  put(cpu_clevel(cci))
                if cpu_ctype(cci) == 1 { put(" data       ") }
                if cpu_ctype(cci) == 2 { put(" instruction") }
                if cpu_ctype(cci) == 3 { put(" unified    ") }
                put("  ")  put(cpu_ckb(cci))  print(" KiB")
            }
            cci = cci + 1
        }
        put("    features: ")
        if cpu_sse2() == 1   { put("sse2 ") }
        if cpu_sse42() == 1  { put("sse4.2 ") }
        if cpu_avx() == 1    { put("avx ") }
        if cpu_avx2() == 1   { put("avx2 ") }
        if cpu_aes() == 1    { put("aes ") }
        if cpu_rdrand() == 1 { put("rdrand ") }
        print("")
        ctc = cpu_temp()
        if ctc > 0 { put("    temperature: ")  put(ctc)  print(" C") }
        if cpu_hv() == 1 {
            put("    running under a hypervisor: ")
            chi = 0
            while chi < 12 { emit(cpu_hvb(chi))  chi = chi + 1 }
            print("")
        } else {
            print("    running on bare metal - no hypervisor bit")
        }
        return 0
    }
    if cmd == 121 {                       # y - virtio-gpu, a real GPU driver
        color(C_CYAN)  print("  virtio-gpu")
        color(C_GREY)
        if vg_find() < 0 {
            print("    no virtio-gpu on the PCI bus")
            print("    add -device virtio-gpu-pci to QEMU to see this work")
            return 0
        }
        if vg_init() == 0 {
            color(C_RED)  print("    the device refused our feature negotiation")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        print("    virtqueue up, DRIVER_OK - the device is ours")
        color(C_GREY)
        put("    scanouts: ")  print(vg_scan())
        if vg_info() == 0 {
            color(C_RED)  print("    GET_DISPLAY_INFO failed")
            color(C_GREY)  return 0
        }
        put("    display:  ")  put(vg_w())  put(" x ")  print(vg_h())
        put("    create_2d:      ")  put(vg_c2d(1, vg_w(), vg_h()))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        put("    attach_backing: ")  put(vg_attach(1, vg_w() * vg_h() * 4))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        put("    set_scanout:    ")  put(vg_scanout(1, vg_w(), vg_h()))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        vgfb = vg_fb()
        put("    framebuffer bound at 0x")  hex(vgfb, 8)  print("")
        # Draw straight into GPU memory and flush it. Every pixel here crossed
        # a virtqueue as a real GPU command.
        if vg_test() == 1 {
            color(C_GREEN)
            print("    TRANSFER_TO_HOST_2D + RESOURCE_FLUSH acknowledged")
            print("    pixels drawn through a real GPU command queue")
            color(C_GREY)
        } else {
            color(C_RED)  print("    flush failed")
            color(C_GREY)
        }
        return 0
    }
    # v/x/a/d are APPS now: under the compositor open_app() gives each one a
    # window before run_command is ever reached, and there is no text-mode
    # version of any of them - they were all full-screen graphical loops.
    if cmd == 118 { return needs_wm("the 3D cube") }
    if cmd == 119 { return wm_session() }    # w - the real compositor (wm.c)
    # THE COMMAND PALETTE, and it needs the compositor: an overlay is drawn by
    # the compositor's paint walk, so in text mode there is nothing to draw it
    # onto. Saying so is better than opening a modal nobody can see.
    # The context menu at a fixed point, for rendering and for gates. It opens
    # a third of the way across the field so it is clear of the rail and of the
    # boot composition's windows.
    # The register's apps by name, so each can be put on screen for checking.
    # reg_open is the click path - raise if open, else open with focus.
    if cmd == 210 { if wm_run() == 0 { return needs_wm("the kernel log") }  return reg_open(40) }
    if cmd == 211 { if wm_run() == 0 { return needs_wm("the hex viewer") }  return reg_open(42) }
    if cmd == 212 { if wm_run() == 0 { return needs_wm("the calculator") }  return reg_open(33) }
    if cmd == 213 { if wm_run() == 0 { return needs_wm("the network pane") }  return reg_open(50) }
    if cmd == 214 { if wm_run() == 0 { return needs_wm("clocks") }  return reg_open(31) }
    if cmd == 215 { if wm_run() == 0 { return needs_wm("disk usage") }  return reg_open(46) }
    if cmd == 216 { if wm_run() == 0 { return needs_wm("system info") }  return reg_open(32) }
    if cmd == 218 { if wm_run() == 0 { return needs_wm("the system pane") }  return open_syspane() }
    if cmd == 217 { if wm_run() == 0 { return needs_wm("the type pane") }  return open_typepane() }
    if cmd == 219 { if wm_run() == 0 { return needs_wm("the monitor") }  return reopen_mon() }
    if cmd == 220 { if wm_run() == 0 { return needs_wm("settings") }  return reg_open(APP_SETTINGS) }
    if cmd == 221 { if wm_run() == 0 { return needs_wm("the font atlas") }  return reg_open(45) }
    if cmd == 222 { if wm_run() == 0 { return needs_wm("the renderer") }  return reg_open(APP_REND) }
    if cmd == 223 { if wm_run() == 0 { return needs_wm("the image viewer") }  return reg_open(APP_IMG) }
    if cmd == 224 { if wm_run() == 0 { return needs_wm("the archive manager") }  return reg_open(APP_ARCH) }
    if cmd == 206 {
        if wm_run() == 0 { return needs_wm("the lock sheet") }
        ov_mode = OV_LOCK
        wm_damage(0, 0, px_w(), px_h())
        return 0
    }
    if cmd == 205 {
        if wm_run() == 0 { return needs_wm("activities") }
        ov_mode = OV_ACTIVITIES
        ov_sel = 0
        wm_damage(0, 0, px_w(), px_h())
        return 0
    }
    if cmd == 204 {
        if wm_run() == 0 { return needs_wm("the context menu") }
        return desk_menu_at(rail_w() + field_w() / 3, px_h() / 4)
    }
    if cmd == 203 {
        if wm_run() == 0 { return needs_wm("the command palette") }
        pal_clear()
        ov_mode = OV_PALETTE
        ov_sel = 0
        # THE WHOLE SCREEN, because a modal scrims all of it. wm_damage takes
        # x,y,w,h - there is no wm_damage_all, and inventing one is a runtime
        # halt in zl rather than a compile error, which is how five invented
        # names once got as far as a boot.
        wm_damage(0, 0, px_w(), px_h())
        return 0
    }
    # x, a, d, i: apps-in-windows turned these four full-screen demos into
    # WINDOWED apps and deleted the full-screen bodies, so the old entry points
    # have nothing left to call. They open windows now, and refuse the same way
    # the cube already did when there is no compositor to open one in.
    if cmd == 120 { if wm_run() == 1 { return open_app(120, 0) }  return needs_wm("the pointer readout") }
    if cmd == 97  { if wm_run() == 1 { return open_app(97, 0) }   return needs_wm("the animation") }
    # SNAKE OPENS A WINDOW when there is a compositor to open it in, and falls
    # back to the old full-screen loop when there is not. That branch is the
    # shape every one of the seven demos wants (desktop-TODO 2e); snake is the
    # first because its state was already external.
    if cmd == 103 {
        if wm_run() == 1 { return open_app(103, 0) }
        return needs_wm("snake")
    }
    if cmd == 100 { if wm_run() == 1 { return open_app(100, 0) }  return needs_wm("paint") }
    if cmd == 105 { if wm_run() == 1 { return open_app(105, arg) } return needs_wm("the editor") }
    # M - the Files app: zlfs by name, in a window. Same shape as every other
    # windowed app above - text mode has no windows to put it in at all.
    if cmd == 77  { if wm_run() == 1 { return open_app(77, 0) }    return needs_wm("the Files app") }
    if cmd == 108 { return disk_list() }
    # 'N', not 'n': every lowercase code from a to z is already a command.
    if cmd == 78 { return net_gate() }    # N - the network card, and an ARP probe
    if cmd == 87 { return web_gate() }    # W - TCP + HTTP/1.0 against a real server
    if cmd == 69 { return real_gate() }   # E - a real website, by name, off the internet
    # A - All Applications. The catalog is the ONLY route to 47 of the 53
    # apps, and until the dock's grid button is fixed it has no pointer
    # route at all - which also means the fidelity oracle cannot open any
    # of them to photograph. A shell word is a route that does not depend
    # on chrome geometry being right, so it is the one the harness can
    # trust. Keep it even after the button works.
    if cmd == 65 { if wm_run() == 1 { return reg_open(APP_CATALOG) }  return needs_wm("the catalog") }
    if cmd == 83 { return tls_gate() }    # S - the same, over verified HTTPS
    if cmd == 114 {                       # r - reboot
        color(C_YELLOW)  print("  rebooting...")
        beep(1568, 6)  beep(784, 10)
        reboot()
        return 0
    }
    if cmd == 109 {
        # Whichever console is up owns different video memory: the text buffer
        # at 0xB8000, or the linear framebuffer. Poking VGA unconditionally
        # read back 255 on the desktop, because in a framebuffer mode nothing
        # decodes 0xB8000 and the write went nowhere.
        mv = vram()
        poke8(mv + 158, 42)
        poke8(mv + 159, 0x4E)
        color(C_GREY)  put("  wrote a byte to video memory, read back: ")
        color(C_WHITE) print(peek8(mv + 158))
        color(C_GREY)  return 0
    }
    # FRAME TIME, on serial as well as on screen. The System Monitor shows it,
    # but a picture of a number is not a number a gate can assert on - and the
    # brief's gate is that it AGREES with fbbench, which needs the figure
    # itself. Prints the TSC rate too, since the conversion depends on it and a
    # wrong rate is the obvious way this number could be plausible and wrong.
    if cmd == 70 {
        color(C_GREY)   put("  frame: ")
        color(C_WHITE)  put(wm_us())
        color(C_GREY)   put(" us avg over 16 painted frames   tsc ")
        put(cpu_khz())  print(" kHz")
        return 0
    }
    if cmd == 99  { draw_screen()  return 0 }
    # THE FRAME TIMER, readable from the shell - which is what lets a probe
    # measure it instead of a person squinting at the tray.
    if cmd == 11 {
        # ONE LINE, MACHINE-READABLE, with a marker a probe can wait for. The
        # first version printed "last N us   peak N us" and probe-frame.py
        # waited for "us" - which matched the FIRST one and returned before the
        # peak had arrived. A gate that stops reading halfway through its own
        # answer reports None and looks like a broken feature.
        color(C_WHITE)  put("  FRAMEUS ")  put(wm_us())  put(" ")
        put(wm_peak())  print(" END")
        # THE MISS COUNTS, on their own line so the regex above keeps working -
        # probe-frame.py waits for END and appending fields before it would have
        # broken a gate to add a number to it.
        #
        # late  painted frames over the budget    <- what a person sees
        # lost  16.667 ms deadlines skipped      <- what the pacing costs
        # of    painted frames since the reset    <- the honest denominator
        # ...and the terminator here must NOT contain "END". exercise.py's
        # Serial.wait() finds a marker as a SUBSTRING and leaves the rest of the
        # line in the buffer, so an "END2" would be matched by the next probe
        # that waits for "END" and hand it half of the previous answer. Measured:
        # probe-tray.py read None for its first sample until this said FIN.
        color(C_WHITE)  put("  FRAMEMISS late ")  put(wm_late())
        put(" lost ")  put(wm_lost())
        put(" of ")    put(wm_painted())
        put(" budget ")  put(wm_budget())  print(" FIN")
        color(C_GREY)  return 0
    }
    if cmd == 12 { wm_peak0()  print("  peak reset")  return 0 }
    if cmd == 13 {
        put("  PERF ")  print(wm_sn())
        pfi = 0
        while pfi < wm_sn() {
            put("  P ")  put(pfi)  put(" ")  put(wm_sf(pfi))  put(" ")  print(wm_si(pfi))
            pfi = pfi + 1
        }
        print("  PERFEND")
        return 0
    }
    # R - run a program the kernel was NOT built with. Typed only: `run` needs a
    # FILENAME, and the single-key path folds everything after the letter into a
    # decimal accumulator, so there is no character buffer on it to hold a word.
    # term.c has the whole line already and hands the text to exec.c in C.
    #
    # exec_run() takes no argument and returns a state code, never a name. That
    # is the whole safety property here: a filename that reached zl would meet
    # zl_binop, which hard-faults on ANY string operand before it ever gets to
    # `==`, so the natural way to write this in zl compiles clean and halts the
    # machine. exec.c does the comparing.
    if cmd == 82 {
        exec_run()
        # The window is opened only for a request that named something. `run`
        # with no filename is a usage error and gets its line and nothing else;
        # a window that says "you forgot the argument" is noise. Anything that
        # names a file gets the window, because from Item 2 on that window is
        # where the program lives - and a window that only ever appears on the
        # success path is a window nobody has tested.
        if exec_window() == 1 { open_run_window() }
        return 0
    }
    # Dedicated destructive diagnostic, intentionally absent from help. The
    # typed word `crashtest` is mapped to a non-printable command code by
    # term.c, so the old single-key shell cannot trigger it accidentally. It
    # never returns: vector 6 must produce a ZLCRASH record and halt.
    if cmd == 127 { crash_test()  return 0 }
    if cmd == 113 { return 1 }
    color(C_RED)  print("  unknown command - press h for help")
    color(C_GREY) return 0
}

# ONE window, reused. `run` twice should not leave two windows on the desktop,
# and wm.c's table is WM_MAX=12 deep - a new window per invocation runs it out
# in twelve commands and then fails silently, which is the failure shape this
# project keeps paying for.
run_win = 0 - 1
fn open_run_window() {
    if wm_avail() == 0 { return 0 }
    u = ui()
    if run_win >= 0 {
        if wm_is_open(run_win) == 1 {
            wm_raise(run_win)
            wm_dmg(run_win)
            # focus goes back below, for the same reason as on the open path
            wm_setfocus(shell_win)
            return 0
        }
    }
    run_win = wm_open(APP_RUN, exec_title(), 90 * u, 90 * u, 320 * u, 110 * u)
    wm_report(run_win)
    # ZPOP. A Run box is a popover in every sense except modality - it cannot
    # be modal, because the keys have to keep reaching the terminal (see
    # below) - so it does not get the fade from wm_modal and asks for it here.
    # 5 is ANIM_FADE; ui.h names it.
    wm_anim(run_win, 5)
    # AND HAND THE KEYBOARD STRAIGHT BACK. wm_open focuses whatever it just
    # opened, so without this the run window holds focus, app_event has no
    # APP_RUN branch, and every subsequent keystroke is dropped - the terminal
    # goes dead and looks for all the world like the compositor crashed.
    #
    # This is not a new discovery, it is the SAME bug the comment above
    # app_event records: three wm_opens at startup left About focused and the
    # shell untypeable. It was fixed there with an explicit wm_focus and it has
    # to be fixed the same way at every later wm_open, because "wm_open steals
    # focus" is a property of wm.c, not of that one call site.
    #
    # Focus does not imply raise (wm.c), so the run window stays on top and the
    # keys still go to the terminal - which is what someone who just typed a
    # command into that terminal expects.
    #
    # probe-run.py asserts this by typing `fib 20` afterwards and requiring
    # 6765. Without the line below that assertion fails, which is how it was
    # found rather than reasoned about.
    wm_setfocus(shell_win)
    return 0
}

# a live System Monitor window: the real CPUID brand, a memory bar, tick count
# and a sparkline - drawn with the same window chrome as everything else
fn draw_sysmon(sx, sy, sfoc) {
    u = ui()
    draw_window(sx, sy, MON_W * u, MON_H * u, "System Monitor", sfoc)
    sysmon_body(sx, sy + TITLE_H * u, MON_W * u, (MON_H - TITLE_H) * u)
    return 0
}

# The CONTENTS, with no frame. Split out so the compositor can draw the chrome
# itself and hand this only its client area - the app contract in ui.h requires
# app_draw to be position-pure, and this already was: every coordinate here is
# derived from sx,sy. Nothing is baked in.
# =============================================================================
# 03 SYSTEM MONITOR
#
# THE REFERENCE ASKS FOR TWO THINGS THIS KERNEL CANNOT MEASURE, and the whole
# design of this pane is what to print instead.
#
# 1. FOUR PER-CORE CPU PERCENTAGES. Nothing in this kernel counts per-core busy
#    time. smp.c exports smp_cpu_count / smp_online / smp_mask / smp_band_wakes
#    and there is no idle accounting anywhere, so a percentage would have to be
#    computed from nothing. What IS real per core: whether it came up, its APIC
#    id, and how many band wakes it has completed. That is the table drawn here.
#    A meter reading 34.0 % would be a better-looking lie.
#
# 2. TEN NAMED PROCESSES WITH cpu %, rss AND wchan. There is no process model.
#    sched.c's task is { sp, state, ticks, wake_at, entry } - no name, no RSS,
#    no wchan, no pid - and it is EMPTY on a booted desktop, because sched_go()
#    is only reached from a shell command. The honest analogue is the window
#    table: live, selectable, already driven by the rail, and now carrying a
#    real per-window microsecond figure via wm_appus. The reference's process
#    list is mocked data; this one is the machine.
#
# The sampling note is re-labelled for the same reason. The reference says
# "1 Hz - 64 s history"; wm.c's ring is pushed once per PAINTED FRAME, not once
# per second, so at 60 Hz its 64 columns are about a second, not 64 of them.
# It says "per frame" and prints the count it actually has.

SM_PAD    = 12
SM_GAP    = 10
SM_METERH = 19                     # .meter
SM_TRACKH = 9                      # .mtrack
# 8, not 14. Three figures each gained a " ms" and the row stopped fitting -
# budget's unit was clipped by the column edge, which is the one figure on the
# row that is a quoted constant and so the one a reader is most likely to check.
SM_FIGGAP = 8
SM_SPARKH = 42                     # spark(hist, 300, 42, 100, --zd-steel)

fn sm_lab(lx, ly, lh, s) {
    ui_caps(lx, ly + (lh - ui_th(PW_SM)) / 2, s, theme(TH_TEXT_DIM), PW_SM)
    return 0
}

# A meter. design.h:659 - "these are INSTRUMENTS, so their fill is ZD_STEEL and
# never" the overprint - so the fill is TH_STEEL and the only other ink it may
# take is the warn colour, when the thing being metered is past its ceiling.
fn sm_meter(mx, my, mw, nm, val, vmax) {
    u = ui()
    mh = SM_METERH * u
    sm_lab(mx, my, mh, nm)
    mtx = mx + 86 * u
    mtw = mw - 86 * u - 58 * u
    mty = my + (mh - SM_TRACKH * u) / 2
    mth = SM_TRACKH * u
    fill_rgb(mtx, mty, mtw, mth, theme(TH_CUT))
    fill_rgb(mtx + 1, mty + 1, mtw - 2, mth - 2, theme(TH_SURF_WELL))
    mfw = 0
    if vmax > 0 { mfw = (mtw - 2) * val / vmax }
    if mfw > mtw - 2 { mfw = mtw - 2 }
    mcol = theme(TH_STEEL)
    if val * 5 > vmax * 4 { mcol = theme(TH_WARN) }
    if mfw > 0 { fill_rgb(mtx + 1, mty + 1, mfw, mth - 2, mcol) }
    mq1 = 0
    if vmax > 0 { mq1 = val * 1000 / vmax }
    my2 = my + (mh - ui_th(PW_SM)) / 2
    # BACKWARDS FROM THE RIGHT EDGE, unit first. Laid out forwards from a
    # guessed x the per-cent sign hung off the column the moment the reading
    # reached three digits - pw_sect's comment says exactly this and it is worth
    # obeying rather than rediscovering.
    muw = ui_tw(" %", PW_SM, PW_MONO)
    mnw = pw_decgw(mq1, 1, PW_SM, PW_MONO)
    pw_decg(mx + mw - muw - mnw, my2, mq1, 1, theme(TH_TEXT_2), PW_SM, PW_MONO)
    ui_txt(mx + mw - muw, my2, " %", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return my + mh
}

# The composite-time spark, over wm.c's real per-frame ring.
#
# THIS REPLACED A DRAWING. It was seven line() calls at fixed offsets
# -3, -1, -6, -3, -7, -4, -6: a shape with no data behind it, in an instrument,
# in a system whose entire argument is that its instruments are read. It filled
# with TH_ACCENT too, against the design.h rule quoted above.
#
# SCALED AGAINST THE BUDGET, NOT AGAINST THE TALLEST SAMPLE. A spark normalised
# to its own maximum always looks the same, which is the one thing a frame-time
# chart must never do: full height is wm_budget(), so a bar that reaches the top
# is a frame that spent its whole deadline, and the shape means something across
# two different runs.
fn sm_spark(gx, gy, gw, gh) {
    sn = wm_sn()
    fill_rgb(gx, gy, gw, 1, theme(TH_CUT))
    if sn < 1 { return 0 }
    bud = wm_budget()
    if bud < 1 { bud = 1 }
    cap = SPARK_MAX
    if sn < cap { cap = sn }
    # FULL HEIGHT IS THE BUDGET *OR* THE TALLEST SAMPLE, WHICHEVER IS LARGER.
    # It was the budget alone, which is right in intent - a spark normalised to
    # its own peak always looks the same - and wrong in exactly the case that
    # matters. Measured on this machine: min 18.3 ms against a 16.667 ms budget,
    # so EVERY bar clipped at full height and the chart was a solid block that
    # said only "over", never how far or whether it was getting worse. A chart
    # that saturates when the news is bad is a chart that stops working when you
    # start needing it.
    top = bud
    i = 0
    while i < cap {
        v = wm_sf(sn - cap + i)
        if v > top { top = v }
        i = i + 1
    }
    bw2 = gw / cap
    if bw2 < 1 { bw2 = 1 }
    i = 0
    while i < cap {
        v = wm_sf(sn - cap + i)
        bh = v * gh / top
        if bh > gh { bh = gh }
        if bh < 1 { bh = 1 }
        c = theme(TH_STEEL)
        if v > bud { c = theme(TH_WARN) }
        # bw2 - 1 IS THE GAP, AND AT bw2 == 1 IT IS THE WHOLE BAR. The clamp
        # above guarantees bw2 >= 1, so a narrow monitor drew every column
        # ZERO PIXELS WIDE and the spark vanished entirely - the one column
        # width at which the gap must be given up rather than the bar.
        bwid = bw2 - 1
        if bwid < 1 { bwid = 1 }
        fill_rgb(gx + i * bw2, gy + gh - bh, bwid, bh, c)
        i = i + 1
    }
    # The deadline, drawn where it actually falls now that the scale can exceed
    # it. Bars crossing this line are over budget and you can see by how much.
    bly = gy + gh - bud * gh / top
    fill_rgb(gx, bly, gw, 1, theme(TH_LIT))
    return 0
}

# THE WINDOW THE CHART ACTUALLY DRAWS. The reducers walked the whole 256-deep
# ring while sm_spark draws the last SPARK_MAX of it, so the printed min could
# be a frame that is not on the chart - a figure and a picture disagreeing about
# the same thing, side by side, with no way to tell from the screen.
fn sm_ring_span() {
    sn = wm_sn()
    if sn > SPARK_MAX { return SPARK_MAX }
    return sn
}

fn sm_ring_min() {
    sn = wm_sn()
    if sn < 1 { return 0 }
    i = sn - sm_ring_span()
    lo = 0 - 1
    while i < sn {
        v = wm_sf(i)
        if lo < 0 { lo = v }
        if v < lo { lo = v }
        i = i + 1
    }
    if lo < 0 { return 0 }
    return lo
}

fn sm_ring_mean() {
    sn = wm_sn()
    if sn < 1 { return 0 }
    i = sn - sm_ring_span()
    tot = 0
    while i < sn {
        tot = tot + wm_sf(i)
        i = i + 1
    }
    return tot / sm_ring_span()
}

# A label and its number, laid out left to right by measurement. Returns the x
# the next figure may start at, so a row of them cannot overlap however wide any
# one of them turns out to be.
# A READING WITHOUT ITS UNIT IS NOT A READING. The reference prints "min 6.2 ms",
# "mean 8.9 ms", "budget 16.667 ms"; this drew MIN 18.3 MEAN 20.1 BUDGET 16.667
# with no ms anywhere - in the one pane whose subject is instrument readings, and
# beside a spark whose whole point is that those numbers are milliseconds.
fn sm_fig(fx, fy, nm, v, dp, col) { return sm_figu(fx, fy, nm, v, dp, "", col) }

fn sm_figu(fx, fy, nm, v, dp, unit, col) {
    lw = ui_capsw(nm, PW_SM)
    ui_caps(fx, fy, nm, theme(TH_TEXT_DIM), PW_SM)
    nx = fx + lw + 5 * ui()
    # dp 0 IS A WHOLE NUMBER, not a number with nothing after the point.
    # pw_decg still draws the separator at dp 0, so a line count came out as
    # "1." - which reads as a truncated decimal, i.e. as a rendering fault.
    if dp == 0 {
        num_aa(nx, fy, v, col)
        ui_txt(nx + s3_numw(v), fy, unit, theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        return nx + s3_numw(v) + ui_tw(unit, PW_SM, PW_MONO) + SM_FIGGAP * ui()
    }
    pw_decg(nx, fy, v, dp, col, PW_SM, PW_MONO)
    ui_txt(nx + pw_decgw(v, dp, PW_SM, PW_MONO), fy, unit, theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return nx + pw_decgw(v, dp, PW_SM, PW_MONO) + ui_tw(unit, PW_SM, PW_MONO) + SM_FIGGAP * ui()
}

# THE IRQ TABLE, READ OFF THE IOAPIC.
#
# The reference prints eight rows - timer/i8042/xhci/e1000e/nvme q0/nvme q1/
# intel vbl/spurious - with counts and modes. Per-IRQ counters exist in this
# kernel only as zllog telemetry with NO READ-BACK: zllog.h exposes no counter
# getter and no native binds one, so every count in that table would have to be
# invented. Four of its rows are MSI/MSI-X vectors besides, which the IOAPIC
# does not route at all, and one names e1000e where this config runs virtio-net.
#
# What IS readable is better than what the reference mocks: apic_redtbl(irq)
# returns the LIVE redirection entry for IRQ 0-15 - the vector actually
# programmed, the trigger and polarity actually set, and the mask bit actually
# in force. That is hardware state, read this frame, not a remembered list.
fn sm_irq_head(hx, hy, hw) {
    hy2 = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(pw_colx(hx, hw, 0) + pw_cellpx(), hy2, "irq", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 16), pw_colw(hw, 16), ui_capsw("gsi", PW_SM)), hy2, "gsi", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 32), pw_colw(hw, 16), ui_capsw("vec", PW_SM)), hy2, "vec", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 50) + pw_cellpx(), hy2, "mode", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 76) + pw_cellpx(), hy2, "state", theme(TH_TEXT_DIM), PW_SM)
    fill_rgb(hx, hy + pw_headh() - 1, hw, 1, theme(TH_LIT))
    return hy + pw_headh()
}

fn sm_irq_row(rx, ry, rw, irq) {
    red = apic_red(irq)
    cy = pw_celly(ry)
    num_aa(pw_colx(rx, rw, 0) + pw_cellpx(), cy, irq, theme(TH_TEXT_2))
    num_aa(pw_right(pw_colx(rx, rw, 16), pw_colw(rw, 16), s3_numw(apic_gsi(irq))), cy, apic_gsi(irq), theme(TH_TEXT_DIM))
    vec = band(red, 255)
    num_aa(pw_right(pw_colx(rx, rw, 32), pw_colw(rw, 16), s3_numw(vec)), cy, vec, theme(TH_TEXT_2))
    # bit 15 is trigger, bit 13 is polarity - both as the IOAPIC holds them now
    if band(red, 32768) == 0 { ui_txt(pw_colx(rx, rw, 50) + pw_cellpx(), cy, "edge", theme(TH_TEXT_DIM), PW_SM, 0) } else { ui_txt(pw_colx(rx, rw, 50) + pw_cellpx(), cy, "level", theme(TH_TEXT_DIM), PW_SM, 0) }
    if band(red, 8192) != 0 { ui_txt(pw_colx(rx, rw, 62) + pw_cellpx(), cy, "lo", theme(TH_TEXT_DIM), PW_SM, 0) }
    # bit 16 is the mask. An armed line and a masked one look identical from
    # anywhere else in the system, which is the whole reason to print it.
    if band(red, 65536) == 0 { pw_sw(pw_colx(rx, rw, 76) + pw_cellpx(), cy, "ARMED", theme(TH_OK)) } else { pw_sw(pw_colx(rx, rw, 76) + pw_cellpx(), cy, "MASKED", theme(TH_TEXT_DIM)) }
    pw_row_rule(rx, ry, rw)
    return ry + pw_rowh()
}

# THE ONE FLOOR THE MONITOR'S LEFT COLUMN STOPS AT.
#
# `sy + sh - 8 * u` was written out at each of the three places that tested it,
# and the two places that should have tested it did not - which is exactly how
# the heap meter and the whole interrupt table came to be drawn past the client
# edge and scissored away. One expression, one name, five readers.
fn sm_core_floor(sy, sh, u) { return sy + sh - 8 * u }

fn sm_core_head(hx, hy, hw) {
    hy2 = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(pw_colx(hx, hw, 0) + pw_cellpx(), hy2, "core", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 30), pw_colw(hw, 30), ui_capsw("apic", PW_SM)), hy2, "apic", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 74) + pw_cellpx(), hy2, "state", theme(TH_TEXT_DIM), PW_SM)
    fill_rgb(hx, hy + pw_headh() - 1, hw, 1, theme(TH_LIT))
    return hy + pw_headh()
}

# One core. Every column is read: smp_id is the APIC id the AP actually
# reported, smp_jobs is band wakes completed, and "state" is whether this core
# came up at all - which is the question a four-percentage meter row silently
# answers "yes" to whether or not it is true.
fn sm_core_row(rx, ry, rw, i) {
    cy = pw_celly(ry)
    # `i < smp_n()` IS CORRECT HERE, AND I BROKE IT ONCE BY "FIXING" IT.
    #
    # An audit reported that comparing an index against a count would name the
    # wrong core if cores came up sparsely, and I replaced it with a smp_mask()
    # bit test without reading smp.c. smp_mask() is `ap_mask | 1u`, and ap_mask
    # is built as `ap_mask |= (1u << id)` where id is CPUID.1:EBX[31:24] - the
    # INITIAL APIC ID. It is keyed by APIC id and those are not dense; kernel.zl
    # prints the same value as "APIC id bitmap" elsewhere. Indexing it with a
    # loop counter reads the wrong bit.
    #
    # The slots ARE dense, and smp.c says so on the line that fills them:
    # "Claim a slot by arrival order, not by APIC id - ids are not dense and a
    # sparse array would leave the dispatcher spinning on a slot nobody owns."
    # slot = ap_online, and smp_online() is ap_online + 1. So cores 0..smp_n()-1
    # are exactly the ones that answered, and the count IS the membership test.
    on = 0
    if i < smp_n() { on = 1 }
    num_aa(pw_colx(rx, rw, 0) + pw_cellpx(), cy, i, theme(TH_TEXT_2))
    if on == 1 {
        num_aa(pw_right(pw_colx(rx, rw, 30), pw_colw(rw, 30), s3_numw(smp_id(i))), cy, smp_id(i), theme(TH_TEXT_2))
        pw_sw(pw_colx(rx, rw, 74) + pw_cellpx(), cy, "UP", theme(TH_OK))
    } else {
        ui_txt(pw_right(pw_colx(rx, rw, 30), pw_colw(rw, 30), ui_tw("-", PW_SM, PW_MONO)), cy, "-", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        # "DOWN" IN THE WARN COLOUR SAYS A CORE FAILED TO START. Nothing tried.
        # smp_start() has one caller in the tree - the smp_go native, reached
        # only from the `*` shell command - so on an ordinary boot ap_mask is 0
        # and every core but the BSP is reported as a failure. A core nobody
        # woke is not a core that did not wake, and colouring it warn invents an
        # incident. smp_ready() distinguishes the two.
        if smp_ready() == 1 { pw_sw(pw_colx(rx, rw, 74) + pw_cellpx(), cy, "DOWN", theme(TH_WARN)) } else { ui_txt(pw_colx(rx, rw, 74) + pw_cellpx(), cy, "not started", theme(TH_TEXT_DIM), PW_SM, 0) }
    }
    pw_row_rule(rx, ry, rw)
    return ry + pw_rowh()
}

fn sm_win_head(hx, hy, hw) {
    hy2 = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(pw_colx(hx, hw, 0) + pw_cellpx(), hy2, "z", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 12) + pw_cellpx(), hy2, "window", theme(TH_TEXT_DIM), PW_SM)
    # THE COLUMN THE `per window timing` SEGMENT SELECTS. usOf at proto:1606-1610
    # offers app-microseconds OR kilopixels-repainted OR nothing, and both
    # readings were already drawn here side by side with no way to choose. The
    # head follows the choice so a column cannot be headed one thing and filled
    # with another.
    if set_us == 0 {
        ui_caps(pw_right(pw_colx(hx, hw, 78), pw_colw(hw, 22), ui_capsw("app us", PW_SM)), hy2, "app us", theme(TH_TEXT_DIM), PW_SM)
    }
    if set_us == 1 {
        ui_caps(pw_right(pw_colx(hx, hw, 78), pw_colw(hw, 22), ui_capsw("kpx", PW_SM)), hy2, "kpx", theme(TH_TEXT_DIM), PW_SM)
    }
    fill_rgb(hx, hy + pw_headh() - 1, hw, 1, theme(TH_LIT))
    return hy + pw_headh()
}

# One window. app us is wm_appus(), the figure wm.c has measured per window with
# two rdtsc around the app call since app_draw_dispatch was written - and which
# nothing could read until wm_win_us was exported, so the settings pane printed
# the whole compositor frame under a per-window label instead.
fn sm_win_row(rx, ry, rw, zi) {
    w = wm_zat(zi)
    cy = pw_celly(ry)
    num_aa(pw_colx(rx, rw, 0) + pw_cellpx(), cy, zi, theme(TH_TEXT_DIM))
    ui_txt(pw_colx(rx, rw, 12) + pw_cellpx(), cy, app_name(wm_app(w)), theme(TH_TEXT_2), PW_SM, 0)
    if set_us == 0 {
        num_aa(pw_right(pw_colx(rx, rw, 78), pw_colw(rw, 22), s3_numw(wm_appus(w))), cy, wm_appus(w), theme(TH_TEXT_2))
    }
    if set_us == 1 {
        kpx = wm_cw(w) * wm_ch(w) / 1000
        num_aa(pw_right(pw_colx(rx, rw, 78), pw_colw(rw, 22), s3_numw(kpx)), cy, kpx, theme(TH_TEXT_2))
    }
    pw_row_rule(rx, ry, rw)
    return ry + pw_rowh()
}

fn sysmon_body(sx, sy, sw, sh) {
    u = ui()
    fill_rgb(sx, sy, sw, sh, theme(TH_PANEL))
    mx = sx + SM_PAD * u
    mw = sw - 2 * SM_PAD * u
    my = sy + SM_PAD * u

    # head: sampling / N samples, per frame / RUN
    hy = my + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(mx, hy, "sampling", theme(TH_TEXT_DIM), PW_SM)
    # THE SWATCH IS PLACED FIRST AND THE NOTE FITS AROUND IT. Laying the note
    # out forwards from a guessed x is how it ended up printed straight through
    # the RUN dot - the note's width changes with the sample count and the
    # swatch's changes with the word, so neither may be assumed.
    runw = pw_sww("RUN")
    if sm_run_live != 1 { runw = pw_sww("IDLE") }
    swx = mx + mw - runw
    runc = theme(TH_WARN)
    if sm_run_live == 1 { runc = theme(TH_OK) }
    if sm_run_live == 1 { pw_sw(swx, hy, "RUN", runc) } else { pw_sw(swx, hy, "IDLE", runc) }
    nwx = mx + ui_capsw("sampling", PW_SM) + 12 * u
    num_aa(nwx, hy, wm_sn(), theme(TH_TEXT_2))
    # "N PER COMPOSITED FRAME" READ AS A RATE AND IS A CEILING. wm_sn() is
    # sample_n, and wm.c stops it at WM_SAMPLE_N: `if (sample_n < WM_SAMPLE_N)
    # sample_n++`. A few seconds after boot this line says "256 per composited
    # frame" and never moves again - a fixed number wearing a rate's grammar,
    # in the pane whose whole subject is readings that change. What is true is
    # that the ring HOLDS that many, and that the chart below draws a window of
    # them.
    ui_txt(nwx + s3_numw(wm_sn()), hy, " frames held, ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    nwx2 = nwx + s3_numw(wm_sn()) + ui_tw(" frames held, ", PW_SM, PW_MONO)
    num_aa(nwx2, hy, sm_ring_span(), theme(TH_TEXT_2))
    ui_txt(nwx2 + s3_numw(sm_ring_span()), hy, " charted", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    my = my + pw_headh()

    # two columns, as the reference's .cols
    colw = (mw - SM_GAP * u) / 2
    lx = mx
    rx2 = mx + colw + SM_GAP * u
    ly = my
    ry2 = my

    # ---- left: the cores, then the one memory figure that is real ----------
    # SMP_JOBS IS GLOBAL AND WAS PRINTED PER ROW. smp_jobs takes no argument -
    # it is smp_band_wakes(), one counter for the machine - so calling it
    # smp_jobs(i) passed a core index that is ignored and printed the same total
    # on every core's line under a per-core heading. A global figure belongs in
    # the section head, once, where it cannot be read as four measurements.
    ly = pw_sect(lx, ly, colw, "cores", smp_jobs(), " band wakes")
    ly = sm_core_head(lx, ly, colw)
    # THE LOOP STOPPED AND NOTHING ELSE DID.
    #
    # This ran out of client and set `ci = cpu_thr()` to end - correctly - and
    # then the five statements after it drew UNCONDITIONALLY at an ly already
    # past `sy + sh`. The zl heap meter, the ioapic section head, the IRQ
    # column head and the IRQ rows were all emitted below the client rect and
    # scissored away by the compositor, so on a machine with more cores than
    # rows the memory meter and the WHOLE interrupt table vanished and nothing
    # on screen said a row had been dropped.
    #
    # THIS IS NOT A HYPOTHETICAL MACHINE. MON_H is 400 and about twelve core
    # rows fit; cpu_threads() reads the package's logical processor count from
    # CPUID leaf 0x0B, which is 16 or 32 on an ordinary desktop. QEMU is run
    # here with -smp 4, which is exactly why no probe in this tree ever saw it.
    #
    # kernel.zl:7486-7487 already states the rule: "anything shorter and
    # sys_body says on screen how many rows it had room for rather than quietly
    # truncating". The count is drawn, and the sections below it get the room
    # back - `sm_shown` is what the loop actually reached, so the line cannot
    # claim a number the loop did not draw.
    sm_shown = 0
    sm_stop = 0
    ci = 0
    while ci < cpu_thr() {
        if sm_stop == 1 { ci = cpu_thr() } else {
            if ly + pw_rowh() > sm_core_floor(sy, sh, u) { sm_stop = 1 } else {
                ly = sm_core_row(lx, ly, colw, ci)
                sm_shown = sm_shown + 1
                ci = ci + 1
            }
        }
    }
    if sm_shown < cpu_thr() {
        num_aa(lx, ly + 2 * u, sm_shown, theme(TH_WARN))
        ui_txt(lx + s3_numw(sm_shown), ly + 2 * u, " of ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        sm_ofx = lx + s3_numw(sm_shown) + ui_tw(" of ", PW_SM, PW_MONO)
        num_aa(sm_ofx, ly + 2 * u, cpu_thr(), theme(TH_TEXT_2))
        ui_txt(sm_ofx + s3_numw(cpu_thr()), ly + 2 * u, " cores - the pane is too short", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        ly = ly + pw_rowh()
    }
    ly = ly + 6 * u
    # NAMED FOR ITS SCOPE. The reference's meter says "memory" and reads as
    # machine RAM; heap_cap() is the fixed 64 MiB zl heap. Metering one and
    # labelling it the other is how a true number tells a false thing.
    # AND EVERYTHING BELOW ASKS FIRST. Each of these used to draw whatever ly
    # had become; now each is gated on there being room for it, so a pane that
    # runs out stops at a section boundary instead of emitting the rest into
    # the scissor.
    if ly + pw_rowh() <= sm_core_floor(sy, sh, u) {
        ly = sm_meter(lx, ly, colw, "zl heap", heap_used(), heap_cap())
    }
    ly = ly + 8 * u

    # apic_pins(), NOT THE LITERAL 16. This said 16 while apic_ioapic_pins()
    # already existed, already bound, reading the version register's
    # max-redirection-entry field at init. A written figure standing directly in
    # front of a read one, in the pane whose entire subject is read figures.
    sm_irq_room = 0
    if ly + 3 * pw_rowh() <= sm_core_floor(sy, sh, u) { sm_irq_room = 1 }
    if sm_irq_room == 1 {
        ly = pw_sect(lx, ly, colw, "ioapic lines", apic_pins(), " routable")
        ly = sm_irq_head(lx, ly, colw)
    }
    qi = 0
    while qi < 16 {
        if sm_irq_room == 0 { qi = 16 }
        if ly + pw_rowh() > sm_core_floor(sy, sh, u) { qi = 16 } else {
            if apic_red(qi) != 0 { ly = sm_irq_row(lx, ly, colw, qi) }
            qi = qi + 1
        }
    }

    # ---- right: composite time, then the live window table -----------------
    ry2 = pw_sect(rx2, ry2, colw, "composite time", wm_budget(), " us budget")
    sm_spark(rx2, ry2, colw, SM_SPARKH * u)
    ry2 = ry2 + SM_SPARKH * u + 5 * u
    fy = ry2
    fx = sm_figu(rx2, fy, "min", sm_ring_min() * 10 / 1000, 1, " ms", theme(TH_TEXT_2))
    fx = sm_figu(fx, fy, "mean", sm_ring_mean() * 10 / 1000, 1, " ms", theme(TH_TEXT_2))
    # budget at three decimals, because 16.667 ms is the figure the reference
    # prints and rounding it to 16.7 loses the point of quoting it at all
    sm_figu(fx, fy, "budget", wm_budget(), 3, " ms", theme(TH_TEXT_HI))
    ry2 = ry2 + ui_th(PW_SM) + 8 * u

    ry2 = pw_sect(rx2, ry2, colw, "windows", wm_n(), " open")
    ry2 = sm_win_head(rx2, ry2, colw)
    wi = 0
    while wi < wm_n() {
        if ry2 + pw_rowh() > sm_core_floor(sy, sh, u) { wi = wm_n() } else { ry2 = sm_win_row(rx2, ry2, colw, wi)  wi = wi + 1 }
    }
    return 0
}

# a small About window - the identity card, static content
fn draw_about(ax, ay, afoc) {
    u = ui()
    draw_window(ax, ay, AB_W * u, AB_H * u, "About", afoc)
    about_body(ax, ay + TITLE_H * u, AB_W * u, (AB_H - TITLE_H) * u)
    return 0
}

fn about_body(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    ui_label("zlOS 0.3")
    ui_dim("a desktop written in zl")
    ui_sep()
    ui_label("no OS   no libc   no GNU")
    ui_dim("type help for commands")
    return 0
}

# =============================================================================
# 10 SYSTEM and 14 TYPE - the two panes that grade the machine and the type
#
# THESE TWO ARE THE PROTOTYPE'S ARGUMENT, NOT ITS DECORATION. Everything else
# in PRESSWORK asserts: design.h says a ratio, a comment says an atlas exists.
# These two RECOMPUTE. The SYSTEM pane's contrast table runs WCAG against
# whatever ui_theme() resolved a moment ago, so turning the knockout off in 11
# SETTINGS moves four of its fourteen rows while you watch; the TYPE pane reads
# the font arrays' own dimensions with sizeof and reports what is in the image
# rather than what the design asked for. Where those two disagree - and they
# do, once - the pane prints the disagreement.
#
# NO NEW ARITHMETIC LIVES HERE. Contrast is ui_ratio(), which is uikit's
# ui_ratio_q4 - one WCAG table in the tree, x10^4 across the seam. The atlas
# facts are the atlas_* seven. This file's job is layout and honesty about
# units, and every number it prints arrives from one of those calls.
#
# WHY A TABLE ENGINE IN zl AT ALL. uikit.c has ui_colhead/ui_grid_row and they
# are not registered as zl builtins; registering six more widgets to draw two
# tables would be a wider seam than two panes are worth, and the prototype's
# `td` is four numbers deep - 15 of leading, 2+2 of padding, a 1px groove. So
# the rows are drawn from primitives here and the four numbers come from
# design.h through the constants below.
# =============================================================================

# The type scale and flag word, mirroring ui.h's UI_SM / UI_MD / UI_LG and
# UI_F_MONO / UI_F_BOLD / UI_F_CAPS. Prefixed rather than named UI_* because
# this file already carries T_CAPTION/T_BODY/T_TITLE for fb.c's OTHER scale and
# two unprefixed families one letter apart is how a call site ends up passing
# the wrong ladder's constant to the right-looking argument.
PW_SM   = 0
PW_MD   = 1
PW_LG   = 2
PW_MONO = 1
PW_BOLD = 2

# ZD_LISTROW_H / ZD_COLHEAD_H / ZD_CELL_PX / ZD_KV_H / ZD_STAT_PY / ZD_STAT_PX
# / ZD_STAT_GAP, in design px. Duplicated here for the same stated reason the
# four band sizes above are: design.h owns them, this is the copy, and it says
# so. There is no ui_metric role for a table cell.
PW_ROWH    = 20
PW_HEADH   = 20
PW_CELLPX  = 6
PW_KVH     = 20
PW_CARDPY  = 7
PW_CARDPX  = 9
PW_CARDGAP = 1                     # the 1px gap over ZD_CUT IS the hairline
PW_DOT     = 6                     # ZD_DOT - the verdict swatch

fn pw_rowh()   { return PW_ROWH * ui() }
fn pw_headh()  { return PW_HEADH * ui() }
fn pw_cellpx() { return PW_CELLPX * ui() }
fn pw_kvh()    { return PW_KVH * ui() }

# THE GROOVE IS THE ROW'S LAST PIXEL, not a gap after it. `td` carries
# border-bottom: 1px solid var(--zd-cut), so the run belongs to the row it
# closes and the next row starts immediately under it - which is what makes
# consecutive grooves land exactly PW_ROWH apart with no drift.
fn pw_row_rule(rx, ry, rw) {
    fill_rgb(rx, ry + pw_rowh() - 1, rw, 1, theme(TH_CUT))
    return ry + pw_rowh()
}

# A cell's text baseline, centred in the row above its own groove. Two of
# them, because a proportional run and a mono run are different heights and a
# table with both in it lines up on neither if only one is measured.
fn pw_celly(ry)  { return ry + (pw_rowh() - 1 - ui_th(PW_SM)) / 2 }
fn pw_mcelly(ry) { return ry + (pw_rowh() - 1 - cell_h()) / 2 }

# COLUMNS ARE PERCENTAGES OF THE TABLE, exactly as the prototype's TBL() takes
# them, so a table keeps its proportions when a window is dragged wider instead
# of leaving a ragged gutter on the right.
fn pw_colx(tx, tw, pct) { return tx + tw * pct / 100 }
fn pw_colw(tw, pct)     { return tw * pct / 100 }

# Right-flush inside a column. The prototype's numeric cells are `class="r"`,
# and the pad is the SAME ZD_CELL_PX the left edge uses - a right-flushed
# number that sits on the column boundary reads as belonging to the next one.
fn pw_right(cx, cw, w) { return cx + cw - pw_cellpx() - w }

# ---- FIXED POINT, DRAWN --------------------------------------------------
# zl has no formatting and no float in the drawing path, so a ratio crosses
# the seam from ui_ratio() as an integer times 10^4 and is drawn digit by
# digit here. THE FRACTION IS ZERO PADDED and that is not cosmetic: label_num
# prints 4 for 4, so 9.04:1 drawn without the pad reads 9.4:1, which is a
# different and wrong number in a column headed RATIO.
#
# MONO IS THE TABLES' FACE. The prototype's numeric cells are .t-num, its mono
# class, and both panes' columns carry it. The card values are LG and
# PROPORTIONAL, which is why the walk below measures every digit rather than
# multiplying by a cell.
fn pw_pow10(dp) {
    if dp == 1 { return 10 }
    if dp == 2 { return 100 }
    if dp == 3 { return 1000 }
    if dp == 4 { return 10000 }
    return 1
}

# ONE LOOP, MEASURED AND DRAWN, and it is the same discipline uikit.c's
# tracked text follows for the same reason: a right-flushed number whose
# measure and draw disagree overhangs its column. `draw` is the only thing that
# varies between the two entry points below - the pen advance is written once.
#
# It walks DIGIT BY DIGIT rather than handing the whole number to ui_txtn,
# because the fraction needs its leading zeros and because at LG the face is
# proportional: a '1' and a '0' are different widths there, so a width computed
# as "digits times a cell" would be wrong by several pixels on any number
# containing a 1. In mono every advance is cell_w() and this reduces to that.
fn pw_dec_run(dx, dy, v, dp, col, size, flags, draw) {
    pv_sc = pw_pow10(dp)
    pv_w = v / pv_sc
    pv_f = v - pv_w * pv_sc
    pv_x = dx
    if draw == 1 { ui_txtn(pv_x, dy, pv_w, col, size, flags) }
    pv_x = pv_x + ui_tnw(pv_w, size, flags)
    if draw == 1 { ui_txt(pv_x, dy, ".", col, size, flags) }
    pv_x = pv_x + ui_tw(".", size, flags)
    pv_p = pv_sc / 10
    while pv_p >= 1 {
        pv_d = (pv_f / pv_p) % 10
        if draw == 1 { ui_txtn(pv_x, dy, pv_d, col, size, flags) }
        pv_x = pv_x + ui_tnw(pv_d, size, flags)
        pv_p = pv_p / 10
    }
    return pv_x - dx
}

fn pw_decgw(v, dp, size, flags) { return pw_dec_run(0, 0, v, dp, 0, size, flags, 0) }
fn pw_decg(dx, dy, v, dp, col, size, flags) {
    return dx + pw_dec_run(dx, dy, v, dp, col, size, flags, 1)
}

# The two the tables use: SM, mono, because .t-num is the prototype's mono
# class and every numeric cell in both panes carries it.
fn pw_decw(v, dp) { return pw_decgw(v, dp, PW_SM, PW_MONO) }
fn pw_dec(dx, dy, v, dp, col) { return pw_decg(dx, dy, v, dp, col, PW_SM, PW_MONO) }

# A ratio, as the prototype prints one: two decimals and the ":1" that says
# what kind of number it is. ui_ratio() answers x10^4, so the rounding to two
# places happens here and once.
fn pw_ratw(q4) { return pw_decw((q4 + 50) / 100, 2) + ui_tw(":1", PW_SM, PW_MONO) }
fn pw_rat(dx, dy, q4, col) {
    pr_x = pw_dec(dx, dy, (q4 + 50) / 100, 2, col)
    ui_txt(pr_x, dy, ":1", col, PW_SM, PW_MONO)
    return pr_x + ui_tw(":1", PW_SM, PW_MONO)
}

# ---- THE VERDICT SWATCH --------------------------------------------------
# A ZD_DOT square in the state colour and the word beside it, which is the
# prototype's `sw()`. A SQUARE, not a disc: ZD_DOT_R is ZD_R_CHIP at 2 design
# px and at ui 1 that rounds to nothing, and a 6px disc drawn with a 2px radius
# is a 6px square with four pixels missing. Drawn as what it is.
fn pw_sw(sx, sy, word, col) {
    ps_d = PW_DOT * ui()
    fill_rgb(sx, sy + (ui_th(PW_SM) - ps_d) / 2, ps_d, ps_d, col)
    ui_txt(sx + ps_d + pw_cellpx(), sy, word, col, PW_SM, 0)
    return 0
}
fn pw_sww(word) { return PW_DOT * ui() + pw_cellpx() + ui_tw(word, PW_SM, 0) }

# ---- A SECTION BAND, AND A KEY/VALUE ROW ---------------------------------
# The section head is the LABEL style - SM, uppercase, bold, tracked - with a
# 2px ZD_LIT rule over it, which is PRESSWORK's second and last rule weight.
# uikit.c owns the tracking; ui_caps is that, reachable from here now.
fn pw_sect(sx, sy, sw2, nm, note, unit) {
    fill_rgb(sx, sy, sw2, RULE_H * ui(), theme(TH_LIT))
    ps_y = sy + RULE_H * ui() + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(sx, ps_y, nm, theme(TH_TEXT_HI), PW_SM)
    # The count is measured BACKWARDS from the right edge, number then unit,
    # because the number is the part whose width changes. Laying it out
    # forwards from a guessed x is how a right-flushed reading ends up one
    # glyph over the boundary the day it gains a digit.
    ps_uw = ui_tw(unit, PW_SM, PW_MONO)
    ps_nw = ui_tnw(note, PW_SM, PW_MONO)
    ui_txtn(sx + sw2 - ps_uw - ps_nw, ps_y, note, theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    ui_txt(sx + sw2 - ps_uw, ps_y, unit, theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return sy + RULE_H * ui() + pw_headh()
}

# =============================================================================
# 10 SYSTEM - the machine, and then the design grading itself
#
# THE TABLE AT THE BOTTOM IS THE POINT. Everything above it is an inventory and
# every other pane in the system could carry it; "MEASURED CONTRAST, THIS
# LADDER, RIGHT NOW" is the one thing PRESSWORK does that its parents did not,
# and it only means anything because the numbers are computed rather than
# quoted. ui_ratio() reads the LIVE theme, so:
#
#   * turn the knockout off in 11 SETTINGS and rows 5, 6, 10 and 12 move -
#     theme.knock goes to ZD_FOCUS_WASH and the two inks and the foot edge go
#     with it, which is four of fourteen and visibly so.
#   * a token edited in design.h moves its rows on the next boot with no edit
#     here at all.
#
# WHY THE RATIOS ARE NOT A TABLE IN design.h. WCAG needs pow(x, 2.4) on a
# linearised channel and this drawing path has no floating point, so the
# arithmetic had to go somewhere. It went to ui_ratio_q4() in ui.c - a
# 256-entry sRGB table and integer fixed point, x10^4 - and NOT into a table of
# answers here, because a table of answers cannot follow the knockout switch
# and would therefore be asserting on a screen headed MEASURED. Proven against
# known values rather than trusted: every ratio design.h quotes in prose was
# recomputed in float64 first, all fifteen agreed, and the integer path
# reproduces all fifteen, all fourteen printed here, and the 1.1682:1 smallest
# surface step exactly.
#
# THE FOURTEEN PAIRS ARE FOUR PARALLEL TABLES walked by one index, which is the
# same shape rail_app/rail_name/rail_icon/rail_sub take a thousand lines up and
# for the same reason: zl has no record type, so the four are kept adjacent and
# a row added to one is visibly missing from the others.
# =============================================================================
SYSG_N = 14

fn sysg_name(i) {
    if i == 0  { return "text 1 on base" }
    if i == 1  { return "text 1 on float" }
    if i == 2  { return "text 2 on float" }
    if i == 3  { return "text 3 on float" }
    if i == 4  { return "title on knockout" }
    if i == 5  { return "sub on knockout" }
    if i == 6  { return "ink on vermilion" }
    if i == 7  { return "edge over on float" }
    if i == 8  { return "edge over on base" }
    if i == 9  { return "knockout on base" }
    if i == 10 { return "lit on base" }
    if i == 11 { return "ko edge on knockout" }
    if i == 12 { return "cut on base" }
    return "grid on void"
}

# THE INK OF THE PAIR. theme(), never a literal - the rule is that a colour
# literal may appear in design.h and nowhere else, and a pane that spelled
# #DAD4CB to grade #DAD4CB would be grading its own copy.
fn sysg_fg(i) {
    if i == 0  { return theme(TH_TEXT) }
    if i == 1  { return theme(TH_TEXT) }
    if i == 2  { return theme(TH_TEXT_2) }
    if i == 3  { return theme(TH_TEXT_DIM) }
    if i == 4  { return theme(TH_KNOCK_INK) }
    if i == 5  { return theme(TH_KNOCK_INK2) }
    if i == 6  { return theme(TH_INK_ON) }
    if i == 7  { return theme(TH_EDGE_OVER) }
    if i == 8  { return theme(TH_EDGE_OVER) }
    if i == 9  { return theme(TH_KNOCK) }
    if i == 10 { return theme(TH_LIT) }
    if i == 11 { return theme(TH_KO_EDGE) }
    if i == 12 { return theme(TH_CUT) }
    return theme(TH_GRID)
}

fn sysg_bg(i) {
    if i == 0  { return theme(TH_PANEL) }
    if i == 1  { return theme(TH_SURF_5) }
    if i == 2  { return theme(TH_SURF_5) }
    if i == 3  { return theme(TH_SURF_5) }
    if i == 4  { return theme(TH_KNOCK) }
    if i == 5  { return theme(TH_KNOCK) }
    if i == 6  { return theme(TH_ACCENT) }
    if i == 7  { return theme(TH_SURF_5) }
    if i == 8  { return theme(TH_PANEL) }
    if i == 9  { return theme(TH_PANEL) }
    if i == 10 { return theme(TH_PANEL) }
    if i == 11 { return theme(TH_KNOCK) }
    if i == 12 { return theme(TH_PANEL) }
    return theme(TH_BG)
}

# THE FLOOR, x100, and 0 means THIS PAIR IS NOT TEXT AND NOT A BOUNDARY.
# 450 is WCAG AA for body text; 300 is the floor the occlusion rule puts on a
# window boundary, because under overlap the upper plate's bottom and right
# edge is the only thing saying which plate is on top. The last four rows carry
# 0 and are reported as `structure` rather than PASS: ZD_LIT, ZD_KO_EDGE,
# ZD_CUT and ZD_GRID are 1px runs and ruling. Grading a groove against a text
# floor would manufacture four failures out of four things working correctly,
# and a table with four permanent red rows is a table nobody reads.
fn sysg_floor(i) {
    if i < 7  { return 450 }
    if i < 10 { return 300 }
    return 0
}

# HOW MANY OF THE GRADED PAIRS ARE FAILING RIGHT NOW. Drives the OK/FAIL badge
# on the HOST line, so the pane's own headline is its own verdict rather than a
# word somebody typed. Counted, not cached: the theme can change under it.
fn sysg_fails() {
    sf_i = 0
    sf_n = 0
    while sf_i < SYSG_N {
        sf_fl = sysg_floor(sf_i)
        if sf_fl > 0 {
            if (ui_ratio(sysg_fg(sf_i), sysg_bg(sf_i)) + 50) / 100 < sf_fl { sf_n = sf_n + 1 }
        }
        sf_i = sf_i + 1
    }
    return sf_n
}

# ---- the three stat cards ---------------------------------------------------
# ZD_STAT_GAP is 1 and the gap is over ZD_CUT, so the hairline between two
# cards IS the gap - there is no border token on a stat cell. Drawn as three
# ZD_RAISE faces with the plate's own groove showing through between them.
fn sys_card(cx, cy, cw, ch, k, vnum, vdec, cap) {
    fill_rgb(cx, cy, cw, ch, theme(TH_PANEL_HI))
    fill_rgb(cx, cy, cw, 1, theme(TH_LIT))              # the struck top run
    fill_rgb(cx, cy + ch - 1, cw, 1, theme(TH_CUT))     # the cut foot groove
    sc_x = cx + PW_CARDPX * ui()
    sc_y = cy + PW_CARDPY * ui()
    ui_caps(sc_x, sc_y, k, theme(TH_TEXT_DIM), PW_SM)
    sc_y = sc_y + ui_th(PW_SM) + 3 * ui()
    # ONE LARGE READING PER CARD, at LG - the only place in this pane where the
    # big atlas is used, which is what "the one large reading per view" means
    # when a view has three cards in it.
    if vdec > 0 {
        pw_decg(sc_x, sc_y, vnum, vdec, theme(TH_TEXT_HI), PW_LG, 0)
    } else {
        ui_txtn(sc_x, sc_y, vnum, theme(TH_TEXT_HI), PW_LG, 0)
    }
    sc_y = sc_y + ui_th(PW_LG) + 3 * ui()
    ui_txt(sc_x, sc_y, cap, theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    return 0
}

# THE PANEL REFRESH IS MEASURED ONCE, AND NOT HERE. intel_refresh_mhz() counts
# frames across 500 ms of the PIT - read intel.c:699 - so calling it from a
# draw would stall the compositor for half a second on every repaint of this
# window. It is called from open_syspane() instead, once per open, and cached.
# On anything that is not a live Intel pipe it returns 0 immediately, which is
# QEMU, BGA and virtio-gpu; the card says so rather than printing a rate this
# machine cannot measure.
sys_hz = 0

fn sys_cards(cx, cy, cw) {
    sd_h = PW_CARDPY * 2 * ui() + ui_th(PW_SM) * 2 + ui_th(PW_LG) + 6 * ui()
    sd_g = PW_CARDGAP * ui()
    sd_w = (cw - 2 * sd_g) / 3
    # "hyperthreaded" WAS A WRITTEN CLAIM beside a measured number. cpu_tpc()
    # is bound and reports threads per core, so the word can be earned rather
    # than asserted - and on a part without SMT the old literal was simply
    # false while the figure beside it was right.
    if cpu_tpc() > 1 { sys_card(cx, cy, sd_w, sd_h, "cpu", cpu_thr(), 0, "logical, hyperthreaded") } else { sys_card(cx, cy, sd_w, sd_h, "cpu", cpu_thr(), 0, "logical, one thread per core") }
    # MiB, not GiB: ruler_mapped() is the memory map this kernel actually
    # mapped, and dividing it to one decimal of a gibibyte would round away the
    # thing the number is for. The foot's ruler prints the same figure.
    sys_card(cx + sd_w + sd_g, cy, sd_w, sd_h, "memory", ruler_mapped() / 1048576, 0, "MiB mapped, no swap")
    if sys_hz > 0 {
        sys_card(cx + 2 * (sd_w + sd_g), cy, sd_w, sd_h, "refresh", sys_hz, 3, "Hz, measured")
    } else {
        # wm_painted(), NOT wm_frame(). wm_frame is bound as
        # `{ wm_frame(); return zl_nil(); }` - it is the compositor's per-frame
        # DRIVER, so this printed nil as 0 and re-entered the compositor from
        # inside app_draw, draining input twice. wm_painted is the counter.
        sys_card(cx + 2 * (sd_w + sd_g), cy, sd_w, sd_h, "refresh", wm_painted(), 0, "composites, no panel clock")
    }
    return cy + sd_h
}

# ---- the six inventory rows -------------------------------------------------
# THE VALUE IS RIGHT FLUSHED, AND THAT IS WHY EACH ROW IS RUN TWICE. The
# prototype's kv() puts the key hard left and the value hard right, and a value
# here is not a string - zl's kernel subset has no string values, so
# "1920 x 1200 x 32" is four pieces walked with an x cursor. There is no width
# to subtract from the right edge until the pieces have been walked.
#
# So sys_row_val() walks them with the ink switched off to get a width, and
# again from (right - width) to draw. ONE FUNCTION, TWO PASSES, which is the
# same measure/draw contract uikit.c's tracked text keeps and enforced the same
# way: there is only one list of pieces, so the measure cannot describe a row
# the draw does not lay down. A second function that added up widths would be
# the copy that silently stops matching.
#
# ONE FUNCTION AND A SELECTOR rather than six functions, because six functions
# would need six pairs of call sites and the pairing is the thing that has to
# be right.
fn sys_rowk(rx, ry, k) {
    ui_caps(rx, ry + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, k, theme(TH_TEXT_2), PW_SM)
    return 0
}
fn sys_rowend(rx, ry, rw) {
    fill_rgb(rx, ry + pw_kvh() - 1, rw, 1, theme(TH_CUT))
    return ry + pw_kvh()
}
fn sys_valy(ry) { return ry + (pw_kvh() - 1 - cell_h()) / 2 }

# The three pen advances. `dr` 0 measures and 0 draws; every one returns the x
# it ended at, so a row is a chain and its total width is the last x minus the
# first. TH_TEXT for a reading and TH_TEXT_DIM for the words between readings,
# which is the DATA/LABEL split applied inside a single line.
fn sys_vn(vx, vy, n, dr) {
    if dr == 1 { ui_txtn(vx, sys_valy(vy), n, theme(TH_TEXT_HI), PW_SM, PW_MONO) }
    return vx + ui_tnw(n, PW_SM, PW_MONO)
}
fn sys_vs(vx, vy, s, dr) {
    if dr == 1 { ui_txt(vx, sys_valy(vy), s, theme(TH_TEXT_DIM), PW_SM, PW_MONO) }
    return vx + ui_tw(s, PW_SM, PW_MONO)
}
fn sys_vt(vx, vy, s, dr) {
    if dr == 1 { ui_txt(vx, sys_valy(vy), s, theme(TH_TEXT), PW_SM, PW_MONO) }
    return vx + ui_tw(s, PW_SM, PW_MONO)
}

SYS_ROWS_N = 6

fn sys_rowk_name(i) {
    if i == 0 { return "display" }
    if i == 1 { return "framebuffer" }
    if i == 2 { return "arena" }
    if i == 3 { return "storage" }
    if i == 4 { return "input" }
    return "ladder"
}

# THE SIX VALUES. Every branch here is a READ - intel_supported(), fs_mounted(),
# xhci_kbd_ready() - and there is no row whose content is a sentence somebody
# typed. That is why the prototype's FIRMWARE row is not among them: nothing in
# this image reports the UEFI revision or the secure-boot state to zl, so that
# row could only have been prose wearing a value's clothes. ARENA replaces it,
# and the arena is a thing this kernel actually has and can count.
fn sys_row_val(vx, vy, i, dr) {
    sv_x = vx
    if i == 0 {
        # DISPLAY - who is driving the panel. intel_supported() is the real
        # modesetting driver, virtio_gpu_present() is the QEMU path, and
        # anything else is a framebuffer the firmware handed us and we did not
        # program. Three different truths, never one hopeful string.
        if intel_ok() == 1 {
            sv_x = sys_vt(sv_x, vy, "intel gen9, pipe ", dr)
            sv_x = sys_vn(sv_x, vy, intel_pipe(), dr)
        }
        if intel_ok() == 0 {
            if vg_ok() == 1 { sv_x = sys_vt(sv_x, vy, "virtio-gpu", dr) }
            if vg_ok() == 0 { sv_x = sys_vt(sv_x, vy, "firmware framebuffer", dr) }
        }
        sv_x = sys_vs(sv_x, vy, ", ", dr)
        sv_x = sys_vn(sv_x, vy, px_w(), dr)
        sv_x = sys_vs(sv_x, vy, " x ", dr)
        sv_x = sys_vn(sv_x, vy, px_h(), dr)
        # THE DEPTH IS READ LIKE THE OTHER TWO. This was the literal " x 32"
        # sitting between px_w() and px_h(), both of which ARE measurements - so
        # on a machine whose firmware handed back 24-bpp packed or 16-bpp 565
        # the row would have printed two true numbers and one false one in the
        # same sentence, and the false one is the one that changes what you do
        # about it. fb_bpp comes from fb_setup, which takes whatever the
        # bootloader reported.
        sv_x = sys_vs(sv_x, vy, " x ", dr)
        sv_x = sys_vn(sv_x, vy, fb_bpp(), dr)
        return sv_x
    }
    if i == 1 {
        # FRAMEBUFFER - both figures derived from the mode rather than from a
        # constant, so a resolution change moves them.
        sv_x = sys_vn(sv_x, vy, ruler_fb() / 1024, dr)
        sv_x = sys_vs(sv_x, vy, " KiB, stride ", dr)
        # THE STRIDE IS READ. This computed px_w() * 4, which is the one
        # framebuffer figure that specifically is NOT width times bytes per
        # pixel: fb.c keeps fb_pitch as its own field from its own argument to
        # fb_setup, and firmware pads scanlines for alignment routinely. Every
        # pixel write in fb.c goes through fb_base + y * fb_pitch, so the pane
        # was printing a number the driver itself does not use - under the word
        # "stride", which is exactly the word for the number it is not.
        sv_x = sys_vn(sv_x, vy, fb_pitch(), dr)
        sv_x = sys_vs(sv_x, vy, " B, no gpu blitter", dr)
        return sv_x
    }
    if i == 2 {
        sv_x = sys_vn(sv_x, vy, arena_used() / 1024, dr)
        sv_x = sys_vs(sv_x, vy, " KiB used, ", dr)
        sv_x = sys_vn(sv_x, vy, arena_free() / 1024, dr)
        sv_x = sys_vs(sv_x, vy, " KiB free, refusals ", dr)
        sv_x = sys_vn(sv_x, vy, arena_refused(), dr)
        return sv_x
    }
    if i == 3 {
        # STORAGE - the controller and the volume are asked separately, because
        # a working controller with nothing mounted and no controller at all are
        # different failures and a single "no storage" would hide which.
        if nv_ok() == 1 {
            sv_x = sys_vt(sv_x, vy, "nvme, ", dr)
            sv_x = sys_vn(sv_x, vy, nv_bsize(), dr)
            sv_x = sys_vs(sv_x, vy, " B blocks, ", dr)
        }
        if nv_ok() == 0 { sv_x = sys_vt(sv_x, vy, "no nvme, ", dr) }
        if fs_ok() == 1 {
            sv_x = sys_vt(sv_x, vy, "zlfs mounted, ", dr)
            sv_x = sys_vn(sv_x, vy, fs_n(), dr)
            sv_x = sys_vs(sv_x, vy, " files", dr)
        }
        if fs_ok() == 0 { sv_x = sys_vt(sv_x, vy, "no volume mounted", dr) }
        return sv_x
    }
    if i == 4 {
        # INPUT - and this row is the one that has caught a real bug. The USB
        # boot keyboard and the PS/2 controller are different devices with
        # different scancode paths, and an image reporting "usb hid" while
        # running on PS/2 is the exact confusion that made Enter do nothing in
        # the terminal on the ThinkPad's own keyboard. Asked, not assumed.
        if usb_kbd_ok() == 1 { sv_x = sys_vt(sv_x, vy, "usb boot keyboard", dr) }
        if usb_kbd_ok() == 0 { sv_x = sys_vt(sv_x, vy, "ps/2 keyboard", dr) }
        if ptr_driver() == 1 { sv_x = sys_vt(sv_x, vy, ", usb boot mouse", dr) }
        if ptr_driver() == 0 { sv_x = sys_vt(sv_x, vy, ", ps/2 mouse", dr) }
        return sv_x
    }
    # LADDER - which ladder is resolved right now and what its smallest surface
    # step measures. FOUR decimals, because the whole widening thesis is the
    # difference between 1.0728 and 1.1682 and two decimals prints 1.07 and
    # 1.17 - a gap that looks like rounding rather than like the argument.
    if ui_knock_on() == 1 { sv_x = sys_vt(sv_x, vy, "presswork, widened, knockout on", dr) }
    if ui_knock_on() == 0 { sv_x = sys_vt(sv_x, vy, "presswork, KNOCKOUT OFF", dr) }
    sv_x = sys_vs(sv_x, vy, ". smallest surface step ", dr)
    if dr == 1 { pw_dec(sv_x, sys_valy(vy), ui_ratio(theme(TH_PANEL_HI), theme(TH_SURF_5)), 4, theme(TH_TEXT_HI)) }
    sv_x = sv_x + pw_decw(ui_ratio(theme(TH_PANEL_HI), theme(TH_SURF_5)), 4)
    return sys_vs(sv_x, vy, ":1", dr)
}

fn sys_rows(rx, ry, rw) {
    sr_i = 0
    sr_y = ry
    while sr_i < SYS_ROWS_N {
        sys_rowk(rx, sr_y, sys_rowk_name(sr_i))
        sr_w = sys_row_val(0, sr_y, sr_i, 0)
        sys_row_val(rx + rw - sr_w, sr_y, sr_i, 1)
        sr_y = sys_rowend(rx, sr_y, rw)
        sr_i = sr_i + 1
    }
    return sr_y
}

# ---- MEASURED CONTRAST, THIS LADDER, RIGHT NOW ------------------------------
# PAIR 44 / RATIO 18 / FLOOR 16 / VERDICT 22, which are the prototype's own
# TBL() widths. The header row is the LABEL style over a 1px ZD_LIT rule; every
# data row closes with a 1px ZD_CUT groove.
fn sysg_head(hx, hy, hw) {
    sh_y = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(pw_colx(hx, hw, 0) + pw_cellpx(), sh_y, "pair", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 44), pw_colw(hw, 18), ui_capsw("ratio", PW_SM)), sh_y, "ratio", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 62), pw_colw(hw, 16), ui_capsw("floor", PW_SM)), sh_y, "floor", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 78) + pw_cellpx(), sh_y, "verdict", theme(TH_TEXT_DIM), PW_SM)
    fill_rgb(hx, hy + pw_headh() - 1, hw, 1, theme(TH_LIT))
    return hy + pw_headh()
}

# Returns the y it stopped at. IT DRAWS ONLY THE ROWS THAT FIT, and the caller
# reports how many that was - a table that silently ends at row nine on a short
# window is a table that has lied about its own verdict.
fn sysg_rows(gx, gy, gw, gmax) {
    sg_i = 0
    sg_y = gy
    while sg_i < SYSG_N {
        if sg_y + pw_rowh() > gmax { return sg_y }
        sg_q = ui_ratio(sysg_fg(sg_i), sysg_bg(sg_i))
        sg_fl = sysg_floor(sg_i)
        ui_txt(pw_colx(gx, gw, 0) + pw_cellpx(), pw_celly(sg_y), sysg_name(sg_i), theme(TH_TEXT), PW_SM, 0)
        pw_rat(pw_right(pw_colx(gx, gw, 44), pw_colw(gw, 18), pw_ratw(sg_q)), pw_mcelly(sg_y), sg_q, theme(TH_TEXT_HI))
        if sg_fl > 0 {
            pw_dec(pw_right(pw_colx(gx, gw, 62), pw_colw(gw, 16), pw_decw(sg_fl, 2)), pw_mcelly(sg_y), sg_fl, 2, theme(TH_TEXT_DIM))
            if (sg_q + 50) / 100 >= sg_fl {
                pw_sw(pw_colx(gx, gw, 78) + pw_cellpx(), pw_celly(sg_y), "PASS", theme(TH_OK))
            } else {
                pw_sw(pw_colx(gx, gw, 78) + pw_cellpx(), pw_celly(sg_y), "FAIL", theme(TH_DANGER))
            }
        } else {
            # A DASH, NOT A ZERO. "0.00" in a FLOOR column reads as a floor of
            # zero, which is a claim; the dash says the question does not apply.
            ui_txt(pw_right(pw_colx(gx, gw, 62), pw_colw(gw, 16), ui_tw("-", PW_SM, PW_MONO)), pw_mcelly(sg_y), "-", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
            ui_txt(pw_colx(gx, gw, 78) + pw_cellpx(), pw_celly(sg_y), "structure", theme(TH_TEXT_DIM), PW_SM, 0)
        }
        sg_y = pw_row_rule(gx, sg_y, gw)
        sg_i = sg_i + 1
    }
    return sg_y
}

# The HOST line's value, on the same measure-then-draw contract as the six
# inventory rows. wm_n() is in it because the number of open windows is the one
# fact about this host that changes while you are looking at the pane.
fn sys_host_val(hx, hy, dr) {
    sv_hx = sys_vt(hx, hy, "zlos 0.3, x86_64, single image, ", dr)
    sv_hx = sys_vn(sv_hx, hy, wm_n(), dr)
    return sys_vs(sv_hx, hy, " windows", dr)
}

fn sys_body(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    # See type_body: ui_text() gates on ui_mode_get() and ui_text_tracked()
    # does not, so the mode is set explicitly before either is used.
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    sb_x = ax + pad_d()
    sb_w = aw - 2 * pad_d()
    sb_y = ay + pad_d()
    sb_bot = ay + ah - pad_d()

    # THE HOST LINE, and its badge is the table's own verdict rather than a
    # word. If any graded pair drops below its floor this reads FAIL, on the
    # first line of the window, without anybody scrolling to find out.
    ui_caps(sb_x, sb_y + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, "host", theme(TH_TEXT_2), PW_SM)
    sb_f = sysg_fails()
    # The badge is measured first because the value has to stop short of it,
    # then the value is measured, then both are drawn from the right edge in.
    sb_bw = pw_sww("OK")
    if sb_f > 0 { sb_bw = pw_sww("FAIL") }
    sb_hw = sys_host_val(0, sb_y, 0)
    sys_host_val(sb_x + sb_w - sb_bw - 2 * pad_d() - sb_hw, sb_y, 1)
    if sb_f == 0 {
        pw_sw(sb_x + sb_w - sb_bw, sb_y + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, "OK", theme(TH_OK))
    } else {
        pw_sw(sb_x + sb_w - sb_bw, sb_y + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, "FAIL", theme(TH_DANGER))
    }
    sb_y = sys_rowend(sb_x, sb_y, sb_w) + PW_CARDGAP * ui()

    sb_y = sys_cards(sb_x, sb_y, sb_w) + PW_CARDGAP * ui()
    sb_y = sys_rows(sb_x, sb_y, sb_w)

    sb_y = pw_sect(sb_x, sb_y + pad_d(), sb_w, "measured contrast, this ladder, right now", SYSG_N, " pairs")
    sb_y = sysg_head(sb_x, sb_y, sb_w)
    sb_shown = idiv(sb_bot - sb_y, pw_rowh())   # idiv: a row COUNT
    if sb_shown > SYSG_N { sb_shown = SYSG_N }
    # A window dragged short enough leaves no room at all and this goes
    # negative; `-3 of 14 rows fit` is a worse readout than `0 of 14`.
    if sb_shown < 0 { sb_shown = 0 }
    sb_y = sysg_rows(sb_x, sb_y, sb_w, sb_bot)
    # WHAT DID NOT FIT IS STATED. The prototype scrolls this table; this window
    # does not scroll yet, so the honest substitute is to say how many rows the
    # window had room for. Silently ending at row nine would make the pane's
    # own verdict depend on the window height, which is the failure this line
    # exists to make impossible.
    if sb_shown < SYSG_N {
        # BOTH counts come from SYSG_N and the loop, never from a literal in
        # the sentence. " of 14 rows" written out is a second copy of SYSG_N
        # and would go stale the day a fifteenth pair is added - which is
        # exactly the drift this pane exists to catch elsewhere.
        sb_nw = ui_tw(" of ", PW_SM, PW_MONO) + ui_tnw(SYSG_N, PW_SM, PW_MONO) + ui_tw(" rows fit - make the window taller", PW_SM, PW_MONO)
        sb_nx = sb_x + sb_w - sb_nw - ui_tnw(sb_shown, PW_SM, PW_MONO)
        sb_nx = sys_vn(sb_nx, sb_y, sb_shown, 1)
        sb_nx = sys_vs(sb_nx, sb_y, " of ", 1)
        sb_nx = sys_vn(sb_nx, sb_y, SYSG_N, 1)
        sys_vs(sb_nx, sb_y, " rows fit - make the window taller", 1)
    }
    return 0
}

# =============================================================================
# 14 TYPE - the three registers at their real sizes, and every atlas in the
#           image
#
# THE PANE READS ITS OWN FACTS. atlas_n / atlas_w / atlas_h / atlas_g are
# sizeof() over the linked font arrays in ui.c, and atlas_role asks which one a
# type register is drawing from at the scale in force this second. Nothing
# below is typed in, which matters here more than anywhere else in the system:
# the design's stated type facts and the image's actual type facts DISAGREE,
# and a pane that quoted design.h would have reported the disagreement as
# agreement.
#
# THE DISAGREEMENT, stated plainly because the pane prints it. design.h's type
# section opens "THREE sizes, because there are THREE baked bitmap atlases
# (8x16, 16x32, 24x48)... This is a hard platform fact", and the prototype's
# TYPE table has exactly those three rows, all three marked OK. TWO OF THE
# THREE ARE IN THIS IMAGE. font_big.c holds a real 24x48 coverage atlas and is
# NOT in kernel/SOURCES, so no target links it - fb.c's own note says why, and
# says it in the past tense: "the 24x48 huge font was removed - unused, and its
# 109 KiB pushed the raw kernel past the 640 KiB low-memory limit our own
# bootloader loads into". The LG register is resampled from the 16x32 atlas.
# The row is drawn and marked ABSENT.
#
# AND THERE ARE SIX MORE THAN EITHER DOCUMENT COUNTS. The mono atlases are the
# CONSOLE's. Every label, title, column head and row in this desktop is drawn
# by fb_text_role out of font_prop.inc's PROPORTIONAL atlases - three cells at
# two weights, DejaVu Sans - which no version of the three-row table mentions
# at all. Nine rows, because nine is how many there are.
#
# TRACKING IS NO LONGER UNPRICED, AND THE PANE MEASURES IT RATHER THAN SAYING
# SO. The prototype's own note calls letter-spacing "the one unpriced item in
# this direction" and design.h repeats it. uikit.c's ui_text_tracked now draws
# it, so the TRACKING row below reports the DEVICE pixels actually inserted
# between two glyphs - ui_capsw("WW") minus twice ui_capsw("W") - which is a
# measurement of the shipped behaviour and not a reading of the token.
# =============================================================================

TY_MONO = 0                        # atlas_face(): DejaVu Sans Mono, fixed cell
TY_SANS = 1                        # DejaVu Sans, proportional
TY_SANSB = 2                       # the same, bold

fn ty_face(f) {
    if f == TY_MONO { return "mono" }
    if f == TY_SANSB { return "sans bold" }
    return "sans"
}

fn ty_reg(r) {
    if r == PW_SM { return "SM" }
    if r == PW_MD { return "MD" }
    return "LG"
}

# HOW MANY ATLASES ARE REALLY HERE. Counted from atlas_in() rather than from
# atlas_n(), because atlas_n() includes the row the design asked for and the
# link does not have - and "three atlases" printed over a table with an ABSENT
# row in it would be the pane contradicting itself in two adjacent lines.
fn ty_present() {
    tp_i = 0
    tp_n = 0
    while tp_i < atlas_n() {
        if atlas_in(tp_i) == 1 { tp_n = tp_n + 1 }
        tp_i = tp_i + 1
    }
    return tp_n
}

# TOTAL COVERAGE, which is the headline reading this pane is entitled to: the
# number of glyph cells actually baked into the running image. It is the one
# figure here that is genuinely large and genuinely the type system's own.
fn ty_glyphs() {
    tg_i = 0
    tg_n = 0
    while tg_i < atlas_n() {
        if atlas_in(tg_i) == 1 { tg_n = tg_n + atlas_g(tg_i) }
        tg_i = tg_i + 1
    }
    return tg_n
}

# THE TRACK, MEASURED. Two glyphs minus twice one glyph is exactly the space
# uikit.c inserted between them, in device pixels, after UI_DP rounding and
# after the floor that keeps a track from rounding to nothing. 'W' because it
# is the widest cell in the atlas and therefore the one where a per-glyph
# rounding error would be most visible if there were one.
fn ty_track_lab() { return ui_capsw("WW", PW_SM) - 2 * ui_capsw("W", PW_SM) }
fn ty_track_big() { return ui_dispw("WW", PW_LG) - 2 * ui_dispw("W", PW_LG) }

# ---- the specimen -----------------------------------------------------------
# The three registers at their real sizes, one under the other, which is the
# only way a type specimen means anything: LG as the display style with
# ZD_TR_BIG on it, LG again as a plain reading, MD as prose, SM as the tracked
# uppercase label doing structural work. A card, because it is one object.
fn ty_specimen(cx, cy, cw) {
    tp_p = pad_d()
    tp_h = 2 * tp_p + ui_th(PW_LG) * 2 + ui_th(PW_MD) + ui_th(PW_SM) + 12 * ui()
    fill_rgb(cx, cy, cw, tp_h, theme(TH_SURF_5))
    fill_rgb(cx, cy, cw, 1, theme(TH_LIT))
    fill_rgb(cx, cy + tp_h - 1, cw, 1, theme(TH_CUT))
    tp_x = cx + tp_p
    tp_y = cy + tp_p
    # THE LITERAL IS ALREADY UPPERCASE and that is a workaround, not a style
    # choice. The prototype's `.t-big` carries text-transform:uppercase on the
    # same rule as its letter-spacing (line 349), but uikit.c's ui_display()
    # passes UI_F_BOLD without UI_F_CAPS - so the display style tracks and does
    # not case, and a lowercase argument would come out lowercase. Passing the
    # caps in fixes the pixels here without editing another agent's file; the
    # missing flag is reported rather than patched around silently.
    ui_disp(tp_x, tp_y, "PRESSWORK", theme(TH_TEXT_HI), PW_LG)
    tp_y = tp_y + ui_th(PW_LG) + 4 * ui()
    # The one large reading per view, and it is a real one: every glyph cell
    # baked into this image, summed across the atlases that are in it.
    ui_txtn(tp_x, tp_y, ty_glyphs(), theme(TH_TEXT_HI), PW_LG, 0)
    ui_txt(tp_x + ui_tnw(ty_glyphs(), PW_LG, 0), tp_y, " glyph cells, baked", theme(TH_TEXT), PW_LG, 0)
    tp_y = tp_y + ui_th(PW_LG) + 4 * ui()
    ui_txt(tp_x, tp_y, "The root size. Everything a person reads as prose.", theme(TH_TEXT), PW_MD, 0)
    tp_y = tp_y + ui_th(PW_MD) + 4 * ui()
    ui_caps(tp_x, tp_y, "label, uppercase and tracked, doing structural work", theme(TH_TEXT_2), PW_SM)
    return cy + tp_h
}

# ---- the atlas table --------------------------------------------------------
# ATLAS 32 / ROLE 14 / SIZE 14 / COVERAGE 20 / STATE 20. Column 0 carries the
# cell AND the face name - "16 x 32   sans bold" - so it is the widest, and it
# was measured against the longest of the three face names rather than picked:
# at ui 1 that run is 6 mono cells + a 2-cell gap + 9 more, 136 px, against
# 32% of a 580 px table, 185 px.
fn ty_head(hx, hy, hw) {
    th_y = hy + (pw_headh() - ui_th(PW_SM)) / 2
    ui_caps(pw_colx(hx, hw, 0) + pw_cellpx(), th_y, "atlas", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 32) + pw_cellpx(), th_y, "role", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 46), pw_colw(hw, 14), ui_capsw("size", PW_SM)), th_y, "size", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_right(pw_colx(hx, hw, 60), pw_colw(hw, 20), ui_capsw("coverage", PW_SM)), th_y, "coverage", theme(TH_TEXT_DIM), PW_SM)
    ui_caps(pw_colx(hx, hw, 80) + pw_cellpx(), th_y, "state", theme(TH_TEXT_DIM), PW_SM)
    fill_rgb(hx, hy + pw_headh() - 1, hw, 1, theme(TH_LIT))
    return hy + pw_headh()
}

# WHICH REGISTERS ARE ON THIS ATLAS RIGHT NOW, drawn as up to three tokens.
# More than one can land on the same atlas and that is not a bug: at ui 1
# fb.c's role ladder resolves SM, MD and LG to 12, 12 and 16 device px and
# prop_atlas_cell rounds all three to the 16px atlas, so all three registers
# share one face and the type scale collapses. Reading that off the screen is
# the whole reason this column asks the running system instead of design.h,
# which says 11 / 13 / 21 and is describing the design rather than the panel.
# Returns the x it stopped at, so the SIZE column can be right-flushed after.
fn ty_roles(rx, ry, i) {
    tr_r = 0
    tr_x = rx
    while tr_r < 3 {
        if atlas_role(tr_r, 0) == i {
            ui_txt(tr_x, ry, ty_reg(tr_r), theme(TH_TEXT), PW_SM, PW_MONO)
            tr_x = tr_x + ui_tw(ty_reg(tr_r), PW_SM, PW_MONO) + cell_w()
        }
        tr_r = tr_r + 1
    }
    # A bold atlas is not a register of its own - it is the same three at
    # W_BOLD - so it is marked as the weight rather than given a fourth name.
    if atlas_face(i) == TY_SANSB {
        ui_txt(tr_x, ry, "bold", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        tr_x = tr_x + ui_tw("bold", PW_SM, PW_MONO)
    }
    # The console's own cell, which is a face nothing in the desktop's type
    # scale reaches: term.c and the raster strip draw from it directly.
    if atlas_face(i) == TY_MONO {
        if cell_h() == atlas_h(i) {
            ui_txt(tr_x, ry, "DATA", theme(TH_TEXT), PW_SM, PW_MONO)
            tr_x = tr_x + ui_tw("DATA", PW_SM, PW_MONO)
        } else {
            ui_txt(tr_x, ry, "-", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
            tr_x = tr_x + ui_tw("-", PW_SM, PW_MONO)
        }
    }
    if tr_x == rx {
        ui_txt(tr_x, ry, "-", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        tr_x = tr_x + ui_tw("-", PW_SM, PW_MONO)
    }
    return tr_x
}

# TYPE'S SCROLL OFFSET. The pane's section head counts atlas_n() rows and the
# loop below stops when it runs out of well, so on any window shorter than the
# full list it printed a count it then did not show - and there was no way to
# reach the rest, because app_event had no arm for this pane at all and it fell
# into reg_event, which has never heard of it.
ty_scroll = 0

# How many rows fit, so the scroll clamp and the loop agree.
fn ty_fit(gy, gmax) {
    tyf = idiv(gmax - gy, pw_rowh())
    if tyf < 1 { tyf = 1 }
    return tyf
}

fn ty_rows(gx, gy, gw, gmax) {
    # CLAMPED HERE, where the well's height is known. Scrolling past the end
    # would leave a blank pane with a head still claiming N rows.
    tymax = atlas_n() - ty_fit(gy, gmax)
    if tymax < 0 { tymax = 0 }
    if ty_scroll > tymax { ty_scroll = tymax }
    if ty_scroll < 0 { ty_scroll = 0 }
    tw_i = ty_scroll
    tw_y = gy
    while tw_i < atlas_n() {
        if tw_y + pw_rowh() > gmax { return tw_y }
        tw_c = theme(TH_TEXT)
        if atlas_in(tw_i) == 0 { tw_c = theme(TH_TEXT_DIM) }
        # ATLAS - the cell, w x h, both out of sizeof.
        tw_x = pw_colx(gx, gw, 0) + pw_cellpx()
        ui_txtn(tw_x, pw_mcelly(tw_y), atlas_w(tw_i), tw_c, PW_SM, PW_MONO)
        tw_x = tw_x + ui_tnw(atlas_w(tw_i), PW_SM, PW_MONO)
        ui_txt(tw_x, pw_mcelly(tw_y), " x ", tw_c, PW_SM, PW_MONO)
        tw_x = tw_x + ui_tw(" x ", PW_SM, PW_MONO)
        ui_txtn(tw_x, pw_mcelly(tw_y), atlas_h(tw_i), tw_c, PW_SM, PW_MONO)
        tw_x = tw_x + ui_tnw(atlas_h(tw_i), PW_SM, PW_MONO) + 2 * cell_w()
        ui_txt(tw_x, pw_mcelly(tw_y), ty_face(atlas_face(tw_i)), theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        # ROLE - live.
        ty_roles(pw_colx(gx, gw, 32) + pw_cellpx(), pw_mcelly(tw_y), tw_i)
        # SIZE - the atlas cell in px, which is the size it is actually baked
        # at. The DESIGN sizes (11 / 13 / 21) are in the SIZES row below and
        # are deliberately not repeated here: this column reads the image.
        pw_dec(pw_right(pw_colx(gx, gw, 46), pw_colw(gw, 14), pw_decw(atlas_h(tw_i) * 10, 1)), pw_mcelly(tw_y), atlas_h(tw_i) * 10, 1, tw_c)
        # COVERAGE.
        tw_cx = pw_right(pw_colx(gx, gw, 60), pw_colw(gw, 20), ui_tnw(atlas_g(tw_i), PW_SM, PW_MONO) + ui_tw(" glyphs", PW_SM, PW_MONO))
        ui_txtn(tw_cx, pw_mcelly(tw_y), atlas_g(tw_i), tw_c, PW_SM, PW_MONO)
        ui_txt(tw_cx + ui_tnw(atlas_g(tw_i), PW_SM, PW_MONO), pw_mcelly(tw_y), " glyphs", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
        # STATE.
        if atlas_in(tw_i) == 1 {
            pw_sw(pw_colx(gx, gw, 80) + pw_cellpx(), pw_celly(tw_y), "OK", theme(TH_OK))
        } else {
            pw_sw(pw_colx(gx, gw, 80) + pw_cellpx(), pw_celly(tw_y), "ABSENT", theme(TH_WARN))
        }
        tw_y = pw_row_rule(gx, tw_y, gw)
        tw_i = tw_i + 1
    }
    return tw_y
}

# ---- the four statements, and two of them carry a measurement ---------------
# Same measure-then-draw contract as the SYSTEM pane's rows, and index 0 is the
# FACES line's right-hand count so all five composed runs in this pane go
# through one function.
#
# SIZES READS THE LIVE PIXELS, not design.h's 11 / 13 / 21, and prints both so
# the gap is visible. At ui 1 fb.c's role ladder resolves all three registers
# to 12, 12 and 16 device px - caption and body come out the SAME SIZE and the
# three-step scale is two - which is a fact about the panel in front of you and
# is exactly what a type pane is for.
# 5, NOT 4. ty_rowk_name has five entries and the loop ran 1..3, so `hierarchy`
# - which is the DEFAULT return, and the reference's fourth kv row - was never
# drawn. Index 0 is consumed separately by FACES above the loop, so the row that
# needed the extra slot was the one at the end. The prototype's R.type carries
# sizes, styles, tracking AND hierarchy; this drew three of four and the fourth
# was one comparison away the whole time.
TY_ROWS_N = 5

fn ty_rowk_name(i) {
    if i == 1 { return "sizes" }
    if i == 2 { return "styles" }
    if i == 3 { return "tracking" }
    return "hierarchy"
}

fn ty_row_val(vx, vy, i, dr) {
    tv_x = vx
    if i == 0 {
        tv_x = sys_vn(tv_x, vy, ty_present(), dr)
        return sys_vs(tv_x, vy, " atlases in this image, no rasteriser", dr)
    }
    if i == 1 {
        tv_x = sys_vs(tv_x, vy, "three, live: SM ", dr)
        tv_x = sys_vn(tv_x, vy, ui_th(PW_SM), dr)
        tv_x = sys_vs(tv_x, vy, " / MD ", dr)
        tv_x = sys_vn(tv_x, vy, ui_th(PW_MD), dr)
        tv_x = sys_vs(tv_x, vy, " / LG ", dr)
        tv_x = sys_vn(tv_x, vy, ui_th(PW_LG), dr)
        # NOT "design.h asks 11 / 13 / 21". Both halves of that comparison
        # come from design.h - ui_th() resolves the same tokens the literal
        # quotes - so it can never disagree and is a tautology wearing a
        # check's clothes. What the left half DOES measure is the scale: these
        # are design px multiplied by the panel's q8 and rounded, so at any
        # scale but 1 they differ from the token and that difference is the
        # only real reading on the row.
        return sys_vs(tv_x, vy, " px, design px scaled to this panel", dr)
    }
    if i == 2 { return sys_vt(tv_x, vy, "four. DATA mono / LABEL tracked caps / BODY / PLATE", dr) }
    if i == 3 {
        # THE ONE THE PROTOTYPE PRINTS AS UNPRICED, and it is priced now. These
        # two numbers are not tokens read back - they are ui_capsw("WW") minus
        # twice ui_capsw("W"), i.e. the device pixels uikit.c actually inserted
        # between two glyphs after UI_DP rounding and after the floor that stops
        # a track rounding to nothing. If the tracking ever silently stops being
        # drawn, these read 0 on screen.
        tv_x = sys_vs(tv_x, vy, "DRAWN, measured: LABEL +", dr)
        tv_x = sys_vn(tv_x, vy, ty_track_lab(), dr)
        tv_x = sys_vs(tv_x, vy, " px, PLATE +", dr)
        tv_x = sys_vn(tv_x, vy, ty_track_big(), dr)
        return sys_vs(tv_x, vy, " px between glyphs", dr)
    }
    return sys_vt(tv_x, vy, "case, weight and rule weight. never size", dr)
}

# 14 TYPE'S EVENT ARM, which did not exist. app_draw tests this id before the
# registry fall-through and says why - it is above the registry range and
# reg_draw "has never heard of them and would draw nothing at all" - and
# app_event was never given the same treatment, so every key and every wheel
# notch went to reg_event, which does not know it either.
#
# A dispatcher corrected on one side and not the other is the same defect twice:
# the draw path was fixed and the event path kept the bug the fix describes.
#
# The system pane is deliberately NOT given an arm here: it has no scrollable
# list and no controls, so an empty handler would be a claim that it does.
fn type_event(win, ety, ecode) {
    if ety == 5 {
        ty_scroll = ty_scroll + ecode
        if ty_scroll < 0 { ty_scroll = 0 }
        wm_dmg(win)
        return 1
    }
    if ety != 3 { return 0 }
    if ecode == K_UP   { ty_scroll = ty_scroll - 1  if ty_scroll < 0 { ty_scroll = 0 }  wm_dmg(win)  return 1 }
    if ecode == K_DOWN { ty_scroll = ty_scroll + 1  wm_dmg(win)  return 1 }
    return 0
}

fn type_body(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    # ui_begin PUTS THE TOOLKIT BACK IN DRAW MODE, and it is not decoration.
    # ui_text() gates on ui_mode_get() while ui_text_tracked() deliberately
    # does not, so a pane that mixed the two after some other window's
    # hit-test pass had left L.mode at UI_HITTEST would draw its tracked
    # labels and none of its values. One call, and both halves agree.
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    tb_x = ax + pad_d()
    tb_w = aw - 2 * pad_d()
    tb_y = ay + pad_d()
    tb_bot = ay + ah - pad_d()

    # FACES, and the count on the right is the number of atlases that are IN
    # this image, not the number the design named.
    ui_caps(tb_x, tb_y + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, "faces", theme(TH_TEXT_2), PW_SM)
    ui_txt(tb_x + pw_colw(tb_w, 18), tb_y + (pw_kvh() - 1 - cell_h()) / 2, "DejaVu Sans + DejaVu Sans Mono", theme(TH_TEXT), PW_SM, PW_MONO)
    tb_fw = ty_row_val(0, tb_y, 0, 0)
    ty_row_val(tb_x + tb_w - tb_fw, tb_y, 0, 1)
    tb_y = sys_rowend(tb_x, tb_y, tb_w) + PW_CARDGAP * ui()

    tb_y = ty_specimen(tb_x, tb_y, tb_w) + PW_CARDGAP * ui()

    tb_y = pw_sect(tb_x, tb_y + pad_d(), tb_w, "every atlas this design names or this image links", atlas_n(), " rows")
    tb_y = ty_head(tb_x, tb_y, tb_w)
    tb_y = ty_rows(tb_x, tb_y, tb_w, tb_bot)

    # ---- the four statements, and each one carries a measurement ------------
    # SIZES reads the LIVE px of the three registers, not design.h's 11/13/21,
    # so on a panel where the ladder collapses the row says so.
    if tb_y + 4 * pw_kvh() + pad_d() < tb_bot {
        tb_y = tb_y + pad_d()
        tb_i = 1
        while tb_i < TY_ROWS_N {
            ui_caps(tb_x, tb_y + (pw_kvh() - 1 - ui_th(PW_SM)) / 2, ty_rowk_name(tb_i), theme(TH_TEXT_2), PW_SM)
            tb_rw = ty_row_val(0, tb_y, tb_i, 0)
            ty_row_val(tb_x + tb_w - tb_rw, tb_y, tb_i, 1)
            tb_y = sys_rowend(tb_x, tb_y, tb_w)
            tb_i = tb_i + 1
        }
    }
    return 0
}

# ---- the two windows --------------------------------------------------------
# IDS 71 AND 72, ABOVE THE REGISTRY RANGE, which is where APP_CATALOG (70)
# already lives and for the same reason: 15..50 belongs to apps_registry.zl and
# its five slices, and a kernel-owned id inside that range is a collision
# waiting for the next app somebody adds there. app_draw and app_name test
# these BEFORE their `id >= REG_FIRST` fall-through, exactly as they do for the
# catalog. check-appids.py reads both numbers out of this file.
APP_SYSPANE  = 71
APP_TYPEPANE = 72

syspane_win  = 0 - 1
typepane_win = 0 - 1

# THE PANEL REFRESH IS MEASURED HERE AND NOWHERE ELSE. intel_refresh_mhz()
# counts frames across 500 ms of the PIT (intel.c:699), so it is a HALF SECOND
# of wall clock every time it is called - which is fine once, on a window the
# user just asked for, and ruinous inside app_draw, where it would run on every
# repaint of a window that is repainted whenever anything overlaps it. It
# returns 0 immediately when the pipe is not enabled, so on QEMU, BGA and
# virtio-gpu this costs nothing and the card falls back to the compositor's own
# count. Measured once per OPEN rather than once per boot because a mode change
# between opens would leave a stale rate on screen wearing the word "measured".
fn syspane_measure() {
    sys_hz = gpu_hz()
    return sys_hz
}

fn open_syspane() {
    op_u = ui()
    if syspane_win >= 0 { if wm_open_p(syspane_win) == 1 {
        wm_setfocus(syspane_win)  wm_raise(syspane_win)  return 1
    }}
    syspane_measure()
    # 560 x 620 design px is the height the fourteen graded rows need on top of
    # the cards and the six inventory rows; anything shorter and sys_body says
    # on screen how many rows it had room for rather than quietly truncating.
    syspane_win = wm_open(APP_SYSPANE, "System", desk_x(96), desk_y(56), 560 * op_u, 620 * op_u)
    if syspane_win < 0 { return 0 }
    wm_report(syspane_win)
    return 1
}

fn open_typepane() {
    ot_u = ui()
    if typepane_win >= 0 { if wm_open_p(typepane_win) == 1 {
        wm_setfocus(typepane_win)  wm_raise(typepane_win)  return 1
    }}
    typepane_win = wm_open(APP_TYPEPANE, "Type", desk_x(140), desk_y(96), 600 * ot_u, 520 * ot_u)
    if typepane_win < 0 { return 0 }
    wm_report(typepane_win)
    return 1
}

# ---- THE APP CONTRACT ------------------------------------------------------
# Three functions, no loop, ever. wm.c calls these through wmglue.c, which
# reaches them as zl_fn_app_* because zl compiles TO C. See ui.h and
# docs/archive/superseded/desktop-wiring.md.
#
# app_draw is handed the CLIENT area. The bodies below were written against the
# WINDOW origin, so the title bar height is subtracted back off - which is
# exactly the kind of thing that has to be done once, here, rather than by
# editing sixty coordinates.


# ---- SNAKE AS A REAL APP ---------------------------------------------------
# desktop-TODO 2e names this as the one to convert first, and it is right: the
# game's state has lived in raw memory (SNAKE_X / SNAKE_Y) since long before
# any of this, so there is nothing to move - only a `while` loop to delete.
#
# THE LOOP IS THE WHOLE POINT. snake_game() owned the screen and owned the
# keyboard: it cleared the framebuffer, spun until you died, and ended with
# "press any key". Three functions and no loop turn that into a window you can
# drag another window across while the snake keeps moving. That sentence -
# "Snake keeps playing while you drag the System Monitor" - is the interaction
# target desktop-TODO states in Roy's words, and this is the first app to
# actually meet it.
#
#   sn_draw   position-pure: every cell derived from the client rect it is
#             handed, nothing baked in, called only when damaged
#   sn_event  one key per call, no waiting
#   sn_step   runs every frame, cheap, DRAWS NOTHING, returns 1 when the board
#             changed - which is what asks for the repaint
SN_CELL = 8                        # design units; x ui() for pixels
sn_gw = 0                          # grid, in cells - set by the first draw
sn_gh = 0
sn_len = 0
sn_dx = 1
sn_dy = 0
sn_fx = 0
sn_fy = 0
sn_score = 0
sn_alive = 0
sn_next = 0
sn_seed = 12345
sn_ready = 0

# THE GENERATOR ac_rand SAID IT WAS COPYING - "proven already, not reinvented".
#
# It has the identical fault, and the citation is how it spread: zl values are
# doubles, zl_binop casts to long long and back, and after two steps the product
# passes 2^53 so the round trip zeroes the low bits of the state. `sn_seed / 256`
# then takes bits whose bottom two are the dead ones, and every modulus that is
# a multiple of two collapses - which for Snake is the direction the food spawns
# in.
#
# "Proven" meant "already in the tree", which is not the same claim.
#
# MINSTD, same as ac_rand: the largest product is 16807 * 2147483646 = 3.61e13
# against 2^53 = 9.01e15, so nothing rounds and the low bits stay alive.
fn sn_rand(n) {
    sn_seed = (sn_seed * 16807) % 2147483647
    if sn_seed < 1 { sn_seed = 1 }
    r = idiv(sn_seed, 64) % n
    if r < 0 { r = 0 - r }
    return r
}

# (Re)start on a grid of gw x gh cells. Called by the draw when the window it
# is given is a different size from the one it last laid out for - which is
# also what makes the game survive a resize instead of drawing off the edge.
fn sn_reset(gw, gh) {
    sn_gw = gw
    sn_gh = gh
    sn_len = 5
    shx = gw / 2
    shy = gh / 2
    si = 0
    while si < sn_len {
        poke8(SNAKE_X + si, shx - si)
        poke8(SNAKE_Y + si, shy)
        si = si + 1
    }
    # PAUSED UNTIL THE FIRST STEER. It used to start moving right, and in a
    # window it is dead against the wall in under two seconds - before anyone
    # has looked at it, let alone touched a key. A game that requires you to
    # already be holding a key when it opens is not a game.
    sn_dx = 0
    sn_dy = 0
    sn_seed = ticks() + 7
    sn_fx = sn_rand(gw)
    sn_fy = sn_rand(gh)
    sn_score = 0
    sn_alive = 1
    sn_next = ticks() + 7
    sn_ready = 1
    return 0
}

# ONE KEY PER CALL. w a s d steer; r restarts after a death. Nothing here
# waits, and nothing here ends the app - the close box and Ctrl+W do that, like
# every other window.
fn sn_event(ety, ecode) {
    if ety != 3 { return 1 }
    if ecode == 119 { if sn_dy == 0 { sn_dx = 0  sn_dy = 0 - 1 } }
    if ecode == 115 { if sn_dy == 0 { sn_dx = 0  sn_dy = 1 } }
    if ecode == 97  { if sn_dx == 0 { sn_dx = 0 - 1  sn_dy = 0 } }
    if ecode == 100 { if sn_dx == 0 { sn_dx = 1  sn_dy = 0 } }
    if ecode == 114 { if sn_alive == 0 { sn_reset(sn_gw, sn_gh) } }
    return 1
}

# Every frame, cheap, MUST NOT DRAW. Returns 1 to say "repaint me".
fn sn_step() {
    if sn_ready == 0 { return 0 }
    if sn_alive == 0 { return 0 }
    if sn_dx == 0 { if sn_dy == 0 { return 0 } }      # paused: nothing to do
    if ticks() < sn_next { return 0 }
    sn_next = ticks() + 7
    nhx = peek8(SNAKE_X) + sn_dx
    nhy = peek8(SNAKE_Y) + sn_dy
    if nhx < 0      { sn_alive = 0 }
    if nhx >= sn_gw { sn_alive = 0 }
    if nhy < 0      { sn_alive = 0 }
    if nhy >= sn_gh { sn_alive = 0 }
    si = 0
    while si < sn_len {
        if peek8(SNAKE_X + si) == nhx {
            if peek8(SNAKE_Y + si) == nhy { sn_alive = 0 }
        }
        si = si + 1
    }
    if sn_alive == 0 { return 1 }
    if nhx == sn_fx {
        if nhy == sn_fy {
            sn_score = sn_score + 1
            sn_len = sn_len + 1
            sn_fx = sn_rand(sn_gw)
            sn_fy = sn_rand(sn_gh)
        }
    }
    si = sn_len - 1
    while si > 0 {
        poke8(SNAKE_X + si, peek8(SNAKE_X + si - 1))
        poke8(SNAKE_Y + si, peek8(SNAKE_Y + si - 1))
        si = si - 1
    }
    poke8(SNAKE_X, nhx)
    poke8(SNAKE_Y, nhy)
    return 1
}

# POSITION-PURE. The whole board every time, from state - which is what makes
# it survive a window being dragged across it. The old version painted each
# cell as it changed and could not be repainted at all, which is exactly the
# problem term.c's scrollback solves for the shell.
fn sn_draw(ax, ay, aw, ah) {
    u = ui()
    cell = SN_CELL * u
    gw = aw / cell
    gh = (ah - 3 * SN_CELL * u) / cell        # a strip at the top for the score
    if gw < 8  { gw = 8 }
    if gh < 6  { gh = 6 }
    if gw > 200 { gw = 200 }                  # SNAKE_X is a 512-byte page
    if gh > 200 { gh = 200 }
    if sn_ready == 0 { sn_reset(gw, gh) }
    if gw != sn_gw { sn_reset(gw, gh) }
    if gh != sn_gh { sn_reset(gw, gh) }

    by = ay + 3 * SN_CELL * u
    # THE BOARD IS A PIT, which is what design.h's ZD_SURF_GAME already says
    # (it resolves to ZD_CUT). This was rgb(9,12,22), a blue-black left over
    # from the predecessor palette - the last three raw colours in the shell,
    # and the reason the "no colour literal outside design.h" rule was still
    # not true. A game canvas is furniture, not user content: the seven in
    # paint_col() stay because a paint colour is something the user chose.
    fill_rgb(ax, by, gw * cell, gh * cell, theme(TH_CUT))
    label(ax + 2 * u, ay + 2 * u, "SCORE", theme(TH_TEXT_DIM), T_CAPTION, W_BOLD)
    label_num(ax + 56 * u, ay + 2 * u, sn_score, theme(TH_ACCENT), T_CAPTION, W_BOLD)
    # C_RED is a VGA TEXT ATTRIBUTE (0x0C), and this was the one place in the
    # file it reached a function that wants an RGB. label() would have drawn
    # rgb(0, 0, 12) - black on a near-black board, so the one message the
    # player has to see was the least visible thing on screen. Every other
    # C_RED in this file goes to color(), which is the console and is correct.
    if sn_alive == 0 { label(ax + 110 * u, ay + 2 * u, "game over - press r", theme(TH_DANGER), T_CAPTION, W_BOLD) }
    if sn_alive == 1 {
        if sn_dx == 0 { if sn_dy == 0 { label(ax + 110 * u, ay + 2 * u, "w a s d to start", theme(TH_ACCENT), T_CAPTION, W_REG) } }
        if sn_dx != 0 { label(ax + 110 * u, ay + 2 * u, "w a s d to steer", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
        if sn_dy != 0 { label(ax + 110 * u, ay + 2 * u, "w a s d to steer", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    }

    # the food, then the body, then the head - painted last so a head that has
    # just eaten is drawn over the food rather than under it
    # THE FOOD IS THE OVERPRINT, and this is the one case where the design's
    # rule and the game's rule are the same sentence: vermilion marks THE ONE
    # THING TO ACT ON. The head moves to the knockout, which is the value
    # inversion this design uses everywhere for "the live one" - a focused
    # header, a selected row, an engaged switch, and now the head of a snake.
    fill_rgb(ax + sn_fx * cell + 1, by + sn_fy * cell + 1, cell - 2, cell - 2, theme(TH_ACCENT))
    si = sn_len - 1
    while si > 0 {
        sbx = ax + peek8(SNAKE_X + si) * cell
        sby = by + peek8(SNAKE_Y + si) * cell
        fill_rgb(sbx + 1, sby + 1, cell - 2, cell - 2, theme(TH_TEXT_2))
        si = si - 1
    }
    shx = ax + peek8(SNAKE_X) * cell
    shy = by + peek8(SNAKE_Y) * cell
    fill_rgb(shx + 1, shy + 1, cell - 2, cell - 2, theme(TH_KNOCK))
    return 0
}

# ---- Files: the persistent zlfs file manager ------------------------------
# 20, not 24. design.h ZD_LISTROW_H is 20 and decomposes exactly against the
# prototype: --lh-sm 15 leading + td padding 2+2 + a 1px groove. ui_grid_row_h()
# already returns that; this list was the one table not using it.
FILES_ROW = 20

# THE LIST'S GEOMETRY, IN ONE PLACE. Where row 0 starts and how many rows fit
# were each computed in three different places, and two of the three copies
# were wrong in different ways. Both take the client's own y or height so the
# draw, the hit test and the keyboard cannot drift apart again.
# THE FILESYSTEM'S CLOCK, WHICH NOTHING HAD EVER SET.
#
# fs.c writes FE_MTIME on every create and every write - from `now_secs`, which
# fs_set_time() sets and which is bound to zl as `fs_stamp`. Until a file is
# written after the clock has been read, now_secs is 0, every mtime is 0, and
# the Files pane's "modified" column prints 00:00 for every row.
#
# THE FIRST VERSION OF THIS COMMENT SAID fs_stamp HAD "ZERO CALLERS". It had
# one, in the shell's `;` command, and it had had it since the command was
# written - `git log -S` finds it immediately. Worse than being wrong, the claim
# was load-bearing: believing the field was unwritten is exactly what made it
# reasonable to add a SECOND writer in a different unit, and the two then took
# turns filling one field with seconds-since-1970 and seconds-since-midnight.
#
# The check that would have caught it is the one this file keeps asking for
# elsewhere and did not run here: grep for the name before describing what
# calls it. A negative existence claim is a measurement, and this one was
# asserted rather than taken.
#
# SECONDS SINCE MIDNIGHT, not since an epoch. This kernel has no epoch - the RTC
# gives wall-clock fields and nothing converts them - so the stamp is what it
# can honestly be, and the column head says so. rtc_up() re-reads the CMOS;
# rtc_here() guards a machine with no CMOS at all.
# hh:mm from seconds-since-midnight, using the same zero-padded field the rail's
# clock uses - a clock that reads "9:5" is worse than no clock, as that helper's
# own comment says.
fn files_hhmm(hx, hy, secs, col) {
    # A STAMP THAT IS NOT A TIME OF DAY IS NOT DRAWN AS ONE. An existing volume
    # can still be carrying epoch-based mtimes written before the two time bases
    # were merged, and clock_field does not clamp - it draws every digit it is
    # given and then advances by exactly two cells, so a six-digit hour runs
    # straight through the colon and the minute field. There is no way to
    # recover a wall time from such a stamp, so the column says it has none.
    if secs < 0 or secs >= 86400 {
        label(hx, hy, "--:--", col, T_CAPTION, W_REG)
        return 0
    }
    fx2 = clock_field(hx, hy, idiv(secs, 3600), CLOCK_DIGIT * ui(), T_CAPTION, col)
    label(fx2, hy, ":", col, T_CAPTION, W_REG)
    clock_field(fx2 + CLOCK_DIGIT * ui(), hy, idiv(secs, 60) % 60, CLOCK_DIGIT * ui(), T_CAPTION, col)
    return 0
}

fn fs_stamp_now() {
    if rtc_here() == 0 { return 0 }
    if rtc_up() == 0 { return 0 }
    fs_stamp(rtc_h() * 3600 + rtc_mi() * 60 + rtc_s())
    return 1
}

fn files_list_top(cy) { return cy + 62 * ui() + ui_colhead_h() }
# THE DETAIL BLOCK'S HEIGHT, reserved out of the list so the two cannot overlap.
# R.files puts a rule, a selected-file row, four kv rows and a three-button row
# under its table; this pane had none of it and gave the whole client to the
# list. One owner, because the list's row count and the block's origin are the
# same subtraction from opposite ends.
# DERIVED, NOT GUESSED. This was 116 and the block spends more: 10dp of lead,
# four kv rows at PW_KVH each, 4dp before the pills, the pill's own height, and
# a foot margin. At 116 the three buttons were drawn past the bottom of the
# client rect and clipped by it - a button row half off its own pane.
#
# Written as the sum so that changing a row count or PW_KVH moves the
# reservation with it, rather than leaving a constant that was right once.
fn files_detail_h() { return 10 + 4 * PW_KVH + 4 + FILES_PILL_H + 10 }
FILES_PILL_H = 22                  # ui_pill_h(S3_MD) in design units

fn files_detail_y(cy, ch) { return cy + ch - files_detail_h() * ui() }

fn files_list_rows(ch) {
    flr = idiv(ch - 104 * ui() - files_detail_h() * ui() - ui_colhead_h(), FILES_ROW * ui())
    if flr < 1 { return 1 }
    return flr
}
files_sel = 0 - 1
files_scroll = 0
files_new = 0
files_delete = 0 - 1
files_format = 0

fn files_select_first() {
    if fs_ok() == 0 { files_sel = 0 - 1  return 0 }
    if files_sel >= 0 { if fs_inuse(files_sel) == 1 { return 1 } }
    files_sel = 0 - 1
    files_fi = 0
    while files_fi < fs_max() {
        if files_sel < 0 { if fs_inuse(files_fi) == 1 { files_sel = files_fi } }
        files_fi = files_fi + 1
    }
    return 1
}

fn files_refresh() {
    files_new = 0
    files_delete = 0 - 1
    files_format = 0
    if fs_ok() == 0 { fs_mount() }
    files_select_first()
    return fs_ok()
}

fn files_prev() {
    files_pi = files_sel - 1
    while files_pi >= 0 {
        if fs_inuse(files_pi) == 1 { files_sel = files_pi  files_delete = 0 - 1  return 1 }
        files_pi = files_pi - 1
    }
    return 0
}

fn files_next() {
    files_ni = files_sel + 1
    if files_ni < 0 { files_ni = 0 }
    while files_ni < fs_max() {
        if fs_inuse(files_ni) == 1 { files_sel = files_ni  files_delete = 0 - 1  return 1 }
        files_ni = files_ni + 1
    }
    return 0
}

fn files_sel_order() {
    files_oi = 0
    files_on = 0
    while files_oi < fs_max() {
        if fs_inuse(files_oi) == 1 {
            if files_oi == files_sel { return files_on }
            files_on = files_on + 1
        }
        files_oi = files_oi + 1
    }
    return 0
}

fn files_keep_visible(rows) {
    files_ord = files_sel_order()
    if files_ord < files_scroll { files_scroll = files_ord }
    if files_ord >= files_scroll + rows { files_scroll = files_ord - rows + 1 }
    if files_scroll < 0 { files_scroll = 0 }
    return 0
}

fn files_slot_at_order(want) {
    files_ai = 0
    files_an = 0
    while files_ai < fs_max() {
        if fs_inuse(files_ai) == 1 {
            if files_an == want { return files_ai }
            files_an = files_an + 1
        }
        files_ai = files_ai + 1
    }
    return 0 - 1
}

fn files_open_selected() {
    if files_sel < 0 { return 0 }
    return open_disk_editor(files_sel)
}

fn files_finish_new() {
    if fs_nlen() == 0 { note_say("a file needs a name", 260)  return 0 }
    if fs_get() >= 0 { note_say("that file already exists", 300)  return 0 }
    files_made = fs_new(0)
    if files_made < 0 { note_say("could not create file", 300)  return 0 }
    if fs_sync() == 0 { note_say("file create is not durable", 400)  return 0 }
    files_sel = files_made
    files_new = 0
    files_scroll = 0
    note_say("file created", 180)
    return files_open_selected()
}

# the cell mode: size in the low byte, 256 right-aligns, 512 selects mono
FILES_M_NUM = 768
fn files_draw_name(slot, x, y, colour) {
    files_ci = 0
    while files_ci < 23 {
        files_cc = fs_ch(slot, files_ci)
        if files_cc > 0 { char_aa(x + files_ci * cell_w(), y, files_cc, colour) }
        files_ci = files_ci + 1
    }
    return 0
}

# R.files' DETAIL BLOCK AND BUTTON ROW, which this pane did not have.
#
# The reference puts a 2dp rule under its table, then a selected-file row, four
# kv rows, and three buttons - open in editor / hex / stat. Register slot 02 is
# the second surface a person reads and it was the least converted of the
# fourteen: a table and a "bytes free" line.
#
# WHAT IS DRAWN IS WHAT zlfs CAN ANSWER, and the two it cannot say so:
#
#   full path   "/" + the name. zlfs is FLAT - there are no directories - so
#               this is not a stand-in for a path, it IS the path.
#   extent      fs_lba and fs_run, read. "contiguous" is not a hope either:
#               fs.c allocates every file as one contiguous run and says so.
#   mode        zlfs has no mode field, no uid and no gid. The reference prints
#               `rw-r--r--  uid 0  gid 0`; copying that would invent a
#               permission model, which is the same fault as an invented figure
#               and harder to spot because it looks like every other filesystem.
#   crc32       nothing computes one. Summing the file on every frame to fill a
#               row would be work done for a decoration.
#   verdict     R.files puts sw('OK') on the selected row, and I drew it -
#               unconditionally, with no test behind it, in a block whose whole
#               comment is a list of things it refuses to invent. zlfs computes
#               no per-file checksum and fs.c exposes no health field, so a
#               green OK is a claim about INTEGRITY: the one thing a user would
#               act on, and the strongest form an invented figure takes in this
#               design system.
#
#               Deleted rather than replaced with a dash. The dashes that work
#               elsewhere sit in table columns under printed headers - "Mode",
#               "Checksum" - and the header supplies the question the dash
#               declines. This position has no label at all, so a floating "-"
#               at the right edge would answer a question nobody asked.
#
#               And NOT replaced with an extent-bounds check either, which is
#               the tempting version: fs.c already validates every entry at
#               mount and refuses to mount on failure, so the test is true by
#               construction on any volume this pane can reach - a one-state
#               swatch with a two-state legend, which is the fault fixed in the
#               System Monitor two days ago.
FILES_BTN_GAP = 8

fn files_kv_row(x, y, w, k) {
    ui_caps(x, y, k, theme(TH_TEXT_DIM), PW_SM)
    return 0
}

fn files_detail(ax, ay, aw, ah, sel) {
    fdu = ui()
    fdy = files_detail_y(ay, ah)
    fdx = ax + 12 * fdu
    fdw = aw - 24 * fdu
    # the 2dp rule the reference puts between the table and the detail
    fill_rgb(fdx, fdy, fdw, 2 * fdu, theme(TH_CUT))
    fdy = fdy + 10 * fdu
    if sel < 0 {
        ui_txt(fdx, fdy, "no file selected - arrow keys or a click choose one", theme(TH_TEXT_DIM), PW_SM, 0)
        return 0
    }
    # ---- the selected row: name, size, and the swatch
    ui_caps(fdx, fdy, "SELECTED", theme(TH_TEXT_DIM), PW_SM)
    files_draw_name(sel, fdx + 76 * fdu, fdy, theme(TH_TEXT_HI))
    fdsz = fs_bytes(sel)
    num_aa(fdx + fdw - 60 * fdu - s3_numw(fdsz), fdy, fdsz, theme(TH_TEXT_2))

    fdy = fdy + pw_kvh()
    # ---- full path. zlfs is flat, so this is the whole of it.
    files_kv_row(fdx, fdy, fdw, "FULL PATH")
    ui_txt(fdx + 76 * fdu, fdy, "/", theme(TH_TEXT), PW_SM, PW_MONO)
    files_draw_name(sel, fdx + 76 * fdu + cell_w(), fdy, theme(TH_TEXT))
    fdy = fdy + pw_kvh()
    # ---- the extent, read from the directory entry
    files_kv_row(fdx, fdy, fdw, "EXTENT")
    fdex = fdx + 76 * fdu
    ui_txt(fdex, fdy, "lba ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    fdex = fdex + ui_tw("lba ", PW_SM, PW_MONO)
    num_aa(fdex, fdy, fs_lba(sel), theme(TH_TEXT))
    fdex = fdex + s3_numw(fs_lba(sel))
    ui_txt(fdex, fdy, "  run ", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    fdex = fdex + ui_tw("  run ", PW_SM, PW_MONO)
    num_aa(fdex, fdy, fs_run(sel), theme(TH_TEXT))
    fdex = fdex + s3_numw(fs_run(sel))
    ui_txt(fdex, fdy, "  one extent, contiguous", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    fdy = fdy + pw_kvh()
    # ---- the two the filesystem cannot answer, saying so
    files_kv_row(fdx, fdy, fdw, "MODE")
    ui_txt(fdx + 76 * fdu, fdy, "zlfs carries no mode, uid or gid", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    fdy = fdy + pw_kvh()
    # ---- the buttons
    fdby = fdy + 4 * fdu
    fdbx = fdx
    fdbx = fdbx + s3_btn(fdbx, fdby, "open in editor", 1, 0) + FILES_BTN_GAP * fdu
    fdbx = fdbx + s3_btn(fdbx, fdby, "hex", 0, 0) + FILES_BTN_GAP * fdu
    s3_btn(fdbx, fdby, "stat", 0, 0)
    return 0
}

fn files_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    # DISARM HERE, NOT ONLY IN THE KEY HANDLER. The handler runs on SHIFT F, so
    # a flag armed on a blank disk survived the volume being mounted by anything
    # else - the shell's format, or files_refresh - and sat at 1 with the
    # confirmation banner unreachable, because that banner is drawn inside the
    # empty-state branch. This runs every frame, so the arm cannot outlive the
    # state that justified it.
    if fs_ok() == 1 { files_format = 0 }
    files_u = ui()
    files_rh = FILES_ROW * files_u
    # THE APP NO LONGER PRINTS ITS OWN NAME. The chrome writes "02 FILES rd0"
    # across the title bar - register number, name in tracked caps, volume as
    # the subtitle - so a second "Files" 8 dp inside the client was the same
    # word twice, 30 dp apart, in two sizes and two weights. It survived every
    # earlier pass because it read as a heading for the list; it only became a
    # duplicate when the title bar grew the register and the subtitle.
    if fs_ok() == 0 {
        # THE EMPTY STATE IS A STATE, NOT A GAP. This was two stranded labels
        # adrift in a full-size plate. A window with nothing to show still has
        # to say what it has nothing OF, why, and what acts on it - and it has
        # to look like the rest of the system while doing it, which here means
        # the same tracked LABEL column head, the same 1px ZD_CUT rule and the
        # same caption register every other table uses.
        #
        # The cause is stated precisely. QEMU does attach an NVMe image and a
        # USB stick, so fs_ok() == 0 means the volume is UNFORMATTED, not
        # absent, and the old copy did not distinguish those.
        files_ex = ax + 12 * files_u
        # IT IS PLACED, NOT DROPPED AT THE TOP. The redone empty state was
        # correct copy in the wrong position: a 120 dp block pinned to the top
        # of a 550 dp client, with 430 dp of nothing under it. Four lines
        # stranded against a ceiling read as a window that failed to finish
        # loading, which is the opposite of what an empty state is for.
        #
        # OPTICALLY centred, at 45% rather than 50%. A block on the true
        # vertical centre reads as sitting low, because the eye takes the
        # centre of a field to be above its midpoint - the same reason a
        # framed picture is hung high. The 5% is the standard correction.
        files_eh = 120 * files_u
        files_ey = ay + (ah - files_eh) * 45 / 100
        if files_ey < ay + 10 * files_u { files_ey = ay + 10 * files_u }
        # BOUNDED MEASURE. The rule used to span the full client - a 1 px hair
        # 940 dp wide over four short lines, joined to nothing at its right end.
        # A rule is only a rule if it is the width of what it heads.
        files_ew = aw - 24 * files_u
        if files_ew > 400 * files_u { files_ew = 400 * files_u }
        ui_caps(files_ex, files_ey, "VOLUME", theme(TH_TEXT_2), T_CAPTION)
        fill_rgb(files_ex, files_ey + 16 * files_u, files_ew, 1, theme(TH_CUT))
        label(files_ex, files_ey + 28 * files_u, "no zlfs volume is mounted", theme(TH_TEXT_HI), T_BODY, W_REG)
        # THE CAUSE IS NOW READ, AND FORMAT IS ONLY OFFERED FOR ONE OF THEM.
        #
        # This printed "the disk is present and unformatted" whenever fs_ok()
        # was 0, and offered SHIFT F to erase the disk on the same unguarded
        # arm. fs_mount_impl returns 0 from TEN distinct places and exactly one
        # of them is that state. One of the other nine is the checksum failure,
        # where fs.c prints "the volume is damaged, not empty. Nothing was read."
        # - and this pane answered that by inviting the user to erase it. A
        # recoverable volume, described as blank, with the destructive action
        # already on screen.
        #
        # The comment that used to justify the line said QEMU attaches an NVMe
        # image so fs_ok() == 0 must mean unformatted. That is a claim about the
        # host, not a reading of it, and it is false on any machine with no NVMe
        # controller - which fs.c has a distinct message for.
        files_why = fs_why()
        files_ok_to_format = 0
        if files_why == FS_WHY_UNFORMATTED { files_ok_to_format = 1 }
        # ELEVEN ARMS AND ONE FALLBACK, COUNTED BY A FLAG. The fallback used to
        # be a five-deep nest of `!=` tests, which is how five of the eleven
        # causes came to be missing from it without anyone noticing: the nest
        # named the causes it EXCLUDED, so a cause nobody had written an arm
        # for was silently included in "not reported". A flag names the causes
        # that were HANDLED instead, so a new fs.c code shows up as an honest
        # unhandled reason rather than a wrong sentence.
        files_said = 0
        if files_why == FS_WHY_NODISK { label(files_ex, files_ey + 52 * files_u, "no disk - the NVMe controller did not come ready", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_UNFORMATTED { label(files_ex, files_ey + 52 * files_u, "the disk is present and unformatted", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_DAMAGED { label(files_ex, files_ey + 52 * files_u, "the volume is DAMAGED, not empty. nothing was read", theme(TH_WARN), T_CAPTION, W_BOLD)  files_said = 1 }
        if files_why == FS_WHY_UNREADABLE { label(files_ex, files_ey + 52 * files_u, "the superblock could not be read", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_VERSION { label(files_ex, files_ey + 52 * files_u, "an on-disk version this build refuses to mount", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_GEOMETRY { label(files_ex, files_ey + 52 * files_u, "the volume geometry does not fit this disk", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        # The five fs.c reports that this pane used to answer with silence.
        # Each sentence is fs.c's own, shortened to the caption measure: the
        # console and the pane must not describe the same refusal differently.
        if files_why == FS_WHY_BLOCKSIZE { label(files_ex, files_ey + 52 * files_u, "the volume's block size is not this disk's", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_MAXFILES { label(files_ex, files_ey + 52 * files_u, "the directory holds a count this kernel does not expect", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_DIRLOAD { label(files_ex, files_ey + 52 * files_u, "the directory blocks could not be read", theme(TH_TEXT_DIM), T_CAPTION, W_REG)  files_said = 1 }
        if files_why == FS_WHY_DIRENTRY { label(files_ex, files_ey + 52 * files_u, "a directory entry points outside the data area", theme(TH_WARN), T_CAPTION, W_BOLD)  files_said = 1 }
        # NOT A REFUSED MOUNT - AN UNMOUNT. fs.c:439-446 drops `mounted` after
        # a directory it could not repair, so this volume WAS open and is now
        # closed on purpose. Saying "refused" about it would misdescribe both
        # the moment and the disk.
        if files_why == FS_WHY_DIRBROKEN { label(files_ex, files_ey + 52 * files_u, "the directory is inconsistent - unmounted rather than written to", theme(TH_WARN), T_CAPTION, W_BOLD)  files_said = 1 }
        if files_said == 0 { label(files_ex, files_ey + 52 * files_u, "the mount was refused - reason not reported", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
        ui_caps(files_ex, files_ey + 82 * files_u, "R", theme(TH_TEXT_2), T_CAPTION)
        label(files_ex + 78 * files_u, files_ey + 82 * files_u, "retry the mount", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        # SHIFT F IS NOT DRAWN UNLESS THE DISK IS ACTUALLY BLANK. Offering an
        # erase beside "the volume is damaged" is how a person loses a volume
        # that fsck could have opened.
        if files_ok_to_format == 1 { ui_caps(files_ex, files_ey + 102 * files_u, "SHIFT F", theme(TH_TEXT_2), T_CAPTION) }
        if files_ok_to_format == 1 { label(files_ex + 78 * files_u, files_ey + 102 * files_u, "format - twice to confirm", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
        if files_ok_to_format == 0 { label(files_ex, files_ey + 102 * files_u, "format is not offered for this cause", theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
        # ONE key column, so the two descriptions align. They were indented to
        # their own key's width - 24 dp and 78 dp - which set the two hints on
        # two different left edges and made the pair read as unrelated.
        if files_format == 1 {
            rrect(files_ex, files_ey + 126 * files_u, files_ew, 24 * files_u, 2 * files_u, theme(TH_DANGER))
            label(files_ex + 8 * files_u, files_ey + 131 * files_u, "SHIFT F again ERASES this disk", theme(TH_INK_ON), T_CAPTION, W_BOLD)
        }
        return 0
    }
    label_num(ax + aw - 130 * files_u, ay + 8 * files_u, fs_n(), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label(ax + aw - 108 * files_u, ay + 8 * files_u, "files", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    if files_new == 1 {
        rrect(ax + 10 * files_u, ay + 34 * files_u, aw - 20 * files_u, 30 * files_u, 6 * files_u, theme(TH_PANEL_HI))
        label(ax + 18 * files_u, ay + 40 * files_u, "New:", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        files_nci = 0
        while files_nci < fs_nlen() {
            char_aa(ax + 66 * files_u + files_nci * cell_w(), ay + 40 * files_u, fs_nch(files_nci), theme(TH_TEXT_HI))
            files_nci = files_nci + 1
        }
        fill_rgb(ax + 66 * files_u + fs_nlen() * cell_w(), ay + 40 * files_u, 2 * files_u, cell_h() - 4 * files_u, theme(TH_ACCENT))
    } else {
        label(ax + 12 * files_u, ay + 40 * files_u, "N new   Enter open   Delete twice remove   R refresh", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    # R.files IS A TABLE, and its column head is what turns a run of names and
    # figures into columns. The reference has five - name, size, kind, perm,
    # mtime - and this has three, because zlfs is a flat store with NO MODES:
    # printing `rw-r--r-- uid 0 gid 0` would be inventing a permission model
    # this filesystem does not have, which is a claim rather than a decoration.
    # Name, size and mtime are all real reads: fs_ch, fs_bytes, fs_when.
    ui_grid("*|90|110")
    ui_colhead(ax, ay + 62 * files_u, aw, "name|size|modified", 0 - 1, 0)
    files_y0 = files_list_top(ay)
    files_rows = files_list_rows(ah)
    if files_rows < 1 { files_rows = 1 }
    files_keep_visible(files_rows)
    files_di = 0
    files_dn = 0
    files_seen = 0
    while files_di < fs_max() {
        if fs_inuse(files_di) == 1 {
            if files_seen >= files_scroll { if files_dn < files_rows {
                    files_ry = files_y0 + files_dn * files_rh
                    if files_di == files_sel {
                        # THE SELECTED ROW WAS rgb(35,58,78) - a blue-slate fill
                        # left over from the palette PRESSWORK replaced, and the
                        # last raw surface literal in an app in this file. It is
                        # ZD_RAISE with the overprint on its left edge now, which
                        # is ZD_SEL_BAR_W / ZD_FOCUS_BAR and the same mark the
                        # register uses for the same meaning: this is the one.
                        # SELECTION IS THE KNOCKOUT, NOT THE HOVER PLUS A BAR.
                        # The prototype separates them explicitly:
                        #   tr.pick:hover:not(.sel) td { background: ZD_RAISE }
                        #   tr.sel td { background: ZD_KNOCK; color: ZD_KNOCK_INK }
                        # and its comment calls the second "the same value flip
                        # the focused header uses". This drew ZD_RAISE - the
                        # HOVER treatment - and added an overprint bar the
                        # reference does not have on a row at all, so the
                        # selected row was the hover state wearing a mark, and
                        # nothing on the pane could show hover afterwards.
                        rrect(ax + 8 * files_u, files_ry, aw - 16 * files_u, files_rh - 2 * files_u, R_INSET_D * files_u, theme(TH_KNOCK))
                    }
                    # ONE INK FOR THE WHOLE TABLE. presswork-prototype.html:784
                    # is `td { color: var(--zd-text-2) }` - one value for every
                    # cell. This drew the name at ZD_TEXT_0 and the two figures
                    # at ZD_TEXT_3: three rungs across one table, which reads as
                    # three kinds of information where the reference has one.
                    files_ink = theme(TH_TEXT_2)
                    if files_di == files_sel { files_ink = theme(TH_KNOCK_INK) }
                    files_draw_name(files_di, ax + 18 * files_u, files_ry + 4 * files_u, files_ink)
                    # size and mtime, in their own tracks and right-aligned as
                    # the reference marks both with `r: 1`
                    ui_gcelln(ax, aw, files_ry, files_rh, 1, fs_bytes(files_di), files_ink, FILES_M_NUM)
                    # A CLOCK, NOT A COUNT OF SECONDS. fs_stamp_now stores
                    # seconds since midnight - this kernel has no epoch, the RTC
                    # gives wall-clock fields and nothing converts them - so the
                    # raw number under a head reading "modified" would be a
                    # figure implying something it is not. Drawn hh:mm, which is
                    # what it actually says. A file written before the stamp
                    # existed reads 0 and shows a dash rather than 00:00, which
                    # is a real time and would be a lie.
                    files_wt = fs_when(files_di)
                    if files_wt > 0 { files_hhmm(ui_gspanx(ax, aw, 2), pw_mcelly(files_ry), files_wt, files_ink) } else { ui_txt(ui_gspanx(ax, aw, 2) + 4 * files_u, pw_mcelly(files_ry), "-", theme(TH_TEXT_DIM), PW_SM, PW_MONO) }
                    files_dn = files_dn + 1
            }}
            files_seen = files_seen + 1
        }
        files_di = files_di + 1
    }
    if fs_n() == 0 { label(ax + 18 * files_u, files_y0 + 8 * files_u, "Empty volume. Press N to create a file.", theme(TH_TEXT_DIM), T_BODY, W_REG) }
    files_detail(ax, ay, aw, ah, files_sel)
    if files_delete >= 0 {
        label(ax + 12 * files_u, ay + ah - 24 * files_u, "Press Delete again to permanently remove the selected file", theme(TH_DANGER), T_CAPTION, W_BOLD)
    } else {
        # RIGHT-FLUSHED, out of the buttons' way: the detail block now owns the
        # bottom-left of this pane and the free figure used to sit on top of it.
        files_fb = fs_free() * fs_bs()
        files_fw = s3_numw(files_fb) + ui_tw(" bytes free", PW_SM, PW_MONO)
        num_aa(ax + aw - 12 * files_u - files_fw, ay + ah - 22 * files_u, files_fb, theme(TH_TEXT_DIM))
        ui_txt(ax + aw - 12 * files_u - files_fw + s3_numw(files_fb), ay + ah - 22 * files_u, " bytes free", theme(TH_TEXT_DIM), PW_SM, PW_MONO)
    }
    return 0
}

# WHICH BUTTON, OR -1. The x edges are recomputed from the same terms
# files_detail draws them with, so a pill and its hit rectangle cannot drift -
# the discipline ca_btn_w and files_list_rows already enforce in this file.
fn files_btn_at(win, ex, ey) {
    if files_sel < 0 { return 0 - 1 }
    fbu = ui()
    fbay = wm_cy(win)
    fbah = wm_ch(win)
    fby = files_detail_y(fbay, fbah) + 10 * fbu + 4 * pw_kvh() + 4 * fbu
    if ey < fby { return 0 - 1 }
    if ey >= fby + ui_pill_h(S3_MD) { return 0 - 1 }
    fbx = wm_cx(win) + 12 * fbu
    fbw = s3_btn_w("open in editor", 0)
    if ex >= fbx { if ex < fbx + fbw { return 0 } }
    fbx = fbx + fbw + FILES_BTN_GAP * fbu
    fbw = s3_btn_w("hex", 0)
    if ex >= fbx { if ex < fbx + fbw { return 1 } }
    fbx = fbx + fbw + FILES_BTN_GAP * fbu
    fbw = s3_btn_w("stat", 0)
    if ex >= fbx { if ex < fbx + fbw { return 2 } }
    return 0 - 1
}

# `stat` in the reference raises a toast. Here it says what the entry actually
# holds, which is the same three facts the detail block draws - so the button
# reports rather than computes, and cannot disagree with the rows above it.
fn files_stat_say() {
    if files_sel < 0 { return 1 }
    note_say2("stat", "size, first block and run length are in the detail block - zlfs holds no mode, owner or checksum", 900)
    return 1
}

fn files_mouse_slot(win, ey) {
    files_mu = ui()
    # THE DRAW AND THE HIT TEST DISAGREED ABOUT WHERE ROW 0 IS.
    #
    # files_draw puts the first row at `ay + 62*u + ui_colhead_h()`; this
    # computed `wm_cy(win) + 72*u`, a bare 72 with no column-head term. Both
    # start from the same client y, so the two are directly comparable and they
    # differ by ui_colhead_h() - 10 dp. Every click landed on a row above the
    # one under the pointer for most of each row's height.
    #
    # And the ROW COUNT was computed three times in three places, two of them
    # dropping the `- ui_colhead_h()` term, so the hit test and the keyboard
    # both believed in one row the draw never puts on screen. Three expressions
    # that must be one number, which is how they came to be three numbers.
    files_my0 = files_list_top(wm_cy(win))
    if ey < files_my0 { return 0 - 1 }
    # "ONE PIXEL ROW IN TWENTY" WAS WRITTEN HERE AND WAS NEVER MEASURED. The
    # claim was that `/` is float, so this index missed every row - and `/`
    # truncates in the compiled kernel (see the idiv note at the top of this
    # file). files_slot_at_order does return -1 for a `want` it cannot reach,
    # which is worth knowing, but nothing was producing an unreachable one.
    files_mrow = idiv(ey - files_my0, FILES_ROW * files_mu)
    files_mrows = files_list_rows(wm_ch(win))
    if files_mrow < 0 { return 0 - 1 }
    if files_mrow >= files_mrows { return 0 - 1 }
    return files_slot_at_order(files_scroll + files_mrow)
}

fn files_event(win, ety, ecode, ex, ey) {
    if files_new == 1 {
        if ety == 1 {
            if ecode == K_ESC { files_new = 0  fs_nclear()  wm_dmg(win)  return 1 }
            if ecode == K_BKSP { fs_npop()  wm_dmg(win)  return 1 }
            if ecode == K_ENTER { files_finish_new()  wm_dmg(win)  return 1 }
        }
        if ety == 3 {
            if ecode == 27 { files_new = 0  fs_nclear()  wm_dmg(win)  return 1 }
            if ecode == 8 { fs_npop()  wm_dmg(win)  return 1 }
            if ecode == 13 { files_finish_new()  wm_dmg(win)  return 1 }
            if ecode >= 32 { if ecode <= 126 { fs_npush(ecode)  wm_dmg(win)  return 1 } }
        }
        return 1
    }
    if ety == 1 {
        files_rows_now = files_list_rows(wm_ch(win))
        if files_rows_now < 1 { files_rows_now = 1 }
        if ecode == K_UP { files_prev()  files_keep_visible(files_rows_now)  wm_dmg(win)  return 1 }
        if ecode == K_DOWN { files_next()  files_keep_visible(files_rows_now)  wm_dmg(win)  return 1 }
        if ecode == K_ENTER { files_open_selected()  return 1 }
        if ecode == K_DEL {
            if files_sel < 0 { return 1 }
            # DELETING A FILE THE EDITOR HAS OPEN HANDS ITS SLOT TO THE NEXT
            # CREATE, AND THE EDITOR THEN WRITES OVER WHOEVER GETS IT.
            #
            # ed_slot is set once at open and never re-validated; editor_save
            # calls fs_wr(ed_slot, ...) and fs_write_impl guards only that the
            # slot is IN USE - it has no identity check. fs_create_impl takes
            # the first free directory slot. Both windows are live at once (the
            # Files pane stays open while the editor runs), so: delete the open
            # file here, create any new one, and the editor's next save lands on
            # the new file's bytes. Its head prints the NEW name the whole time,
            # because ed_name reads fs_ch(ed_slot, i) every frame - the surface
            # asserts the wrong identity while the buffer holds the other file.
            #
            # Refused at the source. fs_rm has exactly one caller in the tree,
            # which is this line, so this is the only entrance to that loss.
            if files_delete == files_sel {
                if edit_win >= 0 {
                    if wm_open_p(edit_win) == 1 {
                        if files_sel == ed_slot {
                            note_say2("that file is open in 04 EDITOR", "close the editor first - deleting it now would hand its slot to the next new file", 900)
                            files_delete = 0 - 1
                            return 1
                        }
                    }
                }
                fs_rm(files_sel)
                if fs_sync() == 0 { note_say("delete is not durable", 400) }
                files_delete = 0 - 1
                files_select_first()
            } else { files_delete = files_sel }
            wm_dmg(win)
            return 1
        }
    }
    if ety == 3 {
        if ecode == 13 { files_open_selected()  return 1 }
        if ecode == 110 { fs_nclear()  files_new = 1  files_delete = 0 - 1  wm_dmg(win)  return 1 }
        if ecode == 114 { files_refresh()  wm_dmg(win)  return 1 }
        if ecode == 70 {
            # THE KEY IS GATED, NOT ONLY THE OFFER. Hiding the SHIFT F hint
            # while leaving the handler live would be worse than leaving both:
            # a destructive control that still fires with nothing on screen
            # saying it is there. fs_format() is fs_mkfs_impl, which zeroes the
            # superblock FIRST - deliberately, by its own comment, so a failed
            # reformat cannot leave a mountable half-volume. There is no undo
            # behind this key.
            # THE ARM MUST NOT OUTLIVE THE STATE IT WAS ARMED IN.
            #
            # files_format was set by the first press and cleared in only three
            # places - module init, files_refresh, and a successful format. Not
            # by the refusal below, and not when the volume came back. The
            # confirmation banner is drawn inside `if fs_ok() == 0`, so once
            # anything mounted the disk the flag could sit at 1 with NOTHING ON
            # SCREEN saying the machine was one keypress from erasing it, and
            # the next time the pane went empty a SINGLE press would format.
            # "format - twice to confirm" was then a promise the code did not
            # keep. Disarm on every path that is not the second press.
            if fs_ok() == 1 { files_format = 0 }
            if fs_ok() == 0 {
                if fs_why() == FS_WHY_UNFORMATTED {
                    if files_format == 1 {
                        if fs_format() == 1 { files_format = 0  files_select_first()  note_say("zlfs formatted", 300) }
                    } else { files_format = 1 }
                } else { files_format = 0  note_say("format refused - this volume is not blank", 400) }
                wm_dmg(win)
            }
            return 1
        }
    }
    if ety == 4 {
        if band(ecode, 1) != 0 {
            # THE THREE BUTTONS, tested BEFORE the list - they sit below it and
            # a click that reaches the list's hit test from down here would
            # select whatever row the arithmetic happened to land on.
            #
            # Wired in the same commit they are drawn in. Three pills with no
            # dispatch arm is the dead-control fault this session has spent its
            # length removing, and adding three more while doing it would be a
            # poor joke.
            # The buttons are only live when the block that draws them is. With
            # no selection files_detail draws a single line and no pills, and
            # the hit test used to answer for them anyway - a click on empty
            # ground opening the editor.
            fbn = 0 - 1
            if files_sel >= 0 { fbn = files_btn_at(win, ex, ey) }
            if fbn == 0 { files_open_selected()  return 1 }
            # THE HEX PILL CANNOT SHOW THIS FILE, and now says so instead of
            # opening something else. reg_open takes an app id and nothing
            # else - files_sel was never handed over - and the Hex Viewer has
            # no file binding of ANY kind: HX_BASE is 0x100000, where boot.S is
            # loaded, and it reads straight through peek8. So "hex" on a file
            # opened a viewer of PHYSICAL RAM, which looks like the file's bytes
            # to anyone who does not know the pane.
            #
            # Wrong content under a right-looking label is worse than no button:
            # the reader has no way to tell. The viewer still opens - the
            # reference has the pill and memory is worth looking at - and the
            # toast says what is on screen.
            if fbn == 1 {
                note_say2("06 HEX reads memory, not files", "it is showing physical RAM from 0x100000 - zlfs has no mapping into the viewer", 900)
                return reg_open(APP_HEXV)
            }
            if fbn == 2 { return files_stat_say() }
            files_hit = files_mouse_slot(win, ey)
            if files_hit >= 0 {
                files_sel = files_hit
                files_delete = 0 - 1
                wm_dmg(win)
                if band(ecode, 256) != 0 { files_open_selected() }
            }
            return 1
        }
    }
    return 0
}

APP_SHELL   = 0
APP_MONITOR = 1
APP_ABOUT   = 2
APP_SNAKE   = 3
APP_MENU    = 4
# ---- the resolver: names into addresses ------------------------------------
# Everything under this is addressed by number. This is the rung that turns
# "a machine I already know the address of" into "a name someone typed".
fn dns_show(dnm) {
    if dns_ask(dnm) == 0 {
        color(C_RED)  put("    could not ask about ")  print(dnm)
        color(C_GREY) return 0
    }
    # Do not use an iteration count as a timeout. On KVM the old 400000-spin
    # ceiling expired in about 430 ms on CDC-ECM; the resolver's valid reply
    # then arrived after the next query had replaced its transaction ID. The
    # PIT is already live here and dns_poll() owns a real three-second bound.
    dstop = ticks() + 310
    dgs = 1
    while ticks() < dstop {
        ip_poll()
        dgs = dns_poll()
        if dgs != 1 { dstop = ticks() }
    }
    if dgs == 2 {
        color(C_GREEN)  put("    ")  put(dnm)  put("  ->  ")
        dip = dns_ip()
        put(band(dip / 16777216, 255))  put(".")
        put(band(dip / 65536, 255))     put(".")
        put(band(dip / 256, 255))       put(".")
        print(band(dip, 255))
        color(C_GREY)  return 1
    }
    if dgs == 3 { color(C_YELLOW)  put("    no such name: ")  print(dnm) }
    if dgs == 4 { color(C_RED)     put("    timed out asking about ")  print(dnm) }
    if dgs == 5 { color(C_RED)     put("    the answer was refused: ")  print(dnm) }
    color(C_GREY)  return 0
}

fn dns_gate() {
    color(C_CYAN)  print("  DNS")
    color(C_GREY)
    dns_server_now = NET_DNS
    if dhcp_state() == 3 { dns_server_now = dhcp_dns() }
    dns_up(dns_server_now)
    if dhcp_state() == 3 {
        put("    asking leased resolver ")
        put(band(dns_server_now / 16777216, 255))  put(".")
        put(band(dns_server_now / 65536, 255))  put(".")
        put(band(dns_server_now / 256, 255))  put(".")
        print(band(dns_server_now, 255))
    } else { print("    asking 10.0.2.3 (diagnostic fallback)") }
    dns_show("example.com")
    dns_show("github.com")
    dns_show("no-such-host-anywhere.invalid")
    put("    queries ")  put(dns_q())  put("  replies ")  put(dns_r())
    put("  refused ")  put(dns_bad())  put("  cached ")  print(dns_n())
    return 0
}

# ---- a real website, by name -----------------------------------------------
# The whole stack in one command: resolve a name we did not choose, open a
# connection to whatever address came back, fetch over HTTP/1.0, parse the
# markup and lay it out. Every layer under this was written this session.
fn tls_gate() {
    color(C_CYAN)  print("  a real website over HTTPS")
    color(C_GREY)
    if ip_live() == 0 {
        print("    the network is not up - run net first")
        return 0
    }
    tls_dns = NET_DNS
    if dhcp_state() == 3 { tls_dns = dhcp_dns() }
    dns_up(tls_dns)
    # www.wikipedia.org is ~120 KB and chains to ISRG Root X2, which is the
    # root roots.c carries. A page that does not chain to it MUST be refused,
    # and that refusal is the point of this gate as much as the success is.
    print("    GET https://www.wikipedia.org/   (verified, not just encrypted)")
    br_go("https://www.wikipedia.org/")
    # A TIME BUDGET, NOT AN ITERATION BUDGET, and that distinction is why the
    # first version of this gate reported a failure that was not one.
    #
    # real_gate's `while i < 900000` works for a 1 KB page over plain HTTP:
    # the ticks are cheap and 900000 of them outlast the fetch. HTTPS is a
    # different shape of wait - a TLS handshake, then SIX ECDSA scalar
    # multiplications through shift-and-add modular arithmetic under TCG, then
    # 120 KB of transfer. The iterations ran out while the work was still in
    # flight, and the gate called that "HTTPS FAILED" when nothing had failed.
    #
    # ticks() is 100 Hz, so a tick is 10 ms and 9000 of them is 90 seconds.
    tgs0 = ticks()
    tgt = tgs0 + 9000
    tgs = 7
    while ticks() < tgt {
        br_tick()
        tgs = br_state()
        # 4 is fetching the document and 7 is resolving its name. Both mean
        # keep pumping; anything else has finished, one way or another.
        if tgs == 4 { } else {
            if tgs == 7 { } else { tgt = 0 }
        }
    }
    put("    took ")  put((ticks() - tgs0) / 100)
    print(" seconds")
    # 8 IS SUCCESS, and getting that wrong reported a working fetch as broken.
    # State 8 is "the page is up, its pictures are arriving" - browser.c moves
    # to it the moment the DOCUMENT has landed and it starts on the
    # stylesheets and images the page asked for. This gate is about the
    # document, so 8 and 0 are the same answer to the question it asks; the
    # difference is only whether the subresources have finished too, and under
    # TCG each of those is its own TLS handshake and can outlast any budget.
    #
    # The state was added this session and this test was not revisited, so it
    # reported "HTTPS FAILED, browser status 8" for a fetch that had entirely
    # succeeded. Adding a state means revisiting everything that enumerates
    # states - there were two loops and this test, and only the loops are
    # obvious.
    # Written as two tests rather than `tgs == 0 or tgs == 8`, because this
    # language's precedence for `or` against `==` is not something to find out
    # from a gate that reports a working fetch as broken.
    tgok = 0
    if tgs == 0 { tgok = 1 }
    if tgs == 8 { tgok = 1 }
    if tgok == 1 {
        color(C_GREEN)  put("    HTTPS OK: ")
        put(br_h())  print(" pixels of laid-out page")
        # THE PAGE'S OWN NUMBERS, not http.c's current ones. By the time this
        # prints, http.c may be describing a stylesheet or a picture the page
        # asked for, so it reported "HTTP 0   body 0 bytes" for a fetch that
        # had worked perfectly. The raw http gate below still reads http.c
        # directly, because there it IS the subject.
        color(C_GREY)  put("    HTTP ")  put(br_code())
        put("   body ")  put(br_doclen())  print(" bytes")
        put("    title: ")  print(br_title())
        color(C_GREY)  return 0
    }
    # WHERE it stopped, not just that it did. 4 is still fetching (the budget
    # ran out), 2 is a TLS or certificate refusal, 3 is DNS, 5 is the fetch.
    color(C_RED)  put("    HTTPS FAILED, browser status ")  put(br_state())
    print("   (4 = still fetching, 2 = refused, 3 = no DNS, 5 = failed)")
    put("    the browser says: ")  print(br_why())
    color(C_GREY)  return 0
}

fn real_gate() {
    color(C_CYAN)  print("  a real website")
    color(C_GREY)
    if ip_live() == 0 {
        print("    the network is not up - press N first")
        return 0
    }
    real_dns = NET_DNS
    if dhcp_state() == 3 { real_dns = dhcp_dns() }
    dns_up(real_dns)
    print("    GET http://example.com/   (a name, not an address)")
    br_go("http://example.com/")
    # Keep pumping while the browser is RESOLVING (7) or FETCHING (4).
    # Anything else means it has finished, one way or the other.
    rgi = 0
    rgs = 7
    while rgi < 900000 {
        br_tick()
        rgs = br_state()
        if rgs == 4 { rgi = rgi + 1 } else {
            if rgs == 7 { rgi = rgi + 1 } else { rgi = 900000 }
        }
    }
    # 8 IS SUCCESS HERE TOO - see the note in the https gate above.
    rgok = 0
    if rgs == 0 { rgok = 1 }
    if rgs == 8 { rgok = 1 }
    if rgok == 1 {
        color(C_GREEN)  put("    fetched and rendered: ")
        put(br_h())  print(" pixels of laid-out page")
        # THE PAGE'S OWN NUMBERS, not http.c's current ones. By the time this
        # prints, http.c may be describing a stylesheet or a picture the page
        # asked for, so it reported "HTTP 0   body 0 bytes" for a fetch that
        # had worked perfectly. The raw http gate below still reads http.c
        # directly, because there it IS the subject.
        color(C_GREY)  put("    HTTP ")  put(br_code())
        put("   body ")  put(br_doclen())  print(" bytes")
        put("    title: ")  print(br_title())
        color(C_CYAN)  print("    press w for the desktop - it is on screen")
        color(C_GREY)  return 0
    }
    color(C_RED)  put("    failed, browser status ")  print(br_state())
    color(C_GREY)  return 0
}

# ---- items 3 and 4: TCP and HTTP, against a real server --------------------
# 10.0.2.2 is the HOST from inside QEMU's user-mode network, so this fetches
# from a python3 -m http.server running on the machine the emulator is on.
# That is a real server, a real three-way handshake and a real response body -
# not a loopback and not a mock.
HTTP_PORT = 8000

fn web_gate() {
    color(C_CYAN)  print("  TCP + HTTP/1.0")
    color(C_GREY)
    if ip_live() == 0 {
        print("    the IP stack is not up - run the network gate first")
        return 0
    }
    tcp_up(NET_ME)
    http_reset()
    if http_get(NET_GW, HTTP_PORT, "10.0.2.2", "/") == 0 {
        color(C_RED)  print("    could not start the fetch")
        color(C_GREY) return 0
    }
    put("    GET http://10.0.2.2:")  put(HTTP_PORT)  print("/  ...")
    wgi = 0
    wgs = 0
    while wgi < 400000 {
        ip_poll()
        tcp_tick()
        wgs = http_poll()
        if wgs > 2 { wgi = 400000 } else { wgi = wgi + 1 }
    }
    put("    tcp state:    ")  print(tcp_st())
    put("    segments:     out ")  put(tcp_tx())  put("  in ")  put(tcp_rx())
    put("  retransmits ")  put(tcp_rexmit())  put("  dup ")  put(tcp_dup())
    put("  out-of-order ")  print(tcp_ooo())
    if wgs == 3 {
        color(C_GREEN)  put("    HTTP ")  put(http_code())
        put("   body ")  put(http_len())  put(" bytes of ")  put(http_total())
        print(" received")
        color(C_GREY)
        if http_trunc() == 1 { color(C_YELLOW)  print("    body truncated - larger than the buffer")  color(C_GREY) }
        # ...and hand it straight to the browser, which is the whole point
        br_load(http_addr(), http_len())
        color(C_CYAN)  print("    loaded into the browser. press w for the desktop.")
        color(C_GREY)  return 0
    }
    if wgs == 5 { color(C_YELLOW)  print("    refused: not text/html or text/plain")  color(C_GREY)  return 0 }
    color(C_RED)  put("    fetch failed in state ")  print(wgs)
    print("    is there a server? on the host:  python3 -m http.server 8000")
    color(C_GREY)  return 0
}

# ---- the network card, and the two-frame proof that it works ---------------
# Item 1's gate: send an ARP request into QEMU's user-mode network, receive the
# reply, print both MACs. Two frames, and it exercises the whole path - PCI
# capability walk, feature handshake, both virtqueues, DMA out and DMA in.
#
# 10.0.2.15 is the address QEMU's user-mode DHCP hands the guest and 10.0.2.2
# is its gateway. We do not speak DHCP, so the address is asserted rather than
# leased - which is fine for an ARP probe and is NOT fine for anything above it.
NET_ME  = 167772687          # 10.0.2.15
NET_GW  = 167772674          # 10.0.2.2

fn mac_print(which) {
    mpi = 0
    while mpi < 6 {
        if mpi > 0 { put(":") }
        if which == 0 { hex(net_mac(mpi), 2) } else { hex(net_peer(mpi), 2) }
        mpi = mpi + 1
    }
    return 0
}

# THE NETWORK COMES UP AT BOOT, WITHOUT BEING ASKED.
#
# It used to require typing `net` (or pressing N), and the browser said so:
# "the network is not up - run the network gate first". That is a fine message
# for a bring-up GATE and a terrible one for a browser - a person who opens a
# browser has already said what they want, and being told to go and run a
# diagnostic first is the shape of a demo rather than a desktop. Every other
# device this kernel drives comes up at boot; the card was the exception only
# because its bring-up started life as a test.
#
# QUIET, AND NOT FATAL. net_gate() prints a page of diagnostics and runs twenty
# pings, which is right for a gate and wrong for a boot. This does the four
# steps that actually matter - find the card, hand it its arena, bring the IP
# stack up, point it at a resolver - reports ONE line, and returns 0 without
# complaint when there is no card. Most gates in this repo boot with no
# -device virtio-net-pci at all, and a boot that printed an error for a machine
# with no network would make every one of those transcripts noisy.
#
# net_gate() is untouched and still does the full diagnostic; it now finds the
# link already up and says so, which is the branch ip_live() already handled.
fn net_boot() {
    # NO CARD IS SILENT; A CARD THAT FAILS IS NOT. Most gates here boot with no
    # -device virtio-net-pci at all, so complaining about a machine that simply
    # has no network would make every one of those transcripts noisy. But a
    # card that IS present and does not come up is a fault, and a boot that
    # says nothing about it is how "the browser cannot reach the network"
    # becomes a mystery later.
    diag_mark(210)                       # automatic network discovery entered
    nf = net_find()
    diag_mark(211)                       # discovery returned
    if nf <= 0 { return 0 }
    if net_ram() == 0 {
        color(C_RED)  print("  network: the DMA arena is not backed by RAM (needs -m 256)")
        color(C_GREY) return 0
    }
    diag_mark(212)                       # selected driver initialization entered
    nu = net_up()
    diag_mark(213)                       # selected driver initialization returned
    if nu == 0 {
        if net_kind() == 2 {
            if net_devid() == 3407 {     # 0x0d4f: PCH I219, not legacy e1000
                diag_mark(216)           # I219 safely quarantined before MMIO
                color(C_YELLOW) print("  network: Intel I219 detected; PCH driver not ready, skipped safely")
                color(C_GREY) return 0
            }
        }
        color(C_RED)  print("  network: the card refused the feature handshake")
        color(C_GREY) return 0
    }
    if net_kind() == 2 {
        color(C_GREEN) put("  network driver: ")
        color(C_GREY) put("Intel e1000e/I219 device 0x")  hex(net_devid(), 4)  print("")
    } else if net_kind() == 3 {
        color(C_GREEN) put("  network driver: ")
        color(C_GREY) print("USB CDC-ECM")
    } else {
        color(C_GREEN) put("  network driver: ")
        color(C_GREY) print("virtio-net")
    }
    diag_mark(214)                       # link attach and DHCP start entered
    ia = ip_auto()
    diag_mark(215)                       # link attach and DHCP start returned
    if ia == 0 {
        color(C_RED)  print("  network: DHCP could not start")
        color(C_GREY) return 0
    }
    color(C_GREEN)  put("  network: ")
    color(C_GREY)   print("link ready, DHCP started")
    return 1
}

fn net_gate() {
    color(C_CYAN)  print("  network")
    color(C_GREY)
    # Never reset a live descriptor ring to run a diagnostic. DHCP may still
    # be selecting while net_ip is zero, so net_attached (the injected link),
    # not ip_live (configured address), owns this choice.
    if net_attached() == 0 {
        if net_find() <= 0 {
            print("    no supported Ethernet device")
            print("    automatic: USB CDC-ECM, virtio-net, Intel 82540/82574")
            print("    Intel I217/I218/I219 are detected but quarantined until the PCH driver exists")
            put("    CDC-ECM stage ")  put(usb_ecm_stage())
            put(" config-index ")      put(usb_ecm_cfg())
            put(" parse 0x")           hex(usb_ecm_bits(), 2)
            put(" completion ")        print(usb_ecm_cc())
            ecdi = 0
            while ecdi < usb_ecm_len() {
                if ecdi % 16 == 0 { put("    CDC cfg: ") }
                hex(usb_ecm_byte(ecdi), 2)  put(" ")
                ecdi = ecdi + 1
                if ecdi % 16 == 0 { print("") }
            }
            if ecdi % 16 != 0 { print("") }
            return 0
        }
        if net_kind() == 1 { put("    DMA arena at  0x")  hex(net_arena(), 8)  print("") }
        if net_kind() == 2 { put("    Intel device:  0x")  hex(net_devid(), 4)  print("") }
        if net_ram() == 0 {
            color(C_RED)  print("    the arena is NOT backed by RAM - needs -m 1G or more")
            color(C_GREY) return 0
        }
        if net_up() == 0 {
            if net_kind() == 2 {
                if net_devid() == 3407 {
                    color(C_YELLOW) print("    Intel I219 PCH initialization is quarantined; no unsafe MMIO was attempted")
                    color(C_GREY) return 0
                }
            }
            color(C_RED)  print("    the device refused the feature handshake")
            color(C_GREY) return 0
        }
    } else {
        if net_kind() == 1 { put("    driver:       virtio-net")  print("") }
        if net_kind() == 2 { put("    Intel device:  0x")  hex(net_devid(), 4)  print("") }
        if net_kind() == 3 { put("    driver:       USB CDC-ECM")  print("") }
    }
    put("    link:         ")   print(net_link())
    put("    our MAC:      ")   mac_print(0)  print("")
    # A diagnostic may wait, but on real time rather than an iteration count:
    # QEMU answered the first Intel DISCOVER in 71 us, still later than 2,048
    # tight MMIO polls. PIT wakeups keep this bounded and let DMA make progress.
    ng_deadline = ticks() + 300
    while ticks() < ng_deadline {
        if dhcp_state() == 1 { dhcp_work() }
        if dhcp_state() == 2 { dhcp_work() }
        if dhcp_state() == 3 { ng_deadline = ticks() }
        if dhcp_state() == 4 { ng_deadline = ticks() }
        if dhcp_state() == 1 { idle() }
        if dhcp_state() == 2 { idle() }
    }
    # ONE LAYER MAY OWN THE RECEIVE QUEUE. The raw ARP probe below drains the
    # card directly and throws away every frame that is not its own reply, so
    # running it once net.c is also draining that queue eats exactly the frames
    # net.c is waiting for. It is a bring-up test, and it is only valid before
    # bring-up.
    if ip_live() == 1 {
        color(C_GREY)  print("    (link already proven; the IP stack owns the queue now)")
        return ip_gate()
    }
    if net_kind() == 2 {
        color(C_YELLOW) put("    Intel link is up but DHCP state is ")  print(dhcp_state())
        color(C_GREY) put("    DHCP retries ")  put(dhcp_retry())
        put(" bad packets ")  put(dhcp_bad())
        put("; driver tx ")  put(net_tx())  put(" rx ")  put(net_rx())
        put(" drops ")  print(net_drop())
        color(C_GREY) return 0
    }
    color(C_GREY)  print("    sending an ARP request for 10.0.2.2 ...")
    if net_arp(NET_ME, NET_GW, 2000) == 0 {
        color(C_RED)  put("    no ARP reply. tx ")  put(net_tx())
        put(" rx ")  put(net_rx())  put(" drops ")  print(net_drop())
        color(C_GREY) return 0
    }
    put("    gateway MAC:  ")   mac_print(1)  print("")
    color(C_GREEN)  put("    LINK UP. frames out ")  put(net_tx())
    put(", in ")  print(net_rx())
    color(C_GREY)  return ip_gate()
}

# ---- item 2: ARP, IPv4, ICMP -----------------------------------------------
# One ping proves a round trip happened. It does NOT prove the stack works: a
# stack that drops every fourth packet looks identical on a single ping, which
# is why this runs twenty and reports loss and jitter as well as a time.
#
# The constants below are only the explicit diagnostic fallback. Normal boot
# uses the DHCP lease and its router/resolver on either virtio or Intel links.
NET_MASK = 4294967040        # 255.255.255.0
NET_DNS  = 167772675         # 10.0.2.3 - QEMU's built-in resolver

fn ip_gate() {
    color(C_CYAN)  print("  IPv4 / ICMP")
    color(C_GREY)
    if ip_live() == 0 {
        if ip_up(NET_ME, NET_MASK, NET_GW) == 0 {
            color(C_RED)  print("    the stack could not be brought up")
            color(C_GREY) return 0
        }
        print("    10.0.2.15/24 via 10.0.2.2  (diagnostic fallback)")
    } else {
        if dhcp_state() == 3 {
            color(C_GREEN) put("    DHCP lease acquired, ")  put(dhcp_lease())  print(" seconds")
            color(C_GREY)
        }
    }
    gate_gw = NET_GW
    if dhcp_state() == 3 { gate_gw = dhcp_gw() }
    pg = ip_ping(gate_gw, 1000)
    if pg < 0 {
        color(C_RED)  print("    no echo reply from the gateway")
        color(C_GREY) return 0
    }
    put("    ping gateway ")
    put(band(gate_gw / 16777216, 255))  put(".")
    put(band(gate_gw / 65536, 255))  put(".")
    put(band(gate_gw / 256, 255))  put(".")
    put(band(gate_gw, 255))  put(":  ")  put(pg)  print(" us")
    color(C_GREY)  print("    ...and 20 more, because one proves nothing:")
    ip_run(gate_gw, 20, 1000)
    put("      sent ")  put(ip_sent())  put("   received ")  put(ip_recv())
    put("   lost ")     print(ip_lost())
    put("      min ")   put(ip_min())   put(" us   avg ")  put(ip_avg())
    put(" us   max ")   put(ip_max())   print(" us")
    put("      jitter ")  put(ip_jit())  print(" us  (mean step between round trips)")
    dns_gate()
    if ip_lost() > 0 { put("      lost pings (bit 0 = the first): 0x")  hex(ip_mask(), 8)  print("") }
    put("      frames in ")  put(ip_rxf())  put("  arp ")  put(ip_rxarp())
    put("  ip ")  put(ip_rxip())  put("  icmp ")  put(ip_rxicmp())
    put("  bad-checksum ")  put(ip_badsum())  put("  not-ours ")  put(ip_notours())
    put("  unmatched-echo ")  print(ip_stale())
    put("      dropped: short ")  put(ip_short())  put("  bad-version ")  put(ip_badver())
    put("  bad-ihl ")  put(ip_badihl())  put("  fragment ")  print(ip_frag())
    put("      driver: tx ")  put(net_tx())  put("  rx ")  put(net_rx())
    put("  rx-truncated ")  put(net_drop())  put("  runts ")  put(net_runt())  put("  tx-queue-full ")  print(net_txfull())
    put("      driver saw: arp ")  put(net_seenarp())  put("  ip ")  put(net_seenip())
    put("   buffers handed back twice: ")  print(net_idreuse())
    print("      device trace  (index: desc-id len ethertype)")
    tri = 0
    while tri < net_trn() {
        put("        ")  put(tri)  put(": id ")  put(net_trid(tri))
        put("  len ")  put(net_trlen(tri))  put("  et 0x")  hex(net_tret(tri), 4)  print("")
        tri = tri + 1
    }
    put("      rings: tx avail ")  put(net_txa())  put(" used ")  put(net_txu())
    put("   rx avail ")  put(net_rxa())  put(" used ")  print(net_rxu())
    if ip_lost() == 0 {
        color(C_GREEN)  print("      no loss")
    } else {
        color(C_YELLOW)  print("      PACKETS WERE LOST - the stack is not clean")
    }
    color(C_GREY)  return 0
}

APP_BROWSER = 5                     # 3 was APP_SNAKE; the union merge gave both the same id
APP_SETTINGS = 6
APP_RUN     = 7                     # 3 is APP_SNAKE, 5 APP_BROWSER, 6 APP_SETTINGS
# apps-in-windows numbered these 4..8, which are APP_MENU, APP_BROWSER,
# APP_SETTINGS and APP_RUN here. Renumbered from 8.
APP_PAINT   = 8
APP_CUBE    = 9
APP_ANIM    = 10
APP_MOUSE   = 11
APP_EDIT    = 12
APP_FILES   = 13

# Which window each app is in, or -1. An app that is already open is FOCUSED
# rather than opened twice - wm.c would happily give you a second Snake, and
# both would drive the same SNAKE_X/SNAKE_Y because the state is module-level.
snake_win = 0 - 1
paint_win = 0 - 1
cube_win  = 0 - 1
anim_win  = 0 - 1
mouse_win = 0 - 1
edit_win  = 0 - 1
edit_prev_focus = 0 - 1
browser_win = 0 - 1
settings_win = 0 - 1
files_win = 0 - 1

# ==============================================================================
# 11 SETTINGS - "design.h, live". The design explaining itself.
# ==============================================================================
#
# THIS PANE IS NOT A PREFERENCES DIALOG AND IT IS NOT A STYLE GUIDE. The
# prototype's own header on it says what it is: "THIS PANE IS WHERE THE DESIGN
# ARGUES FOR ITSELF, and it argues by recomputing rather than by asserting."
# Every ratio on screen is computed at draw time from the tokens that are
# actually loaded, through ui_ratio() - the integer WCAG engine in ui.c - and
# not one of them is a string somebody typed after reading design.h.
#
# WHY THAT DISTINCTION IS THE WHOLE POINT. design.h's own header ends with "do
# not trust this comment - run it". A pane that printed the same figures as
# quoted constants would be the comment again, in a window, and it would go
# stale the first time a token moved by one byte - silently, in the optimistic
# direction, because nobody re-checks a number that is already on screen. A
# pane that recomputes cannot: change ZD_KNOCK and the table says something
# different on the next repaint.
#
# WHAT IS *NOT* COMPUTED, AND IT IS SAID OUT LOUD RATHER THAN DRESSED UP. Three
# figures measure ladders this system does not carry - graphite's own focus
# wash at 1.3999:1, the raking design's loudest element at 6.19:1, and the
# 1,019 px its focus signal covered. There is no token here to compute them
# from. They come from design.h's ZD_REF_*_Q4 block, they are printed in the
# dim ink this pane reserves for a quoted figure, and they sit in the table's
# comparison rows where the eye already reads them as somebody else's numbers.
# Everything drawn in the live inks was computed.
#
# THE TWO CONTROLS ARE LIVE, NOT ILLUSTRATIONS. "the knockout" rebuilds the
# theme with the four knockout roles swapped for graphite's wash and its
# ordinary inks, so every focused header in the system - including this pane's
# own selected tab - falls back while you watch, and the table's first row
# changes from a computed 6.4796:1 to a computed 1.3681:1 in the same repaint.
# "focus bar" sets theme.focus_bar in design px, so the vermilion run down the
# left of every focused plate gets wider and the pixel arithmetic in the table
# follows it. A control that changed a number without changing the screen would
# be exactly the assertion this pane exists to avoid.
#
# WHY IT IS IN zl AND NOT IN C. It used to be in C - settings.c - and that
# file's header gives the reason: "zl exposes NO natives for ui_* at all, so a
# zl Settings app would need ~15 new builtins in runtime_kernel.c first". That
# is no longer true; runtime_kernel.c answers for ui_color, ui_metric and the
# whole ui_* widget set today. The same header says the move would then be "a
# translation, not a redesign". It was not a translation in the end, because
# what this pane has to say changed completely, but the blocker it named is
# gone and policy belongs in zl.
#
# ---- THE FOUR TABS ----------------------------------------------------------
#   LADDER    the one structural decision - why the steps were widened, what
#             the ladder resolves to right now, and what the widening cost
#   FOCUS     the knockout, the sign inversion it used to cause, which side an
#             edge goes on, and the pixel/ratio arithmetic on a 600x420 plate
#   BOUNDARY  the occluder draws the border - and the ceiling that forces it
#   PRESS     what came across from the printed document, and what it cost
#
# FOCUS is the tab this opens on. That is the prototype's own choice for the
# `#settings` scene (it sets setTab = 1 and nothing else), and it is the right
# one: the knockout is the departure the rest of the design was rearranged to
# make room for, so it is the argument to lead with.

SET_LADDER   = 0
SET_FOCUS    = 1
SET_BOUNDARY = 2
SET_PRESS    = 3
SET_TABS     = 4

# ---- geometry, in DESIGN px, read off the prototype's stylesheet --------------
# Not picked by eye. .wbody padding 6/9, .row height 26 and gap 8, .seg > span
# height 20 and padding 0 9, .sw2 34 x 17 with a 13 square knob, .r2 2px,
# .kv .k 132 wide, the slider label column 146 and its value column 62, and the
# settings slider's own 11px mtrack override. Everything else is measured at
# run time from label_h()/cell_h() rather than assumed, because the atlas a
# role lands on is fb.c's decision and not this file's.
SET_PADX   = 9
SET_PADY   = 6
SET_ROWH   = 26
SET_SEGH   = 20
SET_SEGPX  = 9
SET_GAP    = 8
SET_R2     = 2
SET_SWW    = 34
SET_SWH    = 17
SET_KNOB   = 13
SET_TRKH   = 11
SET_LABW   = 146
SET_VALW   = 62
SET_KVKW   = 132
SET_WELLPX = 8
SET_WELLPY = 6
SET_TDPX   = 6
SET_TDPY   = 2
SET_STACK  = 5                     # .stack gap - the space between blocks
SET_SCRLSTEP = 40                  # design px per scroll gesture

# ---- ui.c's two published index spaces --------------------------------------
# ui.h's enum ui_ref_color_id and enum ui_ref_num_id. Numbered here because zl
# has no way to include a C header; the check that they still agree is that
# every figure below reproduces design.h's own prose, which is stated with each
# one at its call site.
SET_REF_LIT_RAKING  = 0
SET_REF_BASE_RAKING = 1
SET_REF_KNOCK_PLATE = 2
SET_REF_WASH_RAKING = 3
SET_RN_PLATE_W   = 0
SET_RN_PLATE_H   = 1
SET_RN_TITLE_H   = 2
SET_RN_RAKING_PX   = 3
SET_RN_GRAPHITE_PX = 4
SET_RN_WASH_Q4     = 5
SET_RN_RAKING_Q4   = 6

set_tab = 1                        # SET_FOCUS. see the note above.
set_scroll = 0                     # px already scrolled off the top
set_conth = 0                      # content height, LEARNED from the last draw
set_viewh = 0                      # the scroll viewport's height, likewise
# The scroll clamp is deliberately fed by the previous frame rather than by a
# measure pass. A second pass that walked the same layout to total it up is a
# second copy of the layout, and this file has uikit.c's warning in front of it:
# a measure/draw disagreement is a clipped label. Learning the height from the
# draw that just happened cannot disagree with that draw, and the one frame of
# lag is invisible - it costs an over-scroll that snaps back on the next
# repaint, and only on the frame you change tabs.

# ---- FIXED POINT, BECAUSE THERE IS NO FLOAT IN THE DRAWING PATH ---------------
# ui_ratio() hands a contrast across the seam as an integer x10^4, so 6.4796:1
# arrives as 64796. These print it. set_q() rescales with ROUNDING - the
# prototype's toFixed(2) rounds, and truncating turns 6.4796 into "6.47", which
# is a different number in the only place anyone checks.
fn set_q(v, dec) {
    setq_p = 1
    setq_i = dec
    while setq_i < 4 { setq_p = setq_p * 10  setq_i = setq_i + 1 }
    return idiv(v + idiv(setq_p, 2), setq_p)
}
fn set_decw(v, dec) {
    setdw_p = 1
    setdw_i = 0
    while setdw_i < dec { setdw_p = setdw_p * 10  setdw_i = setdw_i + 1 }
    return s3_numw(idiv(v, setdw_p)) + (dec + 1) * cell_w()
}
# v is already scaled to `dec` decimals. The fraction is ZERO PADDED, which is
# the whole reason this is not two num_aa calls with a dot between them: 6.0796
# printed that way reads "6.796", one decimal place short and wrong by a factor
# of ten, and it looks entirely plausible.
fn set_dec(x, y, v, dec, col) {
    setd_p = 1
    setd_i = 0
    while setd_i < dec { setd_p = setd_p * 10  setd_i = setd_i + 1 }
    setd_ip = idiv(v, setd_p)
    setd_fr = v - setd_ip * setd_p
    num_aa(x, y, setd_ip, col)
    setd_x = x + s3_numw(setd_ip)
    text_aa(setd_x, y, ".", col)
    setd_x = setd_x + cell_w()
    setd_p = idiv(setd_p, 10)
    while setd_p >= 1 {
        num_aa(setd_x, y, idiv(setd_fr, setd_p) % 10, col)
        setd_x = setd_x + cell_w()
        setd_p = idiv(setd_p, 10)
    }
    return setd_x
}
# A CONTRAST, "6.4796:1", right aligned on xr. Right aligned because a column
# of ratios is read by comparing magnitudes, and left-aligned figures of
# different integer widths put the decimal points in different places.
fn set_rat_r(xr, y, v4, dec, col) {
    setrr_v = set_q(v4, dec)
    setrr_x = xr - set_decw(setrr_v, dec) - 2 * cell_w()
    setrr_x = set_dec(setrr_x, y, setrr_v, dec, col)
    text_aa(setrr_x, y, ":1", col)
    return 0
}
fn set_pct_r(xr, y, v4, dec, col) {
    setpr_v = set_q(v4, dec)
    setpr_x = xr - set_decw(setpr_v, dec) - 2 * cell_w()
    setpr_x = set_dec(setpr_x, y, setpr_v, dec, col)
    text_aa(setpr_x, y, " %", col)
    return 0
}
# A PIXEL COUNT WITH A THOUSANDS SEPARATOR - "16,800". The prototype prints
# every one of these through toLocaleString and the grouping is what makes a
# five figure count readable at a glance in a column beside a percentage.
fn set_thouw(v) {
    if v < 1000 { return s3_numw(v) }
    return s3_numw(idiv(v, 1000)) + 4 * cell_w()
}
fn set_thou_r(xr, y, v, col) {
    setth_x = xr - set_thouw(v)
    if v < 1000 {
        num_aa(setth_x, y, v, col)
        return 0
    }
    setth_hi = idiv(v, 1000)
    num_aa(setth_x, y, setth_hi, col)
    setth_x = setth_x + s3_numw(setth_hi)
    text_aa(setth_x, y, ",", col)
    num3(setth_x + cell_w(), y, v - setth_hi * 1000, col)
    return 0
}

# ---- the recipes, one function each ------------------------------------------
# THE MEASURE AND THE DRAW SHARE THE HELPER. uikit.c already documents why: a
# measure/draw disagreement is a clipped label, and here it would be worse - a
# hit test that lands on the row above the one you clicked. Every control's
# rectangle comes out of one of these, and app_event calls exactly the same
# functions app_draw does rather than re-deriving the same arithmetic.
fn set_rowh() { return SET_ROWH * ui() }
fn set_tdh()  { return cell_h() + 2 * SET_TDPY * ui() + 1 }
fn set_thh()  { return label_h(T_CAPTION) + 2 * SET_TDPY * ui() + SET_R2 * ui() }
fn set_kvh()  { return cell_h() + 2 * ui() + 1 }
fn set_lineh() { return cell_h() }
fn set_headh() { return label_h(T_CAPTION) + SET_STACK * ui() }

# A HARD RULE, and there are exactly two weights. design.h's depth rank inside
# a plate: ZD_CUT at 1dp for rows, cells and group edges; ZD_LIT at 2dp for
# regions, table heads and bands. There is no third rank, and nesting never
# changes a value - which is the rule the BOUNDARY tab prints as a table.
fn set_rule1(x, y, w) { fill_rgb(x, y, w, 1, theme(TH_CUT))  return y + 1 }
fn set_rule2(x, y, w) { fill_rgb(x, y, w, SET_R2 * ui(), theme(TH_LIT))  return y + SET_R2 * ui() }

# A SECTION CAPTION. LABEL style: SM, uppercase, bold, ZD_TEXT_3. It is NOT
# tracked, and that is the one item on the PRESS tab's own bill: fb_text_role
# cannot letterspace without a UI_F_TRACK flag on the existing flag word, and
# measure and draw must share the helper or a tracked label clips. The
# prototype gets tracking free from CSS; here it is unpriced work, and the
# caption reads flatter without it. Named rather than hidden.
fn set_head(x, y, s) {
    label(x, y, s, theme(TH_TEXT_DIM), T_CAPTION, W_BOLD)
    return y + set_headh()
}

# SUNKEN. The .well recipe: ZD_WELL ground, ZD_R_INSET corner, a ZD_CUT ring,
# and the seat's two inset runs WITH THE SIGN FLIPPED - cut along the top
# inside edge, ZD_LITSOFT along the bottom. That inversion is the whole reason
# a well reads as a hole and a card reads as a raise: the light still comes
# from upper left, so a surface below the plane is dark where a surface above
# it is bright. Same lamp, opposite geometry.
fn set_wellh(lines) { return 2 * SET_WELLPY * ui() + lines * set_lineh() }
fn set_well(x, y, w, lines) {
    setwl_u = ui()
    setwl_h = set_wellh(lines)
    rrect(x, y, w, setwl_h, R_INSET_D * setwl_u, theme(TH_CUT))
    rrect(x + 1, y + 1, w - 2, setwl_h - 2, R_INSET_D * setwl_u - 1, theme(TH_SURF_WELL))
    fill_rgb(x + 1, y + 1, w - 2, 1, theme(TH_CUT))
    fill_rgb(x + 1, y + setwl_h - 2, w - 2, 1, theme(TH_LITSOFT))
    return y + setwl_h + SET_STACK * ui()
}
# The baseline of line `n` inside a well. A caller lays a paragraph out by
# COUNTING LINES rather than by carrying a cursor - which matters because a zl
# local is not scoped to its function, so a cursor held across a call to
# another drawing helper is a cursor that helper can move out from under it.
fn set_wly(y, n) { return y + SET_WELLPY * ui() + n * set_lineh() }

# ---- table furniture ---------------------------------------------------------
# A column head is LABEL on the plate with a 2dp ZD_LIT rule under it; a body
# cell is DATA mono at ZD_TEXT_2 with a 1dp ZD_CUT rule under it. Two rule
# weights, no borders, no zebra - the ruling IS the table.
fn set_th(x, y, s) {
    label(x + SET_TDPX * ui(), y + SET_TDPY * ui(), s, theme(TH_TEXT_DIM), T_CAPTION, W_BOLD)
    return 0
}
fn set_th_r(xr, y, s) {
    label(xr - SET_TDPX * ui() - label_w(s, T_CAPTION, W_BOLD), y + SET_TDPY * ui(), s, theme(TH_TEXT_DIM), T_CAPTION, W_BOLD)
    return 0
}
fn set_thead(x, y, w) {
    fill_rgb(x, y + set_thh() - SET_R2 * ui(), w, SET_R2 * ui(), theme(TH_LIT))
    return y + set_thh()
}
fn set_trow(x, y, w) {
    fill_rgb(x, y + set_tdh() - 1, w, 1, theme(TH_CUT))
    return y + set_tdh()
}
fn set_tdy(y) { return y + SET_TDPY * ui() }
fn set_td(x, y, s, col) { text_aa(x + SET_TDPX * ui(), set_tdy(y), s, col)  return 0 }
fn set_tdl(x, y, s, col) { label(x + SET_TDPX * ui(), set_tdy(y), s, col, T_CAPTION, W_BOLD)  return 0 }

# A KEY/VALUE LINE. LABEL on the left in a fixed 132dp column, DATA mono right
# aligned, a 1dp groove under. The fixed key column is what lets a run of them
# be read as a list rather than as sentences.
fn set_kv(x, y, w, k) {
    label(x, y + 1 * ui(), k, theme(TH_TEXT_DIM), T_CAPTION, W_BOLD)
    fill_rgb(x, y + set_kvh() - 1, w, 1, theme(TH_CUT))
    return y + set_kvh()
}
fn set_kvvx(x) { return x + SET_KVKW * ui() }

# ---- the segmented tab bar ---------------------------------------------------
# THE SELECTED TAB IS THE KNOCKOUT. Not a second idea and not an accent: the
# same value flip the focused window header uses, on one segment. A reader who
# has learned it on a window reads it here for free - and when the FOCUS tab's
# toggle switches the knockout off, THIS BAR FALLS BACK TOO, which is the most
# direct demonstration of the control there is.
fn set_tabname(i) {
    if i == SET_LADDER   { return "LADDER" }
    if i == SET_FOCUS    { return "FOCUS" }
    if i == SET_BOUNDARY { return "BOUNDARY" }
    return "PRESS"
}
# ---- A SEGMENTED CONTROL, FOR ANY LIST ---------------------------------------
#
# set_press_ctl's own comment said it: "`raster clock` and `per window timing`
# are segmented controls this pane has no widget for". Add the LADDER tab's
# 'surface ladder' and that was THREE of the authority's twelve controls with
# no drawable form.
#
# The drawing code existed and was hardwired. set_segbar looped SET_TABS,
# called set_tabname(i) and compared against the global set_tab, so the only
# thing it could ever draw was the tab strip - a widget that is a widget for
# exactly one caller is a layout, not a widget.
#
# There are no arrays or string lists in this kernel subset, so a list is a
# KIND plus a name function, which is the idiom the rest of this file uses for
# the same reason. Kind 0 is the tab strip and its behaviour is unchanged: the
# old names below are wrappers on it, so nothing that drew a tab strip had to
# move.
SEG_TABS   = 0                     # the Settings tab strip
SEG_LADDER = 1                     # LADDER: surface ladder - proto:2036
SEG_US     = 2                     # PRESS:  per window timing - proto:2188

# THE LADDER SEGMENT SELECTS SOMETHING THIS MACHINE DOES NOT HAVE, and says so
# rather than pretending. design.h:54-59 puts a second light/raking ladder
# deliberately out of scope, and the only raking values in the tree are four
# REFERENCE constants. So the control is drawn, it is live, and picking the
# second rung reports that the rung is not built - which is the same answer the
# Renderer's wireframe toggle gives, for the same reason.
set_ladder = 0                     # 0 presswork, 1 raking
# PER WINDOW TIMING HAS TWO REAL READINGS AND AN OFF. usOf at proto:1606-1610
# switches between `w.us + ' us'` and `(w.px / 1000) + ' kpx'`; the System
# Monitor's window table already draws both columns, and this is what chooses
# between them.
set_us = 0                         # 0 measured, 1 repaint, 2 off

fn seg_n(k) {
    if k == SEG_TABS { return SET_TABS }
    if k == SEG_LADDER { return 2 }
    return 3
}
fn seg_name(k, i) {
    if k == SEG_TABS { return set_tabname(i) }
    if k == SEG_LADDER {
        if i == 0 { return "presswork" }
        return "raking"
    }
    if i == 0 { return "measured" }
    if i == 1 { return "repaint" }
    return "off"
}
fn seg_sel(k) {
    if k == SEG_TABS { return set_tab }
    if k == SEG_LADDER { return set_ladder }
    return set_us
}

fn set_tabw(i) { return seg_w(SEG_TABS, i) }
fn seg_w(k, i) { return label_w(seg_name(k, i), T_CAPTION, W_BOLD) + 2 * SET_SEGPX * ui() }
fn seg_x(k, x, i) {
    settx_x = x + 1
    settx_j = 0
    while settx_j < i {
        settx_x = settx_x + seg_w(k, settx_j) + 1
        settx_j = settx_j + 1
    }
    return settx_x
}
fn set_tabx(x, i) { return seg_x(SEG_TABS, x, i) }
fn seg_barw(k) {
    setsw_w = 2
    setsw_i = 0
    while setsw_i < seg_n(k) {
        setsw_w = setsw_w + seg_w(k, setsw_i) + 1
        setsw_i = setsw_i + 1
    }
    return setsw_w - 1
}
fn set_segw() { return seg_barw(SEG_TABS) }
fn set_segh() { return SET_SEGH * ui() }
fn seg_draw(k, x, y) {
    # the 1px ZD_CUT ring and the separators between segments are ONE fill with
    # the segments punched out of it. A border drawn as four fills per segment
    # would double every internal rule and land 2px where the recipe says 1.
    fill_rgb(x, y, seg_barw(k), set_segh(), theme(TH_CUT))
    setsg_i = 0
    while setsg_i < seg_n(k) {
        setsg_x = seg_x(k, x, setsg_i)
        setsg_w = seg_w(k, setsg_i)
        setsg_bg = theme(TH_PANEL_HI)
        setsg_ink = theme(TH_TEXT_DIM)
        if setsg_i == seg_sel(k) {
            setsg_bg = theme(TH_KNOCK)
            setsg_ink = theme(TH_KNOCK_INK)
        }
        fill_rgb(setsg_x, y + 1, setsg_w, set_segh() - 2, setsg_bg)
        label(setsg_x + SET_SEGPX * ui(), y + (set_segh() - label_h(T_CAPTION)) / 2, seg_name(k, setsg_i), setsg_ink, T_CAPTION, W_BOLD)
        setsg_i = setsg_i + 1
    }
    return 0
}
fn set_segbar(x, y) { return seg_draw(SEG_TABS, x, y) }

# ONE ROW: a label on the left and the control right-flushed, the same shape
# set_tog_row draws. The authority's `seg()` is a labelled row exactly like its
# `tog()`, so the two read as one family rather than two.
fn set_seg_row(x, y, w, n, k, nm, note) {
    ssr_y = set_rowN_y(y, n)
    if set_vis(ssr_y, set_rowh()) == 0 { return 0 }
    label(x, ssr_y + (set_rowh() - label_h(T_BODY)) / 2, nm, theme(TH_TEXT), T_BODY, W_REG)
    ssr_bx = x + w - seg_barw(k)
    seg_draw(k, ssr_bx, ssr_y + (set_rowh() - set_segh()) / 2)
    ssr_nx = ssr_bx - ui_tw(note, PW_SM, PW_MONO) - SET_GAP * ui()
    text_aa(ssr_nx, ssr_y + (set_rowh() - cell_h()) / 2, note, theme(TH_TEXT_DIM))
    return 0
}
# ...and its hit test, from the same two functions.
fn set_seg_row_at(x, y, w, n, k, ex, ey) {
    ssa_y = set_rowN_y(y, n)
    return seg_at(k, x + w - seg_barw(k), ssa_y + (set_rowh() - set_segh()) / 2, ex, ey)
}
# Which segment a pointer landed on, from the same two functions that drew it.
# -1 for a miss, and a miss is not "the nearest one" - a settings pane that
# switches tabs when you click beside the bar is a settings pane you cannot
# scroll without changing what you are reading.
fn seg_at(k, x, y, ex, ey) {
    if ey < y { return 0 - 1 }
    if ey >= y + set_segh() { return 0 - 1 }
    setta_i = 0
    while setta_i < seg_n(k) {
        if ex >= seg_x(k, x, setta_i) {
            if ex < seg_x(k, x, setta_i) + seg_w(k, setta_i) { return setta_i }
        }
        setta_i = setta_i + 1
    }
    return 0 - 1
}
fn set_tab_at(x, y, ex, ey) { return seg_at(SEG_TABS, x, y, ex, ey) }

# WHAT PICKING A SEGMENT DOES. Every arm either changes something a reader can
# see or says why it cannot - a segmented control whose second rung is silent
# is the dead-control fault with three states instead of two.
fn seg_pick(k, i) {
    if k == SEG_LADDER {
        if i == 1 {
            # design.h:54-59 puts a second light/raking ladder deliberately out
            # of scope, and the only raking values in this tree are four
            # REFERENCE constants - not six switchable surface rungs. Saying so
            # is the whole of what this rung can honestly do.
            note_say2("there is no raking ladder to switch to", "design.h states the second ladder is out of scope - the four raking figures here are reference constants, not rungs", 1400)
            return 1
        }
        set_ladder = 0
        return 1
    }
    if k == SEG_US {
        set_us = i
        if i == 0 { note_say2("per window timing: measured", "the monitor's window table prints wm_appus - microseconds this window spent drawing", 900) }
        if i == 1 { note_say2("per window timing: repaint", "the same table prints kilopixels - the client area it repaints", 900) }
        if i == 2 { note_say2("per window timing: off", "the column is not drawn", 900) }
        return 1
    }
    return 0
}

# ---- the toggle --------------------------------------------------------------
# .sw2: 34 x 17 with a 13 square knob. OFF is a ZD_WELL trough with a ZD_CUT
# ring and the knob in ZD_TEXT_INERT - the structure-only rung, which is legal
# here precisely because a knob is a FILL and never a glyph. ON is solid
# ZD_KNOCK, ring included, with the knob reversed out in ZD_KNOCK_INK. So the
# control that switches the knockout off is itself drawn with the knockout, and
# switching it off changes the control you just pressed.
fn set_togw() { return SET_SWW * ui() }
fn set_togh() { return SET_SWH * ui() }
fn set_toggle(x, y, on) {
    settg_k = SET_KNOB * ui()
    if on == 1 {
        fill_rgb(x, y, set_togw(), set_togh(), theme(TH_KNOCK))
        fill_rgb(x + set_togw() - settg_k - 1, y + 1, settg_k, settg_k, theme(TH_KNOCK_INK))
    } else {
        fill_rgb(x, y, set_togw(), set_togh(), theme(TH_CUT))
        fill_rgb(x + 1, y + 1, set_togw() - 2, set_togh() - 2, theme(TH_SURF_WELL))
        fill_rgb(x + 1, y + 1, settg_k, settg_k, theme(TH_SURF_7))
    }
    return 0
}
# The whole ROW is the hit target, not the 34px switch. A 17px tall control is
# a 17px tall control at ui 1 and the pointer is not that accurate; the
# prototype makes the row the target for the same reason.
fn set_hit_row(x, y, w, ex, ey) {
    if ex < x { return 0 }
    if ex >= x + w { return 0 }
    if ey < y { return 0 }
    if ey >= y + set_rowh() { return 0 }
    return 1
}

# THE SLIDER'S TARGET IS ITS TRACK, NOT ITS WHOLE ROW.
#
# The focus-bar row was hit-tested with set_hit_row, whose x test is the full
# body width, and the result fed straight into set_slider_v - which CLAMPS an
# out-of-range x to the nearest end. So clicking the words "focus bar", in the
# label column, silently set the bar to its minimum; clicking anywhere in the
# empty space right of the track set it to its maximum. A label is not a
# control, and a clamp is not a hit test.
fn set_hit_trk(x, y, w, ex, ey) {
    if ex < set_trk_x(x) { return 0 }
    if ex >= set_trk_x(x) + set_trk_w(x, w) { return 0 }
    if ey < y { return 0 }
    if ey >= y + set_rowh() { return 0 }
    return 1
}

# ---- the slider --------------------------------------------------------------
# .mtrack with the settings pane's own 11px height override. THE FILL IS STEEL
# AND THAT IS A RULE, NOT A CHOICE: ZD_STEEL is the machine's own reading and
# appears inside an instrument and nowhere else, while ZD_VERM is an ink laid
# on a surface for the one thing to act on. A vermilion track fill would be the
# overprint doing an instrument's job, which is exactly the discipline the
# PRESS tab warns turns this direction into a generic two-accent dark UI.
fn set_trkh() { return SET_TRKH * ui() }
fn set_slider(x, y, w, v, lo, hi) {
    fill_rgb(x, y, w, set_trkh(), theme(TH_CUT))
    fill_rgb(x + 1, y + 1, w - 2, set_trkh() - 2, theme(TH_SURF_WELL))
    setsl_f = 0
    if hi > lo { setsl_f = (v - lo) * (w - 2) / (hi - lo) }
    if setsl_f > w - 2 { setsl_f = w - 2 }
    if setsl_f > 0 { fill_rgb(x + 1, y + 1, setsl_f, set_trkh() - 2, theme(TH_STEEL)) }
    return 0
}
# The value a click at ex asks for. Rounded to the nearest step rather than
# truncated: with six steps across the track, truncation makes the top value
# reachable only on the single rightmost pixel column.
fn set_slider_v(x, w, lo, hi, ex) {
    if w <= 1 { return lo }
    setsv_n = hi - lo
    setsv_v = lo + idiv((ex - x) * setsv_n * 2 + w, 2 * w)
    if setsv_v < lo { setsv_v = lo }
    if setsv_v > hi { setsv_v = hi }
    return setsv_v
}

# ---- the scroll viewport ------------------------------------------------------
# The pane is taller than any window it fits in - the FOCUS tab alone runs to
# about 1,100 px at ui 1 - so the body scrolls. wm.c already scissors the client
# rect ("an app physically cannot draw over its own title bar no matter what it
# does"), so a straddling row is clipped for free and this only has to decide
# what NOT to bother drawing. set_c0/set_c1 are that window in absolute pixels.
set_c0 = 0
set_c1 = 0
fn set_vis(y, h) {
    if y + h <= set_c0 { return 0 }
    if y >= set_c1 { return 0 }
    return 1
}
fn set_cx(x, w, pc) { return x + idiv(w * pc, 100) }

# ---- live figures, every one of them recomputed -------------------------------
# theme(TH_*) is the LOADED value, not design.h's - which is exactly the point,
# because the FOCUS tab's toggle changes four of them while you watch and every
# figure below has to follow. ui_ratio() returns WCAG contrast x10^4.
fn set_r_knock()   { return ui_ratio(theme(TH_KNOCK), theme(TH_PANEL)) }
fn set_r_verm()    { return ui_ratio(theme(TH_ACCENT), theme(TH_PANEL)) }
fn set_r_koedge()  { return ui_ratio(theme(TH_KO_EDGE), theme(TH_KNOCK)) }
fn set_r_lit()     { return ui_ratio(theme(TH_LIT), theme(TH_PANEL)) }
fn set_r_cut()     { return ui_ratio(theme(TH_CUT), theme(TH_PANEL)) }
# The two ceilings: how much room a surface has below it and above it. They are
# what decides which side an edge goes on, and they are properties of the
# GROUND alone - the loudest darker term against a surface is its ratio to pure
# black, the loudest lighter term is its ratio to pure white.
fn set_dn(c) { return ui_ceil_dn(c) }
fn set_up(c) { return ui_ceil_up(c) }

# THE COMPARISON LADDER, computed rather than quoted. design.h's ZD_REF_* block
# reached by index so no colour literal appears in this file. These three
# reproduce the prototype's own figures exactly - 1.9931, 5.9822 and 11.9231 -
# and design.h's header states the third at line 128, so a disagreement here is
# a real signal rather than a rounding argument.
fn set_ref_lit_ground() { return ui_ratio(ui_ref(SET_REF_LIT_RAKING), ui_ref(SET_REF_BASE_RAKING)) }
fn set_ref_lit_ko()     { return ui_ratio(ui_ref(SET_REF_LIT_RAKING), ui_ref(SET_REF_KNOCK_PLATE)) }
fn set_ref_ko_plate()   { return ui_ratio(ui_ref(SET_REF_KNOCK_PLATE), ui_ref(SET_REF_BASE_RAKING)) }

# THE SKEW - the widening's central claim in one number. The edge run has to
# compute the SAME ratio against the knockout as against the ground, or the
# light inverts its loudness when the header inverts.
#
# EVERYTHING THIS PANE PRINTS IS x10^4 AND THERE IS NO SECOND FIXED POINT.
# These two are percentages rather than ratios, and the first version of them
# returned x10^2 "because two decimals is all a percentage needs" - which meant
# the print helper, which rescales FROM q4, divided them by a hundred again and
# drew "0.00 %" where 0.25 % belongs. A plausible-looking zero, in the one
# figure the whole widening argument rests on. One fixed point, everywhere,
# and the helpers do the rescaling: a percentage is x10^4 like everything else.
fn set_skew_q4() {
    setsk_a = set_r_lit()
    setsk_b = set_r_koedge()
    if setsk_a <= 0 { return 0 }
    # absolute, because with the knockout switched OFF the foot rule is the
    # groove and the difference runs the other way - a negative here would go
    # through set_dec and come out as a digit salad.
    if setsk_b < setsk_a { setsk_b = setsk_a + (setsk_a - setsk_b) }
    return idiv((setsk_b - setsk_a) * 1000000, setsk_a)
}
# ...and the reference skew's multiplier: how many times louder the same token
# reads on PLATE's header than on graphite's ground. 3.00x, opposite sign.
fn set_ref_x_q4() { return idiv(set_ref_lit_ko() * 10000, set_ref_lit_ground()) }

# ---- the 600 x 420 dp reference plate ----------------------------------------
# THE PIXEL COUNTS ARE DERIVED, NOT QUOTED, and that is the difference between
# a table and a caption. 16,800 is the plate's width times ZD_TITLE_H - the
# header band, whether it carries the knockout or the wash, because the two
# cover THE IDENTICAL AREA and that is the comparison's whole premise. 1,176 is
# the focus bar's width in dp times the plate below the header, so it moves the
# instant the slider moves. Only the raking design's 1,019 is quoted: its focus
# signal is not a rectangle this ladder knows the shape of.
fn set_plate_w()  { return ui_refn(SET_RN_PLATE_W) }
fn set_plate_h()  { return ui_refn(SET_RN_PLATE_H) }
fn set_plate_th() { return ui_refn(SET_RN_TITLE_H) }
fn set_plate_a()  { return set_plate_w() * set_plate_h() }
fn set_px_hdr()   { return set_plate_w() * set_plate_th() }
fn set_px_bar()   { return ui_fbar_dp() * (set_plate_h() - set_plate_th()) }
fn set_px_tot()   { return set_px_hdr() + set_px_bar() }
# percent of plate, x10^4 so it goes through the same print helper as a ratio.
fn set_pct_q4(v) { return idiv(v * 1000000, set_plate_a()) }

# ---- FOCUS: the two controls -------------------------------------------------
# Their geometry is a function because app_event calls the same functions to
# decide what was clicked. The alternative - re-deriving the row's y in the
# event handler - is the exact shape of bug uikit.c documents: the two copies
# agree until one of them is edited.
fn set_row1_y(y) { return y }
fn set_row2_y(y) { return y + set_rowh() }
# The Nth control row. FOCUS has two and PRESS now has four; one function so a
# fifth cannot be drawn at one pitch and hit-tested at another - which is the
# fault the Files list had in three places.
fn set_rowN_y(y, n) { return y + n * set_rowh() }

# One toggle row: switch, label, and the prototype's own note right-flushed.
fn set_tog_row(x, y, w, n, on, nm, note) {
    stg_y = set_rowN_y(y, n)
    if set_vis(stg_y, set_rowh()) == 0 { return 0 }
    set_toggle(x, stg_y + (set_rowh() - set_togh()) / 2, on)
    label(x + set_togw() + SET_GAP * ui(), stg_y + (set_rowh() - label_h(T_BODY)) / 2, nm, theme(TH_TEXT), T_BODY, W_REG)
    text_aa(x + w - ui_tw(note, PW_SM, PW_MONO), stg_y + (set_rowh() - cell_h()) / 2, note, theme(TH_TEXT_DIM))
    return 0
}

# THE SAME ROW WITH THE MODULE'S DIMENSIONS READ INSTEAD OF SPELLED.
#
# The grid row's note was the string "12 x 8, ruled onto the field", and the
# prototype composes it from live state - `tog('desk module grid', 'grid',
# S.cols + ' x ' + S.rows)`. GRID_COLS and GRID_ROWS are named constants in this
# file, are what draw_grid actually loops over, and are already DRAWN AS DIGITS
# by two other surfaces here: the wallpaper legend and the printer's slug. So
# the module's size appeared three times as a reading and once as prose, and the
# prose is the copy that would go stale.
#
# zl has no string values, so the note cannot be assembled - it is drawn in
# pieces, right-flushed off a measured total, the way the legend does it.
fn set_tog_row_grid(x, y, w, n, on, nm) {
    stgg_y = set_rowN_y(y, n)
    if set_vis(stgg_y, set_rowh()) == 0 { return 0 }
    set_toggle(x, stgg_y + (set_rowh() - set_togh()) / 2, on)
    label(x + set_togw() + SET_GAP * ui(), stgg_y + (set_rowh() - label_h(T_BODY)) / 2, nm, theme(TH_TEXT), T_BODY, W_REG)
    stgg_ty = stgg_y + (set_rowh() - cell_h()) / 2
    stgg_w = s3_numw(GRID_COLS) + ui_tw(" x ", PW_SM, PW_MONO) + s3_numw(GRID_ROWS) + ui_tw(", ruled onto the field", PW_SM, PW_MONO)
    stgg_x = x + w - stgg_w
    num_aa(stgg_x, stgg_ty, GRID_COLS, theme(TH_TEXT_DIM))
    stgg_x = stgg_x + s3_numw(GRID_COLS)
    text_aa(stgg_x, stgg_ty, " x ", theme(TH_TEXT_DIM))
    stgg_x = stgg_x + ui_tw(" x ", PW_SM, PW_MONO)
    num_aa(stgg_x, stgg_ty, GRID_ROWS, theme(TH_TEXT_DIM))
    stgg_x = stgg_x + s3_numw(GRID_ROWS)
    text_aa(stgg_x, stgg_ty, ", ruled onto the field", theme(TH_TEXT_DIM))
    return 0
}

# THE PRESS TAB'S CONTROLS, WHICH IT HAD NONE OF. The tab named six switches and
# two segmented controls and offered not one of them - the pane described a set
# of choices the machine did not have. These four are the ones whose state this
# OS can actually hold: each gates something kernel.zl was drawing
# unconditionally. Labels and notes are the prototype's, verbatim.
fn set_press_ctl(x, y, w) {
    set_tog_row_grid(x, y, w, 0, desk_grid_on, "desk module grid")
    set_tog_row(x, y, w, 1, desk_crop_on, "crop marks", "overprint job 3, vermilion, at the margins")
    set_tog_row(x, y, w, 2, desk_ruler_on, "memory map ruler", "Datum, on the foot")
    set_tog_row(x, y, w, 3, desk_slug_on, "printer's slug", "PLATE, one mono line, measured")
    # TWO MORE OF THE PROTOTYPE'S THIRTEEN, and both gate behaviour that
    # already exists rather than adding any. A switch wired to nothing is the
    # dead-control fault wearing a nicer surface, which is why these two and not
    # the other five: `raster clock` and `per window timing` are segmented
    # controls this pane has no widget for, and `surface ladder` and `ui scale`
    # would need a second ladder and a mode change respectively.
    set_tog_row(x, y, w, 4, ui_motion_on(), "motion", "RISE 90 / TRAVEL 160 / SETTLE 240, one curve")
    set_tog_row(x, y, w, 5, ui_track_on(), "label tracking", "ZD_TR_LAB 1.4 and ZD_TR_BIG 2.6")
    # `per window timing` IS ONE OF THE TWO THIS PANE HAD NO WIDGET FOR, and it
    # has one now - see the SEG_* block. It is the one of the pair whose data
    # this machine already measures: usOf at proto:1606-1610 switches between
    # `w.us + ' us'` and `(w.px / 1000) + ' kpx'`, and the System Monitor's
    # window table already draws both columns from wm_appus and wm_cw*wm_ch.
    #
    # `raster clock` is still absent and that is deliberate rather than
    # forgotten: the authority's two rungs are composite and frame, and this
    # kernel counts composites. Drawing a rung for a clock nothing counts would
    # be the dead control this whole round has been removing.
    set_seg_row(x, y, w, 6, SEG_US, "per window timing", "app us, or the client area it repaints")
    return 6 * set_rowh()
}
fn set_trk_x(x)  { return x + SET_LABW * ui() }
fn set_trk_w(x, w) { return w - SET_LABW * ui() - SET_VALW * ui() - SET_GAP * ui() }

fn set_focus_ctl(x, y, w) {
    setfc_u = ui()
    # ROW 1 - the knockout. The row is the hit target; see set_hit_row.
    setfc_y = set_row1_y(y)
    if set_vis(setfc_y, set_rowh()) == 1 {
        set_toggle(x, setfc_y + (set_rowh() - set_togh()) / 2, ui_knock_on())
        label(x + set_togw() + SET_GAP * setfc_u, setfc_y + (set_rowh() - label_h(T_BODY)) / 2, "the knockout", theme(TH_TEXT), T_BODY, W_REG)
        # the caption is the prototype's, verbatim, and it is a STATEMENT OF
        # WHAT THE CONTROL DOES rather than a description of the setting.
        text_aa(x + w - 46 * cell_w(), setfc_y + (set_rowh() - cell_h()) / 2, "off falls back to graphite's wash in the same band", theme(TH_TEXT_DIM))
    }
    # ROW 2 - the focus bar, 1..6 dp. UI_FBAR_MIN/MAX in ui.h are the clamp and
    # these are the same two numbers; ui_fbar() returns the value it SETTLED
    # on, so the thumb can never be drawn past the end of its own track.
    setfc_y = set_row2_y(y)
    if set_vis(setfc_y, set_rowh()) == 1 {
        label(x, setfc_y + (set_rowh() - label_h(T_BODY)) / 2, "focus bar", theme(TH_TEXT), T_BODY, W_REG)
        set_slider(set_trk_x(x), setfc_y + (set_rowh() - set_trkh()) / 2, set_trk_w(x, w), ui_fbar_dp(), 1, 6)
        num_aa(x + w - 3 * cell_w() - s3_numw(ui_fbar_dp()), setfc_y + (set_rowh() - cell_h()) / 2, ui_fbar_dp(), theme(TH_TEXT_HI))
        text_aa(x + w - 3 * cell_w(), setfc_y + (set_rowh() - cell_h()) / 2, " dp", theme(TH_TEXT_HI))
    }
    return y + 2 * set_rowh()
}

# ---- mono prose inside a well -------------------------------------------------
# A prose line is placed BY COLUMN, not by measuring the text that precedes it.
# text_aa is fixed advance (fb.c: cell_w for every glyph), so a column is an
# exact multiple of cell_w() and a figure spliced into a sentence lands where
# the layout says rather than where the previous word happened to end. The
# columns below were counted by a generator, not by eye - a miscount here is a
# number drawn on top of a word, which reads as a rendering fault.
#
# THE FIGURE IS RIGHT ALIGNED INTO ITS FIELD. Not because it is prettier: a
# left-aligned figure whose integer part gains a digit pushes the rest of the
# sentence sideways, and these figures CHANGE - the knockout toggle moves four
# of them. Right aligned into a fixed field, the sentence around them cannot
# move no matter what the tokens do.
fn set_wc(x, c) { return x + SET_WELLPX * ui() + c * cell_w() }
fn set_wlc(x, y, n, c, s) { text_aa(set_wc(x, c), set_wly(y, n), s, theme(TH_TEXT_2))  return 0 }
# A COUNT rather than a figure. set_wnum_r rescales its argument from x10^4,
# which is right for every ratio and percentage in this pane and wrong for a
# pixel count - 17,976 through that path comes out "2.". Separate function, so
# the two cannot be confused at a call site.
fn set_wthou_r(x, y, n, endc, v) {
    set_thou_r(set_wc(x, endc), set_wly(y, n), v, theme(TH_TEXT_HI))
    return 0
}
fn set_wnum_r(x, y, n, endc, v4, dec) {
    setwr_v = set_q(v4, dec)
    set_dec(set_wc(x, endc) - set_decw(setwr_v, dec), set_wly(y, n), setwr_v, dec, theme(TH_TEXT_HI))
    return 0
}

# ---- a contrast with a trailing word -----------------------------------------
# "6.48:1 max" and "1.400:1 wash", right aligned as one run. The suffix is
# measured in CHARACTER CELLS by the caller rather than by a strlen this
# language does not have; the count is beside the literal at every call site.
fn set_rat_sfx_r(xr, y, v4, dec, ncs, s, col) {
    text_aa(xr - ncs * cell_w(), y, s, col)
    set_rat_r(xr - ncs * cell_w(), y, v4, dec, col)
    return 0
}

# ==============================================================================
# FOCUS - the knockout, and everything it had to be true for.
# ==============================================================================
fn set_focus_body(x, y, w) {
    setfb_x = x
    setfb_y = y
    setfb_w = w
    setfb_u = ui()

    # --- the two controls -----------------------------------------------------
    setfb_y = set_focus_ctl(setfb_x, setfb_y, setfb_w)
    setfb_y = set_rule2(setfb_x, setfb_y + SET_STACK * setfb_u, setfb_w) + SET_STACK * setfb_u

    # --- the argument ---------------------------------------------------------
    setfb_y = set_head(setfb_x, setfb_y, "THE KNOCKOUT, AND THE SIGN INVERSION IT USED TO CAUSE")
    if set_vis(setfb_y, set_wellh(23)) == 1 {
        set_well(setfb_x, setfb_y, setfb_w, 23)
        set_wlc(setfb_x, setfb_y, 0, 0, "deciding.md C2 says a knockout on graphite's ladder breaks two")
        set_wlc(setfb_x, setfb_y, 1, 0, "measurable things. both are checked here against LIVE tokens.")
        set_wlc(setfb_x, setfb_y, 3, 0, "1  THE LIGHT INVERTS SIGN. ZD_LIT is the struck top edge - the")
        set_wlc(setfb_x, setfb_y, 4, 0, "   light itself. on graphite's ground it computes ")
        set_wnum_r(setfb_x, setfb_y, 4, 56, set_ref_lit_ground(), 4)
        set_wlc(setfb_x, setfb_y, 4, 56, ":1 as a")
        set_wlc(setfb_x, setfb_y, 5, 0, "   LIGHTER term. on PLATE's knockout it computes ")
        set_wnum_r(setfb_x, setfb_y, 5, 55, set_ref_lit_ko(), 4)
        set_wlc(setfb_x, setfb_y, 5, 55, ":1")
        set_wlc(setfb_x, setfb_y, 6, 0, "   as a DARKER one. same token, ")
        set_wnum_r(setfb_x, setfb_y, 6, 36, set_ref_x_q4(), 2)
        set_wlc(setfb_x, setfb_y, 6, 36, "x the loudness, opposite")
        set_wlc(setfb_x, setfb_y, 7, 0, "   sign: the recipe says raised and the pixels say cut.")
        set_wlc(setfb_x, setfb_y, 9, 0, "2  SUB THRESHOLD STEPS STOP BEING READ next to a full inversion.")
        set_wlc(setfb_x, setfb_y, 11, 0, "PRESSWORK FIXES 1 BY ARITHMETIC RATHER THAN BY RULE. pick ZD_KNOCK")
        set_wlc(setfb_x, setfb_y, 12, 0, "so that the edge run computes the SAME ratio against the knockout")
        set_wlc(setfb_x, setfb_y, 13, 0, "as against the ground, and there is nothing left to remap:")
        set_wlc(setfb_x, setfb_y, 15, 0, "     ZD_LIT      on ZD_BASE     ")
        set_wnum_r(setfb_x, setfb_y, 15, 38, set_r_lit(), 4)
        set_wlc(setfb_x, setfb_y, 15, 38, ":1   lighter term, top edge")
        set_wlc(setfb_x, setfb_y, 16, 0, "     ZD_KO_EDGE  on ZD_KNOCK    ")
        set_wnum_r(setfb_x, setfb_y, 16, 38, set_r_koedge(), 4)
        set_wlc(setfb_x, setfb_y, 16, 38, ":1   darker  term, foot edge")
        set_wlc(setfb_x, setfb_y, 17, 0, "     skew                       ")
        set_wnum_r(setfb_x, setfb_y, 17, 36, set_skew_q4(), 2)
        set_wlc(setfb_x, setfb_y, 17, 36, " %")
        # THE LAST PARAGRAPH IS STATE DEPENDENT, and it has to be: with the
        # knockout switched off the two figures above stop being a mirrored
        # pair, and a paragraph that still claimed "ONE VALUE, TWO GEOMETRIES"
        # would be the pane asserting something its own table contradicts.
        if ui_knock_on() == 1 {
            set_wlc(setfb_x, setfb_y, 19, 0, "in this ladder ZD_KO_EDGE resolves to ZD_LIT's own value. ONE")
            set_wlc(setfb_x, setfb_y, 20, 0, "VALUE, TWO GEOMETRIES, ONE LOUDNESS. the run is not remapped and")
            set_wlc(setfb_x, setfb_y, 21, 0, "the knockout carries no extra token - it moves to the side the")
            set_wlc(setfb_x, setfb_y, 22, 0, "headroom is on, which is what the raking light was always doing.")
        } else {
            set_wlc(setfb_x, setfb_y, 19, 0, "THE KNOCKOUT IS OFF. the header is an ordinary surface again, the")
            set_wlc(setfb_x, setfb_y, 20, 0, "foot rule is back to the groove, and the two figures above are no")
            set_wlc(setfb_x, setfb_y, 21, 0, "longer a mirrored pair - which is the state this pane exists to")
            set_wlc(setfb_x, setfb_y, 22, 0, "let you compare against, not a fault.")
        }
    }
    setfb_y = setfb_y + set_wellh(23) + SET_STACK * setfb_u

    # --- which side the edge goes on ------------------------------------------
    setfb_y = set_head(setfb_x, setfb_y, "WHICH SIDE THE EDGE GOES ON, DECIDED BY CEILING")
    setfb_y = set_edge_table(setfb_x, setfb_y, setfb_w)
    if set_vis(setfb_y, set_wellh(5)) == 1 {
        set_well(setfb_x, setfb_y, setfb_w, 5)
        set_wlc(setfb_x, setfb_y, 0, 0, "the alternative was a new token for the knockout's own struck run,")
        set_wlc(setfb_x, setfb_y, 1, 0, "and it is arithmetically capped: pure white on the knockout reaches")
        set_wlc(setfb_x, setfb_y, 2, 0, "only ")
        set_wnum_r(setfb_x, setfb_y, 2, 10, set_up(theme(TH_KNOCK)), 3)
        set_wlc(setfb_x, setfb_y, 2, 10, ":1, against ")
        set_wnum_r(setfb_x, setfb_y, 2, 27, set_dn(theme(TH_KNOCK)), 3)
        set_wlc(setfb_x, setfb_y, 2, 27, ":1 available downward. so the")
        set_wlc(setfb_x, setfb_y, 3, 0, "second resolution costs a token AND lands quieter. that is why it")
        set_wlc(setfb_x, setfb_y, 4, 0, "lost.")
    }
    setfb_y = setfb_y + set_wellh(5) + SET_STACK * setfb_u

    # --- the arithmetic on a 600 x 420 dp plate -------------------------------
    setfb_y = set_head(setfb_x, setfb_y, "MEASURED, ON A 600 X 420 DP PLATE")
    setfb_y = set_measured_table(setfb_x, setfb_y, setfb_w)
    if set_vis(setfb_y, set_wellh(11)) == 1 {
        set_well(setfb_x, setfb_y, setfb_w, 11)
        set_wlc(setfb_x, setfb_y, 0, 0, "THE AREA DID NOT CHANGE. graphite's bezel plus wash covered")
        set_wthou_r(setfb_x, setfb_y, 1, 6, ui_refn(SET_RN_GRAPHITE_PX))
        set_wlc(setfb_x, setfb_y, 1, 6, " px of this plate and this ladder's header covers the")
        set_wlc(setfb_x, setfb_y, 2, 0, "same band. WHAT MOVED IS THE RATIO INSIDE IT: graphite's own wash")
        set_wlc(setfb_x, setfb_y, 3, 0, "was ")
        set_wnum_r(setfb_x, setfb_y, 3, 10, ui_refn(SET_RN_WASH_Q4), 4)
        set_wlc(setfb_x, setfb_y, 3, 10, ":1, this header is ")
        set_wnum_r(setfb_x, setfb_y, 3, 35, set_r_knock(), 4)
        set_wlc(setfb_x, setfb_y, 3, 35, ":1.")
        set_wlc(setfb_x, setfb_y, 5, 0, "ON A PLATE is not a hedge, it is the boundary of the claim. the")
        set_wlc(setfb_x, setfb_y, 6, 0, "two instrument bands sit outside the plate ladder on purpose:")
        set_wlc(setfb_x, setfb_y, 7, 0, "ZD_STEEL on the strip's ZD_CUT ground computes ")
        set_wnum_r(setfb_x, setfb_y, 7, 51, ui_ratio(theme(TH_STEEL), theme(TH_CUT)), 2)
        set_wlc(setfb_x, setfb_y, 7, 51, ":1, louder")
        set_wlc(setfb_x, setfb_y, 8, 0, "than the knockout, because a plotted measurement has to read as")
        set_wlc(setfb_x, setfb_y, 9, 0, "data and not as furniture. that is the one place Datum's two")
        set_wlc(setfb_x, setfb_y, 10, 0, "material law is taken.")
    }
    setfb_y = setfb_y + set_wellh(11) + SET_STACK * setfb_u

    # --- the five readings ----------------------------------------------------
    return set_focus_kv(setfb_x, setfb_y, setfb_w)
}

# ---- FOCUS table 1: which side the edge goes on -------------------------------
# THREE SURFACES AND THE ARITHMETIC THAT DECIDES THEIR EDGES. Not an
# illustration of a rule - the rule itself, evaluated. "the ground decides
# which direction has the headroom" is a claim about two ceilings, and the two
# ceilings are in the two middle columns; the verdict column is the comparison
# between them and nothing else. ZD_BASE and ZD_VOID have room upward, so their
# edges are the struck run on the TOP; ZD_KNOCK has room downward, so the
# focused header's edge is a groove on its FOOT. Same lamp, other side, and the
# table is what makes that a measurement instead of a preference.
#
# Column widths 24 / 22 / 22 / 32 percent. The verdict column is the widest
# because "DOWN, bottom + right" is the longest cell in the table and a mono
# column that ellipsises its own verdict is a column carrying no verdict.
fn set_edge_row(x, y, w, nm, c) {
    setet_dn = set_dn(c)
    setet_up = set_up(c)
    set_td(x, y, nm, theme(TH_TEXT_2))
    set_rat_r(set_cx(x, w, 46) - SET_TDPX * ui(), set_tdy(y), setet_dn, 3, theme(TH_TEXT_2))
    set_rat_r(set_cx(x, w, 68) - SET_TDPX * ui(), set_tdy(y), setet_up, 3, theme(TH_TEXT_2))
    if setet_dn > setet_up {
        set_td(set_cx(x, w, 68), y, "DOWN, bottom + right", theme(TH_TEXT_HI))
    } else {
        set_td(set_cx(x, w, 68), y, "UP, top and left", theme(TH_TEXT_HI))
    }
    return set_trow(x, y, w)
}
fn set_edge_table(x, y, w) {
    setea_y = y
    if set_vis(setea_y, set_thh()) == 1 {
        set_th(x, setea_y, "SURFACE")
        set_th_r(set_cx(x, w, 46), setea_y, "ROOM DOWNWARD")
        set_th_r(set_cx(x, w, 68), setea_y, "ROOM UPWARD")
        set_th(set_cx(x, w, 68), setea_y, "EDGE GOES")
    }
    setea_y = set_thead(x, setea_y, w)
    if set_vis(setea_y, set_tdh()) == 1 { set_edge_row(x, setea_y, w, "ZD_BASE", theme(TH_PANEL)) }
    setea_y = setea_y + set_tdh()
    if set_vis(setea_y, set_tdh()) == 1 { set_edge_row(x, setea_y, w, "ZD_VOID", theme(TH_BG)) }
    setea_y = setea_y + set_tdh()
    if set_vis(setea_y, set_tdh()) == 1 { set_edge_row(x, setea_y, w, "ZD_KNOCK", theme(TH_KNOCK)) }
    setea_y = setea_y + set_tdh()
    return setea_y + SET_STACK * ui()
}

# ---- FOCUS table 2: measured, on a 600 x 420 dp plate -------------------------
# THE TOP THREE ROWS ARE THIS SYSTEM'S AND ARE COMPUTED. The bottom three are
# the parent designs' and are QUOTED - they are drawn in TH_TEXT_DIM, which is
# the ink this pane reserves for a figure it did not derive, and the last of
# them in TH_WARN because 11.92:1 is the failure the widening exists to avoid
# rather than a neutral comparison.
#
# Every pixel count in the live rows comes out of geometry: the header band is
# the plate's width times ZD_TITLE_H, the focus bar is its width in dp times
# the plate below the header. Move the slider and the second and third rows
# change on the next repaint, which is the point of putting a slider on a table.
fn set_meas_row(x, y, w, px, ratq4, dec, ncs, sfx, ink, dim) {
    set_thou_r(set_cx(x, w, 60) - SET_TDPX * ui(), set_tdy(y), px, dim)
    set_pct_r(set_cx(x, w, 76) - SET_TDPX * ui(), set_tdy(y), set_pct_q4(px), 3, dim)
    set_rat_sfx_r(x + w - SET_TDPX * ui(), set_tdy(y), ratq4, dec, ncs, sfx, ink)
    return set_trow(x, y, w)
}
fn set_measured_table(x, y, w) {
    setmt_y = y
    if set_vis(setmt_y, set_thh()) == 1 {
        set_th(x, setmt_y, "COMPONENT")
        set_th_r(set_cx(x, w, 60), setmt_y, "PIXELS")
        set_th_r(set_cx(x, w, 76), setmt_y, "OF PLATE")
        set_th_r(x + w, setmt_y, "CONTRAST")
    }
    setmt_y = set_thead(x, setmt_y, w)

    # 1 - the header band. THE SAME PIXELS EITHER WAY, which is the whole
    # comparison: with the knockout on it is a solid light plate at 6.4796:1,
    # with it off it is graphite's wash in the same band at 1.3681:1, and not
    # one pixel of area moves between the two states.
    if set_vis(setmt_y, set_tdh()) == 1 {
        if ui_knock_on() == 1 {
            set_td(x, setmt_y, "header knockout", theme(TH_TEXT_2))
        } else {
            set_td(x, setmt_y, "header wash, this ladder", theme(TH_TEXT_2))
        }
        set_meas_row(x, setmt_y, w, set_px_hdr(), set_r_knock(), 4, 0, "", theme(TH_TEXT_2), theme(TH_TEXT_2))
    }
    setmt_y = setmt_y + set_tdh()

    # 2 - the overprint. It stops at the foot of the header and never crosses
    # it, because vermilion ON the knockout computes about 1.40:1 and would
    # disappear - the figure is in the readings at the bottom of this tab.
    if set_vis(setmt_y, set_tdh()) == 1 {
        set_td(x, setmt_y, "vermilion focus bar", theme(TH_TEXT_2))
        set_meas_row(x, setmt_y, w, set_px_bar(), set_r_verm(), 4, 0, "", theme(TH_TEXT_2), theme(TH_TEXT_2))
    }
    setmt_y = setmt_y + set_tdh()

    # 3 - the total, in emphasis ink. The one row a reader is meant to carry
    # away, so it is the only row on the plate at TH_TEXT_HI.
    if set_vis(setmt_y, set_tdh()) == 1 {
        set_tdl(x, setmt_y, "PRESSWORK, TOTAL", theme(TH_TEXT_HI))
        set_meas_row(x, setmt_y, w, set_px_tot(), set_r_knock(), 2, 4, " max", theme(TH_TEXT_HI), theme(TH_TEXT_HI))
    }
    setmt_y = setmt_y + set_tdh()

    # 4..6 - the comparison rows. Quoted, and drawn as quoted.
    if set_vis(setmt_y, set_tdh()) == 1 {
        set_td(x, setmt_y, "graphite bezel + wash, same plate", theme(TH_TEXT_DIM))
        set_meas_row(x, setmt_y, w, ui_refn(SET_RN_GRAPHITE_PX), ui_refn(SET_RN_WASH_Q4), 3, 5, " wash", theme(TH_TEXT_DIM), theme(TH_TEXT_DIM))
    }
    setmt_y = setmt_y + set_tdh()
    if set_vis(setmt_y, set_tdh()) == 1 {
        set_td(x, setmt_y, "raking, same plate", theme(TH_TEXT_DIM))
        set_meas_row(x, setmt_y, w, ui_refn(SET_RN_RAKING_PX), ui_refn(SET_RN_RAKING_Q4), 2, 4, " max", theme(TH_TEXT_DIM), theme(TH_TEXT_DIM))
    }
    setmt_y = setmt_y + set_tdh()
    if set_vis(setmt_y, set_tdh()) == 1 {
        set_td(x, setmt_y, "PLATE knockout, graphite ladder", theme(TH_TEXT_DIM))
        set_meas_row(x, setmt_y, w, set_px_hdr(), set_ref_ko_plate(), 2, 4, " max", theme(TH_WARN), theme(TH_TEXT_DIM))
    }
    setmt_y = setmt_y + set_tdh()
    return setmt_y + SET_STACK * ui()
}

# ---- FOCUS: the five readings -------------------------------------------------
# A kv line is the shape this pane uses for a figure that has no column to
# belong to. All five are computed; the two floors are WCAG's 4.50, which is a
# constant of the standard rather than of this design and is printed as text.
fn set_focus_kv(x, y, w) {
    setfk_y = y
    setfk_u = ui()
    setfk_r = x + w - SET_TDPX * setfk_u
    if set_vis(setfk_y, set_kvh()) == 1 {
        set_kv(x, setfk_y, w, "KNOCKOUT OF CEILING")
        # 46.6 % of 13.903:1 - the knockout as a fraction of everything the
        # plate has upward. The point of the figure is that it is UNDER half:
        # the widening bought headroom and the knockout deliberately does not
        # spend it all, which is what leaves room for ZD_EDGE_OVER above it.
        setfk_p = idiv(set_r_knock() * 1000, set_up(theme(TH_PANEL)))
        setfk_c = set_q(set_up(theme(TH_PANEL)), 3)
        setfk_w = set_decw(setfk_p, 1) + 6 * cell_w() + set_decw(setfk_c, 3) + 2 * cell_w()
        setfk_x = setfk_r - setfk_w
        setfk_x = set_dec(setfk_x, setfk_y + 1 * setfk_u, setfk_p, 1, theme(TH_TEXT_HI))
        text_aa(setfk_x, setfk_y + 1 * setfk_u, " % of ", theme(TH_TEXT_HI))
        setfk_x = set_dec(setfk_x + 6 * cell_w(), setfk_y + 1 * setfk_u, setfk_c, 3, theme(TH_TEXT_HI))
        text_aa(setfk_x, setfk_y + 1 * setfk_u, ":1", theme(TH_TEXT_HI))
    }
    setfk_y = setfk_y + set_kvh()
    if set_vis(setfk_y, set_kvh()) == 1 {
        set_kv(x, setfk_y, w, "TITLE ON THE KNOCKOUT")
        set_rat_sfx_r(setfk_r, setfk_y + 1 * setfk_u, ui_ratio(theme(TH_KNOCK_INK), theme(TH_KNOCK)), 2, 12, ", floor 4.50", theme(TH_TEXT_HI))
    }
    setfk_y = setfk_y + set_kvh()
    if set_vis(setfk_y, set_kvh()) == 1 {
        set_kv(x, setfk_y, w, "SUB ON THE KNOCKOUT")
        set_rat_sfx_r(setfk_r, setfk_y + 1 * setfk_u, ui_ratio(theme(TH_KNOCK_INK2), theme(TH_KNOCK)), 2, 12, ", floor 4.50", theme(TH_TEXT_HI))
    }
    setfk_y = setfk_y + set_kvh()
    if set_vis(setfk_y, set_kvh()) == 1 {
        set_kv(x, setfk_y, w, "VERMILION ON IT")
        set_rat_sfx_r(setfk_r, setfk_y + 1 * setfk_u, ui_ratio(theme(TH_ACCENT), theme(TH_KNOCK)), 2, 30, " - so the bar stops at the foot", theme(TH_TEXT_HI))
    }
    setfk_y = setfk_y + set_kvh()
    if set_vis(setfk_y, set_kvh()) == 1 {
        set_kv(x, setfk_y, w, "THE EDGE RUN, BOTH WAYS")
        # the skew, and it is the widening's central claim in one line.
        setfk_s = set_q(set_skew_q4(), 2)
        setfk_x = setfk_r - set_decw(setfk_s, 2) - 28 * cell_w()
        setfk_x = set_dec(setfk_x, setfk_y + 1 * setfk_u, setfk_s, 2, theme(TH_TEXT_HI))
        text_aa(setfk_x, setfk_y + 1 * setfk_u, " % apart, mirrored, one lamp", theme(TH_TEXT_HI))
    }
    return setfk_y + set_kvh()
}

# ==============================================================================
# LADDER - the one structural decision.
# ==============================================================================
# WHAT IS NOT HERE AND WHY. The prototype's step table carries a GRAPHITE
# column - 1.1028 / 1.0728 / 1.1257 / 1.0893 / 1.0771 - beside the presswork
# one. Those are the parent ladder's step ratios and there is no token in this
# system to compute them from; design.h quotes four of the five in its header
# and not the fifth. Rather than paste five numbers this file cannot check, the
# comparison is made the way the arithmetic already supports it: every step is
# measured against the 1.15 perceptual threshold, and the summary row states
# the smallest one, which is the number the whole widening is about. The
# omission is the honest half of "prototype parity" and it is named rather than
# quietly dropped.
fn set_hexchar(d) {
    if d < 10 { return 48 + d }
    return 55 + d                          # uppercase, as the prototype prints
}
fn set_hex6(x, y, v, col) {
    text_aa(x, y, "#", col)
    sethx_i = 5
    while sethx_i >= 0 {
        char_aa(x + (6 - sethx_i) * cell_w(), y, set_hexchar(band(shr(v, sethx_i * 4), 15)), col)
        sethx_i = sethx_i - 1
    }
    return 0
}
# One rung. The VALUE column is the loaded hex, so the two knockout rows change
# hex while you watch when the FOCUS tab's toggle is thrown - which is the most
# literal demonstration available that this table is reading the theme and not
# a copy of design.h.
fn set_rung(x, y, w, nm, c, role) {
    set_td(x, y, nm, theme(TH_TEXT_2))
    set_hex6(set_cx(x, w, 34), set_tdy(y), c, theme(TH_TEXT_HI))
    set_rat_r(set_cx(x, w, 62) - SET_TDPX * ui(), set_tdy(y), ui_ratio(c, theme(TH_PANEL)), 4, theme(TH_TEXT_2))
    set_td(set_cx(x, w, 62), y, role, theme(TH_TEXT_DIM))
    return 0
}
fn set_rung_row(x, y, w, nm, c, role) {
    if set_vis(y, set_tdh()) == 1 { set_rung(x, y, w, nm, c, role) }
    return set_trow(x, y, w)
}
# One step between adjacent rungs. THE THRESHOLD IS 1.15 and it is the whole
# verdict: below it a step is not seen as a step, which is the finding the
# widening answers.
fn set_step_row(x, y, w, nm, a, b) {
    if set_vis(y, set_tdh()) == 1 {
        setsr_v = ui_ratio(a, b)
        set_td(x, y, nm, theme(TH_TEXT_2))
        set_rat_r(set_cx(x, w, 66) - SET_TDPX * ui(), set_tdy(y), setsr_v, 4, theme(TH_TEXT_HI))
        if setsr_v >= 11500 {
            set_td(set_cx(x, w, 66), y, "above threshold", theme(TH_OK))
        } else {
            set_td(set_cx(x, w, 66), y, "sub threshold", theme(TH_WARN))
        }
    }
    return set_trow(x, y, w)
}
# WHERE THE LADDER TAB'S ONE CONTROL SITS, named once.
#
# It is inside the SCROLLING body, after the head and the nine-line well, so
# its y moves with set_scroll - and this file has found the same class of split
# four times already (Settings, the browser, the catalogue, the Files list):
# a draw that computes a position inline and a hit test that recomputes it is
# two answers to "where is this control", and the one you can see loses.
fn set_ladder_seg_y(y) { return y + set_headh() + set_wellh(9) + SET_STACK * ui() }

fn set_ladder_body(x, y, w) {
    setlb_x = x
    setlb_y = y
    setlb_w = w
    setlb_u = ui()
    setlb_y = set_head(setlb_x, setlb_y, "RESOLUTION 1 - WIDEN THE LADDER")
    if set_vis(setlb_y, set_wellh(9)) == 1 {
        setfb_x = setlb_x
        setfb_y = setlb_y
        set_well(setlb_x, setlb_y, setlb_w, 9)
        set_wlc(setfb_x, setfb_y, 0, 0, "graphite spent its entire separation budget on 1px runs and said")
        set_wlc(setfb_x, setfb_y, 1, 0, "so: four surface steps every one below perceptual threshold. that")
        set_wlc(setfb_x, setfb_y, 2, 0, "is why its focus signal was weak.")
        set_wlc(setfb_x, setfb_y, 4, 0, "THE WIDENING IS ASYMMETRIC BECAUSE THE ARITHMETIC IS. below the")
        set_wlc(setfb_x, setfb_y, 5, 0, "ground the total room to pure black is")
        set_wnum_r(setfb_x, setfb_y, 5, 45, set_dn(theme(TH_PANEL)), 4)
        set_wlc(setfb_x, setfb_y, 5, 45, ":1 and three rungs")
        set_wlc(setfb_x, setfb_y, 6, 0, "must share it. above it the room is")
        set_wnum_r(setfb_x, setfb_y, 6, 43, set_up(theme(TH_PANEL)), 4)
        set_wlc(setfb_x, setfb_y, 6, 43, ":1. presswork spends")
        set_wlc(setfb_x, setfb_y, 7, 0, "downward the little that exists and takes the rest upward.")
        set_wlc(setfb_x, setfb_y, 8, 0, "ZD_BASE ITSELF IS UNTOUCHED - the ground never moved.")
    }
    setlb_y = setlb_y + set_wellh(9) + SET_STACK * setlb_u

    # THE LADDER TAB HAD NO CONTROLS AT ALL. The authority puts two here,
    # immediately after this first well: `seg('surface ladder', 'ladder',
    # ['presswork','raking'])` at proto:2036 and `slider('ui scale', 'ui', 80,
    # 140, ' %')` at :2037. set_ladder_body called set_tog_row, set_slider and
    # seg zero times.
    #
    # THE TWO ARE DIFFERENT PROBLEMS AND ARE NOT TREATED AS ONE.
    #
    # The surface ladder is a capability this machine does NOT have -
    # design.h:54-59 puts a second light/raking ladder deliberately out of
    # scope, and the only raking values in the tree are four REFERENCE
    # constants, not six switchable rungs. So the control is drawn, it is live,
    # and its second rung reports that the rung is not built. That is a
    # smaller claim than a missing control makes, because a control that is
    # absent says nothing about whether the thing exists.
    #
    # The ui-scale slider is NOT here, and the reason is arithmetic rather than
    # effort: the authority's range is 80..140 %, and every measurement in this
    # file is `N * ui()` where ui() is an INTEGER from fb.c. A percentage
    # cannot be expressed against an integer scale without moving the whole
    # layout onto the q8 value fb.c already keeps - which is a change to every
    # `* ui()` in the tree, not a control. Recorded in
    # docs/design/PRESSWORK-BACKLOG.md rather than faked with two rungs the
    # authority does not have.
    set_seg_row(setlb_x, set_ladder_seg_y(y), setlb_w, 0, SEG_LADDER, "surface ladder", "the one this system resolves")
    setlb_y = setlb_y + set_rowh() + SET_STACK * setlb_u

    setlb_y = set_head(setlb_x, setlb_y, "THE LADDER, AS RESOLVED RIGHT NOW")
    if set_vis(setlb_y, set_thh()) == 1 {
        set_th(setlb_x, setlb_y, "TOKEN")
        set_th(set_cx(setlb_x, setlb_w, 34), setlb_y, "VALUE")
        set_th_r(set_cx(setlb_x, setlb_w, 62), setlb_y, "ON BASE")
        set_th(set_cx(setlb_x, setlb_w, 62), setlb_y, "ROLE")
    }
    setlb_y = set_thead(setlb_x, setlb_y, setlb_w)
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_CUT", theme(TH_CUT), "groove, strip")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_WELL", theme(TH_SURF_WELL), "sunken")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_VOID", theme(TH_BG), "the desk")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_BASE", theme(TH_PANEL), "the plate")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_RAISE", theme(TH_PANEL_HI), "on a plate, rail")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_FLOAT", theme(TH_SURF_5), "off the plane")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_LITSOFT", theme(TH_LITSOFT), "grazed left")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_LIT", theme(TH_LIT), "struck top")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_EDGE_OVER", theme(TH_EDGE_OVER), "the occluder")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_KNOCK", theme(TH_KNOCK), "focused header")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_KO_EDGE", theme(TH_KO_EDGE), "the knockout edge")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_TEXT_0", theme(TH_TEXT_HI), "emphasis")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_TEXT_1", theme(TH_TEXT), "body")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_TEXT_2", theme(TH_TEXT_2), "secondary")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_TEXT_3", theme(TH_TEXT_DIM), "label")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_TEXT_INERT", theme(TH_SURF_7), "structure only")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_STEEL", theme(TH_STEEL), "instruments only")
    setlb_y = set_rung_row(setlb_x, setlb_y, setlb_w, "ZD_VERM", theme(TH_ACCENT), "the overprint")
    setlb_y = setlb_y + SET_STACK * setlb_u

    setlb_y = set_head(setlb_x, setlb_y, "THE STEPS, AND WHETHER THEY ARE SEEN")
    if set_vis(setlb_y, set_thh()) == 1 {
        set_th(setlb_x, setlb_y, "STEP")
        set_th_r(set_cx(setlb_x, setlb_w, 66), setlb_y, "PRESSWORK")
        set_th(set_cx(setlb_x, setlb_w, 66), setlb_y, "READ, FLOOR 1.15")
    }
    setlb_y = set_thead(setlb_x, setlb_y, setlb_w)
    setlb_y = set_step_row(setlb_x, setlb_y, setlb_w, "cut to well", theme(TH_CUT), theme(TH_SURF_WELL))
    setlb_y = set_step_row(setlb_x, setlb_y, setlb_w, "well to void", theme(TH_SURF_WELL), theme(TH_BG))
    setlb_y = set_step_row(setlb_x, setlb_y, setlb_w, "void to base, desk to plate", theme(TH_BG), theme(TH_PANEL))
    setlb_y = set_step_row(setlb_x, setlb_y, setlb_w, "base to raise", theme(TH_PANEL), theme(TH_PANEL_HI))
    setlb_y = set_step_row(setlb_x, setlb_y, setlb_w, "raise to float", theme(TH_PANEL_HI), theme(TH_SURF_5))
    if set_vis(setlb_y, set_tdh()) == 1 {
        set_tdl(setlb_x, setlb_y, "CUT TO BASE, THE WHOLE DOWNWARD BUDGET", theme(TH_TEXT_HI))
        set_rat_r(set_cx(setlb_x, setlb_w, 66) - SET_TDPX * setlb_u, set_tdy(setlb_y), set_r_cut(), 4, theme(TH_TEXT_HI))
        # ...of a hard ceiling. There is no fifth dark rung to be had later,
        # and that is a cost rather than a footnote.
        set_td(set_cx(setlb_x, setlb_w, 66), setlb_y, "of a ceiling of", theme(TH_TEXT_DIM))
        set_rat_r(setlb_x + setlb_w - SET_TDPX * setlb_u, set_tdy(setlb_y), set_dn(theme(TH_PANEL)), 4, theme(TH_TEXT_DIM))
    }
    setlb_y = set_trow(setlb_x, setlb_y, setlb_w) + SET_STACK * setlb_u

    if set_vis(setlb_y, set_kvh()) == 1 {
        set_kv(setlb_x, setlb_y, setlb_w, "INK RAMP")
        text_aa(setlb_x + setlb_w - SET_TDPX * setlb_u - 34 * cell_w(), setlb_y + setlb_u, "four rungs. the fifth no longer clears", theme(TH_TEXT_HI))
    }
    setlb_y = setlb_y + set_kvh()
    if set_vis(setlb_y, set_kvh()) == 1 {
        set_kv(setlb_x, setlb_y, setlb_w, "ACCENT SATURATION")
        text_aa(setlb_x + setlb_w - SET_TDPX * setlb_u - 34 * cell_w(), setlb_y + setlb_u, "LOCKED. two inks, and no third one", theme(TH_TEXT_HI))
    }
    return setlb_y + set_kvh()
}

# ==============================================================================
# BOUNDARY - the occluder draws the border.
# ==============================================================================
# THE 3:1 FLOOR IS THE ONLY REASON ZD_EDGE_OVER EXISTS. Under overlap the sole
# thing saying which plate is on top is the upper plate's bottom and right edge
# lying on the lower plate's body, so that edge carries information and has to
# clear an information floor. The table proves the darker direction cannot: the
# ZD_CUT column is every one of those edges measured, and every one of them
# fails. That is not a design preference, it is a ceiling.
fn set_bound_row(x, y, w, nm, ground) {
    if set_vis(y, set_tdh()) == 1 {
        setbr_c = ui_ratio(theme(TH_CUT), ground)
        setbr_e = ui_ratio(theme(TH_EDGE_OVER), ground)
        set_td(x, y, nm, theme(TH_TEXT_2))
        set_rat_r(set_cx(x, w, 44) - SET_TDPX * ui(), set_tdy(y), setbr_c, 2, theme(TH_WARN))
        set_rat_r(set_cx(x, w, 68) - SET_TDPX * ui(), set_tdy(y), setbr_e, 3, theme(TH_TEXT_HI))
        # MARGIN OVER THE 3:1 FLOOR, as a percent in the same x10^4 fixed point
        # everything else here uses. The floor is 30000 in q4, so the margin is
        # (e - 30000) / 30000 as a fraction, x10^6 to land in percent-q4:
        # (e - 30000) * 1000000 / 30000, which reduces to (e - 30000) * 100 / 3
        # and stays inside 31 bits for every value ui_ratio can return.
        #
        # THE NEGATIVE CASE IS NOT DRAWN RATHER THAN DRAWN NEGATIVE. set_dec
        # splits a value into an integer part and a zero-padded fraction, and
        # neither split is meaningful below zero - a failing margin would print
        # as a digit salad, which reads as a rendering fault instead of as the
        # failure it is. The verdict column already carries that news.
        if setbr_e >= 30000 {
            set_pct_r(set_cx(x, w, 86) - SET_TDPX * ui(), set_tdy(y), idiv((setbr_e - 30000) * 100, 3), 1, theme(TH_TEXT_2))
            set_td(set_cx(x, w, 86), y, "PASS", theme(TH_OK))
        } else {
            text_aa(set_cx(x, w, 86) - SET_TDPX * ui() - cell_w(), set_tdy(y), "-", theme(TH_TEXT_2))
            set_td(set_cx(x, w, 86), y, "FAIL", theme(TH_DANGER))
        }
    }
    return set_trow(x, y, w)
}
fn set_bound_body(x, y, w) {
    # THE BOUNDARY TAB'S FIRST CONTROL. It drew two tables and two wells and
    # nothing you could touch - a whole tab of prose in a pane whose subject is
    # the switches. `tog('occlusion edge', 'over', ...)` is the reference's, and
    # the chrome already computes the state; off falls back to the plain ring,
    # which is exactly what not applying `.win.over` does there.
    set_tog_row(x, y, w, 0, ui_over_on(), "occlusion edge", "off falls back to the plain ZD_CUT ring")
    y = y + set_rowh() + SET_STACK * ui()
    setbb_x = x
    setbb_y = y
    setbb_w = w
    setbb_u = ui()
    setbb_y = set_head(setbb_x, setbb_y, "THE OCCLUDER DRAWS THE BORDER, NEVER THE OCCLUDED")
    if set_vis(setbb_y, set_wellh(9)) == 1 {
        setfb_x = setbb_x
        setfb_y = setbb_y
        set_well(setbb_x, setbb_y, setbb_w, 9)
        set_wlc(setfb_x, setfb_y, 0, 0, "free floating windows put a 3:1 floor on the window boundary,")
        set_wlc(setfb_x, setfb_y, 1, 0, "because under overlap the only thing saying which plate is on top")
        set_wlc(setfb_x, setfb_y, 2, 0, "is the upper plate's bottom and right edge lying on the lower")
        set_wlc(setfb_x, setfb_y, 3, 0, "plate's body.")
        set_wlc(setfb_x, setfb_y, 5, 0, "THE CEILING ON A DARKER EDGE IS FIXED BY THE GROUND ALONE. on the")
        set_wlc(setfb_x, setfb_y, 6, 0, "plate it is")
        set_wnum_r(setfb_x, setfb_y, 6, 18, set_dn(theme(TH_PANEL)), 4)
        set_wlc(setfb_x, setfb_y, 6, 18, ":1 in total, so the downward direction is")
        set_wlc(setfb_x, setfb_y, 7, 0, "arithmetically shut and the occluding edge has to be the LIGHT.")
        set_wlc(setfb_x, setfb_y, 8, 0, "same rule, and the ground decides which way it points.")
    }
    setbb_y = setbb_y + set_wellh(9) + SET_STACK * setbb_u

    if set_vis(setbb_y, set_thh()) == 1 {
        set_th(setbb_x, setbb_y, "EDGE ON")
        set_th_r(set_cx(setbb_x, setbb_w, 44), setbb_y, "ZD_CUT")
        set_th_r(set_cx(setbb_x, setbb_w, 68), setbb_y, "ZD_EDGE_OVER")
        set_th_r(set_cx(setbb_x, setbb_w, 86), setbb_y, "MARGIN ON 3.00")
        set_th(set_cx(setbb_x, setbb_w, 86), setbb_y, "FLOOR")
    }
    setbb_y = set_thead(setbb_x, setbb_y, setbb_w)
    setbb_y = set_bound_row(setbb_x, setbb_y, setbb_w, "ZD_BASE", theme(TH_PANEL))
    setbb_y = set_bound_row(setbb_x, setbb_y, setbb_w, "ZD_RAISE", theme(TH_PANEL_HI))
    setbb_y = set_bound_row(setbb_x, setbb_y, setbb_w, "ZD_FLOAT", theme(TH_SURF_5))
    setbb_y = set_bound_row(setbb_x, setbb_y, setbb_w, "ZD_VOID", theme(TH_BG))
    setbb_y = set_bound_row(setbb_x, setbb_y, setbb_w, "ZD_WELL", theme(TH_SURF_WELL))
    setbb_y = setbb_y + SET_STACK * setbb_u

    setbb_y = set_head(setbb_x, setbb_y, "DEPTH RANK INSIDE A PLATE - TWO RULE WEIGHTS, NO THIRD")
    if set_vis(setbb_y, set_thh()) == 1 {
        set_th(setbb_x, setbb_y, "RANK")
        set_th(set_cx(setbb_x, setbb_w, 46), setbb_y, "TOKEN")
        set_th_r(set_cx(setbb_x, setbb_w, 74), setbb_y, "WEIGHT")
        set_th_r(setbb_x + setbb_w, setbb_y, "ON BASE")
    }
    setbb_y = set_thead(setbb_x, setbb_y, setbb_w)
    if set_vis(setbb_y, set_tdh()) == 1 {
        set_td(setbb_x, setbb_y, "rows, cells, group edges", theme(TH_TEXT_2))
        set_td(set_cx(setbb_x, setbb_w, 46), setbb_y, "ZD_CUT", theme(TH_TEXT_2))
        text_aa(set_cx(setbb_x, setbb_w, 74) - SET_TDPX * setbb_u - 4 * cell_w(), set_tdy(setbb_y), "1 dp", theme(TH_TEXT_2))
        set_rat_r(setbb_x + setbb_w - SET_TDPX * setbb_u, set_tdy(setbb_y), set_r_cut(), 3, theme(TH_TEXT_HI))
    }
    setbb_y = set_trow(setbb_x, setbb_y, setbb_w)
    if set_vis(setbb_y, set_tdh()) == 1 {
        set_td(setbb_x, setbb_y, "regions, table heads, bands", theme(TH_TEXT_2))
        set_td(set_cx(setbb_x, setbb_w, 46), setbb_y, "ZD_LIT", theme(TH_TEXT_2))
        text_aa(set_cx(setbb_x, setbb_w, 74) - SET_TDPX * setbb_u - 4 * cell_w(), set_tdy(setbb_y), "2 dp", theme(TH_TEXT_2))
        set_rat_r(setbb_x + setbb_w - SET_TDPX * setbb_u, set_tdy(setbb_y), set_r_lit(), 3, theme(TH_TEXT_HI))
    }
    setbb_y = set_trow(setbb_x, setbb_y, setbb_w)
    if set_vis(setbb_y, set_tdh()) == 1 {
        set_td(setbb_x, setbb_y, "a third rank", theme(TH_TEXT_DIM))
        set_td(set_cx(setbb_x, setbb_w, 46), setbb_y, "none", theme(TH_TEXT_DIM))
        text_aa(set_cx(setbb_x, setbb_w, 74) - SET_TDPX * setbb_u - cell_w(), set_tdy(setbb_y), "-", theme(TH_TEXT_DIM))
        text_aa(setbb_x + setbb_w - SET_TDPX * setbb_u - 30 * cell_w(), set_tdy(setbb_y), "nesting never changes a value", theme(TH_TEXT_DIM))
    }
    setbb_y = set_trow(setbb_x, setbb_y, setbb_w) + SET_STACK * setbb_u

    if set_vis(setbb_y, set_kvh()) == 1 {
        set_kv(setbb_x, setbb_y, setbb_w, "DRAG CUE")
        set_rat_sfx_r(setbb_x + setbb_w - SET_TDPX * setbb_u, setbb_y + setbb_u, ui_ratio(theme(TH_EDGE_OVER), theme(TH_PANEL)), 2, 20, ", perimeter, no lift", theme(TH_TEXT_HI))
    }
    setbb_y = setbb_y + set_kvh()
    if set_vis(setbb_y, set_kvh()) == 1 {
        set_kv(setbb_x, setbb_y, setbb_w, "FOCUS AND BOUNDARY")
        text_aa(setbb_x + setbb_w - SET_TDPX * setbb_u - 40 * cell_w(), setbb_y + setbb_u, "separated. the header says which is on top", theme(TH_TEXT_HI))
    }
    return setbb_y + set_kvh()
}

# ==============================================================================
# PRESS - what came across from the printed document, and what it cost.
# ==============================================================================
fn set_press_body(x, y, w) {
    setpb_x = x
    setpb_y = y
    setpb_w = w
    setpb_u = ui()
    # THE CONTROLS COME FIRST, as they do on the FOCUS tab and in the reference:
    # what you can change, then what changing it costs.
    setpb_y = setpb_y + set_press_ctl(setpb_x, setpb_y, setpb_w)
    setpb_y = set_head(setpb_x, setpb_y, "WHAT CAME ACROSS FROM PAPER, AND WHAT IT COST")
    if set_vis(setpb_y, set_wellh(12)) == 1 {
        setfb_x = setpb_x
        setfb_y = setpb_y
        set_well(setpb_x, setpb_y, setpb_w, 12)
        set_wlc(setfb_x, setfb_y, 0, 0, "the numbered register, the ruled module grid, LABEL type, hard")
        set_wlc(setfb_x, setfb_y, 1, 0, "rules, the printer's slug, the vermilion overprint and three")
        set_wlc(setfb_x, setfb_y, 2, 0, "instruments. six of the seven are free riders: text, digits and")
        set_wlc(setfb_x, setfb_y, 3, 0, "1px fills that touch no surface value, no boundary token, no")
        set_wlc(setfb_x, setfb_y, 4, 0, "radius and no focus signal.")
        set_wlc(setfb_x, setfb_y, 6, 0, "TWO ARE NOT FREE AND BOTH ARE PRICED HERE.")
        set_wlc(setfb_x, setfb_y, 7, 0, "  TRACKING. fb_text_role cannot letterspace without UI_F_TRACK on")
        set_wlc(setfb_x, setfb_y, 8, 0, "  the existing flag word, and measure and draw must share the")
        set_wlc(setfb_x, setfb_y, 9, 0, "  helper or a label clips. EVERY LABEL IN THIS PANE IS UNTRACKED")
        set_wlc(setfb_x, setfb_y, 10, 0, "  and reads flatter for it. the prototype gets it free from CSS.")
        set_wlc(setfb_x, setfb_y, 11, 0, "  PER WINDOW MICROSECONDS ARE MEASURED - wm_win_us, per plate.")
    }
    setpb_y = setpb_y + set_wellh(12) + SET_STACK * setpb_u

    setpb_y = set_head(setpb_x, setpb_y, "THE TWO INKS, AND THE CONTRACT BETWEEN THEM")
    if set_vis(setpb_y, set_thh()) == 1 {
        set_th(setpb_x, setpb_y, "INK")
        set_th(set_cx(setpb_x, setpb_w, 20), setpb_y, "JOBS")
        set_th_r(set_cx(setpb_x, setpb_w, 76), setpb_y, "ON BASE")
        set_th(set_cx(setpb_x, setpb_w, 76), setpb_y, "MAY CARRY TEXT")
    }
    setpb_y = set_thead(setpb_x, setpb_y, setpb_w)
    if set_vis(setpb_y, set_tdh()) == 1 {
        set_td(setpb_x, setpb_y, "ZD_STEEL", theme(TH_TEXT_2))
        set_td(set_cx(setpb_x, setpb_w, 20), setpb_y, "raster columns, meter fills, ruler", theme(TH_TEXT_2))
        set_rat_r(set_cx(setpb_x, setpb_w, 76) - SET_TDPX * setpb_u, set_tdy(setpb_y), ui_ratio(theme(TH_STEEL), theme(TH_PANEL)), 2, theme(TH_TEXT_HI))
        set_td(set_cx(setpb_x, setpb_w, 76), setpb_y, "no - instrument", theme(TH_TEXT_DIM))
    }
    setpb_y = set_trow(setpb_x, setpb_y, setpb_w)
    if set_vis(setpb_y, set_tdh()) == 1 {
        set_td(setpb_x, setpb_y, "ZD_VERM", theme(TH_TEXT_2))
        set_td(set_cx(setpb_x, setpb_w, 20), setpb_y, "focus bar, register mark, crop marks", theme(TH_TEXT_2))
        set_rat_r(set_cx(setpb_x, setpb_w, 76) - SET_TDPX * setpb_u, set_tdy(setpb_y), set_r_verm(), 2, theme(TH_TEXT_HI))
        set_td(set_cx(setpb_x, setpb_w, 76), setpb_y, "no - a fill or mark", theme(TH_TEXT_DIM))
    }
    setpb_y = set_trow(setpb_x, setpb_y, setpb_w) + SET_STACK * setpb_u

    if set_vis(setpb_y, set_wellh(7)) == 1 {
        setfb_x = setpb_x
        setfb_y = setpb_y
        set_well(setpb_x, setpb_y, setpb_w, 7)
        set_wlc(setfb_x, setfb_y, 0, 0, "two chromatic inks is more than either parent allowed and the risk")
        set_wlc(setfb_x, setfb_y, 1, 0, "is real: two inks on warm graphite starts to look decorative. the")
        set_wlc(setfb_x, setfb_y, 2, 0, "mitigation is a WIDTH rule - vermilion never fills an area wider")
        set_wlc(setfb_x, setfb_y, 3, 0, "than the focus bar except one button per view - and a PLACEMENT")
        set_wlc(setfb_x, setfb_y, 4, 0, "rule: steel appears inside an instrument and nowhere else.")
        set_wlc(setfb_x, setfb_y, 6, 0, "if that discipline slips this becomes a generic two accent dark UI.")
    }
    setpb_y = setpb_y + set_wellh(7) + SET_STACK * setpb_u

    # THE LIVE READINGS. app_us is what wm.c actually measured for the last
    # draw of this window - the same figure its own foot band prints - so the
    # bottom of this tab is the cost of the top of it.
    #
    # AND IT WAS wm_us(), WHICH IS NOT THAT. wm_us is wm_frame_us: the WHOLE
    # compositor frame, every window's work plus the chrome, printed under the
    # label "THIS PANE" with the comment above claiming the opposite. The
    # per-window figure was measured all along - two rdtsc around the app call
    # in app_draw_dispatch - and no accessor existed in any .c, .h or .zl, so
    # nothing could read the slot it was written into. wm_appus is that
    # accessor.
    if set_vis(setpb_y, set_kvh()) == 1 {
        set_kv(setpb_x, setpb_y, setpb_w, "THIS PANE, LAST DRAW")
        # settings_win, not `win` - set_press_body takes (x, y, w) and has no
        # window in scope, so `win` here would have read whatever global of that
        # name happened to hold, which is how a plausible wrong number gets on
        # screen without anything failing.
        setpb_v = wm_appus(settings_win)
        text_aa(setpb_x + setpb_w - SET_TDPX * setpb_u - 3 * cell_w(), setpb_y + setpb_u, " us", theme(TH_TEXT_HI))
        num_aa(setpb_x + setpb_w - SET_TDPX * setpb_u - 3 * cell_w() - s3_numw(setpb_v), setpb_y + setpb_u, setpb_v, theme(TH_TEXT_HI))
    }
    setpb_y = setpb_y + set_kvh()
    if set_vis(setpb_y, set_kvh()) == 1 {
        set_kv(setpb_x, setpb_y, setpb_w, "TYPE SIZES")
        text_aa(setpb_x + setpb_w - SET_TDPX * setpb_u - 40 * cell_w(), setpb_y + setpb_u, "three, landing exactly on the three atlases", theme(TH_TEXT_HI))
    }
    setpb_y = setpb_y + set_kvh()
    if set_vis(setpb_y, set_kvh()) == 1 {
        set_kv(setpb_x, setpb_y, setpb_w, "TYPE STYLES")
        text_aa(setpb_x + setpb_w - SET_TDPX * setpb_u - 32 * cell_w(), setpb_y + setpb_u, "four. DATA, LABEL, BODY, PLATE", theme(TH_TEXT_HI))
    }
    setpb_y = setpb_y + set_kvh()
    if set_vis(setpb_y, set_kvh()) == 1 {
        set_kv(setpb_x, setpb_y, setpb_w, "GLYPH RASTERISER")
        text_aa(setpb_x + setpb_w - SET_TDPX * setpb_u - 34 * cell_w(), setpb_y + setpb_u, "none. three baked atlases, no runtime", theme(TH_TEXT_HI))
    }
    return setpb_y + set_kvh()
}

# ==============================================================================
# THE PANE - chrome, the scroll viewport, and the two entry points wm.c calls.
# ==============================================================================
# THE HEADER LINE IS "design.h - live" AND IT IS A CLAIM. Every figure under it
# was computed from the loaded theme this repaint, so the line is either true
# or the pane is broken; there is no third state where it is decorative.
SET_TABROW = 24                    # the tab row's own height, .row at 24dp

fn set_tabrow_y(ay) { return ay + SET_PADY * ui() }
fn set_seg_y(ay)    { return set_tabrow_y(ay) + (SET_TABROW * ui() - set_segh()) / 2 }
# WHERE THE SCROLLING BODY STARTS. Shared by the draw and by the hit test for
# the two FOCUS controls, so the two cannot disagree about which row was
# clicked - the failure mode uikit.c documents and the reason none of this
# arithmetic is written twice.
fn set_body_y(ay) {
    return set_tabrow_y(ay) + SET_TABROW * ui() + SET_R2 * ui() + SET_STACK * ui()
}
fn set_ctl_y(ay)  { return set_body_y(ay) - set_scroll }
fn set_body_x(ax) { return ax + SET_PADX * ui() }
fn set_body_w(aw) { return aw - 2 * SET_PADX * ui() }

fn set_tab_body(x, y, w) {
    if set_tab == SET_LADDER   { return set_ladder_body(x, y, w) }
    if set_tab == SET_FOCUS    { return set_focus_body(x, y, w) }
    if set_tab == SET_BOUNDARY { return set_bound_body(x, y, w) }
    return set_press_body(x, y, w)
}

fn settings_body(ax, ay, aw, ah) {
    setb_u = ui()
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    setb_x = set_body_x(ax)
    setb_w = set_body_w(aw)

    # --- the tab row ----------------------------------------------------------
    set_segbar(setb_x, set_seg_y(ay))
    # "design.h - live", DATA mono, right margin. The prototype separates the
    # two words with a middle dot; the console atlas is ASCII, so it is a hyphen
    # and that is a substitution rather than a design decision - said here
    # because an unexplained difference from the prototype is a bug report
    # waiting to be filed against a deliberate choice.
    text_aa(setb_x + setb_w - 15 * cell_w(), set_tabrow_y(ay) + (SET_TABROW * setb_u - cell_h()) / 2, "design.h - live", theme(TH_TEXT_DIM))
    set_rule2(setb_x, set_tabrow_y(ay) + SET_TABROW * setb_u, setb_w)

    # --- the scrolling body ---------------------------------------------------
    # set_c0/set_c1 are the viewport in absolute pixels and every block tests
    # itself against them before drawing. wm.c's client scissor is what makes
    # the block STRADDLING the edge safe - "an app physically cannot draw over
    # its own title bar no matter what it does" - so this only decides what is
    # not worth drawing, never what is allowed to.
    set_c0 = set_body_y(ay)
    set_c1 = ay + ah
    # THE SCISSOR, because set_vis alone is not one. set_vis skips a block only
    # when it is ENTIRELY above the viewport - `if y + h <= set_c0 { return 0 }`
    # - so a block STRADDLING the fold is drawn in full, up over the tab strip
    # and the rule under it. The comment above says the compositor keeps a
    # straddling block "safe" because an app cannot draw over its own title bar;
    # that is true of the CHROME and says nothing about this pane's own header,
    # which is inside the client rect and is exactly what got painted over.
    #
    # `clip` drives the framebuffer's real scissor and this file already uses it
    # twice. The hit test gained its floor a commit ago; this is the other half,
    # and having only one of the two is what let the draw and the click disagree
    # about where the body begins.
    clip(setb_x, set_c0, setb_w, set_c1 - set_c0)
    setb_end = set_tab_body(setb_x, set_ctl_y(ay), setb_w)
    clipoff()
    # WHAT THE DRAW JUST LEARNED, fed to the next one. The content height is
    # taken from the draw that produced it rather than from a second pass that
    # walks the same layout to total it up; a second pass is a second copy of
    # the layout and the two diverge the first time one is edited.
    set_conth = setb_end - set_ctl_y(ay)
    set_viewh = set_c1 - set_c0
    set_clamp_scroll()

    # THE TRIM. A pane that scrolls cuts its last row wherever the pane ends,
    # and against the window's own foot band that chop reads as a rendering
    # fault. The cut lands on a 2dp ZD_LIT rule - the same rule weight every
    # other rank break uses - so the half row above it reads as a column
    # continuing past the trim, which is what it is.
    if set_conth > set_viewh { set_rule2(setb_x, set_c1 - SET_R2 * setb_u, setb_w) }
    set_scrollbar(ax, aw, set_c0, set_viewh)
    return 0
}

# THE SCROLLBAR, AND THE PANE HAD NONE.
#
# The prototype styles one - `.scroll::-webkit-scrollbar` and its thumb - and
# this pane scrolled with no bar and no position indicator at all: nothing on
# screen said there was more, or how much, or where in it you were. On a tab
# whose content runs to twice the viewport that is the difference between a
# short pane and a pane you did not know was long.
#
# Geometry from ui.c's own scrollbar so the two agree: SCROLLBAR_W wide against
# the right edge, the track in ZD_SURF_WELL, the thumb in ZD_SURF_7 with chip
# ends. The thumb's LENGTH is the viewport's share of the content and its
# POSITION is the scroll's share of the overrun - both read from the figures the
# draw just learned, so the bar cannot disagree with what it is describing.
#
# Drawn only when there is something to scroll. A full-length thumb in a
# full-height track is a bar saying nothing, and the prototype's `overflow-y:
# auto` hides it for the same reason.
SCROLLBAR_W = 9

fn set_scrollbar(ax, aw, vy, vh) {
    if set_conth <= vh { return 0 }
    if vh < 1 { return 0 }
    ssu = ui()
    ssw = SCROLLBAR_W * ssu
    ssx = ax + aw - ssw - 2 * ssu
    fill_rgb(ssx, vy, ssw, vh, theme(TH_SURF_WELL))
    # the thumb: the viewport's share of the content, never thinner than a chip
    ssth = idiv(vh * vh, set_conth)
    if ssth < 2 * R_CHIP_D * ssu { ssth = 2 * R_CHIP_D * ssu }
    if ssth > vh { ssth = vh }
    ssover = set_conth - vh
    ssty = vy
    if ssover > 0 { ssty = vy + idiv((vh - ssth) * set_scroll, ssover) }
    rrect(ssx, ssty, ssw, ssth, R_CHIP_D * ssu, theme(TH_SURF_7))
    return 0
}

# The clamp is separate because three callers need it: the draw (after
# learning the height), the wheel, and the tab switch. One copy.
fn set_clamp_scroll() {
    setcs_max = set_conth - set_viewh
    if setcs_max < 0 { setcs_max = 0 }
    if set_scroll > setcs_max { set_scroll = setcs_max }
    if set_scroll < 0 { set_scroll = 0 }
    return 0
}

# ---- the events ---------------------------------------------------------------
# A CONTROL THAT CHANGES A NUMBER WITHOUT CHANGING THE SCREEN IS AN ASSERTION,
# which is the thing this pane exists not to be. Both controls call into ui.c,
# which rebuilds the theme, and then damage EVERY window - because the theme is
# global and each window's client surface is retained, so a window that is not
# repainted keeps the old header until something else happens to touch it. That
# is the same "finished-looking code with no caller" shape this tree keeps
# catching, one layer up: the setting would be correct and invisible.
fn settings_event(win, ety, ecode, ex, ey) {
    setev_ax = wm_cx(win)
    setev_ay = wm_cy(win)
    setev_aw = wm_cw(win)
    setev_x = set_body_x(setev_ax)
    setev_w = set_body_w(setev_aw)

    # THE WHEEL. Scroll goes to what is under the pointer and wm.c already
    # routed it here, so there is nothing to hit test - the whole client is the
    # scroll region. The notch count is SIGNED and arrives as it was counted.
    if ety == 5 {
        set_scroll = set_scroll - ecode * SET_SCRLSTEP * ui()
        set_clamp_scroll()
        wm_dmg(win)
        return 1
    }

    if ety == 4 {
        # bit 0 of the mask is the left button. Without this check every
        # pointer MOVE across the pane would toggle the knockout, which is the
        # bug the browser's click path already paid for once.
        if band(ecode, 1) == 0 { return 0 }
        setev_t = set_tab_at(setev_x, set_seg_y(setev_ay), ex, ey)
        if setev_t >= 0 {
            if setev_t != set_tab {
                set_tab = setev_t
                # A NEW TAB STARTS AT THE TOP. Carrying the scroll across means
                # landing in the middle of a shorter tab with nothing above the
                # fold, which reads as an empty pane.
                set_scroll = 0
            }
            wm_dmg(win)
            return 1
        }
        # THE VIEWPORT FLOOR. Every hit test below this line is against a row
        # in the SCROLLING body, and the draw clips those rows to the viewport
        # (set_focus_ctl gates each on set_vis against set_body_y) while the hit
        # tests did not. So one wheel notch put a control's hit rectangle up
        # underneath the tab strip, where the row is not drawn at all - clicking
        # a tab toggled the knockout, and clicking where the control appeared to
        # be did nothing.
        #
        # A draw that clips and a hit test that does not is two different
        # answers to "where is this control", and the one the user can see is
        # the one that loses.
        if ey < set_body_y(setev_ay) { return 1 }

        # The two live controls are on the FOCUS tab only, and they are the
        # first two rows of its scrolling body - so their y moves with the
        # scroll and the hit test asks the same functions the draw did.
        # PRESS's four toggles, hit-tested against the same set_rowN_y the draw
        # used. Each one re-bakes or re-damages exactly what it changed: the
        # grid and the crop marks live in the wallpaper cache, so those two cost
        # a re-bake, and the ruler and slug are drawn live on the foot.
        if set_tab == SET_PRESS {
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 0), setev_w, ex, ey) == 1 {
                desk_grid_on = 1 - desk_grid_on
                rebake_wallpaper()
                wm_damage(0, 0, px_w(), px_h())
                return 1
            }
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 1), setev_w, ex, ey) == 1 {
                desk_crop_on = 1 - desk_crop_on
                rebake_wallpaper()
                wm_damage(0, 0, px_w(), px_h())
                return 1
            }
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 2), setev_w, ex, ey) == 1 {
                desk_ruler_on = 1 - desk_ruler_on
                wm_damage(0, 0, px_w(), px_h())
                return 1
            }
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 3), setev_w, ex, ey) == 1 {
                desk_slug_on = 1 - desk_slug_on
                wm_damage(0, 0, px_w(), px_h())
                return 1
            }
            # THE TWO NEW ROWS, wired in the same breath they were drawn in.
            # Both change how EVERY window is composited, so both damage the
            # whole screen rather than the pane: motion changes what a
            # transition looks like and tracking changes the width of every
            # tracked run in the system.
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 4), setev_w, ex, ey) == 1 {
                ui_motion(1 - ui_motion_on())
                if ui_motion_on() == 1 { note_say2("motion on", "RISE 90 / TRAVEL 160 / SETTLE 240, one curve", 800) } else { note_say2("motion off", "every transition completes on the frame it starts", 800) }
                wm_damage_theme()
                return 1
            }
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 5), setev_w, ex, ey) == 1 {
                ui_track(1 - ui_track_on())
                if ui_track_on() == 1 { note_say2("label tracking on", "ZD_TR_LAB 1.4 and ZD_TR_BIG 2.6", 800) } else { note_say2("label tracking off", "the letter-spacing goes, the faces stay", 800) }
                wm_damage_theme()
                return 1
            }
            # THE SEGMENT IS HIT-TESTED ON THE BAR, NOT ON THE ROW. A toggle
            # occupies its whole row so set_hit_row is right for one; a
            # segmented control has three targets inside its bar and a row-wide
            # test could only ever pick one of them. set_seg_row_at asks the
            # same two functions set_seg_row drew with.
            setev_g = set_seg_row_at(setev_x, set_ctl_y(setev_ay), setev_w, 6, SEG_US, ex, ey)
            if setev_g >= 0 {
                seg_pick(SEG_US, setev_g)
                wm_damage(0, 0, px_w(), px_h())
                return 1
            }
        }
        # AND THE LADDER TAB HAS ONE TOO, from the same shared helper the draw
        # used - set_ladder_seg_y, not a second copy of head + well + stack.
        if set_tab == SET_LADDER {
            setev_l = set_seg_row_at(setev_x, set_ladder_seg_y(set_body_y(setev_ay)), setev_w, 0, SEG_LADDER, ex, ey)
            if setev_l >= 0 {
                seg_pick(SEG_LADDER, setev_l)
                wm_dmg(win)
                return 1
            }
        }
        # THE BOUNDARY TAB HAS A CONTROL NOW and therefore needs an arm. It had
        # neither, which is why it needed neither.
        if set_tab == SET_BOUNDARY {
            if set_hit_row(setev_x, set_rowN_y(set_ctl_y(setev_ay), 0), setev_w, ex, ey) == 1 {
                ui_over(1 - ui_over_on())
                if ui_over_on() == 1 { note_say2("occlusion edge on", "a plate over another gets the lighter ring", 800) } else { note_say2("occlusion edge off", "every plate takes the plain ZD_CUT ring", 800) }
                wm_damage_theme()
                return 1
            }
        }
        if set_tab == SET_FOCUS {
            if set_hit_row(setev_x, set_row1_y(set_ctl_y(setev_ay)), setev_w, ex, ey) == 1 {
                ui_knock(1 - ui_knock_on())
                wm_damage_theme()
                return 1
            }
            if set_hit_trk(setev_x, set_row2_y(set_ctl_y(setev_ay)), setev_w, ex, ey) == 1 {
                ui_fbar(set_slider_v(set_trk_x(setev_x), set_trk_w(setev_x, setev_w), 1, 6, ex))
                wm_damage_theme()
                return 1
            }
        }
        return 0
    }

    # Keys, so the pane is usable with no pointer at all - which is not a
    # nicety here: this machine has booted with a keyboard and no mouse more
    # than once, and a design document you cannot scroll is a design document
    # you cannot read.
    if ety == 1 {
        if ecode == K_UP    { set_scroll = set_scroll - SET_SCRLSTEP * ui()  set_clamp_scroll()  wm_dmg(win)  return 1 }
        if ecode == K_DOWN  { set_scroll = set_scroll + SET_SCRLSTEP * ui()  set_clamp_scroll()  wm_dmg(win)  return 1 }
        if ecode == K_HOME  { set_scroll = 0  wm_dmg(win)  return 1 }
        if ecode == K_END   { set_scroll = set_conth  set_clamp_scroll()  wm_dmg(win)  return 1 }
        if ecode == K_LEFT  { set_tab = (set_tab + SET_TABS - 1) % SET_TABS  set_scroll = 0  wm_dmg(win)  return 1 }
        if ecode == K_RIGHT { set_tab = (set_tab + 1) % SET_TABS  set_scroll = 0  wm_dmg(win)  return 1 }
        if ecode == K_TAB   { set_tab = (set_tab + 1) % SET_TABS  set_scroll = 0  wm_dmg(win)  return 1 }
    }
    if ety == 3 {
        # the two live controls, from the keyboard. `k` is the toggle; `[` and
        # `]` step the focus bar, which is what a slider is when there is no
        # pointer to drag.
        # THE KNOCKOUT TOGGLE SAYS WHAT IT DID, and the ratio is RECOMPUTED
        # rather than quoted. The prototype's body for this toast cites 6.4796
        # and 1.400 - its own ladder's figures. ui_ratio() reads this one's,
        # live, so the number on screen is this machine's and not a number
        # copied from a document about a different one.
        if ecode == 107 {
            ui_knock(1 - ui_knock_on())
            if ui_knock_on() == 1 { note_say2("knockout on", "the focused header inverts, and it is the only focus signal", 800) } else { note_say2("knockout off", "fallback is the wash ramp - sit back and find the focused plate", 800) }
            wm_damage_theme()
            return 1
        }
        if ecode == 91  { ui_fbar(ui_fbar_dp() - 1)  wm_damage_theme()  return 1 }
        if ecode == 93  { ui_fbar(ui_fbar_dp() + 1)  wm_damage_theme()  return 1 }
    }
    return 0
}

fn app_draw(id, ax, ay, aw, ah, afocus) {
    if id == APP_MONITOR { return sysmon_body(ax, ay, aw, ah) }
    if id == APP_ABOUT   { return about_body(ax, ay, aw, ah) }
    if id == APP_SNAKE   { return sn_draw(ax, ay, aw, ah) }
    if id == APP_MENU    { return menu_draw(ax, ay, aw, ah) }
    # 10 SYSTEM and 14 TYPE. Tested BEFORE the `id >= REG_FIRST` fall-through
    # at the foot of this chain, because 71 and 72 are above the registry range
    # and would otherwise be handed to reg_draw, which has never heard of them
    # and would draw nothing at all - the silent-fallback failure this file
    # keeps catching. Same placement APP_CATALOG needs and for the same reason.
    if id == APP_SYSPANE  { return sys_body(ax, ay, aw, ah) }
    if id == APP_TYPEPANE { return type_body(ax, ay, aw, ah) }
    # 11 SETTINGS. It used to be dispatched in wmglue.c straight to settings.c
    # because zl had no ui_* natives; it does now, and policy belongs here with
    # every other app rather than in the seam. See settings_body's header.
    if id == APP_SETTINGS { return settings_body(ax, ay, aw, ah) }
    # THE BROWSER'S ENTIRE POLICY SURFACE IS THIS LINE. The parse, the box
    # model and the paint are C - a tokenizer is string handling, and the zl
    # kernel subset has string literals but no string values. Same split the
    # terminal's command matcher had to make, and for the same reason.
    if id == APP_BROWSER { return br_draw(ax, ay, aw, ah, afocus) }
    # The exec track's window. Its body is written in C for the same reason
    # term.c's is: what it has to say includes a FILENAME, and a filename
    # cannot be a zl value - zl_binop hard-faults on any string operand. So
    # this branch does nothing but hand exec.c the client rectangle.
    if id == APP_RUN {
        u = ui()
        exec_draw(ax + 8 * u, ay + 6 * u, aw - 16 * u, ah - 12 * u, theme(TH_TEXT_HI), theme(TH_TEXT_DIM), theme(TH_ACCENT))
        return 0
    }
    if id == APP_PAINT   { return paint_draw(ax, ay, aw, ah) }
    if id == APP_CUBE    { return cube_draw(ax, ay, aw, ah) }
    if id == APP_ANIM    { return anim_draw(ax, ay, aw, ah) }
    if id == APP_MOUSE   { return mouse_draw(ax, ay, aw, ah) }
    if id == APP_EDIT    { return editor_draw(ax, ay, aw, ah) }
    if id == APP_FILES   { return files_draw(ax, ay, aw, ah) }
    if id == APP_SHELL {
        # The terminal redraws itself from its OWN scrollback, which is what
        # makes it survive a window being dragged across it. Before term.c the
        # shell's output existed only as pixels and could not be repainted.
        #
        # CLEAR THE TARGET FIRST. A retained client surface is reused, not
        # freshly allocated on every invalidation. term_draw paints glyphs but
        # no background, so `clear` changed the scrollback model and then drew
        # nothing over the old glyph pixels; Backspace likewise left the last
        # character visible. The physical trace contains three successful
        # `clear` submissions, and the PS/2-only pixel gate reproduced an
        # exactly unchanged client. The current clip is already the full
        # client or the one-row prompt dirty rect, so this clears no more than
        # the invalidation asked for and keeps the partial-update fast path.
        fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
        u = ui()
        cb = 0
        if afocus == 1 { if band(ticks() / 50, 1) == 0 { cb = 1 } }
        # THE TRANSCRIPT SITS IN A WELL, as the reference's
        # `<div class="well stack">` does. It was drawn straight onto the plate,
        # so the one surface in this app that is a container did not read as one.
        shp = 10 * u
        shbh = SH_BTNH * u + 10 * u
        shwh = ah - 2 * shp - shbh
        pw_well(ax + shp, ay + shp, aw - 2 * shp, shwh)
        term_draw(ax + shp + 8 * u, ay + shp + 6 * u, aw - 2 * shp - 16 * u, shwh - 12 * u, theme(TH_TEXT_HI), theme(TH_TEXT_DIM), theme(TH_ACCENT), cb)
        sh_buttons(ax + shp, ay + ah - shp - SH_BTNH * u, aw - 2 * shp)
        return 0
    }
    # Everything past APP_EDIT is the app suite (apps_registry.zl and the
    # category modules it fronts) - one seam, so this chain never grows past
    # the original 13 again.
    # REG_FIRST, not APP_CATALOG. The floor is "the registry owns this id",
    # and APP_CATALOG stopped being that number the moment APP_FILES was given
    # 13 - see apps_registry.zl's note on the constant.
    if id >= REG_FIRST { return reg_draw(id, ax, ay, aw, ah, afocus) }
    return 0
}

# Return 1 if handled, 0 if NOT. The fall-through used to `return 1`, so the
# System Monitor and the About window each claimed to have handled every event
# sent to them and then dropped it. wm.c discards this value at all three
# hook_event call sites today, so that was not what made the terminal
# untypeable - THAT was wm_open focusing the window it just opened, which left
# the shell (opened first) unfocused while About (opened last) received every
# keystroke and ignored it. Fixed where it belongs, with wm_focus below.
#
# The honest return value stays anyway. ui.h states the contract, wm.c will
# read it the moment there is a fallback path for an unhandled key, and
# claiming to have handled something you dropped is the same bug class as a
# silent fallback - which is this repo's most expensive recurring bug.
# THE PS/2 KEYBOARD DOES NOT PRODUCE A CHARACTER FOR ENTER.
#
# input.c's sc_plain[] has 0 at 0x01 (ESC), 0x0E (backspace) and 0x1C (Enter),
# so handle_scancode pushes EV_KEY_DOWN with a navigation code and skips the
# `if (ch)` that would push EV_CHAR. Only the USB HID path turns those into
# 27/8/13 (xhci.c hid_to_ascii). An app that listens for EV_CHAR alone can
# therefore be TYPED INTO but never submitted to - letters arrive, Enter does
# nothing, and no command ever runs.
#
# That is the ThinkPad's own keyboard, and no gate could see it: every probe
# boots with -device usb-kbd attached. The old text shell was immune because
# key_full()/edit_key() translated scancodes through KBD_TABLE themselves; the
# conversion to app_event lost that, so this is a regression, not an old bug.
#
# Translated here, once, rather than in each app: policy about what a key MEANS
# belongs above wm.c, and every app already speaks ASCII.
KEY_ESC_NAV   = 0x101
KEY_BACK_NAV  = 0x102
KEY_ENTER_NAV = 0x104

fn nav_to_char(ecode) {
    if ecode == KEY_ENTER_NAV { return 13 }
    if ecode == KEY_BACK_NAV  { return 8 }
    if ecode == KEY_ESC_NAV   { return 27 }
    return 0
}

fn app_event(id, win, ety, ecode, ex, ey) {
    if id == APP_SNAKE { return sn_event(ety, ecode) }
    if id == APP_SETTINGS { return settings_event(win, ety, ecode, ex, ey) }
    if id == APP_MENU  { return menu_event(ety, ecode, ex, ey, win) }
    # BEFORE the nav_to_char translation below, like Snake and the browser -
    # not after it. That block turns an untranslatable EV_KEY_DOWN (anything
    # that is not Esc/Backspace/Enter) into an immediate `return 0`, which
    # would silently eat every arrow-key press before a registry app ever saw
    # it. 2048 and the maze both steer by arrow key, so this needs the RAW
    # event, exactly as K_LEFT/K_RIGHT/K_UP/K_DOWN are already defined for.
    # REG_FIRST, not APP_CATALOG - and here the old floor was actively wrong
    # rather than merely misnamed. It sat ABOVE the `id == APP_FILES` arm
    # below, and APP_FILES is 13, so every key and click aimed at the Files
    # window was routed into cat_event() instead of files_event().
    # THE SAME TWO ARMS app_draw HAS, AND FOR THE SAME REASON. app_draw tests
    # these ids before the registry fall-through and explains why: they are
    # above the registry range and reg_draw "has never heard of them and would
    # draw nothing at all". app_event was never given the treatment, so 14 TYPE
    # and the system pane fell into reg_event, which does not know them either -
    # no scrolling, no clicks, no keys.
    #
    # A dispatcher fixed on one side and not the other is the same defect twice
    # over: the draw path was corrected and the event path was left with the
    # bug the correction describes.
    if id == APP_TYPEPANE { return type_event(win, ety, ecode) }
    if id >= REG_FIRST { return reg_event(id, win, ety, ecode, ex, ey) }
    if id == APP_BROWSER {
        # '[' and ']' RESIZE THE WINDOW, and that is the gate rather than a
        # convenience: reflow is only observable if the width can change while
        # the machine is running. wm_resize has existed since the compositor
        # landed with no caller and no way to reach it - this is the first.
        if ety == 3 {
            if ecode == 91 { wm_size(win, wm_w(win) - 80, wm_hh(win))  wm_dmg(win)  return 1 }
            if ecode == 93 { wm_size(win, wm_w(win) + 80, wm_hh(win))  wm_dmg(win)  return 1 }
            if br_key(ecode) == 1 { wm_dmg(win) }
            return 1
        }
        # THE BUTTON MASK, which was not checked. EV_MOUSE carries it in ecode
        # (input.c:620 pushes `(u32)b`), and it is pushed for MOTION too - the
        # coalescer above it only suppresses events where position AND buttons
        # are both unchanged. So calling br_click on every EV_MOUSE meant moving
        # the pointer across a link fired a full fetch. menu_event gets this
        # right with the same test.
        # THE BUTTON MASK GOES THROUGH. br_click(ex, ey) passed two arguments
        # and browser_click reads three - cx, cy AND btn - so the third came
        # from an uninitialised stack slot in the builtin dispatcher.
        #
        # The `band(ecode, 1) != 0` gate has to GO rather than move: browser.c
        # computes its own press EDGE from btn (`down = (btn & 1) && !(click_btn
        # & 1)`), and it can only do that if it SEES the releases. Filtering
        # them out left click_btn latched, so the edge fired at most once.
        if ety == 4 {
            if br_click(ex, ey, ecode) == 1 { wm_dmg(win) }
            return 1
        }
        # ...AND KEYS AND THE WHEEL ARE NOT SWALLOWED. This fell through to a
        # bare `return 1` that ate every other event type. EV_KEY_DOWN is 1, and
        # wm.c routes an extended keycode there with no EV_CHAR beside it, so
        # the arrows, Home, End and the page keys never reached browser_key at
        # all - a bound native with, from this arm, no caller.
        # KEYCODES ONLY. input.c BACKFILLS a letter's EV_KEY_DOWN with its
        # character when sc_special() has no keycode for it - `if (!key && ch)
        # key = ch;` - so a printable key arrives TWICE with the same code, once
        # as EV_KEY_DOWN and once as EV_CHAR. Taking both fed every letter to
        # the browser twice: typing 'l' opened the URL bar with an 'l' already
        # in it.
        #
        # This is the identical fault the desk-key path had, found a week ago
        # and fixed there by splitting on CODE SPACE rather than event type.
        # Keycodes are >= 0x100 and reach us only as EV_KEY_DOWN; characters are
        # below it and are authoritative on EV_CHAR. I had the answer written
        # down in wm.c and did not apply it here.
        if ety == 1 {
            if ecode >= 0x100 {
                if br_key(ecode) == 1 { wm_dmg(win) }
            }
            return 1
        }
        if ety == 5 {
            if br_scroll(0 - ecode * 3 * cell_h()) == 1 { wm_dmg(win) }
            return 1
        }
        return 1
    }
    if id == APP_FILES { return files_event(win, ety, ecode, ex, ey) }
    # Terminal navigation is a KEY, not a character.  The physical ThinkPad
    # trace retained Left/Right/Up/Down events here and then watched this block
    # discard them because nav_to_char only translates Enter/Backspace/Esc.
    # Let term.c's cursor/history editor own those keys before the generic
    # character-only translation used by the append-only editor below.
    if id == APP_SHELL {
        ac = ecode
        # THE BUTTONS ARE CLICKABLE, which is the difference between a control
        # and a picture of one. The mask is tested the way menu_event and the
        # browser test it: EV_MOUSE carries the buttons in ecode and is pushed
        # for MOTION too, so acting on every EV_MOUSE would fire on hover.
        if ety == 4 {
            if band(ecode, 1) != 0 {
                # run_command, NOT open_app. open_app handles seven commands -
                # 77, 97, 100, 103, 105, 118, 120 - and neither 210 nor 216 is
                # among them, so both buttons returned 0 and did nothing even
                # before the coordinate bug above. Two independent reasons for
                # the same dead control, which is why "I wired it" is never the
                # same claim as "it fires".
                shb = sh_btn_hit(win, ex, ey)
                if shb == 0 { return run_command(210, 0) }
                if shb == 1 { return run_command(216, 0) }
            }
            return 1
        }
        if ety == 1 {
            ac = nav_to_char(ecode)
            if ac == 0 {
                if ecode == K_LEFT  { ac = ecode }
                if ecode == K_RIGHT { ac = ecode }
                if ecode == K_UP    { ac = ecode }
                if ecode == K_DOWN  { ac = ecode }
                if ecode == K_HOME  { ac = ecode }
                if ecode == K_END   { ac = ecode }
                if ecode == K_DEL   { ac = ecode }
            }
            if ac == 0 { return 0 }
            ety = 3
        }
        ecode = ac
        # ONE CHARACTER OR NAVIGATION KEY PER CALL. No loop - that is the
        # whole inversion. term_key owns cursor movement and history.
        if ety == 3 {
            if term_key(ecode) == 1 {
                tc = term_cmd()
                if tc > 0 {
                    if tc == 113 { term_complete(tc, 0)  wm_stop()  return 1 }
                    ta = term_arg()
                    td_open = open_app(tc, ta)
                    if td_open == 0 {
                        sh_t0 = cpu_tsc()
                        td_result = run_command(tc, ta)
                        # THE REFERENCE PRINTS "exit 0 - 1.42 s" AND BOTH HALVES
                        # ARE REAL HERE. run_command already returned a result
                        # and it was passed to term_complete and then dropped;
                        # ticks() is the PIT at 100 Hz, so it is centiseconds
                        # and 142 of them IS 1.42 s. Nothing had to be invented,
                        # only kept.
                        # MICROSECONDS FROM THE TSC, NOT CENTISECONDS FROM
                        # THE PIT. ticks() is 100 Hz, so every builtin that
                        # finishes inside 10 ms - which is all of them - read
                        # "0.00 s": true, and useless. cpu_khz() is the
                        # measured TSC rate, so (delta / khz) is microseconds
                        # and the readout can show what a command actually
                        # cost. A zero or uncalibrated rate falls back rather
                        # than dividing by it.
                        # CYCLES TIMES 1000 OVER kHz, BECAUSE kHz IS CYCLES
                        # PER MILLISECOND.
                        #
                        # This was `(cpu_tsc() - sh_t0) / sh_khz`, which is
                        # MILLISECONDS, printed under a " us" label - a
                        # thousand-fold unit error committed on the same day I
                        # fixed a thousand-fold unit error in the network pane's
                        # rtt row, and in a readout added specifically because
                        # the previous one always printed 0.00 s. It then always
                        # printed 0 us, which is the same failure in new units.
                        #
                        # cpu_tsc_khz() returns cycles / (elapsed * 10) where
                        # elapsed counts 10 ms ticks - kHz, cycles per
                        # millisecond. Three places in this tree already get it
                        # right and all three multiply by 1000: wm.c's
                        # cycles_per_us, net.c's tsc_to_us, zllog.c's cycles_us.
                        # The old variable name sh_us - centiseconds, from the
                        # PIT version before it - was the tell.
                        sh_khz = cpu_khz()
                        if sh_khz > 0 { sh_us = (cpu_tsc() - sh_t0) * 1000 / sh_khz } else { sh_us = 0 }
                        term_complete(tc, td_result)
                    } else { term_complete(tc, 0) }
                }
            }
            if term_bad() == 1 { wm_anim(shell_win, 4) }
            if ecode == 13 { ser_out("zl> ") }
            if ecode == 10 { ser_out("zl> ") }
            if ecode == 13 {
                wm_damage_win_all()
            } else {
                if ecode == 10 { wm_damage_win_all() } else { wm_damage_shell_input() }
            }
        }
        return 1
    }
    # EV_KEY_DOWN (1) carrying a navigation code becomes the character the apps
    # below already handle. EV_CHAR (3) passes straight through.
    ac = ecode
    if ety == 1 {
        ac = nav_to_char(ecode)
        if ac == 0 { return 0 }
        ety = 3
    }
    ecode = ac
    # (apps-in-windows had a second APP_SNAKE arm here, calling its own
    #  snake_key(); the sn_event arm above returns first.)
    if id == APP_EDIT {
        if ety == 3 {
            ek = editor_key(ecode)
            # 2 means ESC: it saved, and the window closes. That is what every
            # other window means by "exit", and it is the whole difference from
            # "press any key" - there is nothing to press a key to get out of.
            if ek == 2 {
                # A user gesture - ESC in the editor is 'exit', which is exactly
                # what the closebox means. wm_close_fx() is wm_close plus the
                # ANIM_CLOSE shrink; wm_close() stays for teardown.
                wm_close_fx(win)
                edit_win = 0 - 1
                # Return to the window that launched the editor. Generic close
                # chooses the next z-order entry, which can be Paint or another
                # app; serial commands would then be routed into that app and
                # disappear even though the shell prompt is still visible.
                if edit_prev_focus >= 0 {
                    if wm_open_p(edit_prev_focus) == 1 {
                        wm_setfocus(edit_prev_focus)
                        wm_raise(edit_prev_focus)
                    }
                }
                edit_prev_focus = 0 - 1
                return 1
            }
            if ek == 1 { wm_dmg(win)  return 1 }
        }
        return 0
    }
    if id == APP_PAINT {
        if ety == 3 { if paint_key(ecode) == 1 { wm_dmg(win)  return 1 } }
        # EV_MOUSE (4) carries the position and the button mask. Painting on
        # the EVENT rather than polling in app_tick is what makes a stroke
        # follow the pointer through wm.c's grab, which keeps delivering to
        # this window even when the hand outruns the frame.
        if ety == 4 {
            if band(ecode, 1) != 0 {
                if paint_dab(ex - wm_cx(win), ey - wm_cy(win)) == 1 { wm_dmg(win) }
                return 1
            }
        }
        return 0
    }
    return 0
}

# WHERE A WINDOW IS, on the serial log. A pointer gate has to aim at a title
# bar, and every alternative is worse: hardcoding coordinates gave probe-drag.py
# a default that was off the right edge of a 1920-wide screen and made it report
# "dragging is a no-op" for a drag that worked, and recomputing this layout in
# Python would go stale the first time the look track moves a window.
#
# Printed when the session starts AND whenever a window opens afterwards, so a
# window that did not exist at boot still says where it is.
fn wm_report(w) {
    put("  wm: win ")  put(w)  put(" title ")
    put(wm_cx(w))  put(",")  put(wm_cy(w) - TITLE_H * ui())  put(" ")
    put(wm_cw(w))  put("x")  put(TITLE_H * ui())
    put(" client ")
    put(wm_cx(w))  put(",")  put(wm_cy(w))  put(" ")
    put(wm_cw(w))  put("x")  print(wm_ch(w))
    return 0
}

# Open an app in its own window, or focus the one already open. Returns 1 if
# this command was an app, 0 if the shell should run it as a command.
#
# THE APPS TILE rather than cascade. A cascade is the usual desktop default and
# it is wrong here for a reason worth keeping: every one of these windows shows
# something MOVING, and stacked on top of each other four of the five are
# invisible - which is also how probe-apps.py first measured 0.00% change for
# three apps that were running perfectly. Two rows of 200x160 design units clear
# each other at every UI scale, and all of them stay left of the System
# Monitor column at 1342 px so nothing opens underneath it.
#
# Snake gets the widest tile because it is the one app whose window size is
# GAMEPLAY: the board is the client area divided by SNAKE_CELL, so a narrow
# tile is a short game. At 200 design units it was 24 cells across and the
# snake reached the wall 0.84 s after opening, every time, before a player
# could react. 280 units and a 100 ms step make that ~1.7 s.
#
# OPENING DOES NOT STEAL FOCUS, and that is a decision rather than an omission.
# A new window taking focus is normal on a desktop you drive with a mouse; here
# the shell is the ONLY launcher, so handing focus to the app you just started
# means you cannot type the next command without clicking your way back. It
# also made launching two apps in a row impossible - the second command was
# typed into the first app, which dropped it. Asking for an app that is already
# open DOES focus and raise it, because that is the only way to get to it from
# the keyboard, and Alt+Tab cycles the rest.
fn open_app(cmd, arg) {
    oa_u = ui()
    # WHO HAD FOCUS BEFORE. wm_open() focuses the window it just opened
    # (wm.c: focus_win = i), so simply not calling wm_focus here is not enough
    # - the focus still moves. Put it back explicitly, or the second command
    # you type goes to the app you started with the first one and is dropped.
    oa_f = wm_focus()
    if cmd == 103 {
        if snake_win >= 0 { if wm_open_p(snake_win) == 1 {
                wm_setfocus(snake_win)  wm_raise(snake_win)  return 1
        }}
        snake_win = wm_open(APP_SNAKE, "Snake", 120 * oa_u, 70 * oa_u, 420 * oa_u, 360 * oa_u)
        if snake_win < 0 { return 0 }
        sn_reset(wm_cw(snake_win), wm_ch(snake_win))
        if oa_f >= 0 { wm_setfocus(oa_f) }
        wm_report(snake_win)
        return 1
    }
    if cmd == 100 {
        if paint_win >= 0 { if wm_open_p(paint_win) == 1 {
                wm_setfocus(paint_win)  wm_raise(paint_win)  return 1
        }}
        paint_win = wm_open(APP_PAINT, "Paint", 20 * oa_u, 230 * oa_u, 280 * oa_u, 160 * oa_u)
        if paint_win < 0 { return 0 }
        if oa_f >= 0 { wm_setfocus(oa_f) }
        wm_report(paint_win)
        return 1
    }
    if cmd == 118 {
        if cube_win >= 0 { if wm_open_p(cube_win) == 1 {
                wm_setfocus(cube_win)  wm_raise(cube_win)  return 1
        }}
        cube_win = wm_open(APP_CUBE, "3D", 310 * oa_u, 60 * oa_u, 160 * oa_u, 160 * oa_u)
        if cube_win < 0 { return 0 }
        if oa_f >= 0 { wm_setfocus(oa_f) }
        wm_report(cube_win)
        return 1
    }
    if cmd == 97 {
        if anim_win >= 0 { if wm_open_p(anim_win) == 1 {
                wm_setfocus(anim_win)  wm_raise(anim_win)  return 1
        }}
        anim_win = wm_open(APP_ANIM, "zlOS", 480 * oa_u, 60 * oa_u, 160 * oa_u, 160 * oa_u)
        if anim_win < 0 { return 0 }
        if oa_f >= 0 { wm_setfocus(oa_f) }
        wm_report(anim_win)
        return 1
    }
    if cmd == 105 {
        if edit_win >= 0 { if wm_open_p(edit_win) == 1 {
                edit_prev_focus = oa_f
                wm_setfocus(edit_win)  wm_raise(edit_win)  return 1
        }}
        if editor_open_default() == 0 {
            note_say("no zlfs volume for /user/notes.txt", 400)
            return 0
        }
        edit_win = wm_open(APP_EDIT, "Text Editor", 322 * oa_u, 140 * oa_u, 522 * oa_u, 360 * oa_u)
        if edit_win < 0 { return 0 }
        # THE EDITOR TAKES FOCUS, unlike every other app here, because it is the
        # only one that is useless without the keyboard. Opening Snake and
        # carrying on typing commands is reasonable; opening an editor and
        # having your typing go to the shell is not.
        edit_prev_focus = oa_f
        wm_setfocus(edit_win)
        wm_report(edit_win)
        return 1
    }
    if cmd == 77 {
        if files_win >= 0 { if wm_open_p(files_win) == 1 {
                wm_setfocus(files_win)  wm_raise(files_win)  return 1
        }}
        files_win = wm_open(APP_FILES, "Files", desk_x(FILES_X), desk_y(FILES_Y), FILES_W * oa_u, FILES_H * oa_u)
        if files_win < 0 { return 0 }
        files_refresh()
        wm_setfocus(files_win)
        wm_report(files_win)
        return 1
    }
    if cmd == 120 {
        if mouse_win >= 0 { if wm_open_p(mouse_win) == 1 {
                wm_setfocus(mouse_win)  wm_raise(mouse_win)  return 1
        }}
        mouse_win = wm_open(APP_MOUSE, "Pointer", 310 * oa_u, 230 * oa_u, 160 * oa_u, 160 * oa_u)
        if mouse_win < 0 { return 0 }
        if oa_f >= 0 { wm_setfocus(oa_f) }
        wm_report(mouse_win)
        return 1
    }
    return 0
}

fn open_disk_editor(slot) {
    if edit_win >= 0 { if wm_open_p(edit_win) == 1 {
            note_say("close the current editor first", 300)
            wm_setfocus(edit_win)
            wm_raise(edit_win)
            return 0
    }}
    if editor_open_disk(slot) == 0 {
        note_say("file is missing or too large", 320)
        return 0
    }
    ode_u = ui()
    edit_prev_focus = wm_focus()
    edit_win = wm_open(APP_EDIT, "Text Editor", 322 * ode_u, 140 * ode_u, 522 * ode_u, 360 * ode_u)
    if edit_win < 0 { return 0 }
    wm_setfocus(edit_win)
    wm_report(edit_win)
    return 1
}

# Runs every frame, must be cheap, MUST NOT DRAW. Returning 1 means "my state
# changed, repaint me" - which is how the monitor's clock advances without
# owning the frame, and is the whole reason it needs no while-loop.
last_tick_sec = 0 - 1
# ---- FRAME TIME ------------------------------------------------------------
# Measured in wm.c, not here, and that distinction cost a wrong answer once.
# The first version timed the gap between app_tick calls. At the time wm_frame
# was PIT-gated, so that gap was pinned at 10 ms by construction. It reported
# a confident, stable 9997 us: the PIT frequency wearing a frame timer's clothes.
#
# wm_us() times the BODY of a frame - input, routing, ticks, repaint,
# present - and only over frames that actually repainted. That is the figure
# comparable to hosttest/fbbench.c, which times the same drawing with no
# compositor around it.
# The shell window repaints after anything is typed or printed into it.
shell_win = 0 - 1
# Is a compositor session already running? It matters now that the compositor
# is the BOOT STATE rather than something 'w' launches: `windows` is still in
# term.c's command table and still dispatches to wm_session, so typing it into
# the shell inside a session would re-enter, call wm_init() - which clears the
# whole window table, including the shell you typed into - and then run a
# second frame loop nested inside the first.
# wm_live WAS HERE, AND IT WAS NEVER READ. One mention in the whole tree: its
# own declaration. The paragraph above describes a real re-entrancy hazard and
# sat directly on top of it, which reads as "this variable is the guard".
#
# IT IS NOT, AND THE HAZARD IS COVERED ANYWAY. wm_session's first line is
# `if wm_run() == 1 { "the compositor is already the desktop - you are in it"
# return 0 }` at :13943. That is the guard. Checked before deleting, because a
# variable that looks like a guard and a guard that exists elsewhere are two
# different findings and only one of them is a bug.
# EVERY OPEN WINDOW, which is what the theme sites actually need.
#
# wm_damage_win_all damages the SHELL and nothing else - four of its callers
# genuinely mean that, so widening it would repaint every window on every shell
# newline. But five call sites use it after a THEME change (the knockout
# toggle, the focus-bar slider, the `k` key, `[` and `]`, and the palette's
# knockout row), and ui.c is explicit that a theme change invalidates every
# cached window surface in the system and that its own layer does not know
# about surfaces. Those five left every window but the shell showing the old
# ladder until something else happened to dirty it.
fn wm_damage_theme() {
    wdt_i = 0
    while wdt_i < wm_n() {
        wm_dmg(wm_zat(wdt_i))
        wdt_i = wdt_i + 1
    }
    wm_damage(0, 0, px_w(), px_h())
    return 0
}

fn wm_damage_win_all() {
    if shell_win >= 0 { wm_dmg(shell_win) }
    return 0
}

# Printable input changes only the live prompt row. Keep the rest of the
# terminal's retained surface intact instead of rasterising every visible
# scrollback glyph for every key press.
fn wm_damage_shell_input() {
    if shell_win < 0 { return 0 }
    u = ui()
    py = wm_ch(shell_win) - 6 * u - cell_h()
    if py < 0 { py = 0 }
    wm_cdmg(shell_win, 0, py, wm_cw(shell_win), cell_h())
    return 0
}

# THE ONE APP THAT CAN REFUSE TO CLOSE.
#
# wm.c consults this from the close box and from Ctrl+W. Returning 0 keeps the
# window open. Before this existed there was no close hook in the OS at all,
# and clicking the close box on an editor whose footer read UNSAVED threw the
# buffer away without a word - the next open re-read the file from disk.
#
# Refusing is the cheap honest answer. A confirm dialog would need a modal this
# compositor does not have, and saving silently on close is the behaviour that
# just got deleted from ESC one function up: writing a file the user did not
# ask to write is not a safe default, it is the same fault pointed the other
# way. So the window stays, and the toast says which key resolves it.
# THE REFUSAL NEEDED A WAY OUT, and the first version did not have one.
#
# Refusing to close a dirty buffer is right. But ESC returns 1 rather than
# closing when editor_save() fails, and ed_dirty is only cleared by a
# SUCCESSFUL save or by opening a file - which cannot happen while this window
# is up, because open_disk_editor refuses and run_command raises the existing
# window instead. So on a volume where alloc_run cannot find a contiguous run,
# the editor became a window with no exit at all: ESC would not close it,
# Ctrl+W would not, the close box would not.
#
# Trading silent data loss for an unclosable window is not a fix, it is a
# different bug with better manners.
#
# The second close in a row discards. The first says what is unsaved and how to
# save it; the second is an explicit instruction from someone who has just been
# told, which is the same shape the Files pane's format already uses ("twice to
# confirm"). Arming clears the moment anything else resolves the state, so a
# refusal from ten minutes ago cannot silently authorise a discard now.
fn app_can_close(win) {
    if win == edit_win {
        if ed_dirty == 1 {
            if ed_discard_armed == 1 {
                ed_discard_armed = 0
                ed_dirty = 0
                note_say2("closed without saving", "the edits are gone - the file on disk is unchanged", 900)
                return 1
            }
            ed_discard_armed = 1
            note_say2("unsaved changes", "ESC saves and closes - close again to discard", 900)
            return 0
        }
    }
    return 1
}

fn app_tick(id, win) {
    # id == -1 IS THE DESK, not an app. wm.c calls this once per composite
    # before it walks the z-order, so everything that belongs to the DESKTOP
    # rather than to a window is clocked here - and goes on being clocked when
    # every window is closed or minimised.
    #
    # These two used to sit in the per-window body below, which meant they ran
    # once per open window per frame (wasteful but harmless, since both guard
    # themselves) and ZERO times per frame when the desk was empty (not
    # harmless at all). The raster ring stopped sampling while wm_painted()
    # kept counting, so the plot and the ADVANCE figure printed beside it drifted
    # apart by exactly the frames composited with nothing open - and the comment
    # here asserted they "cannot drift". They could, and the way to see it was
    # to close everything and watch.
    #
    # raster_tick is a history of COMPOSITES. It replaces dock_dot_tick(), whose
    # job was the pulsing running-app dot; PRESSWORK has no pulse anywhere -
    # ZD_PULSE_FLOOR is 255, design.h deleting the infinite pulse rather than
    # merely not using it. A register mark that breathes is decoration on a
    # control, and the mark is a reading.
    #
    # rail_clock_tick is the wall clock's one sample per second. It draws
    # nothing; it asks for the clock block back when the minute rolls.
    if id < 0 {
        wake_tick()
        raster_tick()
        sm_run_tick()
        rail_clock_tick()
        rail_stat_tick()
        foot_tick()
        return 0
    }
    if id == APP_SNAKE { return sn_step() }
    # The browser drives its own fetch from the frame loop. app_tick MUST NOT
    # DRAW and must be cheap; br_tick pumps the link, the TCP timers and the
    # HTTP state machine, and returns 1 only when something actually changed.
    if id == APP_BROWSER { return br_tick() }
    if id == APP_MONITOR {
        tsec = idiv(ticks(), 100)   # `/` would do; see the idiv note at the top
        if tsec != last_tick_sec {
            last_tick_sec = tsec
            # ...and the two live readouts that are furniture rather than a
            # window: the foot's slug and the rail's stat block and clock.
            #
            # THE RECTANGLE IS THE WHOLE BAND, and that is the correction the
            # old version of this comment was written about the hard way. It
            # used to invalidate a hand-counted strip inside the tray, starting
            # 170 units right of where the row it was invalidating began, so a
            # number that SHRANK kept the head of its previous value on screen
            # for ever - the `)08` debris in docs/archive/prompts/POINTER-PROMPT.md 1b.
            #
            # A band is cheap to invalidate whole and a hand-counted sub-strip
            # is not cheap to get right, so both of these are the band. The foot
            # is 46 dp of a 2560-wide screen and the rail's bottom block is 170
            # wide; between them that is about a twelfth of what the old dock
            # strip cost, so there is nothing to buy back by being clever.
            # THE RULE IS INSIDE THE FOOT NOW, so the damage band is the foot
            # and nothing above it - see field_y's border-box note.
            wm_damage(rail_w(), foot_y(), px_w() - rail_w(), foot_h())
            wm_damage(0, px_h() - rail_bot_h(), rail_w(), rail_bot_h())
            return 1
        }
    }
    # THE WHOLE POINT OF app_tick. Snake advances here, draws nothing, and
    # returns 1 to ask for a repaint - so it keeps playing while another window
    # is being dragged over it, which is the assertion probe-snake.py makes.
    # (apps-in-windows had a second APP_SNAKE arm here calling its own
    #  snake_step(); this tree runs overnight-compositor's sn_step above,
    #  which returns first, so it was unreachable.)
    if id == APP_CUBE  { return cube_tick() }
    if id == APP_ANIM  { return anim_tick(wm_cw(win), wm_ch(win)) }
    if id == APP_MOUSE { return mouse_tick() }
    if id >= REG_FIRST { return reg_tick(id, win) }
    return 0
}

# The wallpaper pass: furniture, drawn before any window, never in the z-order.
# It may ignore the damage rectangle it is given - the scissor is already set to
# it, so nothing outside can reach the screen. Using it would be the
# optimisation; correctness does not depend on it.
# DESK_DRAW IS CALLED ONCE PER DAMAGE RECTANGLE, up to eight times a frame, and
# forgetting that is what made the desktop slow.
#
# The wallpaper was fine: wall_paint takes the rectangle and blits only that.
# The header and the dock were not. Both redrew IN FULL every call, and the
# dock had just become the most expensive thing on screen - a cached-blur blit
# plus a full-width translucent tint over a 1920x128 strip. Measured from
# fbbench's own numbers: 245,760 px at 1.54 cyc/px to blit the blur and 22.16
# cyc/px to tint it, which is 5.8M cycles, about 2.5 ms. Eight damage
# rectangles is 20 ms of dock alone, against a 16.67 ms budget - and seven of
# those eight rectangles usually do not touch the dock at all.
#
# So the furniture is drawn only when the rectangle it is being asked about
# actually overlaps it. That is not an optimisation of the drawing; it is
# noticing that desk_draw was handed a rectangle and ignored it.
# ==== THE OVERLAY LAYER =======================================================
# The prototype has five surfaces that live above the whole desktop rather than
# inside a window: activities, the command palette, the context and window
# menus, and the lock sheet. None of them is a window, and that is the point -
# a window would appear in the register, take focus, and be listed by the very
# thing it is drawn over.
#
# wm.c gained one hook for them (wm_overlay), called after every window AND
# after the toast, inside the same damage rectangle. Last in, last drawn: a
# modal a toast can cover is not modal.
OV_NONE   = 0
OV_PALETTE = 1
OV_ACTIVITIES = 2
OV_MENU   = 3
OV_LOCK   = 4
ov_mode = 0
ov_sel  = 0                        # the highlighted row, per surface

# THE SCRIM IS A SHADE, NOT A FILL. `shade` reads each pixel back and scales
# it, so what is under the modal stays legible as shape while losing its claim
# on attention. A flat fill at any alpha would need the blend this drawing path
# does not have, and a solid panel would say "the desktop is gone" rather than
# "the desktop is behind this".
#
# THE PROTOTYPE'S OWN SCRIM, which is a mix and not a darkening:
#
#   #palette .scrim { background: color-mix(in srgb, var(--zd-cut) 78%, transparent); }
#
# 78 parts ZD_CUT to 22 parts of what is underneath. Written as 78/100 rather
# than rounded to an eighth because there is no reason to round: mix() takes
# num/den and the arithmetic is integer either way.
OV_SCRIM_NUM = 78
OV_SCRIM_DEN = 100

# The overview is an opaque panel over the FIELD - not a scrim, and not over the
# whole screen. The rail, the raster strip and the foot are not dimmed by it.
fn ov_field_panel(cx0, cy0, cx1, cy1) {
    fx0 = field_x()
    fy0 = field_y()
    if cx0 > fx0 { fx0 = cx0 }
    if cy0 > fy0 { fy0 = cy0 }
    fx1 = cx1
    fy1 = cy1
    if fx1 > field_x() + field_w() { fx1 = field_x() + field_w() }
    if fy1 > field_y() + field_h() { fy1 = field_y() + field_h() }
    if fx1 > fx0 { if fy1 > fy0 { fill_rgb(fx0, fy0, fx1 - fx0, fy1 - fy0, theme(TH_BG)) } }
    return 0
}

fn ov_active() { if ov_mode == OV_NONE { return 0 }  return 1 }

# THE SHEET a modal sits on: centred, bounded, and never wider than its measure.
# 580, not 520. presswork-prototype.html: #palette .sheet { width: calc(580px
# * var(--ui)) }. At 520 the right-flushed kind column and the row text had
# 60 dp less room than the design allows for, which is most of a word.
OV_SHEET_W = 580                   # design units, the prototype's .sheet
OV_SHEET_MAXH = 420
fn ov_sheet_x() { return (px_w() - OV_SHEET_W * ui()) / 2 }
fn ov_sheet_y() { return (px_h() - OV_SHEET_MAXH * ui()) / 3 }

# ---- the command palette -----------------------------------------------------
# The prototype's CMDS table is fourteen rows of `label, kind, target`. This is
# the same list, and the kinds are the prototype's own words.
OV_PAL_N = 16
# ALL SIXTEEN, IN THE PROTOTYPE'S OWN ORDER. This held ten and dropped six -
# the whole `design` kind, which ov_pal_kind had no case for either, plus two
# shell rows. A palette that silently omits a third of its commands is a
# shorter palette, not a smaller one: there is no way to tell from the screen
# that the missing rows exist.
fn ov_pal_label(i) {
    if i == 0 { return "open 03 monitor" }
    if i == 1 { return "open 02 files" }
    if i == 2 { return "open 11 settings" }
    if i == 3 { return "open 05 kernel log" }
    if i == 4 { return "open 13 registers" }
    if i == 5 { return "regdump cpuid apic" }
    if i == 6 { return "zlfs fsck rd0" }
    if i == 7 { return "dmesg --level warn" }
    if i == 8 { return "modeset 1600x1000" }
    if i == 9 { return "tile onto the module" }
    if i == 10 { return "workspace 02" }
    if i == 11 { return "lock session" }
    if i == 12 { return "toggle the knockout" }
    if i == 13 { return "toggle occlusion edge" }
    if i == 14 { return "toggle desk grid" }
    return "swap to raking ladder"
}
fn ov_pal_kind(i) {
    if i < 5 { return "window" }
    if i < 9 { return "shell" }
    if i < 11 { return "wm" }
    if i < 12 { return "session" }
    return "design"
}
# WHAT EACH ROW ACTUALLY DOES. A palette whose rows are labels and nothing else
# is a picture of a palette - the same distinction probe-dock.py draws about the
# dock, and the reason this returns an app id rather than a string.
# WHICH APP A ROW OPENS, or -1 for a row that is not an open. The comment this
# function was written under says a palette whose rows are labels and nothing
# else "is a picture of a palette", which is the reason it returns an app id
# rather than a string - and then it was never called by anything. Enter calls
# it now. Row 4 is "open 13 registers", which is the registers pane, not
# sysinfo: 32 was the id this listed before the register was renumbered.
fn ov_pal_app(i) {
    if i == 0 { return APP_MONITOR }
    if i == 1 { return APP_FILES }
    if i == 2 { return APP_SETTINGS }
    if i == 3 { return 40 }
    if i == 4 { return 32 }
    return 0 - 1
}

# What Enter does on the selected row. Only the five window rows and the two
# that name a thing this kernel can actually do are wired; the rest report that
# they are not, rather than appearing to work. A palette row that swallows
# Enter silently is worse than one that says no.
# TAKES THE VISIBLE INDEX. Everything above hands one of these around - the
# selection, the click, the keyboard - and this is the single place it becomes
# a real row, so a filtered list cannot run the row above the one chosen.
fn ov_pal_run(k) {
    i = ov_pal_nth(k)
    if i < 0 { return 1 }
    pa = ov_pal_app(i)
    if pa >= 0 { ov_mode = OV_NONE  wm_damage(0, 0, px_w(), px_h())  return reg_open(pa) }
    if i == 6 { ov_mode = OV_NONE  wm_damage(0, 0, px_w(), px_h())  return run_command(46, 0) }
    if i == 11 { ov_mode = OV_LOCK  ov_sel = 0  wm_damage(0, 0, px_w(), px_h())  return 1 }
    # SIX ROWS REFUSED WORK THIS KERNEL ALREADY DOES, four hundred lines from
    # the code that does it. `tile onto the module`, `workspace 02`,
    # `toggle the knockout` and `toggle desk grid` are all wired in ov_ctx_run
    # for the FIELD MENU - the same four actions, named the same way, reachable
    # by right-clicking the desk - and the palette answered them with "this
    # machine cannot do yet", which was simply false.
    #
    # Routed to the same functions the menu uses rather than reimplemented, so
    # the two surfaces cannot drift into disagreeing about what the action is.
    if i == 5  { ov_close_overlay()  return run_command(216, 0) }
    if i == 9  { ov_close_overlay()  return desk_tile() }
    if i == 10 { ov_close_overlay()  return ws_hotkey(2) }
    if i == 12 {
        ov_close_overlay()
        ui_knock(1 - ui_knock_on())
        if ui_knock_on() == 1 { note_say2("knockout on", "the focused header inverts, and it is the only focus signal", 800) } else { note_say2("knockout off", "fallback is the wash ramp - sit back and find the focused plate", 800) }
        wm_damage_theme()
        return 1
    }
    if i == 13 {
        ov_close_overlay()
        ui_over(1 - ui_over_on())
        if ui_over_on() == 1 { note_say2("occlusion edge on", "a plate over another gets the lighter ring", 800) } else { note_say2("occlusion edge off", "every plate takes the plain ZD_CUT ring", 800) }
        wm_damage_theme()
        return 1
    }
    if i == 14 {
        ov_close_overlay()
        desk_grid_on = 1 - desk_grid_on
        rebake_wallpaper()
        wm_damage(0, 0, px_w(), px_h())
        if desk_grid_on == 1 { note_say2("desk grid on", "12 x 8 module, ruled to the field margin", 800) } else { note_say2("desk grid off", "crop marks and the slug stay - they have their own switches now", 800) }
        return 1
    }
    # THREE OF THE FOUR ROWS THIS COMMENT CALLED IMPOSSIBLE WERE REACHABLE.
    #
    # It said: "rows 7, 8, 13 and 15 name a dmesg filter, a modeset, an
    # occlusion-edge switch and a second ladder, none of which this kernel
    # has." Checked, one at a time, rather than believed:
    #
    #   7   kl_filter EXISTED and kl_shown READ it, which is exactly what made
    #       it look reachable - and it was not. See the arm below: the whole
    #       chain under it was dead, and this row was wired into it before that
    #       was checked. A reader is not a route.
    #   13  ui_over / ui_over_on are bound and the BOUNDARY tab already toggles
    #       them. The switch was not missing; this row just did not call it.
    #   15  the surface ladder now has a control, and its honest answer is that
    #       the second ladder is out of scope - so the row can give the same
    #       answer instead of a generic one.
    #   8   modeset IS genuinely absent, and is the only one left.
    #
    # A WRONG "not supported" IS NEVER TESTED, because nobody tries what they
    # have been told is missing. That is what kept three of these dark.
    # ROW 7 WAS WIRED TO A DEAD ISLAND, BY ME, IN THE COMMIT THAT CELEBRATED
    # FINDING ONE.
    #
    # kl_filter existed and kl_shown READ it, which is what made it look
    # reachable. But kl_shown was called only by kl_count, kl_count was called
    # by nothing, and kl_kind - the classifier under all of it - keyed off the
    # ROW INDEX of the fourteen fixed rows the pane stopped drawing when it was
    # rewritten to read term.c's real ring. Nine functions, every caller of
    # each one itself dead. Setting kl_filter changed nothing on screen.
    #
    # AND THERE IS NOTHING TO FILTER BY. This kernel's console has exactly two
    # level emitters, ok_line and info_line at kernel.zl:3261-3272; there is no
    # WARN and no ERROR anywhere in it. A `--level warn` over a log with no warn
    # level shows an empty pane whatever the filter does.
    #
    # So the row says the real reason. Giving the console a warn level - and
    # tagging the sites that already report a degraded condition in prose, "no
    # xHCI", "no NVMe", "no LPSS" - is the fix, and it is a change to the
    # kernel's printing rather than to this row. It is in
    # docs/design/PRESSWORK-BACKLOG.md.
    if i == 7 {
        ov_close_overlay()
        if wm_run() == 1 { reg_open(APP_KLOG) }
        note_say2("this log has no levels to filter", "ok_line and info_line are the only two emitters - there is no warn or error record to keep", 1400)
        wm_damage(0, 0, px_w(), px_h())
        return 1
    }
    if i == 13 {
        ov_close_overlay()
        ui_over(1 - ui_over_on())
        if ui_over_on() == 1 { note_say2("occlusion edge on", "a plate over another gets the lighter ring", 800) } else { note_say2("occlusion edge off", "every plate takes the plain ZD_CUT ring", 800) }
        wm_damage_theme()
        return 1
    }
    if i == 15 {
        ov_close_overlay()
        return seg_pick(SEG_LADDER, 1)
    }
    # Row 8, and only row 8. modeset is a mode change this kernel does not
    # expose, and naming the one that is really absent is worth more than a
    # sentence that covered four and was right about one.
    note_say2("modeset is not exposed", "the display mode is settled at boot and there is no setter", 700)
    return 1
}

fn ov_draw_palette(u) {
    sx = ov_sheet_x()
    sy = ov_sheet_y()
    sw = OV_SHEET_W * u
    rowh = 22 * u
    sh = ov_pal_sheet_h()
    # the plate, its struck top edge and its cut groove - the same depth the
    # rest of the system uses, because a modal is a plate like any other
    fill_rgb(sx, sy, sw, sh, theme(TH_PANEL))
    fill_rgb(sx, sy, sw, 1, theme(TH_LIT))
    fill_rgb(sx, sy + sh - 1, sw, 1, theme(TH_CUT))
    # the header: "COMMAND  zlsh builtin        N of M"
    ui_caps(sx + 13 * u, sy + 9 * u, "COMMAND", theme(TH_TEXT_2), T_CAPTION)
    label(sx + 92 * u, sy + 9 * u, "zlsh builtin", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(sx + sw - 52 * u, sy + 9 * u, ov_pal_nvis(), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label(sx + sw - 34 * u, sy + 9 * u, "of", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(sx + sw - 20 * u, sy + 9 * u, OV_PAL_N, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    fill_rgb(sx, sy + 26 * u, sw, 1, theme(TH_CUT))
    # the input line: "RUN" and a caret. There is no typed query yet - the row
    # list is the whole surface - and a fake one would be a picture of an input.
    ui_caps(sx + 13 * u, sy + 34 * u, "RUN", theme(TH_TEXT_2), T_CAPTION)
    # THE QUERY, drawn a byte at a time - there is no string to hand to a text
    # call, only the buffer the keystrokes went into. The caret follows it,
    # which is the difference between an input and a picture of one.
    pqx = sx + 52 * u
    pqi = 0
    while pqi < pal_qlen {
        char_aa(pqx, sy + 33 * u, peek8(PAL_QUERY + pqi), theme(TH_TEXT_HI))
        pqx = pqx + cell_w()
        pqi = pqi + 1
    }
    fill_rgb(pqx, sy + 33 * u, 2 * u, cell_h(), theme(TH_ACCENT))
    fill_rgb(sx, sy + 54 * u, sw, 1, theme(TH_CUT))
    # the rows
    # THE LOOP WALKS WHAT SURVIVES THE QUERY, and pk is the visible position
    # while pi is the real row. Everything that identifies the row - its number,
    # its label, its kind, its dispatch - uses pi; everything that places it uses
    # pk. Mixing those is how a filtered list runs the row above the one clicked.
    pk = 0
    pvis = ov_pal_nvis()
    # A QUERY THAT MATCHES NOTHING SAYS SO. Without this the sheet shrinks to a
    # header, an input line and a blank strip, which reads as the palette having
    # broken rather than as the query having found nothing. The row list IS the
    # answer here, so an empty list needs a sentence.
    if pvis < 1 {
        # label(), not ui_txt(). Every other string on this sheet is drawn with
        # label/ui_caps, which are ungated; ui_txt checks ui_mode_get() and
        # draws nothing while the toolkit is left in hit-test mode - which
        # menu_event does on any start-menu click and never restores. This one
        # line would have vanished for the rest of the session after one such
        # click, and only this one, which is the hardest kind of missing.
        label(sx + 38 * u, sy + 66 * u, "no command matches", theme(TH_TEXT_DIM), T_BODY, W_REG)
    }
    while pk < pvis {
        pi = ov_pal_nth(pk)
        ry = sy + 62 * u + pk * rowh
        # THE SELECTED ROW IS A VALUE FLIP, NOT A COLOURED EDGE, and the mark
        # on it cannot be the overprint.
        #
        # This drew ZD_RAISE with a vermilion bar. On ZD_RAISE that bar is a
        # perfectly good 3.7150:1 - which is exactly why it survived review.
        # The prototype's selected row is the KNOCKOUT, and vermilion on the
        # knockout measures 1.3989:1: the mark would be there and invisible.
        # So the prototype marks it with ZD_KO_EDGE, the knockout's own edge
        # run, and that is the pair that has to move together. Changing the
        # ground without changing the mark is the version of this that looks
        # right in a screenshot and fails at arm's length.
        pnum = theme(TH_TEXT_DIM)
        ptxt = theme(TH_TEXT_HI)
        pkind = theme(TH_TEXT_2)
        if pk == ov_sel {
            fill_rgb(sx, ry, sw, rowh, theme(TH_KNOCK))
            fill_rgb(sx, ry, focus_bar(), rowh, theme(TH_KO_EDGE))
            pnum = theme(TH_KNOCK_INK2)
            ptxt = theme(TH_KNOCK_INK)
            pkind = theme(TH_KNOCK_INK2)
        }
        label_num(sx + 13 * u, ry + 4 * u, pi + 1, pnum, T_CAPTION, W_REG)
        label(sx + 38 * u, ry + 4 * u, ov_pal_label(pi), ptxt, T_BODY, W_REG)
        ui_caps(sx + sw - 76 * u, ry + 5 * u, ov_pal_kind(pi), pkind, T_CAPTION)
        pk = pk + 1
    }
    # the footer, the prototype's three key hints
    # THE FOOTER FOLLOWS THE SHEET. This was placed at a fixed sixteen rows,
    # which was right when the list was always sixteen; with the filter it
    # floated on the scrim below a shrunken sheet - up to three hundred dp away
    # from the plate it belongs to.
    fy = sy + ov_pal_sheet_h() - 18 * u
    fill_rgb(sx, fy, sw, 1, theme(TH_CUT))
    ui_caps(sx + 13 * u, fy + 7 * u, "ENTER", theme(TH_TEXT_2), T_CAPTION)
    label(sx + 58 * u, fy + 7 * u, "run", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ui_caps(sx + 96 * u, fy + 7 * u, "UP DOWN", theme(TH_TEXT_2), T_CAPTION)
    label(sx + 158 * u, fy + 7 * u, "select", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ui_caps(sx + 208 * u, fy + 7 * u, "ESC", theme(TH_TEXT_2), T_CAPTION)
    label(sx + 240 * u, fy + 7 * u, "dismiss", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    return 0
}

# ---- the two menus -----------------------------------------------------------
# The prototype's ctxmenu and winmenu, item for item. showMenu takes
# `[label, action, arg, disabled, shortcut]`, so each row here is a label, a
# right-aligned shortcut, and whether it is a separator or disabled.
#
# THE SHORTCUT COLUMN IS NOT DECORATION. Every one of these keys exists: f1 and
# ctrl+k open the two modals below, ctrl+g and the knockout toggle are already
# wired at ecode 107, and alt+1/alt+2 are the workspace switch. A menu that
# lists a key the system does not answer is a picture of a menu.
OV_MENU_FIELD = 0                  # the desk was right-clicked
OV_MENU_WIN   = 1                  # a window was
ov_menu_kind = 0
ov_menu_x = 0
ov_menu_y = 0
ov_menu_win = 0 - 1

OV_CTX_N = 12
fn ov_ctx_label(i) {
    if i == 0 { return "activities" }
    if i == 1 { return "command palette" }
    if i == 2 { return "-" }
    if i == 3 { return "tile onto the module" }
    if i == 4 { return "toggle desk grid" }
    if i == 5 { return "toggle the knockout" }
    if i == 6 { return "-" }
    if i == 7 { return "workspace 01" }
    if i == 8 { return "workspace 02" }
    if i == 9 { return "-" }
    # "open 11 settings" WAS MISSING. The prototype's ctxmenu has twelve
    # entries and this had eleven - the row between the third separator and
    # lock session. A menu one row short is not a shorter menu; nothing on
    # screen says the row exists.
    if i == 10 { return "open 11 settings" }
    return "lock session"
}
# SEPARATORS AND SHORTCUTS ARE ANSWERED BY NUMBER, not by comparing text.
# zl's kernel subset has string LITERALS but no string VALUES - a literal can be
# passed to a native that takes a const char*, and that is all. `label == "-"`
# cannot work, and the first version of this menu was written that way: the
# scrim appeared and not one row did, because every row test was false.
fn ov_ctx_sep(i) {
    if i == 2 { return 1 }
    if i == 6 { return 1 }
    if i == 9 { return 1 }
    return 0
}
fn ov_ctx_haskey(i) {
    if i == 0 { return 1 }
    if i == 1 { return 1 }
    if i == 4 { return 1 }
    if i == 7 { return 1 }
    if i == 8 { return 1 }
    if i == 10 { return 1 }
    return 0
}
fn ov_ctx_key(i) {
    if i == 0 { return "F1" }
    if i == 1 { return "CTRL K" }
    if i == 4 { return "CTRL G" }
    if i == 7 { return "ALT 1" }
    if i == 8 { return "ALT 2" }
    if i == 10 { return "ALT 11" }
    if i == 11 { return "CTRL L" }
    return ""
}

OV_WIN_N = 9
fn ov_win_label(i) {
    if i == 0 { return "bring to front" }
    if i == 1 { return "minimise" }
    if i == 2 { return "maximise" }
    if i == 3 { return "-" }
    if i == 4 { return "tile onto the module" }
    # READ, like row 6 below it. The authority builds this as
    # `'this plate is ' + (isOver ? 'over another' : 'on the field')`, and the
    # chrome has asked the same question since the occluder was written - it
    # just had no way to say so from here. This row stated one of the two
    # answers for every window in every state, which is the exact fault fixed
    # one row down a few commits ago; they were adjacent and only one was seen.
    if i == 5 {
        if wm_over_p(ov_menu_win) == 1 { return "this plate is over another" }
        return "this plate is on the field"
    }
    # "header is knocked out / at rest" WAS MISSING ENTIRELY. It is the row
    # that names the focus signal this whole design is built on, and it is the
    # second of the two DISABLED rows whose value column carries a live ratio.
    # READ, not stated. The authority builds this row as
    # `'header is ' + (S.focus === id ? 'knocked out' : 'at rest')`, and
    # wm_focus() is bound and already read in four other places in this file.
    # This returned the same string for every window in every state - so the row
    # that names the focus signal the whole design is built on was the one row
    # that could not tell you whether the window had it.
    #
    # Two literals branched on an integer, which is how zl says this: there are
    # no string values to concatenate.
    if i == 6 {
        if wm_focus() == ov_menu_win { return "header is knocked out" }
        return "header is at rest"
    }
    if i == 7 { return "-" }
    return "close"
}
# ROW 7 IS THE SEPARATOR, NOT ROW 6. This flagged 3 and 6, but row 6 is
# "header is at rest" and row 7 is the "-". So the row that names the focus
# signal this whole design is built on was drawn as a hairline and never said
# anything, while the literal string "-" was drawn as a menu row underneath it.
# The labels and the flags were edited at different times and only the labels
# were renumbered.
fn ov_win_sep(i) {
    if i == 3 { return 1 }
    if i == 7 { return 1 }
    return 0
}
fn ov_win_haskey(i) {
    if i == 0 { return 1 }
    if i == 2 { return 1 }
    return 0
}
fn ov_win_key(i) {
    if i == 0 { return "CLICK" }
    # "travel 160" - the prototype names the motion the minimise takes, and
    # ZD_MS_TRAVEL is 160 in design.h, so this is a quoted constant and not a
    # measurement of anything this kernel timed.
    if i == 1 { return "TRAVEL 160" }
    if i == 2 { return "DOUBLE CLICK" }
    return ""
}
# Row 5 is DISABLED in the prototype - it states a fact about the plate rather
# than offering an action, and it is set at the caption rung to say so.
# Rows 5 AND 6 are the disabled pair - both are statements about the window
# rather than actions on it, and both carry a live ratio in the value column.
fn ov_win_dis(i) { if i == 5 { return 1 }  if i == 6 { return 1 }  return 0 }

# 214, the prototype's `.menu { min-width: calc(214px * var(--ui)) }`. It is a
# MINIMUM there and a fixed width here, which is a real divergence: the
# prototype's menu grows to its longest row and this one clips it.
OV_MENU_W = 214
fn ov_menu_rows() {
    if ov_menu_kind == OV_MENU_WIN { return OV_WIN_N }
    return OV_CTX_N
}
fn ov_menu_label(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_label(i) }
    return ov_ctx_label(i)
}
fn ov_menu_key(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_key(i) }
    return ov_ctx_key(i)
}
fn ov_menu_dis(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_dis(i) }
    return 0
}
fn ov_menu_sep(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_sep(i) }
    return ov_ctx_sep(i)
}
fn ov_menu_haskey(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_haskey(i) }
    return ov_ctx_haskey(i)
}

# THE MENU'S GEOMETRY, LIFTED OUT OF ITS DRAW so a hit test can ask for exactly
# the rectangle that was painted. It was computed inline, which is why no hit
# test existed: writing one meant copying four calculations, and a copied
# calculation is a second answer waiting to disagree with the first.
OV_MENU_ROWH = 20
OV_MENU_SEPH = 7
OV_MENU_HEADH = 20

fn ov_menu_h() {
    mhh = OV_MENU_HEADH * ui()
    mhi = 0
    while mhi < ov_menu_rows() {
        if ov_menu_sep(mhi) == 1 { mhh = mhh + OV_MENU_SEPH * ui() } else { mhh = mhh + OV_MENU_ROWH * ui() }
        mhi = mhi + 1
    }
    return mhh + 6 * ui()
}

# KEEP IT ON SCREEN. The prototype clamps to the desktop with an 8 px margin; a
# menu opened near the right or bottom edge otherwise draws off the panel and
# the rows nearest the pointer are the ones lost.
fn ov_menu_mx() {
    omx = ov_menu_x
    if omx + OV_MENU_W * ui() > px_w() - 8 * ui() { omx = px_w() - OV_MENU_W * ui() - 8 * ui() }
    if omx < 0 { omx = 0 }
    return omx
}
fn ov_menu_my() {
    omy = ov_menu_y
    if omy + ov_menu_h() > px_h() - 8 * ui() { omy = px_h() - ov_menu_h() - 8 * ui() }
    if omy < 0 { omy = 0 }
    return omy
}

# Which row the pointer is over, or -1. Walks the same accumulation the draw
# does, so a separator's short height is honoured in both.
fn ov_menu_row_at(cx, cy) {
    if cx < ov_menu_mx() { return 0 - 1 }
    if cx >= ov_menu_mx() + OV_MENU_W * ui() { return 0 - 1 }
    if cy < ov_menu_my() { return 0 - 1 }
    if cy >= ov_menu_my() + ov_menu_h() { return 0 - 1 }
    mry = ov_menu_my() + OV_MENU_HEADH * ui()
    mri = 0
    while mri < ov_menu_rows() {
        if ov_menu_sep(mri) == 1 {
            mry = mry + OV_MENU_SEPH * ui()
        } else {
            if cy >= mry { if cy < mry + OV_MENU_ROWH * ui() { return mri } }
            mry = mry + OV_MENU_ROWH * ui()
        }
        mri = mri + 1
    }
    return 0 - 1
}

# ============================================================================
# WHAT THE MENU ROWS DO. Until now: nothing at all.
#
# Twenty-one rows across two menus drew, highlighted, listed their keyboard
# shortcuts, and could not be clicked - because route_mouse never offered the
# pointer to the overlay layer, and no hit test for any overlay surface existed
# anywhere in the tree. The keyboard could drive the palette; the mouse could
# drive none of it. A control that draws and does nothing is the defect this
# project ranks second only to an invented figure, and this was thirty-seven of
# them in one layer.
#
# Every arm below routes to the SAME function the keyboard shortcut uses, so
# the two paths cannot drift. Where a row has no implementation behind it, it
# is disabled rather than silently inert - see ov_ctx_dis.

# TILE ONTO THE MODULE. Three menu rows have named this action since the menus
# were written and none of them had anything to call - wm_move was not even
# bound to zl. It is implemented rather than disabled because the module grid
# is the one thing this desktop is actually about: the field is 12 x 8 and
# every window in the boot composition is already placed on it.
#
# The arrangement is the smallest square that holds the windows - 1 across for
# one, 2 for two to four, 3 for five to nine - which is what the prototype's
# own tile does. Windows are placed in z-order so the front-most lands top-left.
#
# MINIMISED WINDOWS ARE LEFT ALONE. Tiling one would restore it as a side
# effect of a command about layout, and "tile" is not "un-minimise everything".
# Windows on another workspace are skipped for the same reason.
# One predicate, so the counting loop and the placing loop cannot disagree
# about which windows are in the layout - a mismatch there would put windows in
# the wrong cells rather than merely tiling the wrong set.
fn tl_tile_p(w) {
    if wm_winws(w) != cur_ws() { return 0 }
    if wm_min_p(w) == 1 { return 0 }
    return 1
}

fn tile_cols(n) {
    if n <= 1 { return 1 }
    if n <= 4 { return 2 }
    if n <= 9 { return 3 }
    return 4
}

fn desk_tile() {
    tl_n = 0
    tl_i = 0
    while tl_i < wm_n() {
        tl_w = wm_zat(tl_i)
        # ...AND IT CAN NOW ACTUALLY ASK. The comment above promised to skip
        # minimised windows and both loops tested only the workspace, because
        # wm_is_minimized was not bound to zl - so tiling counted a minimised
        # window into the grid, gave it a cell, and moved it there, which is a
        # layout command silently un-minimising things.
        if tl_tile_p(tl_w) == 1 { tl_n = tl_n + 1 }
        tl_i = tl_i + 1
    }
    if tl_n < 1 { note_say("nothing to tile", 400)  return 1 }
    tl_c = tile_cols(tl_n)
    tl_r = idiv(tl_n + tl_c - 1, tl_c)
    tl_gx = field_x()
    tl_gy = field_y()
    tl_gw = idiv(field_w(), tl_c)
    tl_gh = idiv(field_h(), tl_r)
    tl_k = 0
    tl_i = 0
    while tl_i < wm_n() {
        tl_w = wm_zat(tl_i)
        if tl_tile_p(tl_w) == 1 {
            tl_cx = tl_gx + (tl_k % tl_c) * tl_gw
            tl_cy = tl_gy + idiv(tl_k, tl_c) * tl_gh
            wm_move(tl_w, tl_cx, tl_cy)
            wm_size(tl_w, tl_gw - PAD_D * ui(), tl_gh - PAD_D * ui())
            tl_k = tl_k + 1
        }
        tl_i = tl_i + 1
    }
    wm_damage(0, 0, px_w(), px_h())
    note_say2("tiled onto the module", "one cell per window, front-most top-left", 700)
    return 1
}

# THE PALETTE'S ROWS, measured from the same origin ov_draw_palette draws them
# at: sheet top, plus the 62dp header-and-input block, plus 22dp a row.
OV_PAL_ROWH = 22
OV_PAL_TOP  = 62

# THE TYPED QUERY, WHICH THE PALETTE DREW AND DID NOT HAVE.
#
# The sheet has always painted "RUN" and a caret, and a comment beside it said
# so plainly: "There is no typed query yet - the row list is the whole surface -
# and a fake one would be a picture of an input." True, and the prototype's is
# real: it filters sixteen rows as you type.
#
# zl has string LITERALS and no string VALUES, so a row's label cannot be
# examined here. The comparison goes to a native instead: str_has takes the
# label, and the bytes the palette has accumulated, and answers case-insensitively.
PAL_QMAX = 32
pal_qlen = 0

fn pal_clear() { pal_qlen = 0  return 0 }

fn pal_push(ch) {
    if pal_qlen >= PAL_QMAX { return 0 }
    poke8(PAL_QUERY + pal_qlen, ch)
    pal_qlen = pal_qlen + 1
    return 1
}

fn pal_pop() {
    if pal_qlen < 1 { return 0 }
    pal_qlen = pal_qlen - 1
    return 1
}

# Does row i survive the query? An empty query matches every row, which is what
# an empty query means.
fn ov_pal_match(i) { return str_has(ov_pal_label(i), PAL_QUERY, pal_qlen) }

# How many rows survive, and which real row is the k-th of them. The draw, the
# hit test and the keyboard all go through these, so a filtered list cannot
# select the row that merely LOOKS like it is under the pointer.
fn ov_pal_nvis() {
    pvn = 0
    pvi = 0
    while pvi < OV_PAL_N {
        if ov_pal_match(pvi) == 1 { pvn = pvn + 1 }
        pvi = pvi + 1
    }
    return pvn
}

fn ov_pal_nth(k) {
    pnn = 0
    pni = 0
    while pni < OV_PAL_N {
        if ov_pal_match(pni) == 1 {
            if pnn == k { return pni }
            pnn = pnn + 1
        }
        pni = pni + 1
    }
    return 0 - 1
}

# THE SHEET'S HEIGHT, PUBLISHED ONCE. The hit test rebuilt it from OV_PAL_TOP,
# which is the ROW ORIGIN (62) and not the top block's height (66), so the test
# rectangle was 4dp shorter than the plate and a click on the sheet's bottom
# edge read as a click on the scrim - dismissing the palette instead of doing
# nothing. Two expressions for one rectangle, disagreeing by the difference
# between two numbers that look interchangeable and are not.
fn ov_pal_sheet_h() {
    psh = ov_pal_nvis()
    if psh < 1 { psh = 1 }        # the "no command matches" line needs the row
    return 66 * ui() + psh * OV_PAL_ROWH * ui() + 24 * ui()
}

# INSIDE THE SHEET IS NOT THE SAME QUESTION AS ON A ROW, and collapsing the two
# is why a click on the palette's own header dismissed it. The scrim dismisses;
# the sheet does not. A modal that closes when you click its title bar is a
# modal you lose work in.
fn ov_pal_in_sheet(cx, cy) {
    if cx < ov_sheet_x() { return 0 }
    if cx >= ov_sheet_x() + OV_SHEET_W * ui() { return 0 }
    if cy < ov_sheet_y() { return 0 }
    if cy >= ov_sheet_y() + ov_pal_sheet_h() { return 0 }
    return 1
}

# Returns the VISIBLE index, which is what the selection and the draw both use;
# ov_pal_nth turns it into the real row at the point of dispatch.
fn ov_pal_row_at(cx, cy) {
    if ov_pal_in_sheet(cx, cy) == 0 { return 0 - 1 }
    opy = cy - ov_sheet_y() - OV_PAL_TOP * ui()
    if opy < 0 { return 0 - 1 }
    opr = idiv(opy, OV_PAL_ROWH * ui())
    if opr >= ov_pal_nvis() { return 0 - 1 }
    return opr
}

# The menu's equivalent: its plate, from the geometry the draw uses.
fn ov_menu_in_plate(cx, cy) {
    if cx < ov_menu_mx() { return 0 }
    if cx >= ov_menu_mx() + OV_MENU_W * ui() { return 0 }
    if cy < ov_menu_my() { return 0 }
    if cy >= ov_menu_my() + ov_menu_h() { return 0 }
    return 1
}

# THE POINTER REACHES THE OVERLAY, which it never did before.
#
# wm.c registered exactly one overlay hook and it was a DRAW hook; route_mouse
# contained no reference to the overlay layer at all. So a click on a menu row
# or a palette row did nothing AND did not dismiss the surface - and worse, it
# fell THROUGH: the window menu is drawn on top of the window it belongs to, so
# clicking "close" on it focused, raised and started an app-drag on that very
# window instead. Only Escape ever closed any of it.
#
# This consumes EVERY event while an overlay is up, presses and releases alike,
# which is what "modal" means and what the keyboard path already does. A click
# outside any surface dismisses, the way clicking off a menu does everywhere.
fn ov_click(cx, cy, down) {
    if ov_active() == 0 { return 0 }
    # THE DESK'S RIGHT-BUTTON LATCH IS RELEASED HERE, because the desk will not
    # see the release itself. This function consumes every pointer event while
    # an overlay is up and returns before route_mouse reaches hook_desk_click,
    # so rail_rpress stayed armed from the press that opened the menu - and the
    # NEXT right-click compared equal to it and fired nothing. Right-clicking
    # the desk worked on alternate attempts only.
    #
    # The latch belongs to whoever can observe both edges. While an overlay is
    # up that is this function, and the honest thing for it to say is "the desk
    # is not holding a button".
    rail_rpress = 0
    # Releases and moves are still SWALLOWED - the return is 1 either way - so
    # nothing underneath sees a stray drag. But only the press EDGE acts: wm.c
    # passes `down`, not the raw button, because the button is a level and a row
    # driven off the level would re-run on every frame it stayed held.
    if down == 0 { return 1 }
    # OFF THE PLATE DISMISSES; ON THE PLATE BUT OFF A ROW DOES NOTHING. Only
    # the scrim closes these, which is what clicking away from a menu means
    # everywhere else.
    if ov_mode == OV_MENU {
        if ov_menu_in_plate(cx, cy) == 0 { return ov_close_overlay() }
        ovr = ov_menu_row_at(cx, cy)
        if ovr < 0 { return 1 }
        if ov_menu_sep(ovr) == 1 { return 1 }
        ov_sel = ovr
        return ov_menu_run(ovr)
    }
    # AN ACTIVITIES TILE PICKS ITS WINDOW, which is the entire point of an
    # overview. Every tile drew as a control and none was one: the click fell
    # through to the dismiss below and the overview closed having done nothing.
    # A click on the ground between tiles still dismisses, which is what
    # clicking away from a picker means.
    if ov_mode == OV_ACTIVITIES {
        ovw = ov_act_tile_at(cx, cy)
        if ovw < 0 { return ov_close_overlay() }
        ov_close_overlay()
        wm_setfocus(ovw)
        wm_raise(ovw)
        return 1
    }
    # A LOCK YOU CLICK AWAY IS NOT A LOCK. Every other overlay dismisses on a
    # click off its plate, and this one inherited that through the fall-through
    # at the bottom - so a single press on any pixel, the passphrase well
    # included, unlocked the session. That is not a weak lock, it is a picture
    # of one.
    #
    # It consumes every press and dismisses on none. Escape is the way out and
    # the sheet says so - and now says the other half too, that there is no
    # authentication behind it. A field with a caret implies a secret is being
    # checked; this one is not, and the surface should not let the reader think
    # otherwise.
    if ov_mode == OV_LOCK { return 1 }
    if ov_mode == OV_PALETTE {
        if ov_pal_in_sheet(cx, cy) == 0 { return ov_close_overlay() }
        ovp = ov_pal_row_at(cx, cy)
        if ovp < 0 { return 1 }
        ov_sel = ovp
        return ov_pal_run(ovp)
    }
    # ACTIVITIES and LOCK have no row dispatch yet, and a click that silently
    # did nothing would be the same defect this function exists to remove. They
    # dismiss, which is at least an answer.
    return ov_close_overlay()
}

fn ov_close_overlay() {
    ov_mode = OV_NONE
    wm_damage(0, 0, px_w(), px_h())
    return 1
}

# The field menu. Row numbers are ov_ctx_label's.
# No disabled rows on the field menu - ov_menu_dis says so for this kind, and
# every actionable row below now has something behind it. Separators never
# arrive here: ov_menu_row_at skips their bands rather than returning them.
fn ov_ctx_run(i) {
    if i == 0 { ov_mode = OV_ACTIVITIES  ov_sel = 0  wm_damage(0, 0, px_w(), px_h())  return 1 }
    if i == 1 { pal_clear()  ov_mode = OV_PALETTE  ov_sel = 0  wm_damage(0, 0, px_w(), px_h())  return 1 }
    if i == 4 {
        ov_close_overlay()
        desk_grid_on = 1 - desk_grid_on
        rebake_wallpaper()
        wm_damage(0, 0, px_w(), px_h())
        if desk_grid_on == 1 { note_say2("desk grid on", "12 x 8 module, ruled to the field margin", 800) } else { note_say2("desk grid off", "crop marks and the slug stay - they have their own switches now", 800) }
        return 1
    }
    if i == 5 {
        ov_close_overlay()
        ui_knock(1 - ui_knock_on())
        if ui_knock_on() == 1 { note_say2("knockout on", "the focused header inverts, and it is the only focus signal", 800) } else { note_say2("knockout off", "fallback is the wash ramp - sit back and find the focused plate", 800) }
        wm_damage_theme()
        return 1
    }
    if i == 3  { ov_close_overlay()  return desk_tile() }
    if i == 7  { ov_close_overlay()  return ws_hotkey(1) }
    if i == 8  { ov_close_overlay()  return ws_hotkey(2) }
    if i == 10 { ov_close_overlay()  return reg_open(APP_SETTINGS) }
    if i == 11 { ov_mode = OV_LOCK  ov_sel = 0  wm_damage(0, 0, px_w(), px_h())  return 1 }
    return 1
}

# The window menu, acting on ov_menu_win - the window that was right-clicked,
# not the focused one, because those are different the moment a menu is open.
fn ov_win_run(i) {
    if ov_win_dis(i) == 1 { return 1 }
    if ov_menu_win < 0 { return ov_close_overlay() }
    if wm_is_open(ov_menu_win) == 0 { return ov_close_overlay() }
    ov_close_overlay()
    if i == 0 { wm_setfocus(ov_menu_win)  wm_raise(ov_menu_win)  return 1 }
    if i == 1 { return wm_min(ov_menu_win) }
    if i == 2 { return wm_max(ov_menu_win) }
    if i == 4 { return desk_tile() }
    # THE CLOSE ROW GOES THROUGH THE SAME REFUSAL THE CLOSE BOX DOES. Calling
    # wm_close directly here would be a second way to destroy an unsaved buffer,
    # and app_can_close exists precisely because the first one was.
    if i == 8 {
        if app_can_close(ov_menu_win) == 0 { return 1 }
        return wm_close_fx(ov_menu_win)
    }
    return 1
}

fn ov_menu_run(i) {
    if ov_menu_kind == OV_MENU_WIN { return ov_win_run(i) }
    return ov_ctx_run(i)
}

fn ov_draw_menu(u) {
    mw = OV_MENU_W * u
    rowh = OV_MENU_ROWH * u
    seph = OV_MENU_SEPH * u
    headh = OV_MENU_HEADH * u
    mh = ov_menu_h()
    mx = ov_menu_mx()
    my = ov_menu_my()
    fill_rgb(mx, my, mw, mh, theme(TH_PANEL_HI))
    fill_rgb(mx, my, mw, 1, theme(TH_LIT))
    fill_rgb(mx, my + mh - 1, mw, 1, theme(TH_CUT))
    # the header names what was clicked - "field", or the window's register row
    if ov_menu_kind == OV_MENU_WIN {
        ui_caps(mx + 10 * u, my + 6 * u, "WINDOW", theme(TH_TEXT_2), T_CAPTION)
    } else {
        ui_caps(mx + 10 * u, my + 6 * u, "FIELD", theme(TH_TEXT_2), T_CAPTION)
    }
    fill_rgb(mx, my + headh - 1, mw, 1, theme(TH_CUT))
    ry = my + headh
    mi = 0
    while mi < ov_menu_rows() {
        if ov_menu_sep(mi) == 1 {
            fill_rgb(mx + 8 * u, ry + seph / 2, mw - 16 * u, 1, theme(TH_CUT))
            ry = ry + seph
        } else {
            tc = theme(TH_TEXT_HI)
            if ov_menu_dis(mi) == 1 { tc = theme(TH_TEXT_DIM) }
            if mi == ov_sel { if ov_menu_dis(mi) == 0 {
                fill_rgb(mx, ry, mw, rowh, theme(TH_SURF_5))
                fill_rgb(mx, ry, focus_bar(), rowh, theme(TH_ACCENT))
            }}
            label(mx + 14 * u, ry + 3 * u, ov_menu_label(mi), tc, T_BODY, W_REG)
            if ov_menu_haskey(mi) == 1 {
                ui_caps(mx + mw - 74 * u, ry + 4 * u, ov_menu_key(mi), theme(TH_TEXT_2), T_CAPTION)
            }
            ry = ry + rowh
        }
        mi = mi + 1
    }
    return 0
}

# ---- activities --------------------------------------------------------------
# The prototype's #overview: every window on this workspace as a scaled plate,
# under a header that reads `activities  N plates on workspace 0N  esc to
# dismiss`. At most three columns, and the tiles take each window's OWN aspect
# at ONE shared scale - so the grid also states the windows' real sizes relative
# to each other, which a uniform grid of equal boxes throws away.
#
# THE TILE IS THE PLATE AT SCALE, NOT A BOX THE PLATE SITS IN. The prototype's
# own comment records getting this wrong first: tiles took the whole grid cell
# while the scaled window filled only the top, so every tile carried 130-160 px
# of blank ground and the overview read as half-printed sheets.
OV_ACT_COLS = 3
OV_ACT_GAP  = 14                   # design units between tiles
OV_ACT_TH   = 20                   # the tile's own header band
OV_ACT_PAD  = 28                   # margin around the grid
OV_ACT_HEAD = 34                   # the surface's header

# How many windows the overview will show: open, on this workspace. The register
# counts differently (it counts APPS with a row), so this walks the z-order.
# A MINIMISED WINDOW IS NOT IN THE OVERVIEW, and the authority says so twice:
# showOverview builds its list with `.filter(w => w.ws === S.ws && !w.min)`
# (presswork-prototype.html:2523-2524) and the subtitle counts the same
# predicate (:2369-2370).
#
# THIS TOOK MINIMISED WINDOWS THREE WAYS AND EACH ONE SHOWED. The header prints
# this count under the words "plates on this workspace"; wm_minimize calls
# window_surfaces_free (wm.c:2288-2296), so W->client_px is NULL, wm_thumb
# returns 0 (wm.c:1929) and the tile renders as a BARE PLATE - the "half
# printed sheets" failure the prototype's own comment at :2529 and this file's
# at 12032 both describe; and ov_act_scale takes maxw/maxh over the minimised
# ones too, so a window nobody can see shrinks every tile that is visible.
#
# wm_min_p is already bound and this file already uses it for exactly this
# class of filter at 11770. Both helpers get the arm, because a count that
# disagrees with the list it heads is worse than either being wrong alone.
fn ov_act_shows(w) {
    if wm_winws(w) != wm_ws() { return 0 }
    if wm_min_p(w) == 1 { return 0 }
    return 1
}
fn ov_act_n() {
    oan = 0
    oai = 0
    while oai < wm_n() {
        oaw = wm_zat(oai)
        if ov_act_shows(oaw) == 1 { oan = oan + 1 }
        oai = oai + 1
    }
    return oan
}
fn ov_act_win(idx) {
    oas = 0
    oaj = 0
    while oaj < wm_n() {
        oaw2 = wm_zat(oaj)
        if ov_act_shows(oaw2) == 1 {
            if oas == idx { return oaw2 }
            oas = oas + 1
        }
        oaj = oaj + 1
    }
    return 0 - 1
}

# WHICH TILE IS UNDER THE POINTER, OR -1.
#
# Every tile in the overview draws as a control - a plate with a struck edge, a
# header carrying the register number and name, the window's real size, a live
# preview, and a knocked-out header on the focused one - and not one of them was
# one. ov_click had no OV_ACTIVITIES arm, so a click anywhere dismissed the
# overview and did nothing else. An overview whose whole purpose is picking a
# window could not pick one.
#
# THE ACCUMULATION IS REPEATED IN THE SAME ORDER as the draw's, term for term,
# because the alternative is a second layout that diverges the first time one is
# edited - the fault this file has now found in Settings, the browser, the
# catalogue and the Files list. Same gx0, same gy0, same cols, same sc.
# THE TILE IS SIZED FROM WHAT IS ACTUALLY BLITTED INTO IT.
#
# This measured wm_w / wm_hh, which are wm_geometry's gw/gh - the FRAME. The
# tile is then filled by wm_thumb, which box-filters client_w x client_h
# (wm.c:1925-1958). client_of subtracts ZD_TITLE_H 28, the status band's 21 and
# 2 of border, so client_h is frame_h - 51 and every preview came out stretched
# VERTICALLY by frame_h/client_h - 14.6% for the Files window, 16.5% for the
# editor. The comment at 12028 claims the tiles take each window's own aspect;
# they took a distorted one.
#
# The authority sizes from the body for the same reason: showOverview uses
# `maxH = max(w.h - 28)` and `tileH = TH + (w.h - 28) * sc0` (:2538-2540), and
# the clone it puts inside is `w.w x (w.h - 28)` (:2571-2573).
#
# wm_cw / wm_ch were already bound (runtime_kernel.c:1805-1806) - the
# measurement existed, and the wrong one was being read.
fn ov_act_scale(gw, gh, cols, rows, n) {
    oas_maxw = 1
    oas_maxh = 1
    oas_i = 0
    while oas_i < n {
        oas_w = wm_cw(ov_act_win(oas_i))
        oas_h = wm_ch(ov_act_win(oas_i))
        if oas_w > oas_maxw { oas_maxw = oas_w }
        if oas_h > oas_maxh { oas_maxh = oas_h }
        oas_i = oas_i + 1
    }
    oas_cw = idiv(gw - (cols - 1) * OV_ACT_GAP * ui(), cols)
    oas_ch = idiv(gh - (rows - 1) * OV_ACT_GAP * ui(), rows)
    oas_scx = idiv(oas_cw * 256, oas_maxw)
    oas_scy = idiv((oas_ch - OV_ACT_TH * ui()) * 256, oas_maxh)
    oas_sc = oas_scx
    if oas_scy < oas_sc { oas_sc = oas_scy }
    if oas_sc < 16 { oas_sc = 16 }
    return oas_sc
}

fn ov_act_tile_at(cx, cy) {
    oat_n = ov_act_n()
    if oat_n < 1 { return 0 - 1 }
    oat_u = ui()
    oat_gx0 = rail_w() + OV_ACT_PAD * oat_u
    oat_gy0 = strip_h() + OV_ACT_PAD * oat_u + OV_ACT_HEAD * oat_u
    oat_gw = px_w() - oat_gx0 - OV_ACT_PAD * oat_u
    oat_gh = px_h() - oat_gy0 - OV_ACT_PAD * oat_u - foot_h()
    oat_cols = oat_n
    if oat_cols > OV_ACT_COLS { oat_cols = OV_ACT_COLS }
    oat_rows = idiv(oat_n + oat_cols - 1, oat_cols)
    oat_cw = idiv(oat_gw - (oat_cols - 1) * OV_ACT_GAP * oat_u, oat_cols)
    oat_ch = idiv(oat_gh - (oat_rows - 1) * OV_ACT_GAP * oat_u, oat_rows)
    oat_sc = ov_act_scale(oat_gw, oat_gh, oat_cols, oat_rows, oat_n)
    oat_i = 0
    while oat_i < oat_n {
        oat_w2 = ov_act_win(oat_i)
        oat_c = oat_i - idiv(oat_i, oat_cols) * oat_cols
        oat_r = idiv(oat_i, oat_cols)
        # THE HIT RECT IS THE DRAWN RECT, term for term. The draw moved to the
        # client measurement; a hit test still asking for the frame would place
        # every tile's clickable box a stretch away from the tile - which is
        # the class of split this whole helper exists to prevent.
        oat_tw = idiv(wm_cw(oat_w2) * oat_sc, 256)
        oat_th = idiv(wm_ch(oat_w2) * oat_sc, 256) + OV_ACT_TH * oat_u
        oat_tx = oat_gx0 + oat_c * (oat_cw + OV_ACT_GAP * oat_u) + idiv(oat_cw - oat_tw, 2)
        oat_ty = oat_gy0 + oat_r * (oat_ch + OV_ACT_GAP * oat_u)
        if cx >= oat_tx {
            if cx < oat_tx + oat_tw {
                if cy >= oat_ty {
                    if cy < oat_ty + oat_th { return oat_w2 }
                }
            }
        }
        oat_i = oat_i + 1
    }
    return 0 - 1
}

fn ov_draw_activities(u) {
    n = ov_act_n()
    gx0 = rail_w() + OV_ACT_PAD * u
    gy0 = strip_h() + OV_ACT_PAD * u + OV_ACT_HEAD * u
    gw = px_w() - gx0 - OV_ACT_PAD * u
    gh = px_h() - gy0 - OV_ACT_PAD * u - foot_h()
    # the header, at the same rung the other modals use
    ui_caps(gx0, strip_h() + OV_ACT_PAD * u, "ACTIVITIES", theme(TH_TEXT_HI), T_CAPTION)
    label_num(gx0 + 108 * u, strip_h() + OV_ACT_PAD * u, n, theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label(gx0 + 126 * u, strip_h() + OV_ACT_PAD * u, "plates on this workspace", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    ui_caps(px_w() - OV_ACT_PAD * u - 96 * u, strip_h() + OV_ACT_PAD * u, "ESC TO DISMISS", theme(TH_TEXT_2), T_CAPTION)
    if n < 1 { return 0 }
    cols = n
    if cols > OV_ACT_COLS { cols = OV_ACT_COLS }
    rows = idiv(n + cols - 1, cols)          # idiv: a row COUNT
    cw = (gw - (cols - 1) * OV_ACT_GAP * u) / cols
    ch = (gh - (rows - 1) * OV_ACT_GAP * u) / rows
    # ONE SCALE FOR THE WHOLE WORKSPACE, taken from the largest window, so the
    # tiles keep their sizes relative to each other. Per-tile scaling would make
    # a 320-wide window and a 1200-wide one the same size on screen, which is
    # the one thing this grid is meant to show.
    # THE SCALE COMES FROM THE SHARED HELPER, so the hit test cannot compute a
    # different one. The loop below still finds maxw/maxh for its own reasons.
    maxw = 1
    maxh = 1
    oi = 0
    while oi < n {
        ow = wm_cw(ov_act_win(oi))
        oh = wm_ch(ov_act_win(oi))
        if ow > maxw { maxw = ow }
        if oh > maxh { maxh = oh }
        oi = oi + 1
    }
    # scale in 1/256ths - there are no floats here
    scx = idiv(cw * 256, maxw)
    scy = idiv((ch - OV_ACT_TH * u) * 256, maxh)
    sc = scx
    if scy < sc { sc = scy }
    if sc < 16 { sc = 16 }
    oi = 0
    while oi < n {
        ow2 = ov_act_win(oi)
        c = oi - idiv(oi, cols) * cols
        r = idiv(oi, cols)
        # THE SAME CLIENT MEASUREMENT THE SCALE WAS TAKEN FROM. wm_thumb fills
        # this rect with client pixels, so the rect has to have the client's
        # aspect or the picture is stretched to fit a frame that is not in it.
        tw = idiv(wm_cw(ow2) * sc, 256)
        th = idiv(wm_ch(ow2) * sc, 256) + OV_ACT_TH * u
        tx = gx0 + c * (cw + OV_ACT_GAP * u) + (cw - tw) / 2
        ty = gy0 + r * (ch + OV_ACT_GAP * u)
        # the plate, its struck edge and its groove - a tile is a plate
        fill_rgb(tx, ty, tw, th, theme(TH_PANEL))
        fill_rgb(tx, ty, tw, 1, theme(TH_LIT))
        fill_rgb(tx, ty + th - 1, tw, 1, theme(TH_CUT))
        # THE FOCUSED TILE IS A KNOCKED-OUT HEADER, AND THE BAR STARTS BELOW IT.
        #
        # This drew a full-height vermilion bar straight down the tile,
        # crossing its own header. The prototype's `.thumb.on::after` starts at
        # top: 20dp - below the header band - and the header itself flips to
        # ZD_KNOCK with its text reversed out. The prototype's comment records
        # why it is not both: "It used to take a vermilion border as well, which
        # contradicted the caption directly above it."
        #
        # Measured on this ladder, vermilion on the knockout is 1.3989:1, so a
        # bar drawn over a knocked-out header would be there and unreadable.
        # ZD_KO_EDGE is the knockout's own edge run - design.h states 2.5487:1
        # on it - and that is what marks the focused tile below the band.
        onum = theme(TH_TEXT_DIM)
        onm = theme(TH_TEXT_2)
        if wm_focus() == ow2 {
            fill_rgb(tx, ty, tw, OV_ACT_TH * u, theme(TH_KNOCK))
            fill_rgb(tx, ty + OV_ACT_TH * u, focus_bar(), th - OV_ACT_TH * u, theme(TH_KO_EDGE))
            onum = theme(TH_KNOCK_INK2)
            onm = theme(TH_KNOCK_INK)
        }
        # the tile header: register number, name, and the window's REAL size
        osl = slot_of_app(wm_app(ow2))
        if osl >= 0 {
            label_num(tx + 8 * u, ty + 4 * u, osl + 1, onum, T_CAPTION, W_REG)
            label(tx + 28 * u, ty + 4 * u, rail_name(osl), onm, T_CAPTION, W_REG)
        }
        label_num(tx + tw - 62 * u, ty + 4 * u, wm_w(ow2), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label(tx + tw - 34 * u, ty + 4 * u, "x", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        label_num(tx + tw - 26 * u, ty + 4 * u, wm_hh(ow2), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
        fill_rgb(tx, ty + OV_ACT_TH * u - 1, tw, 1, theme(TH_CUT))
        # THE PREVIEW IS THE WINDOW, box-filtered. wm_thumb returns 0 for a
        # window that has never painted, and that case is left as bare plate
        # rather than filled with something invented.
        wm_thumb(ow2, tx, ty + OV_ACT_TH * u, tw, th - OV_ACT_TH * u)
        oi = oi + 1
    }
    return 0
}

# ---- the lock sheet ----------------------------------------------------------
# The prototype's #lock: a plate whose header is KNOCKED OUT - the same inversion
# a focused window's header uses, for the same reason. This is the one surface
# that owns the whole screen, so it takes the strongest mark the system has.
#
# EVERY FIGURE ON IT IS ONE THIS MACHINE KNOWS. The prototype prints uptime,
# workspaces and plates held, the display mode, and the storage generation, and
# all four exist here: ticks()/100, WS_N and wm_n(), px_w() x px_h(), and
# fs_ok()/fs_n(). Where the prototype prints something this OS cannot measure it
# is left out rather than invented - the same line the parity pass drew when it
# refused to print LOAD 0.58.
#
# THE PASSPHRASE FIELD IS EMPTY, and that is the honest version. The prototype
# draws eleven bullets, which is a mock of a typed secret; nothing has been
# typed here and there is no authentication behind it. The field and its caret
# are drawn - they say what the surface is for - and the bullets are not.
OV_LOCK_W = 460
fn ov_draw_lock(u) {
    lw = OV_LOCK_W * u
    lh = 250 * u
    lx = (px_w() - lw) / 2
    ly = (px_h() - lh) / 3
    hh = 30 * u
    # the plate
    fill_rgb(lx, ly, lw, lh, theme(TH_PANEL))
    fill_rgb(lx, ly + lh - 1, lw, 1, theme(TH_CUT))
    # THE KNOCKED-OUT HEADER, solid, with its ink reversed out of it
    fill_rgb(lx, ly, lw, hh, theme(TH_KNOCK))
    ui_caps(lx + 13 * u, ly + 9 * u, "SESSION LOCKED", theme(TH_KNOCK_INK), T_CAPTION)
    label(lx + 150 * u, ly + 9 * u, "tty1 seat0", theme(TH_KNOCK_INK), T_CAPTION, W_REG)
    # the overprint bar under the header, as a focused window carries
    fill_rgb(lx, ly + hh, lw, focus_bar(), theme(TH_ACCENT))
    by = ly + hh + 14 * u
    # the clock, at the largest cell the system draws
    draw_hhmm(lx + 13 * u, by, CLOCK_CELL_LG * u, T_TITLE, theme(TH_TEXT_HI))
    ui_caps(lx + 150 * u, by + 4 * u, "OPERATOR", theme(TH_TEXT_2), T_CAPTION)
    label(lx + 150 * u, by + 20 * u, "root", theme(TH_TEXT_HI), T_BODY, W_REG)
    by = by + 46 * u
    fill_rgb(lx + 13 * u, by, lw - 26 * u, 1, theme(TH_CUT))
    by = by + 10 * u
    # the readings, each one measured
    ui_caps(lx + 13 * u, by, "UPTIME", theme(TH_TEXT_2), T_CAPTION)
    label_num(lx + 110 * u, by, idiv(ticks(), 100), theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(lx + 150 * u, by, "s", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    by = by + 18 * u
    ui_caps(lx + 13 * u, by, "WORKSPACES", theme(TH_TEXT_2), T_CAPTION)
    label_num(lx + 110 * u, by, WS_N, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label_num(lx + 150 * u, by, wm_n(), theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(lx + 178 * u, by, "plates held", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    by = by + 18 * u
    ui_caps(lx + 13 * u, by, "DISPLAY", theme(TH_TEXT_2), T_CAPTION)
    label_num(lx + 110 * u, by, px_w(), theme(TH_TEXT_HI), T_CAPTION, W_REG)
    label(lx + 150 * u, by, "x", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(lx + 162 * u, by, px_h(), theme(TH_TEXT_HI), T_CAPTION, W_REG)
    by = by + 18 * u
    ui_caps(lx + 13 * u, by, "STORAGE", theme(TH_TEXT_2), T_CAPTION)
    if fs_ok() == 1 {
        label_num(lx + 110 * u, by, fs_n(), theme(TH_TEXT_HI), T_CAPTION, W_REG)
        label(lx + 150 * u, by, "files on rd0", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(lx + 110 * u, by, "rd0 unformatted", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    by = by + 26 * u
    # the passphrase well: the field and its caret, and nothing pretending to be
    # in it
    rrect(lx + 13 * u, by, lw - 26 * u, 24 * u, R_INSET_D * u, theme(TH_PANEL_HI))
    ui_caps(lx + 21 * u, by + 6 * u, "PASSPHRASE", theme(TH_TEXT_2), T_CAPTION)
    fill_rgb(lx + 110 * u, by + 5 * u, 2 * u, cell_h(), theme(TH_ACCENT))
    by = by + 32 * u
    ui_caps(lx + 13 * u, by, "ESC", theme(TH_TEXT_2), T_CAPTION)
    label(lx + 46 * u, by, "dismiss - this lock has no authentication behind it", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    return 0
}

# THE ONE ENTRY POINT the compositor calls. x0,y0,x1,y1 is the DAMAGE rect, in
# the same form wm.c's paint walk carries it.
fn overlay_draw(ox0, oy0, ox1, oy1) {
    if ov_mode == OV_NONE { return 0 }
    ou = ui()
    # the scrim covers the whole screen, clipped to the damage rectangle - a
    # modal whose scrim stops at the desk leaves the rail at full brightness,
    # which the prototype's own comment calls out as the bug it had.
    sx0 = ox0
    sy0 = oy0
    sx1 = ox1
    sy1 = oy1
    if sx0 < 0 { sx0 = 0 }
    if sy0 < 0 { sy0 = 0 }
    if sx1 > px_w() { sx1 = px_w() }
    if sy1 > px_h() { sy1 = px_h() }
    # ---- ONE SCRIM FOR FOUR SURFACES WAS THREE SURFACES WRONG ---------------
    #
    # This shaded the whole screen for every mode. The prototype does that for
    # exactly one of them:
    #
    #   palette     a scrim over everything - the only true scrim
    #   activities  an OPAQUE ZD_VOID panel over the FIELD ONLY. The rail, the
    #               strip and the foot keep their own brightness; the overview
    #               replaces the desk, it does not dim the machine.
    #   menu        NO scrim at all. A context menu that dims the screen is a
    #               modal, and this one is not.
    #   lock        opaque, full screen, and outside #os entirely.
    #
    # And the scrim itself was the wrong operation. shade() multiplies toward
    # BLACK at 5/8, keeping 62.5% of each pixel. The prototype lays 78% of
    # ZD_CUT over what is underneath, keeping 22% - roughly twice as dark, and
    # warm rather than neutral, because the whole ladder sits on a warm ground
    # and a neutral veil reads as a different material laid on top.
    #
    # The comment that used to justify 5/8 cited `.scrim { background:
    # rgba(0,0,0,.38) }`. `rgba(` does not appear anywhere in the current
    # prototype - that rule is from ds.html, the superseded predecessor.
    if sx1 > sx0 { if sy1 > sy0 {
        if ov_mode == OV_PALETTE { mix(sx0, sy0, sx1 - sx0, sy1 - sy0, theme(TH_CUT), OV_SCRIM_NUM, OV_SCRIM_DEN) }
        if ov_mode == OV_LOCK { fill_rgb(sx0, sy0, sx1 - sx0, sy1 - sy0, theme(TH_BG)) }
        if ov_mode == OV_ACTIVITIES { ov_field_panel(sx0, sy0, sx1, sy1) }
    }}
    if ov_mode == OV_PALETTE { return ov_draw_palette(ou) }
    if ov_mode == OV_MENU { return ov_draw_menu(ou) }
    if ov_mode == OV_ACTIVITIES { return ov_draw_activities(ou) }
    if ov_mode == OV_LOCK { return ov_draw_lock(ou) }
    return 0
}

fn desk_draw(dx, dy, dw, dh) {
    # THE CHROME'S TWO SHELL FACTS, refreshed before anything is painted.
    # wm_set_field tells wm.c where the module grid's origin is, so a window
    # can print its own cell as "M0101 7x5"; label_windows fills the register
    # and subtitle cells. Both are cheap and both are stale-able - the field
    # moves when the panel resizes, and the labels move when an app opens into
    # a slot - so they are refreshed rather than set once at boot.
    wm_set_field(field_x(), field_y(), field_w(), field_h())
    label_windows()
    if wall_ok() == 1 {
        wall_paint(dx, dy, dw, dh)
    } else {
        desk_ground()
    }
    # THE FOUR BANDS, each drawn only when the rectangle actually touches it.
    # The rail's static half and the desk are in the wallpaper cache; everything
    # below is the live half, and each test is the band's own extent rather than
    # a margin somebody guessed.
    if shell_baked == 0 { draw_rail_static() }
    if dx < rail_w() {
        draw_rail_reg()
        draw_rail_ws()
        draw_rail_stat()
        draw_rail_clock()
    }
    # Both bands own their own rule, so the tests are the bands' own extents.
    if dy < strip_h() { draw_strip() }
    if dy + dh > foot_y() { draw_foot() }
    return 0
}

# THE DESK, WITHOUT THE CACHE. The fallback when wall_save() refuses the
# bitmap - a 4K RGB565 cache fits the 16 MiB arena today, and if some future
# mode or competing effect does not, this is what the compositor falls back to
# rather than drawing nothing.
fn desk_ground() {
    fill_rgb(0, 0, px_w(), px_h(), theme(TH_BG))
    draw_grid()
    return 0
}

# ---- THE WALLPAPER IS THE FIELD --------------------------------------------
# Nine layers went out of here and one came in, and the deletion is the change.
#
# What was here: a base gradient, three offset elliptical glows, two clipped
# conic wedges, a two-scale technical grid at four alphas, a scanline grain, 320
# deterministic speckles and a vignette. Thirteen passes over every pixel of the
# screen, in navy and cyan, with three colour literals kept in this file because
# ui_theme had no role for them.
#
# What PRESSWORK asks for is a DESK. ZD_VOID, flat, with the ruled module grid
# on it - and the grid is the only thing on the desk that carries information,
# which is precisely why nothing else may compete with it. A vignette darkens
# the corners the crop marks live in; a conic sweep crosses the module rules at
# an angle and makes them look like a moire; a speckle field at 7/255 is
# indistinguishable from a dirty panel. All three are gone and none of them is
# coming back behind a toggle.
#
# THE ONE THING THAT SURVIVES is the raking light, and it survives because it is
# the design's premise rather than a decoration: PRESSWORK is lit by a single
# lamp entering from off-screen upper left, every 1px run in the system is drawn
# on the side that lamp strikes, and a field with no gradient at all would be
# the one surface in the machine the lamp does not reach. design.h states the
# call exactly, and the prototype's own comment above `#field::before` quotes
# the same line:
#
#     fb_glow(-w/8, -h/6, w*11/8, h*11/8, ZD_LITSOFT, 26, 0, 100)
#
# ...so this is that call, with ZD_LITSOFT reached through TH_LITSOFT and a_in
# through ZD_WALL_GLOW_A. There is no colour literal left in this function, and
# wall_glow_a/b/c - the three that design.h could not name - are deleted with
# the layers that used them.
#
# THE BRIEF SAID "no vignette, no glow" AND THE PROTOTYPE DRAWS THIS ONE. Where
# the two disagree the prototype wins, and reading them together the brief is
# naming the nine-layer stack rather than the design's own lamp: the vignette is
# gone, the three teal glows are gone, and what is left is a single call that
# design.h, ui.c and the prototype all three specify in the same terms.
# ZD_WALL_GLOW_A IS 26 AND THAT IS NOT fb_glow's a_in. design.h labels it
# "fb_glow a_in, percent" and it is neither: run through fb.c's OWN gamma tables
# - ipow22, LIN_MAX 4095, srgb_to_lin/lin_to_srgb, not the textbook sRGB curve -
# ZD_LITSOFT over ZD_VOID at alpha 26 comes out #2D2623, which is ZD_WALL_42
# (#2D2622) to within one code value in one channel. So 26 is the value at the
# 34% STOP, and design.h's own three flattened tokens are what say so.
#
# The a_in that reproduces ZD_WALL_0 (#3E3733), the CENTRE, is 85: it lands on
# #3D3733, again one code value total. Both figures were solved by sweeping all
# 256 alphas through a copy of fb.c's blend_rgb rather than derived on paper,
# because fb.c blends in LINEAR LIGHT and the prototype's CSS mixes in sRGB - so
# the 46% the prototype's stylesheet asks for is not 46% here, and computing it
# from the sRGB formula would have given 117 and a visibly too-bright desk.
#
# THE TWO SEGMENTS ARE TWO CALLS, and this is where the note above used to
# give up. It said: the CSS ramp has TWO segments (46% at the centre, 16% at
# 34%, transparent at 72%) and fb_glow has ONE; anchored on the centre with a
# stop of 100 the single ramp reads 85 * (100 - 34) / 100 = 56 at the 34% stop
# where the CSS reads 26, so the middle of the desk is brighter than the
# prototype's - and it concluded "fixing that needs a two-stop radial in fb.c,
# and fb.c is not this change's to edit."
#
# THE DIAGNOSIS WAS RIGHT AND THE CONCLUSION WAS WRONG. fb_glow takes a stop,
# so a two-segment ramp is a two-segment ramp: an OUTER call that carries the
# 34%-to-72% tail and an INNER one that adds the extra light back over the
# first 34%. They composite because glow_px blends the same colour twice, so
# the effective coverage is 1 - (1 - a1)(1 - a2) rather than a1 + a2 - which is
# also why WALL_GLOW_IN is not 85 - 49. fb.c is untouched; the desk is two
# calls instead of one.
#
# THE FIGURES ARE SWEPT, NOT DERIVED, for the same reason the 85 above was: fb.c
# blends in LINEAR LIGHT and the CSS mixes in sRGB, so no closed form on paper
# is the number this renders. hosttest built the desk at 1920x1200 both ways
# and read back seven points, against the prototype's own two-segment ramp
# evaluated at each point's radius. Worst channel error, one stop vs two:
#
#   point           d       target    1 call      2 calls
#   top-left      0.154    #362F2B   #3A3430  5  #362F2C  1
#   top-mid       0.471    #2A231F   #332D29 10  #2A2420  1
#   top-right     0.826    #241D19   #29231F  6  #241D19  0
#   mid-left      0.494    #29221E   #322C28 10  #29231F  1
#   centre        0.665    #251E1A   #2E2724 10  #251E1B  1
#   bottom-left   0.850    #241D19   #28221E  5  #241D19  0
#   bottom-right  1.175    #241D19   #241D19  0  #241D19  0
#
# The worst error goes from 10 code values to 1. The two points that were
# already exact stay exact, which is the control: a change that moved those
# would be a change to the lamp rather than to its falloff. Note the shape of
# the old error - the desk was TOO BRIGHT everywhere except at the very far
# corner, and most wrong in the middle, which is exactly what one linear ramp
# stretched over a curve that has a knee in it does.
#
# The centre itself cannot be sampled: the lamp is at (-w/8, -h/6), off the
# panel, so the smallest radius any real pixel has is 0.154. The 85 in the
# comment above is still the anchor the sweep was solved against - it is just
# not a pixel anyone can see.
WALL_GLOW_OUT_A = 49               # swept: the 34%-to-72% tail
WALL_GLOW_IN_A  = 42               # swept: the extra light over the first 34%
WALL_GLOW_OUT_STOP = 72            # the CSS ramp's `transparent 72%`
WALL_GLOW_IN_STOP  = 34            # ...and its middle stop
WALL_GLOW_OUT = 0                  # ZD_WALL_GLOW_OUT - both ramps end at nothing
fn draw_wallpaper() {
    ww = px_w()
    wh = px_h()
    fill_rgb(0, 0, ww, wh, theme(TH_BG))
    # the lamp. Clipped to the FIELD, because the rail, the strip and the foot
    # are plates lit by their own 1px runs - letting the glow wash over them
    # would put a second, contradictory light source on the same chrome.
    clip(field_x(), field_y(), field_w(), field_h())
    gx = 0 - idiv(ww, 8)
    gy = 0 - idiv(wh, 6)
    grx = ww * 11 / 8
    gry = wh * 11 / 8
    # ORDER DOES NOT MATTER but the OUTER one is written first, because it is
    # the ramp that reaches the whole field and the inner one is a correction
    # over its first third.
    glow(gx, gy, grx, gry, theme(TH_LITSOFT), WALL_GLOW_OUT_A, WALL_GLOW_OUT, WALL_GLOW_OUT_STOP)
    glow(gx, gy, grx, gry, theme(TH_LITSOFT), WALL_GLOW_IN_A, WALL_GLOW_OUT, WALL_GLOW_IN_STOP)
    clipoff()
    draw_grid()
    return 0
}

# Open snake, or raise it if it is already open. A dock that opens a second
# copy of an app every time it is clicked is the single most annoying thing a
# dock can do, and wm.c gives no such rule for free - "one window per app" is
# policy and this is where policy lives.
snake_win = 0 - 1
fn open_snake() {
    u = ui()
    if snake_win >= 0 {
        if wm_open_p(snake_win) == 1 {
            wm_setfocus(snake_win)
            wm_raise(snake_win)
            return 0
        }
    }
    sx = px_w() / 2 - 200 * u
    sy = 120 * u
    snake_win = wm_open(APP_SNAKE, "Snake", sx, sy, 420 * u, 360 * u)
    wm_setfocus(snake_win)
    wm_raise(snake_win)
    return 0
}

# ---- the rail, which is CLICKABLE -------------------------------------------
# wm.c hands presses that hit no window here. Everything the desktop owns - the
# register, the workspace row, the catalog - is in the rail now, so this
# function is the rail's hit test and nothing else. The dock's three bands (the
# Activities corner, the pip row, the strip) are gone with the dock.
rail_hover = 0 - 1                 # which register row the pointer is over
# THE RIGHT BUTTON'S EDGE. `rail_press` used to live here, tracking the LEFT
# button so it could damage the register band on press and again on release -
# for a pressed state that nothing draws. Its three occurrences in the tree were
# its declaration and its own assignment; draw_rail_row has four states and
# pressed is not one of them, and the prototype has no `:active` rule on .slot
# either. Two full repaints of a 170-wide column per click, to change nothing.
#
# What replaces it tracks the RIGHT button, and is read: it is the edge that
# stops a held right button reopening the field menu on every pointer event.
rail_rpress = 0

fn desk_click(cx, cy, cbtn) {
    down = band(cbtn, 1)

    # HOVER FIRST, and only repaint when the answer CHANGES. Damaging the rail
    # on every pointer event repaints a 170x1440 column sixty times a second to
    # change nothing; damaging it when the hovered row changes repaints it when
    # there is something to see. The rectangle is the REGISTER BAND rather than
    # the whole rail, because the identity block, the workspace row, the stat
    # block and the clock cannot be hovered.
    nh = rail_slot_at(cx, cy)
    if nh != rail_hover {
        rail_hover = nh
        wm_damage(0, rail_dmg_y(), rail_w(), rail_dmg_h())
    }
    # RIGHT-CLICK OPENS THE FIELD MENU. Bit 1 is the right button - wm.c states
    # that mask where it explains why the double-click bit had to move - and
    # this function read bit 0 and nothing else, so a right press on the desk
    # produced down == 0 and fell straight out.
    #
    # The consequence was that a twelve-row surface had exactly one route: type
    # the word `ctxmenu` in the Terminal, which opens it at a fixed point. A
    # context menu reachable only by typing a command is not a context menu.
    #
    # Guarded on the same edge state the removed press-repaint used, so a held
    # right button opens it once rather than on every pointer event that arrives
    # while it is down.
    rdn = band(cbtn, 2)
    if rdn != rail_rpress {
        rail_rpress = rdn
        if rdn != 0 { return desk_menu_at(cx, cy) }
    }

    if down == 0 { return 0 }
    # the workspace row, checked before the register because it is below it and
    # rail_slot_at has already refused anything past the register band
    wn = rail_ws_at(cx, cy)
    if wn > 0 { return set_ws(wn) }
    if nh >= 0 { return rail_launch(nh) }
    return 0
}

# SUPER OPENS THE MENU. MOD_SUPER has been tracked by input.c since it was
# written and used for nothing; a modifier emits no event of its own, so there
# was nothing for a shortcut to fire on. input.c emits KEY_SUPER (0x11A) on a
# TAP now - pressed and released with no other key between - and wm.c routes it
# here rather than to whichever window has focus, because the start menu is the
# desktop's and not any app's.
fn desk_key(kcode, kmods) {
    # ESC DISMISSES WHATEVER IS UP, and it is tested first so a modal cannot
    # trap the desktop. The prototype prints "esc to dismiss" on two of its five
    # surfaces; a modal that lists a key it does not answer is worse than one
    # that lists none.
    # 27 IS THE SERIAL ESCAPE; 0x101 IS KEY_ESC FROM A REAL KEYBOARD.
    # This tested 27 alone, and 27 never arrives here from a keyboard - it is
    # the raw COM1 byte. The keycode is 0x101, from keycodes.h, which zl cannot
    # include. wm.c carries a comment about the twin of this bug: someone wrote
    # the Alt+Tab test with no KEY_TAB in scope, reached for '\t', and Alt+Tab
    # never fired. Its conclusion was to delete the copies and include the
    # header - and zl cannot do that, so this file IS a second copy of that
    # table and went wrong in the same way. Both values are tested because both
    # genuinely occur.
    if kcode == 27 or kcode == KEY_ESC_K {
        if ov_mode != OV_NONE {
            ov_mode = OV_NONE
            ov_sel = 0
            wm_damage(0, 0, px_w(), px_h())
            return 1
        }
    }
    # THE LOCK OWNS THE KEYBOARD, NOT JUST THE POINTER.
    #
    # ov_click was given an OV_LOCK arm so a press no longer dismisses the
    # sheet - and desk_key was not, so every printable key still fell straight
    # through to the focused app. Type at the PASSPHRASE well and the
    # characters landed in whatever window was behind it: the shell ran them,
    # the editor inserted them. A lock that stops the mouse and forwards the
    # keyboard is not modal, it is a screensaver with a caret.
    #
    # Escape is handled above this line and therefore still works, which is the
    # half that has to keep working: making a surface swallow the keyboard is
    # exactly how you lock someone out of their own machine, and probe-lock
    # presses Escape for that reason.
    if ov_mode == OV_LOCK { return 1 }
    # F1 IS ACTIVITIES, which is what the context menu says it is. A menu that
    # advertises a key the system does not answer is a picture of a menu, so the
    # row and the binding land together.
    # 0x120, not 0x13B. KEY_F1 is 0x120 (keycodes.h:39); 0x13B is 0x100|0x3B,
    # the Linux keycode, from a scheme this kernel does not use. Nothing has
    # ever emitted it.
    if kcode == KEY_F1_K {
        if ov_mode == OV_ACTIVITIES {
            ov_mode = OV_NONE
        } else {
            ov_mode = OV_ACTIVITIES
            ov_sel = 0
        }
        wm_damage(0, 0, px_w(), px_h())
        return 1
    }
    # ---- THE PALETTE IS DRIVEN, NOT JUST DRAWN ----------------------------
    # Everything below only fires while the palette is up, and returns 1 to say
    # the desk took the key. With no overlay open none of it matches and the
    # focused window gets its keys exactly as before.
    if ov_mode == OV_PALETTE {
        if kcode == K_UP {
            ov_sel = ov_sel - 1
            if ov_sel < 0 { ov_sel = ov_pal_nvis() - 1 }
            if ov_sel < 0 { ov_sel = 0 }
            wm_damage(0, 0, px_w(), px_h())
            return 1
        }
        if kcode == K_DOWN {
            ov_sel = ov_sel + 1
            if ov_sel >= ov_pal_nvis() { ov_sel = 0 }
            wm_damage(0, 0, px_w(), px_h())
            return 1
        }
        # Enter arrives as KEY_ENTER from a keyboard and as 13 or 10 down the
        # serial wire, the same split Escape has - input.c pushes the raw byte
        # for COM1 and a keycode for PS/2 and USB.
        if kcode == KEY_ENTER_K { return ov_pal_run(ov_sel) }
        if kcode == 13 { return ov_pal_run(ov_sel) }
        if kcode == 10 { return ov_pal_run(ov_sel) }
        # TYPING FILTERS. Backspace first, because 8 is under 32 and would
        # otherwise fall out with the other control codes.
        if kcode == 8 {
            if pal_pop() == 1 {
                ov_sel = 0
                wm_damage(0, 0, px_w(), px_h())
            }
            return 1
        }
        if kcode >= 32 {
            if kcode < 127 {
                if pal_push(kcode) == 1 {
                    # The selection goes back to the top: after a keystroke the
                    # list is a different list, and keeping an index into the
                    # old one selects whatever happens to have moved into that
                    # position.
                    ov_sel = 0
                    wm_damage(0, 0, px_w(), px_h())
                }
                return 1
            }
        }
    }
    # ---- THE KEYS THE MENUS ADVERTISE ------------------------------------
    #
    # The field menu has always printed CTRL K, CTRL G, CTRL L, ALT 1 and
    # ALT 2 beside its rows, and FIVE OF THE SIX had no handler anywhere in
    # the tree - only F1 did, and F1 was unreachable until this file's Escape
    # fix. kernel.zl's own comment two hundred lines up says "a menu that
    # advertises a key the system does not answer is a picture of a menu", and
    # the menu had been one since it was written.
    #
    # Ctrl+letter arrives as the ASCII control code: Ctrl+G is 7, Ctrl+K is 11,
    # Ctrl+L is 12. Alt is read from the modifier bitmap, MOD_ALT.
    if kcode == 11 {
        pal_clear()
        ov_mode = OV_PALETTE
        ov_sel = 0
        wm_damage(0, 0, px_w(), px_h())
        return 1
    }
    if kcode == 12 {
        ov_mode = OV_LOCK
        ov_sel = 0
        wm_damage(0, 0, px_w(), px_h())
        return 1
    }
    if kcode == 7 {
        # THE TOGGLE WAS INERT AND THE TOAST WAS THE ONLY EVIDENCE IT HAD RUN.
        #
        # draw_grid() is reached from draw_wallpaper() and desk_ground(), and
        # draw_wallpaper() is called ONCE, at boot, immediately followed by the
        # single wall_save(). Every later paint takes the `if wall_ok() == 1
        # { wall_paint(...) }` branch, which blits a bitmap baked with the grid
        # ON. So this flipped a flag, fired a toast saying the desk had changed,
        # and the desk did not change - a control that reports success and does
        # nothing, which is worse than one that visibly fails. I shipped it this
        # morning while fixing five other controls that did exactly that.
        #
        # The grid is IN the cache, so changing it means re-baking the cache.
        # That is a full wallpaper redraw, which is why it does not happen per
        # frame - but this is a keypress, and a keypress may cost a repaint.
        desk_grid_on = 1 - desk_grid_on
        rebake_wallpaper()
        # The crop marks and the slug now survive a grid-off, on their own
        # flags, which is what the prototype does. This comment used to explain
        # why they could not - "until this OS has that second switch" - and the
        # switch is draw_crop_marks() plus the desk_slug_on test in draw_grid.
        if desk_grid_on == 1 { note_say2("desk grid on", "12 x 8 module, ruled to the field margin", 800) } else { note_say2("desk grid off", "crop marks and the slug stay - they have their own switches now", 800) }
        wm_damage(0, 0, px_w(), px_h())
        return 1
    }
    # ALT+1 AND ALT+2 ARE ONE-BASED, because wm_set_ws is.
    #
    # These passed 0 and 1. wm.c refuses anything below 1 outright
    # (`if (n < 1 || n > ws_n || n == ws_cur) return 0;`), so Alt+1 switched to
    # nothing at all and Alt+2 switched to workspace 01 - one dead key and one
    # off by one, with a full-screen damage claimed either way. The comment in
    # the shortcut column above states the correct behaviour and has stated it
    # the whole time; only the two numbers were wrong.
    #
    # Routed through set_ws so the keyboard and the .wsb click share one entry
    # point, and returning set_ws's own answer so a refused switch (already on
    # that workspace) does not repaint the screen to accomplish nothing.
    if band(kmods, MOD_ALT_K) != 0 {
        if kcode == 49 { return ws_hotkey(1) }
        if kcode == 50 { return ws_hotkey(2) }
    }
    if kcode == KEY_SUPER_K { return open_menu() }
    return 0
}

# THE WINDOW'S OWN MENU. wm.c hands over the window it was pressed on, so the
# header can name the register row rather than say "window" - which is the whole
# difference between the prototype's `03 monitor` header and a generic one.
fn win_menu_at(wmw, wmx, wmy) {
    ov_mode = OV_MENU
    ov_menu_kind = OV_MENU_WIN
    ov_menu_win = wmw
    ov_menu_x = wmx
    ov_menu_y = wmy
    ov_sel = 0 - 1
    wm_damage(0, 0, px_w(), px_h())
    return 1
}

# THE DESK'S RIGHT-CLICK MENU. wm.c routes a click on the field here, and the
# prototype opens ctxmenu at the pointer with the field's own item list.
fn desk_menu_at(mx, my) {
    ov_mode = OV_MENU
    ov_menu_kind = OV_MENU_FIELD
    ov_menu_x = mx
    ov_menu_y = my
    ov_sel = 0 - 1
    wm_damage(0, 0, px_w(), px_h())
    return 1
}

# ---- THE WINDOW LIST IS THE REGISTER'S TAIL ---------------------------------
# There used to be a separate row of window chips beside the dock, for windows
# whose app had no launcher tile. It was the wrong shape twice over: nine
# launchers ended at 1244 px on a 1920 screen and the tray started at 1320, so
# 150-unit chips had 76 px to live in - and the answer to "where do I find the
# window I opened from the catalog" should never have been a second, differently
# shaped control next to the first one.
#
# The register absorbs it. draw_rail_reg walks the twelve fixed rows and then
# any open window with no fixed row, numbering straight on, and rail_slot_at
# walks the same list in the same order. So a catalog app appears as row 13 in
# the same column, with the same mark, and is raised by the same click. TASK_W,
# TASK_PITCH, task_x0, task_room, draw_tasklist and task_slot_at are all gone;
# what survives is the predicate that decides which windows are in the tail.

# Canonical product identity for every window/application id. This is separate
# from task_label(): a task chip may eventually abbreviate a name, but the
# manifest, launcher, diagnostics and provenance must all start from one exact
# identity. Everything in the registry delegates to reg_name(), whose slice
# tables own the remaining 47 current apps.
fn app_name(app) {
    if app == APP_SHELL   { return "Terminal" }
    if app == APP_MONITOR { return "System Monitor" }
    if app == APP_ABOUT   { return "About" }
    if app == APP_SNAKE   { return "Snake" }
    if app == APP_MENU    { return "Menu" }
    if app == APP_BROWSER { return "Browser" }
    if app == APP_SETTINGS { return "Settings" }
    if app == APP_RUN     { return "Run" }
    if app == APP_PAINT   { return "Paint" }
    if app == APP_CUBE    { return "3D" }
    if app == APP_ANIM    { return "zlOS animation" }
    if app == APP_MOUSE   { return "Pointer" }
    if app == APP_FILES   { return "Files" }
    if app == APP_EDIT    { return "Text Editor" }
    if app == APP_CATALOG { return "All Applications" }
    if app == APP_SYSPANE  { return "System" }
    if app == APP_TYPEPANE { return "Type" }
    # Every app-suite window falls through to the same registry the catalog
    # reads, so a new app's taskbar chip needs no entry here at all.
    if app >= REG_FIRST { return reg_name(app) }
    return "window"
}

# Does this app already have a fixed register row? If it does, that row IS its
# taskbar entry and a tail row beside it would be the same window listed twice.
# It is derived from rail_app() rather than restated, so the two tables cannot
# drift: adding an app to the register removes it from the tail automatically,
# which the old hand-written list demonstrably could not manage - it named
# APP_EDIT, APP_PAINT and APP_CUBE twice each and APP_RUN not at all.
# WHICH REGISTER ROW OWNS AN APP, or -1. app_has_slot answers yes/no over the
# same walk; the overview needs the row itself, to print its number and name on
# the tile. One walk, two callers, rather than a second table.
fn slot_of_app(app) {
    sa = 0
    while sa < REG_N {
        if rail_app(sa) == app { return sa }
        sa = sa + 1
    }
    return 0 - 1
}

fn app_has_slot(app) {
    if app == APP_MENU { return 1 }           # a modal, never listed at all
    if app == APP_CATALOG { return 1 }        # reachable from the ALL APPS row
    rs = 0
    while rs < REG_N {
        if rail_app(rs) == app { return 1 }
        rs = rs + 1
    }
    return 0
}

# WHAT A REGISTER ROW DOES. Rows 0..REG_N-1 open or raise a real window; rows
# past REG_ROWS are the tail and simply raise the window they name; REG_CATALOG
# opens "All Applications", which is the only route to the other forty-seven and
# was the dock's grid button before this.
#
# Four of the fixed rows still run a full-screen demo rather than opening a
# window, and that is stated rather than hidden - desktop-TODO 2e is the work
# that makes them all the first kind, and pretending otherwise here would just
# move the surprise.
fn rail_launch(slot) {
    if slot >= REG_ROWS {
        tw = rail_tail_win(slot)
        if tw < 0 { return 0 }
        wm_setfocus(tw)
        wm_raise(tw)
        return 0
    }
    if slot == REG_CATALOG { return reg_open(APP_CATALOG) }
    da = rail_app(slot)
    if da == APP_SHELL { return raise_shell() }
    if da == APP_BROWSER { return reopen_browser() }
    if da == APP_SNAKE { return open_snake() }
    if da == APP_CUBE { return open_app(118, 0) }
    if da == APP_MONITOR { return reopen_mon() }
    if da == APP_ABOUT { return reopen_about() }
    if da == APP_SETTINGS { return reopen_settings() }
    if da == APP_FILES { return reopen_files() }
    if da == APP_RUN { return open_run_window() }
    # THE EDITOR OPENS THROUGH THE SHELL, and it is keyed off the APP rather
    # than the slot number. This used to be rail_cmd(slot), a second table that
    # said "slot 4 is the editor, slot 5 is paint" - and the moment the register
    # became the prototype's fourteen, slot 4 was the kernel log and slot 5 was
    # hex, so clicking the log launched the editor. A table keyed by position,
    # sitting beside four other tables keyed by the same position, is the same
    # defect this branch spent the day removing: one fact in two places, and the
    # copy nobody edits wins silently.
    if da == APP_EDIT {
        raise_shell()
        run_command(105, 0)
        wm_damage_win_all()
        return 0
    }
    # THE SYSTEM AND TYPE PANES ARE ABOVE THE REGISTRY RANGE. app_draw already
    # says so - 71 and 72 are tested BEFORE the `id >= REG_FIRST` fall-through
    # precisely because reg_draw has never heard of them - and reg_open cannot
    # create a window for an app the registry does not own. Rows 10 and 14 of
    # the register went straight to it and got `reg: no window for app id 72`.
    #
    # Found by opening the type pane from the shell, not by the rail probe:
    # that probe clicks row 05, so it proved one row and implied nothing about
    # the other fourteen.
    if da == APP_SYSPANE { return open_syspane() }
    if da == APP_TYPEPANE { return open_typepane() }
    # EVERYTHING ELSE IN THE REGISTER IS A REGISTRY APP, addressed by its
    # manifest id - the id IS the app number, so no lookup is needed. reg_open
    # is the click path: it raises the window if the app is already open, and
    # otherwise opens it WITH focus, which is what a click should do. open_app
    # would be wrong here; it deliberately restores the previous focus because
    # the shell calls it mid-command-line.
    if da > 0 { return reg_open(da) }
    return 0
}

# One Terminal geometry authority for both boot and reopening. The terminal
# state lives in term.c; closing its window removes only the view. The old
# raise_shell() checked a stale window slot and did nothing after Ctrl+W, so the
# first dock tile could close Terminal but could never bring it back.
fn create_shell_window() {
    csu = ui()
    # THE COMPOSITION IS MEASURED FROM THE DESK, not from the screen. It used to
    # centre a 1280-unit composition inside px_w(); the desk is px_w() - 170 dp
    # wide now, so centring on the screen pushes the whole composition 85 dp
    # right and the leftmost window under the rail.
    # THE PROTOTYPE'S OWN RECT: presswork-prototype.html APPS shell p[14,12,640,400].
    # This was desk_x(24), desk_y(24), 600 x 368 - numbers re-origined from
    # ds.html, the PREDECESSOR document. design.h settles which wins: "THE SOURCE
    # IS docs/design/presswork-prototype.html ... If this header and the prototype
    # disagree, THE PROTOTYPE WINS." The old comments cite the oracle's
    # regions.json as the thing this composition answers to; that file records
    # source ds.html with its sha, is generated into a 1280-wide screen, lives
    # outside the repo in ~/Downloads, and is wired into no gate - so nothing has
    # ever compared this composition to anything.
    if field_w() >= PROTO_FIT * csu {
        return wm_open(APP_SHELL, "Terminal", desk_x(14), desk_y(12), 640 * csu, 400 * csu)
    }
    return wm_open(APP_SHELL, "Terminal", desk_x(8), desk_y(8), field_w() - 16 * csu, field_h() - 16 * csu)
}

fn raise_shell() {
    if shell_win >= 0 {
        if wm_open_p(shell_win) == 1 {
            wm_setfocus(shell_win)
            wm_raise(shell_win)
            return 0
        }
    }
    shell_win = create_shell_window()
    if shell_win >= 0 {
        wm_setfocus(shell_win)
        wm_raise(shell_win)
        wm_report(shell_win)
    }
    return 0
}

mon_win = 0 - 1
about_win = 0 - 1

# ---- WHERE A WINDOW MAY BE PUT ----------------------------------------------
# EVERY window position in this file used to be measured from the screen's own
# origin, because the screen's origin was the desktop's: the top bar floated
# over the wallpaper and the dock floated over it, so a window at x=16 was on
# the desk. PRESSWORK's rail is 170 dp of OPAQUE plate at x=0, so x=16 is now
# UNDER it - the window is drawn, the compositor composites it, and the rail
# repaints over its left 154 columns. Nothing errors; the window is just partly
# invisible, which is the worst kind of wrong.
#
# So the desk has an origin of its own and every placement goes through it. Two
# functions, one for each axis, and they take DESIGN UNITS so a call site that
# already said `132 * u` becomes `desk_x(132)` with the scale folded in.
fn desk_x(dux) { return field_x() + dux * ui() }
fn desk_y(duy) { return field_y() + duy * ui() }
# ...and the right edge, for the two windows anchored to it. There is no desk_b:
# nothing in the boot composition is bottom-anchored, and a helper with no
# caller is a helper nobody has ever run.
fn desk_r(w) { return field_x() + field_w() - w }

fn reopen_browser() {
    u = ui()
    if browser_win >= 0 { if wm_open_p(browser_win) == 1 { wm_setfocus(browser_win)  wm_raise(browser_win)  return 0 } }
    browser_win = wm_open(APP_BROWSER, "Browser", field_x() + (field_w() - 800 * u) / 2, desk_y(220), 800 * u, 440 * u)   # float ok - a centring offset, not an index; the name ends in "win"
    wm_setfocus(browser_win)
    wm_raise(browser_win)
    return 0
}
fn reopen_settings() {
    u = ui()
    if settings_win >= 0 { if wm_open_p(settings_win) == 1 { wm_setfocus(settings_win)  wm_raise(settings_win)  return 0 } }
    # 660 x 720 dp, and both numbers are the CONTENT's, not a taste. 660 is
    # what the widest mono line in the pane needs: 67 characters at cell_w
    # plus the well's 8dp padding either side, plus the body's 9dp margins,
    # plus the plate's 1px ring and the focus bar's gutter. A narrower window
    # ellipsises a paragraph that is an argument. 720 is the prototype's own
    # settings window height; the body scrolls past it either way.
    settings_win = wm_open(APP_SETTINGS, "Settings", desk_x(120), desk_y(40), 660 * u, 720 * u)
    wm_setfocus(settings_win)
    wm_raise(settings_win)
    return 0
}
fn reopen_mon() {
    u = ui()
    if mon_win >= 0 { if wm_open_p(mon_win) == 1 { wm_setfocus(mon_win)  wm_raise(mon_win)  return 0 } }
    mon_win = wm_open(APP_MONITOR, "System Monitor", desk_r(MON_W * u + 16 * u), desk_y(16), MON_W * u, MON_H * u)
    wm_setfocus(mon_win)
    return 0
}
fn reopen_about() {
    u = ui()
    if about_win >= 0 { if wm_open_p(about_win) == 1 { wm_setfocus(about_win)  wm_raise(about_win)  return 0 } }
    about_win = wm_open(APP_ABOUT, "About", desk_r(AB_W * u + 16 * u), desk_y(16) + (MON_H + 16) * u, AB_W * u, AB_H * u)
    wm_setfocus(about_win)
    return 0
}
# THE FILES ROW HAD NO REOPEN, and that is not an oversight this change made -
# Files was in the boot composition and in nothing else, so once you closed it
# the only route back was the catalog. It is register row 02 now, so it needs
# one, and it is the same shape as the other four.
fn reopen_files() {
    u = ui()
    if files_win >= 0 { if wm_open_p(files_win) == 1 { wm_setfocus(files_win)  wm_raise(files_win)  return 0 } }
    files_win = wm_open(APP_FILES, "Files", desk_x(FILES_X), desk_y(FILES_Y), FILES_W * u, FILES_H * u)
    wm_setfocus(files_win)
    wm_raise(files_win)
    return 0
}

# ---- the start menu, as a MODAL WINDOW --------------------------------------
# The old one drew straight onto the screen and saved the patch underneath with
# grab/stamp - the sticker technique C4 deleted, at menu size. wm.c has had
# WF_MODAL since it was written and NOTHING EVER SET IT, which is the exact
# hazard HANDOFF.md names for intel.c: the code exists, so it looks done, and
# it has no caller. This is the caller.
#
# A modal takes every event and a click outside dismisses it - both already in
# route_mouse. Restoring what was underneath is a repaint of the damage it
# leaves, which needs no saved bitmap at all.
# 10 rows now: the original 8 plus Settings and All Applications, both of
# which existed already (settings.c; the catalog above) and had no caller
# anywhere on the running desktop until this brief.
# TWELVE, and the two new rows are 10 SYSTEM and 14 TYPE. THIS IS A TEMPORARY
# HOME FOR THEM. In the prototype both are REGISTER rows - system at 10, type
# at 14 - and the register is where they belong; the register table here is
# still the shipped twelve and renumbering it to the prototype's fourteen is
# the shell's own piece of work, being done separately. Until it lands, a menu
# row is what keeps these two reachable, and an app with no launch route is
# dead code in exactly the way a native with no registration is.
MENU_ROWS = 12
menu_win = 0 - 1

fn menu_label(idx) {
    if idx == 0 { return "Terminal" }
    if idx == 1 { return "Snake" }
    if idx == 2 { return "System Monitor" }
    if idx == 3 { return "About" }
    if idx == 4 { return "3D Cube" }
    if idx == 5 { return "Paint" }
    if idx == 6 { return "Editor" }
    if idx == 7 { return "Settings" }
    if idx == 8 { return "System" }
    if idx == 9 { return "Type" }
    if idx == 10 { return "All Applications" }
    return "Halt"
}

fn menu_pick(idx) {
    if idx == 0 { return raise_shell() }
    if idx == 1 { return open_snake() }
    if idx == 2 { return reopen_mon() }
    if idx == 3 { return reopen_about() }
    # Settings (settings.c) is compiled into every build and wmglue.c has
    # dispatched its draw/event since it was written - it just had nothing
    # anywhere that called wm_open(APP_SETTINGS, ...). This is that call.
    if idx == 7 { return reg_open(APP_SETTINGS) }
    if idx == 8 { return open_syspane() }
    if idx == 9 { return open_typepane() }
    if idx == 10 { return reg_open(APP_CATALOG) }
    if idx == 11 { wm_stop()  return 0 }
    raise_shell()
    if idx == 4 { run_command(118, 0) }
    if idx == 5 { run_command(100, 0) }
    if idx == 6 { run_command(105, 0) }
    wm_damage_win_all()
    return 0
}

menu_bx = 0
menu_by = 0
fn open_menu() {
    u = ui()
    if menu_win >= 0 { if wm_open_p(menu_win) == 1 { wm_close_fx(menu_win)  menu_win = 0 - 1  return 0 } }
    mh = MENU_ROWS * (ui_metric(UM_ROW_H) + ui_metric(UM_GAP)) + 2 * ui_metric(UM_PAD) + ui_metric(UM_TITLE_H)
    # AGAINST THE RAIL, NOT AGAINST THE DOCK. The menu used to sit 8 dp above
    # the dock at x=10, which is under the rail now. It hangs off the rail's
    # inner edge instead, bottom-aligned with the desk, which is where a menu
    # opened from a left-hand register belongs.
    mx = field_x() + 8 * u
    my = field_y() + field_h() - mh - 8 * u
    if my < field_y() { my = field_y() }
    # This used to blur what is behind the menu here, before the window existed,
    # because wm.c draws the chrome and then calls app_draw - by which time the
    # panel fill is already sitting in the client rect and there is nothing left
    # underneath to blur. The blur is gone (DECISIONS #29); the menu is an
    # OPAQUE panel now, so there is nothing to capture and the ordering problem
    # that made this awkward has gone with it.
    menu_bx = mx
    menu_by = my
    menu_win = wm_open(APP_MENU, "zlOS", mx, my, 210 * u, mh)
    # zov / zpop in the prototype: the menu fades in over the desktop behind
    # it. This is a REAL fade - the rectangle is stashed before the window is
    # drawn on it and blended back - not a tint pretending to be one.
    #
    # THE `wm_anim(menu_win, 5)` THAT USED TO BE HERE IS GONE, and its absence
    # is the point. It was ANIM_FADE's only caller in the entire tree, so this
    # menu faded and every other overlay in the system appeared instantly.
    # wm_modal() starts it now: "becoming modal" is the one thing a popover, a
    # dialog and a context menu have in common, so an overlay written next
    # year is animated by having been written rather than by somebody
    # remembering this line.
    wm_modal(menu_win, 1)
    return 0
}

menu_hover = 0 - 1
fn menu_draw(ax, ay, aw, ah) {
    fill_rgb(ax, ay, aw, ah, theme(TH_PANEL))
    ui_begin(ax, ay, aw, ah, 0, 0, 0, 0)
    # THE NORTHSTAR'S ANSWER FOR A FLOATING theme(TH_PANEL), which is not a tint over a
    # blur - it has no blur anywhere and its only panel rule is opaque:
    #
    #   .win{ background:var(--panel); border:1px solid var(--line) }
    #     --panel #05060a   --line #26304a
    #
    # An alpha tint over an UNBLURRED desktop reads as a rendering fault rather
    # than as translucency, so removing the blur and keeping the 205/255 tint
    # would have been the worst of the three options. The border is drawn as the
    # outer rrect with the panel one unit inside it, the same nesting the window
    # frame uses, so the hairline follows the curve instead of cutting it.
    mi = 0
    while mi < MENU_ROWS {
        ui_list(menu_label(mi), mi == menu_hover)
        mi = mi + 1
    }
    return 0
}

fn menu_row_at(win, ey) {
    cy = wm_cy(win)
    r = idiv(ey - cy - ui_metric(0), ui_metric(2) + ui_metric(1))   # idiv: a row INDEX
    if r < 0 { return 0 - 1 }
    if r >= MENU_ROWS { return 0 - 1 }
    return r
}

# A press inside the menu picks a row. wm.c hands the pointer position in
# SCREEN coordinates, which is what the client rect is measured in too, so the
# row is one subtraction - and the same arithmetic the draw above uses, which
# is the only way a menu responds where it looks.
fn menu_event(ety, ecode, ex, ey, win) {
    if ety != 4 { return 1 }
    # HOVER, and only repaint when the row CHANGES - the same rule the dock
    # follows and for the same reason: a repaint per pointer event redraws the
    # whole panel sixty times a second to change nothing.
    nh = menu_row_at(win, ey)
    if nh != menu_hover {
        menu_hover = nh
        wm_dmg(win)
    }
    if band(ecode, 1) == 0 { return 1 }
    ui_begin(wm_cx(win), wm_cy(win), wm_cw(win), wm_ch(win), 1, ex, ey, 1)
    idx = 0 - 1
    mi = 0
    while mi < MENU_ROWS {
        if ui_list(menu_label(mi), mi == menu_hover) == 1 { idx = mi }
        mi = mi + 1
    }
    menu_hover = 0 - 1
    wm_close_fx(win)
    menu_win = 0 - 1
    if idx >= 0 { if idx < MENU_ROWS { menu_pick(idx) } }
    return 1
}

# ---- bringing the compositor up --------------------------------------------
# Called from the boot sequence BEFORE the boot log prints, because the log
# goes inside window 0 and a window has to exist to be printed into. Returns 1
# if the desktop is up and the frame loop is worth entering.
fn wm_boot_start() {
    if wm_avail() == 0 { return 0 }
    u = ui()
    ui_theme(u)
    # Read-only discovery makes the already-written frame counter/vblank path
    # reachable. Non-Intel and unsupported devices simply keep TSC pacing.
    intel_find()
    wm_init()
    # HOW MANY WORKSPACES THERE ARE, told to the compositor rather than
    # duplicated inside it. wm.c defaults to 1 - which is what keeps the host
    # tests, none of which call this, behaving exactly as they did before
    # workspaces existed - and refuses any switch past the ceiling, so
    # Super+9 cannot strand you on an empty workspace with no pip to return
    # from. WS_N is this file's, because three pips is a design decision.
    wm_wsn(WS_N)
    # ZSWEEP, ON. The band drifting down the wallpaper is off in wm.c by
    # default for the same reason wm_wsn exists: the host gates never call this
    # function, and several of them assert that a region is EXACTLY the
    # wallpaper colour. Turning it on here is the policy decision - the
    # reference keeps it behind its own `crtOn` toggle too - and it stays under
    # the Settings animation switch on top of that.
    # The reference treats this as an optional CRT overlay. At 2560x1440 its
    # moving band damages roughly a third of the panel about fourteen times a
    # second forever, so making it a boot default turns decoration into steady
    # compositor load. Keep the effect available, but start the real desktop
    # quiet and repaint only for actual state changes.
    wm_sweep(0)
    if wm_bind() == 0 {
        color(C_RED)  print("  wm: kernel.zl defines no app_draw - nothing to composite")
        color(C_GREY)
        return 0
    }
    # THE CONSOLE STOPS PAINTING HERE. It draws at its own cursor inside its
    # own scrolling region and knows nothing about windows, so with the
    # compositor repainting from damage every printed line landed twice: once
    # in the shell window from term.c's scrollback, and once as raw text
    # scrolling across the desktop underneath it. Muting stops the pixels only
    # - the tee into the scrollback and the write to COM1 both continue, so the
    # window has a complete transcript to redraw from and every automated gate
    # reads exactly what it read before.
    con_mute(1)
    # THE SHELL IS WINDOW 0, and it is opened FIRST so the boot log that
    # follows lands inside it - the same ordering draw_desk relied on, now
    # expressed through wm_open.
    # Compose the first desktop like a workspace, not a diagnostic dashboard.
    # Terminal is a compact command surface, Browser anchors the lower half
    # and Resources balances it on the right. Empty black client area is not
    # minimalism here; it reads as an unfinished debug panel.
    # THE BOOT COMPOSITION IS THE REFERENCE'S, EXACTLY. ds-reference.html's
    # initial state opens three windows - `open:{term:true, mon:true,
    # files:true}` - and its APPS table gives each one a size and a position:
    #
    #   term   600 x 368  at 132, 60
    #   files  672 x 352  at 238, 346
    #   mon    424 x 376  at 758, 76
    #
    # These are not "about right". They are the numbers, and they are what the
    # oracle's regions.json compares against - win_term, win_files, win_mon are
    # three of its named boxes. A Terminal 680 wide at y=140 scores as WRONG on
    # structure no matter how good it looks, because it is not where the thing
    # it is being compared to is.
    #
    # BROWSER IS NOT IN THE REFERENCE'S BOOT SET and is no longer in ours. It
    # was anchoring the lower half, where Files belongs; leaving it there put a
    # window over the dock and left Files closed, so two of the three boxes
    # were empty and a fourth was occupied by something with no counterpart.
    # THE THREE POSITIONS ARE THE REFERENCE'S, RE-ORIGINED ON THE DESK. They
    # were `desk_ox + 238` and `desk_ox + 758` measured from the screen, with
    # desk_ox centring a 1280-unit composition inside px_w(). The desk is
    # px_w() - 170 dp wide now and starts at 170, so the same arithmetic puts
    # Terminal's left edge 24 dp inside the rail. Subtracting the rail from the
    # composition's own origin keeps all three windows in the same relationship
    # to each other and to the desk, which is what the oracle's regions.json
    # compares - it names win_term, win_files and win_mon relative to the
    # composition, not to the panel.
    if field_w() >= PROTO_FIT * u {
        shell_win = create_shell_window()
        files_win = wm_open(APP_FILES, "Files", desk_x(FILES_X), desk_y(FILES_Y), FILES_W * u, FILES_H * u)
        # MON_W/MON_H, not a second copy of the size. This line said 424 x 376
        # while reopen_mon() opened MON_W x MON_H, so the monitor was one size at
        # boot and a different size the moment you closed and reopened it - the
        # same one-fact-many-copies shape the reserves and the app count were.
        mon_win = wm_open(APP_MONITOR, "System Monitor", desk_x(14), desk_y(430), MON_W * u, MON_H * u)
        # THE BOOT SET GETS ITS WORKSPACE FROM THE TABLE, not from whichever
        # one happens to be current. wm_open puts a new window on the current
        # workspace - correct for everything a person launches, and the wrong
        # source for the composition the desktop builds for itself. All three
        # are ws 1 in the reference, so today these three calls change nothing
        # and are refused as no-ops; they are here so that the day the boot set
        # gains a fourth window, its workspace comes from the same place its
        # size and position already do.
        wm_setwinws(shell_win, app_ws(APP_SHELL))
        wm_setwinws(files_win, app_ws(APP_FILES))
        wm_setwinws(mon_win, app_ws(APP_MONITOR))
    } else {
        shell_win = create_shell_window()
    }
    # THE SHELL TAKES THE KEYBOARD BACK. wm_open focuses whatever it just
    # opened, and the shell has to be opened FIRST for an unrelated reason -
    # the boot log prints into it, so it must exist before the log runs. Those
    # two facts together handed every keystroke on a fresh desktop to the About
    # window, which has no app_event at all: typing did nothing and said
    # nothing. Focus is policy, so it is stated here rather than inherited from
    # the order the windows happened to be created in.
    wm_setfocus(shell_win)
    wm_raise(shell_win)
    # ...and bake the wallpaper. It has to happen while nothing is on top of
    # it, which is now, and it has to happen after wm_init so the mode is
    # settled. wall_save() prints what it took and what is left; if it refuses
    # - a 4K RGB565 cache now fits the 16 MiB arena; if any future mode or
    # competing effect does not, desk_draw falls back to the plain gradient
    # and says so rather than drawing nothing.
    # THE STATIC FURNITURE IS BAKED IN WITH THE WALLPAPER, and this is the
    # single biggest thing that made the desktop slow.
    #
    # Measured, with the frame timer that should have existed first: hovering
    # one dock tile cost 7,426 us and peaked at 18,455 us - over the whole
    # 16.67 ms budget, to light up one chip. The dock strip is 1920x128 =
    # 245,760 px and the tint over it is 22.16 cyc/px, so recompositing
    # blur-then-tint every time anything in the dock changed was ~2.4 ms of
    # blend on its own, plus the blur blit, plus nine tiles.
    #
    # None of that ever CHANGES. The blur is of a wallpaper that is fixed, the
    # tint over it is fixed, and eight of the nine tiles look the same as they
    # did last frame. So all of it goes into the cached bitmap once, and a
    # frame pays one blit at 1.54 cyc/px for the lot.
    # WHAT IS BAKED AND WHAT IS NOT, and the split is the four bands' own:
    #   baked   the desk - ZD_VOID, the raking light, the ruled module grid, the
    #           crop marks and the measured legend - and the rail's STATIC half:
    #           its ground, its two runs, the identity block, the two section
    #           captions and the four rules between them.
    #   live    the register rows (four states, all of them functions of what is
    #           open), the workspace row, the stat block, the clock, the raster
    #           strip and the foot. None of those can be cached because none of
    #           them is the same twice.
    # SAMPLE THE CMOS ONCE BEFORE THE FIRST FRAME. rail_clock_tick() would get
    # there within a second anyway, but "within a second" means the desktop's
    # first painted frame - the one a screenshot gate captures and the one a
    # person sees at boot - carries a midnight the machine never claimed. The
    # cost is a single read on a path that has just spent milliseconds on the
    # wallpaper. rtc_here() guards it so a machine with no CMOS at all does not
    # spin the update-in-progress loop for nothing.
    if rtc_here() == 1 { rtc_up() }
    draw_wallpaper()
    draw_rail_static()
    # SHELL_BAKED IS THE RETURN VALUE, not 1. wall_save() returns 0 when the
    # arena cannot hold the bitmap and it was being ignored, so on any screen
    # where the cache is refused the flag still said "the furniture is in the
    # wallpaper". desk_draw and draw_status both skip the rail's static half
    # when it is set, and the wallpaper they were relying on does not exist, so
    # it was painted once at boot and then never again: a rail that vanishes
    # under the first window you move. Only true when the save actually happened.
    shell_baked = wall_save()
    # SAY THAT THE COMPOSITOR STARTED, on the serial line, from the BOOT path.
    #
    # con_mute mutes only the pixels, so this reaches a headless gate and lets
    # it tell "the compositor is up with windows in it" from "it never got
    # there" - which are otherwise the same silence. verify-iso.sh greps for
    # exactly this and desktop/apps-in-windows is where that check came from.
    #
    # It used to live only in wm_session(), which is the `w` command. That was
    # enough on apps-in-windows, whose boot path WAS wm_session(); it is not
    # enough here, where wm_boot_start() opens the windows and the frame loop
    # runs directly. Same marker, emitted where the windows actually appear.
    # ---- FIND THE INTEL GPU, HERE, once, at boot ---------------------------
    # intel_find() had exactly two callers and both were interactive shell
    # commands - `P` and `k`, kernel.zl:1496 and :1539. So on a desktop nobody
    # typed a diagnostic into, `mmio` was 0 for the entire session, and every
    # consequence of that is silent rather than loud: mmio_r() returns 0 when
    # mmio is 0, so intel_frame_count() answered 0 forever, and
    # intel_wait_vblank() (zl: gpu_vbl) tested intel_pipe_enabled(), read 0 out
    # of a register it never mapped, and reported "no vblank" immediately. Not
    # an error anywhere - just a driver that was never asked to look.
    #
    # That is what blocks the pacing work in docs/desktop/look-and-speed.md §4: replacing the
    # 100 Hz PIT release with a 59.998 Hz panel deadline starts by being able to
    # read the frame counter, and nothing could.
    #
    # WHAT THIS TOUCHES, precisely, because intel.c is the one file here that
    # can damage hardware: a PCI scan, then pci_enable() setting memory-decode
    # and bus-master on a device the firmware is ALREADY scanning out of, then
    # two BAR reads. No panel register, no AUX, no power sequencing - none of
    # intel.c's hazard list (the 500 ms T12 delay, AUX into an unpowered panel)
    # is reachable from here, and nothing arms lt_armed.
    #
    # It lives inside wm_boot_start rather than in the boot log because
    # wm_avail() is 0 on verify.sh - no framebuffer, no compositor - and that
    # gate diffs its whole transcript against golden.txt byte for byte.
    if intel_find() < 0 {
        # TWO DIFFERENT FACTS, and printing the wrong one sends the next reader
        # looking for a missing device. intel_find() returns -1 both when there
        # is no Intel display controller and when there IS one whose 64-bit BAR
        # sits above 4 GiB, which a 32-bit build cannot address - and which it
        # now refuses rather than truncating, because the low dword of a high
        # BAR is a different, unrelated physical address.
        if intel_hibar() == 1 {
            info_line("Intel GPU found but its BAR is above 4 GiB - refused, not truncated")
        } else {
            info_line("no Intel GPU on the bus - vblank pacing unavailable here")
        }
    } else {
        if intel_ok() == 0 {
            info_line("Intel GPU present but not Gen9 - vblank pacing unavailable")
        } else {
            # THE PIXEL CLOCK, NOT THE FRAME COUNTER, and that ordering is a
            # correction: the first version of this line printed the frame
            # counter as the liveness fact, on the reasoning that 0 means the
            # pipe is not scanning out. `hosttest/intel_probe` against this
            # laptop's own GPU refutes it -
            #
            #     frame counter   0 -> 0 in 0.5 s  =  0.0 Hz   <- frozen: PSR is on
            #     pixel clock     241690 kHz  (from PIPE_LINK_M1/N1 - PSR-immune)
            #
            # - and intel.c's own comment above intel_pixel_clock_khz() had said
            # so all along: with self-refresh on, the panel redraws from its own
            # memory, the pipe is not fetching, and PIPE_FRMCNT does not move.
            # Firmware leaves PSR on here (EDP_PSR_CTL = 0x81F00406). So a
            # zeroed frame counter on this machine means PSR, not a dead pipe,
            # and printing it as a health indicator would be exactly the thing
            # the northstar forbids: a status that claims something the machine
            # has not proved.
            color(C_GREY)  put("  [")
            color(C_GREEN) put("  OK  ")
            color(C_GREY)  put("] Intel 0x")  hex(intel_id(), 4)
            put(" mapped at boot, pipe ")     put(intel_pipe())
            put(", pixel clock ")             put(gpu_clk())  print(" kHz")
            # Say which of the two clocks the pacing work can actually use, on
            # THIS machine, rather than leaving the next session to rediscover
            # PSR the expensive way.
            #
            # GATED ON THE PIPE BEING ON, because 0 has two causes and only one
            # of them is PSR: a supported Gen9 part whose pipe A is disabled -
            # another adapter supplied the boot framebuffer, say - also reads 0,
            # and blaming PSR there is a diagnosis nobody checked. With the pipe
            # enabled and the counter at 0 the panel is scanning from its own
            # memory, which is what PSR is. Even then it is stated as the
            # reading plus its cause, not as a verdict: HANDOFF.md records that
            # this counter is INTERMITTENTLY zero, not reliably so - 0 idle,
            # a correct 60.0 Hz with a terminal scrolling.
            if intel_pipe() == 1 {
                if gpu_frames() == 0 {
                    info_line("PIPE_FRMCNT reads 0 with pipe A on - that is PSR; pace off the pixel clock")
                }
            }
        }
    }

    color(C_GREEN)  put("  compositor: ")
    color(C_GREY)   put(wm_n())  put(" windows, shell client ")
    put(wm_cx(shell_win))  put(",")  put(wm_cy(shell_win))  put(" ")
    put(wm_cw(shell_win))  put("x")  print(wm_ch(shell_win))
    # ...AND EVERY WINDOW'S RECTANGLE, WHICH THIS PATH WAS NOT DOING.
    #
    # The comment above records moving the compositor marker out of
    # wm_session() and into the boot path, because wm_session() is the `w`
    # command and nothing with a framebuffer reaches it. That move was HALF
    # DONE: the marker came here, the wm_report loop underneath it did not.
    #
    # So wm_report's own header - "printed when the session starts AND whenever
    # a window opens afterwards" - described a thing that on the shipped boot
    # path happened NEVER, and every pointer gate that reads those lines was
    # aiming at nothing. probe-drag.py without --grab exits with "the
    # compositor reported no window rects", and probe-urlbar.py found it by
    # doing exactly that.
    #
    # A written rationale nobody ran is a guess with a citation. Same marker,
    # same loop, emitted where the windows actually appear.
    wi = 0
    while wi < wm_n() {
        wm_report(wi)
        wi = wi + 1
    }

    return 1
}

# 'w' used to launch the compositor. The compositor IS the desktop now, so the
# only two machines that can reach this are one with no framebuffer, and a
# mistake.
fn wm_session() {
    if wm_run() == 1 {
        color(C_GREY)  print("  the compositor is already the desktop - you are in it")
        return 0
    }
    color(C_GREY)  print("  the compositor needs the framebuffer console")
    # SAY THAT THE COMPOSITOR STARTED, and say WHERE THE SHELL IS. It reaches
    # the serial log even though the console's pixels are muted, because
    # con_mute mutes only the pixels - so a headless gate can tell "the
    # compositor is up and listening" from "the w never arrived", which are
    # otherwise the same silence. probe-term.py waits on this line rather than
    # on a wall-clock guess, and crops its screendump to the rectangle printed
    # here rather than recomputing this layout in Python, where it would go
    # stale the first time a window moves.
    color(C_GREEN)  put("  compositor: ")
    color(C_GREY)   put(wm_n())  put(" windows, shell client ")
    put(wm_cx(shell_win))  put(",")  put(wm_cy(shell_win))  put(" ")
    put(wm_cw(shell_win))  put("x")  print(wm_ch(shell_win))
    # ...and where every window's TITLE BAR is, which is what a pointer gate
    # has to aim at. probe-drag.py used to carry hardcoded coordinates
    # (2110,120 - off the right edge of a 1920-wide screen) and reported
    # "NOTHING MOVED - dragging is a no-op" for a drag that worked perfectly.
    # A gate that fails for a reason unrelated to the code costs a bisect
    # every time, which is the rule verify-raw.sh was rewritten for.
    wi = 0
    while wi < wm_n() {
        wm_report(wi)
        wi = wi + 1
    }
    while wm_run() == 1 { wm_frame()  blk_work()  dhcp_work()  idle() }
    con_mute(0)
    return 0
}

# ---- the full desktop: wallpaper + header + a terminal window + the dock ----
# The shell no longer prints raw onto the screen - it lives inside a real
# window frame (shadow, rounded border, title bar) sitting on the wallpaper,
# with the dock along the bottom. This is what turns "a console" into "a
# desktop". The console text region is set to the window's interior so every
# line the shell prints lands inside the frame.
# the STATIC desktop: wallpaper, header, the fixed terminal window, the dock.
# Everything here stays put, so it becomes the "background" a dragged window is
# lifted off of and dropped back onto.
# Work out where everything sits for the screen we actually got. Our bootloader
# takes the widest mode the card offers, so that is 1280x1024 on one machine and
# 800x600 on another - nothing may be hard-coded to one size. The right-hand
# column is anchored to the right edge and the terminal fills what is left, which
# reproduces the old 800x600 layout exactly and grows from there.
fn layout() {
    # EVERY ONE OF THESE IS MEASURED FROM THE DESK NOW. The rail is 170 dp of
    # opaque plate at x = 0 and the foot is 46 dp at the bottom, so a terminal
    # at x = 16 spanning to the old dock_y() is a terminal with its left edge under
    # rail and its bottom edge under the foot. field_x/y/w/h is the one origin.
    mon_x = desk_r((MON_W + 16) * ui())
    mon_y = desk_y(8)
    ab_x  = mon_x
    ab_y  = mon_y + (MON_H + 16) * ui()
    term_x = desk_x(16)
    term_y = desk_y(8)
    term_w = mon_x - term_x - 16 * ui()
    term_h = field_y() + field_h() - term_y - 16 * ui()
    lcw = cell_w()                             # the console text box, in cells -
    lch = cell_h()                             # which are 8x16 or 16x32 now
    # round the top-left UP to the next whole cell, the bottom-right DOWN, so
    # the text can never sit on the title bar or spill past the frame
    term_c0 = idiv(term_x + 10 + lcw - 1, lcw)
    term_c1 = idiv(term_x + term_w - 12, lcw)
    term_r0 = idiv(term_y + 34 + lch - 1, lch)
    term_r1 = idiv(term_y + term_h - 16, lch)
    return 0
}

fn draw_desk() {
    if px_w() > 0 {
        desk_ground()                                                             # the desk and its ruling
        draw_window(term_x, term_y, term_w, term_h, "zl shell   ~", 1)
        text_box(term_c0, term_c1)
        region(term_r0, term_r1)
        draw_status("ready")
        goto_row(term_r0)
        present()
    } else {
        cls()
        draw_strip()
        region(5, status_row() - 1)
        draw_status("ready")
        goto_row(5)
    }
}

# GIVING THE SCREEN BACK. Every full-screen demo in this file ends by calling
# this, and each one used to mean "redraw the static desktop and re-composite
# the two draggable windows over it" - which under a compositor would paint a
# second, stale desktop on top of the real one.
#
# Under the compositor the correct answer is not to draw anything at all: mark
# the whole screen damaged and let wm_frame repaint it from the window table,
# in z-order, with the scissor set. One place says this, so all seven demos got
# it right at once rather than seven times.
fn draw_screen() {
    if wm_run() == 1 {
        wm_damage(0, 0, px_w(), px_h())
        return 0
    }
    draw_desk()
    return 0
}

# ---- the start menu, and where it went --------------------------------------
# open_menu / close_menu / menu_cmd lived here. They drew the menu straight
# onto the screen and used grab/stamp to save and restore the patch underneath
# - the same sticker technique C4 deleted, at menu size.
#
# The compositor already has the mechanism this needs and it is strictly
# better: WF_MODAL. A modal window takes every event, a click outside dismisses
# it, and it is restored by repainting the damage under it rather than by
# stamping back a bitmap. That is desktop-TODO C5, and it is a wm_open call
# with a flag, not a redraw of this file. Deleting the old one now keeps two
# implementations of "the start menu" from existing at the same time.
# ---- the start menu --------------------------------------------------------
# Click the zlOS button and a menu pops up above the dock. It used to grab()
# the patch of screen underneath and stamp() it back on close - the same
# save-under C4 deleted. Closing now redraws instead, which is what the
# compositor does for every window and needs no buffer. (C5 makes this a real
# WF_MODAL window; until then this path is text-mode only and never runs,
# because px_w() is 0 wherever the text shell is.)


# map a menu row (0..7) to the command it launches

# ---- boot ------------------------------------------------------------------
# TAKE THE MACHINE BEFORE USING THE MACHINE.  On UEFI, efi.c deliberately
# enters main() with interrupts disabled: the firmware's IDT stopped being a
# service at ExitBootServices, and only setup_idt() may turn interrupts back
# on.  The old order did settings/NVMe discovery, resolution selection,
# intel_find(), window construction and a full desktop paint before installing
# our GDT, IDT and timer.  Besides making every timed wait fall back to a spin,
# that left all of the hardware most likely to fail in front of the USB flight
# recorder.
#
# Keep these calls silent here and keep their status lines in the established
# boot transcript below.  That preserves the byte-for-byte headless gate while
# making the actual ownership order match the dependency order:
#
#     GDT -> IDT/PIT -> APIC -> xHCI -> ZLLOG -> storage/display/desktop
#
# The first physical audit run proved that controller ownership alone is not
# enough. The Intel scan had not classified the mass-storage interface yet, so
# diag_up() refused, settings and the compositor ran without a durable witness,
# and only the later reporting pass finished enumeration. Complete that pass
# here. It is idempotent, and it puts the real dependency order on the machine:
# xHCI enumeration -> ZLLOG mount -> allocators -> compositor.
setup_gdt()
setup_idt()
fb_wc()
boot_apic = apic_up()
boot_usb = usb_boot()
diag_boot = diag_up()

kbd_init()
# READ THE SAVED SETTINGS BACK. settings.c writes one record per gesture and
# settings_load() had no caller anywhere, so accent, scale, pointer speed,
# subpixel and animation were all persisted to NVMe and then thrown away on
# every boot. It applies what it finds, prints why when it finds nothing, and
# never writes - so a read-only boot stays read-only.
set_load()
# Mount an existing zlfs volume without formatting unknown media. A successful
# mount seeds hello.zl once for the persistent user-mode interpreter route.
fs_try()

# THE COMPOSITOR ALLOCATES RETAINED CLIENT AND SHELL SURFACES. The physical
# 2560x1440 boot exposed that wm_boot_start() used to run before heap_up(): six
# allocations were loudly refused because the heap had never been initialised.
# QEMU's smaller GOP mode hid the ordering defect behind cheaper fallbacks.
# Initialise both allocators and the heap's virtual window before the first
# window exists. Each mark is synchronously durable when ZLLOG is active, so a
# physical stop identifies the exact call that did not return.
diag_mark(200)                           # allocator sequence entered
arena_up()
diag_mark(201)                           # program arena returned
heap_up()
diag_mark(202)                           # kernel heap returned
vmm_up()
diag_mark(203)                           # virtual-window report returned
mon_x = 0                                # window positions - layout() fills these in
mon_y = 0                                # from the real screen size, and dragging
ab_x = 0                                 # updates them from there
ab_y = 0
term_x = 0                               # the terminal window's frame and text box
term_y = 0
term_w = 0
term_h = 0
term_c0 = 0
term_c1 = 0
term_r0 = 5
term_r1 = 20
# mon_open, ab_open AND focus_win WERE HERE - the pre-compositor window model,
# one mention each. Their comments said "is each window open (1) or closed (0)"
# and "0 = terminal, 1 = monitor, 2 = about", which is the three-window desktop
# wm.c replaced. wm_open_p and wm_focus answer both questions now.
#
# focus_win was the worst of the three: wm.c has a static of the SAME NAME
# meaning something different (a slot index), and :11236 cites it as
# `wm.c: focus_win = i`. A zl global shadowing a C static by name, holding a
# stale meaning, is a trap for the next reader of either.
# Do not accept whatever mode the bootloader happened to hand us. We have our
# own modesetting driver, so ASK THE HARDWARE for a proper resolution - the
# same thing a real OS does at startup. Try progressively smaller modes until
# the card takes one; if none work we simply keep what we were given.
if px_w() > 0 {
    if px_w() < 1900 {
        if set_res(1920, 1200) == 0 {
            if set_res(1920, 1080) == 0 {
                if set_res(1600, 900) == 0 {
                    set_res(1280, 800)
                }
            }
        }
    }
}
if px_w() > 0 { layout() }

# ---- THE INVERSION ---------------------------------------------------------
# The compositor is the boot state, not something reached by pressing a key.
# It has to come up HERE, before a single line of the boot log, because the log
# prints into window 0 and a window has to exist to be printed into. That
# ordering is not cosmetic: draw_desk() relied on exactly the same shape, and
# it is why wm_boot_start() opens the shell first and the other two after.
#
# wm_avail() is FALSE when there is no framebuffer, and verify.sh boots
# -kernel -display none where QEMU's multiboot loader supplies no framebuffer
# tag at all. So on that gate this is 0, draw_desk() takes its text branch, and
# the plain shell at the bottom of this file runs exactly as it always has -
# byte-identical transcript, which is the single most likely thing here to go
# red.
wm_boot = wm_boot_start()
diag_mark(204)                           # compositor construction returned
if wm_boot == 0 { draw_desk() }          # static desktop; the boot log fills the terminal

color(C_WHITE)  print("  zlOS starting")
color(C_GREY)   print("")

if loader() == 2 {
    ok_line("UEFI application - no GRUB, no bootloader, 64-bit from the start")
}
if loader() == 1 {
    if bits() == 64 {
        ok_line("multiboot handoff, then OUR jump into 64-bit long mode")
    }
    if bits() == 32 {
        ok_line("multiboot handoff, 32-bit protected mode")
    }
}
if loader() == 0 {
    if bits() == 64 {
        ok_line("our bootloader (raw_boot), no GRUB - then 64-bit long mode")
    }
    if bits() == 32 {
        ok_line("our bootloader (raw_boot), no GRUB - 32-bit protected mode")
    }
}
ok_line("stack established, 256 KiB")
ok_line("COM1 initialised, 115200 8N1")
if con_kind() == 1 {
    color(C_GREY)  put("  [")
    color(C_GREEN) put("  OK  ")
    color(C_GREY)  put("] framebuffer console, ")
    put(con_cols())  put("x")  print(con_rows())
} else {
    ok_line("VGA text console, 80x25")
}
if bits() == 64 {
    ok_line("GDT loaded - 64-bit flat segments, 4-level paging, SSE on")
} else {
    ok_line("GDT loaded - flat 4 GiB code and data segments")
}
ok_line("IDT installed, PIC remapped, interrupts ON")
# Move off the 8259 if this machine has an APIC. On a UEFI laptop the legacy
# PIC may not be wired to anything at all - the keyboard raises IRQ1 and the
# interrupt is simply never delivered. The I/O APIC is how a modern machine
# routes it, and ACPI is the only thing that knows where that chip lives.
if boot_apic == 1 {
    put("  [  OK  ] APIC: IRQs via I/O APIC at 0x")  hex(apic_ib(), 8)
    put(", ")  put(apic_cpus())  print(" CPU(s)")
} else {
    info_line("no APIC - staying on the legacy 8259 PIC")
}
ok_line("PIT timer running at 100 Hz on IRQ0")
ok_line("keyboard on IRQ1 - no more polling the port")
# Enumeration and its detailed report now happen before the recorder and
# desktop by construction. Retain one idempotent retry for genuinely late
# devices, but the physical boot no longer relies on reaching this line before
# it can persist the allocator/compositor boundary.
if boot_usb == 0 { boot_usb = usb_boot() }
if diag_boot == 0 { diag_boot = diag_up() }
# THE BOOT STICK BECOMES A FLIGHT RECORDER only after xHCI is live. diag_up
# refuses every disk except an exact GPT type+label+GUID+superblock match and
# writes only inside that partition. Until this point the same records have
# been accumulating in RAM, so PCI/USB setup is not missing from the log.
if diag_boot == 1 {
    ok_line("persistent boot observer - ZLLOG journal active")
} else {
    # The headless BIOS transcript has never advertised optional hardware that
    # is absent; keep that byte-for-byte gate quiet.  A graphical machine is
    # exactly where RAM-only mode must be visible because there may be no
    # serial console to explain why a later crash left no USB record.
    if px_w() > 0 {
        info_line("persistent boot observer - RAM only; no exact ZLLOG target")
        if diag_err() == 1 {
            put("         MSC init stage ")  put(msc_istage())
            put(", port ")  put(msc_iport())
            put(", slot ")  put(msc_islot())
            put(", xHCI cc ")  put(msc_icc())
            put(", USB ")  hex(msc_ivid(), 4)
            put(":")  hex(msc_ipid(), 4)  print("")
            if msc_iport() > 0 {
                put("         PORTSC 0x")  hex(usb_portsc(msc_iport()), 8)
            }
            put(", USBSTS 0x")  hex(usb_sts(), 8)
            put(", USBCMD 0x")  hex(usb_cmd(), 8)  print("")
        }
    }
}
# RING 3. Runs a tiny program at ring 3 that talks to the kernel only through
# int 0x80, then comes back. The "u3" in the line below is written by syscalls
# made from the far side of the privilege boundary - there is no other way for
# those bytes to reach the serial port - so this line failing to appear is a
# real regression rather than a cosmetic one, and golden.txt pins it.
user_up()
diag_mark(205)                           # Ring-3 self-test returned
net_boot()
diag_mark(206)                           # network boot returned
ok_line("zl runtime, kernel subset")
# STILL TRUE, and it is worth saying why rather than leaving the next reader to
# wonder whether it was just missed. A bump allocator with no free() and no
# reuse inside a run is not a heap - there is nothing to fragment, nothing to
# double-free, and nothing to leak that a reset does not reclaim. The line stops
# being honest the day the interpreter boxes lists and strings (EXEC-PROMPT §8),
# and that is the change that has to carry it, not this one.
info_line("no heap, zlfs mounts on demand, no scheduler")
app_manifest_report()
build_identity_report()

print("")
color(C_GREEN)  print("  ready.")
color(C_GREY)   print("  press h for help, q to halt")
print("")

# a two-note boot chime - the timer is up, so we can time it
beep(784, 8)  beep(1046, 12)

# The boot transcript remains complete on COM1, where diagnostics belong.
# Once the graphical session is ready, the visible terminal becomes a product
# surface instead of preserving bring-up noise as the first thing on screen.
# term_clear() clears only its scrollback tee; it cannot erase serial evidence.
if wm_boot == 1 {
    term_clear()
    print("zlOS 0.3")
    print("one system, one language")
    print("")
    print("system ready")
    print("type h for commands")
    wm_dmg(shell_win)
}

# The FIRST prompt, on the serial line only. In the compositor the prompt is
# pixels at the bottom of a window; every gate here waits for the string "zl> "
# in the serial log before it types anything, so without this the harness
# reports "booted but no prompt" and every probe stops working the moment the
# desktop becomes the boot state. Later prompts come with the echo in term.c.
if wm_boot == 1 { ser_out("zl> ") }

# THE PEAK MEASURES INTERACTION, NOT BOOT. The first frame repaints the whole
# screen and bakes the wallpaper - three radial glows, two conic sweeps and a
# vignette at full resolution - which is a one-off costing over a tenth of a
# second and would otherwise sit in the peak for ever, hiding every real
# regression underneath it.
if wm_boot == 1 { wm_peak0() }
diag_mark(207)                           # ready to enter the graphical loop


# ---- the shell -------------------------------------------------------------
running = 1
pending = 0

last_sec  = 0 - 1
last_blink = 0 - 1

# ---- the top of the system -------------------------------------------------
# THE COMPOSITOR IS THE TOP OF THE SYSTEM when there is a screen. wm_frame()
# owns the frame: it drains the input queue, ticks every app, repaints only
# what is damaged and presents once. The shell is a window inside it and 'q'
# reaches wm_stop() through the shell's app_event, exactly like any other app.
#
# `running = 0` afterwards is what keeps the old loop below unentered. It is
# written this way rather than as an if/else around 230 lines so that the text
# shell is not merely unchanged in behaviour but UNTOUCHED as a diff - that
# loop is what verify.sh compares byte for byte, and the cheapest way to keep a
# transcript identical is to not edit the code that produces it.
if wm_boot == 1 {
    # One block of writeback per wake, outside wm_frame: filesystem mutations
    # in an input callback only dirty WB RAM and never wait on NVMe there.
    while wm_run() == 1 { wm_frame()  blk_work()  dhcp_work()  idle() }
    con_mute(0)                          # the halting message goes on screen
    running = 0
}

# TEXT MODE, and only text mode. No framebuffer, so no compositor: this is the
# path verify.sh takes.
while running == 1 {
    color(C_GREEN)  put("  zl> ")
    color(C_WHITE)
    crow = row()
    ccol = col()                         # actual column after the prompt (text box aware)

    got = 0
    while got == 0 {
        dhcp_work()
        tk = ticks()

        # clock + text-cursor blink
        sec = idiv(tk, 100)                  # idiv: whole seconds
        if sec != last_sec {
            draw_clock(sec)
            last_sec = sec
            # (apps-in-windows had a second copy of this block here, wrapped in
            #  `if dragging == 0 { if menu_open == 0 {` - guards over two globals
            #  that belong to its static desktop and do not exist in this tree.)

            # ---- mouse: the live pointer, and window dragging ------------------
            # apps-in-windows' static-desktop mouse loop was here: 182 lines of
            # live pointer, window dragging and start-menu handling, drawn with
            # mhide/mpoint/raise_windows against a desktop composited by hand.
            #
            # It is gone because the compositor replaced it. wm.c owns the pointer,
            # the drag and the z-order now, off the damage list, and this block's own
            # comment already said it was unreachable - it sits inside `if px_w() > 0`
            # and px_w() is 0 wherever the text shell runs. It survived the merge only
            # because main deleted it outside a conflict region while apps kept it,
            # and it called raise_windows/close_menu/menu_cmd over menu_open/mnx/mny,
            # none of which exist in this tree. Dead code that does not compile.
            phase = tk % 100
            bon = 0
            if phase < 50 { bon = 1 }
            if bon != last_blink {
                cursor(crow, ccol, bon, C_CURSOR)
                last_blink = bon
            }

            # THE MOUSE BLOCK THAT WAS HERE IS GONE, C4. It was 165 lines of
            # window dragging, hit testing, focus, the close box, the start menu
            # and the dock - all of it guarded by `if px_w() > 0`, and all of it
            # now unreachable: a framebuffer means the compositor booted, and this
            # loop only runs when there is no framebuffer at all. wm.c does every
            # one of those jobs, with a scissor and a damage list instead of a
            # 640x480 sprite buffer.

            present()          # push this frame's changes out in one blit

            ch = key_get()
            if ch > 0 {
                if is_digit(ch) == true {
                    cursor(crow, ccol, 0, C_CURSOR)
                    color(C_WHITE)  put(ch - 48)
                    ccol = ccol + 1
                    last_blink = 0 - 1                  # force a redraw at the new spot
                    pending = pending * 10 + (ch - 48)
                } else {
                    if ch > 32 {
                        cursor(crow, ccol, 0, C_CURSOR)
                        print("")
                        draw_status("working")
                        term_submit(ch, pending, 1)
                        r = run_command(ch, pending)
                        term_complete(ch, r)
                        pending = 0
                        got = 1
                        last_sec = 0 - 1                # clock lost to the redraw
                        draw_status("ready")
                        if r == 1 { running = 0 }
                    }
                }
            }
        }
    }

}

# apps-in-windows wrapped the text shell and the compositor in one if/else and
# called wm_session() from the else. This tree does it the other way round -
# `if wm_boot == 1 { while wm_run() == 1 { wm_frame() } running = 0 }` above,
# so the text loop is left UNTOUCHED as a diff, which is what verify.sh
# compares byte for byte. Both structures survived the merge and the leftover
# `else` had no `if` to belong to.

print("")
color(C_YELLOW)  print("  halting.")
color(C_GREY)
draw_status("halted")
diag_done()                              # durable COMPLETE slot on clean exit
