# apps_games1.zl - board games: click-to-place, one state machine per game,
# each with its own board rather than a reskin of another (see
# apps_registry.zl for why). apps_common.zl's ac_cell_idx/ac_board_bg carry
# the grid arithmetic every one of these shares.

# ==============================================================================
# Tic-Tac-Toe - 3x3, two players share the keyboard-less window, click to
# place. TT_BOARD: 0 empty, 1 X, 2 O.
# ==============================================================================
TT_CELL = 44
tt_turn = 1
tt_win  = 0                         # 0 playing, 1/2 winner, 3 draw

fn tt_reset() { fill_mem(TT_BOARD, 0, 9)  tt_turn = 1  tt_win = 0  return 0 }

fn tt_line(a, b, c) {
    va = peek8(TT_BOARD + a)
    if va == 0 { return 0 }
    if va == peek8(TT_BOARD + b) { if va == peek8(TT_BOARD + c) { return va } }
    return 0
}
fn tt_check() {
    r = tt_line(0, 1, 2)  if r > 0 { return r }
    r = tt_line(3, 4, 5)  if r > 0 { return r }
    r = tt_line(6, 7, 8)  if r > 0 { return r }
    r = tt_line(0, 3, 6)  if r > 0 { return r }
    r = tt_line(1, 4, 7)  if r > 0 { return r }
    r = tt_line(2, 5, 8)  if r > 0 { return r }
    r = tt_line(0, 4, 8)  if r > 0 { return r }
    r = tt_line(2, 4, 6)  if r > 0 { return r }
    ci = 0
    full = 1
    while ci < 9 { if peek8(TT_BOARD + ci) == 0 { full = 0 }  ci = ci + 1 }
    if full == 1 { return 3 }
    return 0
}

fn tt_mark_col(m) {
    if m == 1 { return ac_cat_color(2) }
    return theme(TH_ACCENT)
}
fn tt_draw(ax, ay, aw, ah) {
    u = ui()
    cell = TT_CELL * u
    gx = ax + (aw - 3 * cell) / 2
    gy = ay + 4 * u
    ac_board_bg(gx, gy, cell, 3, 3, rgb(20, 24, 36), rgb(60, 68, 92))
    ci = 0
    while ci < 9 {
        m = peek8(TT_BOARD + ci)
        if m > 0 {
            cx = gx + (ci % 3) * cell
            cy = gy + (ci / 3) * cell
            label(cx + cell / 2 - 6 * u, cy + cell / 2 - 8 * u, tt_mark_str(m), tt_mark_col(m), T_TITLE, W_BOLD)
        }
        ci = ci + 1
    }
    msg_y = gy + 3 * cell + 8 * u
    if tt_win == 0 { label(gx, msg_y, tt_turn_str(), theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if tt_win == 1 { label(gx, msg_y, "X wins - r restarts", ac_cat_color(2), T_CAPTION, W_BOLD) }
    if tt_win == 2 { label(gx, msg_y, "O wins - r restarts", theme(TH_ACCENT), T_CAPTION, W_BOLD) }
    if tt_win == 3 { label(gx, msg_y, "draw - r restarts", theme(TH_TEXT_DIM), T_CAPTION, W_BOLD) }
    return 0
}
fn tt_mark_str(m) { if m == 1 { return "X" }  return "O" }
fn tt_turn_str() { if tt_turn == 1 { return "X to move" }  return "O to move" }

fn tt_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { tt_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if tt_win != 0 { return 0 }
    u = ui()
    cell = TT_CELL * u
    gx = wm_cx(win) + (wm_cw(win) - 3 * cell) / 2
    gy = wm_cy(win) + 4 * u
    idx = ac_cell_idx(gx, gy, cell, 3, 3, ex, ey)
    if idx < 0 { return 0 }
    if peek8(TT_BOARD + idx) != 0 { return 0 }
    poke8(TT_BOARD + idx, tt_turn)
    tt_win = tt_check()
    if tt_win == 0 { if tt_turn == 1 { tt_turn = 2 } else { tt_turn = 1 } }
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Nim - three piles, normal play (whoever takes the last object wins). Click
# a pile at the dot you want to cut it down to - the standard Nim UI.
# ==============================================================================
nim_a = 3
nim_b = 5
nim_c = 7
nim_turn = 1
nim_win  = 0

fn nim_reset() { nim_a = 3  nim_b = 5  nim_c = 7  nim_turn = 1  nim_win = 0  return 0 }
fn nim_pile(i) { if i == 0 { return nim_a }  if i == 1 { return nim_b }  return nim_c }
fn nim_set(i, v) {
    if i == 0 { nim_a = v }
    if i == 1 { nim_b = v }
    if i == 2 { nim_c = v }
    return 0
}

fn nim_draw(ax, ay, aw, ah) {
    u = ui()
    dw = 18 * u
    pi = 0
    while pi < 3 {
        py = ay + 10 * u + pi * 26 * u
        di = 0
        n = nim_pile(pi)
        while di < n {
            fill_rgb(ax + 10 * u + di * dw, py, dw - 4 * u, 16 * u, ac_cat_color(2))
            di = di + 1
        }
        pi = pi + 1
    }
    if nim_win == 0 {
        label(ax + 10 * u, ay + 92 * u, nim_turn_str(), theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    } else {
        label(ax + 10 * u, ay + 92 * u, nim_win_str(), ac_cat_color(2), T_CAPTION, W_BOLD)
    }
    return 0
}
fn nim_turn_str() { if nim_turn == 1 { return "player 1 to move" }  return "player 2 to move" }
fn nim_win_str()  { if nim_win  == 1 { return "player 1 wins - r restarts" }  return "player 2 wins - r restarts" }

fn nim_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { nim_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if nim_win != 0 { return 0 }
    u = ui()
    cx = ex - wm_cx(win)
    cy = ey - wm_cy(win)
    # cy must be checked non-negative BEFORE the divide, not after: this
    # kernel's `/` truncates toward zero (freestanding/runtime_kernel.c),
    # so (cy - 10u) at, say, cy = 8u gives -2u/26u = 0, not -1 - a click just
    # above the first pile would silently pass a `pi < 0` check done after
    # the division and register as a click ON pile 0. ac_cell_idx in
    # apps_common.zl already gets this right; the sliders below (cp_slider_at)
    # and the Hanoi pegs (ho_event) had the same shape and are fixed with it.
    if cy < 10 * u { return 0 }
    pi = (cy - 10 * u) / (26 * u)
    if pi > 2 { return 0 }
    into = cy - 10 * u - pi * 26 * u
    if into >= 16 * u { return 0 }
    cut = (cx - 10 * u) / (18 * u) + 1
    if cut < 0 { cut = 0 }
    if cut >= nim_pile(pi) { return 0 }
    nim_set(pi, cut)
    if nim_a + nim_b + nim_c == 0 {
        nim_win = nim_turn
    } else {
        if nim_turn == 1 { nim_turn = 2 } else { nim_turn = 1 }
    }
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Tower of Hanoi - 3 pegs, 5 disks (0 smallest .. 4 largest). Click a peg to
# select its top disk, click another peg to move it there.
# ==============================================================================
ho_d0 = 0
ho_d1 = 0
ho_d2 = 0
ho_d3 = 0
ho_d4 = 0
ho_sel = 0 - 1
ho_moves = 0

fn ho_peg(d) {
    if d == 0 { return ho_d0 }
    if d == 1 { return ho_d1 }
    if d == 2 { return ho_d2 }
    if d == 3 { return ho_d3 }
    return ho_d4
}
fn ho_set(d, p) {
    if d == 0 { ho_d0 = p }
    if d == 1 { ho_d1 = p }
    if d == 2 { ho_d2 = p }
    if d == 3 { ho_d3 = p }
    if d == 4 { ho_d4 = p }
    return 0
}
fn ho_reset() { ho_d0 = 0  ho_d1 = 0  ho_d2 = 0  ho_d3 = 0  ho_d4 = 0  ho_sel = 0 - 1  ho_moves = 0  return 0 }

# smallest disk index currently on peg p, the standard "top of stack" rule
# for this puzzle (larger disks can never sit above smaller ones), or -1.
fn ho_top(p) {
    d = 0
    while d < 5 { if ho_peg(d) == p { return d }  d = d + 1 }
    return 0 - 1
}

fn ho_draw(ax, ay, aw, ah) {
    u = ui()
    baseY = ay + 90 * u
    pw = aw / 3
    pi = 0
    while pi < 3 {
        px = ax + pi * pw + pw / 2
        col = theme(TH_TEXT_DIM)
        if ho_sel == pi { col = theme(TH_ACCENT) }
        fill_rgb(px - 1 * u, baseY - 70 * u, 2 * u, 70 * u, col)
        fill_rgb(ax + pi * pw + 10 * u, baseY, pw - 20 * u, 4 * u, col)
        pi = pi + 1
    }
    d = 4
    while d >= 0 {
        p = ho_peg(d)
        stacklvl = 0
        dd = 0
        while dd < 5 { if ho_peg(dd) == p { if dd > d { stacklvl = stacklvl + 1 } }  dd = dd + 1 }
        w = (d + 2) * 10 * u
        px = ax + p * pw + pw / 2
        py = baseY - (stacklvl + 1) * 12 * u
        fill_rgb(px - w / 2, py, w, 10 * u, ac_cat_color(2))
        d = d - 1
    }
    if ho_peg(0) == 2 { if ho_peg(1) == 2 { if ho_peg(2) == 2 { if ho_peg(3) == 2 { if ho_peg(4) == 2 {
        label(ax + 8 * u, ay + 8 * u, "solved - r restarts", ac_cat_color(2), T_CAPTION, W_BOLD)
        return 0
    }}}}}
    label(ax + 8 * u, ay + 8 * u, "moves", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    label_num(ax + 56 * u, ay + 8 * u, ho_moves, theme(TH_TEXT_HI), T_CAPTION, W_REG)
    return 0
}

fn ho_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { ho_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    aw = wm_cw(win)
    pw = aw / 3
    cx = ex - wm_cx(win)
    if cx < 0 { return 0 }               # see the note in nim_event
    p = cx / pw
    if p > 2 { return 0 }
    if ho_sel < 0 {
        if ho_top(p) >= 0 { ho_sel = p }
        wm_dmg(win)
        return 1
    }
    if ho_sel == p { ho_sel = 0 - 1  wm_dmg(win)  return 1 }
    src = ho_top(ho_sel)
    dtop = ho_top(p)
    if dtop < 0 { ho_set(src, p)  ho_moves = ho_moves + 1 } else {
        if dtop > src { ho_set(src, p)  ho_moves = ho_moves + 1 }
    }
    ho_sel = 0 - 1
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Lights Out - 5x5, click toggles the cell and its four neighbours, win when
# every light is off. Starts from an all-off (solved) board and applies K
# random valid toggles, which is the standard way to guarantee a solvable
# puzzle without writing a solver.
# ==============================================================================
LO_N = 5

fn lo_toggle(r, c) {
    if r < 0 { return 0 }
    if r >= LO_N { return 0 }
    if c < 0 { return 0 }
    if c >= LO_N { return 0 }
    a = LIGHTS_BOARD + r * LO_N + c
    poke8(a, 1 - peek8(a))
    return 0
}
fn lo_reset() {
    fill_mem(LIGHTS_BOARD, 0, LO_N * LO_N)
    ac_seed_from(ticks() + 19)          # see the note in wg_reset
    ki = 0
    while ki < 12 {
        cell = ac_rand(LO_N * LO_N)
        lo_toggle(cell / LO_N, cell % LO_N)
        lo_toggle(cell / LO_N - 1, cell % LO_N)
        lo_toggle(cell / LO_N + 1, cell % LO_N)
        lo_toggle(cell / LO_N, cell % LO_N - 1)
        lo_toggle(cell / LO_N, cell % LO_N + 1)
        ki = ki + 1
    }
    return 0
}
fn lo_solved() {
    ci = 0
    while ci < LO_N * LO_N { if peek8(LIGHTS_BOARD + ci) != 0 { return 0 }  ci = ci + 1 }
    return 1
}

fn lo_draw(ax, ay, aw, ah) {
    u = ui()
    cell = 34 * u
    gx = ax + (aw - LO_N * cell) / 2
    gy = ay + 6 * u
    ri = 0
    while ri < LO_N {
        ci = 0
        while ci < LO_N {
            on = peek8(LIGHTS_BOARD + ri * LO_N + ci)
            col = rgb(24, 28, 40)
            if on == 1 { col = rgb(230, 200, 90) }
            rrect(gx + ci * cell + 2 * u, gy + ri * cell + 2 * u, cell - 4 * u, cell - 4 * u, 6 * u, col)
            ci = ci + 1
        }
        ri = ri + 1
    }
    if lo_solved() == 1 {
        label(gx, gy + LO_N * cell + 8 * u, "solved - r shuffles again", ac_cat_color(2), T_CAPTION, W_BOLD)
    } else {
        label(gx, gy + LO_N * cell + 8 * u, "click to turn off every light", theme(TH_TEXT_DIM), T_CAPTION, W_REG)
    }
    return 0
}

fn lo_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { lo_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if lo_solved() == 1 { return 0 }
    u = ui()
    cell = 34 * u
    gx = wm_cx(win) + (wm_cw(win) - LO_N * cell) / 2
    gy = wm_cy(win) + 6 * u
    idx = ac_cell_idx(gx, gy, cell, LO_N, LO_N, ex, ey)
    if idx < 0 { return 0 }
    r = idx / LO_N
    c = idx % LO_N
    lo_toggle(r, c)
    lo_toggle(r - 1, c)
    lo_toggle(r + 1, c)
    lo_toggle(r, c - 1)
    lo_toggle(r, c + 1)
    wm_dmg(win)
    return 1
}

# ==============================================================================
# Connect Four - 7x6, click a column, the piece drops to the lowest empty
# row (row 0 = top in storage, drawn top-down; gravity works from the
# bottom row up). C4_BOARD: 0 empty, 1/2 a player's piece.
# ==============================================================================
C4_W = 7
C4_H = 6
c4_turn = 1
c4_win  = 0                         # 0 playing, 1/2 winner, 3 draw

fn c4_reset() { fill_mem(C4_BOARD, 0, C4_W * C4_H)  c4_turn = 1  c4_win = 0  return 0 }
fn c4_at(r, c) {
    if r < 0 { return 0 - 1 }
    if r >= C4_H { return 0 - 1 }
    if c < 0 { return 0 - 1 }
    if c >= C4_W { return 0 - 1 }
    return peek8(C4_BOARD + r * C4_W + c)
}
fn c4_run(r, c, dr, dc, m) {
    n = 0
    while c4_at(r, c) == m { n = n + 1  r = r + dr  c = c + dc }
    return n
}
fn c4_check(r, c) {
    m = c4_at(r, c)
    if m == 0 { return 0 }
    if c4_run(r, c, 0, 1, m) + c4_run(r, c, 0, 0 - 1, m) - 1 >= 4 { return m }
    if c4_run(r, c, 1, 0, m) + c4_run(r, c, 0 - 1, 0, m) - 1 >= 4 { return m }
    if c4_run(r, c, 1, 1, m) + c4_run(r, c, 0 - 1, 0 - 1, m) - 1 >= 4 { return m }
    if c4_run(r, c, 1, 0 - 1, m) + c4_run(r, c, 0 - 1, 1, m) - 1 >= 4 { return m }
    return 0
}
fn c4_full() {
    ci = 0
    while ci < C4_W { if c4_at(0, ci) == 0 { return 0 }  ci = ci + 1 }
    return 1
}

fn c4_col_color(m) { if m == 1 { return ac_cat_color(2) }  return theme(TH_ACCENT) }
fn c4_draw(ax, ay, aw, ah) {
    u = ui()
    cell = 30 * u
    gx = ax + (aw - C4_W * cell) / 2
    gy = ay + 6 * u
    ac_board_bg(gx, gy, cell, C4_W, C4_H, rgb(20, 30, 60), rgb(50, 66, 110))
    ri = 0
    while ri < C4_H {
        ci = 0
        while ci < C4_W {
            m = c4_at(ri, ci)
            if m > 0 {
                fill_rgb(gx + ci * cell + 3 * u, gy + ri * cell + 3 * u, cell - 6 * u, cell - 6 * u, c4_col_color(m))
            }
            ci = ci + 1
        }
        ri = ri + 1
    }
    msg_y = gy + C4_H * cell + 8 * u
    if c4_win == 0 { label(gx, msg_y, c4_turn_str(), theme(TH_TEXT_DIM), T_CAPTION, W_REG) }
    if c4_win == 1 { label(gx, msg_y, "red wins - r restarts", ac_cat_color(2), T_CAPTION, W_BOLD) }
    if c4_win == 2 { label(gx, msg_y, "yellow wins - r restarts", theme(TH_ACCENT), T_CAPTION, W_BOLD) }
    if c4_win == 3 { label(gx, msg_y, "draw - r restarts", theme(TH_TEXT_DIM), T_CAPTION, W_BOLD) }
    return 0
}
fn c4_turn_str() { if c4_turn == 1 { return "red to drop" }  return "yellow to drop" }

fn c4_event(win, ety, ecode, ex, ey) {
    if ety == 3 { if ecode == 114 { c4_reset()  wm_dmg(win)  return 1 }  return 0 }
    if ety != 4 { return 0 }
    if band(ecode, 1) == 0 { return 0 }
    if c4_win != 0 { return 0 }
    u = ui()
    cell = 30 * u
    gx = wm_cx(win) + (wm_cw(win) - C4_W * cell) / 2
    cx = ex - gx
    if cx < 0 { return 0 }
    col = cx / cell
    if col >= C4_W { return 0 }
    # landrow is a real sentinel (-1 = "not placed yet"), unlike overloading
    # the scan cursor itself - a full column and a successful drop both left
    # the scan cursor at -1, so the first version of this could not tell a
    # click on a full column from a real move and ran the win check and the
    # turn switch on nothing.
    landrow = 0 - 1
    r = C4_H - 1
    while r >= 0 {
        if c4_at(r, col) == 0 {
            if landrow < 0 {
                poke8(C4_BOARD + r * C4_W + col, c4_turn)
                landrow = r
            }
        }
        r = r - 1
    }
    if landrow < 0 { return 1 }
    if c4_check(landrow, col) > 0 { c4_win = c4_turn }
    if c4_win == 0 { if c4_full() == 1 { c4_win = 3 } else { if c4_turn == 1 { c4_turn = 2 } else { c4_turn = 1 } } }
    wm_dmg(win)
    return 1
}
