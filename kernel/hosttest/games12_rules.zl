# games12_rules.zl - the rules of apps_games1.zl and apps_games2.zl, asserted,
# on the host. The sibling of hosttest/games4_rules.zl and built to the same
# contract, for the seven games written before that contract existed:
#
#   Word Guess (24)  Tic-Tac-Toe (25)  Nim (26)  Tower of Hanoi (27)
#   Lights Out (28)  Connect Four (29)  Maze (33)
#
# THIS RUNS THE SHIPPING SOURCE. It `import`s kernel/apps_games1.zl and
# kernel/apps_games2.zl unmodified and calls their functions. It does not
# restate any rule - a test that carries its own copy of the thing it checks is
# a second place for the value to be wrong (hosttest/palette.c's header makes
# the same argument at length).
#
# WHY IT CAN. peek8/poke8/peek16/poke16/fill_mem and band/bor/shl/shr all
# exist in the host interpreter. The two that do not, ticks() and ui(), are
# ordinary zl functions here; a user function shadows a builtin, which is what
# makes the clock deterministic. Nothing that draws is called, so theme(),
# label() and fill_rgb() are never reached and the TH_* roles - which live in
# kernel.zl and are NOT imported - are never evaluated.
#
# RUN IT FROM kernel/, because `import` resolves against the working directory:
#
#     cd kernel && ../interp hosttest/games12_rules.zl
#
# Milliseconds. No QEMU, no framebuffer, no host-load sensitivity.
#
# WHAT BREAKS IT - the mutation test, stated per section so a future reader can
# check the assertions still bite rather than taking this header's word for it.
# Each one was applied to the shipping source, this file was run, and the named
# check went red. See the report in the commit that added this file.

import apps_common
import apps_games1
import apps_games2

# ---- the harness ------------------------------------------------------------
# print() takes several values and separates them with a space. put() does NOT
# exist in the host interpreter - it is a kernel-only builtin - so nothing here
# reaches for it.
gt_fail = 0
gt_n = 0
fn gt_ok(cond, what) {
    gt_n = gt_n + 1
    # `if cond`, not `if cond == 1`: a comparison yields a BOOL and comparing a
    # bool against the number 1 is false, so the second form silently passes
    # nothing. games4_rules.zl records the same footgun.
    if cond {
        print("  ok  ", what)
        return 0
    }
    gt_fail = gt_fail + 1
    print("  FAIL", what)
    return 0
}
fn gt_eq(got, want, what) {
    if got == want { return gt_ok(1, what) }
    gt_ok(0, what)
    print("        wanted", want, "got", got)
    return 0
}

# ---- apps_common.zl's PRNG, which does not survive a host --------------------
# ac_rand multiplies its seed by 1103515245 every call and relies on the KERNEL
# runtime's cast to long long to wrap it. Here the seed is a double and grows
# without bound, so the third call hands band() a value past 2^63 and the
# interpreter refuses it - correctly. The generator is therefore replaced, not
# the code under test. Nothing below asserts a PARTICULAR sequence: that a
# Lights Out shuffle is solvable is a property of toggling from solved, and
# that a generated maze is perfect is a property of the backtracker. Both hold
# for any random source, so holding them under a DIFFERENT source than the
# kernel's is a stronger statement than holding them under the same one.
fn ac_rand(n) {
    ac_seed = band(ac_seed * 1103515245 + 12345, 0x7FFFFFFF)
    return band(shr(ac_seed, 8), 32767) % n
}

# ---- the two builtins the kernel has and the host does not ------------------
gt_clock = 1000
fn ticks() { gt_clock = gt_clock + 7919  return gt_clock }
fn ui() { return 1 }

# ---- the fixed pages, moved off the kernel's physical map --------------------
# kernel.zl declares all seven of these at real addresses in the 32 MiB band.
# On Linux those are somebody else's memory, so they are re-pointed at the
# interpreter's own allocator AFTER the import (a later top-level assignment
# wins). NOT ONE ADDRESS IN kernel.zl IS TOUCHED - check-memmap.sh and
# hosttest/zladdrs.sh both read the shipping source, and a parallel job depends
# on those addresses staying exactly where they are.
TT_BOARD     = alloc(64)
LIGHTS_BOARD = alloc(64)
C4_BOARD     = alloc(128)
WG_BOARD     = alloc(64)
MAZE_BOARD   = alloc(512)
MAZE_STACK   = alloc(1024)

print("games12_rules - apps_games1.zl and apps_games2.zl, on the host")

# =============================================================================
# THE ONE THING THIS HARNESS CANNOT MODEL, ASSERTED RATHER THAN ASSUMED.
#
# zl numbers are doubles. The KERNEL runtime casts both operands of `/` to long
# long before dividing (freestanding/runtime_kernel.c, zl_binop) - which is why
# apps_games1.zl's nim_event carries a paragraph about truncation toward zero.
# The HOST interpreter does not: 5 / 4 is 1.25 here.
#
# So any rule that leans on truncation is a DIFFERENT rule in the two runtimes
# this project ships. Word Guess used to unpack its cells with `v / 32` and
# `v % 32` and was exactly that: two rules wearing one name. It now unpacks
# with band/shr, and the assertions below are therefore statements about both
# backends rather than about this one.
print("")
print("the arithmetic this runtime actually has")
gt_ok(5 / 4 == 1.25, "the host interpreter divides as doubles - the kernel truncates")
gt_ok(band(5, 3) == 1, "band is exact in both runtimes")
gt_ok(shr(96, 5) == 3, "...and so is shr, which is why the packed cells use it")

# =============================================================================
# WORD GUESS. The rule is the two-pass consumption every implementation of this
# game uses: greens claim their own target letter, then each remaining guess
# letter takes ONE unclaimed target letter or stays grey.
# =============================================================================
print("")
print("Word Guess - scoring, and the duplicate letter")

# A guess is typed into the live row and scored. wg_type spells the shipping
# input path (wg_put with status 0) rather than a second way to fill a row.
fn t_guess(a, b, c, d, e) {
    wg_put(wg_row, 0, a, 0)
    wg_put(wg_row, 1, b, 0)
    wg_put(wg_row, 2, c, 0)
    wg_put(wg_row, 3, d, 0)
    wg_put(wg_row, 4, e, 0)
    wg_col = 5
    t_row = wg_row
    wg_submit()
    return t_row
}
fn t_states(r) {
    # the five statuses as one base-4 number, so a whole row is one assertion
    return wg_state(r, 0) * 256 + wg_state(r, 1) * 64 + wg_state(r, 2) * 16 + wg_state(r, 3) * 4 + wg_state(r, 4)
}

# The eight-word list is fixed and indexed, so a test can name a target without
# depending on the seed: word 2 is STORM, word 5 is GRAPE, word 0 is CRANE.
gt_eq(wg_word(2, 0), 18, "word 2 starts with s - the list is the one this test assumes")
gt_eq(wg_word(2, 4), 12, "...and ends with m, so word 2 is STORM")

# THE EXACT MATCH. Guessing the target scores five greens and wins.
wg_reset()
wg_widx = 2
wg_row = 0
wg_col = 0
t_guess(18, 19, 14, 17, 12)
gt_eq(t_states(0), 3 * 256 + 3 * 64 + 3 * 16 + 3 * 4 + 3, "guessing STORM against STORM is five greens")
gt_eq(wg_done, 1, "...and the game is won")

# THE DUPLICATE. Target STORM has ONE o. Guessing ROOMS must paint the first o
# green (position 2 matches) and the second o GREY, because there is no second
# o left to claim. The old rule - "does this letter occur anywhere in the
# target" - paints both, and tells the player the word has two of them.
#
#   guess  R  O  O  M  S
#   target S  T  O  R  M
#          |  |  |  |  |
#          2  1  3  2  2      yellow grey green yellow yellow
wg_reset()
wg_widx = 2
wg_row = 0
wg_col = 0
t_guess(17, 14, 14, 12, 18)
gt_eq(wg_state(0, 2), 3, "the o that sits in the right place is green")
gt_eq(wg_state(0, 1), 1, "...and the second o is GREY - STORM has only one")
gt_eq(wg_state(0, 0), 2, "the r is present but misplaced")
gt_eq(wg_state(0, 3), 2, "...so is the m")
gt_eq(wg_state(0, 4), 2, "...and so is the s")

# THE OTHER DIRECTION. Target GRAPE has ONE e, in the last place. Guessing
# EERIE must green the final e and grey BOTH leading es - the green already
# claimed the only one.
wg_reset()
wg_widx = 5
wg_row = 0
wg_col = 0
t_guess(4, 4, 17, 8, 4)
gt_eq(wg_state(0, 4), 3, "the e in the right place is green")
gt_eq(wg_state(0, 0), 1, "...so the first spare e is grey")
gt_eq(wg_state(0, 1), 1, "...and so is the second")
gt_eq(wg_state(0, 2), 2, "the r is present but misplaced")
gt_eq(wg_state(0, 3), 1, "...and GRAPE has no i at all")

# A guess with no letter in common is five greys and does not end the game.
wg_reset()
wg_widx = 5
wg_row = 0
wg_col = 0
t_guess(1, 11, 14, 2, 10)
gt_eq(t_states(0), 1 * 256 + 1 * 64 + 1 * 16 + 1 * 4 + 1, "BLOCK against GRAPE is five greys")
gt_eq(wg_done, 0, "...and the game carries on")
gt_eq(wg_row, 1, "...on the next row")

# A SHORT ROW IS NOT A GUESS. Submitting with four letters typed must change
# nothing at all - not the row, not the statuses.
wg_reset()
wg_widx = 0
wg_row = 0
wg_col = 4
wg_submit()
gt_eq(wg_row, 0, "submitting four letters does not advance the row")
gt_eq(t_states(0), 0, "...and scores nothing")

# SIX WRONG GUESSES LOSE. The row counter is what ends it, so walk it.
wg_reset()
wg_widx = 5
wg_row = 0
wg_col = 0
t_i = 0
while t_i < 6 {
    wg_col = 0
    t_guess(1, 11, 14, 2, 10)
    t_i = t_i + 1
}
gt_eq(wg_done, 2, "six wrong guesses is a loss")
gt_eq(wg_row, 6, "...after exactly six rows")

# ...and a seventh does nothing, rather than running off the end of the board.
wg_col = 5
wg_submit()
gt_eq(wg_row, 6, "a submit after the loss is refused")

# THE PACKED CELL SURVIVES A ROUND TRIP for every letter and every status. This
# is the one that catches a mask off by a bit - 5 bits of letter, 2 of status.
t_bad = 0
t_l = 0
while t_l < 26 {
    t_s = 0
    while t_s < 4 {
        wg_put(0, 0, t_l, t_s)
        if wg_letter(0, 0) != t_l { t_bad = t_bad + 1 }
        if wg_state(0, 0) != t_s { t_bad = t_bad + 1 }
        t_s = t_s + 1
    }
    t_l = t_l + 1
}
gt_eq(t_bad, 0, "all 104 letter/status pairs survive the pack and unpack")

# =============================================================================
print("")
print(" ", gt_n, "checks,", gt_fail, "failures")
if gt_fail > 0 { exit(1) }
print("  OK")
