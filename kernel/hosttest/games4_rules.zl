# games4_rules.zl - the rules of apps_games4.zl, asserted, on the host.
#
# THIS RUNS THE SHIPPING SOURCE. It does not restate Reversi's flip or
# Sokoban's push rule in C and check the two agree - that would be a second
# copy, and hosttest/palette.c's own header explains why a test that hardcodes
# what it is checking is just a fourth place for the value to be wrong. It
# `import`s kernel/apps_games4.zl unmodified and calls its functions.
#
# WHY IT CAN. The kernel builtins these rules need - peek8/poke8/fill_mem,
# band/bor/shl/shr - all exist in the HOST interpreter too (runtime.c's
# peek/poke prefix path, interp.c's fill_mem). The two that do not, ticks()
# and ui(), are ordinary zl functions here, defined below; a user function
# shadows a builtin, which is what makes the clock deterministic instead of
# whatever the host's uptime happened to be. Nothing that draws is called, so
# no framebuffer builtin is ever reached.
#
# WHAT IT IS FOR. Six of these eight games are judged by playing them, and a
# person playing Reversi cannot tell a flip-through-a-gap from a legal flip,
# or a Sokoban that quietly permits a double push from one that does not. Those
# two are also the two the brief names as most commonly got wrong. So they get
# assertions, and the levels get a structural audit that no amount of playing
# level 1 would produce.
#
# RUN IT FROM kernel/, because `import` resolves against the working directory:
#
#     cd kernel && ../interp hosttest/games4_rules.zl
#
# Milliseconds. No QEMU, no framebuffer, no host-load sensitivity.

import apps_common
import apps_games4

# ---- the harness ------------------------------------------------------------
g4t_fail = 0
g4t_n = 0
# print() takes several values and separates them with a space. put() does
# NOT exist in the host interpreter - it is a kernel-only builtin - so this
# harness never reaches for it.
fn g4t_ok(cond, what) {
    g4t_n = g4t_n + 1
    # `if cond`, not `if cond == 1`: a comparison yields a BOOL and comparing a
    # bool against the number 1 is false, so the second form silently failed
    # every check written as an expression rather than a 0/1.
    if cond {
        print("  ok  ", what)
        return 0
    }
    g4t_fail = g4t_fail + 1
    print("  FAIL", what)
    return 0
}
fn g4t_eq(got, want, what) {
    if got == want { return g4t_ok(1, what) }
    g4t_ok(0, what)
    print("        wanted", want, "got", got)
    return 0
}

# ---- apps_common.zl's PRNG, which does not survive a host ------------------
# ac_rand multiplies its seed by 1103515245 every call and relies on the KERNEL
# runtime's cast to long long to wrap it. Here the seed is a double and grows
# without bound, so the third call hands band() a value past 2^63 and the
# interpreter refuses it - correctly.
#
# The generator is therefore replaced, not the code under test. Nothing below
# asserts anything about a PARTICULAR sequence: that every shuffle of the 15
# puzzle is solvable is a property of walking legal slides, that the shoe is a
# permutation is a property of Fisher-Yates, and that the dealer never stands
# below 17 is a property of the loop - all three hold for any random source,
# and holding them under a DIFFERENT source than the kernel's is a stronger
# statement, not a weaker one.
fn ac_rand(n) {
    ac_seed = band(ac_seed * 1103515245 + 12345, 0x7FFFFFFF)
    return band(shr(ac_seed, 8), 32767) % n
}

# ---- the two builtins the kernel has and the host does not ------------------
# A CLOCK THAT ADVANCES, so every ac_seed_from(ticks() + k) in the shipping
# source picks a different sequence and a shuffle can be exercised many times.
g4t_clock = 1000
fn ticks() { g4t_clock = g4t_clock + 7919  return g4t_clock }
fn ui() { return 1 }

# ---- the fixed pages, moved off the kernel's physical map --------------------
# apps_games4.zl declares SK_BOARD and friends at real addresses in the 32 MiB
# band, and kernel.zl declares the three it reuses. On Linux those are somebody
# else's memory, so they are re-pointed at the interpreter's own allocator
# AFTER the import (a later top-level assignment wins). The code under test does
# not change by a character.
FIFTEEN_BOARD = alloc(64)
RV_BOARD      = alloc(128)
SIMON_SEQ     = alloc(64)
SK_BOARD      = alloc(256)
SK_UNDO       = alloc(1024)
MC_BUF        = alloc(1024)
BJ_BUF        = alloc(256)

print("games4_rules - apps_games4.zl, on the host")

# =============================================================================
# THE ONE THING THIS HARNESS CANNOT MODEL, ASSERTED RATHER THAN ASSUMED.
#
# zl numbers are doubles. The KERNEL runtime casts both operands of `/` to
# long long before dividing (freestanding/runtime_kernel.c, zl_binop) - which
# is why apps_games1.zl's nim_event has a paragraph about truncation toward
# zero. The HOST interpreter does not: 5 / 4 is 1.25 here.
#
# So any rule that leans on truncation is a DIFFERENT rule in the two runtimes
# this project ships, and a harness that ran it here would be reporting on
# arithmetic the kernel does not have - the exact shape of
# docs/GUARDS-THAT-DID-NOT-GUARD.md.
#
# That was not written down and left as a caveat. The rules under test were
# changed so they do not divide at all: sk_undo's move record and bj_rank /
# bj_suit unpack with band/shr, rv_can and rv_ai walk rows and columns instead
# of a flat index, and the 15 puzzle keeps the hole as a row and a column. The
# assertion below states which runtime this is, so a future reader cannot
# mistake these results for a claim about integer division.
print("")
print("the arithmetic this runtime actually has")
g4t_ok(5 / 4 == 1.25, "the host interpreter divides as doubles - the kernel truncates")
g4t_ok(band(5, 3) == 1, "band is exact in both runtimes")
g4t_ok(shr(5, 2) == 1, "...and so is shr, which is why the rules use them")

# =============================================================================
# REVERSI. Rule 1: a move is legal only if some ray holds an unbroken run of
# enemy discs ending on one of yours.
# =============================================================================
print("")
print("Reversi - legality, the flip, and the pass")

rv_reset()
g4t_eq(rv_count(1), 2, "the opening has two black discs")
g4t_eq(rv_count(2), 2, "...and two white")

# The four openings are the same four in every book: C4, D3, E6, F5. Anything
# else being legal means the ray walk is finding runs that are not there.
t_legal = 0
t_r = 0
while t_r < 8 {
    t_c = 0
    while t_c < 8 {
        if rv_gain(1, t_r, t_c) > 0 { t_legal = t_legal + 1 }
        t_c = t_c + 1
    }
    t_r = t_r + 1
}
g4t_eq(t_legal, 4, "black has exactly four legal opening moves")
g4t_eq(rv_gain(1, 2, 3), 1, "(2,3) is legal and flips exactly one")
g4t_eq(rv_gain(1, 3, 2), 1, "(3,2) is legal and flips exactly one")
g4t_eq(rv_gain(1, 4, 5), 1, "(4,5) is legal and flips exactly one")
g4t_eq(rv_gain(1, 5, 4), 1, "(5,4) is legal and flips exactly one")
g4t_eq(rv_gain(1, 2, 2), 0, "a diagonal move onto no run is illegal")
g4t_eq(rv_gain(1, 3, 3), 0, "an occupied square is never legal")

rv_play(1, 2, 3)
g4t_eq(rv_count(1), 4, "playing (2,3) leaves four black")
g4t_eq(rv_count(2), 1, "...and one white, so exactly one disc turned over")

# A GAP BREAKS THE RAY. Row 4 reads black . white white EMPTY black from
# column 0: playing black at (4,0) must flip NOTHING, because the run of white
# does not end on a black disc, it ends on a hole. The classic wrong
# implementation - "is one of mine somewhere along this ray" - returns 3 here.
fill_mem(RV_BOARD, 0, 64)
rv_set(4, 1, 2)
rv_set(4, 2, 2)
rv_set(4, 4, 1)
g4t_eq(rv_gain(1, 4, 0), 0, "a hole in the run flips nothing")
rv_set(4, 3, 2)
g4t_eq(rv_gain(1, 4, 0), 3, "...and closing the hole flips all three")

# A RAY THAT RUNS OFF THE BOARD flips nothing - there is no wrap.
fill_mem(RV_BOARD, 0, 64)
rv_set(0, 1, 2)
rv_set(0, 2, 2)
g4t_eq(rv_gain(1, 0, 0), 0, "a run reaching the edge flips nothing")

# ALL EIGHT DIRECTIONS AT ONCE: white ring, black ring outside it, hole in the
# middle. Playing the hole must flip all eight.
fill_mem(RV_BOARD, 0, 64)
t_d = 0
while t_d < 8 {
    rv_set(4 + rv_dr(t_d), 4 + rv_dc(t_d), 2)
    rv_set(4 + rv_dr(t_d) * 2, 4 + rv_dc(t_d) * 2, 1)
    t_d = t_d + 1
}
g4t_eq(rv_gain(1, 4, 4), 8, "a full ring flips one disc in every direction")
rv_play(1, 4, 4)
g4t_eq(rv_count(2), 0, "...and after the play no white disc is left")

# RULE 2. The game ends when NEITHER side can move, which is not the same as
# the board being full. One lone disc: nobody has a move, and rv_step must say
# so rather than spinning or waiting for 64 discs.
fill_mem(RV_BOARD, 0, 64)
rv_set(0, 0, 1)
rv_over = 0
g4t_eq(rv_can(1), 0, "on a one-disc board black cannot move")
g4t_eq(rv_can(2), 0, "...and neither can white")
rv_step()
g4t_eq(rv_over, 1, "so rv_step ends the game on a board with 63 empty squares")

# ...and a position where white CAN move is not the end of the game.
rv_reset()
rv_play(1, 2, 3)
rv_over = 0
rv_step()
g4t_eq(rv_over, 0, "a live position is not called over")
g4t_ok(rv_count(1) + rv_count(2) - 6 == 0, "white answered with exactly one disc")

# =============================================================================
# SOKOBAN. The push rule, and the two things it is always got wrong.
# =============================================================================
print("")
print("Sokoban - the push rule, no double push, no pull")

# Every level, audited structurally. A crate or a goal inside a wall is
# invisible in play and makes the level unsolvable; unequal counts make it
# unwinnable. None of that is findable by playing level 1.
t_lv = 0
while t_lv < SK_LEVELS {
    sk_load(t_lv)
    t_crates = 0
    t_goals = 0
    t_bad = 0
    t_r = 0
    while t_r < SK_H {
        t_c = 0
        while t_c < SK_W {
            if sk_crate(t_r, t_c) == 1 {
                t_crates = t_crates + 1
                if sk_iswall(t_r, t_c) == 1 { t_bad = t_bad + 1 }
            }
            if sk_isgoal(t_r, t_c) == 1 {
                t_goals = t_goals + 1
                if sk_iswall(t_r, t_c) == 1 { t_bad = t_bad + 1 }
            }
            t_c = t_c + 1
        }
        t_r = t_r + 1
    }
    g4t_ok(t_crates == t_goals, "level: as many crates as goals")
    g4t_eq(t_bad, 0, "level: no crate and no goal is buried in a wall")
    g4t_ok(t_crates > 0, "level: it has crates at all")
    g4t_eq(sk_iswall(sk_py, sk_px), 0, "level: the player does not start in a wall")
    g4t_eq(sk_crate(sk_py, sk_px), 0, "level: the player does not start on a crate")
    g4t_eq(sk_solved(), 0, "level: it does not open already solved")
    t_lv = t_lv + 1
}

# A push, in isolation. Level 0 is an open room with a crate at (6,3); stand
# west of it and push east.
sk_load(0)
sk_px = 2
sk_py = 6
g4t_eq(sk_crate(6, 3), 1, "the crate is where the level says")
g4t_eq(sk_move(1), 1, "a push into open floor is allowed")
g4t_eq(sk_px, 3, "the player took the crate's square")
g4t_eq(sk_crate(6, 4), 1, "the crate moved one square")
g4t_eq(sk_crate(6, 3), 0, "...and left the one it was on")
g4t_eq(sk_pushes, 1, "the push counter moved")

# NO DOUBLE PUSH. Put a second crate directly beyond the first. The move must
# be refused OUTRIGHT - not "push both", and not "push one through the other".
sk_load(0)
sk_px = 2
sk_py = 6
sk_setcrate(6, 4, 1)
g4t_eq(sk_move(1), 0, "two crates in a row: the push is refused")
g4t_eq(sk_px, 2, "...the player did not move")
g4t_eq(sk_crate(6, 3), 1, "...the near crate did not move")
g4t_eq(sk_crate(6, 4), 1, "...and neither did the far one")
g4t_eq(sk_moves, 0, "...and it did not count as a move")

# A crate against a wall is the same refusal.
sk_load(0)
sk_setcrate(6, 3, 0)
sk_setcrate(6, 1, 1)
sk_px = 2
sk_py = 6
g4t_eq(sk_move(3), 0, "a crate against the wall cannot be pushed into it")
g4t_eq(sk_crate(6, 1), 1, "...the crate stayed put")
g4t_eq(sk_px, 2, "...and the player did not move either")

# NO PULL, stated as the property that matters: undo restores the position
# EXACTLY, and there is no forward move that drags a crate behind the player.
sk_load(0)
sk_px = 2
sk_py = 6
sk_move(1)
sk_move(1)
g4t_eq(sk_crate(6, 5), 1, "after two pushes the crate is two squares along")
sk_undo()
g4t_eq(sk_crate(6, 4), 1, "undo walked the crate back one")
g4t_eq(sk_crate(6, 5), 0, "...and cleared where it had been")
g4t_eq(sk_px, 3, "...and stepped the player back with it")
sk_undo()
g4t_eq(sk_crate(6, 3), 1, "a second undo reaches the starting square")
g4t_eq(sk_px, 2, "...with the player back where the level put him")
g4t_eq(sk_moves, 0, "...and the move counter back at zero")
g4t_eq(sk_pushes, 0, "...and the push counter too")

# undo after a move that pushed NOTHING must not invent a crate.
sk_load(0)
sk_px = 6
sk_py = 4
sk_move(0)
g4t_eq(sk_py, 3, "a plain step moved the player")
sk_undo()
g4t_eq(sk_py, 4, "...and undo put him back")
g4t_eq(sk_crate(3, 6), 0, "...without leaving a crate behind")
g4t_eq(sk_crate(4, 6), 0, "...or under him")

# LEVEL 0, SOLVED, by a move sequence rather than by claim. Route the player
# around to the east of the first crate, push it seven squares west onto its
# goal, then walk under and push the second crate seven squares east.
sk_load(0)
t_seq = 0
while t_seq < 3 { sk_move(0)  t_seq = t_seq + 1 }
t_seq = 0
while t_seq < 5 { sk_move(1)  t_seq = t_seq + 1 }
sk_move(2)
g4t_eq(sk_px, 11, "the player reached the square east of the crate")
g4t_eq(sk_py, 2, "...on the crate's row")
t_seq = 0
while t_seq < 7 { sk_move(3)  t_seq = t_seq + 1 }
g4t_eq(sk_crate(2, 3), 1, "seven pushes put the first crate on its goal")
t_seq = 0
while t_seq < 5 { sk_move(2)  t_seq = t_seq + 1 }
t_seq = 0
while t_seq < 2 { sk_move(3)  t_seq = t_seq + 1 }
sk_move(0)
g4t_eq(sk_px, 2, "the player reached the square west of the second crate")
g4t_eq(sk_py, 6, "...on its row")
t_seq = 0
while t_seq < 7 { sk_move(1)  t_seq = t_seq + 1 }
g4t_eq(sk_crate(6, 10), 1, "seven pushes put the second crate on its goal")
g4t_eq(sk_solved(), 1, "level 0 is solvable, and this is the solution")
g4t_eq(sk_win, 1, "...and the game noticed")

# =============================================================================
# 15 PUZZLE. The shuffle must land on a SOLVABLE arrangement every time.
# The invariant below is computed here, independently - it is not a copy of
# anything in apps_games4.zl, which contains no parity arithmetic at all.
# For a width-4 board: solvable iff inversions + the blank's row (0-based from
# the top) is odd. The solved board gives 0 + 3 = 3.
# =============================================================================
print("")
print("15 Puzzle - every shuffle is solvable")

fn g4t_parity() {
    t_inv = 0
    t_a = 0
    while t_a < 16 {
        t_b = t_a + 1
        while t_b < 16 {
            if peek8(FIFTEEN_BOARD + t_a) != 0 {
                if peek8(FIFTEEN_BOARD + t_b) != 0 {
                    if peek8(FIFTEEN_BOARD + t_a) > peek8(FIFTEEN_BOARD + t_b) { t_inv = t_inv + 1 }
                }
            }
            t_b = t_b + 1
        }
        t_a = t_a + 1
    }
    return (t_inv + fi_br) % 2
}

t_bad = 0
t_solved = 0
t_run = 0
while t_run < 60 {
    fi_reset()
    if g4t_parity() != 1 { t_bad = t_bad + 1 }
    if fi_solved() == 1 { t_solved = t_solved + 1 }
    t_run = t_run + 1
}
g4t_eq(t_bad, 0, "60 shuffles, every one of them solvable")
g4t_eq(t_solved, 0, "...and none of them opened already solved")
g4t_eq(fi_moves, 0, "the move counter starts at zero after a shuffle")

# a slide is only legal between orthogonal neighbours
fi_reset()
g4t_eq(fi_slide(fi_br, fi_bc), 0, "the hole cannot slide into itself")
g4t_eq(fi_slide(fi_br + 1, fi_bc + 1), 0, "a diagonal neighbour cannot slide in")
g4t_eq(fi_slide(fi_br, fi_bc + 2), 0, "nor a tile two squares away")
g4t_eq(fi_slide(0 - 1, fi_bc), 0, "and a square off the board is refused")

# a slide is reversible, which is the property the whole shuffle rests on
fi_reset()
t_r = fi_br
t_c = fi_bc
t_nc = t_c + 1
if t_nc > 3 { t_nc = t_c - 1 }
t_v = peek8(FIFTEEN_BOARD + t_r * 4 + t_nc)
g4t_eq(fi_slide(t_r, t_nc), 1, "a neighbour slides in")
g4t_eq(peek8(FIFTEEN_BOARD + t_r * 4 + t_c), t_v, "the tile landed in the hole")
g4t_eq(fi_bc, t_nc, "...and the hole is where the tile was")
fi_slide(t_r, t_c)
g4t_eq(fi_bc, t_c, "sliding it back restores the hole")
g4t_eq(peek8(FIFTEEN_BOARD + t_r * 4 + t_nc), t_v, "...and the tile")

# =============================================================================
# BLACKJACK. The ace, which is the only interesting arithmetic in the game.
# =============================================================================
print("")
print("Blackjack - aces, and a dealer with no discretion")

# card index = rank * 4 + suit, so 0 is an ace and 48 is a king.
fn g4t_hand(a, b, c, d, nn) {
    poke8(BJ_BUF + BJ_HAND + 0, a)
    poke8(BJ_BUF + BJ_HAND + 1, b)
    poke8(BJ_BUF + BJ_HAND + 2, c)
    poke8(BJ_BUF + BJ_HAND + 3, d)
    return bj_total(BJ_BUF + BJ_HAND, nn)
}
g4t_eq(g4t_hand(0, 48, 0, 0, 2), 21, "ace and king is 21")
g4t_eq(g4t_hand(0, 1, 0, 0, 2), 12, "two aces is 12, not 22 and not 2")
g4t_eq(g4t_hand(0, 1, 32, 0, 3), 21, "ace ace nine is 21")
g4t_eq(g4t_hand(0, 1, 2, 28, 4), 21, "ace ace ace eight is 21")
g4t_eq(g4t_hand(0, 32, 16, 0, 3), 15, "ace nine five demotes the ace to 1")
g4t_eq(g4t_hand(48, 44, 16, 0, 3), 25, "king queen five is a bust at 25")
g4t_eq(g4t_hand(36, 40, 0, 0, 2), 20, "jack and queen is 20")
g4t_eq(g4t_hand(0, 0, 0, 0, 1), 11, "a lone ace is 11")

# the shoe is a permutation - every card exactly once, none twice
bj_shuffle()
t_seen = 0
t_i = 0
while t_i < 52 {
    t_c = peek8(BJ_BUF + t_i)
    t_dup = 0
    t_b = 0
    while t_b < t_i { if peek8(BJ_BUF + t_b) == t_c { t_dup = 1 }  t_b = t_b + 1 }
    if t_dup == 1 { t_seen = t_seen + 1 }
    if t_c > 51 { t_seen = t_seen + 1 }
    t_i = t_i + 1
}
g4t_eq(t_seen, 0, "the shuffled shoe is a permutation of all 52 cards")

# the dealer draws to 17 and then stops, every hand, with no exceptions
t_low = 0
t_high = 0
t_run = 0
while t_run < 40 {
    bj_reset()
    bj_deal()
    if bj_state == 1 { bj_stand() }
    t_dt = bj_total(BJ_BUF + BJ_DEAL, bj_dn)
    if t_dt < 17 { t_low = t_low + 1 }
    if t_dt > 26 { t_high = t_high + 1 }
    t_run = t_run + 1
}
g4t_eq(t_low, 0, "40 hands, the dealer never stood below 17")
g4t_eq(t_high, 0, "...and never drew past a possible bust")

# =============================================================================
# FROGGER. The river is the inverse of the road, and a footprint that straddles
# the wrap still counts.
# =============================================================================
print("")
print("Frogger - the river is the inverse of the road")

fr_reset()
fr_t = 0
fr_level = 1
# lane 1 runs right, length 3, period 6, so at t = 0 an object covers
# x8 0..23 and the NEXT one starts at 48.
g4t_eq(fr_off(1), 0, "at t=0 lane 1 has not moved")
g4t_eq(fr_hit(1, 0), 1, "the frog is on the log at its near end")
g4t_eq(fr_hit(1, 16), 1, "...and at its far end")
g4t_eq(fr_hit(1, 24), 0, "one eighth past it, there is water")
g4t_eq(fr_hit(1, 32), 0, "...and further along, still water")
g4t_eq(fr_hit(1, 40), 0, "a footprint ending exactly at the next log is water")
g4t_eq(fr_hit(1, 41), 1, "...and one eighth later it is on it - the wrap counts")
g4t_eq(fr_hit(0, 0), 0, "the home bank is not a lane")
g4t_eq(fr_hit(6, 0), 0, "the median is not a lane")
g4t_eq(fr_hit(12, 0), 0, "the start bank is not a lane")

# ON THE RIVER, no log kills. ON THE ROAD, a car kills and open road does not.
# Same fr_hit, opposite meaning, and swapping the two is the single mistake
# that turns a Frogger into something else.
fr_reset()
fr_state = 1
fr_t = 0
fr_row = 1
fr_x8 = 24
t_lives = fr_lives
fr_check()
g4t_ok(fr_lives == t_lives - 1, "on the river, no log under you is a drowning")
g4t_eq(fr_why, 2, "...and it is recorded as drowning")

fr_reset()
fr_state = 1
fr_t = 0
fr_row = 1
fr_x8 = 8
t_lives = fr_lives
fr_check()
g4t_eq(fr_lives, t_lives, "on the river, a log under you is safe")

fr_reset()
fr_state = 1
fr_t = 0
fr_row = 7
fr_x8 = 0
t_lives = fr_lives
fr_check()
g4t_ok(fr_lives == t_lives - 1, "on the road, a car on you is a squashing")
g4t_eq(fr_why, 1, "...and it is recorded as squashing")

fr_reset()
fr_state = 1
fr_t = 0
fr_row = 7
fr_x8 = 24
t_lives = fr_lives
fr_check()
g4t_eq(fr_lives, t_lives, "on the road, open tarmac is safe")

# a bay is only claimed once
fr_reset()
fr_home = 0
fr_x8 = 0
fr_row = 1
fr_state = 1
fr_home_in()
g4t_eq(fr_home, 1, "landing in the leftmost bay fills it")
fr_x8 = 0
fr_row = 1
fr_state = 1
t_lives = fr_lives
fr_home_in()
g4t_ok(fr_lives == t_lives - 1, "landing in a bay that is taken costs a life")
g4t_eq(fr_home, 1, "...and does not re-fill it")

# =============================================================================
# MISSILE COMMAND. A blast that kills a missile leaves a blast where it died -
# that is the chain, and without it the game is a shooting gallery.
# =============================================================================
print("")
print("Missile Command - the chain")

mc_reset()
# clear the field, then plant one warhead halfway down at a known column and a
# blast right on top of it.
t_i = 0
while t_i < MC_NIN { mc_sin(t_i, 4, 0)  t_i = t_i + 1 }
t_i = 0
while t_i < MC_NBL { mc_sbl(t_i, 3, 0)  t_i = t_i + 1 }
mc_sin(0, 0, 200)
mc_sin(0, 1, 200)
mc_sin(0, 2, 500)
mc_sin(0, 3, 5)
mc_sin(0, 4, 1)
mc_sin(0, 5, 0)
g4t_eq(mc_inx(0, 400), 200, "the warhead is where it was put")
g4t_eq(mc_iny(0, 400), 189, "...half way down to the ground")
t_score = mc_score
mc_boom(200, 189)
mc_sbl(0, 2, 12)
mc_kill(400, 400)
g4t_eq(mc_in(0, 4), 0, "a blast on a warhead destroys it")
g4t_ok(mc_score == t_score + 25, "...and scores it")
t_blasts = 0
t_i = 0
while t_i < MC_NBL { if mc_bl(t_i, 3) != 0 { t_blasts = t_blasts + 1 }  t_i = t_i + 1 }
g4t_ok(t_blasts >= 2, "...and leaves a second blast where it died - the chain")

# a blast nowhere near it leaves it alone
t_i = 0
while t_i < MC_NIN { mc_sin(t_i, 4, 0)  t_i = t_i + 1 }
t_i = 0
while t_i < MC_NBL { mc_sbl(t_i, 3, 0)  t_i = t_i + 1 }
mc_sin(0, 0, 200)
mc_sin(0, 1, 200)
mc_sin(0, 2, 500)
mc_sin(0, 3, 5)
mc_sin(0, 4, 1)
mc_sin(0, 5, 0)
mc_boom(20, 20)
mc_sbl(0, 2, 12)
mc_kill(400, 400)
g4t_eq(mc_in(0, 4), 1, "a blast across the map does not touch it")

# every city starts standing, and a warhead landing takes exactly one
mc_reset()
g4t_eq(mc_alive_cities(), MC_CITIES, "a new game has every city standing")
mc_scity(2, 0)
g4t_eq(mc_alive_cities(), MC_CITIES - 1, "...and losing one is counted")

# =============================================================================
print("")
print(" ", g4t_n, "checks,", g4t_fail, "failures")
if g4t_fail > 0 { exit(1) }
print("  OK")
