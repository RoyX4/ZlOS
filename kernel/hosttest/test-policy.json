  "source_overrides": {
    "browsertest_san": "browsertest.c",
    "jmptest32": "jmptest.c"
  },
  "optional_build": [
    "gpu_blt",
    "gpu_fillrate"
  ],
  "default_timeout_seconds": 180
}
