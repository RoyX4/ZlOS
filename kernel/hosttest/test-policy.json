      "gpu-dev.sh",
      "gpu-ring-run.sh",
      "modeset-run.sh"
    ],
    "builder": [
      "build.sh"
    ]
  },
  "commands": {
    "gpu_blt": [
      ["./gpu_blt"],
      ["./gpu_blt", "--negative"]
    ],
    "zladdrs.sh": [
      ["./zladdrs.sh"],
      ["./zladdrs.sh", "--selftest"]
