# kernel.zl - a kernel with a shell, written in zl.
#
# Runs on bare metal: no OS, no libc, no syscalls. The serial driver below
# is ordinary zl calling inb/outb, so this is not "C does the work and zl
# prints" - the device handling is in the language.
#
# MASTER_PLAN Floor 6 level 2 is "boot a VM, get a prompt, type a command,
# my language runs it". This is that.

COM1 = 0x3F8

# ---------------------------------------------------------------- serial
# Line Status Register, bit 0: a byte is waiting to be read.
fn kbd_ready() { return band(inb(COM1 + 5), 1) }
fn kbd_read()  { return inb(COM1) }

# --------------------------------------------------------------- VGA text
# 0xB8000 is the text buffer: two bytes per cell, character then colour.
VGA = 0xB8000

fn vga_put(pos, ch, attr) {
    vp = VGA + pos * 2
    poke8(vp, ch)
    poke8(vp + 1, attr)
}

fn vga_banner(text_len, row) {
    vb_i = 0
    while vb_i < 80 {
        vga_put(row * 80 + vb_i, 32, 0x1F)
        vb_i = vb_i + 1
    }
}

# ------------------------------------------------------------- the shell
fn is_digit(c) { return c >= 48 and c <= 57 }

fn run_command(cmd, arg) {
    # cmd is a single letter; keeping the parser tiny keeps the kernel
    # inside the subset (no string values, so commands are characters).
    if cmd == 104 {                       # h - help
        print("")
        print("  h        this help")
        print("  f <n>    fib(n)")
        print("  s <n>    sum of squares to n")
        print("  m        read a byte back from VGA memory")
        print("  c        clear the screen")
        print("  q        halt the machine")
        return 0
    }
    if cmd == 102 {                       # f - fib
        print("")
        print(fib(arg))
        return 0
    }
    if cmd == 115 {                       # s - sum of squares
        print("")
        print(sum_squares(arg))
        return 0
    }
    if cmd == 109 {                       # m - poke/peek proof
        poke8(VGA + 158, 42)              # a '*' near the top-right
        poke8(VGA + 159, 0x4F)
        print("")
        print("wrote '*' to VGA, read back:")
        print(peek8(VGA + 158))
        return 0
    }
    if cmd == 99 {                        # c - clear
        vc_i = 0
        while vc_i < 2000 {
            vga_put(vc_i, 32, 0x07)
            vc_i = vc_i + 1
        }
        print("")
        print("screen cleared")
        return 0
    }
    if cmd == 113 { return 1 }            # q - quit
    print("")
    print("unknown command - press h for help")
    return 0
}

fn fib(n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn sum_squares(n) {
    ss_t = 0
    ss_i = 1
    while ss_i <= n {
        ss_t = ss_t + ss_i * ss_i
        ss_i = ss_i + 1
    }
    return ss_t
}

# ----------------------------------------------------------------- boot
print("========================================")
print("  zl kernel")
print("  no OS. no libc. no syscalls.")
print("========================================")
print("")
print("the serial driver below is written in zl:")
print("inb/outb are builtins, the polling is zl.")
print("")
print("press h for help, q to halt.")

# paint the top row so the screen shows something too
vga_banner(80, 0)
vga_put(0, 90, 0x1F)      # Z
vga_put(1, 76, 0x1F)      # L
vga_put(3, 83, 0x1F)      # S
vga_put(4, 72, 0x1F)      # H

# --------------------------------------------------------- the main loop
# A real read-eval-print loop, polling the UART. This is the whole point:
# the machine is now waiting for YOU.
running = 1
pending = 0                # a digit typed before a command letter

while running == 1 {
    print("")
    print("zl> ")

    got = 0
    while got == 0 {
        if kbd_ready() == 1 {
            ch = kbd_read()

            if is_digit(ch) == true {
                pending = pending * 10 + (ch - 48)
                # echo the digit so typing feels real
                print(ch - 48)
            } else {
                if ch > 32 {
                    r = run_command(ch, pending)
                    pending = 0
                    got = 1
                    if r == 1 { running = 0 }
                }
            }
        }
    }
}

print("")
print("halting.")
