# kernel.zl - zlOS
#
# A kernel with a graphical console and a shell, written in zl. Runs on bare
# metal: no OS, no libc, no syscalls, no GRUB on the BIOS path. The serial and
# keyboard drivers are zl; on a UEFI framebuffer the whole UI - gradients, a
# scaled logo, panels, a block cursor - is drawn pixel by pixel from zl too.

COM1 = 0x3F8
VGA  = 0xB8000

# ---- palette (VGA colour indices; the framebuffer maps them to RGB) --------
C_BLACK  = 0x00
C_BLUE   = 0x01
C_GREEN  = 0x0A
C_CYAN   = 0x0B
C_RED    = 0x0C
C_GREY   = 0x07
C_DGREY  = 0x08
C_LBLUE  = 0x09
C_YELLOW = 0x0E
C_WHITE  = 0x0F

C_TITLE  = 0x1F      # white on blue (VGA title fallback)
C_STATUS = 0x8F      # white on dark grey
C_CURSOR = 0x0A      # green block cursor

# ---- true-colour theme (framebuffer only) ----------------------------------
# The 16 VGA colours are harsh; the framebuffer is real RGB, so the desktop
# uses packed 0xRRGGBB colours (r*65536 + g*256 + b) for smooth gradients.
fn rgb(rr, gg, bb) { return rr * 65536 + gg * 256 + bb }
WALL_TOP = rgb(26, 30, 50)      # wallpaper: deep slate-blue, top
WALL_BOT = rgb(10, 12, 22)      # ... to near-black at the bottom
HDR_TOP  = rgb(48, 92, 168)     # title bar: bright blue
HDR_BOT  = rgb(22, 40, 92)      # ... to deep blue
ACCENT   = rgb(96, 210, 235)    # bright cyan accent line
BAR_TOP  = rgb(40, 46, 66)      # taskbar top
BAR_BOT  = rgb(18, 20, 32)      # taskbar bottom
BAR_HI   = rgb(78, 92, 128)     # taskbar top highlight
PANEL    = rgb(0, 0, 0)        # content panel = black, matches text cell bg
TXT_HI   = rgb(210, 228, 255)   # light text
TXT_DIM  = rgb(150, 165, 195)   # dim text

# ---- serial input, in zl ---------------------------------------------------
fn ser_ready() { return band(inb(COM1 + 5), 1) }
fn ser_read()  { return inb(COM1) }

# ---- PS/2 keyboard, in zl --------------------------------------------------
KBD_TABLE = 0x7000
fn kmap(code, ch) { poke8(KBD_TABLE + code, ch) }
fn kbd_init() {
    fill_mem(KBD_TABLE, 0, 128)
    kmap(0x02, 49)  kmap(0x03, 50)  kmap(0x04, 51)  kmap(0x05, 52)
    kmap(0x06, 53)  kmap(0x07, 54)  kmap(0x08, 55)  kmap(0x09, 56)
    kmap(0x0A, 57)  kmap(0x0B, 48)
    kmap(0x10, 113) kmap(0x11, 119) kmap(0x12, 101) kmap(0x13, 114)
    kmap(0x14, 116) kmap(0x15, 121) kmap(0x16, 117) kmap(0x17, 105)
    kmap(0x18, 111) kmap(0x19, 112)
    kmap(0x1E, 97)  kmap(0x1F, 115) kmap(0x20, 100) kmap(0x21, 102)
    kmap(0x22, 103) kmap(0x23, 104) kmap(0x24, 106) kmap(0x25, 107)
    kmap(0x26, 108)
    kmap(0x2C, 122) kmap(0x2D, 120) kmap(0x2E, 99)  kmap(0x2F, 118)
    kmap(0x30, 98)  kmap(0x31, 110) kmap(0x32, 109)
    kmap(0x39, 32)                      # space
    kmap(0x1C, 13)                      # enter
    kmap(0x0E, 8)                       # backspace
    kmap(0x01, 27)                      # esc
    kmap(0x33, 44)  kmap(0x34, 46)  kmap(0x35, 47)   # , . /
    kmap(0x0C, 45)  kmap(0x0D, 61)                   # - =
    kmap(0x27, 59)  kmap(0x28, 39)                   # ; '
    kmap(0x1A, 91)  kmap(0x1B, 93)                   # [ ]
}

# shift state, tracked for the editor so it can type capitals
shift_state = 0

# a shift-aware read: returns a translated character, or 0 if nothing / a
# modifier / a release. Uppercases letters; leaves the rest as-is (v1).
fn edit_key() {
    uk = usb_key()
    # Codes >= 256 are keys with no character - arrows, F-keys, Home/End. The
    # editor appends and deletes; it has no cursor to move, so it has no use
    # for them. Dropping them here matters: further down, anything >= 32 gets
    # poke8'd into the text buffer, and poke8 would truncate 0x110 to 0x10 and
    # write a control byte into the file.
    if uk >= 256 { return 0 }
    if uk != 0 { return uk }
    sc = scan_get()
    if sc == 0 { return 0 }
    if sc == 0x2A { shift_state = 1  return 0 }      # left shift down
    if sc == 0x36 { shift_state = 1  return 0 }      # right shift down
    if sc == 0xAA { shift_state = 0  return 0 }      # left shift up
    if sc == 0xB6 { shift_state = 0  return 0 }      # right shift up
    if band(sc, 0x80) != 0 { return 0 }              # any other release
    ch = peek8(KBD_TABLE + sc)
    if ch == 0 { return 0 }
    if shift_state == 1 { if ch >= 97 { if ch <= 122 { ch = ch - 32 } } }
    return ch
}
# The keyboard now arrives by INTERRUPT: the IRQ1 handler drops each scancode
# into a ring buffer, and scan_get() pulls the next one (0 when empty). This
# replaced polling port 0x60 directly, which dropped keys on real hardware.
fn kbd_scan() {
    sc = scan_get()
    if sc == 0 { return 0 }
    if band(sc, 0x80) != 0 { return 0 }     # key release - ignore
    return peek8(KBD_TABLE + sc)
}
# The shell's character source. Serial stays first so the automated gates,
# which drive zlOS over a pipe, behave exactly as before. Everything a human
# types goes through the input stack: PS/2 and USB both land in one event
# queue with modifiers, caps lock and auto-repeat already applied.
fn key_get() {
    if ser_ready() == 1 { return ser_read() }
    return in_char()
}

# The editor's reader: a character, OR a navigation key above 0x100 so it can
# tell an arrow from a letter.
fn key_full() {
    if ser_ready() == 1 { return ser_read() }
    return in_key()
}

# key codes the input stack reports for the non-printing keys
K_ESC = 0x101
K_BKSP = 0x102
K_TAB = 0x103
K_ENTER = 0x104
K_LEFT = 0x110
K_RIGHT = 0x111
K_UP = 0x112
K_DOWN = 0x113
K_HOME = 0x114
K_END = 0x115
K_DEL = 0x119

# ---- timing + sound, both riding on the timer interrupt --------------------
fn wait_ticks(n) {
    target = ticks() + n
    while ticks() < target { }
}
fn beep(freq, dur) {
    beep_on(freq)
    wait_ticks(dur)
    beep_off()
}

# ---- graphical chrome ------------------------------------------------------
# On a framebuffer these draw real pixels; on VGA text the primitives no-op
# and the plain text title/status bars are used instead.

# ---- the top bar -----------------------------------------------------------
# A thin, flat GNOME-style bar: system name on the left, clock in the middle,
# status on the right. Deliberately NOT a branded banner - an operating system
# does not explain what it is in its own top bar, it just tells you the state
# of the machine. That is the whole difference between a demo and a desktop.
# The UI scale: 1 on a small screen, 2 once the console switches to 16x32
# cells. EVERY offset and size below is multiplied by it, so the desktop is
# laid out in design units rather than raw pixels and stays correct at any
# resolution instead of colliding when the text grows.
fn ui() { return cell_w() / 8 }
TITLE_H = 28                       # window title bar height, in design units
MON_W = 284                        # System Monitor / About width
MON_H = 214                        # System Monitor height
AB_H  = 122                        # About height
TOPBAR_H = 32
DESK_TOP = 40                    # first row of desktop below the bar + hairline
TOP_BG   = rgb(20, 23, 33)
TOP_LINE = rgb(8, 9, 14)
TOP_TXT  = rgb(226, 234, 248)
TOP_DIM  = rgb(128, 140, 166)
OK_GRN   = rgb(120, 220, 140)

fn draw_header() {
    if px_w() > 0 {
        w = px_w()
        u = ui()
        hb = TOPBAR_H * u
        fill_rgb(0, 0, w, hb, TOP_BG)                     # flat, no gradient
        fill_rgb(0, hb, w, 1, TOP_LINE)                   # hairline separator
        grad_rgb(0, hb + 1, w, 7, rgb(12, 14, 21), WALL_TOP)
        ht = (hb - 16 * u) / 2                            # text baseline, centred
        fill_rgb(14 * u, (hb - 10 * u) / 2, 10 * u, 10 * u, ACCENT)
        text_aa(34 * u, ht, "zlOS", TOP_TXT)
        text_aa(90 * u, ht, "Activities", TOP_DIM)
        # right side: live machine state, laid out from the right edge
        text_aa(w - 300 * u, ht, "fb", TOP_DIM)
        num_aa(w - 276 * u, ht, w, TOP_TXT)
        text_aa(w - 200 * u, ht, "x", TOP_DIM)
        num_aa(w - 184 * u, ht, px_h(), TOP_TXT)
        # This corner used to draw "net", a green dot, and "up".
        #
        # There is no network driver anywhere in this tree - no e1000, no
        # virtio-net, no rtl8139, no network code at all - so that green dot
        # was a claim about hardware that does not exist, made to the user's
        # face on every frame. HANDOFF.md is held to the standard that it
        # records what is VERIFIED rather than what is intended; the screen is
        # now held to the same one.
        #
        # What replaces it is the one thing this corner can truthfully say:
        # the actual time, off the CMOS clock in rtc.c. Drawn a glyph at a
        # time through char_aa, the same way sysmon_body draws the CPU brand
        # string, because the zl kernel subset has no string values. When the
        # clock cannot be read, rtc_ch spells "--:--" rather than a stale time.
        rtc_up()
        hdri = 0
        hdrx = w - 108 * u
        while hdri < 5 {
            char_aa(hdrx, ht, rtc_ch(hdri), TOP_TXT)
            hdrx = hdrx + cell_w()
            hdri = hdri + 1
        }
    } else {
        bar(0, C_TITLE)
        at(0, 2, "zlOS", C_TITLE)
    }
}

# the dock top edge, cell-aligned to row (rows-3) so at_num can place the clock
fn dock_y() { return px_h() - 64 * ui() }

# one app-launcher tile: a rounded chip with a real 24x24 icon in it. Icons,
# not key letters - you are meant to click these, not memorise a hotkey.
DOCK_X0 = 118            # first tile
DOCK_PITCH = 56          # tile-to-tile spacing
DOCK_TW = 48             # tile width/height

fn dock_tile(slot, dy, ic) {
    u = ui()
    dtx = DOCK_X0 * u + slot * DOCK_PITCH * u
    dtw = DOCK_TW * u
    rrect(dtx, dy + 8 * u, dtw, dtw, 8 * u, rgb(34, 40, 58))
    fill_rgb(dtx, dy + 8 * u, dtw, 1, rgb(66, 78, 108))
    icon(dtx + (dtw - 24 * u) / 2, dy + 8 * u + (dtw - 24 * u) / 2, ic, TXT_HI)
    return 0
}

# which app each dock slot launches. Kept in one place so the drawing and the
# click test can never drift apart.
fn dock_icon(slot) {
    if slot == 0 { return 0 }    # terminal
    if slot == 1 { return 7 }    # files
    if slot == 2 { return 3 }    # editor
    if slot == 3 { return 2 }    # paint
    if slot == 4 { return 1 }    # snake
    if slot == 5 { return 6 }    # 3D cube
    if slot == 6 { return 4 }    # system monitor
    if slot == 7 { return 5 }    # about
    if slot == 8 { return 9 }    # power
    return 0 - 1
}
fn dock_cmd(slot) {
    if slot == 0 { return 104 }  # help
    if slot == 1 { return 108 }  # list RAM files
    if slot == 2 { return 105 }  # editor
    if slot == 3 { return 100 }  # paint
    if slot == 4 { return 103 }  # snake
    if slot == 5 { return 118 }  # 3D cube
    if slot == 8 { return 113 }  # halt
    return 0                     # 6 and 7 reopen windows, handled by the caller
}

# the dock: a taller gradient strip with a start button, app tiles and a tray
fn draw_status(msg) {
    sr = status_row()
    if px_w() > 0 {
        w = px_w()
        dy = dock_y()
        grad_rgb(0, dy - 6, w, 6, WALL_BOT, rgb(6, 7, 12))    # soft shadow above
        grad_rgb(0, dy, w, px_h() - dy, BAR_TOP, BAR_BOT)     # the dock
        fill_rgb(0, dy, w, 1, BAR_HI)                          # top highlight
        u = ui()
        rrect(10 * u, dy + 8 * u, 96 * u, DOCK_TW * u, 8 * u, rgb(48, 92, 168))
        fill_rgb(10 * u, dy + 8 * u, 96 * u, 1, rgb(120, 170, 235))
        fill_rgb(24 * u, dy + 26 * u, 11 * u, 11 * u, ACCENT)
        text_aa(44 * u, dy + 22 * u, "zlOS", C_WHITE)
        # app tiles - all icons
        ds = 0
        while ds < 9 {
            dock_tile(ds, dy, dock_icon(ds))
            ds = ds + 1
        }
        # tray: state + uptime
        # the tray must start AFTER the last dock tile, or on a narrow screen
        # the two overlap - at 800x600 nine tiles reach x=622 while w-300 is 500
        tray = w - 300 * u
        dend = DOCK_X0 * u + 9 * DOCK_PITCH * u + 16 * u
        if tray < dend { tray = dend }
        text_aa(tray, dy + 22 * u, "state:", TXT_DIM)
        text_aa(tray + 60 * u, dy + 22 * u, msg, ACCENT)
        text_aa(tray + 170 * u, dy + 22 * u, "up:", TXT_DIM)
    } else {
        bar(sr, C_STATUS)
        at(sr, 2,  "h help", C_STATUS)
        at(sr, 12, "q halt", C_STATUS)
        at(sr, 40, "state:", C_STATUS)
        at(sr, 47, msg, C_STATUS)
        at(sr, 62, "uptime:", C_STATUS)
    }
}

# just the uptime number, redrawn each second. On the framebuffer it is drawn
# in true colour over the taskbar; on VGA it uses the text cell.
fn draw_clock(sec) {
    if px_w() > 0 {
        w = px_w()
        dy = dock_y()
        ctray = w - 300 * ui()
        cdend = DOCK_X0 * ui() + 9 * DOCK_PITCH * ui() + 16 * ui()
        if ctray < cdend { ctray = cdend }
        grad_rgb(ctray + 200 * ui(), dy + 12 * ui(), 80 * ui(), 30 * ui(), BAR_TOP, BAR_BOT)
        num_aa(ctray + 204 * ui(), dy + 22 * ui(), sec, TXT_HI)                  # AA, blends over dock
    } else {
        at_num(status_row(), 70, sec, C_STATUS)
    }
}

# [ OK ]/[ INFO ] boot lines, assembled from coloured pieces
fn ok_line(msg) {
    color(C_GREY)  put("  [")
    color(C_GREEN) put("  OK  ")
    color(C_GREY)  put("] ")
    color(C_GREY)  print(msg)
}
fn info_line(msg) {
    color(C_GREY)  put("  [")
    color(C_CYAN)  put(" INFO ")
    color(C_GREY)  put("] ")
    color(C_GREY)  print(msg)
}

# ---- the work the shell can do ---------------------------------------------
# Recursive, and it WORKS: zl gives every function call its own frame for the
# PARAMETERS, so `n` is restored after each sub-call - fib(20) returns 6765,
# verified against the golden transcript. (The no-locals gotcha only bites
# same-named *free locals*, e.g. a helper's `running` stomping the shell's.)
fn fib(n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
fn sum_squares(n) {
    t = 0
    i = 1
    while i <= n { t = t + i * i  i = i + 1 }
    return t
}
fn is_digit(c) { return c >= 48 and c <= 57 }

fn help() {
    color(C_CYAN)  print("  commands")
    color(C_GREY)
    print("    h        this help")
    print("    <n> f    fib(n)          e.g.  20f")
    print("    <n> s    sum of squares  e.g.  10s")
    print("    t        uptime, from the timer interrupt")
    print("    p        the CPU's own brand string, via CPUID")
    print("    b        colour-bar graphics demo (with sound)")
    print("    a        animation - a bouncing logo over a starfield")
    print("    x        mouse demo - a cursor driven by the PS/2 mouse")
    print("    g        play SNAKE (w a s d to steer)")
    print("    d        paint with the mouse")
    print("    <n> i    edit RAM file n (0-9) - ESC saves it")
    print("    l        list the RAM files")
    print("    e        beep the PC speaker")
    print("    m        poke a byte into video memory and read it back")
    color(C_CYAN)  print("  our hardware drivers")
    color(C_GREY)
    print("    k        PCI bus + the Intel GPU, read off real silicon")
    print("    u        USB: take the xHCI controller and enumerate the bus")
    print("    j        USB keyboard - live, straight off the HID reports")
    print("    n        change the screen resolution, no BIOS involved")
    print("    v        spinning 3D cube, rendered in software")
    print("    w        draggable windows")
    print("    y        virtio-gpu - a real GPU driver, virtqueues and all")
    print("    z        the processor: CPUID, topology, caches, TSC clock")
    print("    o        NVMe disk - identify, then write and read a block back")
    print("    +        multitasking - three tasks running beside the shell")
    print("    *        SMP - wake the other CPU cores with INIT/STARTUP IPIs")
    print("    /        USB mass storage - SCSI over USB, read a sector")
    print("    ?        I2C-HID touchpad (real hardware only - QEMU has no LPSS I2C)")
    print("    =        input events - keys, modifiers, repeat, live")
    print("    c        clear the screen")
    print("    r        reboot the machine")
    print("    q        halt the machine")
}

# a graphics demo: 14 colour bars, proving the framebuffer is ours to paint
fn colorbars() {
    if px_w() == 0 {
        color(C_GREY)  print("  (colour bars need the framebuffer console)")
        return 0
    }
    y = row() * 16 + 8
    w = px_w() / 14
    i = 1
    while i <= 14 {
        fill_rect((i - 1) * w, y, w, 40, i)
        i = i + 1
    }
    print("")
    print("")
    print("")
    color(C_GREY)  print("  14 colours, painted straight into the framebuffer")
    return 0
}

# ---- a live mouse demo: a cursor that follows the PS/2 mouse ---------------
fn mousedemo() {
    if px_w() == 0 {
        color(C_GREY)  print("  the mouse demo needs the framebuffer console")
        return 0
    }
    w = px_w()
    h = px_h()
    cls()
    color(C_WHITE)  print("  MOUSE - move it. left/right button changes colour. press any key to exit.")
    print("")
    color(C_GREY)   put("  x: ")  at(row(), 8, "     y:", C_GREY)
    ox = 0
    oy = 0
    while key_get() == 0 {
        mx = mouse_x()
        my = mouse_y()
        if mx > w - 12 { mx = w - 12 }
        if my > h - 18 { my = h - 18 }
        if my < 48 { my = 48 }
        fill_rect(ox, oy, 12, 18, C_BLACK)     # erase the old cursor
        col = C_GREEN
        if band(mouse_btn(), 1) != 0 { col = C_RED }
        if band(mouse_btn(), 2) != 0 { col = C_CYAN }
        mcursor(mx, my, col, C_WHITE)
        ox = mx
        oy = my
        at_num(2, 5, mx, C_WHITE)
        at_num(2, 16, my, C_WHITE)
        present()          # drawing lands in the back buffer; this is the blit
    }
    draw_screen()
    # Say how many IRQ12 packets actually arrived. A dead pointer has two very
    # different causes and this separates them: 0 means no interrupt reached us
    # at all, non-zero with a stuck cursor means the decode is wrong.
    color(C_GREY)  put("  mouse: ")
    color(C_WHITE) put(mouse_irqs())
    color(C_GREY)  put(" IRQ12 packets, last at ")
    color(C_WHITE) put(mouse_x())  put(",")  print(mouse_y())
    # Which slot/endpoint each HID device landed on. They MUST differ: the
    # interrupt ring is per-slot, so two devices sharing one would corrupt it
    # and whichever spoke second would silence the other.
    color(C_GREY)  put("  usb kbd slot ")  color(C_WHITE)  put(usb_kbd_slot())
    color(C_GREY)  put(" ep ")             color(C_WHITE)  put(usb_kbd_ep())
    color(C_GREY)  put("   ptr slot ")     color(C_WHITE)  put(ptr_slot())
    color(C_GREY)  put(" ep ")             color(C_WHITE)  put(ptr_ep())
    # How many pointer reports have been decoded in total. If this is enormous
    # after a demo that never moved the pointer, the endpoint is storming the
    # shared event ring and starving the keyboard behind it.
    color(C_GREY)  put("  ptr reports ")   color(C_WHITE)  put(ptr_reports())
    # Every dispatch, and the last completion code. ptr_reports counts only
    # SUCCESSFUL decodes, so a stalled endpoint being requeued in a loop leaves
    # it at 1 while events climbs without bound - which is why the earlier
    # "no storm" reading was worthless.
    color(C_GREY)  put("  events ")        color(C_WHITE)  put(ptr_events())
    color(C_GREY)  put("  last cc ")       color(C_WHITE)  print(ptr_lastcc())
    # The keyboard side, same shape. The pointer is healthy; the keyboard
    # delivers exactly one report and then goes quiet, so what matters is
    # whether kbd_events stops at 1 and whether the re-arm actually happened.
    color(C_GREY)  put("  kbd events ")   color(C_WHITE)  put(kbd_events())
    color(C_GREY)  put("  requeues ")     color(C_WHITE)  put(kbd_requeues())
    color(C_GREY)  put("  last cc ")      color(C_WHITE)  print(kbd_lastcc())
    color(C_GREY)
    color(C_GREY)
    color(C_GREY)
    return 0
}

# ---- a real window: soft drop shadow, rounded panel, gradient title bar ----
# This is increment #3+#4 of the desktop plan proven end to end: get_px-backed
# shadows, rrect chrome, a true-colour title bar, all drawn by the CPU.
fn draw_window(wx, wy, ww, wh, title, focus) {
    u = ui()
    shadow(wx, wy, ww, wh, 8 * u, 6 * u)
    rrect(wx, wy, ww, wh, 5 * u, rgb(20, 26, 42))
    rrect(wx + 1, wy + 1, ww - 2, wh - 2, 4 * u, PANEL)
    tbt = rgb(48, 92, 168)
    tbb = rgb(22, 40, 92)
    if focus == 0 { tbt = rgb(42, 53, 80)  tbb = rgb(24, 34, 56) }
    grad_rgb(wx + 4, wy + 3, ww - 8, TITLE_H * u - 5, tbt, tbb)
    if focus == 1 { fill_rgb(wx + 4, wy + TITLE_H * u - 2, ww - 8, 2, ACCENT) }
    fill_rgb(wx + ww - 20 * u, wy + 9 * u, 11 * u, 11 * u, rgb(224, 90, 90))
    text_aa(wx + 12 * u, wy + 7 * u, title, rgb(234, 243, 255))
    return 0
}

# w - three overlapping windows over the wallpaper: the real thing next to the
# mockup, so the software-vs-browser gap is judged by eye, not by promise
fn windows_demo() {
    if px_w() == 0 {
        color(C_GREY)  print("  the window demo needs the framebuffer console")
        return 0
    }
    w = px_w()
    h = px_h()
    grad_rgb(0, 0, w, h, WALL_TOP, WALL_BOT)            # fresh wallpaper
    draw_window(70, 74, 300, 150, "System Monitor", 0)
    text_aa(104, 118, "CPU  load  steady", TXT_DIM)
    text_aa(104, 138, "mem  64 / 256 MiB", TXT_DIM)
    draw_window(150, 150, 340, 200, "zl shell", 1)
    text_aa(186, 194, "the quick brown fox jumps", TXT_HI)
    text_aa(186, 214, "over 0123456789 !@#$%&*", TXT_DIM)
    text_aa(186, 244, "zl> gfx compose --shadows", ACCENT)
    draw_window(440, 258, 250, 120, "Clock", 0)
    text_aa(500, 300, "12:04:37", TXT_HI)
    text_aa(70, h - 58, "real windows - real shadows - press any key", ACCENT)
    present()              # everything above is still in the back buffer
    while key_get() == 0 { }
    draw_screen()
    return 0
}

# a spinning 3D cube - proof the CPU can do real 3D with no GPU and no floats.
# Two wireframe cubes counter-rotating in a viewport window; the maths lives in
# fb.c (integer sine + a perspective divide), zl just spins the angle.
# USB link speeds, as the controller reports them in PORTSC bits 13:10.
# The numbering is the xHCI "Protocol Speed ID"; 1-4 are the defaults every
# controller uses, higher values are only meaningful with the extended
# capability tables, so anything else is reported honestly as unknown.
# Bring the USB stack all the way up: find the controller, take it from the
# firmware, build the DMA rings, then look for a boot-protocol keyboard on
# every port. Returns the keyboard's slot, or 0 if there is no keyboard.
# Safe to call twice - enumeration remembers what it already did.
# Bring the whole USB stack up and SAY what happened.
#
# This runs at boot, before anything is typed, on purpose: on a real UEFI
# machine the firmware's PS/2 emulation dies with ExitBootServices, so if this
# driver fails there is no keyboard to ask it with. The status has to be on the
# screen already. Stays silent when there is no xHCI controller at all, so the
# BIOS/serial test path is unchanged.
fn usb_boot() {
    ub = usb_up()
    if usb_ok() == 0 {
        # Say WHY, and say it on screen. On a UEFI machine there is no serial
        # console and no working PS/2, so a silent failure here is a machine
        # you cannot interact with and cannot diagnose.
        color(C_RED)
        put("  USB: no xHCI controller (")  put(pci_count())
        print(" PCI devices seen)")
        color(C_GREY)
        return 0
    }
    if ub > 0 {
        color(C_GREEN)
        put("  USB: HID keyboard live on slot ")  print(ub)
    } else {
        color(C_RED)
        if usb_ours() == 1 {
            print("  USB: controller is ours, but no HID boot keyboard found")
            color(C_GREY)
            # Dump what IS on the bus. On a machine with no keyboard and no
            # serial this is the only diagnostic we will ever get.
            ubp = 1
            while ubp <= usb_ports() {
                if usb_conn(ubp) == 1 {
                    put("    port ")   put(ubp)
                    put(" portsc 0x")  hex(usb_portsc(ubp), 8)
                    put(" reset->")    put(usb_prst(ubp))
                    put(" now 0x")     hex(usb_portsc(ubp), 8)
                    ubs = usb_enum(ubp)
                    put(" slot ")      put(ubs)
                    if ubs > 0 {
                        put(" vid ")  hex(usb_vid(), 4)
                        put(":")      hex(usb_pid(), 4)
                        put(" cls ")  hex(usb_cls(), 2)
                    }
                    print("")
                }
                ubp = ubp + 1
            }
        } else {
            print("  USB: could not take the xHCI controller")
        }
    }
    color(C_GREY)
    return ub
}

# Live echo test for the USB keyboard. This is the proof that stage 5 works:
# characters here came off the wire as HID reports, not from the PS/2 port.
fn usbkey_demo() {
    color(C_CYAN)  print("  USB keyboard test")
    color(C_GREY)
    if usb_kbd_ok() == 0 {
        if usb_boot() == 0 {
            color(C_RED)  print("    no USB boot keyboard found")
            color(C_GREY)
            return 0
        }
    }
    put("    keyboard on slot ")  put(usb_kbd_slot())
    put(", endpoint dci ")        print(usb_kbd_ep())
    print("    type - ESC or 60s ends the test")
    put("    ")
    ustop = ticks() + 6000
    while ticks() < ustop {
        uc = usb_key()
        if uc != 0 {
            if uc == 27 { print("")  print("    ESC - done")  return 0 }
            # >= 256 is a key with no character (arrow, F-key, Home/End).
            # emit() would draw whatever glyph that number lands on, so show
            # the code instead - this test exists to prove keys arrive.
            if uc >= 256 { put("<")  hex(uc, 3)  put(">") } else {
                if uc == 13 { print("")  put("    ") } else { emit(uc) }
            }
        }
    }
    print("")
    print("    timed out")
    return 0
}

# ---- a real line editor ---------------------------------------------------
# Reading a line is not "collect characters until Enter". A usable prompt has
# a cursor you can move, editing that happens in the middle of the line, and
# a history you can walk back through. That is the difference between typing
# at a computer and operating one.
#
# The line lives in memory at LINE_BUF, the history is a ring of HIST_N slots
# above it, and both are plain bytes - there is no allocator to ask.
LINE_BUF  = 0x02020000
LINE_MAX  = 200
HIST_BUF  = 0x02021000
HIST_N    = 16
hist_count = 0
hist_pos   = 0

fn line_get(i)    { return peek8(LINE_BUF + i) }
fn line_set(i, c) { poke8(LINE_BUF + i, c) }

fn hist_save(len) {
    hslot = hist_count % HIST_N
    hi = 0
    while hi < len {
        poke8(HIST_BUF + hslot * 256 + hi, peek8(LINE_BUF + hi))
        hi = hi + 1
    }
    poke8(HIST_BUF + hslot * 256 + len, 0)
    hist_count = hist_count + 1
}

# Load history entry `back` steps into the past. Returns its length.
fn hist_load(back) {
    if back <= 0 { return 0 }
    if back > hist_count { return -1 }
    if back > HIST_N { return -1 }
    hslot = (hist_count - back) % HIST_N
    hi = 0
    while hi < LINE_MAX {
        hc = peek8(HIST_BUF + hslot * 256 + hi)
        if hc == 0 { return hi }
        poke8(LINE_BUF + hi, hc)
        hi = hi + 1
    }
    return hi
}

# Redraw the line in place. The console has no way to move the cursor
# backwards, so the whole line is rewritten each time - at 80 columns that is
# far too fast to see, and it keeps the logic honest.
fn line_draw(len, cur, startcol) {
    put("\r")
    put("  zl> ")
    li = 0
    while li < len { emit(line_get(li))  li = li + 1 }
    put(" ")
    # park the cursor by rewriting up to it
    put("\r")
    put("  zl> ")
    li = 0
    while li < cur { emit(line_get(li))  li = li + 1 }
    return 0
}

# Read one line. Returns its length; the text is at LINE_BUF.
fn read_line() {
    llen = 0
    lcur = 0
    hist_pos = 0
    line_draw(0, 0, 0)
    while 1 == 1 {
        lk = key_full()
        if lk == 0 { continue }

        if lk == 13 {
            print("")
            if llen > 0 { hist_save(llen) }
            return llen
        }
        if lk == K_ENTER {
            print("")
            if llen > 0 { hist_save(llen) }
            return llen
        }

        if lk == 8 or lk == K_BKSP {
            if lcur > 0 {
                li = lcur - 1
                while li < llen - 1 {
                    line_set(li, line_get(li + 1))
                    li = li + 1
                }
                llen = llen - 1
                lcur = lcur - 1
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_DEL {
            if lcur < llen {
                li = lcur
                while li < llen - 1 {
                    line_set(li, line_get(li + 1))
                    li = li + 1
                }
                llen = llen - 1
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_LEFT  { if lcur > 0    { lcur = lcur - 1  line_draw(llen, lcur, 0) }  continue }
        if lk == K_RIGHT { if lcur < llen { lcur = lcur + 1  line_draw(llen, lcur, 0) }  continue }
        if lk == K_HOME  { lcur = 0     line_draw(llen, lcur, 0)  continue }
        if lk == K_END   { lcur = llen  line_draw(llen, lcur, 0)  continue }

        if lk == K_UP {
            hnew = hist_load(hist_pos + 1)
            if hnew >= 0 {
                hist_pos = hist_pos + 1
                llen = hnew
                lcur = hnew
                line_draw(llen, lcur, 0)
            }
            continue
        }
        if lk == K_DOWN {
            if hist_pos > 1 {
                hist_pos = hist_pos - 1
                hnew = hist_load(hist_pos)
                llen = hnew
                lcur = hnew
            } else {
                hist_pos = 0
                llen = 0
                lcur = 0
            }
            line_draw(llen, lcur, 0)
            continue
        }

        # Ctrl+U clears the line, Ctrl+A and Ctrl+E jump to the ends -
        # the readline bindings everyone's fingers already know.
        if lk == 21 { llen = 0  lcur = 0  line_draw(0, 0, 0)  continue }
        if lk == 1  { lcur = 0     line_draw(llen, lcur, 0)  continue }
        if lk == 5  { lcur = llen  line_draw(llen, lcur, 0)  continue }
        if lk == 27 { llen = 0  lcur = 0  line_draw(0, 0, 0)  continue }

        # an ordinary character: insert it at the cursor
        if lk >= 32 {
            if lk < 127 {
                if llen < LINE_MAX - 1 {
                    li = llen
                    while li > lcur {
                        line_set(li, line_get(li - 1))
                        li = li - 1
                    }
                    line_set(lcur, lk)
                    llen = llen + 1
                    lcur = lcur + 1
                    line_draw(llen, lcur, 0)
                }
            }
        }
    }
    return llen
}

fn spname(s) {
    if s == 1 { return "full (12 Mb/s)" }
    if s == 2 { return "low (1.5 Mb/s)" }
    if s == 3 { return "high (480 Mb/s)" }
    if s == 4 { return "super (5 Gb/s)" }
    if s == 5 { return "super+ (10 Gb/s)" }
    return "unknown"
}

fn cube_demo() {
    if px_w() == 0 {
        color(C_GREY)  print("  the 3D demo needs the framebuffer console")
        return 0
    }
    w = px_w()
    h = px_h()
    grad_rgb(0, 0, w, h, WALL_TOP, WALL_BOT)
    draw_header()
    vx = 150
    vy = 108
    vw = 500
    vh = 384
    draw_window(vx, vy, vw, vh, "3D   -   software rendered, no GPU", 1)
    ccx = vx + vw / 2
    ccy = vy + vh / 2
    cube_clip(vx + 3, vy + 30, vx + vw - 4, vy + vh - 30)       # keep the cube in the viewport
    ang = 0
    while key_get() == 0 {
        fill_rgb(vx + 3, vy + 30, vw - 6, vh - 33, PANEL)      # clear the viewport
        cube3d(ccx, ccy, 96, ang, ACCENT)                      # solid, flat-shaded, lit
        text_aa(vx + 18, vy + vh - 26, "press any key to exit", TXT_DIM)
        ang = ang + 5
        if ang >= 360 { ang = 0 }
        present()          # show this frame before sleeping, not after
        wait_ticks(3)
    }
    draw_screen()
    return 0
}

# ---- an animation: a bouncing logo over a starfield ------------------------
fn anim() {
    if px_w() == 0 {
        color(C_GREY)  print("  the animation needs the framebuffer console")
        return 0
    }
    w = px_w()
    h = px_h()
    lx = 40  ly = 90  vx = 6  vy = 4
    while key_get() == 0 {
        fill_rect(0, 0, w, h, C_BLACK)          # clear the frame
        # a stable starfield from a fixed seed, so stars don't flicker
        seed = 2463534242
        i = 0
        while i < 90 {
            seed = seed * 1103515245 + 12345
            sx = band(seed / 4096, 2047) % w
            seed = seed * 1103515245 + 12345
            sy = band(seed / 4096, 2047) % h
            c = C_GREY
            if band(seed, 7) == 0 { c = C_WHITE }
            fill_rect(sx, sy, 2, 2, c)
            i = i + 1
        }
        lx = lx + vx  ly = ly + vy               # bounce the logo
        if lx < 0      { lx = 0       vx = 0 - vx }
        if lx > w - 120 { lx = w - 120 vx = 0 - vx }
        if ly < 72     { ly = 72      vy = 0 - vy }
        if ly > h - 48 { ly = h - 48  vy = 0 - vy }
        logo(lx, ly, "zlOS", 3, C_CYAN)
        present()          # show this frame before sleeping, not after
        wait_ticks(2)
    }
    draw_screen()
    return 0
}

# ---- Snake: a real, playable game -----------------------------------------
# The snake body is an array of grid cells - and the kernel subset has no
# arrays, so it lives in raw memory: one byte per cell coordinate, walked
# with poke8/peek8. This is what the raw-memory primitives were FOR.
SNAKE_X = 0x02000000    # high memory - 0x30000 was inside the raw-loaded kernel
SNAKE_Y = 0x02000200

fn snake_game() {
    if px_w() == 0 {
        color(C_GREY)  print("  the game needs the framebuffer console")
        return 0
    }
    gw = px_w() / 16
    gh = (px_h() / 16) - 2

    slen = 5
    hx = gw / 2
    hy = gh / 2
    i = 0
    while i < slen {
        poke8(SNAKE_X + i, hx - i)
        poke8(SNAKE_Y + i, hy)
        i = i + 1
    }
    dx = 1  dy = 0
    seed = ticks() + 7
    seed = seed * 1103515245 + 12345
    fx = band(seed / 256, 1023) % gw
    seed = seed * 1103515245 + 12345
    fy = band(seed / 256, 1023) % gh
    score = 0
    alive = 1

    cls()
    fill_rect(0, 0, px_w(), px_h(), C_BLACK)
    at(0, 2, "SNAKE", C_GREEN)
    at(0, 10, "w a s d to steer, any other key to quit", C_GREY)
    at(0, 60, "score:", C_WHITE)

    nexttick = ticks() + 7
    while alive == 1 {
        # key_get(), not kbd_scan(): kbd_scan() reads the PS/2 scancode queue
        # and nothing else, so on a machine whose keyboard is USB the snake
        # could not be steered and the game could not be quit.
        k = key_get()
        if k == 119 { if dy == 0 { dx = 0  dy = 0 - 1 } }
        if k == 115 { if dy == 0 { dx = 0  dy = 1 } }
        if k == 97  { if dx == 0 { dx = 0 - 1  dy = 0 } }
        if k == 100 { if dx == 0 { dx = 1  dy = 0 } }
        if k > 0 {
            if k != 119 { if k != 115 { if k != 97 { if k != 100 { alive = 0 } } } }
        }

        if ticks() >= nexttick {
            nexttick = ticks() + 7
            nhx = peek8(SNAKE_X) + dx
            nhy = peek8(SNAKE_Y) + dy
            if nhx < 0   { alive = 0 }
            if nhx >= gw { alive = 0 }
            if nhy < 0   { alive = 0 }
            if nhy >= gh { alive = 0 }
            i = 0
            while i < slen {
                if peek8(SNAKE_X + i) == nhx {
                    if peek8(SNAKE_Y + i) == nhy { alive = 0 }
                }
                i = i + 1
            }
            if alive == 1 {
                grew = 0
                if nhx == fx {
                    if nhy == fy {
                        grew = 1
                        score = score + 1
                        slen = slen + 1
                        seed = seed * 1103515245 + 12345
                        fx = band(seed / 256, 1023) % gw
                        seed = seed * 1103515245 + 12345
                        fy = band(seed / 256, 1023) % gh
                    }
                }
                if grew == 0 {
                    tx = peek8(SNAKE_X + slen - 1)
                    ty = peek8(SNAKE_Y + slen - 1)
                    fill_rect(tx * 16, ty * 16 + 20, 16, 16, C_BLACK)
                }
                i = slen - 1
                while i > 0 {
                    poke8(SNAKE_X + i, peek8(SNAKE_X + i - 1))
                    poke8(SNAKE_Y + i, peek8(SNAKE_Y + i - 1))
                    i = i - 1
                }
                poke8(SNAKE_X, nhx)
                poke8(SNAKE_Y, nhy)
                fill_rect(nhx * 16, nhy * 16 + 20, 15, 15, C_GREEN)
                fill_rect(fx * 16, fy * 16 + 20, 15, 15, C_RED)
                at_num(0, 67, score, C_YELLOW)
            }
            present()      # one blit per tick, not per rectangle
        }
    }
    beep(200, 20)
    color(C_RED)   put("  game over - score ")  color(C_WHITE)  print(score)
    color(C_GREY)  print("  press any key")
    # Same reason as the steering loop above. This one was worse: with no PS/2
    # keyboard there was no key that could end it, and the shell never came
    # back - every command typed afterwards was swallowed by this loop.
    while key_get() == 0 { }
    draw_screen()
    return 0
}

# ---- Paint: draw with the mouse -------------------------------------------
fn paint() {
    if px_w() == 0 {
        color(C_GREY)  print("  paint needs the framebuffer console")
        return 0
    }
    w = px_w()
    h = px_h()
    cls()
    fill_rect(0, 0, w, h, C_BLACK)
    at(0, 2, "PAINT", C_WHITE)
    at(0, 9, "hold left button to draw   1-7 pick colour   space clears   other key exits", C_GREY)
    col = C_GREEN
    pt_run = 1
    while pt_run == 1 {
        k = key_get()
        if k > 0 {
            if k == 32 { fill_rect(0, 24, w, h - 24, C_BLACK) }
            if k >= 49 { if k <= 55 { col = k - 48 } }
            if k > 55 { pt_run = 0 }
            if k < 49 { if k != 32 { pt_run = 0 } }
        }
        mx = mouse_x()
        my = mouse_y()
        if mx > w - 5 { mx = w - 5 }
        if my > h - 5 { my = h - 5 }
        if my < 24 { my = 24 }
        if band(mouse_btn(), 1) != 0 { fill_rect(mx, my, 5, 5, col) }
        at_num(0, 62, mx, C_GREY)
        at_num(0, 70, my, C_GREY)
        present()          # drawing lands in the back buffer; this is the blit
    }
    draw_screen()
    return 0
}

# ---- a RAM filesystem ------------------------------------------------------
# Ten numbered files, held in memory. Each file's length lives in a small
# metadata table and its bytes in a fixed 8 KiB slot. The whole thing is
# written in zl using copy_mem/poke32/peek32 - no new C. It is a RAM disk,
# so it is wiped on reboot, but within a session the editor can save and
# reload files by number.
# These MUST live above the kernel image. Our own bootloader loads the kernel
# at 0x10000 and it now reaches past 0x89000, so the old 0x50000 landed inside
# the kernel's own code - fs_init() overwrote it and the machine died on an
# invalid opcode the moment that code was reached. GRUB loads at 1 MiB, which
# is why only the raw path ever showed it. 32 MiB is clear of everything.
FS_META = 0x02010000    # 10 lengths, 4 bytes each
FS_DATA = 0x02011000    # 10 slots of FS_SLOT bytes
FS_SLOT = 8192

fn fs_init()      { fill_mem(FS_META, 0, 64) }
fn fs_len(slot)   { return peek32(FS_META + slot * 4) }
fn fs_save(slot, len) {
    if len > FS_SLOT { len = FS_SLOT }
    poke32(FS_META + slot * 4, len)
    if len > 0 { copy_mem(FS_DATA + slot * FS_SLOT, EDIT_BUF, len) }
}
fn fs_load(slot) {
    len = fs_len(slot)
    fill_mem(EDIT_BUF, 0, EDIT_MAX)
    if len > 0 { copy_mem(EDIT_BUF, FS_DATA + slot * FS_SLOT, len) }
    return len
}

fn fs_list() {
    color(C_CYAN)  print("  RAM files:")
    i = 0
    while i < 10 {
        color(C_GREY)   put("    file ")  color(C_WHITE)  put(i)  color(C_GREY)  put(":  ")
        n = fs_len(i)
        if n > 0 { color(C_WHITE)  put(n)  color(C_GREY)  print(" bytes") }
        if n == 0 { color(C_DGREY)  print("empty") }
        i = i + 1
    }
    color(C_GREY)
    return 0
}

# ---- a text editor --------------------------------------------------------
# The text lives in a raw memory buffer, one byte per character. Typing
# appends, backspace removes, enter inserts a newline; the whole buffer is
# re-rendered each keystroke (buffers are small). This is a TempleOS-style
# "the OS edits text" feature, written entirely in zl.
EDIT_BUF = 0x40000
EDIT_MAX = 8000

fn redraw_editor(len) {
    fill_rect(0, 34, px_w(), px_h() - 50, C_BLACK)   # clear the text area
    goto_row(3)
    color(C_WHITE)
    i = 0
    while i < len {
        sc(peek8(EDIT_BUF + i))                        # screen-only, no serial spam
        i = i + 1
    }
    # a block cursor at the current position
    cursor(row(), col(), 1, C_GREEN)
    # sc() writes to the screen only and never emits a newline, so nothing here
    # would otherwise reach the card - the editor drew into the back buffer and
    # stayed invisible.
    present()
}

fn editor(slot) {
    if px_w() == 0 {
        color(C_GREY)  print("  the editor needs the framebuffer console")
        return 0
    }
    cls()
    fill_rect(0, 0, px_w(), 30, C_BLUE)
    at(0, 2, "zlEDIT", C_WHITE)
    at(0, 10, "file", C_CYAN)
    at_num(0, 15, slot, C_YELLOW)
    at(0, 20, "type to edit   backspace deletes   ESC saves file & exits", C_CYAN)
    len = fs_load(slot)                # load the file's existing content
    redraw_editor(len)
    ed_run = 1
    while ed_run == 1 {
        k = edit_key()
        if k > 0 {
            if k == 27 { ed_run = 0 }
            if k == 8 {
                if len > 0 { len = len - 1  poke8(EDIT_BUF + len, 0) }
                redraw_editor(len)
            }
            if k == 13 {
                if len < EDIT_MAX - 1 { poke8(EDIT_BUF + len, 10)  len = len + 1 }
                redraw_editor(len)
            }
            if k >= 32 {
                if len < EDIT_MAX - 1 { poke8(EDIT_BUF + len, k)  len = len + 1 }
                redraw_editor(len)
            }
        }
    }
    fs_save(slot, len)                 # write it back to the file on exit
    draw_screen()
    color(C_GREY)  put("  saved ")  color(C_WHITE)  put(len)
    color(C_GREY)  put(" bytes to file ")  color(C_WHITE)  print(slot)
    return 0
}

fn run_command(cmd, arg) {
    if cmd == 104 { help()  return 0 }
    if cmd == 102 { color(C_WHITE)  put("  ")  print(fib(arg))  color(C_GREY)  return 0 }
    if cmd == 115 { color(C_WHITE)  put("  ")  print(sum_squares(arg))  color(C_GREY)  return 0 }
    if cmd == 116 {                      # t - uptime from the timer IRQ
        color(C_GREY)  put("  uptime: ")
        color(C_WHITE) put(ticks() / 100)  color(C_GREY)  put(" s  (")
        color(C_WHITE) put(ticks())        color(C_GREY)  print(" ticks at 100 Hz)")
        return 0
    }
    if cmd == 98  {                       # b - colour bars, with a little chime
        beep(880, 8)  beep(1174, 8)  beep(1568, 12)
        return colorbars()
    }
    if cmd == 112 {                       # p - CPU brand string via CPUID
        color(C_GREY)  put("  CPU: ")
        color(C_WHITE)
        i = 0
        while i < 48 {
            b = cpu_char(i)
            if b > 0 { emit(b) }
            i = i + 1
        }
        print("")
        color(C_GREY)
        return 0
    }
    if cmd == 101 {                       # e - beep
        color(C_GREY)  print("  beep!")
        beep(1000, 15)
        return 0
    }
    if cmd == 80 {                        # P - light the panel with OUR driver
        color(C_CYAN)  print("  taking the panel with our own modeset")
        color(C_GREY)
        print("    you are reading this on the loader's framebuffer.")
        print("    after this, every pixel is scanned out by a mode this")
        print("    driver programmed, over a link it trained itself.")
        print("")
        ii = intel_find()
        if ii < 0 {
            color(C_RED)   print("    no Intel GPU here - nothing to take")
            color(C_GREY)  return 0
        }
        if intel_ok() == 0 {
            color(C_RED)   print("    not a Gen9 part - refusing")
            color(C_GREY)  return 0
        }
        fb = panel_up()
        if fb == 0 {
            color(C_RED)
            put("    bring-up FAILED at plan step ")  print(panel_step())
            color(C_GREY)
            print("    the loader's framebuffer is untouched. nothing is lost.")
            return 0
        }
        color(C_GREEN)
        put("    the panel is ours. framebuffer at 0x")  hex(fb, 8)  print("")
        color(C_GREY)
        print("    press a key to move the console onto it")
        key()
        panel_console()
        color(C_GREEN)
        print("  this text is being scanned out by our own driver.")
        color(C_GREY)
        return 0
    }
    if cmd == 107 {                       # k - the hardware, as the bus reports it
        color(C_CYAN)  print("  PCI bus scan")
        color(C_GREY)
        pci_scan()
        pn = 0
        while pn < pci_count() {
            put("    ")
            put(pci_vendor(pn))  put(":")  put(pci_device(pn))
            put("   class ")     print(pci_class(pn))
            pn = pn + 1
        }
        put("    devices found: ")  print(pci_count())
        print("")
        color(C_CYAN)  print("  Intel graphics (our own driver)")
        color(C_GREY)
        ii = intel_find()
        if ii < 0 {
            print("    no Intel GPU on this machine (expected in a VM)")
        } else {
            put("    device 0x")  print(intel_id())
            if intel_ok() == 1 {
                print("    generation:    Gen9/9.5 - supported")
                put("    MMIO  (BAR0):  0x")  hex(intel_mmio(), 8)  print("")
                put("    aperture:      0x")  hex(intel_aper(), 8)  print("")
                put("    stolen memory: ")    put(intel_ssize() / 1048576)  print(" MiB")
                put("    GGTT size:     ")    put(intel_ggtt() / 1048576)   print(" MiB")
                put("    pipe A active: ")    print(intel_pipe())
                put("    plane enabled: ")    print(intel_plane())
                put("    live mode:     ")    put(intel_w())  put(" x ")  print(intel_h())
                put("    stride:        ")    put(intel_stride())  print(" bytes")
                put("    plane format:  ")    put(gpu_fmt())
                put("   tiling mode ")        print(gpu_tile())
                # the real video signal, blanking included
                put("    timing:        ")    put(gpu_ha())  put(" of ")  put(gpu_ht())
                put(" px  x  ")               put(gpu_va())  put(" of ")  put(gpu_vt())
                print(" lines")
                print("    measuring refresh against the PIT...")
                gmhz = gpu_hz()
                put("    refresh:       ")    put(gmhz / 1000)
                put(".")                      put((gmhz % 1000) / 100)
                print(" Hz")
                put("    pixel clock:   ")    put(gpu_clk() / 1000)  print(" MHz")
                put("    panel power:   ")    print(panel_on())
                gblm = bl_max()
                if gblm > 0 {
                    put("    backlight:     ")  put(bl_get() * 100 / gblm)
                    put("% of ")                put(gblm)  print(" PWM counts")
                }
                # ask the panel what it is, over the GPU's own I2C bus
                gep = edid_read()
                if gep > 0 {
                    color(C_GREEN)
                    put("    EDID read on GMBUS pin pair ")  print(gep)
                    color(C_GREY)
                    put("    panel:         ")
                    emit(edid_vc(0))  emit(edid_vc(1))  emit(edid_vc(2))
                    put(" product 0x")  hex(edid_prod(), 4)  print("")
                    put("    native mode:   ")  put(edid_w())  put(" x ")  print(edid_h())
                    put("    physical size: ")  put(edid_mmw())  put(" x ")
                    put(edid_mmh())  print(" mm")
                } else {
                    print("    no EDID on any GMBUS pin pair")
                }
                put("    scanning out:  0x")  print(intel_surf())
            } else {
                print("    not a Gen9 part - detected but not driven")
            }
        }
        print("")
        color(C_CYAN)  print("  display adapter")
        color(C_GREY)
        gi = gpu_find()
        if gi < 0 {
            print("    no PCI display adapter found")
        } else {
            put("    framebuffer at 0x")  hex(gpu_fb(), 8)  print("")
            put("    video memory:  ")    put(gpu_vram() / 1048576)  print(" MiB")
            if gpu_present() == 1 {
                put("    modesetting:   YES, BGA rev ")  print(gpu_version())
                put("    current mode:  ")  put(gpu_w())  put(" x ")  print(gpu_h())
            } else {
                print("    modesetting:   not supported by this adapter")
            }
        }
        return 0
    }
    if cmd == 110 {                       # n - switch resolution, live
        color(C_CYAN)  print("  modesetting with our own driver")
        color(C_GREY)
        nw = 1280
        nh = 800
        if px_w() == 1280 { nw = 1920  nh = 1200 }
        put("    switching to ")  put(nw)  put(" x ")  print(nh)
        if set_res(nw, nh) == 1 {
            put("    now ")  put(gpu_w())  put(" x ")  put(gpu_h())
            put(", pitch ")  print(gpu_pitch())
            layout()
            draw_screen()
            color(C_GREEN)  print("  mode set by zlOS, no BIOS involved")
            color(C_GREY)
        } else {
            color(C_RED)  print("    the card refused that mode")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 117 {                       # u - the USB controller, our driver
        color(C_CYAN)  print("  USB host controller (xHCI)")
        color(C_GREY)
        ui2 = usb_find()
        if ui2 < 0 {
            print("    no xHCI controller found on the PCI bus")
        } else {
            put("    xHCI version  0x")  hex(usb_ver(), 4)   print("")
            put("    MMIO at       0x")  hex(usb_mmio(), 8)  print("")
            put("    device slots: ")    print(usb_slots())
            put("    root ports:   ")    print(usb_ports())
            put("    context size: ")    put(usb_ctxsz())  print(" bytes")
            if usb_ram() == 0 {
                color(C_RED)
                print("    the DMA arena at 224 MiB is not backed by RAM")
                color(C_GREY)
                return 0
            }
            # usb_up() is idempotent: it resets and builds our rings only if we
            # do not already own the controller. Re-resetting here would throw
            # away a working keyboard, which is exactly what we came for.
            ukb = usb_up()
            if usb_ours() == 1 {
                color(C_GREEN)
                print("    controller reset, rings up, RUNNING - it is ours")
                color(C_GREY)
                if usb_noop() == 1 {
                    color(C_GREEN)
                    print("    no-op command completed - DMA path proven")
                    color(C_GREY)
                } else {
                    color(C_RED)  print("    no-op did not complete")
                    color(C_GREY)
                }
            } else {
                color(C_RED)  print("    could not take the controller")
                color(C_GREY)
                return 0
            }
            put("    devices attached: ")  print(usb_count())
            up = 1
            while up <= usb_ports() {
                if usb_conn(up) == 1 {
                    put("      port ")  put(up)
                    put(" connected, speed ")  put(spname(usb_speed(up)))
                    # stage 4: reset the port, take a slot, address the device
                    # and read the descriptor that says what it actually is
                    uslot = usb_enum(up)
                    if uslot > 0 {
                        color(C_GREEN)
                        put("  -> slot ")  put(uslot)
                        put(" addr ")      print(usb_addr())
                        color(C_GREY)
                        put("        USB ")  hex(usb_uver(), 4)
                        put("  vendor ")     hex(usb_vid(), 4)
                        put(":")             hex(usb_pid(), 4)
                        put("  class ")      hex(usb_cls(), 2)
                        put("  ep0 mps ")    print(usb_mps())
                    } else {
                        color(C_RED)  print("  -> enumeration failed")
                        color(C_GREY)
                    }
                }
                up = up + 1
            }
            if ukb > 0 {
                color(C_GREEN)
                put("    HID boot keyboard on slot ")  put(ukb)
                put(", endpoint dci ")                 print(usb_kbd_ep())
                print("    keystrokes now come from OUR driver - try 'j'")
                color(C_GREY)
            } else {
                print("    no HID boot keyboard on this bus")
            }
        }
        return 0
    }
    if cmd == 106 { return usbkey_demo() }   # j - USB keyboard, live
    if cmd == 61 {                        # = - the input stack, live
        color(C_CYAN)  print("  input events")
        color(C_GREY)
        print("    every key press, release and character, with modifiers.")
        print("    try caps lock, ctrl, shift, arrows, and holding a key.")
        print("    ESC ends.")
        print("")
        iestop = ticks() + 3000
        while ticks() < iestop {
            iet = in_next()
            if iet != 0 {
                iec = in_code()
                iem = in_mods()
                put("    ")
                if iet == 1 { put("down ") }
                if iet == 2 { put("up   ") }
                if iet == 3 { put("char ") }
                put("code 0x")  hex(iec, 4)
                if iec >= 32 {
                    if iec < 127 { put(" '")  emit(iec)  put("'") }
                }
                put("   mods")
                if band(iem, 1) != 0 { put(" shift") }
                if band(iem, 2) != 0 { put(" ctrl") }
                if band(iem, 4) != 0 { put(" alt") }
                if band(iem, 8) != 0 { put(" CAPS") }
                if iem == 0 { put(" -") }
                print("")
                if iet == 1 {
                    if iec == 0x101 {
                        print("    ESC - done")
                        return 0
                    }
                }
            }
        }
        print("    timed out")
        return 0
    }
    if cmd == 63 {                        # ? - the I2C touchpad
        color(C_CYAN)  print("  I2C-HID touchpad")
        color(C_GREY)
        tpi = 0
        tpfound = 0
        while tpi < 2 {
            if i2c_find(tpi) >= 0 {
                put("    I2C controller ")  put(tpi)
                put(" at 0x")  hex(i2c_mmio(), 8)
                put("  COMP_TYPE 0x")  hex(i2c_ct(), 8)
                if i2c_dw() == 1 {
                    print("  (DesignWare)")
                    tpfound = 1
                } else {
                    print("  (not a DesignWare core)")
                }
            }
            tpi = tpi + 1
        }
        if tpfound == 0 {
            print("    no Intel LPSS I2C controller here.")
            print("    QEMU does not emulate one - this needs the real laptop.")
            return 0
        }
        print("    probing the bus for a HID device...")
        tpa = tp_probe()
        if tpa < 0 {
            color(C_RED)  print("    nothing on the bus answered as HID")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        put("    HID device at I2C address 0x")  hex(tpa, 2)  print("")
        color(C_GREY)
        put("    vendor ")  hex(tp_vid(), 4)
        put(":")            hex(tp_pid(), 4)
        put("  version ")   hex(tp_ver(), 4)  print("")
        put("    max input report ")  put(tp_maxin())
        put(" bytes, report descriptor ")  put(tp_rdlen())  print(" bytes")
        print("    touch the pad - reading reports for a few seconds")
        tpstop = ticks() + 500
        tpn = 0
        while ticks() < tpstop {
            tplen = tp_read()
            if tplen > 2 {
                tpn = tpn + 1
                if tpn < 6 {
                    put("      report ")  put(tplen)  put(" bytes: ")
                    tpj = 2
                    while tpj < 10 { hex(tp_b(tpj), 2)  put(" ")  tpj = tpj + 1 }
                    print("")
                }
            }
        }
        put("    reports received: ")  print(tpn)
        return 0
    }
    if cmd == 47 {                        # / - USB mass storage
        color(C_CYAN)  print("  USB mass storage (SCSI over Bulk-Only Transport)")
        color(C_GREY)
        if usb_up() == 0 { }              # make sure the controller is ours
        mss = msc_up()
        if mss == 0 {
            print("    no bulk-only mass storage device on the bus")
            print("    add -device usb-storage,drive=... to QEMU")
            return 0
        }
        color(C_GREEN)
        put("    device on slot ")  put(mss)
        print(" - bulk IN and OUT endpoints configured")
        color(C_GREY)
        if msc_inq() == 1 {
            put("    INQUIRY:  ")
            mi = 8
            while mi < 36 { emit(msc_b(mi))  mi = mi + 1 }
            print("")
        } else {
            color(C_RED)  print("    INQUIRY failed")  color(C_GREY)
        }
        if msc_cap() == 1 {
            put("    capacity: ")  put(msc_mb())  put(" MiB in ")
            put(msc_blocks())  put(" blocks of ")  put(msc_bsize())  print(" bytes")
        } else {
            color(C_RED)  print("    READ CAPACITY failed")  color(C_GREY)
            return 0
        }
        if msc_read(0) == 1 {
            put("    block 0 first bytes: ")
            mi = 0
            while mi < 8 { hex(msc_b(mi), 2)  put(" ")  mi = mi + 1 }
            print("")
            # a real partitioned stick ends its first sector with 55 AA
            if msc_b(510) == 85 {
                if msc_b(511) == 170 {
                    color(C_GREEN)
                    print("    boot signature 55 AA - this is a real MBR")
                    color(C_GREY)
                }
            }
            color(C_GREEN)
            print("    read a sector off a USB stick with our own driver")
            color(C_GREY)
        } else {
            color(C_RED)  print("    READ(10) of block 0 failed")  color(C_GREY)
        }
        return 0
    }
    if cmd == 42 {                        # * - wake the other CPU cores
        color(C_CYAN)  print("  SMP - the other cores")
        color(C_GREY)
        put("    ACPI lists ")  put(smp_total())  print(" usable core(s):")
        smi = 0
        while smi < smp_total() {
            put("      core ")  put(smi)
            put(" has APIC id ")  print(smp_id(smi))
            smi = smi + 1
        }
        put("    trampoline is ")  put(smp_tsz())  print(" bytes, copied to 0x9000")
        print("    sending INIT then STARTUP to each...")
        smn = smp_go()
        put("    cores online now: ")  put(smn)
        put(" of ")  print(smp_total())
        if smn > 1 {
            color(C_GREEN)
            put("    they answered - APIC id bitmap 0x")  hex(smp_mask(), 8)
            print("")
            print("    the machine is running on more than one core")
            color(C_GREY)
            print("    (they park immediately: nothing is lock-protected yet)")
        } else {
            color(C_RED)  print("    no application processor answered")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 43 {                        # + - three tasks at once
        color(C_CYAN)  print("  multitasking")
        color(C_GREY)
        print("    three tasks, each counting at its own rate, plus this shell.")
        print("    every number below is a different stack.")
        print("")
        put("    tasks now runnable: ")  print(sched_go())
        mti = 0
        while mti < 12 {
            yield()
            put("    t=")   put(ticks())
            put("  A=")     put(counter(0))
            put("  B=")     put(counter(1))
            put("  C=")     put(counter(2))
            put("  switches=")  print(sched_sw())
            mts = ticks() + 25
            while ticks() < mts { yield() }
            mti = mti + 1
        }
        print("")
        color(C_GREEN)
        print("    all three advanced while the shell kept running.")
        color(C_GREY)
        return 0
    }
    if cmd == 111 {                       # o - NVMe storage, our driver
        color(C_CYAN)  print("  NVMe storage")
        color(C_GREY)
        if nv_find() < 0 {
            print("    no NVMe controller on the PCI bus")
            print("    add -device nvme,serial=zl,drive=... to QEMU")
            return 0
        }
        put("    MMIO at   0x")  hex(nv_mmio(), 8)  print("")
        put("    version   ")    hex(nv_ver(), 8)   print("")
        if nv_setup() == 0 {
            color(C_RED)  print("    controller did not come ready")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        print("    enabled, admin + I/O queues created - it is ours")
        color(C_GREY)
        put("    model:    ")
        nmi = 0
        while nmi < 40 { emit(nv_mb(nmi))  nmi = nmi + 1 }
        print("")
        put("    capacity: ")  put(nv_cap())  put(" MiB in ")
        put(nv_blocks())  put(" blocks of ")  put(nv_bsize())  print(" bytes")

        # The real proof: write a pattern to a block, read it back, compare.
        # This is a round trip through a DMA queue to actual storage.
        nvi = 0
        while nvi < 512 { nv_set(nvi, (nvi * 7 + 11) % 256)  nvi = nvi + 1 }
        if nv_write(1000, 0) == 0 {
            color(C_RED)  print("    write to LBA 1000 failed")
            color(C_GREY)  return 0
        }
        # scrub the buffer so a read that does nothing cannot look like success
        nvi = 0
        while nvi < 512 { nv_set(nvi, 0)  nvi = nvi + 1 }
        if nv_read(1000, 0) == 0 {
            color(C_RED)  print("    read back from LBA 1000 failed")
            color(C_GREY)  return 0
        }
        nvbad = 0
        nvi = 0
        while nvi < 512 {
            if nv_get(nvi) != (nvi * 7 + 11) % 256 { nvbad = nvbad + 1 }
            nvi = nvi + 1
        }
        if nvbad == 0 {
            color(C_GREEN)
            print("    wrote 512 bytes to LBA 1000, read them back, all match")
            print("    zlOS can store things that outlive it")
            color(C_GREY)
        } else {
            color(C_RED)
            put("    read back WRONG in ")  put(nvbad)  print(" of 512 bytes")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 122 {                       # z - the processor, read from itself
        color(C_CYAN)  print("  the processor, via CPUID and the MSRs")
        color(C_GREY)
        put("    vendor:   ")
        cvi = 0
        while cvi < 12 { emit(cpu_vb(cvi))  cvi = cvi + 1 }
        print("")
        put("    family ")  put(cpu_fam())
        put("  model ")     put(cpu_mod())
        put("  stepping ")  print(cpu_step())
        put("    topology: ")  put(cpu_cores())  put(" core(s), ")
        put(cpu_thr())  put(" thread(s), ")
        put(cpu_tpc())  print(" per core")
        put("    this core is APIC id ")  print(cpu_apicid())
        put("    clock:    ")  put(cpu_mhz())  put(" MHz (TSC ")
        put(cpu_khz())  put(" kHz")
        if cpu_inv() == 1 { put(", invariant") }
        print(")")
        cci = 0
        while cci < 6 {
            if cpu_ctype(cci) != 0 {
                put("    cache L")  put(cpu_clevel(cci))
                if cpu_ctype(cci) == 1 { put(" data       ") }
                if cpu_ctype(cci) == 2 { put(" instruction") }
                if cpu_ctype(cci) == 3 { put(" unified    ") }
                put("  ")  put(cpu_ckb(cci))  print(" KiB")
            }
            cci = cci + 1
        }
        put("    features: ")
        if cpu_sse2() == 1   { put("sse2 ") }
        if cpu_sse42() == 1  { put("sse4.2 ") }
        if cpu_avx() == 1    { put("avx ") }
        if cpu_avx2() == 1   { put("avx2 ") }
        if cpu_aes() == 1    { put("aes ") }
        if cpu_rdrand() == 1 { put("rdrand ") }
        print("")
        ctc = cpu_temp()
        if ctc > 0 { put("    temperature: ")  put(ctc)  print(" C") }
        if cpu_hv() == 1 {
            put("    running under a hypervisor: ")
            chi = 0
            while chi < 12 { emit(cpu_hvb(chi))  chi = chi + 1 }
            print("")
        } else {
            print("    running on bare metal - no hypervisor bit")
        }
        return 0
    }
    if cmd == 121 {                       # y - virtio-gpu, a real GPU driver
        color(C_CYAN)  print("  virtio-gpu")
        color(C_GREY)
        if vg_find() < 0 {
            print("    no virtio-gpu on the PCI bus")
            print("    add -device virtio-gpu-pci to QEMU to see this work")
            return 0
        }
        if vg_init() == 0 {
            color(C_RED)  print("    the device refused our feature negotiation")
            color(C_GREY)  return 0
        }
        color(C_GREEN)
        print("    virtqueue up, DRIVER_OK - the device is ours")
        color(C_GREY)
        put("    scanouts: ")  print(vg_scan())
        if vg_info() == 0 {
            color(C_RED)  print("    GET_DISPLAY_INFO failed")
            color(C_GREY)  return 0
        }
        put("    display:  ")  put(vg_w())  put(" x ")  print(vg_h())
        put("    create_2d:      ")  put(vg_c2d(1, vg_w(), vg_h()))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        put("    attach_backing: ")  put(vg_attach(1, vg_w() * vg_h() * 4))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        put("    set_scanout:    ")  put(vg_scanout(1, vg_w(), vg_h()))
        put("  resp 0x")  hex(vg_resp(), 4)  print("")
        vgfb = vg_fb()
        put("    framebuffer bound at 0x")  hex(vgfb, 8)  print("")
        # Draw straight into GPU memory and flush it. Every pixel here crossed
        # a virtqueue as a real GPU command.
        if vg_test() == 1 {
            color(C_GREEN)
            print("    TRANSFER_TO_HOST_2D + RESOURCE_FLUSH acknowledged")
            print("    pixels drawn through a real GPU command queue")
            color(C_GREY)
        } else {
            color(C_RED)  print("    flush failed")
            color(C_GREY)
        }
        return 0
    }
    if cmd == 118 { return cube_demo() }     # v - spinning 3D cube (software)
    if cmd == 119 { return wm_session() }    # w - the real compositor (wm.c)
    if cmd == 120 { return mousedemo() }  # x - mouse demo
    if cmd == 97  { return anim() }       # a - animation
    if cmd == 103 { return snake_game() } # g - snake game
    if cmd == 100 { return paint() }      # d - paint (draw)
    if cmd == 105 { return editor(arg) }  # i - text editor (arg = file slot 0-9)
    if cmd == 108 { return fs_list() }    # l - list RAM files
    if cmd == 114 {                       # r - reboot
        color(C_YELLOW)  print("  rebooting...")
        beep(1568, 6)  beep(784, 10)
        reboot()
        return 0
    }
    if cmd == 109 {
        # Whichever console is up owns different video memory: the text buffer
        # at 0xB8000, or the linear framebuffer. Poking VGA unconditionally
        # read back 255 on the desktop, because in a framebuffer mode nothing
        # decodes 0xB8000 and the write went nowhere.
        mv = vram()
        poke8(mv + 158, 42)
        poke8(mv + 159, 0x4E)
        color(C_GREY)  put("  wrote a byte to video memory, read back: ")
        color(C_WHITE) print(peek8(mv + 158))
        color(C_GREY)  return 0
    }
    if cmd == 99  { draw_screen()  return 0 }
    if cmd == 113 { return 1 }
    color(C_RED)  print("  unknown command - press h for help")
    color(C_GREY) return 0
}

# a live System Monitor window: the real CPUID brand, a memory bar, tick count
# and a sparkline - drawn with the same window chrome as everything else
fn draw_sysmon(sx, sy, sfoc) {
    u = ui()
    draw_window(sx, sy, MON_W * u, MON_H * u, "System Monitor", sfoc)
    sysmon_body(sx, sy)
    return 0
}

# The CONTENTS, with no frame. Split out so the compositor can draw the chrome
# itself and hand this only its client area - the app contract in ui.h requires
# app_draw to be position-pure, and this already was: every coordinate here is
# derived from sx,sy. Nothing is baked in.
fn sysmon_body(sx, sy) {
    u = ui()
    text_aa(sx + 14 * u, sy + 40 * u, "CPU", TXT_DIM)
    smi = 0
    smx = sx + 14 * u
    smy = sy + 58 * u
    while smi < 48 {
        smb = cpu_char(smi)
        if smb > 32 { char_aa(smx, smy, smb, TXT_HI) }
        if smb > 0 {
            smx = smx + cell_w()
            if smx > sx + 268 * u { smx = sx + 14 * u  smy = smy + 18 * u }
        }
        smi = smi + 1
    }
    text_aa(sx + 14 * u, sy + 98 * u, "MEM", TXT_DIM)
    fill_rgb(sx + 56 * u, sy + 100 * u, 214 * u, 12 * u, rgb(12, 18, 32))
    fill_rgb(sx + 56 * u, sy + 100 * u, 58 * u, 12 * u, ACCENT)
    text_aa(sx + 14 * u, sy + 122 * u, "TICKS", TXT_DIM)
    num_aa(sx + 68 * u, sy + 122 * u, ticks(), TXT_HI)
    # a little sparkline across the bottom, drawn as connected segments
    line(sx + 14,  sy + 182, sx + 46,  sy + 170, C_CYAN)
    line(sx + 46,  sy + 170, sx + 78,  sy + 176, C_CYAN)
    line(sx + 78 * u, sy + 176 * u, sx + 110 * u, sy + 161 * u, C_CYAN)
    line(sx + 110 * u, sy + 161 * u, sx + 142 * u, sy + 173 * u, C_CYAN)
    line(sx + 142 * u, sy + 173 * u, sx + 174 * u, sy + 158 * u, C_CYAN)
    line(sx + 174 * u, sy + 158 * u, sx + 206 * u, sy + 169 * u, C_CYAN)
    line(sx + 206 * u, sy + 169 * u, sx + 238 * u, sy + 155 * u, C_CYAN)
    line(sx + 238 * u, sy + 155 * u, sx + 270 * u, sy + 164 * u, C_CYAN)
    return 0
}

# a small About window - the identity card, static content
fn draw_about(ax, ay, afoc) {
    u = ui()
    draw_window(ax, ay, MON_W * u, AB_H * u, "About", afoc)
    about_body(ax, ay)
    return 0
}

fn about_body(ax, ay) {
    u = ui()
    text_aa(ax + 14 * u, ay + 32 * u, "zlOS 0.3", TXT_HI)
    text_aa(ax + 14 * u, ay + 54 * u, "a desktop written in zl", TXT_DIM)
    text_aa(ax + 14 * u, ay + 76 * u, "no OS   no libc   no GNU", ACCENT)
    text_aa(ax + 14 * u, ay + 98 * u, "press h for the app list", TXT_DIM)
    return 0
}

# ---- THE APP CONTRACT ------------------------------------------------------
# Three functions, no loop, ever. wm.c calls these through wmglue.c, which
# reaches them as zl_fn_app_* because zl compiles TO C. See ui.h and
# docs/desktop-wiring.md.
#
# app_draw is handed the CLIENT area. The bodies below were written against the
# WINDOW origin, so the title bar height is subtracted back off - which is
# exactly the kind of thing that has to be done once, here, rather than by
# editing sixty coordinates.

APP_SHELL   = 0
APP_MONITOR = 1
APP_ABOUT   = 2

fn app_draw(id, ax, ay, aw, ah, afocus) {
    wy = ay - TITLE_H * ui()
    if id == APP_MONITOR { return sysmon_body(ax, wy) }
    if id == APP_ABOUT   { return about_body(ax, wy) }
    if id == APP_SHELL {
        # The terminal redraws itself from its OWN scrollback, which is what
        # makes it survive a window being dragged across it. Before term.c the
        # shell's output existed only as pixels and could not be repainted.
        u = ui()
        cb = 0
        if afocus == 1 { if band(ticks() / 50, 1) == 0 { cb = 1 } }
        term_draw(ax + 8 * u, ay + 6 * u, aw - 16 * u, ah - 12 * u, TXT_HI, TXT_DIM, ACCENT, cb)
        return 0
    }
    return 0
}

# Return 1 if handled. 'q' or Esc ends the session - NEVER "press any key",
# which is the phrase this whole rewrite exists to delete.
fn app_event(id, win, ety, ecode, ex, ey) {
    if id == APP_SHELL {
        # ONE CHARACTER PER CALL. No loop - that is the whole inversion.
        # read_line used to block, which is exactly why the shell had to be the
        # top of the system and why every demo needed "press any key to exit".
        if ety == 3 {
            if term_key(ecode) == 1 {
                tc = term_cmd()
                if tc > 0 {
                    if tc == 113 { wm_stop()  return 1 }
                    run_command(tc, term_arg())
                }
            }
            wm_damage_win_all()
        }
        return 1
    }
    return 1
}

# Runs every frame, must be cheap, MUST NOT DRAW. Returning 1 means "my state
# changed, repaint me" - which is how the monitor's clock advances without
# owning the frame, and is the whole reason it needs no while-loop.
last_tick_sec = 0 - 1
# The shell window repaints after anything is typed or printed into it.
shell_win = 0 - 1
fn wm_damage_win_all() {
    if shell_win >= 0 { wm_dmg(shell_win) }
    return 0
}

fn app_tick(id, win) {
    if id == APP_MONITOR {
        tsec = ticks() / 100
        if tsec != last_tick_sec { last_tick_sec = tsec  return 1 }
    }
    return 0
}

# The wallpaper pass: furniture, drawn before any window, never in the z-order.
# It may ignore the damage rectangle it is given - the scissor is already set to
# it, so nothing outside can reach the screen. Using it would be the
# optimisation; correctness does not depend on it.
fn desk_draw(dx, dy, dw, dh) {
    grad_rgb(0, 0, px_w(), px_h(), WALL_TOP, WALL_BOT)
    draw_header()
    draw_status("compositor")
    return 0
}

# ---- a real compositor session ---------------------------------------------
# This replaces windows_demo, which desktop-TODO calls superseded. It is NOT
# the full inversion - the shell is still the top of the system, and making it
# app 0 needs read_line to become a state machine (2g). What this does is put
# wm.c, ui.c and the whole damage/clip/z-order stack on the real screen, in the
# kernel, so everything below the shell is proven before the shell moves.
fn wm_session() {
    if px_w() == 0 {
        color(C_GREY)  print("  the compositor needs the framebuffer console")
        return 0
    }
    u = ui()
    ui_theme(u)
    wm_init()
    if wm_bind() == 0 {
        color(C_RED)  print("  wm: kernel.zl defines no app_draw - nothing to composite")
        color(C_GREY)
        return 0
    }
    # THE SHELL IS WINDOW 0, and it is opened FIRST so the boot log that
    # follows lands inside it - the same ordering draw_desk relied on, now
    # expressed through wm_open.
    sw = px_w()
    sh = dock_y()
    shell_win = wm_open(APP_SHELL, "zl shell", 40 * u, 52 * u, sw - 340 * u, sh - 90 * u)
    wm_open(APP_MONITOR, "System Monitor", sw - 290 * u, 52 * u, MON_W * u, MON_H * u)
    wm_open(APP_ABOUT, "About", sw - 290 * u, 52 * u + (MON_H + 16) * u, MON_W * u, AB_H * u)
    while wm_run() == 1 { wm_frame() }
    return 0
}

# ---- the full desktop: wallpaper + header + a terminal window + the dock ----
# The shell no longer prints raw onto the screen - it lives inside a real
# window frame (shadow, rounded border, title bar) sitting on the wallpaper,
# with the dock along the bottom. This is what turns "a console" into "a
# desktop". The console text region is set to the window's interior so every
# line the shell prints lands inside the frame.
# the STATIC desktop: wallpaper, header, the fixed terminal window, the dock.
# Everything here stays put, so it becomes the "background" a dragged window is
# lifted off of and dropped back onto.
# Work out where everything sits for the screen we actually got. Our bootloader
# takes the widest mode the card offers, so that is 1280x1024 on one machine and
# 800x600 on another - nothing may be hard-coded to one size. The right-hand
# column is anchored to the right edge and the terminal fills what is left, which
# reproduces the old 800x600 layout exactly and grows from there.
fn layout() {
    mon_x = px_w() - (MON_W + 16) * ui()
    mon_y = DESK_TOP * ui() + 8 * ui()
    ab_x  = mon_x
    ab_y  = mon_y + (MON_H + 16) * ui()
    term_x = 16 * ui()
    term_y = DESK_TOP * ui() + 8 * ui()
    term_w = mon_x - 32 * ui()
    term_h = dock_y() - term_y - 16 * ui()
    lcw = cell_w()                             # the console text box, in cells -
    lch = cell_h()                             # which are 8x16 or 16x32 now
    # round the top-left UP to the next whole cell, the bottom-right DOWN, so
    # the text can never sit on the title bar or spill past the frame
    term_c0 = (term_x + 10 + lcw - 1) / lcw
    term_c1 = (term_x + term_w - 12) / lcw
    term_r0 = (term_y + 34 + lch - 1) / lch
    term_r1 = (term_y + term_h - 16) / lch
    return 0
}

fn draw_desk() {
    if px_w() > 0 {
        w = px_w()
        grad_rgb(0, 0, w, px_h(), WALL_TOP, WALL_BOT)          # the wallpaper
        draw_header()
        draw_window(term_x, term_y, term_w, term_h, "zl shell   ~", 1)
        text_box(term_c0, term_c1)
        region(term_r0, term_r1)
        draw_status("ready")
        goto_row(term_r0)
        present()
    } else {
        cls()
        draw_header()
        region(5, status_row() - 1)
        draw_status("ready")
        goto_row(5)
    }
}

# snapshot the static desktop as the drag background, then draw the DRAGGABLE
# windows on top of it. Called once the terminal has its content, and again
# after any redraw, so the background always matches what's really behind them.
fn compose_windows() {
    if px_w() > 0 {
        bg_snap()                        # capture wallpaper+header+terminal+dock
        raise_windows()                  # ... then the open windows, focused last
        present()
    }
}

# Draw the open windows in z-order: everything else first, the focused one LAST
# so it lands on top. That single ordering is the whole "bring to front".
fn raise_windows() {
    rw_mf = 0                                  # is the monitor the focused one?
    if focus_win == 1 { rw_mf = 1 }
    if focus_win == 2 {
        if mon_open == 1 { draw_sysmon(mon_x, mon_y, 0) }
        if ab_open  == 1 { draw_about(ab_x, ab_y, 1) }
    }
    if focus_win != 2 {
        if ab_open  == 1 { draw_about(ab_x, ab_y, 0) }
        if mon_open == 1 { draw_sysmon(mon_x, mon_y, rw_mf) }
    }
    present()
    return 0
}

# a full redraw: static desktop + the draggable windows composited over it
fn draw_screen() {
    draw_desk()
    compose_windows()
}

# ---- the start menu --------------------------------------------------------
# Click the zlOS button and a menu pops up above the dock. It saves the patch
# of screen underneath (grab) so closing it just stamps that back - no full
# redraw, so whatever was there (a window, the terminal) returns untouched.
fn open_menu() {
    mnx = 10
    mnh = 10 * 26 + 36
    mny = dock_y() - mnh - 6
    grab(mnx - 2, mny - 2, 182, mnh + 16)               # save what's under the menu
    shadow(mnx, mny, 172, mnh, 8, 6)
    rrect(mnx, mny, 172, mnh, 6, rgb(20, 26, 42))
    rrect(mnx + 1, mny + 1, 170, mnh - 2, 5, PANEL)
    grad_rgb(mnx + 2, mny + 2, 168, 26, HDR_TOP, HDR_BOT)
    fill_rgb(mnx + 2, mny + 28, 168, 2, ACCENT)
    text_aa(mnx + 14, mny + 8, "zlOS menu", C_WHITE)
    mrow = mny + 36
    text_aa(mnx + 18, mrow, "Help", TXT_HI)       mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Snake", TXT_HI)      mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Paint", TXT_HI)      mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Editor", TXT_HI)     mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Demo", TXT_HI)       mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Windows", TXT_HI)    mrow = mrow + 26
    text_aa(mnx + 18, mrow, "3D Cube", ACCENT)    mrow = mrow + 26
    text_aa(mnx + 18, mrow, "System Monitor", TXT_HI)   mrow = mrow + 26
    text_aa(mnx + 18, mrow, "About", TXT_HI)      mrow = mrow + 26
    text_aa(mnx + 18, mrow, "Reboot", TXT_DIM)
    menu_open = 1
    return 0
}
fn close_menu() {
    stamp(mnx - 2, mny - 2)                              # restore the saved patch
    menu_open = 0
    return 0
}
# map a menu row (0..7) to the command it launches
fn menu_cmd(idx) {
    if idx == 0 { return 104 }   # Help
    if idx == 1 { return 103 }   # Snake
    if idx == 2 { return 100 }   # Paint
    if idx == 3 { return 105 }   # Editor
    if idx == 4 { return 97 }    # Demo
    if idx == 5 { return 119 }   # Windows
    if idx == 6 { return 118 }   # 3D Cube
    if idx == 9 { return 114 }   # Reboot
    return 0                     # 7 and 8 reopen windows - the caller handles those
}

# ---- boot ------------------------------------------------------------------
kbd_init()
fs_init()
mon_x = 0                                # window positions - layout() fills these in
mon_y = 0                                # from the real screen size, and dragging
ab_x = 0                                 # updates them from there
ab_y = 0
term_x = 0                               # the terminal window's frame and text box
term_y = 0
term_w = 0
term_h = 0
term_c0 = 0
term_c1 = 0
term_r0 = 5
term_r1 = 20
mon_open = 1                             # is each window open (1) or closed (0)?
ab_open = 1
focus_win = 1                            # 0 = terminal, 1 = monitor, 2 = about
# Do not accept whatever mode the bootloader happened to hand us. We have our
# own modesetting driver, so ASK THE HARDWARE for a proper resolution - the
# same thing a real OS does at startup. Try progressively smaller modes until
# the card takes one; if none work we simply keep what we were given.
if px_w() > 0 {
    if px_w() < 1900 {
        if set_res(1920, 1200) == 0 {
            if set_res(1920, 1080) == 0 {
                if set_res(1600, 900) == 0 {
                    set_res(1280, 800)
                }
            }
        }
    }
}
if px_w() > 0 { layout() }
draw_desk()                              # static desktop; the boot log fills the terminal

color(C_WHITE)  print("  zlOS starting")
color(C_GREY)   print("")

if loader() == 2 {
    ok_line("UEFI application - no GRUB, no bootloader, 64-bit from the start")
}
if loader() == 1 {
    if bits() == 64 {
        ok_line("multiboot handoff, then OUR jump into 64-bit long mode")
    }
    if bits() == 32 {
        ok_line("multiboot handoff, 32-bit protected mode")
    }
}
if loader() == 0 {
    if bits() == 64 {
        ok_line("our bootloader (raw_boot), no GRUB - then 64-bit long mode")
    }
    if bits() == 32 {
        ok_line("our bootloader (raw_boot), no GRUB - 32-bit protected mode")
    }
}
ok_line("stack established, 256 KiB")
ok_line("COM1 initialised, 115200 8N1")
if con_kind() == 1 {
    color(C_GREY)  put("  [")
    color(C_GREEN) put("  OK  ")
    color(C_GREY)  put("] framebuffer console, ")
    put(con_cols())  put("x")  print(con_rows())
} else {
    ok_line("VGA text console, 80x25")
}
setup_gdt()
if bits() == 64 {
    ok_line("GDT loaded - 64-bit flat segments, 4-level paging, SSE on")
} else {
    ok_line("GDT loaded - flat 4 GiB code and data segments")
}
setup_idt()
ok_line("IDT installed, PIC remapped, interrupts ON")
# Move off the 8259 if this machine has an APIC. On a UEFI laptop the legacy
# PIC may not be wired to anything at all - the keyboard raises IRQ1 and the
# interrupt is simply never delivered. The I/O APIC is how a modern machine
# routes it, and ACPI is the only thing that knows where that chip lives.
if apic_up() == 1 {
    put("  [  OK  ] APIC: IRQs via I/O APIC at 0x")  hex(apic_ib(), 8)
    put(", ")  put(apic_cpus())  print(" CPU(s)")
} else {
    info_line("no APIC - staying on the legacy 8259 PIC")
}
ok_line("PIT timer running at 100 Hz on IRQ0")
ok_line("keyboard on IRQ1 - no more polling the port")
# USB comes up HERE, not earlier: the driver's timeouts are measured with the
# PIT, and before setup_idt() that timer is not ticking - every wait would
# silently fall back to a spin count instead of a real millisecond. On a UEFI
# machine the firmware's PS/2 emulation dies with ExitBootServices, so this is
# the only keyboard there will be.
usb_boot()
ok_line("zl runtime, kernel subset")
info_line("no heap, no filesystem, no scheduler")

print("")
color(C_GREEN)  print("  ready.")
color(C_GREY)   print("  press h for help, q to halt")
print("")

# a two-note boot chime - the timer is up, so we can time it
beep(784, 8)  beep(1046, 12)

# now that the terminal holds the boot log, snapshot it as the drag background
# and drop the draggable windows on top
compose_windows()

# ---- the shell -------------------------------------------------------------
running = 1
pending = 0

last_sec  = 0 - 1
last_blink = 0 - 1
last_mx = 0 - 1                           # mouse pointer position, tracked so the
last_my = 0 - 1                           # cursor sprite only redraws when it moves
last_lb = 0                               # last left-button state (drag edge detect)
dragging = 0                             # 1 while a window is being dragged
drag_win = 0                             # which window: 1 = monitor, 2 = about
dox = 0                                  # the dragged window's current drawn origin
doy = 0
dgw = 0                                  # the dragged window's width/height
dgh = 0
gox = 0                                  # grab offset: mouse minus window origin
goy = 0
menu_open = 0                            # is the start menu showing?
mnx = 0                                  # start menu geometry (set in open_menu)
mny = 0
mnh = 0

while running == 1 {
    color(C_GREEN)  put("  zl> ")
    color(C_WHITE)
    crow = row()
    ccol = col()                         # actual column after the prompt (text box aware)

    got = 0
    while got == 0 {
        tk = ticks()
        cur_dirty = 0                     # does the mouse pointer need repainting?

        # clock + text-cursor blink, paused while dragging or the menu is open
        if dragging == 0 { if menu_open == 0 {
            sec = tk / 100
            if sec != last_sec {
                mhide()
                draw_clock(sec)
                last_sec = sec
                cur_dirty = 1
            }
            phase = tk % 100
            bon = 0
            if phase < 50 { bon = 1 }
            if bon != last_blink {
                mhide()
                cursor(crow, ccol, bon, C_CURSOR)
                last_blink = bon
                cur_dirty = 1
            }
        }}

        # ---- mouse: the live pointer, and window dragging ------------------
        if px_w() > 0 {
            mx = mouse_x()
            my = mouse_y()
            if mx > px_w() - 12 { mx = px_w() - 12 }
            if my > px_h() - 18 { my = px_h() - 18 }
            if my < 28 { my = 28 }
            lb = band(mouse_btn(), 1)

            if dragging == 1 {
                # move the grabbed window as a bitmap: restore old spot, stamp new
                nx = mx - gox
                ny = my - goy
                if nx < 0 { nx = 0 }
                if ny < 28 { ny = 28 }
                if nx > px_w() - dgw { nx = px_w() - dgw }
                if ny > px_h() - 52 - dgh { ny = px_h() - 52 - dgh }
                moved = 0
                if nx != dox { moved = 1 }
                if ny != doy { moved = 1 }
                if moved == 1 {
                    mhide()
                    bg_rest(dox, doy, dgw + 16, dgh + 16)   # erase old (incl. shadow)
                    stamp(nx, ny)                            # window bitmap at new spot
                    dox = nx
                    doy = ny
                    mpoint(mx, my)
                }
                if lb == 0 {                                 # released - drop it
                    if drag_win == 1 { mon_x = dox  mon_y = doy }
                    if drag_win == 2 { ab_x = dox  ab_y = doy }
                    mhide()
                    focus_win = drag_win                     # dragging focuses it
                    raise_windows()                          # redraw in z-order
                    dragging = 0
                    drag_win = 0
                    mpoint(mx, my)
                }
            } else {
                # not dragging: pointer follows the mouse; a click may grab a window
                if mx != last_mx { cur_dirty = 1 }
                if my != last_my { cur_dirty = 1 }
                if cur_dirty == 1 { mpoint(mx, my) }
                if lb == 1 {
                    if last_lb == 0 {
                        if menu_open == 1 {
                            # a click while the menu is open: pick a row or dismiss it
                            picked = 0 - 1
                            if mx >= mnx { if mx < mnx + 172 { if my >= mny + 30 {
                                idx = (my - mny - 30) / 26
                                if idx >= 0 { if idx < 10 { picked = idx } }
                            }}}
                            mhide()  close_menu()  mpoint(mx, my)
                            # rows 7 and 8 bring a closed window back
                            if picked == 7 {
                                mon_open = 1  focus_win = 1
                                mhide()  raise_windows()  mpoint(mx, my)
                            }
                            if picked == 8 {
                                ab_open = 1  focus_win = 2
                                mhide()  raise_windows()  mpoint(mx, my)
                            }
                            if picked >= 0 {
                                mcmd = menu_cmd(picked)
                                if mcmd > 0 {
                                    mhide()  print("")  draw_status("working")
                                    r = run_command(mcmd, 0)
                                    got = 1  last_sec = 0 - 1  last_mx = 0 - 1
                                    draw_status("ready")
                                    if r == 1 { running = 0 }
                                }
                            }
                        } else {
                            # menu closed. Work out which window was hit, if any:
                            # 0 = none, 1 = monitor, 2 = about. Topmost (focused)
                            # window wins, so a click on an overlap picks the one
                            # you can actually see.
                            hit = 0
                            hbar = 0                        # was it on the title bar?
                            hcls = 0                        # was it on the close box?
                            if mon_open == 1 { if mx >= mon_x { if mx < mon_x + MON_W * ui() {
                                if my >= mon_y { if my < mon_y + MON_H * ui() { hit = 1 }}}}}
                            if ab_open == 1 { if mx >= ab_x { if mx < ab_x + MON_W * ui() {
                                if my >= ab_y { if my < ab_y + AB_H * ui() {
                                    if hit == 0 { hit = 2 }
                                    if focus_win == 2 { hit = 2 }   # About is on top
                                }}}}}
                            hx = mon_x
                            hy = mon_y
                            if hit == 2 { hx = ab_x  hy = ab_y }
                            if hit > 0 {
                                if my < hy + TITLE_H * ui() { hbar = 1 }
                                if my >= hy + 4 * ui() { if my < hy + 26 * ui() {
                                    if mx >= hx + (MON_W - 26) * ui() { if mx < hx + (MON_W - 4) * ui() { hcls = 1 }}}}
                            }

                            if hcls == 1 {
                                # the red box really closes the window now
                                mhide()
                                if hit == 1 { mon_open = 0  bg_rest(mon_x, mon_y, (MON_W + 16) * ui(), (MON_H + 16) * ui()) }
                                if hit == 2 { ab_open = 0   bg_rest(ab_x, ab_y, (MON_W + 16) * ui(), (AB_H + 16) * ui()) }
                                focus_win = 0
                                raise_windows()             # whatever is left, redrawn
                                mpoint(mx, my)
                            }
                            if hcls == 0 { if hit > 0 {
                                # a click anywhere in a window raises and focuses it
                                if focus_win != hit {
                                    mhide()
                                    focus_win = hit
                                    raise_windows()
                                    mpoint(mx, my)
                                }
                                if hbar == 1 {              # title bar: start a drag
                                    if hit == 1 {
                                        dragging = 1  drag_win = 1  dgw = MON_W * ui()  dgh = MON_H * ui()
                                        dox = mon_x  doy = mon_y
                                        gox = mx - mon_x  goy = my - mon_y
                                        mhide()  grab(mon_x, mon_y, (MON_W + 16) * ui(), (MON_H + 16) * ui())
                                    }
                                    if hit == 2 {
                                        dragging = 1  drag_win = 2  dgw = MON_W * ui()  dgh = AB_H * ui()
                                        dox = ab_x  doy = ab_y
                                        gox = mx - ab_x  goy = my - ab_y
                                        mhide()  grab(ab_x, ab_y, (MON_W + 16) * ui(), (AB_H + 16) * ui())
                                    }
                                }
                            }}
                            # ...or click the dock: zlOS opens the menu, a tile launches an app
                            if dragging == 0 { if hit == 0 {
                                if my >= dock_y() {
                                    if mx >= 10 * ui() { if mx < 106 * ui() {
                                        mhide()  open_menu()  mpoint(mx, my)
                                    }}
                                    dcmd = 0
                                    if mx >= DOCK_X0 * ui() {
                                        dslot = (mx - DOCK_X0 * ui()) / (DOCK_PITCH * ui())
                                        dinto = mx - DOCK_X0 * ui() - dslot * DOCK_PITCH * ui()
                                        if dslot < 9 { if dinto < DOCK_TW * ui() {
                                            if dslot == 6 {
                                                mon_open = 1  focus_win = 1
                                                mhide()  raise_windows()  mpoint(mx, my)
                                            }
                                            if dslot == 7 {
                                                ab_open = 1   focus_win = 2
                                                mhide()  raise_windows()  mpoint(mx, my)
                                            }
                                            dcmd = dock_cmd(dslot)
                                        }}
                                    }
                                    if dcmd > 0 {
                                        mhide()  print("")  draw_status("working")
                                        r = run_command(dcmd, 0)
                                        got = 1  last_sec = 0 - 1  last_mx = 0 - 1
                                        draw_status("ready")
                                        if r == 1 { running = 0 }
                                    }
                                }
                            }}
                        }
                    }
                }
            }
            last_mx = mx
            last_my = my
            last_lb = lb
        }

        present()          # push this frame's changes out in one blit

        ch = key_get()
        if ch > 0 {
            mhide()                                 # pointer off before text is drawn
            if is_digit(ch) == true {
                cursor(crow, ccol, 0, C_CURSOR)
                color(C_WHITE)  put(ch - 48)
                ccol = ccol + 1
                last_blink = 0 - 1                  # force a redraw at the new spot
                pending = pending * 10 + (ch - 48)
            } else {
                if ch > 32 {
                    cursor(crow, ccol, 0, C_CURSOR)
                    print("")
                    draw_status("working")
                    r = run_command(ch, pending)
                    pending = 0
                    got = 1
                    last_sec = 0 - 1                # clock lost to the redraw
                    last_mx = 0 - 1                 # force the pointer to redraw too
                    draw_status("ready")
                    if r == 1 { running = 0 }
                }
            }
        }
    }
}

print("")
color(C_YELLOW)  print("  halting.")
color(C_GREY)
draw_status("halted")
