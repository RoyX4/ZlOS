{
  "function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:args}) {", "\t$0", "}"],
    "description": "Function definition"
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:cond} {", "\t$0", "}"],
    "description": "if block"
  },
  "if/else": {
    "prefix": "ifelse",
    "body": ["if ${1:cond} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "elif": {
    "prefix": "elif",
    "body": ["elif ${1:cond} {", "\t$0", "}"],
    "description": "elif block"
  },
  "for-in": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:list} {", "\t$0", "}"],
    "description": "for ... in (the only loop form zl has besides while)"
  },
  "for-range": {
    "prefix": "forr",
    "body": ["for ${1:i} in range(${2:n}) {", "\t$0", "}"],
    "description": "for over range(n)"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:cond} {", "\t$0", "}"],
    "description": "while loop"
  },
  "print": {
    "prefix": "print",
    "body": ["print(${1:value})"],
    "description": "print"
  },
  "f-string": {
    "prefix": "fs",
    "body": ["f\"${1:text} {${2:expr}}\""],
    "description": "Interpolated string"
  },
  "check": {
    "prefix": "check",
    "body": [
      "fn check(label, got, want) {",
      "\tif got == want {",
      "\t\tprint(f\"  ok    {label}\")",
      "\t\treturn 1",
      "\t}",
      "\tprint(f\"  FAIL  {label}: got {got} want {want}\")",
      "\treturn 0",
      "}"
    ],
    "description": "The assertion helper every tests/*.zl defines by hand"
  }
}
