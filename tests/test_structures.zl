print("-- deque: empty --")
t_dq = dq_new()
check("dq_new is empty",            dq_empty(t_dq),      true)
check("dq_new len",                 dq_len(t_dq),        0)
check("dq_new items",               dq_items(t_dq),      [])
check("pop_front of empty",         dq_pop_front(t_dq),  nil())
check("pop_back of empty",          dq_pop_back(t_dq),   nil())
check("peek_front of empty",        dq_peek_front(t_dq), nil())
check("peek_back of empty",         dq_peek_back(t_dq),  nil())
check("empty survives failed pops", dq_len(t_dq),        0)

print("-- deque: one element --")
dq_push_back(t_dq, 42)
check("one element len",            dq_len(t_dq),        1)
check("one element not empty",      dq_empty(t_dq),      false)
check("front == back on singleton", dq_peek_front(t_dq) == dq_peek_back(t_dq), true)
check("pop_back returns it",        dq_pop_back(t_dq),   42)
check("empty again",                dq_empty(t_dq),      true)

print("-- deque: both ends --")
t_dq = dq_new()
dq_push_back(t_dq, 1)
dq_push_back(t_dq, 2)
dq_push_back(t_dq, 3)
check("push_back order",            dq_items(t_dq),      [1, 2, 3])
dq_push_front(t_dq, 0)
check("push_front prepends",        dq_items(t_dq),      [0, 1, 2, 3])
check("len after 4 pushes",         dq_len(t_dq),        4)
check("peek_front",                 dq_peek_front(t_dq), 0)
check("peek_back",                  dq_peek_back(t_dq),  3)
check("peek does not consume",      dq_len(t_dq),        4)
check("pop_front value",            dq_pop_front(t_dq),  0)
check("after pop_front",            dq_items(t_dq),      [1, 2, 3])
check("pop_back value",             dq_pop_back(t_dq),   3)
check("after pop_back",             dq_items(t_dq),      [1, 2])
# FIFO through push_back/pop_front, LIFO through push_back/pop_back
t_fifo = dq_new()
for t_v in [10, 20, 30] {
    dq_push_back(t_fifo, t_v)
}
check("FIFO order",  [dq_pop_front(t_fifo), dq_pop_front(t_fifo), dq_pop_front(t_fifo)], [10, 20, 30])
t_lifo = dq_new()
for t_v2 in [10, 20, 30] {
    dq_push_back(t_lifo, t_v2)
}
check("LIFO order",  [dq_pop_back(t_lifo), dq_pop_back(t_lifo), dq_pop_back(t_lifo)], [30, 20, 10])
# drain past the end: the extra pops must be nil, not a crash
t_drain = dq_new()
dq_push_front(t_drain, "only")
check("over-drain gives nils", [dq_pop_front(t_drain), dq_pop_front(t_drain), dq_pop_back(t_drain)], ["only", nil(), nil()])
# mixed-type payloads
t_mix = dq_new()
dq_push_back(t_mix, "s")
dq_push_back(t_mix, 0)
dq_push_front(t_mix, [1, 2])
check("mixed payloads",             dq_items(t_mix),     [[1, 2], "s", 0])

print("-- ring buffer --")
t_r3 = ring_new(3)
check("fresh ring len",             ring_len(t_r3),      0)
check("fresh ring not full",        ring_full(t_r3),     false)
for t_v3 in [1, 2, 3] {
    ring_push(t_r3, t_v3)
}
check("ring at capacity",           ring_items(t_r3),    [1, 2, 3])
check("ring full",                  ring_full(t_r3),     true)
ring_push(t_r3, 4)
check("ring drops the oldest",      ring_items(t_r3),    [2, 3, 4])
for t_v4 in [5, 6] {
    ring_push(t_r3, t_v4)
}
check("ring after 6 pushes",        ring_items(t_r3),    [4, 5, 6])
check("ring len stays at cap",      ring_len(t_r3),      3)
t_r1 = ring_new(1)
ring_push(t_r1, "a")
ring_push(t_r1, "b")
check("cap-1 ring keeps newest",    ring_items(t_r1),    ["b"])
# cap 0: a ring that can hold nothing. Degenerate but it must not misbehave.
t_r0 = ring_new(0)
ring_push(t_r0, 9)
check("cap-0 ring stays empty",     ring_items(t_r0),    [])
check("cap-0 ring reports full",    ring_full(t_r0),     true)
# ### CRASH (not run) - ring_new(-1) then ring_push kills the interpreter.
# `while len(items) > r[1]` is still true at len 0 when the cap is negative,
# so it calls remove([], 0): "runtime error: remove index out of range" and
# the process exits 1. Live it would abort this file before report() runs.
#   repro:  fn ring_new(cap){return [[],cap]} ... ring_push(ring_new(0-1), 7)
# check("ring cap -1", ring_items(ring_push(ring_new(0 - 1), 7)), [])
check("negative-cap ring crash, see comment", "documented", "documented")

