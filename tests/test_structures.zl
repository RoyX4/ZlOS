# test_structures.zl - test suite for the stdlib data structures
#   deque.zl     dq_* / ring_*
#   heapq.zl     heap_* / kpush / kpop
#   trie.zl      trie_*
#   unionfind.zl uf_*
#   bitset.zl    bs_*
#   fenwick.zl   fen_*
#   segtree.zl   seg_*
#
# Style follows stdlib/testlib.zl - check(label, got, want) / report().
# zl has no import system, so every function under test is INLINED VERBATIM
# from its stdlib module (only the module demos are dropped). Copying rather
# than paraphrasing matters here: the point is to test the shipped code.
#
# Every `want` was worked out by hand. Where the structures are big enough
# that hand-checking every case is impractical, a brute-force reference is
# written out longhand (bf_*) sharing NO code with the structure it checks,
# and the check asserts "0 mismatches over N queries".
#
# Blocks tagged "### WAS BROKEN" pinned a real defect; all of them are fixed
# now, and the checks under them are the regression tests. The BUGS block at
# the bottom of this file records what each one was.
#
# IMPORTANT - why every top-level name here starts with t_ :
# A parameter and a for-loop variable BIND, so they are scoped to the call.
# But an ordinary assignment inside a function still writes the GLOBAL of that
# name when one exists - deliberate, and what the self-hosted compiler relies
# on. So a module's bare LOCALS are still dangerous to its callers. deque.zl
# and heapq.zl used bare names (q v n r cap items h i l p x a b small tmp out
# xs top last) where trie/unionfind/bitset/fenwick/segtree tag every local;
# both have since been given per-function prefixes, and the copies below are
# in sync with them. The t_ prefix here stays anyway: it is what makes the
# final section of this file able to prove the leak is gone.

g_pass = 0
g_fail = 0

fn check(label, got, want) {
    if str(got) == str(want) {
        g_pass = g_pass + 1
        print("  PASS  " + label)
    } else {
        g_fail = g_fail + 1
        print("  FAIL  " + label + "  got " + str(got) + " want " + str(want))
    }
}
fn report() {
    print("----")
    print(str(g_pass) + " passed, " + str(g_fail) + " failed")
}

# =========================================================== stdlib/deque.zl
fn dq_new() {
    return [[]]
}
fn dq_len(q) {
    return len(q[0])
}
fn dq_empty(q) {
    return len(q[0]) == 0
}
fn dq_items(q) {
    return q[0]
}
fn dq_push_back(q, v) {
    q[0] = push(q[0], v)
    return q
}
fn dq_push_front(q, v) {
    q[0] = insert(q[0], 0, v)
    return q
}
fn dq_pop_front(q) {
    if dq_empty(q) {
        return nil()
    }
    pf_v = q[0][0]
    q[0] = remove(q[0], 0)
    return pf_v
}
fn dq_pop_back(q) {
    if dq_empty(q) {
        return nil()
    }
    pb_n = len(q[0])
    pb_v = q[0][pb_n - 1]
    q[0] = remove(q[0], pb_n - 1)
    return pb_v
}
fn dq_peek_front(q) {
    if dq_empty(q) {
        return nil()
    }
    return q[0][0]
}
fn dq_peek_back(q) {
    if dq_empty(q) {
        return nil()
    }
    return q[0][len(q[0]) - 1]
}
fn ring_new(cap) {
    return [[], cap]
}
fn ring_push(r, v) {
    rp_items = push(r[0], v)
    while len(rp_items) > r[1] {
        rp_items = remove(rp_items, 0)
    }
    r[0] = rp_items
    return r
}
fn ring_items(r) {
    return r[0]
}
fn ring_len(r) {
    return len(r[0])
}
fn ring_full(r) {
    return len(r[0]) == r[1]
}

# =========================================================== stdlib/heapq.zl
fn hless(a, b, keyed) {
    if keyed {
        return a[0] < b[0]
    }
    return a < b
}
fn sift_up(h, i, keyed) {
    while i > 0 {
        su_p = int((i - 1) / 2)
        if not hless(h[i], h[su_p], keyed) {
            return h
        }
        su_tmp = h[su_p]
        h[su_p] = h[i]
        h[i] = su_tmp
        i = su_p
    }
    return h
}
fn sift_down(h, i, keyed) {
    sd_n = len(h)
    while true {
        sd_l = 2 * i + 1
        sd_r = sd_l + 1
        sd_small = i
        if sd_l < sd_n {
            if hless(h[sd_l], h[sd_small], keyed) {
                sd_small = sd_l
            }
        }
        if sd_r < sd_n {
            if hless(h[sd_r], h[sd_small], keyed) {
                sd_small = sd_r
            }
        }
        if sd_small == i {
            return h
        }
        sd_tmp = h[i]
        h[i] = h[sd_small]
        h[sd_small] = sd_tmp
        i = sd_small
    }
    return h
}

fn heap_new() {
    return []
}
fn heap_len(h) {
    return len(h)
}
fn heap_peek(h) {
    if len(h) == 0 {
        return nil()
    }
    return h[0]
}
fn heap_push(h, v) {
    h = push(h, v)
    return sift_up(h, len(h) - 1, false)
}
fn heap_pop(h, keyed) {
    hp_n = len(h)
    if hp_n == 0 {
        return [h, nil()]
    }
    hp_top = h[0]
    hp_last = h[hp_n - 1]
    h = remove(h, hp_n - 1)
    if len(h) > 0 {
        h[0] = hp_last
        h = sift_down(h, 0, keyed)
    }
    return [h, hp_top]
}
fn heap_pop_min(h) {
    return heap_pop(h, false)
}
fn heapify(xs) {
    hf_h = []
    for hf_x in xs {
        hf_h = push(hf_h, hf_x)
    }
    hf_i = int(len(hf_h) / 2) - 1
    while hf_i >= 0 {
        hf_h = sift_down(hf_h, hf_i, false)
        hf_i = hf_i - 1
    }
    return hf_h
}
fn heap_sort(xs) {
    hs_h = heapify(xs)
    hs_out = []
    while len(hs_h) > 0 {
        hs_r = heap_pop_min(hs_h)
        hs_h = hs_r[0]
        hs_out = push(hs_out, hs_r[1])
    }
    return hs_out
}

# keyed variant: the heap holds [priority, item] pairs, lowest priority first.
fn kpush(h, priority, item) {
    h = push(h, [priority, item])
    return sift_up(h, len(h) - 1, true)
}
fn kpop(h) {
    return heap_pop(h, true)
}

# ============================================================ stdlib/trie.zl
fn trie_new() {
    return [[""], [[]], [0]]
}
fn trie_node_at(na_t, na_s) {
    na_i = 0
    na_p = 0
    while na_p < len(na_s) {
        na_ch = at(na_s, na_p)
        na_next = -1
        for na_c in na_t[1][na_i] {
            if na_t[0][na_c] == na_ch {
                na_next = na_c
                break
            }
        }
        if na_next < 0 {
            return -1
        }
        na_i = na_next
        na_p = na_p + 1
    }
    return na_i
}
fn trie_insert(ti_t, ti_w) {
    ti_i = 0
    ti_p = 0
    while ti_p < len(ti_w) {
        ti_ch = at(ti_w, ti_p)
        ti_code = code(ti_ch)
        ti_kids = ti_t[1][ti_i]
        ti_next = -1
        ti_k = 0
        while ti_k < len(ti_kids) {
            if ti_t[0][ti_kids[ti_k]] == ti_ch {
                ti_next = ti_kids[ti_k]
                break
            }
            ti_k = ti_k + 1
        }
        if ti_next < 0 {
            ti_next = len(ti_t[0])
            ti_t[0] = push(ti_t[0], ti_ch)
            ti_t[1] = push(ti_t[1], [])
            ti_t[2] = push(ti_t[2], 0)
            ti_pos = 0
            while ti_pos < len(ti_kids) {
                if code(ti_t[0][ti_kids[ti_pos]]) >= ti_code {
                    break
                }
                ti_pos = ti_pos + 1
            }
            ti_t[1][ti_i] = insert(ti_kids, ti_pos, ti_next)
        }
        ti_i = ti_next
        ti_p = ti_p + 1
    }
    ti_t[2][ti_i] = 1
    return ti_t
}
fn trie_has(th_t, th_w) {
    th_n = trie_node_at(th_t, th_w)
    if th_n < 0 {
        return false
    }
    return th_t[2][th_n] == 1
}
# Is sw_pre a prefix of at least one stored WORD? Reachability alone is not the
# answer: the root is reachable by "" the moment the trie exists, so this used
# to say true on a trie storing nothing. Every OTHER reachable node was put
# there by inserting a word and nothing is ever deleted, so for those
# reachability is exact - only the root needs the extra test.
fn trie_starts_with(sw_t, sw_pre) {
    sw_n = trie_node_at(sw_t, sw_pre)
    if sw_n < 0 {
        return false
    }
    if sw_n == 0 {
        return contains(sw_t[2], 1)
    }
    return true
}
fn trie_with_prefix(wp_t, wp_pre) {
    wp_out = []
    wp_start = trie_node_at(wp_t, wp_pre)
    if wp_start < 0 {
        return wp_out
    }
    wp_stack = [[wp_start, wp_pre]]
    while len(wp_stack) > 0 {
        wp_top = last(wp_stack)
        wp_stack = remove(wp_stack, len(wp_stack) - 1)
        wp_n = wp_top[0]
        wp_s = wp_top[1]
        if wp_t[2][wp_n] == 1 {
            wp_out = push(wp_out, wp_s)
        }
        wp_kids = wp_t[1][wp_n]
        wp_k = len(wp_kids) - 1
        while wp_k >= 0 {
            wp_c = wp_kids[wp_k]
            wp_stack = push(wp_stack, [wp_c, wp_s + wp_t[0][wp_c]])
            wp_k = wp_k - 1
        }
    }
    return wp_out
}
fn trie_words(wd_t) {
    return trie_with_prefix(wd_t, "")
}
fn trie_count(ct_t) {
    return sum(ct_t[2])
}
fn trie_longest_prefix(lp_t, lp_s) {
    lp_best = ""
    lp_i = 0
    lp_p = 0
    while lp_p < len(lp_s) {
        lp_ch = at(lp_s, lp_p)
        lp_next = -1
        for lp_c in lp_t[1][lp_i] {
            if lp_t[0][lp_c] == lp_ch {
                lp_next = lp_c
                break
            }
        }
        if lp_next < 0 {
            break
        }
        lp_i = lp_next
        lp_p = lp_p + 1
        if lp_t[2][lp_i] == 1 {
            lp_best = slice(lp_s, 0, lp_p)
        }
    }
    return lp_best
}

# ======================================================= stdlib/unionfind.zl
fn uf_new(un_n) {
    return [range(un_n), fill(un_n, 0), un_n]
}
fn uf_find(uf_u, uf_x) {
    uf_par = uf_u[0]
    uf_root = uf_x
    while uf_par[uf_root] != uf_root {
        uf_root = uf_par[uf_root]
    }
    uf_cur = uf_x
    while uf_par[uf_cur] != uf_root {
        uf_next = uf_par[uf_cur]
        uf_par[uf_cur] = uf_root
        uf_cur = uf_next
    }
    return uf_root
}
fn uf_union(uu_u, uu_a, uu_b) {
    uu_ra = uf_find(uu_u, uu_a)
    uu_rb = uf_find(uu_u, uu_b)
    if uu_ra == uu_rb {
        return false
    }
    uu_par = uu_u[0]
    uu_rank = uu_u[1]
    if uu_rank[uu_ra] < uu_rank[uu_rb] {
        uu_swap = uu_ra
        uu_ra = uu_rb
        uu_rb = uu_swap
    }
    uu_par[uu_rb] = uu_ra
    if uu_rank[uu_ra] == uu_rank[uu_rb] {
        uu_rank[uu_ra] = uu_rank[uu_ra] + 1
    }
    uu_u[2] = uu_u[2] - 1
    return true
}
fn uf_connected(uc_u, uc_a, uc_b) {
    uc_ra = uf_find(uc_u, uc_a)
    uc_rb = uf_find(uc_u, uc_b)
    return uc_ra == uc_rb
}
fn uf_count(uk_u) {
    return uk_u[2]
}
fn uf_groups(ug_u) {
    ug_roots = []
    ug_out = []
    ug_n = len(ug_u[0])
    ug_i = 0
    while ug_i < ug_n {
        ug_r = uf_find(ug_u, ug_i)
        ug_slot = index_of(ug_roots, ug_r)
        if ug_slot < 0 {
            ug_roots = push(ug_roots, ug_r)
            ug_out = push(ug_out, [ug_i])
        } else {
            ug_out[ug_slot] = push(ug_out[ug_slot], ug_i)
        }
        ug_i = ug_i + 1
    }
    return ug_out
}

# ========================================================== stdlib/bitset.zl
fn bs_popword(pw_w) {
    pw_x = pw_w
    pw_n = 0
    while pw_x > 0 {
        pw_n = pw_n + band(pw_x, 1)
        pw_x = shr(pw_x, 1)
    }
    return pw_n
}
fn bs_tailmask(tm_b, tm_wi) {
    tm_left = tm_b[0] - (tm_wi - 1) * 32
    if tm_left >= 32 {
        return 4294967295
    }
    if tm_left <= 0 {
        return 0
    }
    return shl(1, tm_left) - 1
}
fn bs_new(nw_nbits) {
    assert(nw_nbits >= 0, "bs_new: nbits must be >= 0")
    nw_words = int((nw_nbits + 31) / 32)
    nw_out = [nw_nbits]
    nw_k = 0
    while nw_k < nw_words {
        nw_out = push(nw_out, 0)
        nw_k = nw_k + 1
    }
    return nw_out
}
fn bs_size(sz_b) {
    return sz_b[0]
}
fn bs_set(st_b, st_i) {
    assert(st_i >= 0 and st_i < st_b[0], "bs_set: index out of range")
    st_w = int(st_i / 32) + 1
    st_b[st_w] = bor(st_b[st_w], shl(1, st_i % 32))
    return st_b
}
fn bs_clear(cl_b, cl_i) {
    assert(cl_i >= 0 and cl_i < cl_b[0], "bs_clear: index out of range")
    cl_w = int(cl_i / 32) + 1
    cl_bit = shl(1, cl_i % 32)
    cl_b[cl_w] = bxor(cl_b[cl_w], band(cl_b[cl_w], cl_bit))
    return cl_b
}
fn bs_flip(fl_b, fl_i) {
    assert(fl_i >= 0 and fl_i < fl_b[0], "bs_flip: index out of range")
    fl_w = int(fl_i / 32) + 1
    fl_b[fl_w] = bxor(fl_b[fl_w], shl(1, fl_i % 32))
    return fl_b
}
fn bs_get(gt_b, gt_i) {
    assert(gt_i >= 0 and gt_i < gt_b[0], "bs_get: index out of range")
    gt_w = int(gt_i / 32) + 1
    return band(shr(gt_b[gt_w], gt_i % 32), 1)
}
fn bs_count(ct_b) {
    ct_n = 0
    ct_i = 1
    while ct_i < len(ct_b) {
        ct_n = ct_n + bs_popword(ct_b[ct_i])
        ct_i = ct_i + 1
    }
    return ct_n
}
fn bs_any(ay_b) {
    ay_i = 1
    while ay_i < len(ay_b) {
        if ay_b[ay_i] != 0 {
            return true
        }
        ay_i = ay_i + 1
    }
    return false
}
fn bs_all(al_b) {
    al_i = 1
    while al_i < len(al_b) {
        al_m = bs_tailmask(al_b, al_i)
        if band(al_b[al_i], al_m) != al_m {
            return false
        }
        al_i = al_i + 1
    }
    return true
}
fn bs_union(un_a, un_b) {
    assert(un_a[0] == un_b[0], "bs_union: size mismatch")
    un_out = bs_new(un_a[0])
    un_i = 1
    while un_i < len(un_a) {
        un_out[un_i] = bor(un_a[un_i], un_b[un_i])
        un_i = un_i + 1
    }
    return un_out
}
fn bs_inter(it_a, it_b) {
    assert(it_a[0] == it_b[0], "bs_inter: size mismatch")
    it_out = bs_new(it_a[0])
    it_i = 1
    while it_i < len(it_a) {
        it_out[it_i] = band(it_a[it_i], it_b[it_i])
        it_i = it_i + 1
    }
    return it_out
}
fn bs_diff(df_a, df_b) {
    assert(df_a[0] == df_b[0], "bs_diff: size mismatch")
    df_out = bs_new(df_a[0])
    df_i = 1
    while df_i < len(df_a) {
        df_out[df_i] = bxor(df_a[df_i], band(df_a[df_i], df_b[df_i]))
        df_i = df_i + 1
    }
    return df_out
}
fn bs_to_string(ts_b) {
    ts_s = ""
    ts_i = 0
    while ts_i < ts_b[0] {
        ts_s = ts_s + str(bs_get(ts_b, ts_i))
        ts_i = ts_i + 1
    }
    return ts_s
}

# ========================================================= stdlib/fenwick.zl
fn lowbit(lb_k) {
    return band(lb_k, 0 - lb_k)
}
fn fen_new(nw_n) {
    return fill(nw_n + 1, 0)
}
fn fen_size(fz_f) {
    return len(fz_f) - 1
}
fn fen_add(fa_f, fa_i, fa_d) {
    fa_n = len(fa_f) - 1
    if fa_i < 0 or fa_i >= fa_n {
        return fa_f
    }
    fa_k = fa_i + 1
    while fa_k <= fa_n {
        fa_f[fa_k] = fa_f[fa_k] + fa_d
        fa_k = fa_k + lowbit(fa_k)
    }
    return fa_f
}
fn fen_sum(fs_f, fs_i) {
    fs_n = len(fs_f) - 1
    fs_k = fs_i + 1
    if fs_k > fs_n {
        fs_k = fs_n
    }
    fs_s = 0
    while fs_k > 0 {
        fs_s = fs_s + fs_f[fs_k]
        fs_k = fs_k - lowbit(fs_k)
    }
    return fs_s
}
fn fen_range(fr_f, fr_a, fr_b) {
    if fr_a > fr_b {
        return 0
    }
    return fen_sum(fr_f, fr_b) - fen_sum(fr_f, fr_a - 1)
}
fn fen_set(ft_f, ft_i, ft_v) {
    ft_cur = fen_range(ft_f, ft_i, ft_i)
    return fen_add(ft_f, ft_i, ft_v - ft_cur)
}
fn fen_to_list(fl_f) {
    fl_n = len(fl_f) - 1
    fl_out = []
    fl_prev = 0
    fl_i = 0
    while fl_i < fl_n {
        fl_s = fen_sum(fl_f, fl_i)
        fl_out = push(fl_out, fl_s - fl_prev)
        fl_prev = fl_s
        fl_i = fl_i + 1
    }
    return fl_out
}
fn fen_build(fb_xs) {
    fb_n = len(fb_xs)
    fb_t = fill(fb_n + 1, 0)
    fb_i = 1
    while fb_i <= fb_n {
        fb_t[fb_i] = fb_t[fb_i] + fb_xs[fb_i - 1]
        fb_j = fb_i + lowbit(fb_i)
        if fb_j <= fb_n {
            fb_t[fb_j] = fb_t[fb_j] + fb_t[fb_i]
        }
        fb_i = fb_i + 1
    }
    return fb_t
}

# ========================================================= stdlib/segtree.zl
fn seg_pow2_ceil(p2_n) {
    p2_s = 1
    while p2_s < p2_n {
        p2_s = p2_s * 2
    }
    return p2_s
}
fn seg_op(op_kind, op_a, op_b) {
    if type(op_a) == "nil" {
        return op_b
    }
    if type(op_b) == "nil" {
        return op_a
    }
    if op_kind == "sum" {
        return op_a + op_b
    }
    if op_kind == "min" {
        return min(op_a, op_b)
    }
    return max(op_a, op_b)
}
fn seg_build(bd_xs, bd_kind) {
    assert(bd_kind == "sum" or bd_kind == "min" or bd_kind == "max", "seg_build: kind must be sum, min or max")
    bd_n = len(bd_xs)
    bd_size = seg_pow2_ceil(bd_n)
    bd_nodes = fill(2 * bd_size, nil())
    bd_i = 0
    while bd_i < bd_n {
        bd_nodes[bd_size + bd_i] = bd_xs[bd_i]
        bd_i = bd_i + 1
    }
    bd_p = bd_size - 1
    while bd_p >= 1 {
        bd_nodes[bd_p] = seg_op(bd_kind, bd_nodes[2 * bd_p], bd_nodes[2 * bd_p + 1])
        bd_p = bd_p - 1
    }
    return [bd_nodes, bd_n, bd_kind, bd_size]
}
fn seg_size(sz_t) {
    return sz_t[1]
}
fn seg_kind(sk_t) {
    return sk_t[2]
}
fn seg_get(sg_t, sg_i) {
    if sg_i < 0 {
        return nil()
    }
    if sg_i >= sg_t[1] {
        return nil()
    }
    return sg_t[0][sg_t[3] + sg_i]
}
fn seg_update(up_t, up_i, up_v) {
    assert(up_i >= 0, "seg_update: index below 0")
    assert(up_i < up_t[1], "seg_update: index past the end")
    up_p = up_t[3] + up_i
    up_t[0][up_p] = up_v
    up_p = int(up_p / 2)
    while up_p >= 1 {
        up_t[0][up_p] = seg_op(up_t[2], up_t[0][2 * up_p], up_t[0][2 * up_p + 1])
        up_p = int(up_p / 2)
    }
    return up_t
}
fn seg_query(qy_t, qy_a, qy_b) {
    qy_lo = max(qy_a, 0)
    qy_hi = min(qy_b, qy_t[1] - 1)
    if qy_lo > qy_hi {
        return nil()
    }
    qy_l = qy_t[3] + qy_lo
    qy_r = qy_t[3] + qy_hi + 1
    qy_left = nil()
    qy_right = nil()
    while qy_l < qy_r {
        if qy_l % 2 == 1 {
            qy_left = seg_op(qy_t[2], qy_left, qy_t[0][qy_l])
            qy_l = qy_l + 1
        }
        if qy_r % 2 == 1 {
            qy_r = qy_r - 1
            qy_right = seg_op(qy_t[2], qy_t[0][qy_r], qy_right)
        }
        qy_l = int(qy_l / 2)
        qy_r = int(qy_r / 2)
    }
    return seg_op(qy_t[2], qy_left, qy_right)
}

# ===========================================================================
# Brute-force references. Written longhand, sharing nothing with the code
# they check, so a bug cannot hide by also being a bug in the checker.
# ===========================================================================

fn bf_listmin(bfm_xs) {
    bfm_best = bfm_xs[0]
    bfm_k = 1
    while bfm_k < len(bfm_xs) {
        if bfm_xs[bfm_k] < bfm_best {
            bfm_best = bfm_xs[bfm_k]
        }
        bfm_k = bfm_k + 1
    }
    return bfm_best
}
fn bf_isheap(bfi_h) {
    bfi_k = 0
    while bfi_k < len(bfi_h) {
        bfi_l = 2 * bfi_k + 1
        bfi_r = bfi_l + 1
        if bfi_l < len(bfi_h) {
            if bfi_h[bfi_l] < bfi_h[bfi_k] {
                return false
            }
        }
        if bfi_r < len(bfi_h) {
            if bfi_h[bfi_r] < bfi_h[bfi_k] {
                return false
            }
        }
        bfi_k = bfi_k + 1
    }
    return true
}
# Drive a push/pop script against the heap AND against a plain list, and
# count every step where the heap disagrees with the list. op [1,v] pushes v,
# op [0,0] pops. Returns [violations, steps].
fn bf_heap_drive(bfv_script) {
    bfv_h = heap_new()
    bfv_ref = []
    bfv_bad = 0
    bfv_steps = 0
    for bfv_op in bfv_script {
        bfv_steps = bfv_steps + 1
        if bfv_op[0] == 1 {
            bfv_h = heap_push(bfv_h, bfv_op[1])
            bfv_ref = push(bfv_ref, bfv_op[1])
        } else {
            if len(bfv_ref) == 0 {
                bfv_res = heap_pop_min(bfv_h)
                bfv_h = bfv_res[0]
                if type(bfv_res[1]) != "nil" {
                    bfv_bad = bfv_bad + 1
                }
            } else {
                bfv_want = bf_listmin(bfv_ref)
                bfv_res = heap_pop_min(bfv_h)
                bfv_h = bfv_res[0]
                if bfv_res[1] != bfv_want {
                    bfv_bad = bfv_bad + 1
                }
                bfv_ref = remove(bfv_ref, index_of(bfv_ref, bfv_want))
            }
        }
        if len(bfv_h) != len(bfv_ref) {
            bfv_bad = bfv_bad + 1
        }
        if not bf_isheap(bfv_h) {
            bfv_bad = bfv_bad + 1
        }
        if len(bfv_ref) > 0 {
            if heap_peek(bfv_h) != bf_listmin(bfv_ref) {
                bfv_bad = bfv_bad + 1
            }
        }
    }
    return [bfv_bad, bfv_steps]
}
fn bf_range(bfr_xs, bfr_a, bfr_b) {
    bfr_s = 0
    bfr_k = bfr_a
    while bfr_k <= bfr_b {
        bfr_s = bfr_s + bfr_xs[bfr_k]
        bfr_k = bfr_k + 1
    }
    return bfr_s
}
fn bf_rangek(bfk_xs, bfk_a, bfk_b, bfk_kind) {
    bfk_seen = false
    bfk_acc = 0
    bfk_k = bfk_a
    while bfk_k <= bfk_b {
        bfk_v = bfk_xs[bfk_k]
        if bfk_seen {
            if bfk_kind == "sum" {
                bfk_acc = bfk_acc + bfk_v
            }
            if bfk_kind == "min" {
                if bfk_v < bfk_acc {
                    bfk_acc = bfk_v
                }
            }
            if bfk_kind == "max" {
                if bfk_v > bfk_acc {
                    bfk_acc = bfk_v
                }
            }
        } else {
            bfk_acc = bfk_v
            bfk_seen = true
        }
        bfk_k = bfk_k + 1
    }
    if bfk_seen {
        return bfk_acc
    }
    return nil()
}
# every 0 <= a <= b <= n-1 against the plain list. [mismatches, queries]
fn bf_fen_sweep(bff_f, bff_ref) {
    bff_bad = 0
    bff_q = 0
    bff_a = 0
    while bff_a < len(bff_ref) {
        bff_b = bff_a
        while bff_b < len(bff_ref) {
            bff_q = bff_q + 1
            if fen_range(bff_f, bff_a, bff_b) != bf_range(bff_ref, bff_a, bff_b) {
                bff_bad = bff_bad + 1
            }
            bff_b = bff_b + 1
        }
        bff_a = bff_a + 1
    }
    return [bff_bad, bff_q]
}
fn bf_seg_sweep(bfs_t, bfs_ref) {
    bfs_bad = 0
    bfs_q = 0
    bfs_a = 0
    while bfs_a < len(bfs_ref) {
        bfs_b = bfs_a
        while bfs_b < len(bfs_ref) {
            bfs_q = bfs_q + 1
            if seg_query(bfs_t, bfs_a, bfs_b) != bf_rangek(bfs_ref, bfs_a, bfs_b, bfs_t[2]) {
                bfs_bad = bfs_bad + 1
            }
            bfs_b = bfs_b + 1
        }
        bfs_a = bfs_a + 1
    }
    return [bfs_bad, bfs_q]
}
# transitive closure of an undirected edge list, then every pair against
# uf_connected. [mismatches, pairs]
fn bf_uf_sweep(bfu_n, bfu_edges, bfu_u) {
    bfu_m = fill(bfu_n * bfu_n, 0)
    bfu_i = 0
    while bfu_i < bfu_n {
        bfu_m[bfu_i * bfu_n + bfu_i] = 1
        bfu_i = bfu_i + 1
    }
    for bfu_e in bfu_edges {
        bfu_m[bfu_e[0] * bfu_n + bfu_e[1]] = 1
        bfu_m[bfu_e[1] * bfu_n + bfu_e[0]] = 1
    }
    bfu_k = 0
    while bfu_k < bfu_n {
        bfu_a = 0
        while bfu_a < bfu_n {
            bfu_b = 0
            while bfu_b < bfu_n {
                if bfu_m[bfu_a * bfu_n + bfu_k] == 1 {
                    if bfu_m[bfu_k * bfu_n + bfu_b] == 1 {
                        bfu_m[bfu_a * bfu_n + bfu_b] = 1
                    }
                }
                bfu_b = bfu_b + 1
            }
            bfu_a = bfu_a + 1
        }
        bfu_k = bfu_k + 1
    }
    bfu_bad = 0
    bfu_pairs = 0
    bfu_a = 0
    while bfu_a < bfu_n {
        bfu_b = 0
        while bfu_b < bfu_n {
            bfu_pairs = bfu_pairs + 1
            if uf_connected(bfu_u, bfu_a, bfu_b) != (bfu_m[bfu_a * bfu_n + bfu_b] == 1) {
                bfu_bad = bfu_bad + 1
            }
            bfu_b = bfu_b + 1
        }
        bfu_a = bfu_a + 1
    }
    return [bfu_bad, bfu_pairs]
}
fn bf_trie_sweep(bft_t, bft_words, bft_cands) {
    bft_bad = 0
    for bft_c in bft_cands {
        if trie_has(bft_t, bft_c) != contains(bft_words, bft_c) {
            bft_bad = bft_bad + 1
        }
    }
    return bft_bad
}
fn bf_prefix_sweep(bfp_t, bfp_words, bfp_cands) {
    bfp_bad = 0
    for bfp_c in bfp_cands {
        bfp_want = false
        for bfp_w in bfp_words {
            if starts(bfp_w, bfp_c) {
                bfp_want = true
            }
        }
        if trie_starts_with(bfp_t, bfp_c) != bfp_want {
            bfp_bad = bfp_bad + 1
        }
    }
    return bfp_bad
}
fn bf_bitset_sweep(bfb_b, bfb_ref) {
    bfb_bad = 0
    bfb_k = 0
    while bfb_k < len(bfb_ref) {
        if bs_get(bfb_b, bfb_k) != bfb_ref[bfb_k] {
            bfb_bad = bfb_bad + 1
        }
        bfb_k = bfb_k + 1
    }
    if bs_count(bfb_b) != sum(bfb_ref) {
        bfb_bad = bfb_bad + 1
    }
    if bs_any(bfb_b) != (sum(bfb_ref) > 0) {
        bfb_bad = bfb_bad + 1
    }
    if bs_all(bfb_b) != (sum(bfb_ref) == len(bfb_ref)) {
        bfb_bad = bfb_bad + 1
    }
    return bfb_bad
}

