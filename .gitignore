# The harnesses whose binaries were never listed. csstest and fbtext have been
# built by ./build.sh since they were written and have shown up as untracked
# ever since; pngtest is new. A build output that is merely UNLISTED rather
# than ignored is one `git add -A` away from being committed, which is how
# _genefi.c got into this repo in the first place.
kernel/tests/host/csstest
kernel/tests/host/fbtext
kernel/tests/host/pngtest
kernel/tests/host/csstest_san
kernel/tests/host/pngtest_san
kernel/tests/host/browsertest_san
kernel/tests/host/arenatest
kernel/tests/host/settingstest
kernel/tests/host/systest
