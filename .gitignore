# zlOS outputs are also covered by kernel/.gitignore; these root-qualified
# patterns make the boundary obvious from the repository front door.
kernel/*.elf
kernel/*.img
kernel/*.iso
kernel/*.EFI
kernel/*.lib
kernel/_gen*.c
kernel/shots/
kernel/exercise-out/

# Repository-level rendered frames. Curated evidence under docs/shots remains
# tracked because this rule is anchored to the root.
/shots/

# Local caches and editor state
**/__pycache__/
.cache/
.cursor/

# Local scratch files
scratch.zl
examples/Zaccoding.zl
