# tiny_calc.zl
# Arithmetic expression evaluator for the zl language.
# Supports + - * / with correct precedence and parentheses.
# Approach: tokenize the string, then recursive-descent parse+eval.
#
# zl has no maps/tuples and functions cannot reliably mutate globals,
# so each parse function returns a 2-element list [value, nextPos].
# This threads the cursor position back to the caller purely by return value.

DIGITS = "0123456789."

# ---- tokenizer ----------------------------------------------------------
# Turns "12 + (3*4)" into a list of token strings ["12","+","(","3","*","4",")"]
fn isNumChar(c) {
    return find(DIGITS, c) >= 0
}

fn tokenize(s) {
    toks = []
    i = 0
    while i < len(s) {
        c = at(s, i)
        if c == " " or c == "\t" {
            i = i + 1
        } else {
            if isNumChar(c) {
                numstr = ""
                # consume a run of digits / decimal points
                while i < len(s) and isNumChar(at(s, i)) {
                    numstr = numstr + at(s, i)
                    i = i + 1
                }
                toks = push(toks, numstr)
            } else {
                # single-char token: + - * / ( )
                toks = push(toks, c)
                i = i + 1
            }
        }
    }
    return toks
}

# ---- recursive-descent parser + evaluator -------------------------------
# Grammar:
#   expr   -> term  (('+' | '-') term)*
#   term   -> factor (('*' | '/') factor)*
#   factor -> number | '(' expr ')' | '-' factor
#
# NOTE: zl's `and`/`or` do NOT short-circuit, so a guard like
# `p < len(toks) and toks[p] == "+"` still evaluates toks[p] out of range.
# tokAt() returns "" for out-of-range positions to make loop guards safe.
fn tokAt(toks, p) {
    if p < len(toks) {
        return toks[p]
    } else {
        return ""
    }
}

fn parseFactor(toks, pos) {
    t = tokAt(toks, pos)
    if t == "(" {
        inner = parseExpr(toks, pos + 1)      # inner = [value, posAtCloseParen]
        val = inner[0]
        np = inner[1]
        return [val, np + 1]                  # skip the ')'
    } else {
        if t == "-" {                         # unary minus
            f = parseFactor(toks, pos + 1)
            return [-f[0], f[1]]
        } else {
            return [num(t), pos + 1]
        }
    }
}

fn parseTerm(toks, pos) {
    r = parseFactor(toks, pos)
    val = r[0]
    p = r[1]
    while tokAt(toks, p) == "*" or tokAt(toks, p) == "/" {
        op = tokAt(toks, p)
        rhs = parseFactor(toks, p + 1)
        if op == "*" {
            val = val * rhs[0]
        } else {
            val = val / rhs[0]
        }
        p = rhs[1]
    }
    return [val, p]
}

fn parseExpr(toks, pos) {
    r = parseTerm(toks, pos)
    val = r[0]
    p = r[1]
    while tokAt(toks, p) == "+" or tokAt(toks, p) == "-" {
        op = tokAt(toks, p)
        rhs = parseTerm(toks, p + 1)
        if op == "+" {
            val = val + rhs[0]
        } else {
            val = val - rhs[0]
        }
        p = rhs[1]
    }
    return [val, p]
}

# public entry point: evaluate a string expression -> number
fn evaluate(s) {
    toks = tokenize(s)
    r = parseExpr(toks, 0)
    return r[0]
}

# ---- self-test ----------------------------------------------------------
print("tiny_calc self-test")
print("-------------------")
print("2 + 3 * 4            = " + evaluate("2 + 3 * 4"))       # expect 14
print("(2 + 3) * 4          = " + evaluate("(2 + 3) * 4"))     # expect 20
print("10 - 2 - 3           = " + evaluate("10 - 2 - 3"))      # expect 5 (left assoc)
print("2 * (3 + 4) * 5      = " + evaluate("2 * (3 + 4) * 5")) # expect 70
print("100 / 5 / 2          = " + evaluate("100 / 5 / 2"))     # expect 10
print("-5 + 3               = " + evaluate("-5 + 3"))          # expect -2
print("((1 + 2) * (3 + 4))  = " + evaluate("((1 + 2) * (3 + 4))")) # expect 21
