# noise.zl - deterministic procedural noise: value noise, fBm, heightmaps.
# Groundwork for the game system: terrain, clouds, ore veins, wobble.
#
# Representation: noise is a pure function of its coordinates and a seed -
# there is no hidden state, so nothing here calls random() or seed(). The
# same (x, y, seed) always gives the same number, on any run and in any
# order, which is what lets a world be stored as four numbers instead of a
# grid. Every noise value is a fraction in [0, 1).
#
# The randomness comes from an integer hash written here with the bitwise
# builtins (a 32-bit murmur3 finalizer). zl numbers are doubles, exact only
# to 2^53, so a plain a * b on 32-bit values would silently lose its low
# bits - the very bits a hash lives on. mul32() therefore splits the left
# operand into two 16-bit halves so every partial product stays under 2^48
# and the wrap to 32 bits is exact.
#
# Value noise (not gradient/Perlin noise): hash the integer lattice points,
# then interpolate between them with a smoothstep fade. Cheaper and simpler
# than gradients, and for terrain stacked into fBm the difference does not
# show.
#
# Naming: zl has no local scope in the usual sense - assigning a name that
# already exists as a global writes that global. So every parameter and
# local here carries a two-letter tag for its function (mu_ = mul32,
# vn_ = value_noise_2d, ...), the same convention bitops.zl uses.

MASK32 = 4294967295          # 2^32 - 1
TWO32 = 4294967296           # 2^32
HASH_SALT = 1013904223       # keeps the origin of seed 0 off the fixed point
FBM_LACUNARITY = 2           # frequency multiplier per octave
FBM_GAIN = 0.5               # amplitude multiplier per octave
FBM_SEED_STEP = 1013         # octaves must not reuse one lattice
MAP_OCTAVES = 4              # octaves heightmap() stacks

# --- integer hash -----------------------------------------------------

# Exact (a * b) mod 2^32 for a, b in [0, 2^32).
fn mul32(mu_a, mu_b) {
    mu_lo = mu_a % 65536
    mu_hi = int(mu_a / 65536)
    mu_r = (mu_lo * mu_b) % TWO32
    mu_r = (mu_r + ((mu_hi * mu_b) % 65536) * 65536) % TWO32
    return mu_r
}

# murmur3 fmix32: scrambles one integer into a well-spread 32-bit value.
fn hash32(hx_n) {
    hx_h = band(int(hx_n), MASK32)
    hx_h = bxor(hx_h, shr(hx_h, 16))
    hx_h = mul32(hx_h, 2246822519)
    hx_h = bxor(hx_h, shr(hx_h, 13))
    hx_h = mul32(hx_h, 3266489917)
    hx_h = bxor(hx_h, shr(hx_h, 16))
    return hx_h
}

# Lattice point -> [0, 1). Coordinates may be negative: band() reads them
# back as 32-bit two's complement, so -1 and 4294967295 are one point.
# HASH_SALT is why the coordinates are mixed and not fed in raw - fmix32
# maps 0 to 0, and without the salt the origin of seed 0 would be exactly
# 0.0. The salt does not remove that fixed point, it moves it off (0,0).
fn hash_1d(h1_i, h1_seed) {
    h1_h = mul32(band(int(h1_i), MASK32), 374761393)
    h1_h = bxor(h1_h, mul32(band(int(h1_seed), MASK32), 2654435761))
    return hash32(bxor(h1_h, HASH_SALT)) / TWO32
}
fn hash_2d(h2_x, h2_y, h2_seed) {
    h2_h = mul32(band(int(h2_x), MASK32), 374761393)
    h2_h = bxor(h2_h, mul32(band(int(h2_y), MASK32), 668265263))
    h2_h = bxor(h2_h, mul32(band(int(h2_seed), MASK32), 2654435761))
    return hash32(bxor(h2_h, HASH_SALT)) / TWO32
}

# --- interpolation ----------------------------------------------------

fn lerp(lp_a, lp_b, lp_t) {
    return lp_a + (lp_b - lp_a) * lp_t
}

# Clamped cubic ease, the GLSL shape: 0 below e0, 1 above e1, flat slope
# at both ends so tiles meet without a visible crease.
fn smoothstep(ss_e0, ss_e1, ss_x) {
    if ss_e1 == ss_e0 {
        if ss_x < ss_e0 {
            return 0
        }
        return 1
    }
    ss_t = clamp((ss_x - ss_e0) / (ss_e1 - ss_e0), 0, 1)
    return ss_t * ss_t * (3 - 2 * ss_t)
}

# --- value noise ------------------------------------------------------

fn value_noise_1d(v1_x, v1_seed) {
    v1_i = floor(v1_x)
    v1_t = smoothstep(0, 1, v1_x - v1_i)
    return lerp(hash_1d(v1_i, v1_seed), hash_1d(v1_i + 1, v1_seed), v1_t)
}

fn value_noise_2d(vn_x, vn_y, vn_seed) {
    vn_ix = floor(vn_x)
    vn_iy = floor(vn_y)
    vn_u = smoothstep(0, 1, vn_x - vn_ix)
    vn_v = smoothstep(0, 1, vn_y - vn_iy)
    vn_c00 = hash_2d(vn_ix, vn_iy, vn_seed)
    vn_c10 = hash_2d(vn_ix + 1, vn_iy, vn_seed)
    vn_c01 = hash_2d(vn_ix, vn_iy + 1, vn_seed)
    vn_c11 = hash_2d(vn_ix + 1, vn_iy + 1, vn_seed)
    vn_top = lerp(vn_c00, vn_c10, vn_u)
    vn_bot = lerp(vn_c01, vn_c11, vn_u)
    return lerp(vn_top, vn_bot, vn_v)
}

# Fractal Brownian motion: octaves of value noise, each twice the
# frequency and half the amplitude. Divided by the amplitude total, so the
# result stays in [0, 1).
fn fbm_2d(fb_x, fb_y, fb_oct, fb_seed) {
    fb_sum = 0
    fb_norm = 0
    fb_amp = 1
    fb_freq = 1
    fb_i = 0
    while fb_i < fb_oct {
        fb_layer = value_noise_2d(fb_x * fb_freq, fb_y * fb_freq, fb_seed + fb_i * FBM_SEED_STEP)
        fb_sum = fb_sum + fb_amp * fb_layer
        fb_norm = fb_norm + fb_amp
        fb_amp = fb_amp * FBM_GAIN
        fb_freq = fb_freq * FBM_LACUNARITY
        fb_i = fb_i + 1
    }
    if fb_norm == 0 {
        return 0
    }
    return fb_sum / fb_norm
}

# w columns by h rows of fBm, sampled every `scale` noise units.
# Returns a list of h rows, each a list of w numbers in [0, 1).
fn heightmap(hm_w, hm_h, hm_scale, hm_seed) {
    hm_rows = []
    hm_y = 0
    while hm_y < hm_h {
        hm_row = []
        hm_x = 0
        while hm_x < hm_w {
            hm_v = fbm_2d(hm_x * hm_scale, hm_y * hm_scale, MAP_OCTAVES, hm_seed)
            hm_row = push(hm_row, hm_v)
            hm_x = hm_x + 1
        }
        hm_rows = push(hm_rows, hm_row)
        hm_y = hm_y + 1
    }
    return hm_rows
}

# --- demo helpers -----------------------------------------------------

# fBm piles up around 0.5, so the four bands are cut close together.
WATER_MAX = 0.44
SAND_MAX = 0.48
GRASS_MAX = 0.56

fn terrain_char(tc_v) {
    if tc_v < WATER_MAX {
        return "~"
    }
    if tc_v < SAND_MAX {
        return "."
    }
    if tc_v < GRASS_MAX {
        return "*"
    }
    return "^"
}
fn fmt4(f4_v) {
    return str(round(f4_v * 10000) / 10000)
}

# --- demo -------------------------------------------------------------

print("== hash ==")
print("mul32(3,5):                  " + str(mul32(3, 5)))
print("mul32(65536,65536) wraps:    " + str(mul32(65536, 65536)))
print("mul32(4294967295,3):         " + str(mul32(4294967295, 3)))
print("mul32(123456789,987654321):  " + str(mul32(123456789, 987654321)))
print("hash32(0) / hash32(1):       " + str(hash32(0)) + " / " + str(hash32(1)))
print("salt keeps origin non-zero:  hash_2d(0,0,0)=" + fmt4(hash_2d(0, 0, 0)))
print("hash_1d(7,1) twice:          " + fmt4(hash_1d(7, 1)) + " " + fmt4(hash_1d(7, 1)))
print("hash_1d(7,2) differs:        " + fmt4(hash_1d(7, 2)))

print("")
print("== lerp / smoothstep ==")
print("lerp(0,10,0)=" + str(lerp(0, 10, 0)) + "  lerp(0,10,0.25)=" + str(lerp(0, 10, 0.25)) + "  lerp(0,10,1)=" + str(lerp(0, 10, 1)))
print("lerp(4,6,0.5)=" + str(lerp(4, 6, 0.5)))
print("smoothstep(0,1,x) at 0, 0.25, 0.5, 0.75, 1:")
print("  " + fmt4(smoothstep(0, 1, 0)) + "  " + fmt4(smoothstep(0, 1, 0.25)) + "  " + fmt4(smoothstep(0, 1, 0.5)) + "  " + fmt4(smoothstep(0, 1, 0.75)) + "  " + fmt4(smoothstep(0, 1, 1)))
print("clamped outside: " + fmt4(smoothstep(0, 1, 0 - 5)) + " " + fmt4(smoothstep(0, 1, 5)))
print("smoothstep(10,20,12.5): " + fmt4(smoothstep(10, 20, 12.5)))

print("")
print("== value noise 1d (seed 7) ==")
print("x=3 equals its lattice hash: " + fmt4(value_noise_1d(3, 7)) + " == " + fmt4(hash_1d(3, 7)))
print("x=4 equals its lattice hash: " + fmt4(value_noise_1d(4, 7)) + " == " + fmt4(hash_1d(4, 7)))
print("x=3.5 is their midpoint:     " + fmt4(value_noise_1d(3.5, 7)) + " == " + fmt4((hash_1d(3, 7) + hash_1d(4, 7)) / 2))
walk = ""
wi = 0
while wi <= 10 {
    walk = walk + fmt4(value_noise_1d(3 + wi / 10, 7))
    if wi < 10 {
        walk = walk + " "
    }
    wi = wi + 1
}
print("x=3.0 .. 4.0 by 0.1:")
print("  " + walk)
print("negative x works: value_noise_1d(-0.5,7)=" + fmt4(value_noise_1d(0 - 0.5, 7)))

print("")
print("== value noise 2d (seed 7) ==")
print("(2,5) equals lattice hash:   " + fmt4(value_noise_2d(2, 5, 7)) + " == " + fmt4(hash_2d(2, 5, 7)))
print("(2.5,5) x-midpoint:          " + fmt4(value_noise_2d(2.5, 5, 7)) + " == " + fmt4((hash_2d(2, 5, 7) + hash_2d(3, 5, 7)) / 2))
print("(2,5.5) y-midpoint:          " + fmt4(value_noise_2d(2, 5.5, 7)) + " == " + fmt4((hash_2d(2, 5, 7) + hash_2d(2, 6, 7)) / 2))
print("(2.5,5.5) 4-corner mean:     " + fmt4(value_noise_2d(2.5, 5.5, 7)) + " == " + fmt4((hash_2d(2, 5, 7) + hash_2d(3, 5, 7) + hash_2d(2, 6, 7) + hash_2d(3, 6, 7)) / 4))

print("")
print("== fbm_2d (seed 7) ==")
print("1 octave == value_noise_2d:  " + fmt4(fbm_2d(1.3, 2.7, 1, 7)) + " == " + fmt4(value_noise_2d(1.3, 2.7, 7)))
print("octaves 1..5 at (1.3,2.7):")
oct = 1
octline = "  "
while oct <= 5 {
    octline = octline + str(oct) + ":" + fmt4(fbm_2d(1.3, 2.7, oct, 7)) + "  "
    oct = oct + 1
}
print(octline)
print("2 octaves by hand:           " + fmt4((value_noise_2d(1.3, 2.7, 7) + 0.5 * value_noise_2d(2.6, 5.4, 1020)) / 1.5))

print("")
print("== determinism ==")
same = true
lo = 1
hi = 0
tot = 0
n = 0
sy = 0
while sy < 40 {
    sx = 0
    while sx < 40 {
        v = fbm_2d(sx * 0.17, sy * 0.17, 4, 7)
        if v != fbm_2d(sx * 0.17, sy * 0.17, 4, 7) {
            same = false
        }
        if v < lo { lo = v }
        if v > hi { hi = v }
        tot = tot + v
        n = n + 1
        sx = sx + 1
    }
    sy = sy + 1
}
print("1600 samples, recomputed identical: " + str(same))
print("min " + fmt4(lo) + "  max " + fmt4(hi) + "  mean " + fmt4(tot / n) + "  in [0,1): " + str(lo >= 0 and hi < 1))

print("")
print("== 60x20 terrain, seed 2026, scale 0.09 ==")
print("~ water (< " + str(WATER_MAX) + ")   . sand (< " + str(SAND_MAX) + ")   * grass (< " + str(GRASS_MAX) + ")   ^ rock")
map = heightmap(60, 20, 0.09, 2026)
nwater = 0
nsand = 0
ngrass = 0
nrock = 0
for mrow in map {
    line = ""
    for cell in mrow {
        ch = terrain_char(cell)
        line = line + ch
        if ch == "~" { nwater = nwater + 1 }
        if ch == "." { nsand = nsand + 1 }
        if ch == "*" { ngrass = ngrass + 1 }
        if ch == "^" { nrock = nrock + 1 }
    }
    print(line)
}
print("rows " + str(len(map)) + " x cols " + str(len(map[0])) + " = " + str(len(map) * len(map[0])) + " cells")
print("water " + str(nwater) + "  sand " + str(nsand) + "  grass " + str(ngrass) + "  rock " + str(nrock) + "  total " + str(nwater + nsand + ngrass + nrock))
print("corner heights: [0][0]=" + fmt4(map[0][0]) + "  [0][59]=" + fmt4(map[0][59]) + "  [19][0]=" + fmt4(map[19][0]) + "  [19][59]=" + fmt4(map[19][59]))
print("[0][0] == fbm_2d(0,0,4,2026): " + str(map[0][0] == fbm_2d(0, 0, 4, 2026)))
print("[5][12] == fbm_2d(12*0.09,5*0.09,4,2026): " + str(map[5][12] == fbm_2d(12 * 0.09, 5 * 0.09, 4, 2026)))

print("")
print("== a different seed is a different world ==")
map2 = heightmap(60, 20, 0.09, 99)
for mrow2 in take(map2, 6) {
    line2 = ""
    for cell2 in mrow2 {
        line2 = line2 + terrain_char(cell2)
    }
    print(line2)
}
print("seed 2026 [0][0]=" + fmt4(map[0][0]) + "   seed 99 [0][0]=" + fmt4(map2[0][0]))
