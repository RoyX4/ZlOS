# tic_tac_toe.zl - Tic-tac-toe engine with a perfect minimax AI.
#
# Board is a flat list of 9 cells (indices 0..8), laid out as:
#     0 1 2
#     3 4 5
#     6 7 8
# Each cell is "X", "O", or " " (empty).
# X is the maximizing player, O is the minimizing player.
# NOTE: every function-local variable is uniquely prefixed so it can never
#       clobber a top-level global (per the zl shared-namespace rule).

# Return "X" or "O" if that player has three in a row, else "" (no winner yet).
fn winner(wb) {
  w_lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]
  w_i = 0
  while w_i < len(w_lines) {
    w_line = w_lines[w_i]
    w_a = wb[w_line[0]]
    w_b = wb[w_line[1]]
    w_c = wb[w_line[2]]
    if w_a != " " and w_a == w_b and w_b == w_c {
      return w_a
    }
    w_i = w_i + 1
  }
  return ""
}

# List the indices of all empty cells (the legal moves).
fn moves(mb) {
  m_out = []
  m_i = 0
  while m_i < len(mb) {
    if mb[m_i] == " " {
      m_out = push(m_out, m_i)
    }
    m_i = m_i + 1
  }
  return m_out
}

# The other player.
fn other(ot) {
  if ot == "X" {
    return "O"
  }
  return "X"
}

# Return a NEW board with cell pi set to player pp (boards are never mutated).
fn place(pb, pi, pp) {
  p_out = []
  p_k = 0
  while p_k < len(pb) {
    if p_k == pi {
      p_out = push(p_out, pp)
    } else {
      p_out = push(p_out, pb[p_k])
    }
    p_k = p_k + 1
  }
  return p_out
}

# Minimax value of a board where it is `mp` player's turn.
# Positive favors X, negative favors O. Depth is folded in so the AI prefers
# winning sooner and losing later (10 - depth for an X win, depth - 10 for O).
fn minimax(mmb, mmp, mmd) {
  mm_w = winner(mmb)
  if mm_w == "X" {
    return 10 - mmd
  }
  if mm_w == "O" {
    return mmd - 10
  }
  mm_moves = moves(mmb)
  if len(mm_moves) == 0 {
    return 0
  }
  mm_i = 0
  if mmp == "X" {
    mm_best = -1000
    while mm_i < len(mm_moves) {
      mm_score = minimax(place(mmb, mm_moves[mm_i], "X"), "O", mmd + 1)
      mm_best = max(mm_best, mm_score)
      mm_i = mm_i + 1
    }
    return mm_best
  }
  mm_best = 1000
  while mm_i < len(mm_moves) {
    mm_score = minimax(place(mmb, mm_moves[mm_i], "O"), "X", mmd + 1)
    mm_best = min(mm_best, mm_score)
    mm_i = mm_i + 1
  }
  return mm_best
}

# Pick the optimal move index for `bmp` on board bmb. Returns -1 if no moves.
fn best_move(bmb, bmp) {
  bm_moves = moves(bmb)
  bm_best_i = -1
  if bmp == "X" {
    bm_best_score = -1000
  } else {
    bm_best_score = 1000
  }
  bm_k = 0
  while bm_k < len(bm_moves) {
    bm_m = bm_moves[bm_k]
    bm_score = minimax(place(bmb, bm_m, bmp), other(bmp), 1)
    if bmp == "X" {
      if bm_score > bm_best_score {
        bm_best_score = bm_score
        bm_best_i = bm_m
      }
    } else {
      if bm_score < bm_best_score {
        bm_best_score = bm_score
        bm_best_i = bm_m
      }
    }
    bm_k = bm_k + 1
  }
  return bm_best_i
}

# Render a board as a 3x3 grid ("." for empty), rows separated by newlines.
fn render(rb) {
  r_out = ""
  r_r = 0
  while r_r < 3 {
    r_line = ""
    r_c = 0
    while r_c < 3 {
      r_v = rb[r_r * 3 + r_c]
      if r_v == " " {
        r_line = r_line + "."
      } else {
        r_line = r_line + r_v
      }
      if r_c < 2 {
        r_line = r_line + " "
      }
      r_c = r_c + 1
    }
    r_out = r_out + r_line
    if r_r < 2 {
      r_out = r_out + "\n"
    }
    r_r = r_r + 1
  }
  return r_out
}

# ---------------------------------------------------------------------------
# Demo: two perfect minimax players face off. With optimal play from the
# empty board the game is always a draw.
# ---------------------------------------------------------------------------

empty = [" ", " ", " ", " ", " ", " ", " ", " ", " "]

print("=== Tic-Tac-Toe: minimax AI vs minimax AI ===")

board = empty
turn = "X"
ply = 0
while winner(board) == "" and len(moves(board)) > 0 {
  chosen = best_move(board, turn)
  board = place(board, chosen, turn)
  print("Move " + (ply + 1) + ": " + turn + " plays cell " + chosen)
  print(render(board))
  print("")
  turn = other(turn)
  ply = ply + 1
}

result = winner(board)
if result == "" {
  print("Result: draw (as perfect play demands)")
} else {
  print("Result: " + result + " wins")
}

# ---------------------------------------------------------------------------
# Best-move-for-a-position demo: X to move, one cell from winning the top row.
# ---------------------------------------------------------------------------
print("")
print("=== best move for a position ===")
pos = ["X", "X", " ", "O", "O", " ", " ", " ", " "]
print(render(pos))
print("X to move, best cell = " + best_move(pos, "X") + " (completes the top row)")

# ---------------------------------------------------------------------------
# Self-test: labeled checks.
# ---------------------------------------------------------------------------
print("")
print("=== self-test checks ===")

# winner() detects a completed row / column / diagonal.
row_win = ["X", "X", "X", "O", "O", " ", " ", " ", " "]
print("winner detects X top row : " + (winner(row_win) == "X"))
col_win = ["O", "X", " ", "O", "X", " ", "O", " ", " "]
print("winner detects O left column : " + (winner(col_win) == "O"))
diag_win = ["X", "O", " ", "O", "X", " ", " ", " ", "X"]
print("winner detects X main diagonal : " + (winner(diag_win) == "X"))
print("winner is empty on blank board : " + (winner(empty) == ""))

# moves() lists empty cells.
print("empty board has 9 moves : " + (len(moves(empty)) == 9))
print("row_win board has 4 moves : " + (len(moves(row_win)) == 4))

# place() is immutable and correct.
placed = place(empty, 4, "X")
print("place sets the target cell : " + (placed[4] == "X"))
print("place does not mutate original : " + (empty[4] == " "))

# AI takes an immediate win when offered one.
win_now = ["X", "X", " ", "O", "O", " ", " ", " ", " "]
print("X takes the winning move at 2 : " + (best_move(win_now, "X") == 2))

# AI blocks the opponent's immediate winning threat.
must_block = ["X", "X", " ", "O", " ", " ", " ", " ", " "]
print("O blocks X's threat at 2 : " + (best_move(must_block, "O") == 2))

# minimax spots a forced win: two opposite corners are X, O took the center,
# and X to move can play a third corner to create an unstoppable double threat.
fork = ["X", " ", " ", " ", "O", " ", " ", " ", "X"]
print("minimax scores this X-to-move fork as a win (>0) : " + (minimax(fork, "X", 0) > 0))

# A perfectly played game from empty is a draw.
print("perfect self-play ends in a draw : " + (result == ""))
