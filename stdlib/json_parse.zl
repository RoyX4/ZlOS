# json_parse.zl -- parse a JSON-ish text into nested zl values.
#
# Supports: numbers (int/float, optional sign/exponent), "strings" (with
# \n \t \" \\ escapes), the literals true / false / null, and nested [arrays]
# separated by commas. (No objects/{} -- the language has no maps.)
#
# The parser is a hand-written recursive-descent scanner. Because zl functions
# share the global namespace, the scanner deliberately uses two TOP-LEVEL
# globals as its shared cursor:
#     gSrc  -- the whole source string being parsed
#     gPos  -- current 0-based read index into gSrc
# Every function reads/advances these directly; all OTHER locals are uniquely
# prefixed so they never leak into or clobber a global.
#
# null: zl has no nil/null value, so JSON null is decoded as the string "null".
# (A limitation, documented; see self-test note at the bottom.)

gSrc = ""
gPos = 0

# ---- character helpers -------------------------------------------------------

# TRUE when single-char c is an ASCII digit.
fn isDigit(idC) {
    return has("0123456789", idC)
}

# Advance gPos past spaces, tabs, and newlines.
fn skipWs() {
    swGo = true
    while swGo and gPos < len(gSrc) {
        swC = at(gSrc, gPos)
        if swC == " " or swC == "\t" or swC == "\n" {
            gPos = gPos + 1
        } else {
            swGo = false
        }
    }
}

# ---- scalar scanners ---------------------------------------------------------

# Scan a "quoted string" starting at the opening quote. Returns the decoded
# string and leaves gPos just past the closing quote.
fn scanString() {
    gPos = gPos + 1          # consume opening quote
    ssOut = ""
    ssGo = true
    while ssGo and gPos < len(gSrc) {
        ssC = at(gSrc, gPos)
        if ssC == "\"" {
            gPos = gPos + 1      # consume closing quote
            ssGo = false
        } else if ssC == "\\" {
            gPos = gPos + 1
            ssE = at(gSrc, gPos)
            if ssE == "n" {
                ssOut = ssOut + "\n"
            } else if ssE == "t" {
                ssOut = ssOut + "\t"
            } else if ssE == "\"" {
                ssOut = ssOut + "\""
            } else if ssE == "\\" {
                ssOut = ssOut + "\\"
            } else {
                ssOut = ssOut + ssE
            }
            gPos = gPos + 1
        } else {
            ssOut = ssOut + ssC
            gPos = gPos + 1
        }
    }
    return ssOut
}

# Scan a number token (digits plus - + . e E) and convert with num().
fn scanNumber() {
    snStart = gPos
    snGo = true
    while snGo and gPos < len(gSrc) {
        snC = at(gSrc, gPos)
        if isDigit(snC) or snC == "-" or snC == "+" or snC == "." or snC == "e" or snC == "E" {
            gPos = gPos + 1
        } else {
            snGo = false
        }
    }
    return num(slice(gSrc, snStart, gPos))
}

# Scan the literal starting at gPos: true -> boolean true, false -> boolean
# false, null -> the string "null". Advances gPos past the token.
fn scanLiteral() {
    slC = at(gSrc, gPos)
    if slC == "t" {
        gPos = gPos + 4         # "true"
        return true
    }
    if slC == "f" {
        gPos = gPos + 5         # "false"
        return false
    }
    gPos = gPos + 4             # "null"
    return "null"
}

# ---- structural scanners -----------------------------------------------------

# Scan a [ ... ] array, returning a zl list of parsed child values.
fn scanArray() {
    gPos = gPos + 1             # consume '['
    saOut = []
    skipWs()
    if at(gSrc, gPos) == "]" {
        gPos = gPos + 1
        return saOut
    }
    saGo = true
    while saGo and gPos < len(gSrc) {
        saVal = parseValue()
        saOut = push(saOut, saVal)
        skipWs()
        saC = at(gSrc, gPos)
        if saC == "," {
            gPos = gPos + 1
            skipWs()
        } else {
            # ']' (or malformed end) -- stop consuming elements.
            if saC == "]" {
                gPos = gPos + 1
            }
            saGo = false
        }
    }
    return saOut
}

# Parse any single value at the current cursor. Dispatches on the first
# non-whitespace character.
fn parseValue() {
    skipWs()
    pvC = at(gSrc, gPos)
    if pvC == "[" {
        return scanArray()
    }
    if pvC == "\"" {
        return scanString()
    }
    if pvC == "t" or pvC == "f" or pvC == "n" {
        return scanLiteral()
    }
    return scanNumber()
}

# Public entry point: parse a JSON-ish string into nested zl values.
fn parse(pSrc) {
    gSrc = pSrc
    gPos = 0
    return parseValue()
}

# ---- rendering (for the self-test only) --------------------------------------

# TRUE when v is a list. `type` is the language contract; list equality is now
# structural and reflexive, so the old self-inequality trick is invalid.
fn isList(ilV) {
    return type(ilV) == "list"
}

# Render any parsed value back to a compact JSON-ish string. Order of checks
# matters: booleans MUST be tested before num() (num() of a boolean errors).
fn show(shV) {
    if isList(shV) {
        shOut = "["
        shI = 0
        while shI < len(shV) {
            shOut = shOut + show(shV[shI])
            if shI != len(shV) - 1 {
                shOut = shOut + ", "
            }
            shI = shI + 1
        }
        return shOut + "]"
    }
    if shV == true {
        return "true"
    }
    if shV == false {
        return "false"
    }
    if shV == "null" {
        return "null"
    }
    if type(shV) == "number" {
        return "" + shV
    }
    return "\"" + shV + "\""
}

# ---------------- self-test ----------------
print("== json_parse self-test ==")

print("")
print("scalars:")
print("  number 42        -> " + show(parse("42")))
print("  float -3.5       -> " + show(parse("-3.5")))
print("  string \"hi\"      -> " + show(parse("\"hi\"")))
print("  true             -> " + show(parse("true")))
print("  false            -> " + show(parse("false")))
print("  null             -> " + show(parse("null")))

print("")
print("required input:  [1, \"two\", [3, 4], true]")
r = parse("[1, \"two\", [3, 4], true]")
print("  round-trip       -> " + show(r))
print("  len == 4         : " + (len(r) == 4))
print("  r[0] == 1        : " + (r[0] == 1))
print("  r[1] == \"two\"    : " + (r[1] == "two"))
print("  r[2] is a list   : " + isList(r[2]))
print("  r[2][0] == 3     : " + (r[2][0] == 3))
print("  r[2][1] == 4     : " + (r[2][1] == 4))
print("  r[3] == true     : " + (r[3] == true))

print("")
print("nested + mixed:  [null, [true, [false, \"x\\ny\"]], 10.25]")
d = parse("[null, [true, [false, \"x\\ny\"]], 10.25]")
print("  round-trip       -> " + show(d))
print("  d[0] is null     : " + (d[0] == "null"))
print("  d[1][1][0]==false: " + (d[1][1][0] == false))
print("  escaped newline decoded, d[1][1][1] == \"x<newline>y\" :")
print("  [" + d[1][1][1] + "]")
print("  d[2] == 10.25    : " + (d[2] == 10.25))

print("")
print("empty array []   -> " + show(parse("[]")))
print("  len 0            : " + (len(parse("[]")) == 0))

print("")
print("Note: JSON null decodes to the zl string \"null\" (zl has no nil type).")
