# graphx.zl -- graph algorithms over an edge-list graph.
#
# Representation (different from graph_search.zl / dijkstra.zl, which use
# adjacency lists):
#   nodes = ["a", "b", "c", ...]        a list of node ids
#   edges = [["a","b"], ["b","c"], ...] a list of [from, to] pairs
# Edges are read as DIRECTED (from -> to). The two undirected routines,
# connected_components and is_bipartite, ignore the direction.
# Node ids can be any comparable value; the demo uses strings.
#
# What this module adds on top of the other two graph modules:
#   in_degrees, topo_sort, has_cycle, transpose,
#   reachable_from, connected_components, is_bipartite
#
# Function-locals are prefixed (gx_/ts_/cc_/...) so they can never clobber a
# top-level global -- same convention as dijkstra.zl.

# --- helpers -------------------------------------------------------------

# Successors of gxNode: every `to` of an edge leaving gxNode.
fn gx_succ(gxEdges, gxNode) {
  gxOut = []
  for gxE in gxEdges {
    if gxE[0] == gxNode {
      gxOut = push(gxOut, gxE[1])
    }
  }
  return gxOut
}

# Undirected neighbours of gaNode: both ends of any edge touching it.
fn gx_adj(gaEdges, gaNode) {
  gaOut = []
  for gaE in gaEdges {
    if gaE[0] == gaNode {
      gaOut = push(gaOut, gaE[1])
    }
    if gaE[1] == gaNode {
      gaOut = push(gaOut, gaE[0])
    }
  }
  return gaOut
}

# --- degrees -------------------------------------------------------------

# Number of incoming edges per node, as a list of [node, count] pairs, in
# the same order as `nodes`. Edges pointing at unknown nodes are ignored.
fn in_degrees(idNodes, idEdges) {
  idCounts = []
  for idN in idNodes {
    idCounts = push(idCounts, 0)
  }
  for idE in idEdges {
    idJ = index_of(idNodes, idE[1])
    if idJ >= 0 {
      idCounts[idJ] = idCounts[idJ] + 1
    }
  }
  idOut = []
  idI = 0
  while idI < len(idNodes) {
    idOut = push(idOut, [idNodes[idI], idCounts[idI]])
    idI = idI + 1
  }
  return idOut
}

# --- topological order ---------------------------------------------------

# Kahn's algorithm. Returns a list of every node such that each edge goes
# left-to-right, or nil() if the graph has a cycle (so no order exists).
# Ties are broken by the order nodes appear in `nodes`, so it is stable.
fn topo_sort(tsNodes, tsEdges) {
  tsDeg = []
  for tsN in tsNodes {
    tsDeg = push(tsDeg, 0)
  }
  for tsE in tsEdges {
    tsJ = index_of(tsNodes, tsE[1])
    if tsJ >= 0 {
      tsDeg[tsJ] = tsDeg[tsJ] + 1
    }
  }

  # Seed the queue with everything that has nothing pointing at it.
  tsQueue = []
  tsI = 0
  while tsI < len(tsNodes) {
    if tsDeg[tsI] == 0 {
      tsQueue = push(tsQueue, tsNodes[tsI])
    }
    tsI = tsI + 1
  }

  tsOut = []
  tsHead = 0
  while tsHead < len(tsQueue) {
    tsCur = tsQueue[tsHead]
    tsHead = tsHead + 1
    tsOut = push(tsOut, tsCur)
    for tsE2 in tsEdges {
      if tsE2[0] == tsCur {
        tsK = index_of(tsNodes, tsE2[1])
        if tsK >= 0 {
          tsDeg[tsK] = tsDeg[tsK] - 1
          if tsDeg[tsK] == 0 {
            tsQueue = push(tsQueue, tsNodes[tsK])
          }
        }
      }
    }
  }

  # Anything left undrained is stuck inside a cycle.
  if len(tsOut) < len(tsNodes) {
    return nil()
  }
  return tsOut
}

# true when the directed graph contains at least one cycle (a self-loop
# counts). Simply: a cycle is exactly what stops a topological order existing.
fn has_cycle(hcNodes, hcEdges) {
  return type(topo_sort(hcNodes, hcEdges)) == "nil"
}

# --- edge tricks ---------------------------------------------------------

# Reverse every edge: [from, to] becomes [to, from].
fn transpose(tpEdges) {
  tpOut = []
  for tpE in tpEdges {
    tpOut = push(tpOut, [tpE[1], tpE[0]])
  }
  return tpOut
}

# --- reachability --------------------------------------------------------

# Every node reachable from rfStart by following edges forwards, in BFS
# order and including rfStart itself. [] if rfStart is not in `nodes`.
fn reachable_from(rfNodes, rfEdges, rfStart) {
  if not contains(rfNodes, rfStart) {
    return []
  }
  rfOut = []
  rfSeen = [rfStart]
  rfQueue = [rfStart]
  rfHead = 0
  while rfHead < len(rfQueue) {
    rfCur = rfQueue[rfHead]
    rfHead = rfHead + 1
    rfOut = push(rfOut, rfCur)
    for rfNb in gx_succ(rfEdges, rfCur) {
      if not contains(rfSeen, rfNb) {
        if contains(rfNodes, rfNb) {
          rfSeen = push(rfSeen, rfNb)
          rfQueue = push(rfQueue, rfNb)
        }
      }
    }
  }
  return rfOut
}

# --- undirected structure ------------------------------------------------

# Split the graph into connected components, ignoring edge direction.
# Returns a list of lists of node ids; every node appears exactly once, and
# an isolated node comes back as a component of one.
fn connected_components(ccNodes, ccEdges) {
  ccSeen = []
  ccOut = []
  for ccN in ccNodes {
    if not contains(ccSeen, ccN) {
      ccComp = []
      ccSeen = push(ccSeen, ccN)
      ccQueue = [ccN]
      ccHead = 0
      while ccHead < len(ccQueue) {
        ccCur = ccQueue[ccHead]
        ccHead = ccHead + 1
        ccComp = push(ccComp, ccCur)
        for ccNb in gx_adj(ccEdges, ccCur) {
          if not contains(ccSeen, ccNb) {
            if contains(ccNodes, ccNb) {
              ccSeen = push(ccSeen, ccNb)
              ccQueue = push(ccQueue, ccNb)
            }
          }
        }
      }
      ccOut = push(ccOut, ccComp)
    }
  }
  return ccOut
}

# true when the nodes can be split into two groups with every (undirected)
# edge crossing between them -- i.e. the graph has no odd-length cycle.
# Done by 2-colouring each component with BFS; -1 means "not coloured yet".
fn is_bipartite(bpNodes, bpEdges) {
  bpColor = []
  for bpN in bpNodes {
    bpColor = push(bpColor, -1)
  }
  bpI = 0
  while bpI < len(bpNodes) {
    if bpColor[bpI] == -1 {
      bpColor[bpI] = 0
      bpQueue = [bpNodes[bpI]]
      bpHead = 0
      while bpHead < len(bpQueue) {
        bpCur = bpQueue[bpHead]
        bpHead = bpHead + 1
        bpCi = index_of(bpNodes, bpCur)
        for bpNb in gx_adj(bpEdges, bpCur) {
          bpNi = index_of(bpNodes, bpNb)
          if bpNi >= 0 {
            if bpColor[bpNi] == -1 {
              bpColor[bpNi] = 1 - bpColor[bpCi]
              bpQueue = push(bpQueue, bpNb)
            } else if bpColor[bpNi] == bpColor[bpCi] {
              return false
            }
          }
        }
      }
    }
    bpI = bpI + 1
  }
  return true
}

# --- pretty printing -----------------------------------------------------

fn show_degrees(sdLabel, sdPairs) {
  sdParts = []
  for sdP in sdPairs {
    sdParts = push(sdParts, str(sdP[0]) + "=" + num(sdP[1]))
  }
  print(sdLabel + join(sdParts, "  "))
}

fn show_order(soLabel, soOrder) {
  if type(soOrder) == "nil" {
    print(soLabel + "nil (graph is cyclic)")
  } else {
    print(soLabel + join(soOrder, " -> "))
  }
}

fn show_components(scLabel, scComps) {
  scParts = []
  for scC in scComps {
    scParts = push(scParts, "{" + join(scC, ",") + "}")
  }
  print(scLabel + join(scParts, " "))
}

# ---------------------------------------------------------------------------
# Demo / self-test
# ---------------------------------------------------------------------------

print("=== graphx self-test ===")

# Graph 1: a DAG (think build steps / course prerequisites).
#   a -> b, c     b -> d      c -> d, f     d -> e      f -> e
dagNodes = ["a", "b", "c", "d", "e", "f"]
dagEdges = [["a", "b"], ["a", "c"], ["b", "d"], ["c", "d"], ["d", "e"], ["c", "f"], ["f", "e"]]

print("")
print("-- Graph 1: DAG a->b,c  b->d  c->d,f  d->e  f->e")
show_degrees("in_degrees:        ", in_degrees(dagNodes, dagEdges))
print("  expected:        a=0  b=1  c=1  d=2  e=2  f=1")
show_order("topo_sort:         ", topo_sort(dagNodes, dagEdges))
print("  expected:        a -> b -> c -> d -> f -> e")
print("has_cycle:         " + str(has_cycle(dagNodes, dagEdges)) + "   (expected false)")
print("reachable_from c:  " + join(reachable_from(dagNodes, dagEdges, "c"), " -> ") + "   (expected c -> d -> f -> e)")
print("reachable_from e:  " + join(reachable_from(dagNodes, dagEdges, "e"), " -> ") + "   (expected e)")
print("transpose:         " + str(transpose(dagEdges)))
show_degrees("in_deg of transp:  ", in_degrees(dagNodes, transpose(dagEdges)))
print("  = out-degrees:   a=2  b=1  c=2  d=1  e=0  f=1")
show_order("topo of transpose: ", topo_sort(dagNodes, transpose(dagEdges)))
print("  expected:        e -> d -> f -> b -> c -> a")

# Graph 2: the same nodes plus one back edge e -> a, which closes a cycle.
cycNodes = dagNodes
cycEdges = push(dagEdges, ["e", "a"])

print("")
print("-- Graph 2: Graph 1 plus the back edge e->a")
print("has_cycle:         " + str(has_cycle(cycNodes, cycEdges)) + "    (expected true)")
show_order("topo_sort:         ", topo_sort(cycNodes, cycEdges))
print("reachable_from e:  " + join(reachable_from(cycNodes, cycEdges, "e"), " -> ") + "   (expected e -> a -> b -> c -> d -> f)")
print("self-loop only:    " + str(has_cycle(["s"], [["s", "s"]])) + "    (expected true)")

# Graph 3: three separate pieces, treated as undirected.
#   p - q - r      s - t      u alone
ccNodes = ["p", "q", "r", "s", "t", "u"]
ccEdges = [["p", "q"], ["q", "r"], ["s", "t"]]

print("")
print("-- Graph 3: p-q-r,  s-t,  u isolated")
show_components("components:        ", connected_components(ccNodes, ccEdges))
print("  expected:        {p,q,r} {s,t} {u}")
print("is_bipartite:      " + str(is_bipartite(ccNodes, ccEdges)) + "    (expected true, a forest always is)")
print("reachable_from p:  " + join(reachable_from(ccNodes, ccEdges, "p"), " -> ") + "   (expected p -> q -> r, directed)")

# Graph 4: even cycle (bipartite) vs odd cycle (not).
sqNodes = ["w", "x", "y", "z"]
sqEdges = [["w", "x"], ["x", "y"], ["y", "z"], ["z", "w"]]
triNodes = ["x", "y", "z"]
triEdges = [["x", "y"], ["y", "z"], ["z", "x"]]

print("")
print("-- Graph 4: 4-cycle w-x-y-z-w  vs  triangle x-y-z-x")
print("is_bipartite(4cyc):" + str(is_bipartite(sqNodes, sqEdges)) + "    (expected true)")
print("is_bipartite(tri): " + str(is_bipartite(triNodes, triEdges)) + "   (expected false)")
show_components("components(4cyc):  ", connected_components(sqNodes, sqEdges))
print("  expected:        {w,x,z,y}  (BFS order: w, then x and z, then y)")

print("")
print("=== done ===")
