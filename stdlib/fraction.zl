# fraction.zl -- fraction arithmetic as [numerator, denominator]
# Every function-local variable is prefixed with the function's initials
# to avoid clobbering globals (functions share the global namespace).

# --- greatest common divisor (Euclid), always returns a non-negative value ---
fn frac_gcd(a, b) {
    fg_a = a
    fg_b = b
    if fg_a < 0 { fg_a = -fg_a }
    if fg_b < 0 { fg_b = -fg_b }
    while fg_b != 0 {
        fg_t = fg_b
        fg_b = fg_a % fg_b
        fg_a = fg_t
    }
    return fg_a
}

# --- reduce a fraction to lowest terms and normalize the sign ---
fn frac_simplify(f) {
    fs_n = f[0]
    fs_d = f[1]
    # numerator zero -> canonical 0/1
    if fs_n == 0 {
        return [0, 1]
    }
    # keep the sign on the numerator, denominator stays positive
    if fs_d < 0 {
        fs_n = -fs_n
        fs_d = -fs_d
    }
    fs_g = frac_gcd(fs_n, fs_d)
    fs_rn = int(fs_n / fs_g)
    fs_rd = int(fs_d / fs_g)
    return [fs_rn, fs_rd]
}

# --- addition: n1/d1 + n2/d2 = (n1*d2 + n2*d1) / (d1*d2) ---
fn frac_add(a, b) {
    fa_n = a[0] * b[1] + b[0] * a[1]
    fa_d = a[1] * b[1]
    return frac_simplify([fa_n, fa_d])
}

# --- multiplication: (n1*n2) / (d1*d2) ---
fn frac_mul(a, b) {
    fm_n = a[0] * b[0]
    fm_d = a[1] * b[1]
    return frac_simplify([fm_n, fm_d])
}

# --- render as "n/d" ---
fn frac_to_string(f) {
    return f[0] + "/" + f[1]
}

# =====================  SELF-TEST  =====================
print("fraction.zl self-test")

half = [1, 2]
third = [1, 3]

sum = frac_add(half, third)
print("1/2 + 1/3 = " + frac_to_string(sum) + "   (expect 5/6)")

prod = frac_mul(half, third)
print("1/2 * 1/3 = " + frac_to_string(prod) + "   (expect 1/6)")

# simplification: 6/8 -> 3/4
simp = frac_simplify([6, 8])
print("simplify 6/8 = " + frac_to_string(simp) + "   (expect 3/4)")

# simplification with negative denominator: 2/-4 -> -1/2
negd = frac_simplify([2, -4])
print("simplify 2/-4 = " + frac_to_string(negd) + "   (expect -1/2)")

# zero numerator collapses to 0/1
zero = frac_simplify([0, 5])
print("simplify 0/5 = " + frac_to_string(zero) + "   (expect 0/1)")

# add that reduces: 1/6 + 1/6 = 2/6 -> 1/3
addred = frac_add([1, 6], [1, 6])
print("1/6 + 1/6 = " + frac_to_string(addred) + "   (expect 1/3)")
