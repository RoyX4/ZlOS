# linkedlist.zl
# Singly linked list modeled as nested pairs: node = [value, rest], empty = [].
# All function-local variables are prefixed to avoid clobbering globals (zl scope rule).

# cons: prepend value onto a linked list -> new linked list
fn cons(cValue, cRest) {
    return [cValue, cRest]
}

# head: first value of a linked list ("" for empty)
fn head(hList) {
    if len(hList) == 0 {
        return ""
    }
    return hList[0]
}

# tail: everything after the head ([] for empty)
fn tail(tList) {
    if len(tList) == 0 {
        return []
    }
    return tList[1]
}

# list_length: count of nodes in a linked list
fn list_length(llList) {
    llCount = 0
    llCur = llList
    while len(llCur) != 0 {
        llCount = llCount + 1
        llCur = llCur[1]
    }
    return llCount
}

# from_list: build a linked list from a flat zl list (preserves order)
fn from_list(flZlList) {
    flLinked = []
    flI = len(flZlList) - 1
    while flI >= 0 {
        flLinked = [flZlList[flI], flLinked]
        flI = flI - 1
    }
    return flLinked
}

# to_list: flatten a linked list back into a flat zl list
fn to_list(tlLinked) {
    tlOut = []
    tlCur = tlLinked
    while len(tlCur) != 0 {
        tlOut = push(tlOut, tlCur[0])
        tlCur = tlCur[1]
    }
    return tlOut
}

# reverse: reverse a linked list -> new linked list
fn reverse(rvLinked) {
    rvAcc = []
    rvCur = rvLinked
    while len(rvCur) != 0 {
        rvAcc = [rvCur[0], rvAcc]
        rvCur = rvCur[1]
    }
    return rvAcc
}

# ---------------- self-test ----------------
print("== linkedlist.zl self-test ==")

empty = []
print("empty length: " + list_length(empty))       # 0
print("head of empty: '" + head(empty) + "'")        # ''
print("tail of empty is empty list: " + (len(tail(empty)) == 0))  # true

a = cons(3, cons(2, cons(1, [])))                    # 3 -> 2 -> 1
print("cons list head: " + head(a))                  # 3
print("cons list length: " + list_length(a))         # 3
print("cons list as flat: " + join(to_list(a), ","))  # 3,2,1
print("cons list tail head: " + head(tail(a)))       # 2

fromFlat = from_list([10, 20, 30, 40])
print("from_list head: " + head(fromFlat))           # 10
print("from_list length: " + list_length(fromFlat))  # 4
print("from_list -> to_list: " + join(to_list(fromFlat), ","))  # 10,20,30,40

rev = reverse(fromFlat)
print("reversed -> to_list: " + join(to_list(rev), ","))  # 40,30,20,10
print("reversed head: " + head(rev))                 # 40
print("original unchanged after reverse: " + join(to_list(fromFlat), ","))  # 10,20,30,40

# round-trip check
rt = to_list(from_list([5, 6, 7]))
print("round-trip 5,6,7: " + join(rt, ","))          # 5,6,7

print("== done ==")
