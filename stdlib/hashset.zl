# hashset.zl -- a set of numbers backed by a list (no duplicates).
# Every function-local variable is prefixed to avoid clobbering globals.

# Return true if `val` is a member of set `s`.
fn set_has(s, val) {
  sh_i = 0
  while sh_i < len(s) {
    if s[sh_i] == val {
      return true
    }
    sh_i = sh_i + 1
  }
  return false
}

# Add `val` to set `s`, returning a NEW set. Duplicates are ignored.
fn set_add(s, val) {
  if set_has(s, val) {
    return s
  }
  return push(s, val)
}

# Remove `val` from set `s`, returning a NEW set without it.
fn set_remove(s, val) {
  sr_out = []
  sr_i = 0
  while sr_i < len(s) {
    if s[sr_i] != val {
      sr_out = push(sr_out, s[sr_i])
    }
    sr_i = sr_i + 1
  }
  return sr_out
}

# Number of elements in the set.
fn set_size(s) {
  return len(s)
}

# Union of sets `a` and `b` -- a NEW set with every element of both, no dupes.
fn set_union(a, b) {
  su_out = a
  su_i = 0
  while su_i < len(b) {
    su_out = set_add(su_out, b[su_i])
    su_i = su_i + 1
  }
  return su_out
}

# Intersection of `a` and `b` -- a NEW set of elements present in both.
fn set_intersect(a, b) {
  si_out = []
  si_i = 0
  while si_i < len(a) {
    if set_has(b, a[si_i]) {
      si_out = set_add(si_out, a[si_i])
    }
    si_i = si_i + 1
  }
  return si_out
}

# ---------------------------------------------------------------------------
# Self-test: build two overlapping sets and exercise every function.
# ---------------------------------------------------------------------------

setA = []
setA = set_add(setA, 1)
setA = set_add(setA, 2)
setA = set_add(setA, 3)
setA = set_add(setA, 2)   # duplicate -- should be ignored
setA = set_add(setA, 4)

setB = []
setB = set_add(setB, 3)
setB = set_add(setB, 4)
setB = set_add(setB, 5)
setB = set_add(setB, 6)

print("setA           = " + join(setA, ","))
print("setB           = " + join(setB, ","))
print("size(setA)     = " + set_size(setA))     # 4 (dup ignored)
print("size(setB)     = " + set_size(setB))     # 4

print("has(setA,2)    = " + set_has(setA, 2))   # true
print("has(setA,9)    = " + set_has(setA, 9))   # false

union = set_union(setA, setB)
print("union          = " + join(union, ","))   # 1,2,3,4,5,6
print("size(union)    = " + set_size(union))     # 6

inter = set_intersect(setA, setB)
print("intersect      = " + join(inter, ","))    # 3,4
print("size(intersect)= " + set_size(inter))      # 2

removed = set_remove(setA, 2)
print("remove 2 fromA = " + join(removed, ","))  # 1,3,4
print("size(removed)  = " + set_size(removed))    # 3
print("setA unchanged = " + join(setA, ","))     # 1,2,3,4 (immutability)
